+/* Cidre (0473) : cles de variantes d'un dessin simule (CIDRE_BANC_VARIANTES=N,
+ * N <= 4) : formats declares (cle du prechauffage), puis des etats que le
+ * prechauffage ne devine pas : alpha non ecrit, une seule cible ecrite, une
+ * cible liee de plus que le pipeline n'ecrit pas (RTV en trop, D3D12). */
+static struct kk_rp_variant_key *
+kk_banc_synth(const struct kk_shader *vs, const struct kk_shader *fs, unsigned nb,
+              uint32_t *n)
+{
+   *n = 0;
+   struct kk_rp_variant_key *k0 = kk_prewarm_key(vs, fs);
+   if (k0 == NULL)
+      return NULL;
+   nb = MIN2(nb, 4u);
+   struct kk_rp_variant_key *v = calloc(nb ? nb : 1, sizeof(*v));
+   if (v == NULL) {
+      free(k0);
+      return NULL;
+   }
+   for (unsigned k = 0; k < nb; k++) {
+      v[k] = *k0;
+      int premier = -1, libre = -1;
+      for (int i = 0; i < MAX_DRAW_BUFFERS; i++) {
+         if (k0->formats[i] != MTL_PIXEL_FORMAT_INVALID && premier < 0)
+            premier = i;
+         if (k0->formats[i] == MTL_PIXEL_FORMAT_INVALID && libre < 0)
+            libre = i;
+      }
+      if (k == 1) {
+         for (int i = 0; i < MAX_DRAW_BUFFERS; i++)
+            v[k].blend_write_mask[i] &= 0x7;
+      } else if (k == 2 && premier >= 0) {
+         v[k].write_disable_mask |= ~BITFIELD_BIT(premier) & BITFIELD_MASK(MAX_DRAW_BUFFERS);
+      } else if (k == 3 && libre >= 0) {
+         v[k].formats[libre] = MTL_PIXEL_FORMAT_R8G8B8A8_UNORM;
+         v[k].write_disable_mask |= BITFIELD_BIT(libre);
+      }
+   }
+   free(k0);
+   *n = nb;
+   return v;
