+/* 0355 (cidre-d2r-gel) : demande de suspension (SIGUSR1) arrivee pendant que l'ilot traitait une sortie vers un appel
+ * hote : le fil est vu a l'entree de son appel systeme (pc = adresse de retour, comme save_syscall_entry_frame) ; au
+ * retour, registres et pc tels que wait_suspend les rend, sans passage par KiUserEmulationDispatcher (le fil n'est pas
+ * dans l'emulation : InSimulation n'est pas touche). */
+void ilot_suspendre_appel( struct ilot_regs_exc *r )
+{
+    CONTEXT context;
+    unsigned int i;
 
+    memset( &context, 0, sizeof(context) );
+    context.ContextFlags = CONTEXT_FULL | CONTEXT_ARM64_X18 | CONTEXT_EXCEPTION_REPORTING;
+    for (i = 0; i < 31; i++) context.X[i] = r->x[i];
+    context.Sp = r->sp; context.Pc = r->pc; context.Cpsr = r->nzcv & 0xf0000000;
+    context.Fpcr = r->fpcr; context.Fpsr = r->fpsr;
+    for (i = 0; i < 32; i++) context.V[i] = r->v[i];
+    wait_suspend( &context );
+    for (i = 0; i < 31; i++) r->x[i] = context.X[i];
+    r->sp = context.Sp; r->pc = context.Pc; r->nzcv = context.Cpsr & 0xf0000000;
+}
