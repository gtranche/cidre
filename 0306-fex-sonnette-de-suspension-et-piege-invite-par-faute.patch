+// SPDX-License-Identifier: MIT
+#pragma once
+// Cidre 0306 : sonnette de suspension et piege invite (int3/int1) par une faute de lecture, plus par brk (SIGTRAP).
+//
+// Le crashhandler du client Steam (et des anti-triche) fait signal( SIGTRAP, SIG_IGN ) dans le processus du jeu : un brk
+// n'a alors plus de signal, le noyau le reprend sur place, sans fin. La sonnette de suspension de FEX (brk #0xCAFE en
+// ligne, brk #0xCAFD des talons 0281, brk #0xCAFE de ExitFunctionEC) et le piege invite (brk #0 de GuestSignal_SIGTRAP)
+// gelaient ainsi le fil (SuspendThread, ramasse-miettes, int3 de l'invite). A la place : une lecture dans une reservation
+// sans droits (SIGSEGV/SIGBUS, comme 0275 pour le tremplin W^X), reconnue par son adresse exacte.
+//
+// Page est posee par le frontal ARM64EC avant InitCore ; nulle (WOW64, autres frontaux) : les brk d'origine.
+#include <cstdint>
+
+namespace FEXCore::CidreSonnetteFaute {
+inline uint64_t Page {};
+constexpr uint64_t EN_LIGNE = 0;  // sonnette en ligne (CIDRE_SONNETTE_FROIDE=0)
+constexpr uint64_t FROIDE = 16;   // talon 0281 : le mot qui suit la lecture est le decalage vers le site
+constexpr uint64_t PIEGE = 32;    // GuestSignal_SIGTRAP : exception invitee prise dans SynchronousFaultData
+} // namespace FEXCore::CidreSonnetteFaute
