+  if (!N) {
+    return;
+  }
+  fextl::vector<uint64_t> Triees(Pages, Pages + N);
+  std::sort(Triees.begin(), Triees.end());
+  fextl::vector<std::pair<uint64_t, uint64_t>> Plages;
+  for (uint64_t P : Triees) {
+    P &= FEXCore::Utils::FEX_PAGE_MASK;
+    if (!Plages.empty() && Plages.back().first + Plages.back().second >= P) {
+      Plages.back().second = std::max(Plages.back().second, P + FEXCore::Utils::FEX_PAGE_SIZE - Plages.back().first);
+    } else {
+      Plages.emplace_back(P, FEXCore::Utils::FEX_PAGE_SIZE);
+    }
+  }
+  InvalidateRangesInternal(Plages.data(), Plages.size(), CidreSource);
+}
