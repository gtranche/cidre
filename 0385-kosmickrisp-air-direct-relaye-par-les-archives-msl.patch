+static void
+kk_relais_submit(id<MTL4Compiler> comp, MTL4PipelineDescriptor *desc, id provisional,
+                 bool compute, NSUInteger min_threads)
+{
+   struct kk_relais_job *job = calloc(1, sizeof(*job));
+   if (job == NULL)
+      return;
+   KKRelais *slot = [KKRelais new];
+   objc_setAssociatedObject(provisional, kk_relais_key, slot, OBJC_ASSOCIATION_RETAIN);
+   job->comp = [comp retain];
+   job->desc = [desc retain];
+   job->slot = slot;
+   job->compute = compute;
+   job->min_threads = min_threads;
+   atomic_fetch_add(&kk_relais_live, 1);
+
+   pthread_mutex_lock(&kk_relais_q_mutex);
+   if (!kk_relais_started) {
+      kk_relais_started = 1;
+      for (int i = 0; i < kk_relais_threads(); i++) {
+         pthread_t t;
+         if (pthread_create(&t, NULL, kk_relais_main, NULL) == 0)
+            pthread_detach(t);
+      }
+   }
+   if (kk_relais_tail)
+      kk_relais_tail->next = job;
+   else
+      kk_relais_head = job;
+   kk_relais_tail = job;
+   pthread_cond_signal(&kk_relais_q_cond);
+   pthread_mutex_unlock(&kk_relais_q_mutex);
+}
