+      struct kk_relais_job *job = kk_relais_head;
+      kk_relais_head = job->next;
+      if (kk_relais_head == NULL)
+         kk_relais_tail = NULL;
+      pthread_mutex_unlock(&kk_relais_q_mutex);
+
+      @autoreleasepool {
+         id pipe = nil;
+         kk_compile_lock();
+         if (job->compute)
+            pipe = [job->comp newComputePipelineStateWithDescriptor:(MTL4ComputePipelineDescriptor *)job->desc
