+kk_relais_threads(void)
+{
+   static int threads = -1;
+   if (threads < 0) {
+      const char *v = getenv("CIDRE_AIR_RELAIS");
+      long n = v && v[0] ? strtol(v, NULL, 10) : 2;
+      threads = (int)CLAMP(n, 0, 8);
