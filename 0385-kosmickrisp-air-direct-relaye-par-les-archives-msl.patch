+   MTL4FunctionDescriptor *fs = kk_relais_msl_fd(dev, desc.fragmentFunctionDescriptor, &changed);
+   if (fs == nil && desc.fragmentFunctionDescriptor != nil)
+      return nil;
+   if (!changed)
+      return nil;
+   MTL4RenderPipelineDescriptor *alt = [[desc copy] autorelease];
+   alt.vertexFunctionDescriptor = vs;
+   alt.fragmentFunctionDescriptor = fs;
+   return alt;
+}
