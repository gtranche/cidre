+static void
+kk_relais_drop(id<MTL4Compiler> comp)
+{
+   struct kk_relais_job *keep = NULL, *keep_tail = NULL, *drop = NULL;
+   pthread_mutex_lock(&kk_relais_q_mutex);
+   for (struct kk_relais_job *j = kk_relais_head, *n; j; j = n) {
+      n = j->next;
+      j->next = NULL;
+      if (j->comp == comp) {
+         j->next = drop;
+         drop = j;
+      } else {
+         if (keep_tail)
+            keep_tail->next = j;
+         else
+            keep = j;
+         keep_tail = j;
+      }
+   }
+   kk_relais_head = keep;
+   kk_relais_tail = keep_tail;
+   pthread_mutex_unlock(&kk_relais_q_mutex);
+   for (struct kk_relais_job *n; drop; drop = n) {
+      n = drop->next;
+      atomic_fetch_add(&kk_stat_relais_dropped, 1);
+      kk_relais_job_free(drop);
+   }
+}
