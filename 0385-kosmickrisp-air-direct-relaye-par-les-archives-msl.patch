+   pthread_mutex_unlock(&kk_relais_lib_mutex);
+   if (msl == nil)
+      return nil;
+   MTL4LibraryFunctionDescriptor *n = [[MTL4LibraryFunctionDescriptor new] autorelease];
+   n.name = lfd.name;
+   n.library = msl;
+   *changed = true;
+   return n;
+}
