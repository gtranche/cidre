-                if (NtWaitForAlertByThreadId( NULL, &grace ) == STATUS_ALERTED)
+                if (futex_sleep( &grace ) == STATUS_ALERTED)
                 {
                     ret = STATUS_ALERTED;
                     break;
@@ -983,7 +1027,7 @@
     }
     else
 #endif
-    ret = NtWaitForAlertByThreadId( NULL, timeout );
+    ret = futex_sleep( timeout );
 
     /* We may have already been removed by a call to RtlWakeAddressSingle() or RtlWakeAddressAll(). */
     if (entry.addr)
@@ -1006,7 +1050,7 @@
 static void sonde_alerte_groupee( HANDLE *tids, unsigned int count, const void *addr )
 {
 #ifdef SONDE_GEL
-    NTSTATUS st = NtAlertMultipleThreadByThreadId( tids, count, NULL, NULL );
+    NTSTATUS st = futex_wake( tids, count );
 
     if (st)
