+            if (apres != sonde_avant && InterlockedIncrement( &dits ) <= 20)
+                ERR( "SONDE gel : fil %04x, %ld alertes comptees pendant l'attente mais"
+                     " drapeau=%ld -- l'alerte n'est pas arrivee jusqu'ici\n",
+                     (int)sonde_tid, (long)(apres - sonde_avant), (long)*futex );
         }
-        return STATUS_ALERTED;
+#endif
+        return status;
     }
 #elif defined(HAVE_KQUEUE)
     {
@@ -4275,6 +4287,54 @@
         return status;
     }
