+}
+
+
+/***********************************************************************
+ *           wait_on_address_sleep
+ *
+ * L'attente de RtlWaitOnAddress du ntdll natif. Elle ne passe pas par l'alerte
+ * de NtWaitForAlertByThreadId : ce drapeau-la appartient a l'invite. Sous un
+ * emulateur, le fil qui execute l'invite execute aussi l'emulateur, et celui-ci
+ * prend ses verrous entre deux instructions de l'invite. Une attente de
+ * l'emulateur qui partagerait le drapeau reprendrait l'alerte que l'invite
+ * vient de recevoir -- le reveil de son RtlWaitOnAddress a lui, deja retire de
+ * sa file -- et l'invite s'endormirait ensuite pour de bon.
+ */
+NTSTATUS wait_on_address_sleep( void *args )
+{
+    const struct wait_on_address_sleep_params *params = args;
+#ifdef USE_FUTEX
+    union tid_alert_entry *entry = get_tid_alert_entry( ULongToHandle(get_thread_data()->tid) );
+
+    if (!entry) return STATUS_INVALID_CID;
+    return wait_alert_futex( &entry->futex[1], params->timeout );
+#else
+    return NtWaitForAlertByThreadId( NULL, params->timeout );
+#endif
+}
+
+
+/***********************************************************************
+ *           wait_on_address_wake
+ */
+NTSTATUS wait_on_address_wake( void *args )
+{
+    const struct wait_on_address_wake_params *params = args;
+    unsigned int i;
+
+    for (i = 0; i < params->count; i++)
+    {
+#ifdef USE_FUTEX
+        union tid_alert_entry *entry = get_tid_alert_entry( params->tids[i] );
+
+        if (entry && !InterlockedExchange( &entry->futex[1], 1 ))
+            futex_wake_one( &entry->futex[1] );
+#else
+        NtAlertThreadByThreadId( params->tids[i] );
+#endif
+    }
+    return STATUS_SUCCESS;
 }
 
 
