@@ -1017,7 +1061,7 @@
                  " tous sont deja retires de la file\n", count, addr, (unsigned long)st );
     }
 #else
-    NtAlertMultipleThreadByThreadId( tids, count, NULL, NULL );
+    futex_wake( tids, count );
     (void)addr;
 #endif
 }
@@ -1108,7 +1152,7 @@
      */
     if (tid)
     {
-        NTSTATUS st = NtAlertThreadByThreadId( (HANDLE)(DWORD_PTR)tid );
+        NTSTATUS st = futex_wake_one( tid );
 
