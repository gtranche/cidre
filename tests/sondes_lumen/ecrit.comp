#version 450
// Chaque dispatch ecrit son numero (constante poussee) dans sa case, dans le tampon de son
// jeu de descripteurs, et prepare les arguments du dispatch indirect suivant.
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint k; uint total; };
layout(std430, set = 0, binding = 0) buffer O { uint res[]; };
layout(std430, set = 0, binding = 1) buffer A { uint args[]; };
void main() {
   uint i = gl_GlobalInvocationID.x;
   res[k * 64u + i] = k + 1u;
   if (i == 0u) { args[(k + 1u) * 4u + 0u] = 1u; args[(k + 1u) * 4u + 1u] = 1u; args[(k + 1u) * 4u + 2u] = 1u; }
}
