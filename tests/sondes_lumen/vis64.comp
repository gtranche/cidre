#version 450
#extension GL_EXT_shader_image_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// Visbuffer facon Nanite : imageAtomicMax 64 bits (profondeur << 32 | id), sans valeur rendue.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, r64ui) uniform u64image2D vis;
layout(push_constant) uniform P { uint w, h, iters, mode; };
uint hash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }
void main() {
   uint tid = gl_GlobalInvocationID.x;
   for (uint i = 0u; i < iters; i++) {
      uint hh = hash(tid * 7919u + i * 104729u);
      uint pix = (tid / 4u + i * 37u) % (w * h);
      uint64_t v = (uint64_t(hash(hh)) << 32) | uint64_t(tid * iters + i);
      imageAtomicMax(vis, ivec2(pix % w, pix / w), v);
   }
}
