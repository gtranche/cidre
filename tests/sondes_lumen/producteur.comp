#version 450
// Tour t : ecrit t partout (tampon et image de stockage R32ui).
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform P { uint t; uint w; uint h; };
layout(std430, set = 0, binding = 0) buffer D { uint donnees[]; };
layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D img;
void main() {
   uvec2 p = gl_GlobalInvocationID.xy;
   if (p.x >= w || p.y >= h) return;
   donnees[p.y * w + p.x] = t * 1000003u + p.y * w + p.x;
   imageStore(img, ivec2(p), uvec4(t * 1000003u + p.y * w + p.x));
}
