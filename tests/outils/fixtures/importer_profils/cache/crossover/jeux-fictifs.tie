<?xml version="1.0" encoding="UTF-8"?>
<!-- Recettes CrossTie FABRIQUEES pour tests/outils/test_importer_profils.py, a la
     forme de l'archive publique crossover.tie.gz (racine c4p, une entree <app>
     par version minimale de CrossOver). Rien ici ne vient de CodeWeavers. -->
<c4p>
  <highlightedapps>
    <highlightedapp appid="com.codeweavers.c4.90001" platform="Mac"/>
  </highlightedapps>
  <disabledlicenses>
    <id>FixtureSansValeur</id>
  </disabledlicenses>
  <applications>
    <!-- Jeu Fictif, recette d'avant : remplacee par l'entree 24, rien n'en sort -->
    <app appid="com.codeweavers.c4.90001" timestamp="2015-03-01T10:00:00-06:00">
      <cxversion product="cxoffice">13.0</cxversion>
      <name>Jeu Fictif</name>
      <appprofile>
        <description>Prose CrossOver perimee</description>
        <category>Games/Action Games</category>
        <flag>application</flag>
        <bottletemplate>winxp</bottletemplate>
        <steamid>990000001</steamid>
      </appprofile>
      <installprofile>
        <predependency>com.codeweavers.c4.90015</predependency>
        <preinstallregistry>
          <key>HKEY_CURRENT_USER\Software\Wine\DllOverrides</key>
          <value>
            <name>perimee</name>
            <data>native</data>
          </value>
        </preinstallregistry>
      </installprofile>
    </app>
    <!-- Jeu Fictif, recette en vigueur -->
    <app appid="com.codeweavers.c4.90001" timestamp="2024-05-02T09:30:00-05:00">
      <cxversion product="cxoffice">24</cxversion>
      <name>Jeu Fictif</name>
      <name lang="en">Jeu Fictif</name>
      <name lang="de">Erfundenes Spiel</name>
      <appprofile>
        <description>Prose CrossOver : description</description>
        <description lang="en">Prose CrossOver : description</description>
        <comment>Prose CrossOver : commentaire</comment>
        <medal rating="5" platform="Mac" version="24.0.0" num="3" last="2024-06-01T00:00:00-05:00">gold</medal>
        <category>Games/Action Games</category>
        <flag>application</flag>
        <installeddisplaypattern>Jeu Fictif</installeddisplaypattern>
        <bottletemplate purpose="install">winxp</bottletemplate>
        <bottletemplate purpose="use">win7_64</bottletemplate>
        <bottletemplate purpose="use">win10_64</bottletemplate>
        <steamid>990000001</steamid>
      </appprofile>
      <installprofile>
        <comment>Prose CrossOver : commentaire d'installation</comment>
        <installnotes lang="en">Prose CrossOver : notes d'installation</installnotes>
        <predependency>com.codeweavers.c4.90010</predependency>
        <predependency>com.codeweavers.c4.90011</predependency>
        <predependency>com.codeweavers.c4.90012</predependency>
        <predependency>com.codeweavers.c4.90013</predependency>
        <postdependency>com.codeweavers.c4.90014</postdependency>
        <installerdlloverrides>msi,*msiexec.exe=b</installerdlloverrides>
        <installerenvironment>
          <name>WINE_WAIT_CHILD_PIPE_IGNORE</name>
          <value>installeur.exe</value>
        </installerenvironment>
        <preinstallregistry>
          <key>HKEY_CURRENT_USER\Software\Wine\Direct3D</key>
          <value>
            <name>renderer</name>
            <data>vulkan</data>
          </value>
        </preinstallregistry>
        <preinstallregistry>
          <key>HKCU\Software\Wine\AppDefaults\JeuFictif.exe\DllOverrides</key>
          <value>
            <name>dinput8</name>
            <data>native,builtin</data>
          </value>
        </preinstallregistry>
        <preinstallregistry>
          <key>HKEY_LOCAL_MACHINE\Software\StudioFictif</key>
          <value>
            <name>Installe</name>
            <data>dword:1</data>
          </value>
        </preinstallregistry>
        <postinstallregistry>
          <key>HKEY_CURRENT_USER\Software\Wine\DllOverrides</key>
          <value>
            <name>xaudio2_7</name>
            <data>native</data>
          </value>
        </postinstallregistry>
        <postinstallregistry>
          <key>HKCU\Software\Wine\DllOverrides</key>
          <value>
            <name>x3daudio1_7</name>
            <data>native</data>
          </value>
        </postinstallregistry>
        <postinstallregistry>
          <key>HKCU\Software\Wine\DllOverrides</key>
          <value>
            <name>msvcp140</name>
            <data>native, builtin</data>
          </value>
        </postinstallregistry>
        <postinstallregistry>
          <key>HKCU\Software\Wine\DllOverrides</key>
          <value>
            <name>mfplay</name>
            <data>disable</data>
          </value>
        </postinstallregistry>
        <postinstallregistry>
          <key>HKCU\Software\Wine\DllOverrides</key>
          <value>
            <name>d3d11</name>
            <data>builtin</data>
          </value>
        </postinstallregistry>
        <postinstallregistry>
          <key>HKCU\Software\Wine\DllOverrides</key>
          <value>
            <name>piege;winemenubuilder.exe=</name>
            <data>native</data>
          </value>
        </postinstallregistry>
        <postinstallregistry>
          <key>HKCU\Software\Wine\DllOverrides</key>
          <value>
            <name>inconnue</name>
            <data>mode-invente</data>
          </value>
        </postinstallregistry>
      </installprofile>
      <installprofile>
        <useif>
          <equal name="platform">Mac</equal>
        </useif>
        <preinstallenvironment>
          <name>WINED3DMETAL</name>
          <value>1</value>
        </preinstallenvironment>
      </installprofile>
      <installprofile>
        <useif>
          <equal name="platform">Linux</equal>
        </useif>
        <postinstallregistry>
          <key>HKCU\Software\Wine\DllOverrides</key>
          <value>
            <name>linuxseulement</name>
            <data>native</data>
          </value>
        </postinstallregistry>
      </installprofile>
      <installprofile>
        <useif>
          <not>
            <equal name="sourcetype">steam</equal>
          </not>
        </useif>
        <predependency>com.codeweavers.c4.90015</predependency>
      </installprofile>
      <installprofile>
        <useif>
          <equal name="locale">ja</equal>
        </useif>
        <predependency>com.codeweavers.c4.90015</predependency>
      </installprofile>
      <installprofile>
        <useif>
          <and>
            <or>
              <equal name="vulkan.present">yes</equal>
              <equal name="platform">Android</equal>
            </or>
            <match name="bottletemplate">.*_64$</match>
          </and>
        </useif>
        <preinstallenvironment>
          <name>VKD3D_CONFIG</name>
          <value>heap_multi_bind</value>
        </preinstallenvironment>
      </installprofile>
      <installprofile>
        <useif>
          <match name="bottletemplate">(a+)+$</match>
        </useif>
        <predependency>com.codeweavers.c4.90015</predependency>
      </installprofile>
      <installprofile appid="com.codeweavers.c4.90010">
        <postinstallregistry>
          <key>HKCU\Software\Wine\DllOverrides</key>
          <value>
            <name>pouruneautreappli</name>
            <data>native</data>
          </value>
        </postinstallregistry>
      </installprofile>
    </app>
