#version 450
#extension GL_EXT_shader_image_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, r64ui) uniform u64image2D img;
void main() {
   uint i = gl_LocalInvocationIndex;
   uint64_t v = uint64_t(i) + 1ul + (1ul << 40);
   imageAtomicMax(img, ivec2(0, 0), v);
   imageAtomicMin(img, ivec2(1, 0), v);
   if (i == 0u) imageStore(img, ivec2(2, 0), u64vec4(0x123456789abcul));
   if (i == 1u) imageStore(img, ivec2(4, 0), imageLoad(img, ivec2(3, 0)) + 1ul);
}
