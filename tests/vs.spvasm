          %x = OpFSub %float %x1 %float_1
       %andy = OpBitwiseAnd %int %idx %int_2
         %fy = OpConvertSToF %float %andy
         %y1 = OpFMul %float %fy %float_2
          %y = OpFSub %float %y1 %float_1
        %pos = OpCompositeConstruct %v4float %x %y %float_0 %float_1
         %19 = OpAccessChain %_ptr_Output_v4float %_ %int_0
               OpStore %19 %pos
               OpReturn
               OpFunctionEnd
