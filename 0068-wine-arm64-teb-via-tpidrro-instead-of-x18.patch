diff --git aa/dlls/ntdll/thread.c bb/dlls/ntdll/thread.c
index 9e3cd6e4..8f002f79 100644
--- aa/dlls/ntdll/thread.c
+++ bb/dlls/ntdll/thread.c
@@ -730,3 +730,80 @@ void WINAPI DECLSPEC_HOTPATCH RtlProcessFlsData( void *teb_fls_data, ULONG flags
         RtlFreeHeap( GetProcessHeap(), 0, fls );
     }
 }
+
+#if defined(__aarch64__) || defined(__arm64ec__)
+
+/***********************************************************************
+ *           Retrouver le TEB sans x18, sur macOS
+ *
+ * macOS efface x18 a chaque retour du noyau vers l'espace utilisateur,
+ * preemption comprise : aucune frontiere ne permet de le restaurer. En
+ * revanche TPIDRRO_EL0 est lisible en mode utilisateur, propre au fil, et
+ * mesure stable sur deux cents millions de tours la ou x18 tombe en quelques
+ * millions.
+ *
+ * La table est remplie par le cote unix au demarrage de chaque fil, avant que
+ * le moindre code PE ne s'execute -- c'est ce qui brise le cercle, le cote PE
+ * ne pouvant pas obtenir son TEB tant que l'acces ne fonctionne pas.
+ *
+ * L'adressage est ouvert avec sondage lineaire. La table est volontairement
+ * bien plus grande que le nombre de fils attendu, pour que le sondage reste
+ * court.
+ */
+
+#define TEB_TABLE_TAILLE 1024
+
+struct entree_teb
+{
+    ULONG_PTR cle;
+    void     *teb;
+};
+
+struct entree_teb __wine_teb_table[TEB_TABLE_TAILLE] = { { 0 } };
+
+/*
+ * L'emplacement de stockage local ou le cote unix depose le TEB.
+ *
+ * macOS loge le stockage local du fil a l'adresse que donne TPIDRRO_EL0, dont
+ * les trois bits de poids faible portent le numero de coeur. Mesure : la
+ * partie haute est stable sur trois cents millions de tours, et
+ * « [(TPIDRRO_EL0 & ~7) + 8 * cle] » rend bien ce que pthread_setspecific y a
+ * pose. NtCurrentTeb() se reduit donc a quelques instructions, sans appel ni
+ * sondage -- ce qui importe, puisque c'est le chemin le plus chaud de Wine.
+ *
+ * La table reste le repli : tant que la cle n'est pas posee, l'emplacement
+ * vaut zero.
+ */
+unsigned int __wine_teb_tsd_key = 0;
+
+/* __builtin_arm_rsr64 plutot qu'un bloc __asm__ : ce fichier est compile en
+ * mode MSVC, ou la syntaxe d'assembleur en ligne de GCC n'est pas disponible. */
+static inline ULONG_PTR cle_du_fil(void)
+{
+    return (ULONG_PTR)__builtin_arm_rsr64( "tpidrro_el0" );
+}
+
+/***********************************************************************
+ *           __wine_current_teb
+ */
+TEB * WINAPI __wine_current_teb(void)
+{
+    ULONG_PTR cle = cle_du_fil();
+    unsigned int i = (unsigned int)((cle >> 14) % TEB_TABLE_TAILLE);
+    unsigned int n;
+
+    /* Sondage borne : une recherche infructueuse doit coûter quelques
+     * comparaisons, pas mille. Cette fonction est appelee a chaque acces au
+     * TEB, c'est-a-dire partout. */
+    for (n = 0; n < 8; n++)
+    {
+        if (__wine_teb_table[i].cle == cle) return __wine_teb_table[i].teb;
+        if (!__wine_teb_table[i].cle) break;
+        i = (i + 1) % TEB_TABLE_TAILLE;
+    }
+    /* Rien d'enregistre : on retombe sur x18, qui est parfois juste. Rendre
+     * NULL serait pire, car le code appelant ne le teste pas. */
+    return (TEB *)__getReg(18);
+}
+
+#endif /* __aarch64__ || __arm64ec__ */
diff --git aa/dlls/ntdll/unix/signal_arm64.c bb/dlls/ntdll/unix/signal_arm64.c
index 65ec920e..d866c562 100644
--- aa/dlls/ntdll/unix/signal_arm64.c
+++ bb/dlls/ntdll/unix/signal_arm64.c
@@ -337,6 +337,86 @@ static void save_context( CONTEXT *context, const ucontext_t *sigcontext )
 
 #define X18_RESUME_SIZE 16
 
+/*
+ * La table cle -> TEB, logee dans les donnees du ntdll PE.
+ *
+ * macOS efface x18 a chaque retour du noyau, preemption comprise : il n'existe
+ * aucune frontiere ou le restaurer. TPIDRRO_EL0, lui, est lisible en mode
+ * utilisateur, propre au fil, et mesure stable sur deux cents millions de
+ * tours. Le cote unix inscrit la correspondance des le demarrage du fil, avant
+ * que le moindre code PE ne s'execute.
+ */
+#define TEB_TABLE_TAILLE 1024
+
+struct entree_teb
+{
+    ULONG_PTR cle;
+    void     *teb;
+};
+
+struct entree_teb *teb_table;
+unsigned int *teb_tsd_key;      /* pointe la variable exportee par le ntdll PE */
+pthread_key_t cle_teb_globale;
+#define cle_teb cle_teb_globale
+static int cle_teb_prete;
+
+static inline ULONG_PTR cle_du_fil(void)
+{
+    ULONG_PTR v;
+    __asm__ __volatile__( "mrs %0, tpidrro_el0" : "=r"(v) );
+    return v;
+}
+
+/*
+ * La cle est creee a la premiere demande, pas au chargement du ntdll PE : les
+ * premiers fils naissent avant, et n'auraient alors rien enregistre. Son
+ * numero est publie plus tard, quand la variable exportee est connue ; les
+ * emplacements deja remplis restent valides.
+ */
+void creer_cle_teb(void)
+{
+    if (!cle_teb_prete)
+    {
+        if (pthread_key_create( &cle_teb, NULL ))
+        {
+            ERR( "pthread_key_create a echoue\n" );
+            return;
+        }
+        cle_teb_prete = 1;
+    }
+    if (teb_tsd_key) *teb_tsd_key = (unsigned int)cle_teb;
+}
+
+void enregistrer_teb( TEB *teb )
+{
+    /* Enregistrer un TEB nul est pire que ne rien enregistrer : la table le
+     * rendrait ensuite tel quel, au lieu de laisser le repli jouer. */
+    if (!teb) return;
+
+    creer_cle_teb();
+    /* L'acces direct d'abord : c'est lui que le code PE empruntera. */
+    if (cle_teb_prete) pthread_setspecific( cle_teb, teb );
+
+    ULONG_PTR cle = cle_du_fil();
+    unsigned int i, n;
+
+    if (!teb_table) return;
+    i = (unsigned int)((cle >> 14) % TEB_TABLE_TAILLE);
+    /* Meme borne que la recherche : inserer au-dela la rendrait introuvable. */
+    for (n = 0; n < 8; n++)
+    {
+        if (!teb_table[i].cle || teb_table[i].cle == cle)
+        {
+            teb_table[i].teb = teb;
+            teb_table[i].cle = cle;   /* la cle en dernier : le lecteur ne voit
+                                       * jamais une entree a moitie posee */
+            return;
+        }
+        i = (i + 1) % TEB_TABLE_TAILLE;
+    }
+    ERR( "table des TEB saturee\n" );
+}
+
 extern void x18_resume_trampoline(void);
 __ASM_GLOBAL_FUNC( x18_resume_trampoline,
                    "ldr x18, [sp]\n\t"
@@ -1673,6 +1753,13 @@ void init_syscall_frame( LPTHREAD_START_ROUTINE entry, void *arg, TEB *teb )
     I386_CONTEXT *i386_context;
     ARM_CONTEXT *arm_context;
 
+    /* Ici et nulle part ailleurs : pthread_setspecific ecrit dans le fil
+     * appelant. init_syscall_frame s'execute sur le fil qui vient de naitre,
+     * alors que init_teb s'execute sur son parent -- y enregistrer polluait le
+     * creneau du parent et laissait le nouveau fil sans le sien, d'ou un x18
+     * nul dans les repartiteurs. */
+    enregistrer_teb( teb );
+
     context.X0  = (DWORD64)entry;
     context.X1  = (DWORD64)arg;
     context.X18 = (DWORD64)teb;
@@ -1771,8 +1858,31 @@ __ASM_GLOBAL_FUNC( signal_start_thread,
 /***********************************************************************
  *           __wine_syscall_dispatcher
  */
+/*
+ * Recharger x18 a l'entree des repartiteurs.
+ *
+ * Ces fonctions sont en assembleur et lisent le TEB directement dans x18 --
+ * « ldr x10, [x18, #0x378] », le syscall_frame. Sur macOS x18 est efface a
+ * tout moment, d'ou une faute a l'adresse 0x378 : c'est exactement celle qu'on
+ * observait. La correction du TEB cote C ne les couvrait pas.
+ *
+ * On relit donc le TEB dans le stockage local du fil, comme le fait
+ * NtCurrentTeb(). Si l'emplacement est encore vide -- la cle n'est creee qu'au
+ * premier TEB -- on garde x18 tel quel.
+ */
+#define RECHARGER_X18 \
+    "mrs x10, tpidrro_el0\n\t" \
+    "and x10, x10, #0xfffffffffffffff8\n\t" \
+    "adrp x11, " __ASM_NAME("cle_teb_globale") "@PAGE\n\t" \
+    "ldr w11, [x11, " __ASM_NAME("cle_teb_globale") "@PAGEOFF]\n\t" \
+    "ldr x10, [x10, x11, lsl #3]\n\t" \
+    "cbz x10, 9f\n\t" \
+    "mov x18, x10\n\t" \
+    "9:\n\t"
+
 __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "hint 34\n\t" /* bti c */
+                   RECHARGER_X18
                    "ldr x10, [x18, #0x378]\n\t" /* thread_data->syscall_frame */
                    "stp x18, x19, [x10, #0x90]\n\t"
                    "stp x20, x21, [x10, #0xa0]\n\t"
@@ -1933,7 +2043,12 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "movk x0, #0x001c\n\t"
                    "b " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_return") )
 
+/* Atteinte apres le passage par le noyau, donc avec x18 efface : le
+ * rechargement de l'entree des repartiteurs ne la couvrait pas, et sa toute
+ * premiere instruction lit x18. Seuls x10 et x11 sont touches, et x11 est
+ * reecrit juste apres ; x0 porte la valeur de retour et n'est pas concerne. */
 __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher_return,
+                   RECHARGER_X18
                    "ldr w11, [x18, #0x380]\n\t" /* thread_data->syscall_trace */
                    "cbnz x11, " __ASM_LOCAL_LABEL("trace_syscall_ret") "\n\t"
                    "b " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_return") )
@@ -1944,6 +2059,7 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher_return,
  */
 __ASM_GLOBAL_FUNC( __wine_unix_call_dispatcher,
                    "hint 34\n\t" /* bti c */
+                   RECHARGER_X18
                    "ldr x10, [x18, #0x378]\n\t" /* thread_data->syscall_frame */
                    "stp x18, x19, [x10, #0x90]\n\t"
                    "stp x20, x21, [x10, #0xa0]\n\t"
diff --git aa/dlls/ntdll/unix/loader.c bb/dlls/ntdll/unix/loader.c
index ebfb6af5..61f3570b 100644
--- aa/dlls/ntdll/unix/loader.c
+++ bb/dlls/ntdll/unix/loader.c
@@ -436,6 +436,47 @@ char *get_alternate_wineloader( WORD machine )
 }
 
 
+/*
+ * Recopier l'environnement en memoire basse avant d'executer.
+ *
+ * Sur macOS arm64, execve rend EFAULT quand le tableau d'environnement se
+ * trouve tres haut dans l'espace d'adressage. Mesure : les appels dont
+ * « environ » etait vers 47 Gio echouaient, ceux dont il tenait sous 5 Gio
+ * reussissaient -- y compris avec un argv haut. Wine reservant de vastes
+ * plages basses, un realloc de putenv dans le fils de fork peut atterrir
+ * n'importe ou.
+ *
+ * On recopie donc le tableau et ses chaines dans une seule projection demandee
+ * en bas. En cas d'echec on rend l'environnement d'origine : mieux vaut
+ * retenter tel quel que ne rien faire.
+ */
+static char **env_bas(void)
+{
+    extern char **environ;
+    size_t taille = sizeof(char *), n = 0;
+    char *bloc, **tab;
+    unsigned int i;
+
+    if (!environ) return environ;
+    for (n = 0; environ[n]; n++) taille += sizeof(char *) + strlen( environ[n] ) + 1;
+
+    bloc = mmap( (void *)0x110000000, taille, PROT_READ | PROT_WRITE,
+                 MAP_PRIVATE | MAP_ANON, -1, 0 );
+    if (bloc == MAP_FAILED) return environ;
+
+    tab = (char **)bloc;
+    bloc += (n + 1) * sizeof(char *);
+    for (i = 0; i < n; i++)
+    {
+        size_t l = strlen( environ[i] ) + 1;
+        memcpy( bloc, environ[i], l );
+        tab[i] = bloc;
+        bloc += l;
+    }
+    tab[n] = NULL;
+    return tab;
+}
+
 static void preloader_exec( char **argv )
 {
 #ifdef HAVE_WINE_PRELOADER
@@ -452,7 +493,7 @@ static void preloader_exec( char **argv )
     execv( argv[0], argv );
     free( argv[0] );
 #endif
-    execv( argv[1], argv + 1 );
+    execve( argv[1], argv + 1, env_bas() );
 }
 
 /* exec the appropriate wine loader for the specified machine */
@@ -1555,6 +1596,10 @@ static void load_ntdll_functions( HMODULE module )
     void **p__wine_unix_call_dispatcher_arm64ec = NULL;
     unixlib_handle_t *p__wine_unixlib_handle;
     const IMAGE_EXPORT_DIRECTORY *exports;
+#if defined(__aarch64__) && defined(__APPLE__)
+    void *p__wine_teb_table;
+    void *p__wine_teb_tsd_key;
+#endif
 
     exports = get_module_data_dir( module, IMAGE_DIRECTORY_ENTRY_EXPORT, NULL );
     assert( exports );
@@ -1575,6 +1620,19 @@ static void load_ntdll_functions( HMODULE module )
     GET_FUNC( __wine_syscall_dispatcher );
     GET_FUNC( __wine_unix_call_dispatcher );
     GET_FUNC( __wine_unixlib_handle );
+#if defined(__aarch64__) && defined(__APPLE__)
+    /* La table cle -> TEB vit dans les donnees du ntdll PE ; le cote unix la
+     * remplit, le cote PE la consulte depuis NtCurrentTeb(). */
+    GET_FUNC( __wine_teb_table );
+    GET_FUNC( __wine_teb_tsd_key );
+    teb_table = p__wine_teb_table;
+    teb_tsd_key = p__wine_teb_tsd_key;
+    creer_cle_teb();
+    /* Le fil courant a pu demarrer avant que l'adresse de la table ne soit
+     * connue : son enregistrement n'aurait alors rien fait, et chaque acces au
+     * TEB balaierait la table entiere pour ne rien trouver. On l'inscrit ici. */
+    enregistrer_teb( get_thread_data()->teb );
+#endif
     if (is_arm64ec())
     {
         GET_FUNC( __wine_unix_call_dispatcher_arm64ec );
diff --git aa/dlls/ntdll/unix/unix_private.h bb/dlls/ntdll/unix/unix_private.h
index 9b6401ee..82d3435b 100644
--- aa/dlls/ntdll/unix/unix_private.h
+++ bb/dlls/ntdll/unix/unix_private.h
@@ -739,4 +739,12 @@ static inline int is_gdt_sel( WORD sel )
 
 #endif  /* defined(__i386__) || defined(__x86_64__) */
 
+#if defined(__aarch64__) && defined(__APPLE__)
+struct entree_teb;
+extern struct entree_teb *teb_table;
