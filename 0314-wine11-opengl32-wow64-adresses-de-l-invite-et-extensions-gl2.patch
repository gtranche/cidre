diff --color -ruN a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
--- a/dlls/win32u/opengl.c	2026-11-01 18:12:08
+++ b/dlls/win32u/opengl.c	2026-11-01 18:12:08
@@ -239,10 +239,12 @@
 static void parse_current_extensions( BOOLEAN extensions[GL_EXTENSION_COUNT] )
 {
     const struct opengl_funcs *funcs = &display_funcs;
-    int major = 0;
+    const char *version = (const char *)funcs->p_glGetString( GL_VERSION );
+    int major = version ? atoi( version ) : 0;
 
-    funcs->p_glGetIntegerv( GL_MAJOR_VERSION, &major );
-
+    /* Cidre : GL_MAJOR_VERSION n'existe qu'a partir de 3.0 ; sur un contexte 2.1
+     * (le contexte de compatibilite de macOS) la requete laissait GL_INVALID_ENUM
+     * en attente pour l'application. La chaine de version marche partout. */
     if (major >= 3)
     {
         GLint extensions_count;
@@ -256,9 +258,13 @@
     }
     else
     {
-        enum opengl_extension extensions[GL_EXTENSION_COUNT];
-        size_t extension_count = parse_extensions( (const char *)funcs->p_glGetString( GL_EXTENSIONS ), extensions );
-        for (size_t i = 0; i < extension_count; i++) extensions[i] = TRUE;
+        /* Cidre : le tableau local masquait le parametre, et l'indice etait celui
+         * du tableau, pas l'extension : un contexte < 3.0 n'annoncait aucune
+         * extension (wglGetProcAddress rendait NULL pour glActiveTextureARB...). */
+        enum opengl_extension parsed[GL_EXTENSION_COUNT];
+        const char *names = (const char *)funcs->p_glGetString( GL_EXTENSIONS );
+        size_t extension_count = names ? parse_extensions( names, parsed ) : 0;
+        for (size_t i = 0; i < extension_count; i++) extensions[parsed[i]] = TRUE;
     }
 }
 
