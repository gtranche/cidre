+/* Un tableau de GLintptr/GLsizeiptr de l'invite : des entiers, pas des adresses. */
+static inline void *copy_wow64_ints32s( UINT_PTR address, ULONG count )
+{
+    ULONG *ints = ptr_32to64( (ULONG)address );
+    void **tmp;
+
+    if (!ints || !(tmp = calloc( count, sizeof(*tmp) ))) return NULL;
+    while (count--) tmp[count] = ULongToPtr(ints[count]);
+    return tmp;
+}
+
+/*
+ * Pointeur de l'invite qui designe un decalage dans un tampon si un tampon est
+ * lie a la cible (gl*Pointer, indices, pixels sous PBO, indirect) : on ne le
+ * rebase que si rien n'y est lie. Sans base (hors wow64 deplace) c'est
+ * l'identite, sans requete.
+ */
+static inline BOOL wow64_buffer_bound( TEB *teb, GLenum binding )
+{
+    const struct opengl_funcs *funcs = teb->glTable;
+    GLint bound = 0;
+
+    if (!funcs || !funcs->p_glGetIntegerv) return FALSE;
+    funcs->p_glGetIntegerv( binding, &bound );
+    return bound != 0;
+}
+
+static inline void *ptr_32to64_buf( TEB *teb, GLenum binding, ULONG addr )
+{
+    if (!addr || !base_invite()) return ULongToPtr( addr );
+    return wow64_buffer_bound( teb, binding ) ? ULongToPtr( addr ) : ptr_32to64( addr );
+}
+
+static inline void *copy_wow64_ptr32s_buf( TEB *teb, GLenum binding, UINT_PTR address, ULONG count )
+{
+    if (base_invite() && wow64_buffer_bound( teb, binding )) return copy_wow64_ints32s( address, count );
+    return copy_wow64_ptr32s( address, count );
+}
+
 static inline TEB *get_teb64( ULONG teb32 )
 {
     TEB32 *teb32_ptr = ptr_32to64( teb32 );
