+sub wow64_ptr_expr($$)
+{
+    # Cidre : l'invite 32 bits vit a base + A chez l'hote (fenetre au-dela de
+    # 4 Gio). Une adresse de l'invite que le cote unix dereference doit etre
+    # rebasee ; une poignee (HDC...) ou une adresse de code de l'invite (PROC),
+    # jamais dereferencee ici, reste telle quelle. HGLRC, HPBUFFERARB et GLsync
+    # sont des objets clients en memoire de l'invite : ce sont des adresses.
+    my ($arg_type, $expr) = @_;
+    return "ULongToPtr($expr)" if $arg_type =~ /PROC/;
+    return "ULongToPtr($expr)" if $arg_type =~ /^(const )?H[A-Z0-9]+\s*$/ && $arg_type !~ /^(const )?(HGLRC|HPBUFFERARB)\s*$/;
+    return "ptr_32to64($expr)";
+}
+
+# Cidre : certains pointeurs de GL sont des decalages dans un tampon quand un
+# tampon est lie a la cible correspondante (VBO, IBO, PBO, indirect). Ceux-la
+# ne se rebasent que si rien n'est lie ; sinon la valeur passe telle quelle.
+sub wow64_buffer_binding($$)
+{
+    my ($name, $pname) = @_;
+    return undef if $name =~ /^glGet.*Pointerv/;
+    return "GL_ARRAY_BUFFER_BINDING" if $pname eq "pointer" && $name =~ /(Pointer|^glInterleavedArrays)/;
+    return "GL_ELEMENT_ARRAY_BUFFER_BINDING" if $pname eq "indices" && $name =~ /^gl(Multi)?(Mode)?Draw.*Elements/;
+    return "GL_DRAW_INDIRECT_BUFFER_BINDING" if $pname eq "indirect";
+    if ($name =~ /^glGet(n)?(Compressed)?(Tex|Texture|MultiTex)(Sub)?Image/ ||
+        $name =~ /^glReadn?Pixels/ ||
+        $name =~ /^glGetn?(PolygonStipple|ColorTable|ConvolutionFilter|SeparableFilter|Histogram|Minmax)(EXT|SGI|ARB)?$/)
+    {
+        return "GL_PIXEL_PACK_BUFFER_BINDING" if $pname =~ /^(pixels|img|data|mask|table|image|row|column|span|values)$/;
+    }
+    if ($name =~ /^gl(Compressed)?(Tex|Texture|MultiTex)(Sub)?Image/ ||
+        $name =~ /^gl(DrawPixels|PolygonStipple|Bitmap|ColorTable|ColorSubTable|ConvolutionFilter[12]D|SeparableFilter2D)(EXT|SGI|ARB)?$/)
+    {
+        return "GL_PIXEL_UNPACK_BUFFER_BINDING" if $pname =~ /^(pixels|data|bitmap|mask|table|image|row|column)$/;
+    }
+    return undef;
+}
