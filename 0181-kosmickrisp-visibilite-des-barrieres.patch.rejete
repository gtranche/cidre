--- a/src/kosmickrisp/bridge/mtl_encoder.m
+++ b/src/kosmickrisp/bridge/mtl_encoder.m
@@ -11,6 +11,34 @@
 #include <Metal/MTL4Counters.h>
 #include <Metal/MTL4RenderCommandEncoder.h>
 #include <Metal/MTLRenderPass.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+/* Cidre 0181 : visibilite des barrieres MTL4, CIDRE_VISIBILITE_BARRIERES lue une
+ * fois. KK passe toujours ResourceAlias (vider les caches pour que des adresses
+ * virtuelles aliasees soient coherentes), alors que son TODO dit que seules les
+ * requetes d'occlusion l'exigent.
+ *   alias (defaut) : ResourceAlias, comme KK ;
+ *   device         : Device (coherence au niveau de la memoire du GPU) ;
+ *   aucune         : None (ordre d'execution seul, caches laisses en place). */
+static MTL4VisibilityOptions
+kk_visibilite_barrieres(void)
+{
+   static int lu = 0;
+   static MTL4VisibilityOptions v = MTL4VisibilityOptionResourceAlias;
+   if (!__atomic_load_n(&lu, __ATOMIC_ACQUIRE)) {
+      const char *e = getenv("CIDRE_VISIBILITE_BARRIERES");
+      MTL4VisibilityOptions w = MTL4VisibilityOptionResourceAlias;
+      if (e && (!strcmp(e, "aucune") || !strcmp(e, "none")))
+         w = MTL4VisibilityOptionNone;
+      else if (e && !strcmp(e, "device"))
+         w = MTL4VisibilityOptionDevice;
+      v = w;
+      __atomic_store_n(&lu, 1, __ATOMIC_RELEASE);
+   }
+   return v;
+}
 
