+static void
+CidreEcrirePPM(const char *chemin, const D3D11_MAPPED_SUBRESOURCE &map, UINT w, UINT h, DXGI_FORMAT fmt) {
+  FILE *f = fopen(chemin, "wb");
+  if (!f) {
+    WARN("cidre-relire: ouverture de ", chemin, " impossible");
+    return;
+  }
+  fprintf(f, "P6\n%u %u\n255\n", w, h);
+  std::vector<uint8_t> ligne(w * 3);
+  auto sat = [](float v) -> uint8_t { return v <= 0 ? 0 : v >= 1 ? 255 : (uint8_t)(v * 255.0f + 0.5f); };
+  auto f16 = [](uint16_t hv) -> float {
+    uint32_t sg = (hv & 0x8000) << 16, e = (hv >> 10) & 0x1f, m = hv & 0x3ff, x;
+    if (e == 0) x = sg; else if (e == 31) x = sg | 0x7f800000 | (m << 13); else x = sg | ((e - 15 + 127) << 23) | (m << 13);
+    float r; memcpy(&r, &x, 4); return r;
+  };
+  for (UINT y = 0; y < h; y++) {
+    const uint8_t *src = (const uint8_t *)map.pData + (size_t)y * map.RowPitch;
+    for (UINT x = 0; x < w; x++) {
+      uint8_t *d = &ligne[x * 3];
+      switch (fmt) {
+      case DXGI_FORMAT_B8G8R8A8_UNORM: case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB: case DXGI_FORMAT_B8G8R8A8_TYPELESS:
+      case DXGI_FORMAT_B8G8R8X8_UNORM:
+        d[0] = src[x * 4 + 2]; d[1] = src[x * 4 + 1]; d[2] = src[x * 4 + 0]; break;
