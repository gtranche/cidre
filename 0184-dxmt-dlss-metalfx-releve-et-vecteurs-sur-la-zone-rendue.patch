+void
+MTLFXMVScaleContext::copyDepthR32(const Rc<Texture> &depth, const Rc<Texture> &r32) {
+  ctx_.startComputePass(0);
+  auto tex_depth = ctx_.access(depth, depth->fullView, ResourceAccess::Read).texture;
+  auto tex_r32 = ctx_.access(r32, r32->fullView, ResourceAccess::Write).texture;
+
+  auto &setpso = ctx_.encodeComputeCommand<wmtcmd_compute_setpso>();
+  setpso.type = WMTComputeCommandSetPSO;
+  setpso.pso = pso_copy_depth_r32_;
+  setpso.threadgroup_size = {8, 8, 1};
+
+  auto &set0 = ctx_.encodeComputeCommand<wmtcmd_compute_settexture>();
+  set0.type = WMTComputeCommandSetTexture;
+  set0.texture = tex_depth;
+  set0.index = 0;
+
+  auto &set1 = ctx_.encodeComputeCommand<wmtcmd_compute_settexture>();
+  set1.type = WMTComputeCommandSetTexture;
+  set1.texture = tex_r32;
+  set1.index = 1;
+
+  auto &dispatch = ctx_.encodeComputeCommand<wmtcmd_compute_dispatch>();
+  dispatch.type = WMTComputeCommandDispatchThreads;
+  dispatch.size = {r32->width(), r32->height(), 1};
+
+  ctx_.endPass();
