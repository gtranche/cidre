+/* Cidre 0461 (CIDRE_WSI_CADENCE=<Hz>, defaut 0 = coupe) : chaque image reste
+ * affichee au moins 1/Hz s (presentAfterMinimumDuration). A 120 Hz, 30 = pas
+ * regulier de 4 periodes (33,3 ms) tant que l'image est prete a temps, 40 = 3
+ * periodes (25 ms) ; supprime l'alternance 25/33/42/50 ms d'un jeu qui tourne
+ * entre deux pas. La duree demandee est 1/Hz - 1 ms : Metal arrondit a la
+ * periode suivante, une duree exacte de 4 periodes en donnerait parfois 5.
+ * Present simple seulement (pas MetalFX). Lu une fois. */
+static double
+wsi_metal_cadence_s(void)
+{
+   static double s = -1.0;
+   if (s < 0.0) {
+      const char *v = getenv("CIDRE_WSI_CADENCE");
+      double hz = v ? atof(v) : 0.0;
+      s = hz >= 1.0 && hz <= 240.0 ? 1.0 / hz - 0.001 : 0.0;
+      if (s < 0.0)
+         s = 0.0;
+      if (s > 0.0)
+         fprintf(stderr, "[CIDRE_WSI] cadence reguliere : %.1f Hz (duree minimale %.2f ms par image)\n",
+                 hz, s * 1000.0);
+   }
+   return s;
+}
