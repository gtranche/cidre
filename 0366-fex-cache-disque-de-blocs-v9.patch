+  void DiskCache::CidrePrecharger() {
+    const uint64_t T0 = CidreTick();
+    const ssize_t Taille = RWCacheDB ? RWCacheDB->CidreTaille() : -1;
+    if (Taille <= 0) {
+      return;
+    }
+    auto* Base = static_cast<uint8_t*>(FEXCore::Allocator::VirtualAlloc(Taille));
+    if (!Base || Base == reinterpret_cast<uint8_t*>(-1)) {
+      LogMan::Msg::IFmt("cidre disque : prechargement impossible ({} octets)", Taille);
+      return;
+    }
+    CidrePrechargeBase = Base;
+    constexpr uint64_t BLOC = 8ULL << 20;
+    for (uint64_t Off = 0; Off < (uint64_t)Taille;) {
+      const uint64_t N = std::min<uint64_t>(BLOC, Taille - Off);
+      if (!RWCacheDB->CidreLire(Off, {Base + Off, N})) {
+        break;
+      }
+      Off += N;
+      CidrePrechargeTaille.store(Off, std::memory_order_release);
+    }
+    CidrePrechargeTicks.store(CidreTick() - T0, std::memory_order_relaxed);
+    uint64_t F;
+    __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(F));
+    LogMan::Msg::IFmt("cidre disque : precharge {} Mio en {} ms", CidrePrechargeTaille.load() >> 20, F ? (CidreTick() - T0) * 1000 / F : 0);
+  }
