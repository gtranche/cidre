+  bool DiskCache::CidreEmpreinteVive(Core::InternalThreadState* Thread, uint64_t GuestRIP, std::span<const uint32_t> Extents,
+                                     XXH128_hash_t& Out) {
+    XXH3_state_t HashState;
+    XXH3_128bits_reset(&HashState);
+    uint8_t Tampon[512];
+    for (size_t i = 0; i + 1 < Extents.size(); i += 2) {
+      uint64_t A = GuestRIP + Extents[i];
+      uint64_t Reste = Extents[i + 1];
+      while (Reste) {
+        const size_t N = std::min<uint64_t>(Reste, sizeof(Tampon));
+        if (!Thread->FrontendDecoder->CidreRelire(reinterpret_cast<const uint8_t*>(A), Tampon, N)) {
+          return false;
+        }
+        XXH3_128bits_update(&HashState, Tampon, N);
+        A += N;
+        Reste -= N;
+      }
+    }
+    Out = XXH3_128bits_digest(&HashState);
+    return true;
+  }
