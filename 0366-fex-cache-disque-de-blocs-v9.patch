+bool FEX::Windows::SousPages::CodeArmeRapide(uint64_t Adresse, uint64_t Taille) {
+  if (!Actif || !Taille) {
+    return false;
+  }
+  if (GenSections && *GenSections != GenVuePub.load(std::memory_order_acquire)) {
+    NbArmeLent.fetch_add(1, std::memory_order_relaxed);
