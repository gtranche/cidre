+void Arm64JITCore::CidreChargerSonnette(ARMEmitter::Register Reg, uint64_t Page) {
+  if (!SupportCodeRelocations) {
+    LoadConstant(ARMEmitter::Size::i64Bit, Reg, Page);
+    return;
+  }
+  Relocation MoveABI = Relocation::Default();
+  MoveABI.GuestPatchableData.Header = {.Offset = GetCursorOffset(), .Type = RelocationTypes::RELOC_CIDRE_SONNETTE_MOVE};
+  MoveABI.GuestPatchableData.RegisterIndex = Reg.Idx();
+  LoadConstant(ARMEmitter::Size::i64Bit, Reg, Page, FEXCore::CPU::Arm64Emitter::PadType::DOPAD);
+  Relocations.emplace_back(MoveABI);
+}
