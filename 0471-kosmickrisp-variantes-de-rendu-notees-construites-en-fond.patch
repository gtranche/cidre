+}
+
+/* La paire peut-elle etre notee ? (VS non differe, vrai FS) */
+static bool
+kk_var_apte(struct kk_device *dev, mtl_function_descriptor *vs_function,
+            const struct kk_shader *vs, const struct kk_shader *fs)
+{
+   return vs != NULL && fs != NULL && vs_function != NULL &&
+          vs_function == vs->function && vs->vs_nir == NULL &&
+          vs->emu_vs_nir == NULL && !vs->info.has_gs &&
+          vs->vk.stage == MESA_SHADER_VERTEX &&
+          fs->vk.stage == MESA_SHADER_FRAGMENT && fs != vs->fallback_fs &&
+          fs != dev->empty_fs && fs->function != NULL;
+}
+
+static void
+kk_var_noter(struct kk_device *dev, mtl_function_descriptor *vs_function,
+             struct kk_shader *vs, struct kk_shader *fs,
+             const struct kk_rp_variant_key *full)
+{
+   if (kk_var_table == NULL || !kk_var_apte(dev, vs_function, vs, fs))
+      return;
+   uint8_t rec[8 + 2 * KK_BASE_CLE + KK_VAR_OCTETS];
+   const uint32_t magic = KK_VAR_MAGIC, octets = 2 * KK_BASE_CLE + KK_VAR_OCTETS;
+   memcpy(rec, &magic, 4);
+   memcpy(rec + 4, &octets, 4);
+   memcpy(rec + 8, vs->vk.pipeline.cache_key, KK_BASE_CLE);
+   memcpy(rec + 8 + KK_BASE_CLE, fs->vk.pipeline.cache_key, KK_BASE_CLE);
+   memcpy(rec + 8 + 2 * KK_BASE_CLE, (const char *)full + KK_VAR_DEBUT,
+          KK_VAR_OCTETS);
+   simple_mtx_lock(&kk_var_lock);
+   const bool neuve = kk_var_ajouter_locked(rec + 8, full);
+   if (neuve && kk_var_fd >= 0 && write(kk_var_fd, rec, sizeof(rec)) != (ssize_t)sizeof(rec)) {
+      close(kk_var_fd);
+      kk_var_fd = -1;
+   }
+   simple_mtx_unlock(&kk_var_lock);
+   atomic_fetch_add(&kk_stat_var[neuve ? 2 : 6], 1);
+}
