+static void
+kk_var_charger(const char *chemin)
+{
+   int fd = open(chemin, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return;
+   const size_t taille = 8 + 2 * KK_BASE_CLE + KK_VAR_OCTETS;
+   uint8_t buf[8 + 2 * KK_BASE_CLE + KK_VAR_OCTETS];
+   struct kk_rp_variant_key k;
+   unsigned rejetes = 0;
+   for (;;) {
+      ssize_t r = read(fd, buf, 8);
+      if (r != 8)
+         break;
+      uint32_t magic, octets;
+      memcpy(&magic, buf, 4);
+      memcpy(&octets, buf + 4, 4);
+      if (magic != KK_VAR_MAGIC || octets > 4096) {
+         rejetes++;
+         break; /* fichier abime : on garde ce qui precede */
+      }
+      if (octets != 2 * KK_BASE_CLE + KK_VAR_OCTETS) {
+         /* autre version de la cle : sautee */
+         if (lseek(fd, octets, SEEK_CUR) < 0)
+            break;
+         rejetes++;
+         continue;
+      }
+      if (read(fd, buf + 8, octets) != (ssize_t)octets)
+         break;
+      memset(&k, 0, sizeof(k));
+      memcpy((char *)&k + KK_VAR_DEBUT, buf + 8 + 2 * KK_BASE_CLE,
+             KK_VAR_OCTETS);
+      if (kk_var_ajouter_locked(buf + 8, &k))
+         atomic_fetch_add(&kk_stat_var[0], 1);
+   }
+   (void)taille;
+   close(fd);
+   if (rejetes)
+      fprintf(stderr, "kk: variantes notees : %u enregistrements rejetes dans %s\n",
+              rejetes, chemin);
+}
