+/* Copie les variantes notees de la paire (cles VS, FS) ; NULL si aucune.
+ * dernier_vs != NULL : rien si cette paire vient d'etre mise en file pour
+ * ce meme VS. */
+static struct kk_rp_variant_key *
+kk_var_copier(const uint8_t *vs_cle, const uint8_t *fs_cle, uint32_t *n,
+              const void *dernier_vs)
+{
+   *n = 0;
+   if (kk_var_table == NULL)
+      return NULL;
+   uint8_t cles[2 * KK_BASE_CLE];
+   memcpy(cles, vs_cle, KK_BASE_CLE);
+   memcpy(cles + KK_BASE_CLE, fs_cle, KK_BASE_CLE);
+   struct kk_rp_variant_key *v = NULL;
+   simple_mtx_lock(&kk_var_lock);
+   struct hash_entry *e = _mesa_hash_table_search(kk_var_table, cles);
+   struct kk_var_paire *p = e ? e->data : NULL;
+   if (p != NULL && p->n > 0 &&
+       (dernier_vs == NULL || p->dernier_vs != dernier_vs)) {
+      v = malloc(p->n * sizeof(*v));
+      if (v != NULL) {
+         memcpy(v, p->v, p->n * sizeof(*v));
+         *n = p->n;
+         if (dernier_vs != NULL)
+            p->dernier_vs = dernier_vs;
+      }
+   }
+   simple_mtx_unlock(&kk_var_lock);
+   return v;
+}
