+kk_var_ceder(struct kk_device *dev)
+{
+   if (!kk_fond_cede())
+      return;
+   while (atomic_load(&kk_binds_en_attente) != 0 && !atomic_load(&dev->var_arret))
+      usleep(500);
+}
+
+static void
+kk_var_execute(void *data, UNUSED void *gdata, UNUSED int thread_index)
+{
+   struct kk_var_job *j = data;
+   struct kk_device *dev = j->dev;
+   struct kk_shader *vs = j->vs, *fs = j->fs;
+   kk_qos_fil(QOS_CLASS_UTILITY);
+   kk_var_ceder(dev);
+   if (atomic_load(&dev->var_arret))
+      goto fin;
+   /* Bibliotheques : prises sur ce fil si personne ne les a lancees, sinon
+    * attendues (bornees : un fil de compilation mort ne fige pas la file). */
+   struct kk_shader *paire[2] = {vs, fs};
+   for (unsigned i = 0; i < 2; i++) {
+      if (kk_travail_en_attente(paire[i]) && kk_shader_prendre(paire[i]))
+         atomic_fetch_add(&kk_stat_var[7], 1);
+   }
+   for (unsigned i = 0; i < 2; i++) {
+      struct kk_shader *s = paire[i];
+      if (!s->compile_async)
+         continue;
+      kk_shader_kick(s);
+      if (!util_queue_fence_wait_timeout(&s->compile_ready,
+                                         os_time_get_absolute_timeout(10ll * 1000000000ll))) {
+         atomic_fetch_add(&kk_stat_var[5], 1);
+         goto fin;
+      }
+   }
+   if (kk_shader_compile_failed(vs) || kk_shader_compile_failed(fs) ||
+       !kk_var_apte(dev, vs->function, vs, fs)) {
+      atomic_fetch_add(&kk_stat_var[5], 1);
+      goto fin;
+   }
+   for (uint32_t k = 0; k < j->n && !atomic_load(&dev->var_arret); k++) {
+      kk_var_ceder(dev);
+      struct kk_rp_variant_key *key = &j->v[k];
+      key->vs_function = vs->function;
+      key->fs_function = fs->function;
+      simple_mtx_lock(&dev->rp_variant_lock);
+      const bool deja = _mesa_hash_table_search(dev->rp_variant_cache, key) != NULL;
+      simple_mtx_unlock(&dev->rp_variant_lock);
+      if (deja) {
+         atomic_fetch_add(&kk_stat_var[4], 1);
+         continue;
+      }
+      const int64_t t0 = os_time_get_nano();
+      if (kk_get_render_pipeline_variant(dev, vs->function, vs, fs, key) != NULL) {
+         atomic_fetch_add(&kk_stat_var[3], 1);
+         atomic_fetch_add(&kk_stat_var_us[0], (uint64_t)(os_time_get_nano() - t0) / 1000u);
+      }
+   }
+fin:
+   vk_pipeline_cache_object_unref(&dev->vk, &vs->vk.pipeline.cache_obj);
+   vk_pipeline_cache_object_unref(&dev->vk, &fs->vk.pipeline.cache_obj);
+   free(j->v);
+   free(j);
+   atomic_fetch_sub(&dev->var_en_file, 1);
+}
+
+/* Crochet de creation : met en file les variantes notees de la paire. */
+static void
+kk_var_enfiler(struct kk_device *dev, uint32_t count,
+               struct vk_shader *const *shaders)
+{
+   if (atomic_load(&dev->var_arret))
+      return;
+   struct kk_shader *vs = NULL, *fs = NULL;
+   for (uint32_t i = 0; i < count; i++) {
+      if (shaders[i]->stage == MESA_SHADER_VERTEX)
+         vs = container_of(shaders[i], struct kk_shader, vk);
+      else if (shaders[i]->stage == MESA_SHADER_FRAGMENT)
+         fs = container_of(shaders[i], struct kk_shader, vk);
+      else if (shaders[i]->stage == MESA_SHADER_GEOMETRY ||
+               shaders[i]->stage == MESA_SHADER_TESS_CTRL ||
+               shaders[i]->stage == MESA_SHADER_TESS_EVAL)
+         return;
+   }
+   if (vs == NULL || fs == NULL)
+      return;
+   uint32_t n;
+   struct kk_rp_variant_key *v =
+      kk_var_copier(vs->vk.pipeline.cache_key, fs->vk.pipeline.cache_key, &n, vs);
+   if (v == NULL)
+      return;
+   struct kk_var_job *j = calloc(1, sizeof(*j));
+   if (j == NULL) {
+      free(v);
+      return;
+   }
+   j->dev = dev;
+   j->vs = vs;
+   j->fs = fs;
+   j->n = n;
+   j->v = v;
+   vk_pipeline_cache_object_ref(&vs->vk.pipeline.cache_obj);
+   vk_pipeline_cache_object_ref(&fs->vk.pipeline.cache_obj);
+   atomic_fetch_add(&dev->var_en_file, 1);
+   atomic_fetch_add(&kk_stat_var[8], 1);
+   util_queue_add_job(&dev->var_queue, j, NULL, kk_var_execute, NULL, 0);
+}
+
+static void
+kk_var_init(struct kk_device *dev)
+{
+   dev->var_queue_ok = false;
+   atomic_store(&dev->var_arret, false);
+   atomic_store(&dev->var_en_file, 0);
+   const char *v = getenv("CIDRE_VARIANTES");
+   if (v != NULL && v[0] == '0')
+      return;
+   simple_mtx_lock(&kk_var_lock);
+   if (kk_var_table == NULL) {
+      char chemin[1024];
+      chemin[0] = '\0';
+      if (v != NULL && v[0] == '/')
+         snprintf(chemin, sizeof(chemin), "%s", v);
+      else if (dev->pipeline_cache_dir != NULL && dev->pipeline_cache_dir[0])
+         snprintf(chemin, sizeof(chemin), "%s/variantes-kk.bin", dev->pipeline_cache_dir);
+      if (chemin[0]) {
+         kk_var_table = _mesa_hash_table_create(NULL, kk_var_hash, kk_var_egal);
+         if (kk_var_table != NULL) {
+            kk_var_charger(chemin);
+            kk_var_fd = open(chemin, O_WRONLY | O_APPEND | O_CREAT | O_CLOEXEC, 0644);
+            fprintf(stderr, "kk: variantes notees : %u variantes, %u paires (%s)\n",
+                    atomic_load(&kk_stat_var[0]), atomic_load(&kk_stat_var[1]), chemin);
+         }
+      }
+   }
+   const bool table = kk_var_table != NULL;
+   simple_mtx_unlock(&kk_var_lock);
+   /* Le rejeu construit les variantes lui-meme (kk_rejeu_execute). */
+   if (!table || !kk_var_fond_actif() || getenv("CIDRE_REJEU") != NULL)
+      return;
+   const unsigned n = kk_env_u("CIDRE_VARIANTES_FILS", 3);
+   if (n == 0)
+      return;
+   dev->var_queue_ok = util_queue_init(&dev->var_queue, "kkvar", 4096, CLAMP(n, 1, 16),
+                                       UTIL_QUEUE_INIT_RESIZE_IF_FULL, NULL);
+   if (dev->var_queue_ok)
+      dev->vk.cidre_shaders_crees = kk_shaders_crees;
+}
+
+static void
+kk_var_finish(struct kk_device *dev)
+{
+   if (!dev->var_queue_ok)
+      return;
+   atomic_store(&dev->var_arret, true);
+   for (unsigned n = 0; atomic_load(&dev->var_en_file) != 0; n++) {
+      if (n == 60000) {
+         fprintf(stderr, "[CIDRE] vkDestroyDevice : %u travaux de variantes "
+                         "toujours en file apres 60 s\n",
+                 atomic_load(&dev->var_en_file));
+         break;
+      }
+      usleep(1000);
+   }
+   util_queue_destroy(&dev->var_queue);
+   dev->var_queue_ok = false;
+}
