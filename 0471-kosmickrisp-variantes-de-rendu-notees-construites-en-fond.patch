+/* Cidre (0471) : variantes de rendu notees et construites hors du fil
+ * d'encodage.
+ *
+ * Une variante de rendu (kk_get_render_pipeline_variant) est un
+ * MTLRenderPipelineState par paire VS+FS et par etat de cibles (formats lies,
+ * melange, masques, topologie). Elle n'existe qu'en memoire : chaque partie
+ * reconstruit au dessin toutes celles qu'elle emploie (Diablo IV, 09/11 :
+ * 869 au dessin / 2,6 s, 264 en 2 s a l'entree dans le monde), et le
+ * prechauffage 0237 ne devine que la cle « formats declares », souvent fausse
+ * (cibles liees en plus, masques) et absente des bibliotheques relues.
+ *
+ * Ici :
+ *  - chaque variante construite au dessin est notee (cles de cache Vulkan du
+ *    VS et du FS, blake3, plus la cle de variante sans les pointeurs) dans un
+ *    fichier par jeu, ajout seul : <MESA_KK_PIPELINE_CACHE>/variantes-kk.bin,
+ *    ou CIDRE_VARIANTES=<fichier> ;
+ *  - a la creation d'un pipeline graphique (crochet cidre_shaders_crees), si
+ *    sa paire a des variantes notees, un travail part dans une file a part
+ *    (kkvar, CIDRE_VARIANTES_FILS=3 fils, QoS utility) : il compile les
+ *    bibliotheques si personne ne l'a fait (meme chemin qu'un bind, sur ce
+ *    fil), puis construit toutes les variantes notees. Il cede aux binds en
+ *    attente comme la file de fond (0464). Le dessin les trouve en table.
+ *
+ * CIDRE_VARIANTES=0 : tout coupe (ni note ni fond). CIDRE_VARIANTES_FOND=0 :
+ * note seulement. Le rejeu (0444) construit aussi les variantes notees de
+ * chaque paire rejouee. Compteurs : ligne « KK compile: variantes ».
+ * Seules les paires a VS non differe (pas de vs_nir, pas d'emulation, pas de
+ * GS) et a vrai FS sont notees : la fonction du VS ne depend que du VS. */
+
+#define KK_BASE_CLE 32u /* (meme definition que la base 0444, plus bas) */
+#define KK_VAR_MAGIC 0x3156524bu /* "KRV1" */
+#define KK_VAR_DEBUT offsetof(struct kk_rp_variant_key, formats)
+#define KK_VAR_OCTETS (sizeof(struct kk_rp_variant_key) - KK_VAR_DEBUT)
+
+struct kk_var_paire {
+   uint8_t cles[2 * KK_BASE_CLE];
+   uint32_t n, cap;
+   struct kk_rp_variant_key *v; /* pointeurs de fonction nuls */
+   const void *dernier_vs;      /* dernier VS mis en file (doublons) */
+};
+
+static simple_mtx_t kk_var_lock = SIMPLE_MTX_INITIALIZER;
+static struct hash_table *kk_var_table;
+static int kk_var_fd = -1;
+
+static uint32_t
+kk_var_hash(const void *k)
+{
+   return _mesa_hash_data(k, 2 * KK_BASE_CLE);
 }
 
+static bool
+kk_var_egal(const void *a, const void *b)
+{
+   return memcmp(a, b, 2 * KK_BASE_CLE) == 0;
+}
+
+/* Vrai si ajoutee (absente jusque-la). */
+static bool
+kk_var_ajouter_locked(const uint8_t *cles, const struct kk_rp_variant_key *k)
+{
+   struct hash_entry *e = _mesa_hash_table_search(kk_var_table, cles);
+   struct kk_var_paire *p = e ? e->data : NULL;
+   if (p == NULL) {
+      p = rzalloc(kk_var_table, struct kk_var_paire);
+      if (p == NULL)
+         return false;
+      memcpy(p->cles, cles, sizeof(p->cles));
+      _mesa_hash_table_insert(kk_var_table, p->cles, p);
+      atomic_fetch_add(&kk_stat_var[1], 1);
+   }
+   for (uint32_t i = 0; i < p->n; i++) {
+      if (memcmp((const char *)&p->v[i] + KK_VAR_DEBUT,
+                 (const char *)k + KK_VAR_DEBUT, KK_VAR_OCTETS) == 0)
+         return false;
+   }
+   if (p->n == p->cap) {
+      uint32_t cap = p->cap ? p->cap * 2 : 4;
+      struct kk_rp_variant_key *v =
+         reralloc(p, p->v, struct kk_rp_variant_key, cap);
+      if (v == NULL)
+         return false;
+      p->v = v;
+      p->cap = cap;
+   }
+   memset(&p->v[p->n], 0, sizeof(p->v[p->n]));
+   memcpy((char *)&p->v[p->n] + KK_VAR_DEBUT, (const char *)k + KK_VAR_DEBUT,
+          KK_VAR_OCTETS);
+   p->n++;
+   return true;
+}
