+static void
+kk_base_ecrire(int fd, uint32_t magic, const void *a, size_t na,
+               const void *b, size_t nb)
+{
+   if (fd < 0)
+      return;
+   size_t n = 8 + na + nb;
+   uint8_t *buf = malloc(n);
+   if (buf == NULL)
+      return;
+   uint32_t h[2] = {magic, (uint32_t)(na + nb)};
+   memcpy(buf, h, 8);
+   memcpy(buf + 8, a, na);
+   if (nb)
+      memcpy(buf + 8 + na, b, nb);
+   if (write(fd, buf, n) != (ssize_t)n)
+      fprintf(stderr, "kk: base de pipelines : ecriture incomplete\n");
+   free(buf);
