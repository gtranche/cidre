+static bool
 kk_lazy_library(struct kk_device *dev, struct kk_shader *shader)
 {
    if (!kk_paresseux() || !dev->compile_queue_ok)
       return false;
+   kk_msl_compacter(shader, shader->info.stage);
    shader->compile_dev = dev;
    shader->compile_local_size = 0;
    shader->compile_result = VK_SUCCESS;
