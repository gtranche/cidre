+/* Cidre (0444) : bibliotheque paresseuse relue du cache : ne garder que le
+ * MSL compresse jusqu'a la construction. */
+static void
+kk_msl_compacter(struct kk_shader *shader, mesa_shader_stage stage)
+{
+   struct msl_compile_data *data = &shader->msl_data[stage];
+   if (shader->cache_packed[stage] == NULL || shader->cache_packed_length[stage] == 0 ||
+       shader->msl_brut_length[stage] == 0 || data->code == NULL ||
+       cidre_env_actif("CIDRE_GARDER_MSL"))
+      return;
+   char *tenant = ralloc_size(NULL, 1);
+   if (tenant == NULL)
+      return;
+   tenant[0] = '\0';
+   if (data->air != NULL)
+      ralloc_steal(tenant, (void *)data->air);
+   ralloc_free((void *)data->code);
+   data->code = tenant;
+   shader->msl_differe[stage] = true;
+}
+
 static bool
+kk_msl_restaurer(struct kk_shader *shader, mesa_shader_stage stage)
+{
+   if (!shader->msl_differe[stage])
+      return true;
+   struct msl_compile_data *data = &shader->msl_data[stage];
+   const uint32_t n = shader->msl_brut_length[stage];
+   char *code = ralloc_array(NULL, char, n);
+   if (code == NULL ||
+       !util_compress_inflate(shader->cache_packed[stage],
+                              shader->cache_packed_length[stage],
+                              (uint8_t *)code, n)) {
+      ralloc_free(code);
+      return false;
+   }
+   if (data->air != NULL)
+      ralloc_steal(code, (void *)data->air);
+   ralloc_free((void *)data->code);
+   data->code = code;
+   shader->msl_differe[stage] = false;
+   return true;
+}
