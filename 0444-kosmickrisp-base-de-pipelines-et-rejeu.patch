+         blob_write_bytes(b, in->embedded_samplers,
+                          in->embedded_sampler_count * sizeof(struct vk_sampler_state));
+      blob_write_uint32(b, in->set_layout_count);
+      for (uint32_t l = 0; l < in->set_layout_count; l++)
+         kk_base_ecrire_layout(b, in->set_layouts[l]);
+   }
+   kk_base_ecrire_etat(b, &job->state);
+   if (b->out_of_memory) {
+      blob_finish(b);
+      free(e);
+      return;
+   }
+   e->precomp[0] = vk_cidre_precomp_ref(job->precomp[0]);
+   e->precomp[1] = vk_cidre_precomp_ref(job->precomp[1]);
+   atomic_fetch_add(&kk_stat_fond2[7], 1);
+   util_queue_add_job(&kk_base_queue, e, NULL, kk_base_ecrivain, NULL, 0);
+}
+
+/* --- rejeu --- */
+struct kk_rejeu_index {
+   struct hash_table *nuanceurs; /* cle -> decalage (off_t + 1) */
+   struct hash_table *fonctions; /* cle -> struct vk_features * */
+   int fd_n;
+   int fd_f;
+   void *ctx;
+};
+
+static void
+kk_rejeu_noter_n(void *data, const uint8_t *cle, off_t pos, UNUSED uint32_t taille)
+{
+   struct kk_rejeu_index *ix = data;
+   uint8_t *c = ralloc_size(ix->ctx, KK_BASE_CLE);
+   memcpy(c, cle, KK_BASE_CLE);
+   _mesa_hash_table_insert(ix->nuanceurs, c, (void *)(uintptr_t)(pos + 1));
+}
+
+static void
+kk_rejeu_noter_f(void *data, const uint8_t *cle, off_t pos, uint32_t taille)
+{
+   struct kk_rejeu_index *ix = data;
+   if (taille != KK_BASE_CLE + sizeof(struct vk_features))
+      return;
+   struct vk_features *f = ralloc(ix->ctx, struct vk_features);
+   if (pread(ix->fd_f, f, sizeof(*f), pos + KK_BASE_CLE) != sizeof(*f))
+      return;
+   uint8_t *c = ralloc_size(ix->ctx, KK_BASE_CLE);
+   memcpy(c, cle, KK_BASE_CLE);
+   _mesa_hash_table_insert(ix->fonctions, c, f);
+}
+
+static nir_shader *
+kk_rejeu_nir(struct kk_device *dev, struct kk_rejeu_index *ix, const uint8_t *cle,
+             mesa_shader_stage stage, const struct vk_pipeline_robustness_state *rs)
+{
+   struct hash_entry *he = _mesa_hash_table_search(ix->nuanceurs, cle);
+   if (he == NULL)
+      return NULL;
+   off_t pos = (off_t)(uintptr_t)he->data - 1;
+   uint32_t h[2];
+   if (pread(ix->fd_n, h, 8, pos - 8) != 8)
+      return NULL;
+   uint32_t taille = h[1] - KK_BASE_CLE - 4, brut;
+   if (pread(ix->fd_n, &brut, 4, pos + KK_BASE_CLE) != 4)
+      return NULL;
+   uint8_t *c = malloc(taille), *d = malloc(brut);
+   nir_shader *nir = NULL;
+   if (c != NULL && d != NULL &&
+       pread(ix->fd_n, c, taille, pos + KK_BASE_CLE + 4) == (ssize_t)taille &&
+       util_compress_inflate(c, taille, d, brut)) {
+      const struct nir_shader_compiler_options *opts =
+         dev->vk.shader_ops->get_nir_options(dev->vk.physical, stage, rs);
+      struct blob_reader r;
+      blob_reader_init(&r, d, brut);
+      nir = nir_deserialize(NULL, opts, &r);
+      if (r.overrun) {
+         ralloc_free(nir);
+         nir = NULL;
+      }
+   }
+   free(c);
+   free(d);
+   return nir;
+}
+
+static void
+kk_rejeu_layout_detruire(struct vk_device *device,
+                         struct vk_descriptor_set_layout *layout)
+{
+   vk_descriptor_set_layout_destroy(device, layout);
+}
+
+static struct vk_descriptor_set_layout *
+kk_rejeu_lire_layout(struct kk_device *dev, struct blob_reader *r, bool *ycbcr)
+{
+   if (!blob_read_uint32(r))
+      return NULL;
+   uint32_t n = blob_read_uint32(r);
+   uint32_t dyn = blob_read_uint32(r);
+   uint32_t flags = blob_read_uint32(r);
+   if (r->overrun || n > 4096)
+      return NULL;
+   VkDescriptorSetLayoutCreateInfo ci = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .flags = flags,
+   };
+   struct kk_descriptor_set_layout *l = vk_descriptor_set_layout_zalloc(
+      &dev->vk, sizeof(*l) + n * sizeof(l->binding[0]), &ci);
+   if (l == NULL)
+      return NULL;
+   l->vk.destroy = kk_rejeu_layout_detruire;
+   l->vk.dynamic_descriptor_count = dyn;
+   l->binding_count = n;
+   for (uint32_t i = 0; i < n; i++) {
+      struct kk_descriptor_set_binding_layout *bl = &l->binding[i];
+      bl->type = blob_read_uint32(r);
+      bl->flags = blob_read_uint32(r);
+      bl->array_size = blob_read_uint32(r);
+      bl->offset = blob_read_uint32(r);
+      bl->stride = blob_read_uint8(r);
+      bl->dynamic_buffer_index = blob_read_uint8(r);
+      *ycbcr |= blob_read_uint8(r) != 0;
+   }
+   return &l->vk;
+}
+
+struct kk_rejeu_job {
+   struct kk_device *dev;
+   uint8_t vs_cle[KK_BASE_CLE], fs_cle[KK_BASE_CLE];
+   struct vk_shader_compile_info infos[2];
+   struct vk_pipeline_robustness_state rs[2];
+   VkPushConstantRange *pcr[2];
+   struct vk_sampler_state *samplers[2];
+   struct vk_descriptor_set_layout *layouts[2][KK_BASE_MAX_LAYOUTS];
+   struct vk_graphics_pipeline_state state;
+   void *etat_mem;
+   const struct vk_features *features;
+   int fd_fait;
+   _Atomic uint32_t *en_vol;
+   bool ok;
+};
+
+static void
+kk_rejeu_job_free(struct kk_rejeu_job *j)
+{
+   for (unsigned i = 0; i < 2; i++) {
+      for (uint32_t l = 0; l < j->infos[i].set_layout_count; l++) {
+         if (j->layouts[i][l] != NULL)
+            vk_descriptor_set_layout_unref(&j->dev->vk, j->layouts[i][l]);
+      }
+      free(j->pcr[i]);
+      free(j->samplers[i]);
+      if (j->infos[i].nir != NULL)
+         ralloc_free(j->infos[i].nir);
+   }
+   free(j->etat_mem);
+   free(j);
+}
+
+static struct kk_rejeu_job *
+kk_rejeu_lire(struct kk_device *dev, struct kk_rejeu_index *ix,
+              const uint8_t *data, size_t taille)
+{
+   struct blob_reader r;
+   blob_reader_init(&r, data, taille);
+   struct kk_rejeu_job *j = calloc(1, sizeof(*j));
+   if (j == NULL)
+      return NULL;
+   j->dev = dev;
+   blob_copy_bytes(&r, j->vs_cle, KK_BASE_CLE);
+   blob_copy_bytes(&r, j->fs_cle, KK_BASE_CLE);
+   if (blob_read_uint32(&r) != kk_base_signature())
+      goto echec;
+   uint8_t fcle[KK_BASE_CLE];
+   blob_copy_bytes(&r, fcle, KK_BASE_CLE);
+   struct hash_entry *fe = _mesa_hash_table_search(ix->fonctions, fcle);
+   if (fe == NULL)
+      goto echec;
+   j->features = fe->data;
+   bool ycbcr = false;
+   uint8_t pcle[2][KK_BASE_CLE];
+   for (unsigned i = 0; i < 2; i++) {
+      struct vk_shader_compile_info *in = &j->infos[i];
+      in->stage = blob_read_uint32(&r);
+      in->flags = blob_read_uint32(&r);
+      in->next_stage_mask = blob_read_uint32(&r);
+      blob_copy_bytes(&r, pcle[i], KK_BASE_CLE);
+      blob_copy_bytes(&r, &j->rs[i], sizeof(j->rs[i]));
+      in->robustness = &j->rs[i];
+      in->push_constant_range_count = blob_read_uint32(&r);
+      if (in->push_constant_range_count > 64)
+         goto echec;
+      if (in->push_constant_range_count) {
+         size_t sz = in->push_constant_range_count * sizeof(VkPushConstantRange);
+         j->pcr[i] = malloc(sz);
+         blob_copy_bytes(&r, j->pcr[i], sz);
+         in->push_constant_ranges = j->pcr[i];
+      }
+      in->embedded_sampler_count = blob_read_uint32(&r);
+      if (in->embedded_sampler_count > 4096)
+         goto echec;
+      if (in->embedded_sampler_count) {
+         size_t sz = in->embedded_sampler_count * sizeof(struct vk_sampler_state);
+         j->samplers[i] = malloc(sz);
+         blob_copy_bytes(&r, j->samplers[i], sz);
+         in->embedded_samplers = j->samplers[i];
+      }
+      in->set_layout_count = blob_read_uint32(&r);
+      if (in->set_layout_count > KK_BASE_MAX_LAYOUTS)
+         goto echec;
+      for (uint32_t l = 0; l < in->set_layout_count; l++)
+         j->layouts[i][l] = kk_rejeu_lire_layout(dev, &r, &ycbcr);
+      in->set_layouts = j->layouts[i];
+   }
+   /* etat */
+   uint32_t masque = blob_read_uint32(&r);
+   blob_copy_bytes(&r, j->state.dynamic, sizeof(j->state.dynamic));
+   j->state.shader_stages = blob_read_uint32(&r);
+   j->state.pipeline_flags = blob_read_uint64(&r);
+   j->state.feedback_loop_not_input_only = blob_read_uint8(&r);
+   j->state.rasterization_order_access = blob_read_uint32(&r);
+   size_t total = 0, bit = 0;
+#define X(n) if (masque & (1u << bit)) total += sizeof(*j->state.n); bit++;
+   KK_ETAT_SOUS(X)
+#undef X
+   total += sizeof(struct vk_sample_locations_state);
+   j->etat_mem = calloc(1, total);
+   if (j->etat_mem == NULL)
+      goto echec;
+   uint8_t *p = j->etat_mem;
+   bit = 0;
+#define X(n) if (masque & (1u << bit)) { blob_copy_bytes(&r, p, sizeof(*j->state.n)); \
+      j->state.n = (const void *)p; p += sizeof(*j->state.n); } bit++;
+   KK_ETAT_SOUS(X)
+#undef X
+   if (masque & (1u << 31)) {
+      blob_copy_bytes(&r, p, sizeof(struct vk_sample_locations_state));
+      if (j->state.ms != NULL)
+         ((struct vk_multisample_state *)j->state.ms)->sample_locations = (const void *)p;
+   } else if (j->state.ms != NULL) {
+      ((struct vk_multisample_state *)j->state.ms)->sample_locations = NULL;
+   }
+   if (r.overrun || ycbcr)
+      goto echec;
+   for (unsigned i = 0; i < 2; i++) {
+      j->infos[i].nir = kk_rejeu_nir(dev, ix, pcle[i], j->infos[i].stage, &j->rs[i]);
+      if (j->infos[i].nir == NULL)
+         goto echec;
+   }
+   return j;
+echec:
+   kk_rejeu_job_free(j);
+   return NULL;
+}
+
+static void
+kk_rejeu_execute(void *data, UNUSED void *gdata, UNUSED int thread_index)
+{
+   struct kk_rejeu_job *j = data;
+   struct kk_device *dev = j->dev;
+   kk_qos_fil(QOS_CLASS_UTILITY);
+   struct vk_shader *out[2] = {NULL, NULL};
+   kk_frontal_sync = true;
+   VkResult res = kk_compile_shaders_sync(&dev->vk, 2, j->infos, &j->state,
+                                          j->features, &dev->vk.alloc, out);
+   kk_frontal_sync = false;
+   j->infos[0].nir = j->infos[1].nir = NULL; /* consommes */
+   if (res == VK_SUCCESS && out[0] != NULL && out[1] != NULL) {
+      vk_cidre_shader_init_cache_obj(&dev->vk, out[0], j->vs_cle);
+      vk_cidre_shader_init_cache_obj(&dev->vk, out[1], j->fs_cle);
+      struct kk_shader *vs = container_of(out[0], struct kk_shader, vk);
+      struct kk_shader *fs = container_of(out[1], struct kk_shader, vk);
+      kk_frontal_disk_put(dev, vs);
+      kk_frontal_disk_put(dev, fs);
+      /* Pipeline de rendu prechauffe : il part dans l'archive Metal. */
+      if (vs->vs_nir == NULL && vs->function != NULL && fs->function != NULL &&
+          !vs->info.has_gs) {
+         struct kk_rp_variant_key *key = kk_prewarm_key(vs, fs);
+         if (key != NULL) {
+            key->vs_function = vs->function;
+            key->fs_function = fs->function;
+            mtl_render_pipeline_state *st =
+               kk_build_render_pipeline(dev, vs->function, vs, fs, key);
+            if (st != NULL)
+               mtl_release(st);
+            free(key);
+         }
+      }
+      j->ok = true;
+   }
+   for (unsigned i = 0; i < 2; i++) {
+      if (out[i] != NULL)
+         vk_pipeline_cache_object_unref(&dev->vk, &out[i]->pipeline.cache_obj);
+   }
+}
+
+static _Atomic uint32_t kk_rejeu_ok, kk_rejeu_echecs;
+static struct blob kk_rejeu_attente;
+
+/* Ecrit l'archive Metal puis le journal des rejoues du lot. */
+static void
+kk_rejeu_vider(struct kk_device *dev, int fd_fait)
+{
+   mtl_compiler_flush_maintenant(dev->mtl_compiler_handle, dev->pipeline_cache_dir);
+   simple_mtx_lock(&kk_base_lock);
+   if (fd_fait >= 0 && kk_rejeu_attente.size > 0 &&
+       write(fd_fait, kk_rejeu_attente.data, kk_rejeu_attente.size) < 0)
+      fprintf(stderr, "kk: rejeu : journal des rejoues non ecrit\n");
+   kk_rejeu_attente.size = 0;
+   simple_mtx_unlock(&kk_base_lock);
+}
+
+static void
+kk_rejeu_cleanup(void *data, UNUSED void *gdata, UNUSED int thread_index)
+{
+   struct kk_rejeu_job *j = data;
+   if (j->ok) {
+      /* Journal ecrit apres l'ecriture de l'archive du lot (kk_rejeu_vider) :
+       * une interruption ne marque pas fait un pipeline absent de l'archive. */
+      simple_mtx_lock(&kk_base_lock);
+      blob_write_bytes(&kk_rejeu_attente, j->vs_cle, KK_BASE_CLE);
+      simple_mtx_unlock(&kk_base_lock);
+      atomic_fetch_add(&kk_rejeu_ok, 1);
+   } else {
+      atomic_fetch_add(&kk_rejeu_echecs, 1);
+   }
+   atomic_fetch_sub(j->en_vol, 1);
+   kk_rejeu_job_free(j);
+}
+
+struct kk_rejeu_parcours {
+   struct kk_device *dev;
+   struct kk_rejeu_index *ix;
+   struct set *faits;
+   int fd_p, fd_fait;
+   unsigned max, lances, sautes, illisibles, fils;
+   _Atomic uint32_t en_vol;
+};
+
+static void
+kk_rejeu_un(void *data, const uint8_t *cle, off_t pos, uint32_t taille)
+{
+   struct kk_rejeu_parcours *pc = data;
+   if (pc->max && pc->lances >= pc->max)
+      return;
+   if (_mesa_set_search(pc->faits, cle) != NULL) {
+      pc->sautes++;
+      return;
+   }
+   uint8_t *buf = malloc(taille);
+   if (buf == NULL || pread(pc->fd_p, buf, taille, pos) != (ssize_t)taille) {
+      free(buf);
+      return;
+   }
+   struct kk_rejeu_job *j = kk_rejeu_lire(pc->dev, pc->ix, buf, taille);
+   free(buf);
+   if (j == NULL) {
+      pc->illisibles++;
+      return;
+   }
+   _mesa_set_add(pc->faits, ralloc_memdup(pc->faits, cle, KK_BASE_CLE));
+   j->fd_fait = pc->fd_fait;
+   j->en_vol = &pc->en_vol;
+   /* Au plus 4 travaux par fil en vol : memoire bornee. */
+   while (atomic_load(&pc->en_vol) >= 4 * pc->fils)
+      usleep(1000);
+   atomic_fetch_add(&pc->en_vol, 1);
+   pc->lances++;
+   util_queue_add_job(&pc->dev->compile_queue, j, NULL, kk_rejeu_execute,
+                      kk_rejeu_cleanup, 0);
+   /* Archive par lots (CIDRE_REJEU_LOT, 2000) : une archive geante echoue. */
+   const unsigned lot = kk_env_u("CIDRE_REJEU_LOT", 2000);
+   if (lot && pc->lances % lot == 0) {
+      while (atomic_load(&pc->en_vol) != 0)
+         usleep(1000);
+      kk_rejeu_vider(pc->dev, pc->fd_fait);
+   }
+}
+
+static void
+kk_rejeu(struct kk_device *dev)
+{
+   const char *d = getenv("CIDRE_REJEU");
+   if (d == NULL || d[0] != '/' || !dev->compile_queue_ok ||
+       dev->pipeline_cache_dir == NULL)
+      return;
+   const int64_t t0 = os_time_get_nano();
+   struct kk_rejeu_index ix = {0};
+   ix.ctx = ralloc_context(NULL);
+   ix.nuanceurs = _mesa_hash_table_create(ix.ctx, kk_chaud_hash, kk_chaud_egal);
+   ix.fonctions = _mesa_hash_table_create(ix.ctx, kk_chaud_hash, kk_chaud_egal);
+   char chemin[1024];
+   snprintf(chemin, sizeof(chemin), "%s/nuanceurs.bin", d);
+   ix.fd_n = open(chemin, O_RDONLY | O_CLOEXEC);
+   kk_base_parcourir(chemin, KK_BASE_MAGIC_N, NULL, kk_rejeu_noter_n, &ix);
+   snprintf(chemin, sizeof(chemin), "%s/fonctions.bin", d);
+   ix.fd_f = open(chemin, O_RDONLY | O_CLOEXEC);
+   kk_base_parcourir(chemin, KK_BASE_MAGIC_F, NULL, kk_rejeu_noter_f, &ix);
+
+   struct kk_rejeu_parcours pc = {0};
+   pc.dev = dev;
+   pc.ix = &ix;
+   pc.max = kk_env_u("CIDRE_REJEU_MAX", 0);
+   pc.fils = kk_compile_async_threads();
+   pc.faits = _mesa_set_create(NULL, kk_chaud_hash, kk_chaud_egal);
+   snprintf(chemin, sizeof(chemin), "%s/rejoues-kk.bin", dev->pipeline_cache_dir);
+   int fdr = open(chemin, O_RDONLY | O_CLOEXEC);
+   if (fdr >= 0) {
+      uint8_t cle[KK_BASE_CLE];
+      while (read(fdr, cle, KK_BASE_CLE) == KK_BASE_CLE)
+         _mesa_set_add(pc.faits, ralloc_memdup(pc.faits, cle, KK_BASE_CLE));
+      close(fdr);
+   }
+   pc.fd_fait = open(chemin, O_WRONLY | O_APPEND | O_CREAT | O_CLOEXEC, 0644);
+   blob_init(&kk_rejeu_attente);
+   snprintf(chemin, sizeof(chemin), "%s/pipelines.bin", d);
+   pc.fd_p = open(chemin, O_RDONLY | O_CLOEXEC);
+   fprintf(stderr, "kk: rejeu de %s : %u nuanceurs, %u jeux de fonctions, %u deja rejoues\n",
+           d, _mesa_hash_table_num_entries(ix.nuanceurs),
+           _mesa_hash_table_num_entries(ix.fonctions), pc.faits->entries);
+   kk_base_parcourir(chemin, KK_BASE_MAGIC_P, NULL, kk_rejeu_un, &pc);
+   while (atomic_load(&pc.en_vol) != 0)
+      usleep(10000);
+   kk_rejeu_vider(dev, pc.fd_fait);
+   blob_finish(&kk_rejeu_attente);
+   fprintf(stderr, "kk: rejeu fini en %.1f s : %u lances, %u reussis, %u echecs, "
+                   "%u deja faits, %u illisibles\n",
+           (os_time_get_nano() - t0) / 1e9, pc.lances,
+           atomic_load(&kk_rejeu_ok), atomic_load(&kk_rejeu_echecs),
+           pc.sautes, pc.illisibles);
+   if (pc.fd_p >= 0)
+      close(pc.fd_p);
+   if (pc.fd_fait >= 0)
+      close(pc.fd_fait);
+   if (ix.fd_n >= 0)
+      close(ix.fd_n);
+   if (ix.fd_f >= 0)
+      close(ix.fd_f);
+   ralloc_free(pc.faits);
+   ralloc_free(ix.ctx);
+}
