+/* Chantier barrieres : relachement CIBLE des barrieres ALL->ALL de cloture
+ * d'encodeur, par type d'encodeur. L'A/B a prouve ~20-30% de gain GPU en
+ * relachant ces barrieres, mais le frag->frag GLOBAL cassait les encodeurs
+ * compute/blit (corruption/freeze). Ici on met les vraies stages par type.
+ *
+ * CIDRE_NARROW_BARRIERS :
+ *   non defini / 0 -> ALL->ALL (connu-bon).
+ *   1 (ou "targeted") -> relachement cible (defaut du relachement).
+ *   "global" -> ancien frag->frag global (pour comparaison/debug uniquement).
+ * Off par defaut : comportement connu-bon inchange. */
+enum kk_encoder_kind { KK_ENC_RENDER, KK_ENC_COMPUTE };
+
+static int
+kk_narrow_mode(void)
+{
+   static int mode = -1; /* 0=off, 1=targeted, 2=global */
+   if (mode < 0) {
+      const char *v = getenv("CIDRE_NARROW_BARRIERS");
+      if (!v)
+         mode = 0;
+      else if (!strcmp(v, "global"))
+         mode = 2;
+      else
+         mode = 1;
+   }
+   return mode;
+}
