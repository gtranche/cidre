+/* Inscriptions de l'attente en cours, pour les retirer si le fil meurt pendant qu'il dort (TerminateThread :
+ * quit_handler -> abort_thread, dans le fil lui-meme) : une unite remise a un fil mort est re-signalee. Cle pthread
+ * plutot que __thread : le premier acces d'un fil a une variable __thread d'une dylib peut allouer, ce qui n'est pas
+ * permis dans un gestionnaire de signal ; get/setspecific n'allouent pas. Un processus tue en entier laisse ses
+ * inscriptions (limite connue). */
+struct shm_inscriptions
+{
+    struct cidre_sync_slot **slots;
+    const int *registered;
+    const unsigned int *valeurs;
+    const unsigned char *scrute;   /* evenement auto sans place dans la table : compte dans waiters */
+    unsigned int total;
+};
+static pthread_key_t shm_cle_inscrit;
+static BOOL shm_cle_prete;
+
+static void shm_cle_init(void)
+{
+    if (!pthread_key_create( &shm_cle_inscrit, NULL )) shm_cle_prete = TRUE;
+}
+
+/* appele par abort_thread (thread.c) : le fil meurt, peut-etre au milieu d'une attente */
+void cidre_sync_thread_abort(void)
+{
+    struct shm_inscriptions *ins;
+    unsigned int i;
+
+    if (!shm_cle_prete || !(ins = pthread_getspecific( shm_cle_inscrit ))) return;
+    pthread_setspecific( shm_cle_inscrit, NULL );
+    for (i = 0; i < ins->total; i++)
+    {
+        if (ins->scrute[i]) shm_scrutateur_sort( ins->slots[i] );
+        if (shm_unregister( ins->slots[i], ins->registered[i], ins->valeurs[i] ))
+            shm_signaler_auto( ins->slots[i] );   /* unite remise a un mort : a un autre */
+    }
+}
