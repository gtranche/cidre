+/*
+ * Evenements auto : remise directe (Cidre, 0216). Sous Windows, SetEvent sur un evenement auto qu'un fil attend
+ * remet l'unite a CE fil, et l'evenement reste non signale : un second SetEvent en libere un second. Avec un simple
+ * mot d'etat, le second SetEvent tombait sur l'etat encore a 1 (le premier fil reveille n'avait pas repris) et se
+ * perdait, sans garde-fou pour le rattraper : Detroit: Become Human ne presentait jamais une image au demarrage avec
+ * recompilation (2026-10-21). Ici tout dormeur d'un evenement auto s'inscrit dans la table de la case avec le drapeau
+ * SHM_REMISE ; SetEvent prend une inscription par CAS (SHM_ACCORDE) : l'unite appartient a ce fil, l'etat ne bouge
+ * pas. Le fil qui retire son inscription et trouve SHM_ACCORDE possede l'unite : il la prend (meme a l'echeance), ou
+ * la re-signale s'il en a deja une autre (attente multiple). Un fil tue la rend (cidre_sync_thread_abort). Le CAS
+ * departage remise et retrait : l'unite va a un seul fil, jamais perdue, jamais dupliquee. Sans inscrit (ou table
+ * pleine, ou WaitAll), etat = 1 comme avant.
+ */
+
+/* evenement auto (cree par un client) : remise directe possible */
+static inline int shm_par_remise( const struct cidre_sync_slot *slot )
+{
+    return (__atomic_load_n( &slot->flags, __ATOMIC_SEQ_CST ) & CIDRE_SYNC_TYPE_MASK) == INPROC_SYNC_EVENT && !slot->aux;
 }
 
+/* remet une unite a un inscrit qui l'accepte et n'en a pas encore ; 1 si fait */
+static int shm_remettre( struct cidre_sync_slot *slot )
+{
+    unsigned int i, k, v, idx, debut = (unsigned int)GetCurrentThreadId();
+
+    for (k = 0; k < CIDRE_SYNC_WAITER_SLOTS; k++)
+    {
+        i = (debut + k) % CIDRE_SYNC_WAITER_SLOTS;   /* depart variable : pas toujours le meme fil servi */
+        v = __atomic_load_n( &slot->waiter[i], __ATOMIC_SEQ_CST );
+        if (!(v & SHM_REMISE) || (v & SHM_ACCORDE)) continue;
+        if (!__atomic_compare_exchange_n( &slot->waiter[i], &v, v | SHM_ACCORDE, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+            continue;
+        idx = v & SHM_INSCRIT_INDEX;
+        if (idx && idx < CIDRE_SYNC_MAX_SLOTS)
+        {
+            CIDRE_STAT( WAKE_SYSCALL );
+            __atomic_add_fetch( &shm_slots[idx].wake_seq, 1, __ATOMIC_SEQ_CST );
+            os_sync_wake_by_address_all( &shm_slots[idx].wake_seq, 4, SHM_WAKE_FLAGS );
+        }
+        return 1;
+    }
+    return 0;
+}
+
+/* SetEvent d'un evenement auto : remise directe a un inscrit ; sinon une unite en etat. La table d'inscription n'a que
+ * CIDRE_SYNC_WAITER_SLOTS places : au-dela, les dormeurs scrutent l'etat (toutes les 1 ms) et sont comptes dans
+ * waiters (inutilise autrement pour un evenement auto). Tant qu'il reste de ces dormeurs, chaque SetEvent leur doit une
+ * unite : l'etat compte les unites en attente, au plus waiters + 1 (le « + 1 » est l'etat signale qui reste quand
+ * tous ont repris la leur). Rend l'etat d'avant, 0 ou 1. */
+static unsigned int shm_signaler_auto( struct cidre_sync_slot *slot )
+{
+    unsigned int prev, next;
+
+    if (shm_remettre( slot )) return 0;
+    prev = __atomic_load_n( &slot->state, __ATOMIC_SEQ_CST );
+    for (;;)
+    {
+        if (!prev) next = 1;
+        else if (prev <= __atomic_load_n( &slot->waiters, __ATOMIC_SEQ_CST )) next = prev + 1;
+        else return 1;   /* deja signale, personne de plus a servir : SetEvent sans effet, comme sous Windows */
+        if (__atomic_compare_exchange_n( &slot->state, &prev, next, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST )) break;
+    }
+    if (!prev) shm_wake( slot, 0 );
+    return prev != 0;
+}
+
+/* un dormeur en scrutation sort (servi ou non) : waiters-- et plafond des unites en attente a waiters + 1 */
+static void shm_scrutateur_sort( struct cidre_sync_slot *slot )
+{
+    unsigned int n = __atomic_sub_fetch( &slot->waiters, 1, __ATOMIC_SEQ_CST ), v;
+
+    v = __atomic_load_n( &slot->state, __ATOMIC_SEQ_CST );
+    while (v > n + 1 && !__atomic_compare_exchange_n( &slot->state, &v, v - 1, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST )) {}
+}
