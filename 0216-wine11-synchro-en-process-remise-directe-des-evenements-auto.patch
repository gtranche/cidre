+/* une unite remise est-elle arrivee sur cette inscription ? */
+static inline int shm_accordee( struct cidre_sync_slot *slot, int where )
+{
+    return where && (__atomic_load_n( &slot->waiter[where - 1], __ATOMIC_SEQ_CST ) & SHM_ACCORDE);
+}
