+                  if (f == MTLPixelFormatBGRA8Unorm || f == MTLPixelFormatBGRA8Unorm_sRGB) { float t = r; r = b; b = t; }
+               }
+               float l = 0.2126f * r + 0.7152f * g + 0.0722f * b;
+               sr += r; sg += g; sb += b; n++;
+               if (l < 0.02f) noir++;
+               unsigned k = (unsigned)(y * 4 / h) * 4 + (unsigned)(x * 4 / w);
+               grille[k] += l; ng[k]++;
