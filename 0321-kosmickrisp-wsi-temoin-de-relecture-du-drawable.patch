+int
+wsi_metal_relecture_periode(void)
+{
+   static int periode = -1;
+   if (periode < 0) {
+      const char *e = getenv("CIDRE_WSI_RELECTURE");
+      periode = e ? atoi(e) : 0;
+      if (periode < 0)
+         periode = 0;
+   }
+   return periode;
+}
+
+static float
+relecture_demi(uint16_t h)
+{
+   uint32_t s = (h >> 15) & 1, e = (h >> 10) & 31, m = h & 1023;
+   float v = e == 0 ? ldexpf((float)m, -24) : e == 31 ? 65504.0f : ldexpf((float)(m | 1024), (int)e - 25);
+   return s ? -v : v;
+}
