+      if (queue == nil) {
+         queue = [tex.device newCommandQueue];
+         event = [tex.device newSharedEvent];
+      }
+      MTLPixelFormat f = tex.pixelFormat;
+      uint32_t bpp = (f == MTLPixelFormatRGBA16Float) ? 8 : 4;
+      if (!(f == MTLPixelFormatBGRA8Unorm || f == MTLPixelFormatBGRA8Unorm_sRGB || f == MTLPixelFormatRGBA8Unorm ||
+            f == MTLPixelFormatRGBA8Unorm_sRGB || f == MTLPixelFormatRGB10A2Unorm || f == MTLPixelFormatBGR10A2Unorm ||
+            f == MTLPixelFormatRGBA16Float)) {
