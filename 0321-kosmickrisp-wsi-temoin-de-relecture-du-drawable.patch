+      id<MTLBuffer> buf = [tex.device newBufferWithLength:pitch * h options:MTLResourceStorageModeShared];
+      id<MTLCommandBuffer> cb = [queue commandBuffer];
+      if (mtl4_command_queue != NULL) {
+         uint64_t v = ++valeur;
+         [(id<MTL4CommandQueue>)mtl4_command_queue signalEvent:event value:v];
+         [cb encodeWaitForEvent:event value:v];
+      }
+      id<MTLBlitCommandEncoder> bl = [cb blitCommandEncoder];
+      [bl copyFromTexture:tex sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
