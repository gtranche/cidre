+    }
+
+    /* dans le repertoire du serveur (cwd), supprime aussitot : seul le descripteur circule */
+    {
+        char name[] = "sync-shm-XXXXXX";
+        if ((fd = mkstemp( name )) == -1) goto error;
+        unlink( name );
+    }
+    fcntl( fd, F_SETFD, FD_CLOEXEC );
+    if (ftruncate( fd, (off_t)CIDRE_SYNC_MAX_SLOTS * CIDRE_SYNC_SLOT_SIZE ) == -1) goto error;
+    shm_slots = mmap( NULL, (size_t)CIDRE_SYNC_MAX_SLOTS * CIDRE_SYNC_SLOT_SIZE,
+                      PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+    if (shm_slots == MAP_FAILED) { shm_slots = NULL; goto error; }
+    if (!(shm_free = malloc( CIDRE_SYNC_MAX_SLOTS * sizeof(*shm_free) ))) goto error;
+
+    {
+        struct cidre_sync_header *hdr = (struct cidre_sync_header *)shm_slots;
+        hdr->version = 1;
+        hdr->slot_count = CIDRE_SYNC_MAX_SLOTS;
+        __atomic_store_n( &hdr->magic, CIDRE_SYNC_MAGIC, __ATOMIC_SEQ_CST );
+    }
+    shm_high = 1;
+    shm_fd = fd;
+    if (debug_level) fprintf( stderr, "cidre: synchronisation en process activee (memoire partagee, fd %d)\n", fd );
+    return shm_fd;
+
+error:
+    fprintf( stderr, "cidre: synchronisation en process indisponible : %s\n", strerror( errno ) );
+    if (shm_slots) munmap( shm_slots, (size_t)CIDRE_SYNC_MAX_SLOTS * CIDRE_SYNC_SLOT_SIZE );
+    shm_slots = NULL;
+    if (fd != -1) close( fd );
+    return -1;
+}
+
+struct inproc_sync
+{
+    struct object          obj;  /* object header */
+    enum inproc_sync_type  type;
+    int                    fd;   /* ici : index de la case partagee */
+    struct list            entry;
+};
+
+static struct list inproc_mutexes = LIST_INIT( inproc_mutexes );
+
+static void inproc_sync_dump( struct object *obj, int verbose );
+static int inproc_sync_signal( struct object *obj, unsigned int access, int signal );
+static void inproc_sync_destroy( struct object *obj );
+
+static const struct object_ops inproc_sync_ops =
+{
+    .size    = sizeof(struct inproc_sync),
+    .type    = &no_type,
+    .dump    = inproc_sync_dump,
+    .signal  = inproc_sync_signal,
+    .destroy = inproc_sync_destroy,
+};
+
+int get_inproc_sync_fd( struct inproc_sync *sync )
+{
+    if (!sync) return -1;
+    return sync->fd;
+}
+
+/* reveille ce qui dort sur une case : les attentes directes sur &state, puis les attentes multiples inscrites */
+static void shm_wake( struct cidre_sync_slot *slot, int all )
+{
+    unsigned int i, idx;
+
+    __atomic_add_fetch( &slot->wake_seq, 1, __ATOMIC_SEQ_CST );   /* generation de liberation */
+    if (__atomic_load_n( &slot->waiters, __ATOMIC_SEQ_CST ))
+    {
+        if (all) os_sync_wake_by_address_all( &slot->state, 4, OS_SYNC_WAKE_BY_ADDRESS_SHARED );
+        else os_sync_wake_by_address_any( &slot->state, 4, OS_SYNC_WAKE_BY_ADDRESS_SHARED );
+    }
+    for (i = 0; i < CIDRE_SYNC_WAITER_SLOTS; i++)
+    {
+        if (!(idx = __atomic_load_n( &slot->waiter[i], __ATOMIC_SEQ_CST )) || idx >= CIDRE_SYNC_MAX_SLOTS) continue;
+        __atomic_add_fetch( &shm_slots[idx].wake_seq, 1, __ATOMIC_SEQ_CST );
+        os_sync_wake_by_address_all( &shm_slots[idx].wake_seq, 4, OS_SYNC_WAKE_BY_ADDRESS_SHARED );
+    }
+}
+
+static struct cidre_sync_slot *shm_alloc( enum inproc_sync_type type, unsigned int state, unsigned int aux, int *index )
+{
+    struct cidre_sync_slot *slot;
+    unsigned int idx;
+
+    shm_reap_orphans();
+    if (shm_free_count > SHM_REUSE_DELAY || shm_high >= CIDRE_SYNC_MAX_SLOTS)
+    {
+        if (!shm_free_count) return NULL;
+        idx = shm_free[shm_free_head];
+        shm_free_head = (shm_free_head + 1) % CIDRE_SYNC_MAX_SLOTS;
+        shm_free_count--;
+    }
+    else idx = shm_high++;
+
+    slot = &shm_slots[idx];
+    memset( slot->waiter, 0, sizeof(slot->waiter) );
+    slot->waiters = 0;
+    slot->overflow = 0;
+    slot->wake_seq = 0;
+    slot->refs = 0;
+    slot->aux = aux;
+    slot->state = state;
+    __atomic_store_n( &slot->flags, (unsigned int)type, __ATOMIC_SEQ_CST );
+    __atomic_add_fetch( &slot->generation, 1, __ATOMIC_SEQ_CST );   /* publie la case : generation impaire = vivante */
+    *index = idx;
+    return slot;
+}
+
+static void shm_release( int idx )
+{
+    struct cidre_sync_slot *slot = &shm_slots[idx];
+
+    __atomic_or_fetch( &slot->flags, CIDRE_SYNC_DEAD, __ATOMIC_SEQ_CST );
+    __atomic_add_fetch( &slot->generation, 1, __ATOMIC_SEQ_CST );   /* generation paire = libre */
+    shm_wake( slot, 1 );   /* un jeton perime voit la generation changer et rend STATUS_INVALID_HANDLE */
+    shm_free[shm_free_tail] = idx;
+    shm_free_tail = (shm_free_tail + 1) % CIDRE_SYNC_MAX_SLOTS;
+    shm_free_count++;
+}
+
+/* reprend les cases orphelines que plus aucun client ne tient (borne : quelques-unes par appel) */
+static void shm_reap_orphans(void)
+{
+    struct shm_orphan *orphan, *next;
+    unsigned int budget = 16;
+
+    LIST_FOR_EACH_ENTRY_SAFE( orphan, next, &shm_orphans, struct shm_orphan, entry )
+    {
+        if (!budget--) break;
+        if (__atomic_load_n( &shm_slots[orphan->index].refs, __ATOMIC_SEQ_CST )) continue;
+        list_remove( &orphan->entry );
+        shm_release( orphan->index );
+        free( orphan );
+    }
+}
+
+/* l'objet serveur disparait : la case ne peut etre liberee que si aucun client ne la tient encore */
+static void shm_retire( int idx, unsigned int type )
+{
+    struct shm_orphan *orphan;
+
+    if (!__atomic_load_n( &shm_slots[idx].refs, __ATOMIC_SEQ_CST ) || !(orphan = malloc( sizeof(*orphan) )))
+    {
+        shm_release( idx );
+        return;
+    }
+    orphan->index = idx;
+    orphan->type = type;
+    list_add_tail( &shm_orphans, &orphan->entry );
+}
+
+static struct inproc_sync *create_inproc_sync( enum inproc_sync_type type, unsigned int state, unsigned int aux )
+{
+    struct inproc_sync *sync;
+
+    if (!(sync = alloc_object( &inproc_sync_ops ))) return NULL;
+    sync->type = type;
+    list_init( &sync->entry );
+    if (!shm_alloc( type, state, aux, &sync->fd ))
+    {
+        set_error( STATUS_TOO_MANY_OPENED_FILES );
+        release_object( sync );
+        return NULL;
+    }
+    if (type == INPROC_SYNC_MUTEX) list_add_tail( &inproc_mutexes, &sync->entry );
+    return sync;
+}
+
+struct inproc_sync *create_inproc_internal_sync( int manual, int signaled )
+{
+    return create_inproc_sync( INPROC_SYNC_INTERNAL, signaled, manual );
+}
+
+struct inproc_sync *create_inproc_event_sync( int manual, int signaled )
+{
+    return create_inproc_sync( INPROC_SYNC_EVENT, signaled, manual );
+}
+
+struct inproc_sync *create_inproc_mutex_sync( thread_id_t owner, unsigned int count )
+{
+    return create_inproc_sync( INPROC_SYNC_MUTEX, owner, count );
+}
+
+struct inproc_sync *create_inproc_semaphore_sync( unsigned int initial, unsigned int max )
+{
+    return create_inproc_sync( INPROC_SYNC_SEMAPHORE, initial, max );
+}
+
+static void inproc_sync_dump( struct object *obj, int verbose )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    struct cidre_sync_slot *slot = &shm_slots[sync->fd];
+    assert( obj->ops == &inproc_sync_ops );
+    fprintf( stderr, "Inproc sync type=%d, slot=%d state=%u aux=%u waiters=%u\n", sync->type, sync->fd,
+             __atomic_load_n( &slot->state, __ATOMIC_SEQ_CST ), slot->aux, slot->waiters );
+}
+
+void signal_inproc_sync( struct inproc_sync *sync )
+{
+    struct cidre_sync_slot *slot = &shm_slots[sync->fd];
+    if (debug_level) fprintf( stderr, "set_inproc_event %d\n", sync->fd );
+    if (!__atomic_exchange_n( &slot->state, 1, __ATOMIC_SEQ_CST )) shm_wake( slot, slot->aux != 0 );
+}
+
+void reset_inproc_sync( struct inproc_sync *sync )
+{
+    struct cidre_sync_slot *slot = &shm_slots[sync->fd];
+    if (debug_level) fprintf( stderr, "reset_inproc_event %d\n", sync->fd );
+    __atomic_store_n( &slot->state, 0, __ATOMIC_SEQ_CST );
+}
+
+static int inproc_sync_signal( struct object *obj, unsigned int access, int signal )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    assert( obj->ops == &inproc_sync_ops );
+
+    assert( sync->type == INPROC_SYNC_INTERNAL || sync->type == INPROC_SYNC_EVENT ); /* never called for mutex / semaphore */
+    assert( signal == 0 || signal == 1 ); /* never called from signal_object */
+
+    if (signal) signal_inproc_sync( sync );
+    else reset_inproc_sync( sync );
+    return 1;
+}
+
+static void inproc_sync_destroy( struct object *obj )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    assert( obj->ops == &inproc_sync_ops );
+    list_remove( &sync->entry );
+    shm_retire( sync->fd, sync->type );
+}
+
+static void shm_abandon_mutex( struct cidre_sync_slot *slot, thread_id_t tid )
+{
+    unsigned int owner = tid;
+
+    if (__atomic_load_n( &slot->state, __ATOMIC_SEQ_CST ) != tid) return;
+    slot->aux = 0;
+    __atomic_or_fetch( &slot->flags, CIDRE_SYNC_ABANDONED, __ATOMIC_SEQ_CST );
+    if (__atomic_compare_exchange_n( &slot->state, &owner, 0, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+        shm_wake( slot, 0 );
+}
+
+void abandon_inproc_mutexes( thread_id_t tid )
+{
+    struct inproc_sync *mutex;
+    struct shm_orphan *orphan;
+
+    LIST_FOR_EACH_ENTRY( mutex, &inproc_mutexes, struct inproc_sync, entry )
+        shm_abandon_mutex( &shm_slots[mutex->fd], tid );
+    LIST_FOR_EACH_ENTRY( orphan, &shm_orphans, struct shm_orphan, entry )
+        if (orphan->type == INPROC_SYNC_MUTEX) shm_abandon_mutex( &shm_slots[orphan->index], tid );
+}
+
+static int get_obj_inproc_sync( struct object *obj, int *type )
+{
+    struct object *sync;
+    int fd = -1;
+
+    if (!(sync = get_obj_sync( obj ))) return -1;
+    if (sync->ops == &inproc_sync_ops)
+    {
+        struct inproc_sync *inproc = (struct inproc_sync *)sync;
+        *type = inproc->type;
+        fd = inproc->fd;
+    }
+
+    release_object( sync );
+    return fd;
+}
+
+/* repond au client : pas de descripteur, l'index et la generation de la case */
+void send_inproc_sync_fd( struct process *process, int fd, obj_handle_t handle,
+                          unsigned int *shm_index, unsigned int *shm_generation )
+{
+    *shm_index = fd;
+    *shm_generation = __atomic_load_n( &shm_slots[fd].generation, __ATOMIC_SEQ_CST );
+}
+
+/* le client va garder ce jeton dans son cache : il le rendra (refs--) quand il le lachera */
+void add_inproc_sync_client_ref( int fd )
+{
+    __atomic_add_fetch( &shm_slots[fd].refs, 1, __ATOMIC_SEQ_CST );
+}
+
 #else /* NTSYNC_IOC_EVENT_READ */
 
