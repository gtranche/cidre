new file mode 100644
index 00000000..3a7d34c7
--- /dev/null
+++ b/include/wine/cidre_sync.h
@@ -0,0 +1,94 @@
+/*
+ * Synchronisation en process sur macOS : disposition de la memoire partagee
+ *
+ * Copyright 2026 Frantz Benoist (projet Cidre)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * Principe. Wine 11 possede deja une synchronisation « en process » (inproc
+ * sync) : le serveur cree chaque evenement, mutex ou semaphore comme un objet
+ * du pilote Linux ntsync et en passe le descripteur aux clients, qui l'operent
+ * par ioctl sans parler au serveur. macOS n'a pas de pilote equivalent. Ce
+ * fichier decrit son remplacant : le serveur cree UN fichier de memoire
+ * partagee, decoupe en cases de 64 octets ; chaque objet inproc est une case ;
+ * clients et serveur lisent et modifient l'etat par operations atomiques et
+ * dorment ou reveillent par adresse (os_sync_wait_on_address / wake, drapeau
+ * SHARED : verifie, il traverse les processus, voir tests/sonde_sync_xproc.c).
+ * Le serveur ne fait qu'allouer les cases, poser l'etat initial, signaler ou
+ * remettre a zero les evenements internes (processus, fils, fichiers, files de
+ * messages...) et abandonner les mutex d'un fil mort. Il n'attend jamais.
+ *
+ * Attente sur plusieurs objets. Un fil ne peut dormir que sur une adresse.
+ * Chaque fil possede une case (sa case d'alerte APC, que le serveur cree deja
+ * par fil) dont le mot wake_seq lui sert d'oreiller. Pour attendre sur N objets
+ * il s'inscrit dans la petite table waiter[] de chacun ; quiconque change
+ * l'etat d'un objet reveille les fils inscrits (wake_seq++ puis wake). Si la
+ * table est pleine, le fil dort par tranches bornees (scrutation lente, rare).
+ *
+ * Liberation. Sous Windows, SetEvent libere tous les fils qui attendaient a cet
+ * instant, meme si ResetEvent suit aussitot (et PulseEvent ne fait que cela).
+ * Avec un simple mot d'etat, un fil reveille qui relit l'etat apres la remise a
+ * zero se rendormirait : esync, fsync et msync ont ce defaut connu. Ici chaque
+ * signal incremente aussi wake_seq (generation) ; un fil qui s'est declare
+ * dormeur (waiters++) et voit la generation changer est libere, quel que soit
+ * l'etat relu. Les evenements auto et les semaphores restent a prise par CAS.
+ *
+ * Vie d'une case. Le serveur compte les jetons qu'il distribue (refs) ; le
+ * client en rend un quand son cache lache l'objet. A la destruction de l'objet
+ * serveur (dernier handle ferme), la case n'est liberee que si refs == 0 ;
+ * sinon elle devient orpheline : encore valide pour les fils qui la tiennent
+ * (une attente sur un handle ferme continue, comme avec ntsync, et un mutex
+ * orphelin est encore abandonne a la mort de son proprietaire), et le serveur
+ * la reprend plus tard quand refs retombe a 0. Si un processus meurt sans
+ * rendre ses jetons, ses cases orphelines restent perdues (bornee par le
+ * nombre d'objets qu'il tenait). La generation change a chaque liberation :
+ * un jeton perime recoit STATUS_INVALID_HANDLE au lieu d'operer l'objet suivant.
+ */
+
+#ifndef __WINE_WINE_CIDRE_SYNC_H
+#define __WINE_WINE_CIDRE_SYNC_H
+
+#define CIDRE_SYNC_MAGIC        0x30434e53   /* 'SNC0' */
+#define CIDRE_SYNC_SLOT_SIZE    64
+#define CIDRE_SYNC_MAX_SLOTS    (1u << 20)   /* 64 Mio, fichier creux : seules les cases touchees coutent */
+#define CIDRE_SYNC_WAITER_SLOTS 8
+
+/* flags */
+#define CIDRE_SYNC_TYPE_MASK    0x0f         /* enum inproc_sync_type */
+#define CIDRE_SYNC_ABANDONED    0x10         /* mutex : le proprietaire est mort */
+#define CIDRE_SYNC_DEAD         0x20         /* case liberee par le serveur */
+
+struct cidre_sync_slot
+{
+    unsigned int state;       /* evenement : signale (0/1) ; semaphore : compte ; mutex : tid du proprietaire (0 libre) */
+    unsigned int aux;         /* evenement : manuel ; semaphore : maximum ; mutex : compte de recursion */
+    unsigned int flags;       /* CIDRE_SYNC_* */
+    unsigned int generation;  /* incrementee par le serveur a chaque (re)allocation */
+    unsigned int waiters;     /* fils endormis directement sur &state */
+    unsigned int overflow;    /* statistique : inscriptions refusees (table pleine) */
+    unsigned int wake_seq;    /* generation de liberation : +1 a chaque signal ; cases de fil : aussi l'oreiller des attentes multiples */
+    unsigned int refs;        /* references clients (jetons distribues par le serveur, rendus par les clients) */
+    unsigned int waiter[CIDRE_SYNC_WAITER_SLOTS];  /* index des cases de fil inscrites */
+};
+
+struct cidre_sync_header     /* case 0 */
+{
+    unsigned int magic;
+    unsigned int version;
+    unsigned int slot_count;
+    unsigned int reserved[13];
+};
+
+#endif /* __WINE_WINE_CIDRE_SYNC_H */
