+             * wx_reprendre_hors_signal). */
+            mutex_unlock( &virtual_mutex );
+            return STATUS_WX_EXECUTION;
+        }
         pthread_jit_write_protect_np( err == EXCEPTION_EXECUTE_FAULT );
         /* Pas d'invalidation du cache d'instructions ici : l'emulateur fait la
          * sienne apres avoir emis son code, et la faire a chaque bascule
