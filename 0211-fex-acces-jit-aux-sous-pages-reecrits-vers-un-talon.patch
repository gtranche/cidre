+// SPDX-License-Identifier: MIT
+/*
+ * Cidre : acces du code JIT aux pages d'hote mixtes, sans signal.
+ *
+ * Sur Apple Silicon une page d'hote fait 16 Kio. Quand Windows ferme une page
+ * de 4 Kio (PAGE_NOACCESS) a cote de pages accessibles, Wine (correctif 0201)
+ * ferme toute la page d'hote ; chaque acces permis a une voisine fait faute et
+ * Wine le rejoue dans son gestionnaire de signal (~2,4 us). Wine propose alors
+ * l'instruction fautive a FEX (exception de code Code(), levee apres le rejeu)
+ * et FEX la remplace par un saut vers un talon : le talon demande a un
+ * assistant (SousPagesAide) si l'acces tombe sur une page mixte qui le permet
+ * et, si oui, rebase le registre de base sur un alias de la page d'hote le temps
+ * d'executer l'instruction d'origine. Sinon l'instruction s'execute telle
+ * quelle : une page vraiment fermee fait faute au meme endroit et la violation
+ * d'acces de l'invite reste exacte (FixupStubFault).
+ */
+#pragma once
+
+#include <cstdint>
+#include <windef.h>
+#include <winternl.h>
+
+namespace FEXCore::Context {
+class Context;
+}
+namespace FEXCore::Core {
+struct InternalThreadState;
+}
+
+namespace FEX::Windows::SousPages {
+// Annonce a Wine (appel unix de ntdll) ; sans Wine qui le comprend, rien n'est actif.
+void Init(HMODULE NtDll, bool CodeCaching);
+bool Active();
+// Code de l'exception de proposition (Wine), 0 si inactif.
+uint32_t Code();
+
+// Exception de proposition : reecrire l'instruction si on le peut. Le contexte
+// natif est deja apres l'instruction (Wine l'a rejouee) : l'appelant reprend tel quel.
+void HandleProposal(FEXCore::Context::Context* CTX, FEXCore::Core::InternalThreadState* Thread, const EXCEPTION_RECORD* Rec);
+
+// Si Pc est la copie de l'instruction dans un talon, ramene le contexte a
+// l'instruction d'origine (Pc, Sp, registre de base). Unpatch : remettre aussi
+// l'instruction d'origine en place (faute que le talon ne sait pas porter).
+bool FixupStubFault(ARM64_NT_CONTEXT* Context, bool Unpatch);
+} // namespace FEX::Windows::SousPages
