+      // DC ZVA, Xt : adresse dans Rt, 64 octets (DCZID d'Apple)
+      S.Rn = Rt;
+      S.Mode = MODE_ZVA;
+      S.Taille = 64;
+      S.Ecriture = 1;
+    } else if ((I & 0x3a000000u) == 0x28000000u) {
+      // LDP/STP/LDNP/STNP/LDPSW, entier et SIMD
+      uint32_t Opc = I >> 30, V = (I >> 26) & 1, Idx = (I >> 23) & 3, L = (I >> 22) & 1, Rt2 = (I >> 10) & 31, Esz;
+      int64_t Imm7 = (I >> 15) & 0x7f;
+      if (Imm7 & 0x40) {
+        Imm7 -= 0x80;
+      }
+      if (V) {
+        if (Opc == 3) {
+          return false;
+        }
+        Esz = 4u << Opc;
+      } else {
+        if (Opc == 3 || (Opc == 1 && !L)) {
+          return false;
+        }
+        Esz = (Opc & 2) ? 8 : 4;
+      }
+      S.Taille = 2 * Esz;
+      S.Mode = Idx == 1 ? MODE_BASE : MODE_IMM;
+      S.Imm = Imm7 * (int64_t)Esz;
+      Wb = Idx == 1 || Idx == 3;
+      if (L) {
+        S.Lecture = 1;
+        if (!V) {
+          Dests = Gpr(Rt) | Gpr(Rt2);
+        }
+      } else {
+        S.Ecriture = 1;
+        if (!V) {
+          Srcs = Gpr(Rt) | Gpr(Rt2);
+        }
+      }
+    } else if ((I & 0x3b000000u) == 0x39000000u || (I & 0x3b200000u) == 0x38000000u || (I & 0x3b200c00u) == 0x38200800u) {
+      // LDR/STR (et signes, SIMD) : immediat non signe, imm9 (non echelonne, pre, post, non privilegie), registre
+      uint32_t Size = I >> 30, V = (I >> 26) & 1, Opc = (I >> 22) & 3, Echelle;
+      bool Charge;
+      if (V) {
+        if (Opc & 2) {
+          if (Size) {
+            return false;
+          }
+          Echelle = 4;
+        } else {
+          Echelle = Size;
+        }
+        Charge = Opc & 1;
+      } else {
+        Echelle = Size;
+        if ((Size == 3 && Opc == 2) || (Opc == 3 && Size >= 2)) {
+          return false; // PRFM, non alloue
+        }
+        Charge = Opc != 0;
+      }
+      S.Taille = 1u << Echelle;
+      if ((I & 0x3b000000u) == 0x39000000u) {
+        S.Mode = MODE_IMM;
+        S.Imm = (int64_t)((I >> 10) & 0xfff) << Echelle;
+      } else if ((I & 0x3b200c00u) == 0x38200800u) {
+        S.Mode = MODE_REG;
+        S.Rm = (I >> 16) & 31;
+        S.Option = (I >> 13) & 7;
+        S.Shift = ((I >> 12) & 1) ? Echelle : 0;
+        if (S.Option != 2 && S.Option != 3 && S.Option != 6 && S.Option != 7) {
+          return false;
+        }
+      } else {
+        uint32_t Op2 = (I >> 10) & 3;
+        S.Mode = Op2 == 1 ? MODE_BASE : MODE_IMM;
+        S.Imm = Sext9(I);
+        Wb = Op2 == 1 || Op2 == 3;
+      }
+      if (Charge) {
+        S.Lecture = 1;
+        if (!V) {
+          Dests = Gpr(Rt);
+        }
+      } else {
+        S.Ecriture = 1;
+        if (!V) {
+          Srcs = Gpr(Rt);
+        }
+      }
+    } else if ((I & 0x3f200c00u) == 0x38200000u) {
+      // Atomiques LSE (LDADD..LDUMIN, SWP) et LDAPR
+      uint32_t Size = I >> 30, O3 = (I >> 15) & 1, Opc = (I >> 12) & 7, Rs = (I >> 16) & 31;
+      S.Taille = 1u << Size;
+      if (O3 && Opc == 4) {
+        S.Lecture = 1;
+        Dests = Gpr(Rt);
+      } else if (!O3 || Opc == 0) {
+        S.Lecture = S.Ecriture = 1;
+        Srcs = Gpr(Rs);
+        Dests = Gpr(Rt);
+      } else {
+        return false;
+      }
+    } else if ((I & 0x3f000000u) == 0x08000000u) {
+      // Ordonnes (LDAR, STLR...), CAS, CASP ; exclusifs refuses
+      uint32_t Size = I >> 30, O2 = (I >> 23) & 1, L = (I >> 22) & 1, O1 = (I >> 21) & 1, Rs = (I >> 16) & 31;
+      if (O2 && !O1) {
+        S.Taille = 1u << Size;
+        if (L) {
+          S.Lecture = 1;
+          Dests = Gpr(Rt);
+        } else {
+          S.Ecriture = 1;
+          Srcs = Gpr(Rt);
+        }
+      } else if (O2 && O1) {
+        S.Taille = 1u << Size;
+        S.Lecture = S.Ecriture = 1;
+        Srcs = Gpr(Rs) | Gpr(Rt);
+        Dests = Gpr(Rs);
+      } else if (!O2 && O1 && !(I >> 31)) {
+        if ((Rs & 1) || (Rt & 1)) {
+          return false;
+        }
+        S.Taille = 2 * (4u << Size);
+        S.Lecture = S.Ecriture = 1;
+        Srcs = Gpr(Rs) | Gpr(Rs + 1) | Gpr(Rt) | Gpr(Rt + 1);
+        Dests = Gpr(Rs) | Gpr(Rs + 1);
+      } else {
+        return false;
+      }
+    } else if ((I & 0x3f200c00u) == 0x19000000u) {
+      // LDAPUR/STLUR (et signes)
+      uint32_t Size = I >> 30, Opc = (I >> 22) & 3;
+      S.Taille = 1u << Size;
+      S.Mode = MODE_IMM;
+      S.Imm = Sext9(I);
+      if (Opc == 0) {
+        S.Ecriture = 1;
+        Srcs = Gpr(Rt);
+      } else {
+        if ((Opc == 2 && Size == 3) || (Opc == 3 && Size >= 2)) {
+          return false;
+        }
+        S.Lecture = 1;
+        Dests = Gpr(Rt);
+      }
+    } else if ((I & 0xbfbf0000u) == 0x0c000000u || (I & 0xbfa00000u) == 0x0c800000u) {
+      // LD1-4/ST1-4 a plusieurs registres, sans offset ou post-indexe
+      uint32_t L = (I >> 22) & 1, Opcode = (I >> 12) & 15, Q = (I >> 30) & 1, N;
+      switch (Opcode) {
+      case 0x7: N = 1; break;
+      case 0xa:
+      case 0x8: N = 2; break;
+      case 0x6:
+      case 0x4: N = 3; break;
+      case 0x2:
+      case 0x0: N = 4; break;
+      default: return false;
+      }
+      S.Taille = N * (Q ? 16 : 8);
+      Wb = (I >> 23) & 1;
+      if (Wb) {
+        RmIncr = (I >> 16) & 31;
+      }
+      if (L) {
+        S.Lecture = 1;
+      } else {
+        S.Ecriture = 1;
+      }
+    } else if ((I & 0xbf9f0000u) == 0x0d000000u || (I & 0xbf800000u) == 0x0d800000u) {
+      // LD1/ST1 a un element et LD1R, sans offset ou post-indexe
+      uint32_t L = (I >> 22) & 1, R = (I >> 21) & 1, Opcode = (I >> 13) & 7, Sb = (I >> 12) & 1, Size = (I >> 10) & 3;
+      if (R) {
+        return false;
+      }
+      switch (Opcode) {
+      case 0: S.Taille = 1; break;
+      case 2:
+        if (Size & 1) {
+          return false;
+        }
+        S.Taille = 2;
+        break;
+      case 4:
+        if (Size == 0) {
+          S.Taille = 4;
+        } else if (Size == 1 && !Sb) {
+          S.Taille = 8;
+        } else {
+          return false;
+        }
+        break;
+      case 6:
+        if (!L) {
+          return false;
+        }
+        S.Taille = 1u << Size;
+        break;
+      default: return false;
+      }
+      Wb = (I >> 23) & 1;
+      if (Wb) {
+        RmIncr = (I >> 16) & 31;
+      }
+      if (L) {
+        S.Lecture = 1;
+      } else {
+        S.Ecriture = 1;
+      }
+    } else {
+      return false;
+    }
+
+    if (S.Rn == 31 || (Srcs & (1u << S.Rn))) {
+      return false;
+    }
+    if ((S.Mode == MODE_REG && S.Rm == S.Rn) || RmIncr == S.Rn) {
+      return false;
+    }
+    if (Dests & (1u << S.Rn)) {
+      if (Wb) {
+        return false;
+      }
+      S.RnDest = 1;
+    }
+    return S.Taille && S.Taille <= 64;
+  }
+
+  // --- Talon ----------------------------------------------------------------
+  //  T+0   stp x16, x30, [sp, #-16]!
+  //  T+4   ldr x16, T+48                 Site*
+  //  T+8   ldr x30, T+56                 SousPagesCommun
+  //  T+12  blr x30                       Rn += delta (0 : rien), [sp] = delta, [sp+8] = x30
+  //  T+16  ldr x30, [sp, #8]
+  //  T+20  <instruction d'origine>       une faute ici est ramenee a Pc (FixupStubFault)
+  //  T+24  str Sc, [sp, #8]
+  //  T+28  ldr Sc, [sp]
+  //  T+32  sub Rn, Rn, Sc                (nop si l'instruction a charge Rn)
+  //  T+36  ldr Sc, [sp, #8]
+  //  T+40  add sp, sp, #16
+  //  T+44  b Pc+4
+  //  T+48  Site*
+  //  T+56  SousPagesCommun
+  constexpr size_t TailleTalon = 64;
+  constexpr uint32_t STP_X16_X30_PRE = 0xa9bf7bf0u;
+  constexpr uint32_t BLR_X30 = 0xd63f03c0u;
+  constexpr uint32_t LDR_X30_SP_8 = 0xf94007feu;
+  constexpr uint32_t NOP = 0xd503201fu;
+
+  void ClearICache(void* Debut, size_t Taille) {
+    __builtin___clear_cache(static_cast<char*>(Debut), static_cast<char*>(Debut) + Taille);
+  }
+
+  Site* SiteDuTalon(uint64_t FaultPc) {
+    const auto* Code = reinterpret_cast<const uint32_t*>(FaultPc);
+    if (Code[-5] != STP_X16_X30_PRE || Code[-2] != BLR_X30 || Code[-1] != LDR_X30_SP_8) {
+      return nullptr;
+    }
+    auto* S = *reinterpret_cast<Site* const*>(FaultPc + 28);
+    if (!S || S->FaultPc != FaultPc) {
+      return nullptr;
+    }
+    return S;
+  }
+
+  // --- Cache des pages d'hote (lecture sans verrou, sequence par entree) ----
+  struct Entree {
+    std::atomic<uint32_t> Seq;
+    uint32_t Gen;
+    uint64_t Hote;
+    uint64_t Alias;
+    uint32_t Lecture, Ecriture, Mixte;
+  };
+  constexpr size_t NbEntrees = 1024;
+  Entree Cache[NbEntrees];
+
+  struct Etat {
+    uint32_t Gen;
+    uint64_t Alias;
+    uint32_t Lecture, Ecriture, Mixte;
+  };
+
+  bool LireCache(uint64_t Hote, uint32_t Gen, Etat& E) {
+    auto& C = Cache[(Hote >> 14) & (NbEntrees - 1)];
+    const uint32_t S1 = C.Seq.load(std::memory_order_acquire);
+    if (S1 & 1) {
+      return false;
+    }
+    const uint64_t H = std::atomic_ref<uint64_t>(C.Hote).load(std::memory_order_relaxed);
+    E.Gen = std::atomic_ref<uint32_t>(C.Gen).load(std::memory_order_relaxed);
+    E.Alias = std::atomic_ref<uint64_t>(C.Alias).load(std::memory_order_relaxed);
+    E.Lecture = std::atomic_ref<uint32_t>(C.Lecture).load(std::memory_order_relaxed);
+    E.Ecriture = std::atomic_ref<uint32_t>(C.Ecriture).load(std::memory_order_relaxed);
+    E.Mixte = std::atomic_ref<uint32_t>(C.Mixte).load(std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_acquire);
+    return C.Seq.load(std::memory_order_relaxed) == S1 && H == Hote && E.Gen == Gen;
+  }
+
+  void EcrireCache(uint64_t Hote, const Etat& E) {
+    auto& C = Cache[(Hote >> 14) & (NbEntrees - 1)];
+    uint32_t S = C.Seq.load(std::memory_order_relaxed);
+    if ((S & 1) || !C.Seq.compare_exchange_strong(S, S + 1, std::memory_order_acquire)) {
+      return;
+    }
+    std::atomic_ref<uint64_t>(C.Hote).store(Hote, std::memory_order_relaxed);
+    std::atomic_ref<uint32_t>(C.Gen).store(E.Gen, std::memory_order_relaxed);
+    std::atomic_ref<uint64_t>(C.Alias).store(E.Alias, std::memory_order_relaxed);
+    std::atomic_ref<uint32_t>(C.Lecture).store(E.Lecture, std::memory_order_relaxed);
+    std::atomic_ref<uint32_t>(C.Ecriture).store(E.Ecriture, std::memory_order_relaxed);
+    std::atomic_ref<uint32_t>(C.Mixte).store(E.Mixte, std::memory_order_relaxed);
+    C.Seq.store(S + 2, std::memory_order_release);
+  }
+
+  // Compteurs (CIDRE_DIAG_SOUS_PAGES)
+  std::atomic<uint64_t> NbReecrits, NbRefuses, NbAppels, NbAlias, NbRequetes, NbFautes, NbRemis;
+
+  void Compter(std::atomic<uint64_t>& N, const char* Quoi) {
+    const uint64_t V = N.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (Diag && (V <= 4 || !(V & (V - 1)))) {
+      LogMan::Msg::IFmt("sous-pages : {} {} (reecrits {}, refuses {}, appels {}, par l'alias {}, requetes {}, fautes {})", Quoi, V,
+                        NbReecrits.load(), NbRefuses.load(), NbAppels.load(), NbAlias.load(), NbRequetes.load(), NbFautes.load());
+    }
+  }
+} // namespace
+
+void Init(HMODULE NtDll, bool CodeCaching) {
+  const char* Env = getenv("CIDRE_DIAG_SOUS_PAGES");
+  Diag = Env && *Env && *Env != '0';
+  if (CodeCaching) {
+    // Le cache de code sur disque garderait le saut vers un talon disparu.
+    LogMan::Msg::IFmt("sous-pages : cache de code actif, reecriture coupee");
+    return;
+  }
+  const auto Dispatcher = GetProcAddress(NtDll, "__wine_unix_call_dispatcher");
+  const auto Handle = GetProcAddress(NtDll, "__wine_unixlib_handle");
+  if (!Dispatcher || !Handle) {
+    return;
+  }
+  UnixCallDirect = *reinterpret_cast<decltype(__wine_unix_call_dispatcher)*>(Dispatcher);
+  NtdllUnixLib = *reinterpret_cast<unixlib_handle_t*>(Handle);
+  if (!UnixCallDirect || !NtdllUnixLib) {
+    return;
+  }
+  // L'annonce passe par une classe d'information que seul un Wine qui connait
+  // les sous-pages accepte ; l'appel unix (entree 10) n'existe pas ailleurs.
+  Params P {};
+  P.Op = 0;
+  if (NtQueryVirtualMemory(NtCurrentProcess(), nullptr, static_cast<MEMORY_INFORMATION_CLASS>(MemoryCidreSousPages), &P, sizeof(P),
+                           nullptr) ||
+      !P.GenPtr || !P.Code) {
+    return;
+  }
+  Generation = reinterpret_cast<const volatile uint32_t*>(P.GenPtr);
+  CodeProposition = P.Code;
+  Actif = true;
+  if (Diag) {
+    LogMan::Msg::IFmt("sous-pages : reecriture des acces JIT active (code {:#x})", CodeProposition);
+  }
+}
+
+bool Active() {
+  return Actif;
+}
+
+uint32_t Code() {
+  return Actif ? CodeProposition : 0;
+}
+
+// Wine propose une instruction a chaque rejeu tant qu'on ne la lui a pas refusee :
+// toute issue sans reecriture (sauf course avec une autre reecriture) la refuse.
+static void Refuser(uint64_t Pc, uint32_t Insn) {
+  Params P {};
+  P.Op = 3;
+  P.Hote = Pc;
+  P.Code = Insn;
+  Appel(&P);
+}
+
+void HandleProposal(FEXCore::Context::Context* CTX, FEXCore::Core::InternalThreadState* Thread, const EXCEPTION_RECORD* Rec) {
+  if (!Actif || Rec->NumberParameters < 3) {
+    return;
+  }
+  const uint64_t Pc = Rec->ExceptionInformation[0];
+  const uint32_t Insn = static_cast<uint32_t>(Rec->ExceptionInformation[2]);
+
+  // SiteDuTalon lit les 20 octets qui precedent : ils doivent etre dans un tampon de code projete.
+  if (!Thread || (Pc & 3) || !CTX->IsAddressInCodeBuffer(Thread, Pc) || !CTX->IsAddressInCodeBuffer(Thread, Pc - 20) || SiteDuTalon(Pc)) {
+    Refuser(Pc, Insn);
+    return;
+  }
+  auto* Code = reinterpret_cast<uint32_t*>(Pc);
+  if (std::atomic_ref<uint32_t>(*Code).load(std::memory_order_acquire) != Insn) {
+    return;
+  }
+  {
+    std::scoped_lock Lock(SitesVerrou);
+    auto It = Sites.find(Pc);
+    if (It != Sites.end()) {
+      Site* S = It->second;
+      const auto* T = reinterpret_cast<const uint32_t*>(S->Talon);
+      // Le talon peut etre dans un tampon de code deja libere (FEX en a change depuis) : ne le lire, et n'y
+      // sauter, que s'il est encore dans un tampon projete de ce fil (D2R, manche V1 : faute dans SiteDuTalon
+      // pendant le traitement de l'exception, processus tue).
+      const bool TalonVivant = CTX->IsAddressInCodeBuffer(Thread, S->Talon) && CTX->IsAddressInCodeBuffer(Thread, S->Talon + TailleTalon - 1);
+      if (TalonVivant && S->Insn == Insn && SiteDuTalon(S->FaultPc) == S && T[0] == STP_X16_X30_PRE) {
+        std::atomic_ref<uint32_t>(S->Normaux).store(0, std::memory_order_relaxed);
+        uint32_t Attendu = Insn;
+        if (std::atomic_ref<uint32_t>(*Code).compare_exchange_strong(Attendu, S->Saut, std::memory_order_release)) {
+          ClearICache(Code, 4);
+          Compter(NbReecrits, "instruction reecrite de nouveau");
+        }
+        return;
+      }
+      Sites.erase(It); // code regenere a cette adresse : talon perime
+    }
+  }
+  Site D {};
+  if (!Decoder(Insn, D)) {
+    Compter(NbRefuses, "instruction refusee");
+    if (Diag && NbRefuses.load(std::memory_order_relaxed) <= 64) {
+      LogMan::Msg::IFmt("sous-pages : forme non portee {:08x} a {:#x}", Insn, Pc);
+    }
+    Refuser(Pc, Insn);
+    return;
+  }
+  auto* T = reinterpret_cast<uint32_t*>(CTX->AllocateCodeStub(Thread, Pc, TailleTalon));
+  if (!T) {
+    Compter(NbRefuses, "pas de place pour un talon");
+    Refuser(Pc, Insn);
+    return;
+  }
+  auto* S = new Site(D);
+  S->Pc = Pc;
+  S->Insn = Insn;
+  S->FaultPc = reinterpret_cast<uint64_t>(&T[5]);
+
+  const uint32_t Sc = S->Rn == 16 ? 17 : 16;
+  const uint32_t Rn = S->Rn;
+  T[0] = STP_X16_X30_PRE;
+  T[1] = 0x58000000u | ((44 / 4) << 5) | 16; // ldr x16, T+48
+  T[2] = 0x58000000u | ((48 / 4) << 5) | 30; // ldr x30, T+56
+  T[3] = BLR_X30;
+  T[4] = LDR_X30_SP_8;
+  T[5] = Insn;
+  T[6] = 0xf90007e0u | Sc;                                            // str Sc, [sp, #8]
+  T[7] = 0xf94003e0u | Sc;                                            // ldr Sc, [sp]
+  T[8] = S->RnDest ? NOP : (0xcb000000u | (Sc << 16) | (Rn << 5) | Rn); // sub Rn, Rn, Sc
+  T[9] = 0xf94007e0u | Sc;                                            // ldr Sc, [sp, #8]
+  T[10] = 0x910043ffu;                                                // add sp, sp, #16
+  const int64_t Retour = static_cast<int64_t>(Pc + 4) - reinterpret_cast<int64_t>(&T[11]);
+  T[11] = 0x14000000u | ((static_cast<uint64_t>(Retour) >> 2) & 0x3ffffff);
+  *reinterpret_cast<uint64_t*>(&T[12]) = reinterpret_cast<uint64_t>(S);
+  *reinterpret_cast<uint64_t*>(&T[14]) = reinterpret_cast<uint64_t>(&SousPagesCommun);
+  ClearICache(T, TailleTalon);
+
+  const int64_t Aller = reinterpret_cast<int64_t>(T) - static_cast<int64_t>(Pc);
+  const uint32_t Saut = 0x14000000u | ((static_cast<uint64_t>(Aller) >> 2) & 0x3ffffff);
+  S->Talon = reinterpret_cast<uint64_t>(T);
+  S->Saut = Saut;
+  uint32_t Attendu = Insn;
+  if (!std::atomic_ref<uint32_t>(*Code).compare_exchange_strong(Attendu, Saut, std::memory_order_release)) {
+    // Un autre fil l'a deja reecrite (ou FEX l'a changee) : le talon reste inutilise.
+    return;
+  }
+  ClearICache(Code, 4);
+  {
+    std::scoped_lock Lock(SitesVerrou);
+    Sites[Pc] = S;
+  }
+  Compter(NbReecrits, "instruction reecrite");
+  if (Diag && NbReecrits.load(std::memory_order_relaxed) <= 64) {
+    LogMan::Msg::IFmt("sous-pages : {:08x} a {:#x} -> talon {:#x} (Rn x{}, {} octets, {}{})", Insn, Pc, reinterpret_cast<uint64_t>(T),
+                      Rn, S->Taille, S->Lecture ? "l" : "", S->Ecriture ? "e" : "");
+  }
+}
+
+bool FixupStubFault(ARM64_NT_CONTEXT* Context, bool Unpatch) {
+  if (!Actif || (Context->Pc & 3)) {
+    return false;
+  }
+  auto* S = SiteDuTalon(Context->Pc);
+  if (!S) {
+    return false;
+  }
+  const uint64_t Sp = Context->Sp;
+  const uint64_t Delta = *reinterpret_cast<const uint64_t*>(Sp);
+  Context->Pc = S->Pc;
+  Context->Sp = Sp + 16;
+  if (Delta) {
+    Context->X[S->Rn] -= Delta;
+  }
+  if (Unpatch) {
+    auto* Code = reinterpret_cast<uint32_t*>(S->Pc);
+    std::atomic_ref<uint32_t>(*Code).store(S->Insn, std::memory_order_release);
+    ClearICache(Code, 4);
+  }
+  Compter(NbFautes, Unpatch ? "faute dans un talon, instruction remise" : "faute dans un talon");
+  return true;
+}
+} // namespace FEX::Windows::SousPages
