+using namespace FEX::Windows::SousPages;
+
+// Appele par SousPagesCommun (Module.S), registres de l'invite sauves dans
+// Trame (x0-x30, puis sp). Rend le decalage applique a Rn (alias - page d'hote),
+// ou 0 : l'instruction s'executera telle quelle.
+extern "C" uint64_t SousPagesAide(void* SiteV, uint64_t* Trame) {
+  const auto* S = static_cast<const Site*>(SiteV);
+  const uint64_t Base = Trame[S->Rn];
+  uint64_t Ea = Base;
+
+  if (Diag) {
+    Compter(NbAppels, "acces par le talon");
+  }
+  switch (S->Mode) {
+  case MODE_IMM: Ea = Base + S->Imm; break;
+  case MODE_REG: {
+    uint64_t M = S->Rm == 31 ? 0 : Trame[S->Rm];
+    switch (S->Option) {
+    case 2: M = static_cast<uint32_t>(M); break;
+    case 6: M = static_cast<uint64_t>(static_cast<int64_t>(static_cast<int32_t>(M))); break;
+    default: break;
+    }
+    Ea = Base + (M << S->Shift);
+    break;
+  }
+  case MODE_ZVA: Ea = Base & ~uint64_t {63}; break;
+  default: break;
+  }
+
+  const uint64_t Hote = Ea & ~HostPageMask;
+  if (((Ea + S->Taille - 1) & ~HostPageMask) != Hote) {
+    return 0; // a cheval sur deux pages d'hote : Wine rejoue
+  }
+  const uint32_t Gen = *Generation;
+  Etat E;
+  if (!LireCache(Hote, Gen, E)) {
+    Params P {};
+    P.Op = 1;
+    P.Hote = Hote;
+    if (Diag) {
+      Compter(NbRequetes, "requete a Wine");
+    }
+    if (Appel(&P)) {
+      return 0;
+    }
+    E = {P.Gen, P.Alias, P.Lecture, P.Ecriture, P.Mixte};
+    EcrireCache(Hote, E);
+  }
+  if (!E.Mixte || !E.Alias) {
+    auto* SM = const_cast<Site*>(S);
+    if (std::atomic_ref<uint32_t>(SM->Normaux).fetch_add(1, std::memory_order_relaxed) + 1 == SeuilNormaux) {
+      uint32_t Attendu = SM->Saut;
+      auto* Code = reinterpret_cast<uint32_t*>(SM->Pc);
+      if (std::atomic_ref<uint32_t>(*Code).compare_exchange_strong(Attendu, SM->Insn, std::memory_order_release)) {
+        ClearICache(Code, 4);
+        if (Diag) {
+          Compter(NbRemis, "instruction remise (plus de page mixte)");
+        }
+      }
+      std::atomic_ref<uint32_t>(SM->Normaux).store(0, std::memory_order_relaxed);
+    }
+    return 0;
+  }
+  const uint32_t Premiere = (Ea >> 12) & 3, Derniere = ((Ea + S->Taille - 1) >> 12) & 3;
+  const uint32_t Masque = ((2u << Derniere) - 1) & ~((1u << Premiere) - 1);
+  if ((S->Lecture && (E.Lecture & Masque) != Masque) || (S->Ecriture && (E.Ecriture & Masque) != Masque)) {
+    return 0; // page fermee (ou garde, ou suivi d'ecriture) : la faute reste celle de l'invite
+  }
+  if (std::atomic_ref<uint32_t>(const_cast<Site*>(S)->Normaux).load(std::memory_order_relaxed)) {
+    std::atomic_ref<uint32_t>(const_cast<Site*>(S)->Normaux).store(0, std::memory_order_relaxed);
+  }
+  const uint64_t Delta = E.Alias - Hote;
+  Trame[S->Rn] = Base + Delta;
+  if (Diag) {
+    Compter(NbAlias, "acces par l'alias");
+  }
+  return Delta;
+}
