+    if (!(c = calloc( 1, sizeof(*c) )) || !(c->image = malloc( size ? size : 1 ))) { free( c ); return STATUS_NO_MEMORY; }
+    if ((c->fd = fcntl( fd, F_DUPFD_CLOEXEC, 0 )) < 0) { free( c->image ); free( c ); return STATUS_NO_MEMORY; }
+    memcpy( c->image, addr, size );   /* au-dela de la fin du fichier : des zeros, comme la vue */
