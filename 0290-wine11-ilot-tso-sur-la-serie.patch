+void ilot_retour( struct ilot_frame *f, uint64_t x0 )
+{
+    if (ann_en_cours) { ann_appels[ann_en_cours - 1].ret = x0; ann_appels[ann_en_cours - 1].fini = 1; ann_en_cours = 0; }
