+/***********************************************************************
+ *           ilot_exception
+ *
+ * Cidre, ilot TSO (ilot.c) : faute ou exception synchrone du code PE qui tourne dans un vCPU, livree par le meme
+ * chemin que segv_handler, ill_handler et trap_handler pour le code natif. Rien n'est projete ici : la faute est
+ * resolue par virtual_handle_fault (page de garde, write-watch...), et l'instruction est rejouee, ou bien CONTEXT et
+ * EXCEPTION_RECORD sont poses sur la pile de l'invite et le vCPU reprend a KiUserExceptionDispatcher.
+ *   esr_invite = 0 : faute de deuxieme etage refusee pour une protection Windows (va, genre 0 lecture, 1 ecriture,
+ *   8 execution) ; sinon, syndrome ESR_EL1 pris par le vecteur de l'invite (brk, udf, alignement).
+ * Rend 0 : rejouer l'instruction ; 1 : reprendre avec les registres de r (pc, sp, x18 et le reste si un debogueur
+ * a modifie le contexte) ; -1 : syndrome non pris en charge.
+ */
+struct ilot_regs_exc { ULONG64 x[31], sp, pc, nzcv, fpcr, fpsr; ARM64_NT_NEON128 v[32]; };
+C_ASSERT( offsetof( struct ilot_regs_exc, v ) == 0x120 );
+
+/* comme restore_context : un PC de code emule passe par KiUserEmulationDispatcher avec le contexte sous la pile */
+static void ilot_depuis_contexte( struct thread_data *data, const CONTEXT *context, struct ilot_regs_exc *r )
+{
+    unsigned int i;
+    for (i = 0; i < 31; i++) r->x[i] = context->X[i];
+    r->nzcv = context->Cpsr & 0xf0000000;
+    r->fpcr = context->Fpcr; r->fpsr = context->Fpsr;
+    for (i = 0; i < 32; i++) r->v[i] = context->V[i];
+    if (is_emulated_code( context->Pc ))
+    {
+        CONTEXT *user_context = (CONTEXT *)((context->Sp - sizeof(CONTEXT)) & ~15);
+        data->teb->ChpeV2CpuAreaInfo->InSimulation = 1;
+        *user_context = *context;
+        user_context->ContextFlags = CONTEXT_FULL;
+        r->sp = (ULONG64)user_context;
+        r->pc = (ULONG64)pKiUserEmulationDispatcher;
+    }
+    else { r->sp = context->Sp; r->pc = context->Pc; }
+    r->x[18] = (ULONG64)data->teb;
+}
+
+/***********************************************************************
+ *           ilot_sauver_fp_cadre, ilot_suspendre
+ *
+ * Cidre, ilot TSO. Un fil qui rend son vCPU pendant un appel hote (plafond de HVF) met les q, FPCR et FPSR de
+ * l'invite dans le cadre de l'appel, avec CONTEXT_FLOATING_POINT, pour le retour complet. Un fil suspendu dans son
+ * vCPU remet ses registres a wait_suspend, comme usr1_handler hors appel systeme (CONTEXT_EXCEPTION_REPORTING).
+ */
+void ilot_sauver_fp_cadre( const void *q, ULONG64 fpcr, ULONG64 fpsr )
+{
+    struct syscall_frame *frame = get_syscall_frame( get_thread_data() );
+    if (!frame) return;
+    memcpy( frame->v, q, sizeof(frame->v) );
+    frame->fpcr = fpcr;
+    frame->fpsr = fpsr;
+    frame->restore_flags |= CONTEXT_FLOATING_POINT;
+}
+
+void ilot_suspendre( struct ilot_regs_exc *r )
+{
+    struct thread_data *data = get_thread_data();
+    CONTEXT context;
+    unsigned int i;
+
+    memset( &context, 0, sizeof(context) );
+    context.ContextFlags = CONTEXT_FULL | CONTEXT_ARM64_X18 | CONTEXT_EXCEPTION_REPORTING;
+    for (i = 0; i < 31; i++) context.X[i] = r->x[i];
+    context.Sp = r->sp; context.Pc = r->pc; context.Cpsr = r->nzcv & 0xf0000000;
+    context.Fpcr = r->fpcr; context.Fpsr = r->fpsr;
+    for (i = 0; i < 32; i++) context.V[i] = r->v[i];
+    wait_suspend( &context );
+    ilot_depuis_contexte( data, &context, r );
+}
+
+
+/***********************************************************************
+ *           ilot_retour_emulation
+ *
+ * Cidre, ilot TSO : retour avec RESTORE_FLAGS_EMULATION (ARM64EC). Le chemin natif leve SIGUSR2 et usr2_handler
+ * restaure tout depuis le cadre ; ici, meme calcul, rendu dans r pour une entree complete dans le vCPU.
+ */
+void ilot_retour_emulation( struct ilot_regs_exc *r )
+{
+    struct thread_data *data = get_thread_data();
+    struct syscall_frame *frame = get_syscall_frame( data );
+    unsigned int i;
+
+    if (is_emulated_code( frame->pc ))
+    {
+        CONTEXT *user_context = (CONTEXT *)((frame->sp - sizeof(CONTEXT)) & ~15);
+
+        data->teb->ChpeV2CpuAreaInfo->InSimulation = 1;
+        user_context->ContextFlags = CONTEXT_FULL;
+        NtGetContextThread( GetCurrentThread(), user_context );
+        r->sp = (ULONG64)user_context;
+        r->pc = (ULONG64)pKiUserEmulationDispatcher;
+    }
+    else { r->sp = frame->sp; r->pc = frame->pc; }
+    r->x[29] = frame->fp;
+    r->x[30] = frame->lr;
+    r->nzcv  = frame->cpsr & 0xf0000000;
+    for (i = 0; i <= 28; i++) r->x[i] = frame->x[i];
+    r->fpcr = frame->fpcr;
+    r->fpsr = frame->fpsr;
+    memcpy( r->v, frame->v, sizeof(r->v) );
+    r->x[18] = (ULONG64)data->teb;   /* resume_with_x18 */
+}
+
+int ilot_exception( struct ilot_regs_exc *r, ULONG64 va, int genre, ULONG64 esr_invite )
+{
+    struct thread_data *data = get_thread_data();
+    EXCEPTION_RECORD rec = { .ExceptionAddress = (void *)r->pc };
+    struct exc_stack_layout *stack;
+    CONTEXT context;
+    sigset_t ancien;
+    unsigned int i;
+    int ret = 1;
+
+    /* comme dans un gestionnaire de signal : virtual_handle_fault prend virtual_mutex sans masquer les signaux */
+    pthread_sigmask( SIG_BLOCK, &server_block_set, &ancien );
+
+    memset( &context, 0, sizeof(context) );
+    context.ContextFlags = CONTEXT_FULL;
+    for (i = 0; i < 31; i++) context.X[i] = r->x[i];
+    context.Sp = r->sp;
+    context.Pc = r->pc;
+    context.Cpsr = r->nzcv & 0xf0000000;
+    context.Fpcr = r->fpcr;
+    context.Fpsr = r->fpsr;
+    for (i = 0; i < 32; i++) context.V[i] = r->v[i];
+
+    if (!esr_invite)
+    {
+        rec.ExceptionCode = EXCEPTION_ACCESS_VIOLATION;
+        rec.NumberParameters = 2;
+        rec.ExceptionInformation[0] = genre == 1 ? EXCEPTION_WRITE_FAULT : genre == 8 ? EXCEPTION_EXECUTE_FAULT : EXCEPTION_READ_FAULT;
+        rec.ExceptionInformation[1] = va;
+        if (!virtual_handle_fault( data, &rec, (void *)r->sp )) { ret = 0; goto fin; }
+    }
+    else switch (ESR_ELx_EC( esr_invite ))
+    {
+    case ESR_ELx_EC_BRK64:   /* comme trap_handler */
+        rec.ExceptionCode = EXCEPTION_ILLEGAL_INSTRUCTION;
+        switch (ESR_ELx_ISS_BRK_COMMENT( esr_invite ))
+        {
+        case 0xf000: context.Pc += 4; rec.ExceptionCode = EXCEPTION_BREAKPOINT; rec.NumberParameters = 1; break;
+        case 0xf001: rec.ExceptionCode = STATUS_ASSERTION_FAILURE; break;
+        case 0xf003:
+            rec.ExceptionCode = STATUS_STACK_BUFFER_OVERRUN;
+            rec.ExceptionFlags = EXCEPTION_NONCONTINUABLE;
+            rec.NumberParameters = 1;
+            rec.ExceptionInformation[0] = context.X[0];
+            break;
+        case 0xf004: rec.ExceptionCode = EXCEPTION_INT_DIVIDE_BY_ZERO; break;
+        }
+        break;
+    case 0x00:               /* instruction indefinie (udf), comme ill_handler */
+        rec.ExceptionCode = EXCEPTION_ILLEGAL_INSTRUCTION;
+        break;
+    case ESR_ELx_EC_PC_ALIGN:
+    case 0x26:               /* SP non aligne */
+        rec.ExceptionCode = EXCEPTION_DATATYPE_MISALIGNMENT;
+        break;
+    case ESR_ELx_EC_DABT_CUR:
+        if (ESR_ELx_ISS_DFSC( esr_invite ) != ESR_ELx_ISS_DFSC_ALIGN_FAULT) { ret = -1; goto fin; }
+        rec.ExceptionCode = EXCEPTION_DATATYPE_MISALIGNMENT;
+        break;
+    default:
+        ret = -1;
+        goto fin;
+    }
+
+    /* comme setup_raise_exception, sans sigcontext : le vCPU garde x18 (pas de tremplin X18_RESUME) */
+    {
+        CHPE_V2_CPU_AREA_INFO *chpe = data->teb->ChpeV2CpuAreaInfo;
+        if (!chpe || !chpe->InSimulation)
+        {
+            NTSTATUS status = send_debug_event( data, &rec, &context, TRUE );
+            if (status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED)
+            {
+                ilot_depuis_contexte( data, &context, r );
+                goto fin;
+            }
+        }
+    }
+    if (rec.ExceptionCode == EXCEPTION_BREAKPOINT) context.Pc -= 4;
+    {   /* Cidre, ilot : anneau des exceptions livrees (vide a la sortie du processus, CIDRE_ILOT_XPROC) */
+        extern void ilot_noter_exception( unsigned int code, ULONG64 pc, ULONG64 va );
+        ilot_noter_exception( rec.ExceptionCode, r->pc, rec.NumberParameters >= 2 ? rec.ExceptionInformation[1] : 0 );
+    }
+    stack = virtual_setup_exception( data, (void *)(r->sp & ~15), sizeof(*stack), &rec );
+    stack->rec = rec;
+    stack->context = context;
+    context_init_empty_xstate( &stack->context, stack->redzone );
+    r->sp = (ULONG64)stack;
+    r->pc = (ULONG64)pKiUserExceptionDispatcher;
+    r->x[18] = (ULONG64)data->teb;
+fin:
+    pthread_sigmask( SIG_SETMASK, &ancien, NULL );
+    return ret;
 }
 
 
