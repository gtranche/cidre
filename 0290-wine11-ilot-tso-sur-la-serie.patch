+/* rend le vCPU du fil (place sous le plafond) ; depuis un appel hote, les q, FPCR et FPSR de l'invite, restes dans le
+ * vCPU par la copie minimale, passent dans le cadre de l'appel, avec CONTEXT_FLOATING_POINT, pour le retour complet */
+extern void ilot_sauver_fp_cadre( const void *q, uint64_t fpcr, uint64_t fpsr );
+static void rendre_vcpu( int depuis_appel_hote )
+{
+    __uint128_t q[32]; uint64_t fpcr = 0, fpsr = 0; hv_return_t rc;
+    if (!fil.pret) return;
+    if (depuis_appel_hote)
+    {
+        for (int i = 0; i < 32; i++) { hv_simd_fp_uchar16_t x; hv_vcpu_get_simd_fp_reg( fil.v, HV_SIMD_FP_REG_Q0 + i, &x ); memcpy( &q[i], &x, 16 ); }
+        hv_vcpu_get_reg( fil.v, HV_REG_FPCR, &fpcr ); hv_vcpu_get_reg( fil.v, HV_REG_FPSR, &fpsr );
+    }
+    if ((rc = hv_vcpu_destroy( fil.v )))
+    {   /* refuse : le vCPU reste vivant et au fil, qui le garde (rien n'est retire du compte) */
+        if (__atomic_fetch_add( &c_destroy_refuses, 1, __ATOMIC_RELAXED ) < 10)
+            fprintf( stderr, "[CIDRE_ILOT] rendre_vcpu : hv_vcpu_destroy refuse 0x%x (fil %04x) : le fil garde son vCPU\n", rc, tid_courant() );
+        return;
+    }
+    if (depuis_appel_hote) ilot_sauver_fp_cadre( q, fpcr, fpsr );
+    pthread_mutex_lock( &ilot_mutex );
+    registre_retirer( fil.hote );
+    fil.hote->vivant = 0;
+    c_rendus++;
+    pthread_mutex_unlock( &ilot_mutex );
+    fil.pret = 0; fil.sortie_ok = 0;
+}
+
+/* server_select, futex_wait : un fil qui va se bloquer dans un appel hote rend son vCPU s'il y a pression, ou des que
+ * les vCPU approchent du plafond (3/4). Un fil bloque garde son vCPU jusqu'a son reveil, et seul son fil peut le
+ * detruire : sans ce seuil, des fils bloques avant toute pression pouvaient prendre toutes les places (h64fils F3 :
+ * 100 dormeurs en attente infinie, plafond 64) et les calculateurs n'en trouvaient plus -- interblocage, puisque les
+ * dormeurs n'etaient reveilles qu'a la fin des calculateurs. Avec le seuil, moins de seuil fils bloques gardent leur
+ * vCPU (chacun l'a garde quand le compte, eux compris, etait sous le seuil) : il reste toujours des places. */
+static uint64_t c_rendus_seuil;
+uint64_t ilot_rendus_seuil( void ) { return c_rendus_seuil; }
+void ilot_avant_attente( int peut_bloquer )   /* server_select : peut_bloquer = delai non nul */
+{
+    int rendre;
+    if (!ilot_actif || !fil.pret || !fil.en_appel_hote) return;
+    diag_etat( 2 );
+    rendre = __atomic_load_n( &pression, __ATOMIC_ACQUIRE );
+    if (!rendre && peut_bloquer)   /* une attente nulle (Sleep(0), WaitFor...(h, 0)) rend aussitot la main : elle garde */
+    {
+        uint32_t seuil = max_vcpus - max_vcpus / 4;
+        if (seuil < 1) seuil = 1;
+        pthread_mutex_lock( &ilot_mutex );
+        rendre = (uint32_t)nb_vcpus >= seuil;
+        pthread_mutex_unlock( &ilot_mutex );
+        if (rendre) __atomic_fetch_add( &c_rendus_seuil, 1, __ATOMIC_RELAXED );
+    }
+    if (rendre) rendre_vcpu( 1 );
+}
+void ilot_avant_blocage( void ) { ilot_avant_attente( 1 ); }   /* futex_wait (sync.c) */
+
+/* fin du fil : son vCPU et son miroir */
+static void detruire_fil( void *p )
+{
+    struct fil_hote *h = p;
+    /* destructeur de cle : pas de __thread ici (le stockage TLV peut deja etre rendu), l'indice est dans h */
+    if (h->diag > 0 && h->diag <= NB_DIAG_FILS) { diag_fils[h->diag - 1].mort = 1; __atomic_store_n( &diag_fils[h->diag - 1].blq_t0, 0, __ATOMIC_RELEASE ); }
+    if (xproc_actif) fprintf( stderr, "[ILOT_XPROC] pid %d fil %04x : fin du fil hote\n", getpid(), h->diag > 0 && h->diag <= NB_DIAG_FILS ? diag_fils[h->diag - 1].tid : 0 );
+    pthread_mutex_lock( &ilot_mutex );
+    if (h->vivant)
+    {
+        hv_return_t rc = hv_vcpu_destroy( h->v );
+        registre_retirer( h );
+        h->vivant = 0;
+        if (rc)
+        {   /* le vCPU reste pris dans HVF pour toujours (seul ce fil pouvait le detruire) : une place de moins */
+            c_fuites_vcpu++;
+            if (max_vcpus > 1) max_vcpus--;
+            c_plafond_abaisse++;
+            fprintf( stderr, "[CIDRE_ILOT] fin de fil : hv_vcpu_destroy refuse 0x%x, vCPU perdu ; plafond effectif %u (fuites %llu)\n",
+                     rc, max_vcpus, (unsigned long long)c_fuites_vcpu );
+        }
+    }
+    if (h->miroir && nb_miroirs_libres < 256) miroirs_libres[nb_miroirs_libres++] = h->miroir;
+    pthread_mutex_unlock( &ilot_mutex );
+    free( h );
+}
+
+/* usr1_handler (signal_arm64.c) : suspension demandee alors que l'etat du fil est dans le vCPU. Le ucontext ne le
+ * contient pas : on demande la sortie, et la boucle remet l'etat a wait_suspend hors du signal. Rend 1 si pris. */
+int ilot_demander_suspension( void )
+{
+    if (!ilot_actif || !fil.dans_boucle || !fil.hote) return 0;
+    fil.hote->suspension = 1;
+    if (fil.pret) hv_vcpus_exit( &fil.v, 1 );
+    return 1;
+}
+
+extern void ilot_suspendre( struct ilot_regs *r );
+static void traiter_suspension( void )
+{
+    struct ilot_regs r;
+    fil.hote->suspension = 0;
+    lire_regs( fil.v, &r );
+    ilot_suspendre( &r );       /* wait_suspend : GetThreadContext et SetThreadContext des autres fils passent ici */
+    if (!fil.pret) creer_vcpu();
+    poser_regs( fil.v, &r );
+    c_suspensions++;
+}
+
+/* --- entree dans l'invite ------------------------------------------------------------------------------------------ */
+static void entrer( struct ilot_regs *r ) __attribute__((noreturn));
+static void boucle( hv_vcpu_t v ) __attribute__((noreturn));
+static int appel_rapide( hv_vcpu_t v );   /* appels systeme servis dans la boucle */
+static void entrer( struct ilot_regs *r )
+{
+    hv_vcpu_t v;
+    if (!fil.pret) creer_vcpu();
+    v = fil.v;
+    fil.sortie_ok = 0;
+    fil.dans_boucle = 1;
+    poser_regs( v, r );
+    boucle( v );
+}
+
+/* KeUserModeCallback (signal_arm64.c) depuis un appel hote de l'ilot : le rappel (KiUserCallbackDispatcher, code PE)
+ * tourne dans le vCPU, jamais sur l'hote (l'hote n'execute pas la memoire Windows ; nativement, call_user_mode_callback
+ * y saute par br x3). Son NtCallbackReturn sort comme tout appel systeme et rend la main a call_user_mode_callback.
+ * L'appel exterieur reprend ensuite par le retour court : le vCPU doit alors tenir l'etat de sa sortie. On le sauve
+ * avant le rappel (registres du vCPU et copie de la sortie) et on le repose apres. Si le fil a rendu son vCPU entre
+ * temps, retour complet : q, FPCR et FPSR dans le cadre, comme rendre_vcpu. */
+struct ilot_rappel_sauve { hv_vcpu_t v; struct ilot_regs r; int sortie_ok; uint64_t sx[31], ssp, snzcv, sfpcr, sfpsr; };
+static __thread void *rappel_func;
+static __thread int profondeur_rappel;
+static uint64_t c_diag_exec, c_diag_hote;
+
+void *ilot_rappel_debut( void *func )
+{
+    struct ilot_rappel_sauve *s;
+    if (!ilot_actif || !fil.pret || !fil.en_appel_hote) return NULL;
+    if (!(s = malloc( sizeof(*s) ))) fatal( "rappel : memoire", 0, 0, 0 );
+    s->v = fil.v;
+    lire_regs( fil.v, &s->r );
+    s->sortie_ok = fil.sortie_ok;
+    memcpy( s->sx, fil.sx, sizeof(s->sx) ); s->ssp = fil.ssp; s->snzcv = fil.snzcv; s->sfpcr = fil.sfpcr; s->sfpsr = fil.sfpsr;
+    rappel_func = func;
+    profondeur_rappel++;
+    __atomic_fetch_add( &c_rappels, 1, __ATOMIC_RELAXED );
+    return s;
+}
+void ilot_rappel_fin( void *p )
+{
+    struct ilot_rappel_sauve *s = p;
+    fil.en_appel_hote = 1;   /* de retour dans l'appel exterieur */
+    profondeur_rappel--;
+    if (fil.pret && fil.v == s->v)
+    {
+        poser_regs( fil.v, &s->r );
+        fil.sortie_ok = s->sortie_ok;
+        memcpy( fil.sx, s->sx, sizeof(s->sx) ); fil.ssp = s->ssp; fil.snzcv = s->snzcv; fil.sfpcr = s->sfpcr; fil.sfpsr = s->sfpsr;
+    }
+    else
+    {
+        extern void ilot_sauver_fp_cadre( const void *q, uint64_t fpcr, uint64_t fpsr );
+        fil.sortie_ok = 0;
+        ilot_sauver_fp_cadre( s->r.v, s->r.fpcr, s->r.fpsr );
+    }
+    free( s );
+}
+/* depuis le tremplin (signal_arm64.c), sur la pile noyau sous le cadre du rappel : x18 = TEB, sp = pile Windows */
+void ilot_rappel( uint64_t user_sp, uint64_t teb ) __attribute__((noreturn));
+void ilot_rappel( uint64_t user_sp, uint64_t teb )
+{
+    struct ilot_regs r;
+    memset( &r, 0, sizeof(r) );
+    r.x[18] = teb; r.sp = user_sp; r.pc = (uint64_t)rappel_func;
+    __asm__ volatile( "mrs %0, fpcr\n\tmrs %1, fpsr" : "=r"(r.fpcr), "=r"(r.fpsr) );
+    fil.en_appel_hote = 0;
+    entrer( &r );
+}
+
+/* exception synchrone de l'invite livree a Windows (CIDRE_ILOT_DIAG, 30 au plus) : registres, lr et le code avant lr,
+ * dernier appel systeme et profondeur de rappel du fil */
+static void journal_exception( const char *quoi, const struct ilot_regs *r, uint64_t far, uint64_t esr )
+{
+    uint32_t w[4] = { 0 }; mach_vm_size_t lu = 0; struct diag_fil *d;
+    if (!ilot_diag || __atomic_fetch_add( &c_diag_exec, 1, __ATOMIC_RELAXED ) >= 30) return;
+    d = diag_fil();
+    if (r->x[30] >= 16) mach_vm_read_overwrite( mach_task_self(), r->x[30] - 16, sizeof(w), (mach_vm_address_t)w, &lu );
+    fprintf( stderr, "[CIDRE_ILOT] exception %s : pc 0x%llx far 0x%llx esr 0x%llx ; lr 0x%llx (code avant lr %08x %08x %08x %08x) sp 0x%llx "
+             "x0 0x%llx x1 0x%llx x2 0x%llx x8 0x%llx x9 0x%llx x10 0x%llx x11 0x%llx x15 0x%llx x16 0x%llx x17 0x%llx x29 0x%llx nzcv 0x%llx ; "
+             "profondeur de rappel %d ; dernier appel 0x%llx de 0x%llx\n", quoi,
+             (unsigned long long)r->pc, (unsigned long long)far, (unsigned long long)esr, (unsigned long long)r->x[30],
+             w[0], w[1], w[2], w[3], (unsigned long long)r->sp, (unsigned long long)r->x[0], (unsigned long long)r->x[1],
+             (unsigned long long)r->x[2], (unsigned long long)r->x[8], (unsigned long long)r->x[9], (unsigned long long)r->x[10],
+             (unsigned long long)r->x[11], (unsigned long long)r->x[15], (unsigned long long)r->x[16], (unsigned long long)r->x[17],
+             (unsigned long long)r->x[29], (unsigned long long)r->nzcv, profondeur_rappel,
+             d ? (unsigned long long)d->numero : 0ull, d ? (unsigned long long)d->appelant : 0ull );
+}
+
+static void boucle( hv_vcpu_t v )
+{
+    {   /* rafraichi a chaque entree : un reveil change D */
+        uint64_t d = continu_moins_absolu();
+        if (horloge()->d != d) __atomic_store_n( &horloge()->d, d, __ATOMIC_RELAXED );
+    }
+    kuser_copier( 0, 0 );
+    __atomic_fetch_add( &c_entrees, 1, __ATOMIC_RELAXED );
+    fil.dans_boucle = 1; fil.en_appel_hote = 0;
+    diag_etat( 0 );
+    if (bloques_actif && diag_place > 0) __atomic_store_n( &diag_fils[diag_place - 1].blq_t0, 0, __ATOMIC_RELEASE );
+    for (;;)
+    {
+        if (fil.hote->suspension) traiter_suspension();
+        v = fil.v;
+        if (tlbi_en_attente()) vider_tlb( v, 0 );   /* 5b : une entree L3 a change depuis le dernier talon */
+        uint64_t t0 = mach_absolute_time();
+        if (hv_vcpu_run( v )) fatal( "hv_vcpu_run", 0, 0, 0 );
+        uint64_t t1 = mach_absolute_time();
+        __atomic_fetch_add( &t_vcpu, t1 - t0, __ATOMIC_RELAXED );
+        if (chrono_fils) { struct diag_fil *d = diag_fil(); if (d) d->c_vcpu += t1 - t0; }
+        hv_vcpu_exit_t *e = fil.e;
+        if (e->reason == HV_EXIT_REASON_CANCELED)
+        {
+            if (fil.hote->suspension) continue;   /* traitee en tete de boucle */
+            if (__atomic_load_n( &pression, __ATOMIC_ACQUIRE ) && ms( t1 - fil.t_entree ) > 2.0)
+            {   /* plus de fils que de vCPU : apres son quantum, ce fil cede sa place et la redemande */
+                struct ilot_regs r;
+                lire_regs( v, &r );
+                rendre_vcpu( 0 );
+                c_cessions++;
+                creer_vcpu();   /* sans effet si le vCPU n'a pas ete rendu */
+                poser_regs( fil.v, &r );
+                continue;
+            }
+        }
+        if (e->reason == HV_EXIT_REASON_CANCELED && (chrono_fils || blocage_ech) && !echantillon)
+        {   /* chronologie par fil : pc de ce fil s'il tournait avant la demande (sans vue ni verrou ici) */
+            struct diag_fil *d;
+            if (t0 < __atomic_load_n( &t_ech_demande, __ATOMIC_ACQUIRE ) && (d = diag_fil()))
+            {
+                uint64_t pc; int libre = -1, i;
+                hv_vcpu_get_reg( v, HV_REG_PC, &pc ); pc &= ~63ull;
+                if (blocage_ech) { hv_vcpu_get_sys_reg( v, HV_SYS_REG_SP_EL1, &d->ech_sp ); hv_vcpu_get_reg( v, HV_REG_X30, &d->ech_lr ); }
+                for (i = 0; i < 16; i++)
+                {
+                    if (d->pcs[i].pc == pc) { d->pcs[i].n++; break; }
+                    if (!d->pcs[i].n && libre < 0) libre = i;
+                }
+                if (i == 16 && libre >= 0) { d->pcs[libre].pc = pc; d->pcs[libre].n = 1; }
+            }
+            continue;
+        }
+        if (e->reason == HV_EXIT_REASON_CANCELED && echantillon)
+        {   /* echantillon seulement si le vCPU tournait avant la demande */
+            if (t0 < __atomic_load_n( &t_ech_demande, __ATOMIC_ACQUIRE ))
+            {
+                extern int ilot_vue_base( const void *addr, uint64_t *base, uint64_t *taille, int *image );
+                uint64_t pc, base = 0, taille = 0; int image = 0; struct diag_fil *d = diag_fil();
+                hv_vcpu_get_reg( v, HV_REG_PC, &pc );
+                noter_pc( pc );
+                {   /* appelant : lr et mot en [sp] (lu sans effet de bord) */
+                    uint64_t lr = 0, sp = 0, sp0 = 0; mach_vm_size_t lu = 0;
+                    hv_vcpu_get_reg( v, HV_REG_X30, &lr ); hv_vcpu_get_sys_reg( v, HV_SYS_REG_SP_EL1, &sp );
+                    if (sp) mach_vm_read_overwrite( mach_task_self(), sp, 8, (mach_vm_address_t)&sp0, &lu );
+                    noter_lr( pc, lr, lu == 8 ? sp0 : 0 );
+                }
+                if (d)
+                {
+                    d->ech++;
+                    if (ilot_vue_base( (void *)pc, &base, &taille, &image )) { if (image) d->ech_image++; else d->ech_vue++; }
+                    else d->ech_hors++;
+                }
+            }
+            else __atomic_fetch_add( &c_ech_ecartes, 1, __ATOMIC_RELAXED );
+            continue;
+        }
+        if (e->reason == HV_EXIT_REASON_VTIMER_ACTIVATED || e->reason == HV_EXIT_REASON_CANCELED) { c_minuterie++; continue; }
+        if (e->reason != HV_EXIT_REASON_EXCEPTION) fatal( "sortie", e->reason, 0, 0 );
+        uint64_t esr = e->exception.syndrome, ec = (esr >> 26) & 0x3f, pc;
+        hv_vcpu_get_reg( v, HV_REG_PC, &pc );
+        if (ec == 0x01)
+        {   /* wfi/wfe : on rend la main, puis on reprend apres l'instruction */
+            c_wfx++; sched_yield(); hv_vcpu_set_reg( v, HV_REG_PC, pc + 4 ); continue;
+        }
+        if (ec == 0x16)
+        {   /* hvc #1 : exception de l'invite (son vecteur) ; seules les fautes de traduction du premier etage sont servies */
+            uint64_t esr1, far, elr, spsr;
+            if ((esr & 0xffff) != 1) fatal( "hvc inattendu (ESR, PC)", esr, pc, 0 );   /* hvc #2 : talon TLBI, vu par vider_tlb seulement */
+            hv_vcpu_get_sys_reg( v, HV_SYS_REG_ESR_EL1, &esr1 );
+            hv_vcpu_get_sys_reg( v, HV_SYS_REG_FAR_EL1, &far );
+            hv_vcpu_get_sys_reg( v, HV_SYS_REG_ELR_EL1, &elr );
+            hv_vcpu_get_sys_reg( v, HV_SYS_REG_SPSR_EL1, &spsr );
+            uint64_t ec1 = (esr1 >> 26) & 0x3f, fsc = esr1 & 0x3f;
+            int ok = 0, deja = 0;
+            if ((ec1 == 0x21 || ec1 == 0x25) && fsc == 0x30)
+            {   /* conflit de TLB (decoupage d'un bloc sans break-before-make, 5b) : talon TLBI, puis rejeu */
+                __atomic_fetch_add( &c_conflits, 1, __ATOMIC_RELAXED );
+                hv_vcpu_set_reg( v, HV_REG_PC, elr ); hv_vcpu_set_reg( v, HV_REG_CPSR, spsr );
+                vider_tlb( v, 1 );
+                continue;
+            }
+            if ((ec1 == 0x21 || ec1 == 0x25) && fsc >= 4 && fsc <= 7)
+            {
+                pthread_mutex_lock( &ilot_mutex );
+                deja = ipa_de( far ) != 0;   /* deja servie : entree L3 invalide, AV (sinon servir_gio rebouclerait) */
+                if (!deja) ok = servir_gio( far );
+                pthread_mutex_unlock( &ilot_mutex );
+            }
+            if (!ok && (ec1 == 0x21 || ec1 == 0x25) && ((fsc & 0x3c) == 0x0c || deja))
+            {   /* faute de permission du premier etage (ecriture sur le miroir KUSER, en lecture seule ; sous-page de
+                 * 4 Kio aux droits exacts, 5b) ou traduction de niveau 3 sur une VA servie (sous-page sans acces) :
+                 * AV Windows, sauf si l'entree recalculee permet l'acces (ancienne traduction dans un TLB) */
+                struct ilot_regs r;
+                int genre = ec1 == 0x21 ? 8 : (((esr1 >> 6) & 1) && !((esr1 >> 8) & 1)) ? 1 : 0;   /* CM (bit 8) : entretien de cache, une lecture */
+                if (l3_resync( far, genre ))
+                {
+                    hv_vcpu_set_reg( v, HV_REG_PC, elr ); hv_vcpu_set_reg( v, HV_REG_CPSR, spsr );
+                    vider_tlb( v, 1 );
+                    continue;
+                }
+                lire_regs( v, &r );
+                r.pc = elr; r.nzcv = spsr & 0xf0000000;
+                journal_exception( "permission (1er etage)", &r, far, esr1 );
+                int x = ilot_exception( &r, far, genre, 0 );
+                if (x == 0) { hv_vcpu_set_reg( v, HV_REG_PC, elr ); hv_vcpu_set_reg( v, HV_REG_CPSR, spsr ); continue; }
+                if (x == 1) { c_exceptions++; poser_regs( v, &r ); continue; }
+            }
+            if (!ok && !((ec1 == 0x21 || ec1 == 0x25) && fsc >= 4 && fsc <= 7))
+            {   /* brk, udf, alignement : exception Windows, au PC fautif, avec les drapeaux d'avant l'exception */
+                struct ilot_regs r;
+                lire_regs( v, &r );
+                r.pc = elr; r.nzcv = spsr & 0xf0000000;
+                journal_exception( "synchrone (brk, udf, alignement, traduction)", &r, far, esr1 );
+                int x = ilot_exception( &r, far, 0, esr1 | (1u << 25) );
+                if (x == 1) { c_exceptions++; poser_regs( v, &r ); continue; }
+            }
+            if (!ok) fatal( "exception de l'invite (ESR, FAR, ELR)", esr1, far, elr );
+            hv_vcpu_set_reg( v, HV_REG_PC, elr );
+            hv_vcpu_set_reg( v, HV_REG_CPSR, spsr );
+            continue;
+        }
+        if (ec == 0x20 || ec == 0x24)
+        {   /* faute de deuxieme etage */
+            int p;
+            if ((esr & 0x3f) == 0x30)
+            {   /* conflit de TLB (5b) : talon TLBI, puis rejeu */
+                __atomic_fetch_add( &c_conflits, 1, __ATOMIC_RELAXED );
+                vider_tlb( v, 1 );
+                continue;
+            }
+            if (ec == 0x20 && est_code_hote( e->exception.physical_address )) { p = 1; c_hote_rapides++; }
+            else p = projeter( e->exception.physical_address, e->exception.virtual_address, ec == 0x24 && ((esr >> 6) & 1) && !((esr >> 8) & 1), ec == 0x20 );   /* CM (bit 8) : entretien de cache, une lecture */
+            if (p == 0) continue;
+            if (p == 2) { vider_tlb( v, 0 ); continue; }   /* entrees L3 changees : talon, puis rejeu (nouvelle faute, projection) */
+            if (p == 1 && ec == 0x20 && e->exception.virtual_address == (uint64_t)__wine_syscall_dispatcher && appel_rapide( v ))
+                continue;   /* NtQuerySystemTime, NtQueryVirtualMemory : servis sans quitter la boucle */
+            if (p == 1 && ec == 0x20)
+            {   /* le code PE saute dans le code de l'hote : on y saute nativement avec ses registres */
+                struct ilot_regs h;
+                for (int i = 0; i < 31; i++) hv_vcpu_get_reg( v, HV_REG_X0 + i, &h.x[i] );
+                hv_vcpu_get_sys_reg( v, HV_SYS_REG_SP_EL1, &h.sp );
+                uint64_t cpsr; hv_vcpu_get_reg( v, HV_REG_CPSR, &cpsr ); h.nzcv = cpsr & 0xf0000000;
+                hv_vcpu_get_reg( v, HV_REG_FPCR, &h.fpcr ); hv_vcpu_get_reg( v, HV_REG_FPSR, &h.fpsr );
+                /* les q restent dans le vCPU : appels systeme et unix ne prennent que des entiers, et le retour ne les
+                 * recharge qu'avec CONTEXT_FLOATING_POINT (comme l'asm de retour natif) */
+                if (copie_complete)
+                    for (int i = 0; i < 32; i++) { hv_simd_fp_uchar16_t q; hv_vcpu_get_simd_fp_reg( v, HV_SIMD_FP_REG_Q0 + i, &q ); memcpy( &h.v[i], &q, 16 ); }
+                else memset( h.v, 0, sizeof(h.v) );
+                memcpy( fil.sx, h.x, sizeof(fil.sx) ); fil.ssp = h.sp; fil.snzcv = h.nzcv; fil.sfpcr = h.fpcr; fil.sfpsr = h.fpsr;
