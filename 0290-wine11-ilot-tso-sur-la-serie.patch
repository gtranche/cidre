+        mach_vm_read_overwrite( mach_task_self(), d->a[0], 8, (mach_vm_address_t)cf, &lu );
+        mach_vm_read_overwrite( mach_task_self(), d->a[0] + 8, sizeof(c), (mach_vm_address_t)c, &lu );
+    }
+    fprintf( stderr, "[CIDRE_ILOT] reprise %04x apres 0x%llx -> 0x%llx : ctx %llx flags %x pc 0x%llx x0 0x%llx x1 0x%llx x2 0x%llx sp 0x%llx | "
+             "cadre pc 0x%llx sp 0x%llx x0 0x%llx x1 0x%llx x2 0x%llx restore 0x%x | %s\n", tid,
+             (unsigned long long)d->numero, (unsigned long long)x0, (unsigned long long)d->a[0], cf[0],
+             (unsigned long long)c[32], (unsigned long long)c[0], (unsigned long long)c[1], (unsigned long long)c[2], (unsigned long long)c[31],
+             (unsigned long long)f->pc, (unsigned long long)f->sp, (unsigned long long)f->x[0], (unsigned long long)f->x[1],
+             (unsigned long long)f->x[2], (unsigned int)f->restore_flags,
+             (f->restore_flags & 0x10000) ? "emulation" : (fil.pret && fil.sortie_ok) ? "court" : "complet" );
+    return 1;
+}
