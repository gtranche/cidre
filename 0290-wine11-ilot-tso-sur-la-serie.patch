+             * rend l'exception CodeEcrit. Une autre vue executable du meme bloc n'est armee que si elle est seule
+             * executable (l'ancienne a perdu l'execution ou a ete retiree : FEX a deja invalide son code) ; sinon
+             * refus, FEX y valide le code. */
+            if (!a->rx || a->rx == (ULONG_PTR)code) continue;
+            if (!code || bloc_executable( view->section_ino, bloc, &nb ) != (ULONG_PTR)code || nb != 1) { *raison = 2; return 0; }
+            a->rx = (ULONG_PTR)code;
