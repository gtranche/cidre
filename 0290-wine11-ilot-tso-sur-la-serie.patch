+static void *kuser_fil( void *p )
+{   /* pour les attentes actives sur TickCount ou InterruptTime sans sortie du vCPU */
+    for (unsigned int n = 0;; n++)
+    {
+        usleep( 1000 );
+        kuser_copier( n % 100 == 0, 1 );
+        pthread_mutex_lock( &ilot_mutex );   /* demandes de suspension posees juste avant hv_vcpu_run : relance */
+        for (int i = 0; i < nb_vcpus; i++) if (fils[i] && fils[i]->suspension && vcpus[i]) hv_vcpus_exit( &vcpus[i], 1 );
+        pthread_mutex_unlock( &ilot_mutex );
+    }
+    return NULL;
+}
