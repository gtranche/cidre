+/* sortie anticipee (24/10) : anneaux vides a NtTerminateProcess, sous CIDRE_ILOT_XPROC. Par fil : les 32 derniers appels
+ * hote (numero, ou bibliotheque:fonction unix) et leur retour ; par processus : les 64 dernieres exceptions materielles
+ * livrees a l'invite (signal_arm64.c) et les 8 derniers NtRaiseException (second = non gere). */
+#define NB_ANN_APPELS 32
+static __thread struct { uint32_t num; uint64_t lib, code, ret, t; int fini; } ann_appels[NB_ANN_APPELS];
+static __thread unsigned int ann_tete, ann_en_cours;
+#define NB_ANN_EXC 64
+static struct { uint32_t tid, code; uint64_t pc, va, t; } ann_exc[NB_ANN_EXC];
+static unsigned int ann_exc_tete;
+#define NB_ANN_RAISE 8
+static struct { uint32_t tid, code, premiere; uint64_t adresse, t; } ann_raise[NB_ANN_RAISE];
+static unsigned int ann_raise_tete;
+/* chronologie : exceptions livrees depuis la ligne precedente, par pc (16 pc distincts, le reste en « autres ») */
+#define NB_EXC_PC 16
+static struct { uint64_t pc, va; uint32_t code, n; } exc_pc[NB_EXC_PC];
+static uint32_t exc_pc_autres;
+static void chrono_noter_exception( unsigned int code, uint64_t pc, uint64_t va )
+{
+    for (int i = 0; i < NB_EXC_PC; i++)
+    {
+        uint64_t c = __atomic_load_n( &exc_pc[i].pc, __ATOMIC_ACQUIRE );
+        if (!c && __atomic_compare_exchange_n( &exc_pc[i].pc, &c, pc, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE )) c = pc;
+        if (c == pc) { exc_pc[i].va = va; exc_pc[i].code = code; __atomic_fetch_add( &exc_pc[i].n, 1, __ATOMIC_RELAXED ); return; }
+    }
+    __atomic_fetch_add( &exc_pc_autres, 1, __ATOMIC_RELAXED );
+}
+static void chrono_exceptions( const char *quand )
+{
+    char l[2048], c[160]; int n = 0, vu = 0;
+    n = snprintf( l, sizeof(l), "[CIDRE_ILOT] chrono %s exceptions par pc :", quand );
+    for (int i = 0; i < NB_EXC_PC; i++)
+    {
+        uint64_t pc = __atomic_load_n( &exc_pc[i].pc, __ATOMIC_ACQUIRE );
+        uint32_t k = __atomic_exchange_n( &exc_pc[i].n, 0, __ATOMIC_RELAXED );
+        if (!pc) continue;
+        if (k && n < (int)sizeof(l) - 200)
+            n += snprintf( l + n, sizeof(l) - n, " %s x%u (0x%x, va 0x%llx) ;", decrire_pc( pc, c, sizeof(c) ), k, exc_pc[i].code,
+                           (unsigned long long)exc_pc[i].va );
+        vu += k;
+        if (!k) __atomic_store_n( &exc_pc[i].pc, 0, __ATOMIC_RELEASE );   /* place rendue a un pc muet */
+    }
+    uint32_t a = __atomic_exchange_n( &exc_pc_autres, 0, __ATOMIC_RELAXED );
+    if (!vu && !a) return;
+    if (a) snprintf( l + n, sizeof(l) - n, " autres x%u", a );
+    fprintf( stderr, "%s\n", l );
+}
+void ilot_noter_exception( unsigned int code, uint64_t pc, uint64_t va )   /* signal_arm64.c : exception livree a l'invite */
+{
+    if (chrono_actif) chrono_noter_exception( code, pc, va );
+    if (!xproc_actif) return;
+    unsigned int i = __atomic_fetch_add( &ann_exc_tete, 1, __ATOMIC_RELAXED ) % NB_ANN_EXC;
+    ann_exc[i].t = 0; ann_exc[i].tid = tid_courant(); ann_exc[i].code = code; ann_exc[i].pc = pc; ann_exc[i].va = va;
+    __atomic_store_n( &ann_exc[i].t, mach_absolute_time(), __ATOMIC_RELEASE );
+}
+static void anneau_appel( const struct ilot_regs *h, uint32_t num )
+{
+    unsigned int i = ann_tete++ % NB_ANN_APPELS;
+    ann_appels[i].num = num; ann_appels[i].lib = h->x[0]; ann_appels[i].code = h->x[1]; ann_appels[i].ret = 0;
+    ann_appels[i].fini = 0; ann_appels[i].t = mach_absolute_time();
+    ann_en_cours = i + 1;
+    if (num == 0xd5)
+    {   /* NtRaiseException( EXCEPTION_RECORD *, CONTEXT *, BOOL first_chance ) : code +0, adresse +16 */
+        uint32_t code = 0; uint64_t adr = 0;
+        lire_invite( h->x[0], &code, 4 ); lire_invite( h->x[0] + 16, &adr, 8 );
+        unsigned int k = __atomic_fetch_add( &ann_raise_tete, 1, __ATOMIC_RELAXED ) % NB_ANN_RAISE;
+        ann_raise[k].tid = tid_courant(); ann_raise[k].code = code; ann_raise[k].adresse = adr; ann_raise[k].premiere = (uint32_t)h->x[2];
+        __atomic_store_n( &ann_raise[k].t, mach_absolute_time(), __ATOMIC_RELEASE );
+        static int dits;   /* premieres chances : 50 lignes (exceptions C++ du jeu) ; secondes chances : toutes */
+        if (!h->x[2] || __atomic_fetch_add( &dits, 1, __ATOMIC_RELAXED ) < 50)
+            fprintf( stderr, "[ILOT_XPROC] pid %d fil %04x : NtRaiseException code 0x%08x adresse 0x%llx %s\n", getpid(), tid_courant(), code,
+                     (unsigned long long)adr, h->x[2] ? "(premiere chance)" : "(SECONDE CHANCE : non geree)" );
+    }
+}
+/* adresses de retour plausibles sur la pile du fil qui sort (x64 et ARM64EC partagent la pile) : valeurs pointant
+ * dans une page executable d'une vue, 48 au plus, sur 16 Kio */
+static void pile_vider( uint64_t sp )
+{
+    extern int ilot_pc_executable( const void *addr, uint64_t *base, int *image );
+    uint64_t b[512], prec = 0; int dits = 0; char c[160];
+    fprintf( stderr, "[ILOT_XPROC] pile du fil qui sort (sp 0x%llx), adresses dans du code :\n", (unsigned long long)sp );
+    for (uint64_t o = 0; o < 0x4000 && dits < 48; o += sizeof(b))
+    {
+        if (!lire_invite( sp + o, b, sizeof(b) )) break;
+        for (unsigned int i = 0; i < 512 && dits < 48; i++)
+        {
+            uint64_t q = b[i], base = 0; int image = 0;
+            if (q < 0x10000 || q == prec || !ilot_pc_executable( (void *)q, &base, &image )) continue;
+            prec = q; dits++;
+            fprintf( stderr, "[ILOT_XPROC]   sp+0x%llx : %s\n", (unsigned long long)(o + i * 8), decrire_pc( q, c, sizeof(c) ) );
+        }
+    }
+}
+static void anneaux_vider( uint64_t handle, uint64_t code_sortie )
+{
+    static int vide;
+    uint64_t now = mach_absolute_time(); char c[160];
+    if (__atomic_exchange_n( &vide, 1, __ATOMIC_RELAXED )) return;
+    fprintf( stderr, "[ILOT_XPROC] pid %d fil %04x : sortie du processus (NtTerminateProcess %s, code 0x%llx) ; appels hote du fil, du plus ancien au plus recent :\n",
+             getpid(), tid_courant(), handle == ~0ull ? "soi" : handle ? "autre" : "autres fils", (unsigned long long)code_sortie );
+    for (unsigned int k = 0; k < NB_ANN_APPELS; k++)
+    {
+        unsigned int i = (ann_tete + k) % NB_ANN_APPELS;
+        if (!ann_appels[i].t) continue;
+        char quoi[96];
+        if (ann_appels[i].num == CHRONO_UNIX)
+        {
+            Dl_info di; const char *img = "?";
+            if (dladdr( (void *)ann_appels[i].lib, &di ) && di.dli_fname) img = strrchr( di.dli_fname, '/' ) ? strrchr( di.dli_fname, '/' ) + 1 : di.dli_fname;
+            snprintf( quoi, sizeof(quoi), "unix %s:%llu", img, (unsigned long long)ann_appels[i].code );
+        }
+        else if (nom_appel( ann_appels[i].num )) snprintf( quoi, sizeof(quoi), "%s", nom_appel( ann_appels[i].num ) );
+        else snprintf( quoi, sizeof(quoi), "appel 0x%x", ann_appels[i].num );
+        if (ann_appels[i].fini) fprintf( stderr, "[ILOT_XPROC]   -%.3f ms %s -> 0x%llx\n", ms( now - ann_appels[i].t ), quoi, (unsigned long long)ann_appels[i].ret );
+        else fprintf( stderr, "[ILOT_XPROC]   -%.3f ms %s (en cours)\n", ms( now - ann_appels[i].t ), quoi );
+    }
+    fprintf( stderr, "[ILOT_XPROC] exceptions livrees a l'invite (64 dernieres du processus, de la plus ancienne a la plus recente) :\n" );
+    for (unsigned int k = 0; k < NB_ANN_EXC; k++)
+    {
+        unsigned int i = (ann_exc_tete + k) % NB_ANN_EXC;
+        uint64_t t = __atomic_load_n( &ann_exc[i].t, __ATOMIC_ACQUIRE );
+        if (!t) continue;
+        fprintf( stderr, "[ILOT_XPROC]   -%.3f ms fil %04x code 0x%08x pc %s va 0x%llx\n", ms( now - t ), ann_exc[i].tid, ann_exc[i].code,
+                 decrire_pc( ann_exc[i].pc, c, sizeof(c) ), (unsigned long long)ann_exc[i].va );
+    }
+    for (unsigned int k = 0; k < NB_ANN_RAISE; k++)
+    {
+        unsigned int i = (ann_raise_tete + k) % NB_ANN_RAISE;
+        uint64_t t = __atomic_load_n( &ann_raise[i].t, __ATOMIC_ACQUIRE );
+        if (!t) continue;
+        fprintf( stderr, "[ILOT_XPROC]   NtRaiseException -%.3f ms fil %04x code 0x%08x adresse %s %s\n", ms( now - t ), ann_raise[i].tid, ann_raise[i].code,
+                 decrire_pc( ann_raise[i].adresse, c, sizeof(c) ), ann_raise[i].premiere ? "premiere chance" : "SECONDE CHANCE" );
+    }
+}
+static void xproc_sortie( const struct ilot_regs *h )
+{
+    uint32_t n = (uint32_t)h->x[8];
+    fil.xp_num = 0;
+    if ((n >> 12) || !xproc_voulu( n, h->x )) return;
+    if (n == 0x2c && (!h->x[0] || h->x[0] == ~0ull))
+    {   /* sortie du processus : ecrite avant l'appel (NtTerminateProcess(-1) ne revient pas), avec les anneaux */
+        char c[160];
+        fprintf( stderr, "[ILOT_XPROC] pid %d fil %04x abs %.3f : NtTerminateProcess(%s, code de sortie 0x%llx) avant l'appel ; appelant %s\n",
+                 getpid(), tid_courant(), ms( mach_absolute_time() ), h->x[0] ? "soi" : "autres fils", (unsigned long long)h->x[1],
+                 decrire_pc( h->x[30], c, sizeof(c) ) );
+        if (!h->x[0]) pile_vider( h->sp );   /* premiere des deux sorties (autres fils) : la pile de l'appelant d'ExitProcess */
+        anneaux_vider( h->x[0], h->x[1] );
+    }
+    memcpy( fil.xp_a, h->x, sizeof(fil.xp_a) ); fil.xp_sp = h->sp; fil.xp_lr = h->x[30]; fil.xp_t = mach_absolute_time();
+    fil.xp_num = n;
+}
+static void xproc_retour( uint64_t st )
+{
+    static int lignes, par_num[0x110];
+    uint32_t n = fil.xp_num; const uint64_t *a = fil.xp_a;
