+/* --- diagnostic --------------------------------------------------------------------------------------------------- */
+static double ms( uint64_t t ) { static mach_timebase_info_data_t tb; if (!tb.denom) mach_timebase_info( &tb ); return t * (double)tb.numer / tb.denom / 1e6; }
+/* echantillonneur (CIDRE_ILOT_ECHANTILLON=1) : toutes les millisecondes, sortie forcee de tous les vCPU, PC releve */
+static hv_vcpu_t vcpus[256];
+static struct fil_hote *fils[256];       /* meme ordre que vcpus[] */
+static int nb_vcpus, echantillon;
+static uint32_t max_vcpus = 64;          /* hv_vm_get_max_vcpu_count, ou CIDRE_ILOT_MAX_VCPU */
+static int pression, en_attente;         /* des fils attendent un vCPU */
+static pthread_cond_t place_cond = PTHREAD_COND_INITIALIZER;
+static pthread_key_t cle_vcpu;
+static uint64_t *miroirs_libres[256]; static int nb_miroirs_libres;
+static uint64_t c_rendus, c_cessions, c_suspensions, c_vcpus_crees, c_rappels;
+
+/* mutex tenu. Par le fil, pas par l'identifiant : HVF recycle les identifiants de vCPU, et entre le destroy d'un fil
+ * (hors mutex) et son retrait, un autre fil peut avoir recu le meme ; le retrait par identifiant pouvait alors oter
+ * l'entree de l'autre (plus de sortie forcee pour lui) et laisser une entree perimee. */
+static uint64_t c_fuites_vcpu, c_plafond_abaisse, c_destroy_refuses;
+static void registre_retirer( struct fil_hote *h )
+{
+    for (int i = 0; i < nb_vcpus; i++)
+        if (fils[i] == h) { vcpus[i] = vcpus[nb_vcpus - 1]; fils[i] = fils[nb_vcpus - 1]; nb_vcpus--; break; }
+    pthread_cond_broadcast( &place_cond );
+}
+#define NB_ECH 1024
+static struct { uint64_t pc, n; } ech[NB_ECH];
+static uint64_t c_ech;
+static void noter_pc( uint64_t pc )
+{
+    pc &= ~63ull;   /* par ligne de 64 octets */
+    unsigned int h = (unsigned int)((pc * 0x9E3779B97F4A7C15ull) >> 54);
+    for (unsigned int i = 0; i < NB_ECH; i++, h = (h + 1) % NB_ECH)
+    {
+        uint64_t c = __atomic_load_n( &ech[h].pc, __ATOMIC_RELAXED );
+        if (c == pc || (!c && __atomic_compare_exchange_n( &ech[h].pc, &c, pc, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED )) || c == pc)
+        { __atomic_fetch_add( &ech[h].n, 1, __ATOMIC_RELAXED ); __atomic_fetch_add( &c_ech, 1, __ATOMIC_RELAXED ); return; }
+    }
+}
+/* instant de la derniere demande de sortie de l'echantillonneur : une sortie forcee n'est un echantillon de l'invite
+ * que si le vCPU tournait deja a cet instant (sinon le PC est celui ou l'hote va reprendre, retour d'appel systeme
+ * surtout : biais des releves d'avant) */
+static volatile uint64_t t_ech_demande;
+static uint64_t c_ech_ecartes;
+/* paires (ligne du pc, lr, mot en [sp]) des echantillons : appelant d'une fonction feuille (lr) et, pour une fonction
+ * ARM64EC appelee depuis le x64, adresse de retour x64 probable ([sp]) */
+#define NB_ECH_LR 2048
+static struct { uint64_t pc, lr, sp0, n; } ech_lr[NB_ECH_LR];
+static void noter_lr( uint64_t pc, uint64_t lr, uint64_t sp0 )
+{
+    pc &= ~63ull;
+    unsigned int h = (unsigned int)(((pc ^ (lr * 31) ^ (sp0 * 131)) * 0x9E3779B97F4A7C15ull) >> 53);
+    for (unsigned int i = 0; i < NB_ECH_LR; i++, h = (h + 1) % NB_ECH_LR)
+    {
+        if (__atomic_load_n( &ech_lr[h].pc, __ATOMIC_ACQUIRE ) == pc && ech_lr[h].lr == lr && ech_lr[h].sp0 == sp0)
+        { __atomic_fetch_add( &ech_lr[h].n, 1, __ATOMIC_RELAXED ); return; }
+        uint64_t zero = 0;
+        if (!ech_lr[h].pc && __atomic_compare_exchange_n( &ech_lr[h].lr, &zero, lr ? lr : 1, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED ))
+        {
+            ech_lr[h].sp0 = sp0;
+            __atomic_store_n( &ech_lr[h].pc, pc, __ATOMIC_RELEASE );
+            __atomic_fetch_add( &ech_lr[h].n, 1, __ATOMIC_RELAXED );
+            return;
+        }
+    }
+}
+static void releve_lr( int top )
+{
+    extern int ilot_vue_base( const void *addr, uint64_t *base, uint64_t *taille, int *image );
+    for (int r = 0; r < top; r++)
+    {
+        int m = -1;
+        for (int i = 0; i < NB_ECH_LR; i++) if (ech_lr[i].n && (m < 0 || ech_lr[i].n > ech_lr[m].n)) m = i;
+        if (m < 0) break;
+        uint64_t a[3] = { ech_lr[m].pc, ech_lr[m].lr, ech_lr[m].sp0 }, b[3], t; int im[3]; char d[3][64];
+        for (int k = 0; k < 3; k++)
+        {
+            b[k] = 0; im[k] = 0;
+            if (a[k] > 0x10000 && ilot_vue_base( (void *)a[k], &b[k], &t, &im[k] ))
+                snprintf( d[k], sizeof(d[k]), "%s 0x%llx+0x%llx", im[k] ? "image" : "vue", (unsigned long long)b[k], (unsigned long long)(a[k] - b[k]) );
+            else snprintf( d[k], sizeof(d[k]), "0x%llx", (unsigned long long)a[k] );
+        }
+        fprintf( stderr, "[CIDRE_ILOT] releve appelant pc %6llu : pc %s <- lr %s ; [sp] %s\n", (unsigned long long)ech_lr[m].n, d[0], d[1], d[2] );
+        ech_lr[m].n = 0;
+    }
+    for (int i = 0; i < NB_ECH_LR; i++) { ech_lr[i].n = 0; ech_lr[i].pc = 0; ech_lr[i].lr = 0; ech_lr[i].sp0 = 0; }
+}
+
+static void *echantillonneur( void *p )
+{
+    for (;;)
+    {
+        usleep( 1000 );
+        pthread_mutex_lock( &ilot_mutex );
+        int n = nb_vcpus;
+        pthread_mutex_unlock( &ilot_mutex );
+        __atomic_store_n( &t_ech_demande, mach_absolute_time(), __ATOMIC_RELEASE );
+        if (n) hv_vcpus_exit( vcpus, n );   /* le registre ne retrecit qu'apres destruction : copie sure */
+    }
+    return NULL;
+}
