+    kuser_copier( 1, 1 );
+    { pthread_t t; pthread_create( &t, NULL, kuser_fil, NULL ); pthread_detach( t ); }
+    echantillon = getenv( "CIDRE_ILOT_ECHANTILLON" ) && atoi( getenv( "CIDRE_ILOT_ECHANTILLON" ) );
