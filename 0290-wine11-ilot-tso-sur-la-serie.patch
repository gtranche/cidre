+    uint64_t va = (uint64_t)zone, *l0 = table( ZONE_L0 ), *l1 = table( ZONE_L1 );
+    tranche_va[1] = va & ~(GIO - 1); tranche_vu[1] = calloc( GIO / PAGE_HOTE / 8, 1 ); tranche_nb = 2;
