+/* (1) objet attendu et contexte ; d : fil bloque sur wait_on_address (entree trouvee) */
+static void analyser_blocage( const struct diag_fil *d )
+{
+    extern int ilot_pc_executable( const void *addr, uint64_t *base, int *image );
+    uint64_t a = d->wa_addr, o[8] = { 0 }; char b1[200], c[160];
+    lire_invite( a - 0x20, o, sizeof(o) );
+    fprintf( stderr, "[CIDRE_ILOT] blocage : fil %04x sur 0x%llx ; octets [a-0x20, a+0x20) : %016llx %016llx %016llx %016llx | %016llx %016llx %016llx %016llx\n",
+             d->tid, (unsigned long long)a, (unsigned long long)o[0], (unsigned long long)o[1], (unsigned long long)o[2], (unsigned long long)o[3],
+             (unsigned long long)o[4], (unsigned long long)o[5], (unsigned long long)o[6], (unsigned long long)o[7] );
+    {   /* lectures possibles de l'objet (le bon se reconnait a la pile ci-dessous) */
+        uint64_t cs[4] = { 0 }; uint32_t w = 0;
+        lire_invite( a - 0x18, cs, sizeof(cs) );   /* section critique si a = &LockSemaphore (+0x18) */
+        lire_invite( a, &w, 4 );
+        fprintf( stderr, "[CIDRE_ILOT] blocage :   si section critique (a = &LockSemaphore) : DebugInfo 0x%llx LockCount %d RecursionCount %d OwningThread %04x -> %s\n",
+                 (unsigned long long)cs[0], (int)(uint32_t)cs[1], (int)(uint32_t)(cs[1] >> 32), (unsigned int)cs[2], etat_fil( (uint32_t)cs[2], b1, sizeof(b1) ) );
+        fprintf( stderr, "[CIDRE_ILOT] blocage :   si SRW (attente partagee sur le verrou entier) : exclusive_waiters %d (tenu exclusif %d, en attente %d), owners %u ;"
+                 " si variable de condition : compteur %llu\n", (int)(int16_t)(w & 0xffff), (int)(w & 1), (int)((int16_t)(w & 0xffff) >> 1), w >> 16,
+                 (unsigned long long)o[4] );
+    }
+    if (d->wa_entree)
+    {   /* file de RtlWaitOnAddress (liste circulaire { next, prev ; addr ; tid } dont la tete est dans les donnees de
+         * ntdll.dll) : coherence des liens, rang de ce fil parmi les dormeurs de la meme adresse (FIFO : le premier est
+         * reveille le premier par RtlWakeAddressSingle), et dormeurs de cette adresse */
+        extern int ilot_vue_base( const void *addr, uint64_t *base, uint64_t *taille, int *image );
+        uint64_t n = d->wa_entree, tete = 0, base, taille; int image, total = 0, meme = 0, rang = -1, rompu = 0;
+        char l[700]; int k = 0;
+        for (int i = 0; i < 1024; i++)
+        {
+            uint64_t e[3] = { 0 }, pn = 0;
+            if (!lire_invite( n, e, sizeof(e) )) { rompu = 1; break; }
+            if (!lire_invite( e[0] + 8, &pn, 8 ) || pn != n) { rompu = 2; break; }   /* next->prev != n */
+            n = e[0];
+            if (n == d->wa_entree) break;
+            if (ilot_vue_base( (void *)n, &base, &taille, &image ) && image) { tete = n; break; }
+        }
+        if (tete && !rompu)
+        {
+            n = tete;
+            for (int i = 0; i < 1024; i++)
+            {
+                uint64_t e[4] = { 0 };
+                if (!lire_invite( n, e, sizeof(e) ) || !e[0]) { rompu = 3; break; }
+                n = e[0];
+                if (n == tete) break;
+                if (!lire_invite( n, e, sizeof(e) )) { rompu = 3; break; }
+                total++;
+                if (e[2] == d->wa_addr)
+                {
+                    if (n == d->wa_entree) rang = meme;
+                    meme++;
+                    if (k < (int)sizeof(l) - 16) k += snprintf( l + k, sizeof(l) - k, " %04x", (unsigned int)e[3] );
+                }
+            }
+        }
+        if (!k) l[0] = 0;
+        fprintf( stderr, "[CIDRE_ILOT] blocage :   file de RtlWaitOnAddress : %s ; tete 0x%llx, %d entree(s), %d sur cette adresse, ce fil au rang %d ; dormeurs :%s\n",
+                 rompu == 1 ? "ENTREE ILLISIBLE" : rompu == 2 ? "LIEN ROMPU (next->prev incoherent)" : rompu == 3 ? "parcours interrompu" :
+                 !tete ? "tete introuvable (liste sans tete dans ntdll ?)" : rang == 0 ? "coherente, CE FIL EST LE PREMIER (un reveil simple aurait du le prendre)" : "coherente",
+                 (unsigned long long)tete, total, meme, rang, l );
+    }
+    {   /* pile du fil bloque : adresses dans du code (RtlWaitOnAddress, son appelant ntdll, kernelbase, puis le jeu) */
+        uint64_t s[512], prec = 0; int dits = 0;
+        fprintf( stderr, "[CIDRE_ILOT] blocage :   pile du fil %04x (sp 0x%llx) :", d->tid, (unsigned long long)d->blq_sp );
+        for (uint64_t off = 0; off < 0x2000 && dits < 20; off += sizeof(s))
+        {
+            if (!lire_invite( d->blq_sp + off, s, sizeof(s) )) break;
+            for (unsigned int i = 0; i < 512 && dits < 20; i++)
+            {
+                uint64_t q = s[i], base = 0; int image = 0;
+                if (q < 0x10000 || q == prec || !ilot_pc_executable( (void *)q, &base, &image )) continue;
+                prec = q; dits++;
+                fprintf( stderr, " [+0x%llx %s]", (unsigned long long)(off + i * 8), decrire_pc( q, c, sizeof(c) ) );
+            }
+        }
+        fprintf( stderr, "\n" );
+    }
+    sonde_coherence( a );
+    {   /* etat de tous les fils de l'ilot */
+        int nb = __atomic_load_n( &nb_diag_fils, __ATOMIC_RELAXED ), k = 0;
+        char l[1024]; int n = 0;
+        if (nb > NB_DIAG_FILS) nb = NB_DIAG_FILS;
+        for (int i = 0; i < nb; i++)
+        {
+            if (diag_fils[i].mort) continue;
+            etat_fil( diag_fils[i].tid, b1, sizeof(b1) );
+            if (!n) n = snprintf( l, sizeof(l), "[CIDRE_ILOT] blocage :   fils :" );
+            n += snprintf( l + n, sizeof(l) - n, " %s |", b1 );
+            if (++k % 4 == 0 || n > 800) { fprintf( stderr, "%s\n", l ); n = 0; }
+        }
+        if (n) fprintf( stderr, "%s\n", l );
+    }
+}
