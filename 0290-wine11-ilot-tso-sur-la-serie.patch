+static void *chrono_fil( void *p )
+{
+    static uint64_t av_n[CHRONO_NB], av_t[CHRONO_NB];
+    extern int ilot_c_code_ecrit, ilot_c_gen_sections;   /* LONG = int (32 bits) cote unix */
+    extern int ilot_c_rejeux, ilot_c_rejeux_refuses, ilot_c_rx_ferme;   /* defaut 1 v2 (virtual.c) */
+    static int av_rej[3];
+    extern int ilot_rearm_identiques, ilot_arm_deja_vus, ilot_arm_inedits, ilot_arm_neufs, ilot_arm_premiers, ilot_arm_adresse_connue, ilot_hist_pleine;
+    static int av_arm[7];
+    uint64_t av[14] = { 0 };
+    for (unsigned int tour = 0;; tour++)
+    {
+        usleep( 100000 );
+        uint64_t nv[14] = { (uint64_t)ilot_c_code_ecrit, (uint64_t)ilot_c_gen_sections, c_exceptions, c_vidages, c_retraits,
+                            c_s2, c_appels_hote, c_cessions, t_vcpu, c_projeter, t_projeter, c_proj_de, t_proj_de, c_reprot_pages };
+        uint64_t d[14];
+        for (int i = 0; i < 14; i++) { d[i] = nv[i] - av[i]; av[i] = nv[i]; }
+        /* chronologie legere : appels HV, talons TLBI (temps), compteurs de FEX */
+        static uint64_t av_hv[8], av_fx[9], av_src_n[FEX_CPT_SOURCES], av_src_o[FEX_CPT_SOURCES], av_fil_b[FEX_CPT_FILS], av_fil_t[FEX_CPT_FILS];
+        uint64_t hv[8] = { c_hv_map, t_hv_map, c_hv_unmap, t_hv_unmap, p_hv_unmap, c_hv_prot, t_hv_prot, t_tlbi }, dhv[8];
