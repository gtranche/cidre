+/* signal_arm64.c : livraison par le chemin de Wine ; 0 rejouer, 1 reprendre avec r, -1 non pris en charge */
+extern int ilot_exception( struct ilot_regs *r, uint64_t va, int genre, uint64_t esr_invite );
