+/* Gio decoupes en tables L2/L3 (miroir KUSER, sous-pages exactes de l'etape 5b) : identite (tranche n), sauf la page
+ * du miroir KUSER. Une entree est ecrite avant d'etre publiee (nb_decoupes, puis l'entree L1) : ipa_de la lit sans
+ * mutex depuis creer_vcpu. */
+#define NB_DECOUPES 64
+static struct { uint64_t gio, n; uint64_t *l2; } decoupes[NB_DECOUPES];
+static int nb_decoupes;
+static uint64_t kuser_va[2];             /* 0x7ffe0000 et user_shared_data (virtual.c) */
+
+/* IPA d'une VA deja servie (tables lues comme le ferait l'invite), 0 sinon */
+static uint64_t ipa_de( uint64_t va )
+{
+    uint64_t d0 = table( ZONE_L0 )[(va >> 39) & 511];
+    if (!(d0 & 1)) return 0;
+    uint64_t l1ipa = d0 & 0x0000fffffffff000ull, n = l1ipa >> 30;
+    uint64_t *l1 = (uint64_t *)(tranche_va[n] + (l1ipa & (GIO - 1)));
+    uint64_t d1 = __atomic_load_n( &l1[(va >> 30) & 511], __ATOMIC_ACQUIRE );
+    if (!(d1 & 1)) return 0;
+    if ((d1 & 3) == 3)
+    {   /* Gio decoupe : identite dans sa tranche (la page du miroir KUSER n'est jamais une projection de l'hote) ; une
+         * entree L3 invalide (sous-page sans acces, 5b) n'y change rien : la VA reste servie */
+        int nb = __atomic_load_n( &nb_decoupes, __ATOMIC_ACQUIRE );
+        for (int i = 0; i < nb; i++)
+            if (decoupes[i].gio == (va & ~(GIO - 1))) return (decoupes[i].n << 30) | (va & (GIO - 1));
+        return 0;
+    }
+    return (d1 & 0x000000ffc0000000ull) | (va & (GIO - 1));
+}
+
+/* page de table neuve dans la zone ; mutex tenu. t2 : tables de l'etape 5b, prises dans [ZONE_TABLES2, ZONE_KUSER)
+ * seulement (elles ne prennent jamais la place des L1 : epuisees, l'etape 5b se replie sur l'union de 5a) */
+static uint64_t *table_neuve( uint64_t *ipa, int t2 )
+{
+    size_t *pris = t2 ? &zone_t2_pris : &zone_l1_pris, fin = t2 ? ZONE_KUSER : ZONE_MIROIRS;
+    if (*pris + 0x1000 > fin) return NULL;
+    uint64_t *t = table( *pris );
+    memset( t, 0, 0x1000 );
+    *ipa = ipa_de( (uint64_t)t );
+    if (!*ipa) return NULL;
+    *pris += 0x1000;
+    return t;
+}
