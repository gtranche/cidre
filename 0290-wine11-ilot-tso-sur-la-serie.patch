+/* reecrit les pages modifiees des copies qui recouvrent [base, base + size) ; liberer : la vue disparait. Rend le
+ * nombre de copies touchees. virtual_mutex tenu (sauf a la fin du processus) */
+static int copies_reecrire( const char *base, size_t size, BOOL liberer )
+{
+    struct copie_reecrite *c, *suivant;
+    int vues = 0;
+
+    LIST_FOR_EACH_ENTRY_SAFE( c, suivant, &copies_reecrites, struct copie_reecrite, entry )
+    {
+        size_t o;
+        if (c->base >= base + size || c->base + c->taille <= base) continue;
+        vues++;
+        for (o = 0; o < c->taille; o += page_size)
+        {
+            size_t n = min( page_size, c->taille - o );
+            char tampon[0x1000];
+            mach_vm_size_t lu = 0;
+            if (n > sizeof(tampon)) n = sizeof(tampon);
+            /* lecture sans faute, quelle que soit la protection de la page (une page inaccessible est sautee) */
+            if (mach_vm_read_overwrite( mach_task_self(), (mach_vm_address_t)(UINT_PTR)(c->base + o), n,
+                                        (mach_vm_address_t)(UINT_PTR)tampon, &lu ) || lu != n) continue;
+            if (!memcmp( tampon, c->image + o, n )) continue;
+            if (pwrite( c->fd, tampon, n, c->decalage + o ) == (ssize_t)n)
+            {
+                memcpy( c->image + o, tampon, n );
+                InterlockedIncrement( &copies_reecrites_pages );
+            }
+            else if (InterlockedIncrement( &copies_reecrites_echecs ) <= 8)
+                fprintf( stderr, "[CIDRE_ILOT] vue partagee en copie reecrite : pwrite %s +0x%lx : %s\n", c->chemin,
+                         (unsigned long)(c->decalage + o), strerror( errno ) );
+        }
+        if (liberer && c->base >= base && c->base + c->taille <= base + size)
+        {
+            fprintf( stderr, "[CIDRE_ILOT] vue partagee en copie reecrite : demappee %p (%s), %ld page(s) reecrite(s) en tout\n",
+                     c->base, c->chemin, (long)copies_reecrites_pages );
+            list_remove( &c->entry );
+            close( c->fd );
+            free( c->image );
+            free( c );
+        }
+    }
