+/* Appels systeme servis dans la boucle (CIDRE_ILOT_APPELS_RAPIDES, par defaut actif ; 0 : coupe). Un appel systeme
+ * coute ~1,3 us dans l'ilot (a64ilot Q2 : 1 347 ns contre 24 ns sur l'hote) : sortie, 36 lectures de registres,
+ * ilot_sauter, __wine_syscall_dispatcher (cadre complet, 32 q), ilot_retour, entrer_court, prologue de boucle. D2R en
+ * fait 30 000 a 40 000 par 100 ms de NtQueryVirtualMemory (0x23) ou de NtQuerySystemTime (0x5a) pendant ses trous.
+ * Ces deux-la sont servis ici, sans quitter la boucle : x0..x5 lus, fonction de l'hote appelee, x0 = statut,
+ * lr = x9 et pc = x30, exactement ce que le retour du repartiteur poserait (frame->lr = x9, frame->pc = x30 ; x1-x17
+ * sont jetables pour l'appelant, NZCV, FPCR, FPSR, q et sp inchanges). Seulement quand l'hote ne peut pas fauter en
+ * ecrivant le resultat : tampons de sortie dans la pile engagee du fil ([StackLimit, StackBase) du TEB), alignes ;
+ * NtQueryVirtualMemory seulement pour MemoryBasicInformation du processus courant (aucune requete au serveur, aucune
+ * lecture de memoire de l'invite). Sinon, chemin complet. Coupe sous les diagnostics qui suivent chaque appel. */
+static int rapides_actif = -1;
+extern unsigned int NtQuerySystemTime( void *time );
+extern unsigned int NtQueryVirtualMemory( void *process, const void *addr, unsigned int classe, void *info, size_t len, size_t *rendu );
+static int dans_pile( uint64_t a, uint64_t n, uint64_t limite, uint64_t base )
+{
+    return a >= limite && a + n >= a && a + n <= base;
+}
+/* x8 = NtQueryVirtualMemory deja vu : classe 0xc1d1 et processus courant -> adresse des compteurs de FEX, verifiee
+ * par vm_read (une adresse fausse ne fait pas fauter l'hote : refus), puis retour comme le repartiteur (x0 = statut,
+ * lr = x9, pc = x30). Toute autre classe : 0, chemin habituel. */
+static int fex_annonce( hv_vcpu_t v )
+{
+    uint64_t x0, x1, x2, x9, x30, tete[2] = { 0 };
+    mach_vm_size_t lu = 0;
+    unsigned int st;
+    hv_vcpu_get_reg( v, HV_REG_X2, &x2 );
+    if ((uint32_t)x2 != 0xc1d1) return 0;
+    hv_vcpu_get_reg( v, HV_REG_X0, &x0 );
+    hv_vcpu_get_reg( v, HV_REG_X1, &x1 );
+    if (x0 != ~0ull || (x1 & 7)) st = 0xc0000008;   /* STATUS_INVALID_HANDLE */
+    else if (mach_vm_read_overwrite( mach_task_self(), x1, sizeof(tete), (mach_vm_address_t)tete, &lu ) || lu != sizeof(tete) ||
+             tete[0] != FEX_CPT_MAGIE || (tete[1] >> 32) != 1 || (uint32_t)tete[1] != sizeof(struct cidre_fex_cpt))
+        st = 0xc0000004;   /* STATUS_INFO_LENGTH_MISMATCH : disposition differente */
+    else
+    {
+        __atomic_store_n( &fex_cpt, (struct cidre_fex_cpt *)x1, __ATOMIC_RELEASE );
+        st = 0;
+    }
+    __atomic_fetch_add( &c_fex_annonces, 1, __ATOMIC_RELAXED );
+    hv_vcpu_get_reg( v, HV_REG_X9, &x9 ); hv_vcpu_get_reg( v, HV_REG_X30, &x30 );
+    hv_vcpu_set_reg( v, HV_REG_X0, st );
+    hv_vcpu_set_reg( v, HV_REG_X30, x9 );
+    hv_vcpu_set_reg( v, HV_REG_PC, x30 );
+    __atomic_fetch_add( &c_appels_hote, 1, __ATOMIC_RELAXED );
+    return 1;
+}
+static int appel_rapide( hv_vcpu_t v )
+{
+    extern pthread_key_t cle_teb_globale;
+    uint64_t x8, x[6], x9, x30, teb, base, limite, t0 = 0;
+    unsigned int st, num;
+    if (rapides_actif < 0)
+        rapides_actif = !(getenv( "CIDRE_ILOT_APPELS_RAPIDES" ) && !atoi( getenv( "CIDRE_ILOT_APPELS_RAPIDES" ) ));
+    if (chrono_actif && !__atomic_load_n( &fex_cpt, __ATOMIC_RELAXED ))
+    {   /* annonce des compteurs de FEX : NtQueryVirtualMemory( -1, &compteurs, 0xc1d1, ... ), sous la chronologie seule,
+         * jusqu'a la premiere acceptee ; servie meme sous XPROC, BLOQUES ou DIAG (aucun etat de Wine touche) */
+        hv_vcpu_get_reg( v, HV_REG_X8, &x8 );
+        if ((x8 & 0x3fff) == 0x23 && fex_annonce( v )) return 1;
+    }
+    if (!rapides_actif || ilot_diag || xproc_actif || bloques_actif) return 0;
+    hv_vcpu_get_reg( v, HV_REG_X8, &x8 );
+    num = (unsigned int)(x8 & 0x3fff);   /* table 0 (ntdll) seulement */
+    if (num != 0x5a && num != 0x23) return 0;
+    if (!(teb = (uint64_t)pthread_getspecific( cle_teb_globale ))) return 0;
+    base = ((const volatile uint64_t *)teb)[1];     /* NT_TIB.StackBase */
+    limite = ((const volatile uint64_t *)teb)[2];   /* NT_TIB.StackLimit : pages engagees au-dessus */
+    if (!limite || base <= limite) return 0;
+    {   /* tampons dans la partie vivante de la pile : au-dessus du sp de l'invite */
+        uint64_t sp = 0;
+        hv_vcpu_get_sys_reg( v, HV_SYS_REG_SP_EL1, &sp );
+        if (sp < limite || sp >= base) return 0;
+        limite = sp;
+    }
+    hv_vcpu_get_reg( v, HV_REG_X0, &x[0] );
+    if (chrono_actif) t0 = mach_absolute_time();
+    if (num == 0x5a)
+    {   /* NtQuerySystemTime( LARGE_INTEGER *time ) */
+        if ((x[0] & 7) || !dans_pile( x[0], 8, limite, base )) { __atomic_fetch_add( &c_rapides_refus, 1, __ATOMIC_RELAXED ); return 0; }
+        st = NtQuerySystemTime( (void *)x[0] );
+        __atomic_fetch_add( &c_rapides_temps, 1, __ATOMIC_RELAXED );
+    }
+    else
+    {   /* NtQueryVirtualMemory( process, addr, class, info, len, *res_len ) */
+        for (int i = 1; i < 6; i++) hv_vcpu_get_reg( v, HV_REG_X0 + i, &x[i] );
+        if (x[0] != ~0ull || (uint32_t)x[2] != 0 /* MemoryBasicInformation (enum : w2) */ || x[4] < 48 || x[4] > 0x10000 ||
+            (x[3] & 7) || !dans_pile( x[3], x[4], limite, base ) ||
+            (x[5] && ((x[5] & 7) || !dans_pile( x[5], 8, limite, base )))) { __atomic_fetch_add( &c_rapides_refus, 1, __ATOMIC_RELAXED ); return 0; }
+        st = NtQueryVirtualMemory( (void *)x[0], (const void *)x[1], 0, (void *)x[3], x[4], (size_t *)x[5] );
+        __atomic_fetch_add( &c_rapides_requete, 1, __ATOMIC_RELAXED );
+    }
+    hv_vcpu_get_reg( v, HV_REG_X9, &x9 ); hv_vcpu_get_reg( v, HV_REG_X30, &x30 );
+    hv_vcpu_set_reg( v, HV_REG_X0, st );
+    hv_vcpu_set_reg( v, HV_REG_X30, x9 );
+    hv_vcpu_set_reg( v, HV_REG_PC, x30 );
+    __atomic_fetch_add( &c_appels_hote, 1, __ATOMIC_RELAXED );
+    if (chrono_actif)
+    {
+        __atomic_fetch_add( &chrono_t[num], mach_absolute_time() - t0, __ATOMIC_RELAXED );
+        __atomic_fetch_add( &chrono_n[num], 1, __ATOMIC_RELAXED );
+    }
+    return 1;
+}
