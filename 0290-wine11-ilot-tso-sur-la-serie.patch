+    fil.xp_num = 0;
+    if (n >= 0x110 || __atomic_fetch_add( &par_num[n], 1, __ATOMIC_RELAXED ) >= 300 || __atomic_fetch_add( &lignes, 1, __ATOMIC_RELAXED ) >= 5000) return;
+    switch (n)
+    {
+    case 0x8b:   /* (HANDLE *, access, attr, process, start, param, flags, ...) */
+        lire_invite( a[0], &v, 8 );
+        snprintf( d, sizeof(d), "processus %s, depart 0x%llx, param 0x%llx, drapeaux 0x%llx%s -> %s", decrire_proc_h( a[3], b1, sizeof(b1) ),
+                  (unsigned long long)a[4], (unsigned long long)a[5], (unsigned long long)(a[6] & 0xffffffff), (a[6] & 1) ? " (SUSPENDU)" : "",
+                  st ? "-" : decrire_fil_h( v, b2, sizeof(b2) ) );
+        break;
+    case 0x4e:   /* (HANDLE *, access, attr, process, CLIENT_ID *, ctx, teb, suspended) */
+        lire_invite( a[0], &v, 8 );
+        snprintf( d, sizeof(d), "processus %s, suspendu %llu -> %s", decrire_proc_h( a[3], b1, sizeof(b1) ), (unsigned long long)(a[7] & 0xff),
+                  st ? "-" : decrire_fil_h( v, b2, sizeof(b2) ) );
+        break;
+    case 0x8f:   /* (HANDLE *process, HANDLE *thread, ..., process_flags, thread_flags, params (pile)) */
+    {
+        uint64_t prm = 0; uint16_t lg = 0; uint64_t buf = 0; uint16_t wc[128] = { 0 }; char img[130] = "?";
+        if (lire_invite( fil.xp_sp, &prm, 8 ) && lire_invite( prm + 0x60, &lg, 2 ) && lire_invite( prm + 0x68, &buf, 8 ))
+        {
+            unsigned int k, m = lg / 2 < 128 ? lg / 2 : 128;
+            if (m && lire_invite( buf, wc, m * 2 )) { for (k = 0; k < m; k++) img[k] = wc[k] < 128 ? (char)wc[k] : '?'; img[k] = 0; }
+        }
+        lire_invite( a[0], &v, 8 ); lire_invite( a[1], &w, 8 );
+        snprintf( d, sizeof(d), "image %s, drapeaux processus 0x%llx fil 0x%llx%s -> %s, %s", img, (unsigned long long)(a[6] & 0xffffffff),
+                  (unsigned long long)(a[7] & 0xffffffff), (a[7] & 1) ? " (SUSPENDU)" : "",
+                  st ? "-" : decrire_proc_h( v, b1, sizeof(b1) ), st ? "-" : decrire_fil_h( w, b2, sizeof(b2) ) );
+        break;
+    }
+    case 0x52: case 0x65: case 0xfb:   /* (HANDLE thread, ULONG *count) */
+    {
+        uint32_t cpt = 0; int lu = a[1] && lire_invite( a[1], &cpt, 4 );
+        snprintf( d, sizeof(d), "%s, compte precedent %s%u", decrire_fil_h( a[0], b1, sizeof(b1) ), lu ? "" : "? ", cpt );
+        break;
+    }
+    case 0x9d: case 0xe4: case 0x45: case 0xd3: case 0xd4: case 0x53:
+        snprintf( d, sizeof(d), "%s, arg2 0x%llx", decrire_fil_h( a[0], b1, sizeof(b1) ), (unsigned long long)a[1] ); break;
+    case 0xe0: case 0xfa: case 0x2c:
+        snprintf( d, sizeof(d), "%s%s", decrire_proc_h( a[0], b1, sizeof(b1) ), n == 0x2c ? (a[0] ? "" : " (autres fils)") : "" ); break;
+    case 0x26: case 0xbe:   /* (HANDLE *, access, attr, CLIENT_ID *) */
+    {
+        uint64_t cid[2] = { 0 }; lire_invite( a[3], cid, 16 ); lire_invite( a[0], &v, 8 );
+        snprintf( d, sizeof(d), "vise proc %04x fil %04x, acces 0x%llx -> h 0x%llx", (unsigned int)cid[0], (unsigned int)cid[1],
+                  (unsigned long long)(a[1] & 0xffffffff), (unsigned long long)(st ? 0 : v) );
+        break;
+    }
+    case 0x3a: case 0x3f:   /* (process, addr, buffer, size, SIZE_T *) */
+        snprintf( d, sizeof(d), "%s, adresse 0x%llx, taille 0x%llx", decrire_proc_h( a[0], b1, sizeof(b1) ), (unsigned long long)a[1], (unsigned long long)a[3] ); break;
+    case 0x18: case 0x6b: case 0x50: case 0x1e:   /* (process, void **addr, ...size* en a[3] (0x18) ou a[2]) */
+    {
+        uint64_t sz = 0; lire_invite( a[1], &v, 8 ); lire_invite( n == 0x18 ? a[3] : a[2], &sz, 8 );
+        uint64_t pr = n == 0x18 ? a[5] : n == 0x6b ? a[4] : n == 0x50 ? a[3] : a[3];
+        snprintf( d, sizeof(d), "%s, adresse 0x%llx, taille 0x%llx, %s 0x%llx", decrire_proc_h( a[0], b1, sizeof(b1) ), (unsigned long long)v,
+                  (unsigned long long)sz, n == 0x1e ? "type" : "droits", (unsigned long long)(pr & 0xffffffff) );
+        break;
+    }
+    case 0x2a: case 0x104:
+        snprintf( d, sizeof(d), "%s, adresse 0x%llx", decrire_proc_h( a[0], b1, sizeof(b1) ), (unsigned long long)a[1] ); break;
+    case 0x28: case 0xb0:   /* (section, process, void **addr, ...) */
+        lire_invite( a[2], &v, 8 );
+        snprintf( d, sizeof(d), "section 0x%llx, %s, adresse 0x%llx", (unsigned long long)a[0], decrire_proc_h( a[1], b2, sizeof(b2) ), (unsigned long long)v ); break;
+    }
+    fprintf( stderr, "[ILOT_XPROC] pid %d fil %04x abs %.3f : %s(%s) = 0x%x en %.1f ms ; appelant %s\n", getpid(), tid_courant(),
+             ms( fil.xp_t ), nom_appel( n ) ? nom_appel( n ) : "?", d, (unsigned int)st, ms( mach_absolute_time() - fil.xp_t ),
+             decrire_pc( fil.xp_lr, c, sizeof(c) ) );
+}
