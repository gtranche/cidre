+static uint64_t continu_moins_absolu( void )
+{
+    const volatile uint64_t *tb_off = (const volatile uint64_t *)0x0000000FFFFFC088ull,
+                            *cont = (const volatile uint64_t *)0x0000000FFFFFC098ull,
+                            *cont_hw = (const volatile uint64_t *)0x0000000FFFFFC0A8ull;
+    if (*(const volatile uint8_t *)0x0000000FFFFFC091ull) return *cont_hw - *tb_off;   /* CONT_HWCLOCK */
+    return *cont;
