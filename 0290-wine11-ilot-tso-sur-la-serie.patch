+/* diagnostic d'un refus : la region de l'hote, la pile du fil hote, les registres de l'invite */
+static void decrire_refus( hv_vcpu_t v, uint64_t page )
+{
+    mach_vm_address_t a = page; mach_vm_size_t s = 0; natural_t prof = 0;
+    vm_region_submap_info_data_64_t i; mach_msg_type_number_t n = VM_REGION_SUBMAP_INFO_COUNT_64;
+    int vue, vp_ok;
+    unsigned int vp_vue = 0, vp_page = 0;
+    extern int ilot_vue_protect( const void *addr, unsigned int *vue, unsigned int *page );
+    ilot_verrou_virtuel( 1 ); vue = ilot_vue_windows( (void *)page ); vp_ok = ilot_vue_protect( (void *)page, &vp_vue, &vp_page ); ilot_verrou_virtuel( 0 );
+    {   /* vue Windows (SEC_FILE 0x800000 : vrai fichier ; SEC_IMAGE 0x1000000 ; VPROT_WRITE 2, VPROT_WRITECOPY 8) et fichier
+         * qui porte la region de l'hote, s'il y en a un */
+        char chemin[1024] = "";
+        if (proc_regionfilename( getpid(), page, chemin, sizeof(chemin) ) <= 0) strcpy( chemin, "-" );
+        fprintf( stderr, "[CIDRE_ILOT]   vue protect %#x (fichier %d, image %d), page vprot %#x (ecriture %d, copie %d), fichier de la region %s\n",
+                 vp_ok ? vp_vue : 0, vp_ok && (vp_vue & 0x800000) != 0, vp_ok && (vp_vue & 0x1000000) != 0, vp_page,
+                 (vp_page & 2) != 0, (vp_page & 8) != 0, chemin );
+    }
+    if (!mach_vm_region_recurse( mach_task_self(), &a, &s, &prof, (vm_region_recurse_info_t)&i, &n ))
+        fprintf( stderr, "[CIDRE_ILOT]   region 0x%llx-0x%llx mode %d pager_ext %d etiquette %u sous_carte %d prot %d/%d vue Windows %d\n",
+                 (unsigned long long)a, (unsigned long long)(a + s), i.share_mode, i.external_pager, i.user_tag, i.is_submap,
+                 i.protection, i.max_protection, vue );
+    char *pile = pthread_get_stackaddr_np( pthread_self() );
+    size_t taille = pthread_get_stacksize_np( pthread_self() );
+    fprintf( stderr, "[CIDRE_ILOT]   pile du fil hote 0x%llx-0x%llx\n", (unsigned long long)(pile - taille), (unsigned long long)pile );
+    uint64_t r[31], pc, sp, elr;
+    for (int k = 0; k < 31; k++) hv_vcpu_get_reg( v, HV_REG_X0 + k, &r[k] );
+    hv_vcpu_get_reg( v, HV_REG_PC, &pc ); hv_vcpu_get_sys_reg( v, HV_SYS_REG_SP_EL1, &sp ); hv_vcpu_get_sys_reg( v, HV_SYS_REG_ELR_EL1, &elr );
+    {   /* qui possede la page, et d'ou vient le pointeur */
+        Dl_info di; uint64_t tp = 0, tpro = 0;
+        const char *img = dladdr( (void *)page, &di ) && di.dli_fname ? di.dli_fname : "-";
+        malloc_zone_t *z = malloc_zone_from_ptr( (void *)page );
+        hv_vcpu_get_sys_reg( v, HV_SYS_REG_TPIDR_EL0, &tp ); hv_vcpu_get_sys_reg( v, HV_SYS_REG_TPIDRRO_EL0, &tpro );
+        fprintf( stderr, "[CIDRE_ILOT]   image %s, zone malloc %s, invite TPIDR_EL0 0x%llx TPIDRRO_EL0 0x%llx\n", img,
+                 z ? (z->zone_name ? z->zone_name : "?") : "-", (unsigned long long)tp, (unsigned long long)tpro );
+    }
+    fprintf( stderr, "[CIDRE_ILOT]   invite pc 0x%llx sp 0x%llx fp 0x%llx lr 0x%llx\n", (unsigned long long)pc, (unsigned long long)sp,
+             (unsigned long long)r[29], (unsigned long long)r[30] );
+    {   /* instructions de l'invite avant le pc, lues sans effet de bord */
+        uint32_t w[9]; mach_vm_size_t lu = 0;
+        uint64_t debut = (pc - 32) & ~3ull;
+        if (!mach_vm_read_overwrite( mach_task_self(), debut, sizeof(w), (mach_vm_address_t)w, &lu ) && lu == sizeof(w))
+            fprintf( stderr, "[CIDRE_ILOT]   code 0x%llx : %08x %08x %08x %08x %08x %08x %08x %08x [%08x]\n", (unsigned long long)debut,
+                     w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8] );
+        uint64_t m[8]; lu = 0;
+        if (!mach_vm_read_overwrite( mach_task_self(), page, sizeof(m), (mach_vm_address_t)m, &lu ) && lu == sizeof(m))
+            fprintf( stderr, "[CIDRE_ILOT]   page refusee, 64 premiers octets : %016llx %016llx %016llx %016llx %016llx %016llx %016llx %016llx\n",
+                     (unsigned long long)m[0], (unsigned long long)m[1], (unsigned long long)m[2], (unsigned long long)m[3],
+                     (unsigned long long)m[4], (unsigned long long)m[5], (unsigned long long)m[6], (unsigned long long)m[7] );
+    }
+    for (int k = 0; k < 29; k += 4)
+        fprintf( stderr, "[CIDRE_ILOT]   x%-2d 0x%llx 0x%llx 0x%llx 0x%llx\n", k, (unsigned long long)r[k], (unsigned long long)r[k + 1],
+                 (unsigned long long)(k + 2 < 31 ? r[k + 2] : 0), (unsigned long long)(k + 3 < 31 ? r[k + 3] : 0) );
+    fflush( stderr );
+}
