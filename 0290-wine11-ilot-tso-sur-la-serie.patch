+/* tous les registres de l'invite, dans les deux sens (exceptions, premier retour d'un fil) */
+static void lire_regs( hv_vcpu_t v, struct ilot_regs *r )
+{
+    uint64_t cpsr;
+    for (int i = 0; i < 31; i++) hv_vcpu_get_reg( v, HV_REG_X0 + i, &r->x[i] );
+    hv_vcpu_get_reg( v, HV_REG_PC, &r->pc );
+    hv_vcpu_get_sys_reg( v, HV_SYS_REG_SP_EL1, &r->sp );
+    hv_vcpu_get_reg( v, HV_REG_CPSR, &cpsr ); r->nzcv = cpsr & 0xf0000000;
+    hv_vcpu_get_reg( v, HV_REG_FPCR, &r->fpcr ); hv_vcpu_get_reg( v, HV_REG_FPSR, &r->fpsr );
+    for (int i = 0; i < 32; i++) { hv_simd_fp_uchar16_t q; hv_vcpu_get_simd_fp_reg( v, HV_SIMD_FP_REG_Q0 + i, &q ); memcpy( &r->v[i], &q, 16 ); }
+}
