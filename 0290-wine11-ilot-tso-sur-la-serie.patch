+    if (fil.t_sortie)
+    {   /* chronologie : duree de l'appel hote qui se termine */
+        uint32_t k = fil.num_sortie < CHRONO_NB ? fil.num_sortie : CHRONO_AUTRE;
+        __atomic_fetch_add( &chrono_t[k], mach_absolute_time() - fil.t_sortie, __ATOMIC_RELAXED );
+        __atomic_fetch_add( &chrono_n[k], 1, __ATOMIC_RELAXED );
