+/* vues partagees de sections sans fichier (pagefile), marquees par map_file_into_view dans TOUS les processus de ce
+ * runtime : aucun ne les execute (ilot_mprotect retire PROT_EXEC ; macOS refuse deja l'execution d'un MAP_SHARED,
+ * 0062) ; leur fichier, temporaire et supprime des sa creation par le wineserver, n'est detenu que par lui et ses
+ * clients, tous de ce runtime. Leurs frames ne prennent donc jamais de type executable : l'ilot peut les projeter. */
+static uint8_t *pagefile_carte[NB_GIO_VA];
+static void marquer_pf( uint64_t a, uint64_t len, int oui )
+{
+    uint64_t fin = a + len;
+    pthread_mutex_lock( &carte_mutex );
+    for (a &= ~(PAGE_HOTE - 1); a < fin; a += PAGE_HOTE)
+    {
+        uint64_t g = a >> 30, k = (a & (GIO - 1)) / PAGE_HOTE;
+        if (g >= NB_GIO_VA) break;
+        if (!pagefile_carte[g]) { if (!oui) { a = ((g + 1) << 30) - PAGE_HOTE; continue; } pagefile_carte[g] = calloc( GIO / PAGE_HOTE / 8, 1 ); if (!pagefile_carte[g]) break; }
+        if (oui) pagefile_carte[g][k / 8] |= 1 << (k % 8); else pagefile_carte[g][k / 8] &= ~(1 << (k % 8));
+    }
+    pthread_mutex_unlock( &carte_mutex );
+}
+void ilot_marquer_pagefile( const void *addr, size_t len ) { marquer_pf( (uint64_t)addr, len, 1 ); }
+static int pf_marquee( uint64_t page )
+{
+    uint64_t g = page >> 30, k = (page & (GIO - 1)) / PAGE_HOTE;
+    int r;
+    pthread_mutex_lock( &carte_mutex );
+    r = g < NB_GIO_VA && pagefile_carte[g] && (pagefile_carte[g][k / 8] & (1 << (k % 8)));
+    pthread_mutex_unlock( &carte_mutex );
+    return r;
+}
+static int pf_dans( uint64_t a, uint64_t len )
+{
+    for (uint64_t p = a & ~(PAGE_HOTE - 1); p < a + len; p += PAGE_HOTE) if (pf_marquee( p )) return 1;
+    return 0;
+}
+int ilot_pagefile_dans( const void *addr, size_t len ) { return pf_dans( (uint64_t)addr, len ); }   /* bascule_wx_page */
