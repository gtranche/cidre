+/* chronologie (CIDRE_ILOT_CHRONO=1, sans CIDRE_ILOT_DIAG au besoin) : toutes les 100 ms, l'heure murale a la
+ * milliseconde et ce qui s'est passe dans l'intervalle, pour mettre les trous d'images (trace WSI, heure murale) en
+ * regard : jumelles ecrites (CodeEcrit, ecritures du noyau), exceptions livrees, talons TLBI, retraits et projections du
+ * deuxieme etage, appels hote, cessions de vCPU, temps passe dans les vCPU. Une ligne n'est ecrite que si l'intervalle
+ * n'est pas vide de jumelles, d'exceptions ou de TLBI, ou une fois par seconde. */
+/* echantillonneur leger de la chronologie par fil : sortie forcee de tous les vCPU toutes les 10 ms */
+static void *chrono_ech_fil( void *p )
+{
+    for (;;)
+    {
+        usleep( 10000 );
+        pthread_mutex_lock( &ilot_mutex );
+        int n = nb_vcpus;
+        pthread_mutex_unlock( &ilot_mutex );
+        __atomic_store_n( &t_ech_demande, mach_absolute_time(), __ATOMIC_RELEASE );
+        if (n) hv_vcpus_exit( vcpus, n );
+    }
+    return NULL;
+}
