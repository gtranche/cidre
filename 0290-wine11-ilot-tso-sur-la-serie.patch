+static void creer_vcpu( void )
+{
+    uint64_t v;
+    hv_return_t rc;
+    if (fil.pret) return;   /* le fil a deja son vCPU (rendre_vcpu refuse) : un 2e hv_vcpu_create rendrait HV_BUSY */
+    if (!fil.hote)
+    {
+        fil.hote = calloc( 1, sizeof(*fil.hote) );
+        if (!fil.hote) fatal( "fil_hote", 0, 0, 0 );
+        pthread_setspecific( cle_vcpu, fil.hote );
+        if (xproc_actif) fprintf( stderr, "[ILOT_XPROC] pid %d fil %04x abs %.3f : premiere entree dans l'ilot\n", getpid(), tid_courant(), ms( mach_absolute_time() ) );
+    }
+    /* une place sous le plafond de HVF ; sinon pression : les fils qui se bloquent cedent la leur, ceux qui tournent
+     * sont forces a sortir et cedent apres leur quantum */
+    for (;;)
+    {
+    pthread_mutex_lock( &ilot_mutex );
+    while ((uint32_t)nb_vcpus >= max_vcpus)
+    {
+        struct timespec ts; clock_gettime( CLOCK_REALTIME, &ts );
+        ts.tv_nsec += 2000000; if (ts.tv_nsec >= 1000000000) { ts.tv_sec++; ts.tv_nsec -= 1000000000; }
+        en_attente++; __atomic_store_n( &pression, 1, __ATOMIC_RELEASE );
+        if (nb_vcpus) hv_vcpus_exit( vcpus, nb_vcpus );
+        pthread_cond_timedwait( &place_cond, &ilot_mutex, &ts );
+        en_attente--;
+    }
+    if (!en_attente) __atomic_store_n( &pression, 0, __ATOMIC_RELEASE );
+    vcpus[nb_vcpus] = 0; fils[nb_vcpus] = NULL; nb_vcpus++;   /* place reservee */
+    pthread_mutex_unlock( &ilot_mutex );
+    if (!(rc = hv_vcpu_create( &fil.v, &fil.e, NULL ))) break;
+    /* HV_NO_RESOURCES sous le plafond compte : des vCPU vivants pour HVF ne sont pas comptes ici (fuite : destroy
+     * refuse, fil sorti sans destructeur). Le plafond effectif descend au compte actuel et le fil attend une place
+     * comme sous pression, au lieu d'arreter le processus. Tout autre refus, ou un plafond devenu trop bas, reste fatal. */
+    pthread_mutex_lock( &ilot_mutex );
+    for (int i = 0; i < nb_vcpus; i++)
+        if (!fils[i]) { vcpus[i] = vcpus[nb_vcpus - 1]; fils[i] = fils[nb_vcpus - 1]; nb_vcpus--; break; }   /* place rendue */
+    if (rc != HV_NO_RESOURCES || nb_vcpus < 8)
+    {
+        int n = nb_vcpus; uint32_t m = max_vcpus;
+        pthread_mutex_unlock( &ilot_mutex );
+        fatal( "hv_vcpu_create", rc, n, m );
+    }
+    if ((uint32_t)nb_vcpus < max_vcpus)
+    {
+        fprintf( stderr, "[CIDRE_ILOT] hv_vcpu_create : plus de place dans HVF (0x%x) a %d vCPU comptes sur %u : plafond effectif abaisse a %d "
+                 "(fuites constatees %llu, destroy refuses %llu)\n", rc, nb_vcpus, max_vcpus, nb_vcpus,
+                 (unsigned long long)c_fuites_vcpu, (unsigned long long)c_destroy_refuses );
+        max_vcpus = nb_vcpus;
+        c_plafond_abaisse++;
+    }
+    pthread_cond_broadcast( &place_cond );
+    pthread_mutex_unlock( &ilot_mutex );
+    }
+    pthread_mutex_lock( &ilot_mutex );
+    for (int i = 0; i < nb_vcpus; i++) if (!fils[i]) { vcpus[i] = fil.v; fils[i] = fil.hote; break; }   /* la place reservee */
+    fil.hote->v = fil.v; fil.hote->vivant = 1;
+    c_vcpus_crees++;
+    pthread_mutex_unlock( &ilot_mutex );
+    fil.t_entree = mach_absolute_time();
+    hv_vcpu_set_sys_reg( fil.v, HV_SYS_REG_MAIR_EL1, 0xff );
+    /* T0SZ 16 (48 bits, depart au niveau 0), granule 4 Kio, WB WA, partage interne, TTBR1 coupe, IPS 40 bits */
+    hv_vcpu_set_sys_reg( fil.v, HV_SYS_REG_TCR_EL1, 16 | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23) | (2ull << 32) );
+    hv_vcpu_set_sys_reg( fil.v, HV_SYS_REG_TTBR0_EL1, ipa_de( (uint64_t)table( ZONE_L0 ) ) );
+    hv_vcpu_set_sys_reg( fil.v, HV_SYS_REG_SCTLR_EL1, 0x30d00800 | 1 | 4 | 0x1000 );
+    hv_vcpu_set_sys_reg( fil.v, HV_SYS_REG_CPACR_EL1, 3u << 20 );
+    hv_vcpu_set_sys_reg( fil.v, HV_SYS_REG_VBAR_EL1, (uint64_t)zone + ZONE_VECTEURS );
+    {   /* EnTSO (bit 1) ajoute a la valeur par defaut du vCPU, sans effacer ses autres bits (propres a Apple) ;
+         * CIDRE_ILOT_ACTLR=ecraser rend l'ancien reglage (ACTLR = 2 ou 0) pour comparer */
+        static int vu; uint64_t a0 = 0;
+        const char *e = getenv( "CIDRE_ILOT_ACTLR" );
+        hv_vcpu_get_sys_reg( fil.v, HV_SYS_REG_ACTLR_EL1, &a0 );
+        uint64_t a = (e && !strcmp( e, "ecraser" )) ? (ilot_tso ? 2 : 0) : ilot_tso ? (a0 | 2) : (a0 & ~2ull);
+        hv_vcpu_set_sys_reg( fil.v, HV_SYS_REG_ACTLR_EL1, a );
+        if (ilot_diag && !__atomic_exchange_n( &vu, 1, __ATOMIC_RELAXED ))
+            fprintf( stderr, "[CIDRE_ILOT] ACTLR_EL1 par defaut 0x%llx, pose 0x%llx\n", (unsigned long long)a0, (unsigned long long)a );
+    }
+    /* TPIDRRO_EL0 de l'hote pointe les emplacements TSD de pthread, dans la pile du fil hote (jamais projetee) ; le
+     * code PE y lit son TEB (TSD[cle_teb], signal_arm64.c). L'invite recoit un miroir prive dans la zone, ou seul
+     * cet emplacement est rempli. */
+    {
+        extern pthread_key_t cle_teb_globale;
+        uint64_t *m = fil.hote->miroir;
+        if ((uint64_t)cle_teb_globale * 8 >= MIROIR_TAILLE) fatal( "cle TEB hors du miroir TSD", cle_teb_globale, 0, 0 );
+        if (!m)
+        {   /* miroir du fil : recycle d'un fil fini, sinon pris dans la zone ; garde quand le vCPU est rendu */
+            pthread_mutex_lock( &ilot_mutex );
+            if (nb_miroirs_libres) m = miroirs_libres[--nb_miroirs_libres];
+            else if (zone_miroirs_pris + MIROIR_TAILLE <= ZONE_MIROIRS_FIN) { m = (uint64_t *)(zone + zone_miroirs_pris); zone_miroirs_pris += MIROIR_TAILLE; }
+            pthread_mutex_unlock( &ilot_mutex );
+            if (!m) fatal( "miroirs TSD epuises", 0, 0, 0 );
+            memset( m, 0, MIROIR_TAILLE );
+            fil.hote->miroir = m;
+        }
+        m[cle_teb_globale] = (uint64_t)pthread_getspecific( cle_teb_globale );
+        if (!m[cle_teb_globale]) fatal( "TEB absent du TSD du fil", cle_teb_globale, 0, 0 );
+        /* horloge privee pour RtlQueryPerformanceCounter (ntdll PE) : nulle sur l'hote, donc appel systeme ailleurs */
+        if (getenv( "CIDRE_ILOT_HORLOGE" ) == NULL || atoi( getenv( "CIDRE_ILOT_HORLOGE" ) ))
+            *(volatile uint64_t *)(m[cle_teb_globale] + TEB_HORLOGE) = (uint64_t)horloge();
+        hv_vcpu_set_sys_reg( fil.v, HV_SYS_REG_TPIDRRO_EL0, (uint64_t)m );
+    }
+    __asm__ volatile( "mrs %0, tpidr_el0" : "=r"(v) ); hv_vcpu_set_sys_reg( fil.v, HV_SYS_REG_TPIDR_EL0, v );
+    hv_vcpu_set_vtimer_offset( fil.v, 0 );   /* CNTVCT de l'invite = celui de l'hote */
+    fil.pret = 1;
+}
