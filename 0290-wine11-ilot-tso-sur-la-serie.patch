+/* releve periodique (fil rapport, toutes les 10 s) : la manche tue le processus, l'atexit ne vient jamais ; chaque
+ * releve couvre l'intervalle depuis le precedent (compteurs remis a zero) ; le decalage dans l'image se lit par atos */
+static void releve_table( const char *quoi, void *t, int nb, int top )
+{
+    struct { uint64_t pc, n; } *c = t;
+    uint64_t tot = 0;
+    for (int i = 0; i < nb; i++) tot += c[i].n;
+    for (int r = 0; r < top; r++)
+    {
+        int m = -1;
+        for (int i = 0; i < nb; i++) if (c[i].n && (m < 0 || c[i].n > c[m].n)) m = i;
+        if (m < 0) break;
+        Dl_info di; const char *sym = "?", *img = "?"; uint64_t off = 0;
+        if (dladdr( (void *)c[m].pc, &di ))
+        {
+            if (di.dli_sname) sym = di.dli_sname;
+            if (di.dli_fname) img = strrchr( di.dli_fname, '/' ) ? strrchr( di.dli_fname, '/' ) + 1 : di.dli_fname;
+            off = c[m].pc - (uint64_t)di.dli_fbase;
+        }
+        fprintf( stderr, "[CIDRE_ILOT] releve %s : %10llu (%5.1f %%) vers %s (%s+0x%llx) 0x%llx\n", quoi, (unsigned long long)c[m].n,
+                 100.0 * c[m].n / (tot ? tot : 1), sym, img, (unsigned long long)off, (unsigned long long)c[m].pc );
+        c[m].n = 0;
+    }
+    for (int i = 0; i < nb; i++) { c[i].n = 0; c[i].pc = 0; }   /* table videe : les nouvelles adresses y trouvent place */
+}
