+/* fil et processus Windows d'un handle (requetes au serveur, apres l'appel : jamais de code de l'invite) */
+extern unsigned int NtQueryInformationThread( void *handle, unsigned int classe, void *info, unsigned int taille, unsigned int *rendu );
+extern unsigned int NtQueryInformationProcess( void *handle, unsigned int classe, void *info, unsigned int taille, unsigned int *rendu );
+static const char *decrire_fil_h( uint64_t h, char *b, size_t n )
+{
+    uint64_t tbi[6] = { 0 };   /* THREAD_BASIC_INFORMATION : ClientId.UniqueProcess +16, UniqueThread +24 */
+    if (h == ~1ull || !h) { snprintf( b, n, "soi" ); return b; }
+    if (NtQueryInformationThread( (void *)h, 0, tbi, sizeof(tbi), NULL )) snprintf( b, n, "h 0x%llx (?)", (unsigned long long)h );
+    else snprintf( b, n, "h 0x%llx = fil %04x proc %04x", (unsigned long long)h, (unsigned int)tbi[3], (unsigned int)tbi[2] );
+    return b;
+}
+static const char *decrire_proc_h( uint64_t h, char *b, size_t n )
+{
+    uint64_t pbi[6] = { 0 };   /* PROCESS_BASIC_INFORMATION : UniqueProcessId +32 */
+    if (h == ~0ull || !h) { snprintf( b, n, "soi" ); return b; }
+    if (NtQueryInformationProcess( (void *)h, 0, pbi, sizeof(pbi), NULL )) snprintf( b, n, "h 0x%llx (?)", (unsigned long long)h );
+    else snprintf( b, n, "h 0x%llx = proc %04x", (unsigned long long)h, (unsigned int)pbi[4] );
+    return b;
+}
