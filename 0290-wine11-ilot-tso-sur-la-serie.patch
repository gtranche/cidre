+    *raison = 0;
+    if (!view || !view->section_ino || !size) { *raison = 1; return 0; }
+    debut = view->section_off + (base - (char *)view->base);
+    fin = debut + size;
+    for (bloc = debut / host_page_size; bloc * host_page_size < fin; bloc++)
+    {
+        struct arme *a = arme_trouver( view->section_ino, bloc );
+        char *code = bloc_dans_vue( view, bloc );
+        ULONGLONG h = 0;
+        if (a && !a->desarme_ms)
