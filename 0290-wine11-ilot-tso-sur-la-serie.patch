+/* histogramme des cibles d'appels hote (64 entrees, adressage ouvert) */
+#define NB_CIBLES 64
+static struct { uint64_t pc, n; } cibles[NB_CIBLES];
+static void compter_cible( uint64_t pc )
+{
+    unsigned int h = (unsigned int)((pc * 0x9E3779B97F4A7C15ull) >> 58);
+    for (unsigned int i = 0; i < NB_CIBLES; i++, h = (h + 1) % NB_CIBLES)
+    {
+        uint64_t c = __atomic_load_n( &cibles[h].pc, __ATOMIC_RELAXED );
+        if (c == pc || (!c && __atomic_compare_exchange_n( &cibles[h].pc, &c, pc, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED )) || c == pc)
+        { __atomic_fetch_add( &cibles[h].n, 1, __ATOMIC_RELAXED ); return; }
+    }
+}
+
+/* retraits de pages d'invite par appelant (adresse de retour dans virtual.c), ponderes par le nombre de pages */
+static struct { uint64_t pc, n; } retraits_de[NB_CIBLES];
+static void compter_retrait( uint64_t ra, uint64_t pages )
+{
+    unsigned int h = (unsigned int)((ra * 0x9E3779B97F4A7C15ull) >> 58);
+    for (unsigned int i = 0; i < NB_CIBLES; i++, h = (h + 1) % NB_CIBLES)
+    {
+        uint64_t c = __atomic_load_n( &retraits_de[h].pc, __ATOMIC_RELAXED );
+        if (c == ra || (!c && __atomic_compare_exchange_n( &retraits_de[h].pc, &c, ra, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED )) || c == ra)
+        { __atomic_fetch_add( &retraits_de[h].n, pages, __ATOMIC_RELAXED ); return; }
+    }
+}
