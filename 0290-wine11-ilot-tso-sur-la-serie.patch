+/* --- demarrage ---------------------------------------------------------------------------------------------------- */
+/* CIDRE_ILOT_UNIQUE=1 : un seul processus de l'ilot par prefixe. Verrou $WINEPREFIX/.cidre-ilot.verrou (pid du
+ * detenteur), pris par O_EXCL ; un verrou dont le pid est mort ou n'est plus un processus wine est repris. Rendu a la
+ * sortie, ou cede a l'enfant quand ce processus se rabat sur start.exe /exec (image principale non chargee, env.c). */
+static char verrou_chemin[1024];
+static int verrou_pris;
+static void verrou_rendre( void )
+{
+    if (verrou_pris) { unlink( verrou_chemin ); verrou_pris = 0; }
+}
+static int verrou_prendre( char *pourquoi, size_t n )
+{
+    const char *pfx = getenv( "WINEPREFIX" ), *home = getenv( "HOME" );
+    if (pfx && *pfx) snprintf( verrou_chemin, sizeof(verrou_chemin), "%s/.cidre-ilot.verrou", pfx );
+    else snprintf( verrou_chemin, sizeof(verrou_chemin), "%s/.wine/.cidre-ilot.verrou", home ? home : "" );
+    for (int essai = 0; essai < 2; essai++)
+    {
+        int fd = open( verrou_chemin, O_WRONLY | O_CREAT | O_EXCL, 0644 );
+        if (fd >= 0)
+        {
+            char b[32]; int l = snprintf( b, sizeof(b), "%d\n", getpid() );
+            if (write( fd, b, l ) != l) { close( fd ); unlink( verrou_chemin ); snprintf( pourquoi, n, "ecriture du verrou" ); return 0; }
+            close( fd ); verrou_pris = 1; atexit( verrou_rendre );
+            return 1;
+        }
+        if (errno != EEXIST) { snprintf( pourquoi, n, "verrou %s : errno %d", verrou_chemin, errno ); return 0; }
+        {
+            char b[32] = "", chemin[PROC_PIDPATHINFO_MAXSIZE] = ""; int pid = 0;
+            fd = open( verrou_chemin, O_RDONLY );
+            if (fd >= 0) { ssize_t r = read( fd, b, sizeof(b) - 1 ); if (r > 0) b[r] = 0; close( fd ); pid = atoi( b ); }
+            if (pid > 0 && pid != getpid() && (kill( pid, 0 ) == 0 || errno == EPERM) &&
+                proc_pidpath( pid, chemin, sizeof(chemin) ) > 0 && strstr( chemin, "wine" ))
+            { snprintf( pourquoi, n, "verrou tenu par pid %d (%s)", pid, verrou_chemin ); return 0; }
+            unlink( verrou_chemin );   /* perime : detenteur mort ou pid recycle */
+        }
+    }
+    snprintf( pourquoi, n, "verrou %s : course perdue", verrou_chemin );
+    return 0;
+}
+static void dire_processus( const char *verdict )
+{
+    extern int main_argc; extern char **main_argv;
+    char l[1536]; int n = snprintf( l, sizeof(l), "[CIDRE_ILOT] processus pid %d ppid %d : %s ; commande", getpid(), getppid(), verdict );
+    for (int i = 1; i < main_argc && n < (int)sizeof(l) - 8; i++) n += snprintf( l + n, sizeof(l) - n, " [%s]", main_argv[i] );
+    fprintf( stderr, "%s\n", l );
+}
+/* env.c : l'image principale n'a pas pu etre chargee, le processus se rabat sur start.exe /exec (qui creera le vrai
+ * processus du jeu) ; il reste dans l'ilot s'il y est deja (la memoire Windows est deja projetee sans execution), mais
+ * cede le verrou a son enfant */
+void ilot_repli_start( unsigned int status )
+{
+    char v[160];
+    const char *e = getenv( "CIDRE_ILOT" );
+    if (!e || *e != '1') return;
+    snprintf( v, sizeof(v), "image principale non chargee (statut 0x%x) : repli sur start.exe /exec%s%s", status,
+              ilot_voulu ? ", reste dans l'ilot" : "", verrou_pris ? ", verrou cede a l'enfant" : "" );
+    dire_processus( v );
+    verrou_rendre();
+}
+
+/* au debut de virtual_init, avant toute image PE : choisit le processus et cree la VM */
+void ilot_choisir( void )
+{
+    const char *e = getenv( "CIDRE_ILOT" ), *x = getenv( "CIDRE_ILOT_EXE" );
+    extern int main_argc; extern char **main_argv;
+    int unique = getenv( "CIDRE_ILOT_UNIQUE" ) && atoi( getenv( "CIDRE_ILOT_UNIQUE" ) );
+    if (!e || *e != '1') return;
+    if (getenv( "CIDRE_ILOT_DIAG" ))
+    {
+        fprintf( stderr, "[CIDRE_ILOT] pid %d init, %d arguments :", getpid(), main_argc );
+        for (int i = 0; i < main_argc; i++) fprintf( stderr, " [%s]", main_argv[i] );
+        fprintf( stderr, "\n" );
+    }
+    if (x && *x)
+    {   /* seulement le processus dont la ligne de commande nomme cet exe (pas wineboot, services...) ; UNIQUE : nom
+         * d'image exact (dernier composant d'un argument, casse ignoree), plus de sous-chaine */
+        int i, vu = 0;
+        for (i = unique ? 1 : 0; i < main_argc && !vu; i++)
+        {
+            if (!unique) { if (strstr( main_argv[i], x )) vu = 1; continue; }
+            const char *a = main_argv[i], *b = a;
+            for (const char *q = a; *q; q++) if (*q == '/' || *q == '\\') b = q + 1;
+            if (!strcasecmp( strpbrk( x, "/\\" ) ? a : b, x )) vu = 1;
+        }
+        if (!vu) { if (unique) dire_processus( "refus (image non visee)" ); return; }
+    }
+    if (unique)
+    {
+        char pourquoi[1200];
+        if (!verrou_prendre( pourquoi, sizeof(pourquoi) ))
+        {
+            char v[1300]; snprintf( v, sizeof(v), "refus (%s)", pourquoi );
+            dire_processus( v );
+            return;
+        }
+    }
+    if (getenv( "CIDRE_ILOT_TSO" )) ilot_tso = atoi( getenv( "CIDRE_ILOT_TSO" ) );
+    pthread_key_create( &cle_vcpu, detruire_fil );
+    ilot_diag = getenv( "CIDRE_ILOT_DIAG" ) != NULL;
+    copie_complete = getenv( "CIDRE_ILOT_COPIE" ) && !strcmp( getenv( "CIDRE_ILOT_COPIE" ), "complete" );
+    hv_vm_config_t c = hv_vm_config_create();
+    if (hv_vm_config_set_ipa_size( c, 40 ) || hv_vm_create( c ))
+    {
+        fprintf( stderr, "[CIDRE_ILOT] hyperviseur indisponible (entitlement com.apple.security.hypervisor ?) : ilot coupe\n" );
+        if (unique) { dire_processus( "refus (hyperviseur indisponible)" ); verrou_rendre(); }
+        return;
+    }
+    ilot_voulu = 1;
+    if (unique) dire_processus( "entree dans l'ilot" );
+    {   /* plafond de HVF ; CIDRE_ILOT_MAX_VCPU l'abaisse (temoins de pression) */
+        uint32_t m = 0;
+        if (!hv_vm_get_max_vcpu_count( &m ) && m) max_vcpus = m > 256 ? 256 : m;
+        if (getenv( "CIDRE_ILOT_MAX_VCPU" ) && atoi( getenv( "CIDRE_ILOT_MAX_VCPU" ) ) > 0 &&
+            (uint32_t)atoi( getenv( "CIDRE_ILOT_MAX_VCPU" ) ) < max_vcpus) max_vcpus = atoi( getenv( "CIDRE_ILOT_MAX_VCPU" ) );
+    }
+}
