+    if (prendre) server_enter_uninterrupted_section( &virtual_mutex, &ilot_sigset );
+    else server_leave_uninterrupted_section( &virtual_mutex, &ilot_sigset );
+}
+
+C_ASSERT( offsetof( TEB, Instrumentation[10] ) == 0x1708 );  /* TEB_HORLOGE de ilot.c */
+
+int ilot_vue_base( const void *addr, UINT64 *base, UINT64 *taille, int *image )
+{
+    struct file_view *view;
+    sigset_t sigset;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    view = find_view( addr, 0 );
+    if (view) { *base = (UINT_PTR)view->base; *taille = view->size; *image = (view->protect & SEC_IMAGE) != 0; }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return view != NULL;
+}
+
+/* Cidre, ilot (pile a la sortie du processus) : addr est-elle dans une page executable d'une vue ? base de la vue,
+ * image ou non. Prend virtual_mutex. */
+int ilot_pc_executable( const void *addr, UINT64 *base, int *image )
+{
+    struct file_view *view;
+    sigset_t sigset;
+    int ok = 0;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    if ((view = find_view( addr, 0 )) && (get_page_vprot( addr ) & VPROT_EXEC))
+    {
+        *base = (UINT_PTR)view->base; *image = (view->protect & SEC_IMAGE) != 0; ok = 1;
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return ok;
+}
+
+int ilot_vue_windows( const void *addr )
+{
+    struct file_view *view = find_view( addr, 0 );
+    return view ? (view->protect & VPROT_SYSTEM ? 2 : 1) : 0;
+}
+
+/* Cidre, ilot TSO (diagnostic d'un refus) : protection de la vue (SEC_*, VPROT_*) et de la page ; virtual_mutex tenu */
+int ilot_vue_protect( const void *addr, unsigned int *vue, unsigned int *page )
+{
+    struct file_view *view = find_view( addr, 0 );
+    if (!view) return 0;
+    *vue = view->protect;
+    *page = get_page_vprot( addr );
+    return 1;
+}
+
+int ilot_exec_windows( const void *page )
+{
+    size_t i;
+    for (i = 0; i < host_page_size; i += page_size)
+    {
+        BYTE v = get_page_vprot( (const char *)page + i );
+        if ((v & VPROT_COMMITTED) && !(v & VPROT_GUARD) && (v & VPROT_EXEC)) return 1;
+    }
+    return 0;
+}
+
+/* Cidre, ilot TSO, etape 5b : droits de chacune des quatre pages de 4 Kio d'une page d'hote, pour le premier etage du
+ * vCPU (bit 0 lecture, 1 ecriture, 2 execution ; 0 aucun acces : non engagee, garde, NOACCESS), calcules comme les
+ * droits unix d'une page seule (write-watch : sans ecriture). Rend -1 si une sous-page n'est pas dans une vue Windows
+ * ordinaire (hors vue, vue systeme, MAP_JIT) : le premier etage laisse alors le deuxieme decider. virtual_mutex tenu. */
+int ilot_droits_sous_pages( const void *page, int droits[4] )
+{
+    size_t i;
+    if (host_page_size != 4 * page_size) return -1;
+    for (i = 0; i < 4; i++)
+    {
+        const char *p = (const char *)page + i * page_size;
+        struct file_view *view = find_view( p, 0 );
+        int prot;
+        if (!view || (view->protect & (VPROT_SYSTEM | VPROT_JIT))) return -1;
+        prot = get_unix_prot( get_page_vprot( p ) );
+        droits[i] = ((prot & PROT_READ) ? 1 : 0) | ((prot & PROT_WRITE) ? 2 : 0) | ((prot & PROT_EXEC) ? 4 : 0);
+    }
+    return 0;
+}
