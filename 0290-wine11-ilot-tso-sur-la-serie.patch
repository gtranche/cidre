+static void poser_regs( hv_vcpu_t v, const struct ilot_regs *r )
+{
+    for (int i = 0; i < 31; i++) hv_vcpu_set_reg( v, HV_REG_X0 + i, r->x[i] );
+    hv_vcpu_set_reg( v, HV_REG_PC, r->pc );
+    hv_vcpu_set_reg( v, HV_REG_CPSR, 0x3c5 | (r->nzcv & 0xf0000000) );
+    hv_vcpu_set_reg( v, HV_REG_FPCR, r->fpcr );
+    hv_vcpu_set_reg( v, HV_REG_FPSR, r->fpsr );
+    hv_vcpu_set_sys_reg( v, HV_SYS_REG_SP_EL1, r->sp );
+    for (int i = 0; i < 32; i++) { hv_simd_fp_uchar16_t q; memcpy( &q, &r->v[i], 16 ); hv_vcpu_set_simd_fp_reg( v, HV_SIMD_FP_REG_Q0 + i, q ); }
+}
