+/* (3) une seconde d'echantillons des pc (sorties forcees toutes les 10 ms), puis les fils qui tournaient */
+static void echantillonner_blocage( void )
+{
+    int nb = __atomic_load_n( &nb_diag_fils, __ATOMIC_RELAXED ), dits = 0; char c[160];
+    if (nb > NB_DIAG_FILS) nb = NB_DIAG_FILS;
+    if (!chrono_fils) for (int i = 0; i < nb; i++) memset( diag_fils[i].pcs, 0, sizeof(diag_fils[i].pcs) );
+    __atomic_store_n( &blocage_ech, 1, __ATOMIC_RELEASE );
+    for (int k = 0; k < 100; k++)
+    {
+        usleep( 10000 );
+        pthread_mutex_lock( &ilot_mutex );
+        int n = nb_vcpus;
+        __atomic_store_n( &t_ech_demande, mach_absolute_time(), __ATOMIC_RELEASE );
+        if (n) hv_vcpus_exit( vcpus, n );
+        pthread_mutex_unlock( &ilot_mutex );
+    }
+    usleep( 20000 );
+    __atomic_store_n( &blocage_ech, 0, __ATOMIC_RELEASE );
+    for (int i = 0; i < nb; i++)
+    {
+        struct diag_fil *d = &diag_fils[i]; uint32_t tot = 0; char l[600]; int n;
+        for (int j = 0; j < 16; j++) tot += d->pcs[j].n;
+        if (!tot) continue;
+        n = snprintf( l, sizeof(l), "[CIDRE_ILOT] blocage :   dans le vCPU : fil %04x x%u :", d->tid, tot );
+        for (int r = 0; r < 3; r++)
+        {
+            int m = -1;
+            for (int j = 0; j < 16; j++) if (d->pcs[j].n && (m < 0 || d->pcs[j].n > d->pcs[m].n)) m = j;
+            if (m < 0) break;
+            n += snprintf( l + n, sizeof(l) - n, " %s x%u ;", decrire_pc( d->pcs[m].pc, c, sizeof(c) ), d->pcs[m].n );
+            d->pcs[m].n = 0;
+        }
+        fprintf( stderr, "%s\n", l ); dits++;
+        if (!chrono_fils) memset( d->pcs, 0, sizeof(d->pcs) );
+    }
+    fprintf( stderr, "[CIDRE_ILOT] blocage : %d fil(s) vus dans leur vCPU sur 1 s d'echantillons (pc a 64 octets pres)\n", dits );
+    panorama_fils();
+}
