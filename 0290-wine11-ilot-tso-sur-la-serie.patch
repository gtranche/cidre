+/* --- instabilite de D2R (24/10) : fils bloques (CIDRE_ILOT_BLOQUES=<s>) et appels entre processus (CIDRE_ILOT_XPROC=1).
+ * Diagnostic seul : lectures par mach_vm_read_overwrite (jamais de deference d'un pointeur de l'invite), aucune
+ * projection, aucune ecriture dans l'invite ; la garde n'est pas concernee. */
+static uint32_t tid_courant( void )
+{
+    extern pthread_key_t cle_teb_globale;
+    uint64_t teb = (uint64_t)pthread_getspecific( cle_teb_globale ), tid = 0; mach_vm_size_t lu = 0;
+    if (teb) mach_vm_read_overwrite( mach_task_self(), teb + 0x48, 4, (mach_vm_address_t)&tid, &lu );
+    return (uint32_t)tid;
+}
+static int lire_invite( uint64_t a, void *b, size_t n )
+{
+    mach_vm_size_t lu = 0;
+    if (!a) return 0;
+    return !mach_vm_read_overwrite( mach_task_self(), a, n, (mach_vm_address_t)b, &lu ) && lu == n;
+}
+/* parade aux reveils perdus de RtlWaitOnAddress (sync.c, wait_on_address_sleep) : duree de tranche (0 hors de l'ilot
+ * ou si CIDRE_ILOT_WAO_TRANCHE=0), et, a chaque tranche ecoulee, l'adresse attendue a-t-elle change ? (lecture par
+ * mach_vm_read, jamais de deference ; taille inconnue ou illisible : 0, on se rendort) */
+int ilot_wao_tranche_ms( void )
+{
+    if (!ilot_voulu) return 0;
+    if (wao_tranche < 0)
+    {
+        const char *e = getenv( "CIDRE_ILOT_WAO_TRANCHE" );
+        wao_tranche = e ? atoi( e ) : 8;
+        if (wao_tranche < 0) wao_tranche = 0;
+    }
+    return wao_tranche;
+}
+int ilot_wao_change( void )
+{
+    uint64_t a = 0, c = 0, t = fil.wao_taille;
+    __atomic_fetch_add( &c_wao_tranches, 1, __ATOMIC_RELAXED );
+    if (t != 1 && t != 2 && t != 4 && t != 8) return 0;
+    if (!lire_invite( fil.wao_addr, &a, t ) || !lire_invite( fil.wao_cmp, &c, t )) return 0;
+    if (a == c) return 0;
+    __atomic_fetch_add( &c_wao_rattrapes, 1, __ATOMIC_RELAXED );
+    return 1;
+}
+static const char *decrire_pc( uint64_t pc, char *b, size_t n )
+{
+    extern int ilot_vue_base( const void *addr, uint64_t *base, uint64_t *taille, int *image );
+    uint64_t base = 0, taille = 0; int image = 0; Dl_info di;
+    if (pc > 0x10000 && ilot_vue_base( (void *)pc, &base, &taille, &image ))
+        snprintf( b, n, "%s 0x%llx+0x%llx", image ? "image" : "vue", (unsigned long long)base, (unsigned long long)(pc - base) );
+    else if (pc > 0x10000 && dladdr( (void *)pc, &di ) && di.dli_fname)
+        snprintf( b, n, "%s+0x%llx", strrchr( di.dli_fname, '/' ) ? strrchr( di.dli_fname, '/' ) + 1 : di.dli_fname,
+                  (unsigned long long)(pc - (uint64_t)di.dli_fbase) );
+    else snprintf( b, n, "0x%llx", (unsigned long long)pc );
+    return b;
+}
