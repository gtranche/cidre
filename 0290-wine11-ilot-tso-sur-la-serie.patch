+/* [ILOT_XPROC] : creation et cycle de vie des fils et des processus, et operations sur un autre processus ou un autre
+ * fil, journalises au retour avec leur statut ; 300 lignes par appel, 5000 en tout */
+static int xproc_voulu( uint32_t n, const uint64_t *x )
+{
+    switch (n)
+    {
+    case 0x8b: case 0x4e: case 0x8f: case 0x52: case 0x65: case 0xfb: case 0xe0: case 0xfa: case 0x2c: case 0x26: case 0xbe: return 1;
+    case 0x9d: case 0xe4: case 0x45: case 0xd3: case 0xd4: return x[0] != ~1ull;           /* autre fil que soi */
+    case 0x53: return x[0] && x[0] != ~1ull;
+    case 0x3a: case 0x3f: case 0x18: case 0x6b: case 0x50: case 0x1e: case 0x2a: case 0x104: return x[0] != ~0ull;   /* autre processus */
+    case 0x28: case 0xb0: return x[1] != ~0ull;
+    }
+    return 0;
+}
