+/* une vue de section projetee ou reprotegee : ses blocs armes qui y sont inscriptibles repassent en suivi */
+static void jumelles_reprendre( struct file_view *view, char *base, SIZE_T size )
+{
+    ULONGLONG debut, fin, bloc;
