+/* toutes les secondes : chaque fil dans un appel hote depuis plus du seuil (puis toutes les 30 s s'il y reste) */
+extern int cidre_drapeau_wao( unsigned int tid );   /* sync.c : drapeau de reveil de wait_on_address du fil, -1 inconnu */
+static void *bloques_fil( void *p )
+{
+    int analyses = 0, analyser = 0;
+    for (;;)
+    {
+        sleep( 1 );
+        uint64_t now = mach_absolute_time(), trente;
+        int n = __atomic_load_n( &nb_diag_fils, __ATOMIC_RELAXED ), nb = 0, entete = 0;
+        struct timeval tv; struct tm tm; gettimeofday( &tv, NULL ); localtime_r( &tv.tv_sec, &tm );
+        static mach_timebase_info_data_t tb; if (!tb.denom) mach_timebase_info( &tb );
+        trente = (uint64_t)(30e9 * tb.denom / tb.numer);
+        if (n > NB_DIAG_FILS) n = NB_DIAG_FILS;
+        for (int i = 0; i < n; i++)
+        {
+            struct diag_fil *d = &diag_fils[i];
+            uint64_t t0 = __atomic_load_n( &d->blq_t0, __ATOMIC_ACQUIRE );
+            if (!t0 || d->mort || now < t0 || now - t0 < bloques_seuil) continue;
+            nb++;
+            if (d->blq_dit && now - d->blq_dit < trente) continue;
+            if (!entete)
+            {
+                entete = 1;
+                fprintf( stderr, "[CIDRE_ILOT] bloques %02d:%02d:%02d.%03d abs %.3f : fils dans un appel hote depuis plus de %.0f s\n",
+                         tm.tm_hour, tm.tm_min, tm.tm_sec, (int)(tv.tv_usec / 1000), ms( now ), ms( bloques_seuil ) / 1000 );
+            }
+            int rappel = d->blq_dit != 0;
+            d->blq_dit = now;
+            char quoi[96], delai[64] = "", objets[160] = "", wa[400] = "", c[160];
+            uint32_t num = d->blq_num;
+            int attente = num == 0x4 || num == 0x5b || num == 0x34 || num == 0xd9 || num == 0x105 ||
+                          (num == CHRONO_UNIX && d->blq_code == 8 && est_ntdll( d->blq_handle ));
+            if (num == CHRONO_UNIX)
+            {
+                Dl_info di; const char *img = "?";
+                if (dladdr( (void *)d->blq_handle, &di ) && di.dli_fname) img = strrchr( di.dli_fname, '/' ) ? strrchr( di.dli_fname, '/' ) + 1 : di.dli_fname;
+                snprintf( quoi, sizeof(quoi), "unix %s:%llu%s", img, (unsigned long long)d->blq_code,
+                          attente ? " (wait_on_address_sleep)" : (est_ntdll( d->blq_handle ) && d->blq_code == 9) ? " (wait_on_address_wake)" : "" );
+            }
+            else if (nom_appel( num )) snprintf( quoi, sizeof(quoi), "%s (0x%x)", nom_appel( num ), num );
+            else snprintf( quoi, sizeof(quoi), "appel 0x%x", num );
+            if (!rappel && num == CHRONO_UNIX && d->blq_code == 8 && d->wa_params && est_ntdll( d->blq_handle ))
+                trouver_entree_wao( d, d->wa_params );   /* pile figee : le fil dort */
+            if (attente)
+            {
+                int64_t q = 0;
+                if (!d->blq_delai_ptr) snprintf( delai, sizeof(delai), ", delai infini" );
+                else if (!lire_invite( d->blq_delai_ptr, &q, 8 )) snprintf( delai, sizeof(delai), ", delai illisible" );
+                else if (q == INT64_MIN) snprintf( delai, sizeof(delai), ", delai infini" );
+                else if (q < 0) snprintf( delai, sizeof(delai), ", delai relatif %.1f ms", -q / 1e4 );
+                else snprintf( delai, sizeof(delai), ", delai absolu %lld", (long long)q );
+            }
+            for (uint32_t k = 0, l = 0; k < d->blq_nb && k < 4; k++)
+            {
+                uint32_t s = signaleur( d->blq_obj[k], t0 );
+                char sg[40]; if (s) snprintf( sg, sizeof(sg), "signale par fil %04x", s ); else snprintf( sg, sizeof(sg), "aucun signal note" );
+                l += snprintf( objets + l, sizeof(objets) - l, "%s0x%llx (%s)", k ? ", " : " ; objets ", (unsigned long long)d->blq_obj[k], sg );
+                if (l >= sizeof(objets)) break;
+            }
+            if (num == CHRONO_UNIX && attente)
+            {
+                if (!d->wa_entree) snprintf( wa, sizeof(wa), " ; wait_on_address : entree introuvable sur la pile" );
+                else
+                {
+                    uint64_t ea = ~0ull, cur = 0; int dr = cidre_drapeau_wao( d->tid );
+                    int lu_e = lire_invite( d->wa_entree + 16, &ea, 8 );
+                    if (d->wa_taille) { if (!lire_invite( d->wa_addr, &cur, d->wa_taille )) cur = ~0ull; }
+                    else if (!lire_invite( d->wa_addr, &cur, 8 )) { uint32_t v4 = 0; lire_invite( d->wa_addr, &v4, 4 ); cur = v4; }
+                    uint64_t masque = d->wa_taille && d->wa_taille < 8 ? (1ull << (8 * d->wa_taille)) - 1 : ~0ull;
+                    const char *verdict =
+                        !lu_e ? "entree illisible" :
+                        !ea ? (dr == 1 ? "REVEIL PERDU cote hote : entree retiree et drapeau pose, le fil dort encore"
+                                       : "entree retiree (reveil envoye) mais drapeau a 0 : alerte prise ailleurs ou envoyee a un autre fil") :
+                        ea != d->wa_addr ? "entree reutilisee (pile changee)" :
+                        ((cur ^ d->wa_val) & masque) ? "valeur changee, entree toujours en file (perte, ou reveil simple donne a un autre dormeur : voir la file)" :
+                        "valeur inchangee, entree en file : attente legitime (personne n'a ecrit ni reveille)";
+                    snprintf( wa, sizeof(wa), " ; wait_on_address adresse 0x%llx taille %llu attendu (*cmp) 0x%llx courant 0x%llx, entree 0x%llx (addr 0x%llx), drapeau %d : %s",
+                              (unsigned long long)d->wa_addr, (unsigned long long)d->wa_taille, (unsigned long long)d->wa_val, (unsigned long long)cur,
+                              (unsigned long long)d->wa_entree, (unsigned long long)ea, dr, verdict );
+                }
+            }
+            fprintf( stderr, "[CIDRE_ILOT] bloque%s fil %04x depuis %.1f s : %s%s%s ; appelant %s%s\n", rappel ? " (toujours)" : "", d->tid,
+                     ms( now - t0 ) / 1000, quoi, delai, objets, decrire_pc( d->blq_lr, c, sizeof(c) ), wa );
+            if (!rappel && num == CHRONO_UNIX && attente && d->wa_entree && !d->blq_delai_ptr && analyses < 4)
+            {   /* attente infinie sur une adresse : objet, coherence de la page, fils (4 analyses par processus) */
+                analyses++; analyser = 1;
+                analyser_blocage( d );
+            }
+        }
+        if (entete) fprintf( stderr, "[CIDRE_ILOT] bloques : %d fil(s) au-dela du seuil\n", nb );
+        if (analyser) { analyser = 0; echantillonner_blocage(); }
+    }
+    return NULL;
+}
