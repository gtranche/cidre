+ * execute (h64smc_arme A2 : 3 a 4 cycles sur 200 perimes plus d'une seconde). Pendant le delai, l'op 6 rend 0 :
+ * FEX valide ce code, ce qui reste exact. */
+#define DELAI_REARMEMENT_MS 50
+static ULONGLONG maintenant_ms(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (ULONGLONG)ts.tv_sec * 1000 + ts.tv_nsec / 1000000 + 1;   /* jamais 0 */
+}
+static unsigned int armes_nb;
+
+static unsigned int arme_hache( ULONGLONG ino, ULONGLONG bloc )
+{
+    return (unsigned int)((ino * 0x9e3779b97f4a7c15ull) ^ (bloc * 0xc2b2ae3d27d4eb4full)) & (ARMES_NB - 1);
+}
+static struct arme *arme_trouver( ULONGLONG ino, ULONGLONG bloc )
+{
+    unsigned int i = arme_hache( ino, bloc ), n;
+    for (n = 0; n < ARMES_NB && armes[i].ino; n++, i = (i + 1) & (ARMES_NB - 1))
+        if (armes[i].ino == ino && armes[i].bloc == bloc) return &armes[i];
+    return NULL;
+}
+static BOOL arme_ajouter( ULONGLONG ino, ULONGLONG bloc )
+{
+    unsigned int i = arme_hache( ino, bloc );
+    if (arme_trouver( ino, bloc )) return TRUE;
+    if (armes_nb >= ARMES_NB / 2) return FALSE;
+    while (armes[i].ino && armes[i].ino != ARME_TOMBE) i = (i + 1) & (ARMES_NB - 1);
+    armes[i].ino = ino; armes[i].bloc = bloc; armes[i].desarme_ms = 0; armes[i].empreinte = 0; armes[i].rx = 0;
+    armes_nb++;
+    return TRUE;
+}
+
+/* la page d'hote d'une vue qui porte le bloc (decalage bloc * host_page_size), NULL si elle ne le porte pas */
+static char *bloc_dans_vue( struct file_view *view, ULONGLONG bloc )
+{
+    ULONGLONG off = bloc * host_page_size;
+    if (off < view->section_off || off - view->section_off >= view->size) return NULL;
+    if ((view->section_off & host_page_mask) || ((UINT_PTR)view->base & host_page_mask)) return NULL;
+    return (char *)view->base + (off - view->section_off);
+}
+
+static BOOL page_inscriptible_non_executable( char *p, BOOL *executable )
+{
+    size_t i;
+    BOOL ecrit = FALSE;
+    *executable = FALSE;
+    for (i = 0; i < host_page_size; i += page_size)
+    {
+        BYTE v = get_page_vprot( p + i );
+        if (v & VPROT_EXEC) *executable = TRUE;
+        if (v & (VPROT_WRITE | VPROT_WRITECOPY)) ecrit = TRUE;
+    }
+    return ecrit && !*executable;
+}
+
+/* met en suivi d'ecriture le bloc dans une vue s'il y est inscriptible et non executable. Rend 0, ou la raison
+ * du refus (3 : vue JIT ou systeme, 4 : page d'hote mixte). virtual_mutex tenu. */
+static UINT suivre_bloc( struct file_view *view, ULONGLONG bloc )
+{
+    char *p = bloc_dans_vue( view, bloc );
+    BOOL executable;
+
+    if (!p || !page_inscriptible_non_executable( p, &executable )) return 0;
+    if (view->protect & (VPROT_JIT | VPROT_SYSTEM)) return 3;
+    if (page_hote_mixte( p )) return 4;
+    view->protect |= VPROT_JUMELLE;
+    if (!(get_page_vprot( p ) & VPROT_WRITEWATCH))
+    {
+        set_page_vprot_bits( p, host_page_size, VPROT_WRITEWATCH, 0 );
+        mprotect_range( p, host_page_size, 0, 0 );
+    }
+    return 0;
+}
+
+/* le debut du bloc dans une vue de la section qui l execute (nb : combien de vues), 0 si aucune */
+static ULONG_PTR bloc_executable( ULONGLONG ino, ULONGLONG bloc, int *nb )
+{
+    struct file_view *view;
+    ULONG_PTR trouve = 0;
+    *nb = 0;
+    LIST_FOR_EACH_ENTRY( view, &vues_section, struct file_view, entree_section )
+    {
+        char *p;
+        BOOL executable;
+        if (view->section_ino != ino || !(p = bloc_dans_vue( view, bloc ))) continue;
+        page_inscriptible_non_executable( p, &executable );
+        if (!executable) continue;
+        (*nb)++;
+        trouve = (ULONG_PTR)p;
+    }
+    return trouve;   /* la derniere trouvee ; l op 6 refuse d armer quand il y en a plusieurs */
+}
+
+/* op 6 : arme les blocs de [base, base + size) (vue executable). Rend 1 si c'est fait, 0 sinon, avec la raison
+ * dans *raison : 1 hors vue de section, 2 aucune ou plusieurs vues executables, 3 vue inscriptible JIT ou
+ * systeme, 4 page d'hote mixte cote RW, 5 delai apres une ecriture, 6 table pleine. virtual_mutex tenu. */
+static UINT jumelles_armer( char *base, SIZE_T size, UINT *raison )
+{
+    struct file_view *view = find_view( base, 1 ), *autre;
+    ULONGLONG debut, fin, bloc;
+    UINT r;
+    int nb;
