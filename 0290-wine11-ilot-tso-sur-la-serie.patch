+/* retour d'un appel hote sur le vCPU qui l'a fait : le vCPU garde l'etat de la sortie ; on n'ecrit que ce que l'asm de
+ * retour natif changerait par rapport a lui (x0, pc, et ce que le cadre a modifie) */
+static void entrer_court( struct ilot_frame *f, uint64_t x0 )
+{
+    hv_vcpu_t v = fil.v;
+    uint64_t fpcr, fpsr, nzcv = f->cpsr & 0xf0000000;
+    fil.sortie_ok = 0;
+    if (f->restore_flags & 2) for (int i = 0; i < 18; i++) hv_vcpu_set_reg( v, HV_REG_X0 + i, f->x[i] );   /* CONTEXT_INTEGER */
+    else hv_vcpu_set_reg( v, HV_REG_X0, x0 );
+    for (int i = 18; i < 29; i++) if (f->x[i] != fil.sx[i]) hv_vcpu_set_reg( v, HV_REG_X0 + i, f->x[i] );
+    if (f->fp != fil.sx[29]) hv_vcpu_set_reg( v, HV_REG_X29, f->fp );
+    if (f->lr != fil.sx[30]) hv_vcpu_set_reg( v, HV_REG_X30, f->lr );
+    if (f->sp != fil.ssp) hv_vcpu_set_sys_reg( v, HV_SYS_REG_SP_EL1, f->sp );
+    if (nzcv != fil.snzcv) hv_vcpu_set_reg( v, HV_REG_CPSR, 0x3c5 | nzcv );
+    hv_vcpu_set_reg( v, HV_REG_PC, f->pc );
+    if (f->restore_flags & 4) { fpcr = f->fpcr; fpsr = f->fpsr; }   /* CONTEXT_FLOATING_POINT */
+    else __asm__ volatile( "mrs %0, fpcr\n\tmrs %1, fpsr" : "=r"(fpcr), "=r"(fpsr) );
+    if (fpcr != fil.sfpcr) hv_vcpu_set_reg( v, HV_REG_FPCR, fpcr );
+    if (fpsr != fil.sfpsr) hv_vcpu_set_reg( v, HV_REG_FPSR, fpsr );
+    if (f->restore_flags & 4)
+        for (int i = 0; i < 32; i++) { hv_simd_fp_uchar16_t q; memcpy( &q, &f->v[i], 16 ); hv_vcpu_set_simd_fp_reg( v, HV_SIMD_FP_REG_Q0 + i, q ); }
+    c_retours_courts++;
+    boucle( v );
+}
