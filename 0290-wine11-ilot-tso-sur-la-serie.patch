+static void chrono_noter_unix( uint64_t handle, uint64_t code, uint64_t dt )
+{
+    unsigned int h = (unsigned int)(((handle * 31) ^ code) * 0x9E3779B97F4A7C15ull >> 55) % CHRONO_NB_UNIX;
+    for (unsigned int i = 0; i < CHRONO_NB_UNIX; i++, h = (h + 1) % CHRONO_NB_UNIX)
+    {
+        uint64_t c = __atomic_load_n( &chrono_unix[h].handle, __ATOMIC_ACQUIRE );
+        if (c == handle && chrono_unix[h].code == code) goto noter;
+        if (!c)
+        {
+            uint64_t zero = 0;
+            if (__atomic_compare_exchange_n( &chrono_unix[h].code, &zero, code + 1, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED ))
+            { chrono_unix[h].code = code; __atomic_store_n( &chrono_unix[h].handle, handle, __ATOMIC_RELEASE ); goto noter; }
+        }
