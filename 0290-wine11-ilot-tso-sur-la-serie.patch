+/* les ecritures de tables sont achevees pour tous les observateurs, marcheurs de tables compris (seul un DSB les
+ * ordonne pour eux), avant la publication qui suit ou avant le talon TLBI */
+static inline void dsb_ish( void ) { __asm__ volatile( "dsb ish" ::: "memory" ); }
+
+/* sert le Gio de va (une tranche d'IPA) ; mutex tenu. Chaque publication est precedee et suivie d'un DSB : le marcheur
+ * de tables du vCPU qui rejoue doit la voir (sinon nouvelle faute de traduction, voir l3_resync) */
+static int servir_gio( uint64_t va )
+{
+    uint64_t *l0 = table( ZONE_L0 ), *l1;
+    uint64_t i0 = (va >> 39) & 511, i1 = (va >> 30) & 511;
+    if (!(l0[i0] & 1))
+    {
+        if (zone_l1_pris + 0x1000 > ZONE_MIROIRS) return 0;
+        l1 = table( zone_l1_pris ); memset( l1, 0, 0x1000 );
+        uint64_t ipa = ipa_de( (uint64_t)l1 );
+        if (!ipa) return 0;
+        zone_l1_pris += 0x1000;
+        dsb_ish();
+        __atomic_store_n( &l0[i0], ipa | 3, __ATOMIC_RELEASE );
+        dsb_ish();
+    }
+    uint64_t d0 = l0[i0], l1ipa = d0 & 0x0000fffffffff000ull;
+    l1 = (uint64_t *)(tranche_va[l1ipa >> 30] + (l1ipa & (GIO - 1)));
+    if (l1[i1] & 1) return 1;
+    if (tranche_nb >= NB_TRANCHES) return 0;
+    int n = tranche_nb++;
+    tranche_va[n] = va & ~(GIO - 1);
+    tranche_vu[n] = calloc( GIO / PAGE_HOTE / 8, 1 );
+    uint64_t kv = 0;
+    for (int k = 0; k < 2; k++) if (kuser_va[k] && (kuser_va[k] & ~(GIO - 1)) == (va & ~(GIO - 1))) kv = kuser_va[k];
+    if (kv && nb_decoupes < NB_DECOUPES)
+    {   /* Gio du KUSER : L2 de blocs de 2 Mio, L3 de pages de 4 Kio pour les 2 Mio du KUSER, dont la page pointe le
+         * miroir prive de la zone, en lecture seule */
+        uint64_t ipa2, ipa3, base = (uint64_t)n << 30, *l2 = table_neuve( &ipa2, 0 ), *l3 = table_neuve( &ipa3, 0 );
+        unsigned int j0 = (kv >> 21) & 511, k0 = (kv >> 12) & 511;
+        if (!l2 || !l3) return 0;
+        for (unsigned int j = 0; j < 512; j++) l2[j] = (base | ((uint64_t)j << 21)) | (1u << 10) | (3u << 8) | 1;
+        for (unsigned int k = 0; k < 512; k++) l3[k] = (base | ((uint64_t)j0 << 21) | ((uint64_t)k << 12)) | (1u << 10) | (3u << 8) | 3;
+        l3[k0] = ipa_de( (uint64_t)(zone + ZONE_KUSER) ) | (1u << 10) | (3u << 8) | (1u << 7) | 3;
+        l2[j0] = ipa3 | 3;
+        decoupes[nb_decoupes].gio = va & ~(GIO - 1); decoupes[nb_decoupes].n = n; decoupes[nb_decoupes].l2 = l2;
+        __atomic_store_n( &nb_decoupes, nb_decoupes + 1, __ATOMIC_RELEASE );
+        dsb_ish();
+        __atomic_store_n( &l1[i1], ipa2 | 3, __ATOMIC_RELEASE );
+        dsb_ish();
+        c_s1++;
+        return 1;
+    }
+    /* bloc de 1 Gio : Normal (MAIR attr 0), partage interne, AF */
+    __atomic_store_n( &l1[i1], ((uint64_t)n << 30) | (1u << 10) | (3u << 8) | 1, __ATOMIC_RELEASE );
+    dsb_ish();
+    c_s1++;
+    return 1;
+}
+
+/* --- etape 5b : sous-pages exactes au premier etage ----------------------------------------------------------------
+ * Seules les pages d'hote mixtes (droits Windows differents entre leurs sous-pages de 4 Kio, toutes dans des vues
+ * Windows ordinaires) recoivent des droits exacts ; toute autre entree L3 garde les droits pleins (RW, executable),
+ * c'est-a-dire que le deuxieme etage decide, comme avant 5b. Le decoupage d'un bloc garde l'identite et les memes
+ * attributs (pas de break-before-make : une faute de conflit de TLB, si elle venait, est rejouee apres le talon). */
+#define D_AF  (1ull << 10)
+#define D_SH  (3ull << 8)
+#define D_RO  (1ull << 7)                /* AP[2] : lecture seule a EL1 */
+#define D_PXN (1ull << 53)               /* pas d'execution a EL1 (l'invite tourne en EL1) */
+static int sous_pages_exactes = 1;       /* CIDRE_ILOT_SOUS_PAGES=0 : etape 5a (union, sans L3) */
+static uint64_t gen_l3;                  /* avance a chaque entree L3 changee */
+static uint64_t gen_videe;               /* derniere generation couverte par un talon TLBI acheve */
+static uint64_t c_l2_decoupes, c_l3_tables, c_l3_maj, c_l3_epuisees, c_vidages, c_resync, c_conflits, c_refus_sous_page;
+static __thread uint64_t resync_far;
+static __thread int resync_n;
+
+/* table suivante d'un descripteur de table (les tables sont dans la zone, servie par sa tranche) */
+static uint64_t *va_table( uint64_t desc )
+{
+    uint64_t ipa = desc & 0x0000fffffffff000ull;
+    return (uint64_t *)(tranche_va[ipa >> 30] + (ipa & (GIO - 1)));
+}
+
+static int est_kuser( uint64_t va4k )
+{
+    for (int k = 0; k < 2; k++) if (kuser_va[k] && (kuser_va[k] & ~0xfffull) == va4k) return 1;
+    return 0;
+}
+
+/* L2 du Gio de va (le bloc de 1 Gio est decoupe en 512 blocs de 2 Mio si creer) ; mutex tenu */
+static uint64_t *l2_de( uint64_t va, int creer )
+{
+    uint64_t d0 = table( ZONE_L0 )[(va >> 39) & 511], *l1, d1, ipa2, *l2, n;
+    if (!(d0 & 1)) return NULL;
+    l1 = va_table( d0 );
+    d1 = l1[(va >> 30) & 511];
+    if (!(d1 & 1)) return NULL;
+    if ((d1 & 3) == 3) return va_table( d1 );
+    if (!creer || nb_decoupes >= NB_DECOUPES || !(l2 = table_neuve( &ipa2, 1 ))) return NULL;
+    n = (d1 & 0x000000ffc0000000ull) >> 30;
+    for (unsigned int j = 0; j < 512; j++) l2[j] = ((n << 30) | ((uint64_t)j << 21)) | D_AF | D_SH | 1;
+    decoupes[nb_decoupes].gio = va & ~(GIO - 1); decoupes[nb_decoupes].n = n; decoupes[nb_decoupes].l2 = l2;
+    __atomic_store_n( &nb_decoupes, nb_decoupes + 1, __ATOMIC_RELEASE );
+    dsb_ish();
+    __atomic_store_n( &l1[(va >> 30) & 511], ipa2 | 3, __ATOMIC_RELEASE );
+    dsb_ish();
+    c_l2_decoupes++;
+    return l2;
+}
+
+/* L3 des 2 Mio de va (le bloc de 2 Mio est decoupe en 512 pages de 4 Kio aux droits pleins si creer) ; mutex tenu */
+static uint64_t *l3_de( uint64_t va, int creer )
+{
+    uint64_t *l2 = l2_de( va, creer ), d2, ipa3, *l3, base;
+    unsigned int j = (va >> 21) & 511;
+    if (!l2) return NULL;
+    d2 = l2[j];
+    if ((d2 & 3) == 3) return va_table( d2 );
+    if (!(d2 & 1) || !creer || !(l3 = table_neuve( &ipa3, 1 ))) return NULL;
+    base = d2 & 0x000000ffffe00000ull;
+    for (unsigned int k = 0; k < 512; k++) l3[k] = (base | ((uint64_t)k << 12)) | D_AF | D_SH | 3;
+    dsb_ish();
+    __atomic_store_n( &l2[j], ipa3 | 3, __ATOMIC_RELEASE );
+    dsb_ish();
+    c_l3_tables++;
+    return l3;
+}
+
+/* descripteur de page de 4 Kio : droits (bit 0 lecture, 1 ecriture, 2 execution), -1 droits pleins */
+static uint64_t desc_l3( uint64_t oa, int droits )
+{
+    uint64_t d = oa | D_AF | D_SH | 3;
+    if (droits < 0) return d;
+    if (!(droits & 1)) return 0;
+    if (!(droits & 2)) d |= D_RO;
+    if (!(droits & 4)) d |= D_PXN;
+    return d;
+}
+
+/* descripteur feuille de la traduction actuelle de va, tables relues comme le ferait l'invite (bloc de 1 Gio, de
+ * 2 Mio, ou page de 4 Kio) ; 0 si la traduction est invalide ; mutex tenu */
+static uint64_t feuille( uint64_t va )
+{
+    uint64_t d = table( ZONE_L0 )[(va >> 39) & 511];
+    if ((d & 3) != 3) return 0;
+    d = __atomic_load_n( &va_table( d )[(va >> 30) & 511], __ATOMIC_ACQUIRE );
+    if ((d & 3) == 1) return d;                     /* bloc de 1 Gio */
+    if ((d & 3) != 3) return 0;
+    d = __atomic_load_n( &va_table( d )[(va >> 21) & 511], __ATOMIC_ACQUIRE );
+    if ((d & 3) == 1) return d;                     /* bloc de 2 Mio */
+    if ((d & 3) != 3) return 0;
+    d = __atomic_load_n( &va_table( d )[(va >> 12) & 511], __ATOMIC_ACQUIRE );
+    return (d & 3) == 3 ? d : 0;                    /* page de 4 Kio */
+}
+
+/* le descripteur feuille permet-il l'acces ? genre 0 lecture, 1 ecriture, 8 execution */
+static int permet( uint64_t d, int genre )
+{
+    if (!(d & 1)) return 0;
+    if (genre == 1) return !(d & D_RO);
+    if (genre == 8) return !(d & D_PXN);
+    return 1;
+}
+
+/* entrees L3 de la page d'hote page d'apres la protection Windows de ses sous-pages ; virtual_mutex et ilot_mutex
+ * tenus. dr et *mixte rendus. Rend 1 si une entree a change (ou changerait, ecrire = 0), 0 sinon, -1 si les tables
+ * sont epuisees (la page reste a l'union : etape 5a). */
+static int l3_maj( uint64_t page, int ecrire, int dr[4], int *mixte )
+{
+    extern int ilot_droits_sous_pages( const void *page, int droits[4] );
+    int exact = ilot_droits_sous_pages( (const void *)page, dr ) == 0, change = 0;
+    uint64_t *l3;
+    *mixte = exact && (dr[0] != dr[1] || dr[1] != dr[2] || dr[2] != dr[3]);
+    if (!sous_pages_exactes) return 0;
+    if (!(l3 = l3_de( page, 0 )))
+    {
+        if (!*mixte) return 0;          /* bloc : droits pleins, le deuxieme etage decide */
+        if (!ecrire) return 1;
+        if (!(l3 = l3_de( page, 1 ))) { c_l3_epuisees++; return -1; }
+        if (ilot_diag && c_l3_tables <= 20)
+            fprintf( stderr, "[CIDRE_ILOT] sous-pages exactes : L3 pour les 2 Mio de la page mixte 0x%llx (droits %d %d %d %d), "
+                     "tables L3 %llu\n", (unsigned long long)page, dr[0], dr[1], dr[2], dr[3], (unsigned long long)c_l3_tables );
+    }
+    for (int i = 0; i < 4; i++)
+    {
+        uint64_t va = page + (uint64_t)i * 0x1000, oa = ipa_de( va ) & ~0xfffull, *e, d;
+        if (!oa || est_kuser( va )) continue;   /* la page du miroir KUSER pointe la zone : intouchable */
+        d = desc_l3( oa, *mixte ? dr[i] : -1 );
+        e = &l3[(va >> 12) & 511];
+        if (*e != d) { change = 1; if (ecrire) __atomic_store_n( e, d, __ATOMIC_RELEASE ); }
+    }
+    if (change && ecrire) { dsb_ish(); __atomic_fetch_add( &gen_l3, 1, __ATOMIC_ACQ_REL ); c_l3_maj++; }
+    return change;
+}
+
+/* projection par bloc : les entrees L3 de la page sont-elles deja justes ? */
+static int l3_stable( uint64_t page )
+{
+    int dr[4], mixte;
+    return l3_maj( page, 0, dr, &mixte ) == 0;
+}
+
+/* faute de premier etage sur une VA deja servie (traduction, a tout niveau, ou permission) : l'entree de la sous-page
+ * est recalculee (5b), puis la traduction actuelle est relue en entier ; rend 1 si elle permet l'acces, 0 pour une
+ * vraie faute. Rend 1 donc aussi pour une faute de traduction prise avant qu'un autre fil ne serve le Gio, ou avant
+ * que le marcheur ne voie une entree tout juste publiee (h64fils : faute de traduction de niveau 1 sur une
+ * allocation neuve de FEX, livree en AV) : jamais d'AV quand les tables, a jour de Wine, permettent l'acces.
+ * Quatre rejeux d'affilee a la meme adresse au plus. */
+extern void ilot_verrou_virtuel( int prendre );
+static int l3_resync( uint64_t far, int genre )
+{
+    int r, dr[4], mixte;
+    uint64_t page = far & ~(PAGE_HOTE - 1);
+    ilot_verrou_virtuel( 1 );
+    pthread_mutex_lock( &ilot_mutex );
+    if (sous_pages_exactes && l3_de( page, 0 )) l3_maj( page, 1, dr, &mixte );   /* la page du miroir KUSER n'y change pas */
+    r = permet( feuille( far ), genre );   /* miroir KUSER en ecriture : lecture seule, vraie faute */
+    pthread_mutex_unlock( &ilot_mutex );
+    ilot_verrou_virtuel( 0 );
+    if (!r) { resync_far = 0; return 0; }
+    if (far == resync_far && ++resync_n > 4)
+    {
+        if (ilot_diag) fprintf( stderr, "[CIDRE_ILOT] sous-page 0x%llx : entree permise mais faute repetee, faute livree\n", (unsigned long long)far );
+        resync_far = 0;
+        return 0;
+    }
+    if (far != resync_far) { resync_far = far; resync_n = 1; }
+    __atomic_fetch_add( &c_resync, 1, __ATOMIC_RELAXED );
+    return 1;
+}
+
+/* talon de la zone : tlbi vmalle1is (diffuse a tous les vCPU de la VM), dsb ish, isb, puis hvc #2 rend la main */
+__asm__( ".section __TEXT,__const\n\t.p2align 2\n\t.globl _ilot_talon_tlbi\n_ilot_talon_tlbi:\n\t"
+         "tlbi vmalle1is\n\tdsb ish\n\tisb\n\thvc #2\n\t"
+         ".globl _ilot_talon_tlbi_fin\n_ilot_talon_tlbi_fin:\n\t.text\n" );
+extern const uint32_t ilot_talon_tlbi[], ilot_talon_tlbi_fin[];
+
+/* fait executer le talon par le vCPU du fil (PC et CPSR remis ensuite) si une entree a change depuis le dernier
+ * talon acheve (force : toujours) */
+static void vider_tlb( hv_vcpu_t v, int force )
+{
+    uint64_t g = __atomic_load_n( &gen_l3, __ATOMIC_ACQUIRE ), pc, cpsr, vu, t0;
+    if (!force && __atomic_load_n( &gen_videe, __ATOMIC_ACQUIRE ) >= g) return;
+    t0 = mach_absolute_time();
+    hv_vcpu_get_reg( v, HV_REG_PC, &pc ); hv_vcpu_get_reg( v, HV_REG_CPSR, &cpsr );
+    hv_vcpu_set_reg( v, HV_REG_PC, (uint64_t)zone + ZONE_TALON_TLBI );
+    hv_vcpu_set_reg( v, HV_REG_CPSR, 0x3c5 );   /* EL1h, interruptions masquees */
+    for (unsigned int n = 0;; n++)
+    {
+        if (hv_vcpu_run( v )) fatal( "hv_vcpu_run (talon TLBI)", 0, 0, 0 );
+        hv_vcpu_exit_t *e = fil.e;
+        if (e->reason == HV_EXIT_REASON_EXCEPTION && ((e->exception.syndrome >> 26) & 0x3f) == 0x16 &&
+            (e->exception.syndrome & 0xffff) == 2) break;
+        /* sortie forcee (suspension, pression, echantillon : la boucle les reprend, la demande reste posee), minuterie */
+        if ((e->reason == HV_EXIT_REASON_CANCELED || e->reason == HV_EXIT_REASON_VTIMER_ACTIVATED) && n < 100000) continue;
+        fatal( "talon TLBI : sortie inattendue (raison, ESR, essais)", e->reason, e->exception.syndrome, n );
+    }
+    hv_vcpu_set_reg( v, HV_REG_PC, pc ); hv_vcpu_set_reg( v, HV_REG_CPSR, cpsr );
+    vu = __atomic_load_n( &gen_videe, __ATOMIC_RELAXED );
+    while (vu < g && !__atomic_compare_exchange_n( &gen_videe, &vu, g, 1, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED )) ;
+    __atomic_fetch_add( &c_vidages, 1, __ATOMIC_RELAXED );
+    __atomic_fetch_add( &t_tlbi, mach_absolute_time() - t0, __ATOMIC_RELAXED );
+}
+
+static int tlbi_en_attente( void )
+{
+    return __atomic_load_n( &gen_videe, __ATOMIC_ACQUIRE ) < __atomic_load_n( &gen_l3, __ATOMIC_ACQUIRE );
+}
+
+/* --- deuxieme etage --------------------------------------------------------------------------------------------- */
+/* virtual.c, verrou de virtual_mutex et protection Windows des pages de 4 Kio d'une page d'hote */
+extern void ilot_verrou_virtuel( int prendre );
+extern int ilot_exec_windows( const void *page );
+extern int ilot_vue_windows( const void *addr );
+
+/* la page est-elle residente dans l'objet de tete de son entree (copie privee de la tache) ? */
+static int page_privee( uint64_t page )
+{
+    vm_page_info_basic_data_t b; mach_msg_type_number_t n = VM_PAGE_INFO_BASIC_COUNT;
+    if (mach_vm_page_info( mach_task_self(), page, VM_PAGE_INFO_BASIC, (vm_page_info_t)&b, &n )) return 0;
+    return b.depth == 0 && (b.disposition & VM_PAGE_QUERY_PAGE_PRESENT);
+}
+
+/* classe la region qui contient page : 0 projetable (droits de l'hote dans *f, sans execution), 1 code de l'hote
+ * (executable cote hote : jamais projete), -1 refusee (raison dans *pourquoi) */
+static uint64_t rs_debut, rs_fin; static int rs_mode;   /* entree de region de la derniere classe 0 (mutex tenu) */
+static int region_sure( uint64_t page, hv_memory_flags_t *f, const char **pourquoi )
+{
+    mach_vm_address_t a = page; mach_vm_size_t s = 0; natural_t prof = 0;
+    vm_region_submap_info_data_64_t info; mach_msg_type_number_t n = VM_REGION_SUBMAP_INFO_COUNT_64;
+    *f = 0;
+    if (mach_vm_region_recurse( mach_task_self(), &a, &s, &prof, (vm_region_recurse_info_t)&info, &n ) || a > page)
+    { *pourquoi = "hors projection"; return -1; }
+    rs_debut = a; rs_fin = a + s; rs_mode = info.share_mode;
+    if (info.protection & VM_PROT_EXECUTE) { *pourquoi = "executable cote hote"; return 1; }
+    if (info.is_submap) { *pourquoi = "sous-carte (cache partage)"; return -1; }
+    int pf = pf_marquee( page );
+    if (!marquee( page ) && !pf) { *pourquoi = "pas une projection anonyme privee de virtual.c"; return -1; }
+    if (pf)
+    {   /* vue partagee d'une section pagefile (voir pagefile_carte) : partagee par nature, jamais executee */
+        if (info.user_tag) { *pourquoi = "etiquette (IOKit, Metal, malloc...)"; return -1; }
+        if (info.share_mode == SM_COW || info.share_mode == SM_LARGE_PAGE) { *pourquoi = "mode de partage (pagefile)"; return -1; }
+        *f = ((info.protection & VM_PROT_READ) ? HV_MEMORY_READ : 0) | ((info.protection & VM_PROT_WRITE) ? HV_MEMORY_WRITE : 0);
+        c_pagefile++;
+        return 0;
+    }
+    /* SM_SHARED / SM_TRUESHARED / SM_PRIVATE_ALIASED : la memoire anonyme privee prouvee par la carte n'est partagee
+     * qu'avec le deuxieme etage (hv_vm_map) ou avec un alias de sous-page de virtual.c (mach_vm_remap, sans
+     * execution) ; tout autre mode (copie de fichier, grande page, vide...) est refuse */
+    if (info.share_mode == SM_COW)
+    {   /* copie a la demande : le wineserver ecrit notre memoire par mach_vm_write (server/mach.c), qui peut poser
+         * dans l'entree un objet copie des pages du serveur. N'est admise que la page residente dans l'objet de tete
+         * (profondeur 0 : copie privee de cette tache) ; si l'entree est inscriptible, une ecriture neutre force la
+         * copie, sinon refus */
+        int prive = page_privee( page );
+        if (!prive && (info.protection & VM_PROT_WRITE))
+        {
+            __atomic_fetch_or( (volatile uint64_t *)page, 0, __ATOMIC_RELAXED );
+            prive = page_privee( page );
+        }
+        else if (!prive && (info.protection & VM_PROT_READ) && (info.max_protection & VM_PROT_WRITE))
+        {   /* lecture seule (images, que le wineserver lit par mach_vm_read_overwrite, qui pose la copie a la demande
+             * symetrique) : cette page d'hote seule passe en ecriture le temps de l'ecriture neutre qui force la copie
+             * privee, puis reprend sa protection. virtual_mutex tenu, page pas encore projetee. */
+            if (!mach_vm_protect( mach_task_self(), page, PAGE_HOTE, FALSE, VM_PROT_READ | VM_PROT_WRITE ))
+            {
+                __atomic_fetch_or( (volatile uint64_t *)page, 0, __ATOMIC_RELAXED );
+                mach_vm_protect( mach_task_self(), page, PAGE_HOTE, FALSE, info.protection );
+                prive = page_privee( page );
+                c_copies_forcees++;
+            }
+        }
+        if (!prive) { *pourquoi = "copie a la demande non privee"; return -1; }
+    }
+    else if (info.share_mode != SM_PRIVATE && info.share_mode != SM_EMPTY && info.share_mode != SM_SHARED &&
+             info.share_mode != SM_TRUESHARED && info.share_mode != SM_PRIVATE_ALIASED) { *pourquoi = "mode de partage"; return -1; }
+    if (info.external_pager) { *pourquoi = "pager externe (fichier, peripherique)"; return -1; }
+    if (info.user_tag) { *pourquoi = "etiquette (IOKit, Metal, malloc...)"; return -1; }
+    if (!ilot_voulu) { *pourquoi = "execution de l'hote non coupee"; return -1; }
+    *f = ((info.protection & VM_PROT_READ) ? HV_MEMORY_READ : 0) | ((info.protection & VM_PROT_WRITE) ? HV_MEMORY_WRITE : 0);
+    return 0;
+}
+
+static uint64_t refus_page; static const char *refus_raison;
+static __thread int refus_livrable;      /* refus = protection Windows (droits, adresse non projetee) : exception a livrer */
+
+/* projette la page d'hote qui contient ipa ; 0 : projetee, 1 : code de l'hote (appel hote), -1 : refusee,
+ * 2 : entrees L3 changees (5b), rien de projete : talon TLBI puis rejeu. va : adresse fautive (FAR, comme pour
+ * l'exception livree), dont les bits 12-13 designent la sous-page */
+static int projeter_corps( uint64_t ipa, uint64_t va, int ecriture, int execution );
+static int projeter( uint64_t ipa, uint64_t va, int ecriture, int execution )
+{
+    uint64_t t0 = mach_absolute_time();
+    int r = projeter_corps( ipa, va, ecriture, execution );
+    __atomic_fetch_add( &t_projeter, mach_absolute_time() - t0, __ATOMIC_RELAXED );
+    __atomic_fetch_add( &c_projeter, 1, __ATOMIC_RELAXED );
+    return r;
+}
+static int projeter_corps( uint64_t ipa, uint64_t va, int ecriture, int execution )
+{
+    uint64_t n = ipa >> 30, off = (ipa & (GIO - 1)) & ~(PAGE_HOTE - 1), page, k;
+    int r = -1, c, dr[4], mixte, l3 = 0;
+    hv_memory_flags_t f;
+    const char *pourquoi = "tranche absente";
+    refus_livrable = 0;
+    ilot_verrou_virtuel( 1 );   /* ordre : virtual_mutex puis ilot_mutex, comme ilot_projection */
+    pthread_mutex_lock( &ilot_mutex );
+    if (n == 0 || n >= (uint64_t)tranche_nb) goto fin;
+    page = tranche_va[n] + off; k = off / PAGE_HOTE;
+    c = region_sure( page, &f, &pourquoi );
+    if (c < 0 && !strcmp( pourquoi, "hors projection" )) refus_livrable = 1;   /* adresse sans projection : AV Windows */
+    if (c == 1)
+    {
+        r = execution ? 1 : -1;
+        if (r == 1)
+        {   /* mutex tenu */
+            if (!code_hote[n]) __atomic_store_n( &code_hote[n], calloc( GIO / PAGE_HOTE / 8, 1 ), __ATOMIC_RELEASE );
+            if (code_hote[n]) __atomic_fetch_or( &code_hote[n][k / 8], (uint8_t)(1 << (k % 8)), __ATOMIC_RELAXED );
+        }
+        goto fin;
+    }
+    if (c) goto fin;
+    if (ilot_exec_windows( (void *)page )) f |= HV_MEMORY_EXEC;
+    /* etape 5b : droits exacts des sous-pages au premier etage avant toute projection ; une sous-page fermee a l'acces
+     * est une faute Windows tout de suite ; une entree changee demande le talon TLBI avant de projeter (aucun vCPU ne
+     * doit garder une ancienne traduction plus permissive quand la page redevient accessible au deuxieme etage) */
+    l3 = l3_maj( page, 1, dr, &mixte );
+    if (sous_pages_exactes && l3 >= 0 && mixte && !(dr[(va >> 12) & 3] & (execution ? 4 : ecriture ? 2 : 1)))
+    {
+        pourquoi = "droits (sous-page de 4 Kio)"; refus_livrable = 1; c_refus_sous_page++;
+        goto fin;
+    }
+    if (l3 > 0 || tlbi_en_attente()) { r = 2; goto fin; }
+    pourquoi = "droits";
+    refus_livrable = 1;   /* protection Windows (garde, NOACCESS, lecture seule, sans execution) */
+    if (!(f & HV_MEMORY_READ) || (ecriture && !(f & HV_MEMORY_WRITE)) || (execution && !(f & HV_MEMORY_EXEC))) goto fin;
+    pourquoi = "hv"; refus_livrable = 0;
+    if (tranche_vu[n][k / 8] & (1 << (k % 8)))
+    {   /* deja projetee : les droits ont change */
+        if (hv_vm_protect( (n << 30) | off, PAGE_HOTE, f )) goto fin;
+    }
+    else
+    {   /* projection par bloc : pages voisines de la meme entree de region (meme protection, meme mode, verifiee par
+         * region_sure), marquees, pas encore projetees, au meme droit d'execution Windows, dans la fenetre alignee de
+         * 2 Mio et la tranche ; jamais pour une copie a la demande (verifiee page a page) ni pour une execution */
+        uint64_t deb = page, fin = page + PAGE_HOTE;
+        if (!execution && rs_mode != SM_COW)
+        {
+            uint64_t bas = page & ~((2ull << 20) - 1), haut = bas + (2ull << 20);
+            int x = (f & HV_MEMORY_EXEC) != 0;
+            if (bas < rs_debut) bas = rs_debut;
+            if (haut > rs_fin) haut = rs_fin;
+            if (bas < tranche_va[n]) bas = tranche_va[n];
+            if (haut > tranche_va[n] + GIO) haut = tranche_va[n] + GIO;
+            /* 5b : une voisine dont les entrees L3 changeraient (mixte, ou perimee) attend sa propre faute */
+#define LIBRE(p) (marquee( p ) && !(tranche_vu[n][(((p) - tranche_va[n]) / PAGE_HOTE) / 8] & (1 << ((((p) - tranche_va[n]) / PAGE_HOTE) % 8))) && \
+                  ilot_exec_windows( (void *)(p) ) == x && l3_stable( p ))
+            while (deb - PAGE_HOTE >= bas && LIBRE( deb - PAGE_HOTE )) deb -= PAGE_HOTE;
+            while (fin + PAGE_HOTE <= haut && LIBRE( fin )) fin += PAGE_HOTE;
+#undef LIBRE
+        }
+        if (hv_vm_map( (void *)deb, (n << 30) | (deb - tranche_va[n]), fin - deb, f )) goto fin;
+        for (uint64_t q = deb; q < fin; q += PAGE_HOTE)
+        {
+            uint64_t kk = (q - tranche_va[n]) / PAGE_HOTE;
+            tranche_vu[n][kk / 8] |= 1 << (kk % 8);
+        }
+        if (fin - deb > PAGE_HOTE) { c_blocs++; c_s2 += (fin - deb) / PAGE_HOTE - 1; }
+    }
+    c_s2++; r = 0;
+fin:
+    if (r < 0) { refus_page = tranche_va[n < (uint64_t)tranche_nb ? n : 0] + off; refus_raison = pourquoi; }
+    pthread_mutex_unlock( &ilot_mutex );
+    ilot_verrou_virtuel( 0 );
+    return r;
+}
+
+/* virtual.c : la projection ou les droits de [start, start+size) changent ; les pages d'invite qui les couvrent sont
+ * retirees et seront reprojetees a la prochaine faute */
+static void compter_retrait( uint64_t ra, uint64_t pages );
+static void projection_de( const void *start, size_t size, uint64_t ra );
+void ilot_projection( const void *start, size_t size )
+{
+    projection_de( start, size, (uint64_t)__builtin_return_address( 0 ) );
+}
+void ilot_projection_ra( const void *start, size_t size, void *ra )
+{
+    projection_de( start, size, (uint64_t)ra );
+}
+static void projection_de( const void *start, size_t size, uint64_t ra )
+{
+    uint64_t avant = c_retraits, t0;
+    if (!ilot_actif || !size) return;
+    t0 = mach_absolute_time();
+    uint64_t a = (uint64_t)start & ~(PAGE_HOTE - 1), fin = (uint64_t)start + size;
+    pthread_mutex_lock( &ilot_mutex );
+    while (a < fin)
+    {
+        uint64_t gfin = (a & ~(GIO - 1)) + GIO, ipa = ipa_de( a );
+        if (!ipa) { a = gfin; continue; }
+        uint64_t n = ipa >> 30, run = 0, run_pages = 0;   /* pages projetees contigues : un seul hv_vm_unmap */
+        for (; a < fin && a < gfin; a += PAGE_HOTE)
+        {
+            uint64_t k = (a & (GIO - 1)) / PAGE_HOTE;
+            if (code_hote[n]) __atomic_fetch_and( &code_hote[n][k / 8], (uint8_t)~(1 << (k % 8)), __ATOMIC_RELAXED );
+            if (!(tranche_vu[n][k / 8] & (1 << (k % 8))))
+            {
+                if (run_pages) { hv_vm_unmap( run, run_pages * PAGE_HOTE ); run_pages = 0; }
+                continue;
+            }
+            if (!run_pages) run = (n << 30) | (a & (GIO - 1));
+            run_pages++;
+            tranche_vu[n][k / 8] &= ~(1 << (k % 8));
+            c_retraits++;
+        }
+        if (run_pages) hv_vm_unmap( run, run_pages * PAGE_HOTE );
+    }
+    if (ilot_diag && c_retraits != avant) compter_retrait( ra, c_retraits - avant );
+    if (chrono_actif && c_retraits != avant) chrono_retrait( ra, c_retraits - avant );
+    pthread_mutex_unlock( &ilot_mutex );
+    __atomic_fetch_add( &t_proj_de, mach_absolute_time() - t0, __ATOMIC_RELAXED );
+    __atomic_fetch_add( &c_proj_de, 1, __ATOMIC_RELAXED );
+}
+
+/* Reprotection sans retrait (CIDRE_ILOT_REPROTEGER, par defaut actif) : un mprotect ne change ni l'objet ni les
+ * frames de la memoire (anonyme ou pagefile, jamais executee cote hote) ; seules les permissions changent. Les pages deja
+ * projetees gardent donc leur projection : le deuxieme etage recoit les nouveaux droits (hv_vm_protect, que
+ * Hypervisor.framework invalide lui-meme) et le premier etage ses droits exacts (5b, l3_maj ; une entree changee
+ * demande le talon TLBI, joue avant la prochaine entree de tout fil). Sans droit de lecture, retrait comme avant.
+ * Evite, apres chaque NtProtect (jumelles armees et desarmees, write-watch, W^X...), la refaute de deuxieme etage de
+ * chaque page touchee (sortie, region_sure, hv_vm_map). virtual_mutex tenu par l'appelant (virtual.c, recursif). */
+static int reproteger_actif = -1;
+static uint64_t c_reprot_pages, c_reprot_appels;
+static int reproteger( void *addr, size_t len, int prot )
+{
+    uint64_t a = (uint64_t)addr & ~(PAGE_HOTE - 1), fin = (uint64_t)addr + len;
+    if (reproteger_actif < 0)
+        reproteger_actif = !(getenv( "CIDRE_ILOT_REPROTEGER" ) && !atoi( getenv( "CIDRE_ILOT_REPROTEGER" ) ));
+    if (!reproteger_actif || !ilot_actif || !(prot & PROT_READ)) return 0;
+    ilot_verrou_virtuel( 1 );
+    pthread_mutex_lock( &ilot_mutex );
+    while (a < fin)
+    {
+        uint64_t gfin = (a & ~(GIO - 1)) + GIO, ipa = ipa_de( a );
+        if (!ipa) { a = gfin; continue; }
+        uint64_t n = ipa >> 30;
+        for (; a < fin && a < gfin; a += PAGE_HOTE)
+        {
+            uint64_t k = (a & (GIO - 1)) / PAGE_HOTE;
+            int dr[4], mixte;
+            if (!(tranche_vu[n][k / 8] & (1 << (k % 8)))) continue;
+            hv_memory_flags_t f = HV_MEMORY_READ | ((prot & PROT_WRITE) ? HV_MEMORY_WRITE : 0) | (ilot_exec_windows( (void *)a ) ? HV_MEMORY_EXEC : 0);
+            if (l3_maj( a, 1, dr, &mixte ) < 0 || hv_vm_protect( (n << 30) | (a & (GIO - 1)), PAGE_HOTE, f ))
+            {   /* tables epuisees ou refus : retrait, comme avant */
+                hv_vm_unmap( (n << 30) | (a & (GIO - 1)), PAGE_HOTE );
+                tranche_vu[n][k / 8] &= ~(1 << (k % 8));
+                c_retraits++;
+                continue;
+            }
+            c_reprot_pages++;
+        }
+    }
+    c_reprot_appels++;
+    pthread_mutex_unlock( &ilot_mutex );
+    ilot_verrou_virtuel( 0 );
+    return 1;
+}
+
+/* virtual.c : mprotect et mmap passent par ici. Les pages d'invite sont retirees avant le changement (ou reprotegees,
+ * voir reproteger) ; en mode ilot, l'hote n'execute jamais la memoire de virtual.c (le deuxieme etage accorde
+ * l'execution). */
+int ilot_mprotect( void *addr, size_t len, int prot )
+{
+    int r;
+    if (ilot_voulu || pf_dans( (uint64_t)addr, len )) prot &= ~PROT_EXEC;   /* section pagefile : jamais executee, partout */
+    if (ilot_actif && (prot & PROT_READ) && (reproteger_actif != 0))
+    {   /* droits de l'hote d'abord (les frames ne changent pas), puis ceux des deux etages */
+        if ((r = mprotect( addr, len, prot ))) return r;
+        if (reproteger( addr, len, prot )) return 0;
+        projection_de( addr, len, (uint64_t)__builtin_return_address( 0 ) );
+        return 0;
+    }
+    projection_de( addr, len, (uint64_t)__builtin_return_address( 0 ) );
+    return mprotect( addr, len, prot );
+}
+
+void *ilot_mmap( void *addr, size_t len, int prot, int flags, int fd, off_t off )
+{
+    void *p;
+    if (flags & MAP_FIXED) marquer_pf( (uint64_t)addr, len, 0 );   /* la vue pagefile qui etait la est remplacee */
+    if (!ilot_voulu) return mmap( addr, len, prot, flags, fd, off );
+    if (flags & MAP_JIT) { errno = EINVAL; return MAP_FAILED; }
+    prot &= ~PROT_EXEC;
+    if (flags & MAP_FIXED) { projection_de( addr, len, (uint64_t)__builtin_return_address( 0 ) ); marquer( (uint64_t)addr, len, 0 ); }
+    if (fd >= 0 && (flags & MAP_PRIVATE) && (flags & MAP_FIXED))
+    {   /* copie privee de fichier (images PE) : memoire anonyme lue, jamais la frame du fichier */
+        size_t lu = 0; ssize_t r;
+        p = mmap( addr, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON | MAP_FIXED, -1, 0 );
+        if (p == MAP_FAILED) return p;
+        while (lu < len && (r = pread( fd, (char *)p + lu, len - lu, off + lu )) > 0) lu += r;
+        if (mprotect( p, len, prot )) return MAP_FAILED;
+        marquer( (uint64_t)p, len, 1 );
+        return p;
+    }
+    p = mmap( addr, len, prot, flags, fd, off );
+    if (p != MAP_FAILED && fd < 0 && (flags & MAP_ANON) && (flags & MAP_PRIVATE)) marquer( (uint64_t)p, len, 1 );
+    return p;
+}
+
+int ilot_munmap( void *addr, size_t len )
+{
+    projection_de( addr, len, (uint64_t)__builtin_return_address( 0 ) );
+    marquer_pf( (uint64_t)addr, len, 0 );
+    if (ilot_voulu) marquer( (uint64_t)addr, len, 0 );
+    return munmap( addr, len );
+}
