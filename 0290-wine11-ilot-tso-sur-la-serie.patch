+/* wait_on_address_sleep (appel unix 8 de ntdll) : l'entree de file de RtlWaitOnAddress { list next, prev ; addr ; tid }
+ * est sur la pile de l'invite, au-dessus du bloc de parametres ; on la reconnait a tid = ce fil et next->prev = elle.
+ * L'adresse et sa valeur a l'entree (= la valeur attendue, comparee juste avant sous le verrou de file) sont gardees. */
+static void trouver_entree_wao( struct diag_fil *d, uint64_t params )
+{   /* l'entree est SOUS le bloc de parametres, dans le meme cadre : ntdll.dll 1.5.19, RtlWaitOnAddress ARM64EC entree
+     * sp+0x28 / params sp+0x48 (params - 0x20), aarch64 entree sp+0 / params sp+0x68 (params - 0x68) ; fenetre
+     * [params - 0x100, params + 0x340) */
+    uint64_t b[0x88], base = params - 0x100, addr_reg = d->wa_addr;
+    d->wa_entree = 0; d->wa_val = 0;
+    if (!d->tid || !lire_invite( base, b, sizeof(b) )) return;
+    d->blq_delai_ptr = b[0x100 / 8];   /* params->timeout */
+    for (int i = 0; i + 3 < 0x88; i++)
+    {
+        uint64_t nx = b[i], pv = b[i + 1], ad = b[i + 2], moi = base + i * 8, pn = 0, val = 0;
+        if ((uint32_t)b[i + 3] != d->tid || !ad || !nx || !pv || (nx & 7) || (pv & 7)) continue;
+        if (!lire_invite( nx + 8, &pn, 8 ) || pn != moi) continue;
+        if (d->wa_taille == 1 || d->wa_taille == 2 || d->wa_taille == 4 || d->wa_taille == 8)
+        {   /* valeur attendue : *cmp (x20), sur la taille de l'attente (x22) */
+            if (!lire_invite( d->wa_cmp, &val, d->wa_taille )) val = 0;
+            if (ad != addr_reg) d->wa_taille = 0;   /* registres incoherents avec l'entree : taille inconnue */
+        }
+        else { d->wa_taille = 0; if (!lire_invite( ad, &val, 8 )) { uint32_t v4 = 0; lire_invite( ad, &v4, 4 ); val = v4; } }
+        d->wa_addr = ad; d->wa_val = val; d->wa_entree = moi;
+        return;
+    }
+}
+
+/* --- analyse d'un blocage sur wait_on_address (24/10, CIDRE_ILOT_BLOQUES) ------------------------------------------
+ * (1) l'objet : octets autour de l'adresse, lectures « section critique » / « SRW » / « variable de condition », pile du
+ *     fil bloque, etat de tous les fils de l'ilot ;
+ * (2) coherence de la page : le mot relu par un vCPU de sonde (memes tables, TLB vide) contre le mot lu par l'hote,
+ *     descripteur du premier etage, IPA, bit de projection du deuxieme etage, objet VM de la page de l'hote ;
+ * (3) une seconde d'echantillons (10 ms) des pc des fils qui tournent dans leur vCPU.
+ * Rien n'est projete : une faute de deuxieme etage du vCPU de sonde est rapportee telle quelle. */
+#define ZONE_SONDE 0xc40                 /* ldr x0, [x1] ; hvc #3 (vCPU de sonde, analyse de blocage) */
+static volatile int blocage_ech;         /* echantillons des pc demandes par l'analyse (boucle : sorties CANCELED) */
+static hv_vcpu_t sonde_v; static hv_vcpu_exit_t *sonde_e; static int sonde_etat;   /* 0 a creer, 1 pret, -1 echec */
+
+static const char *decrire_appel_fil( const struct diag_fil *d, char *b, size_t n )
+{
+    if (d->blq_num == CHRONO_UNIX)
+    {
+        Dl_info di; const char *img = "?";
+        if (dladdr( (void *)d->blq_handle, &di ) && di.dli_fname) img = strrchr( di.dli_fname, '/' ) ? strrchr( di.dli_fname, '/' ) + 1 : di.dli_fname;
+        snprintf( b, n, "unix %s:%llu", img, (unsigned long long)d->blq_code );
+    }
+    else if (nom_appel( d->blq_num )) snprintf( b, n, "%s", nom_appel( d->blq_num ) );
+    else snprintf( b, n, "appel 0x%x", d->blq_num );
+    return b;
+}
+static const char *etat_fil( uint32_t tid, char *b, size_t n )
+{
+    int nb = __atomic_load_n( &nb_diag_fils, __ATOMIC_RELAXED );
+    uint64_t now = mach_absolute_time(); char q[96];
+    if (nb > NB_DIAG_FILS) nb = NB_DIAG_FILS;
+    if (!tid) { snprintf( b, n, "aucun" ); return b; }
+    for (int i = 0; i < nb; i++)
+    {
+        const struct diag_fil *d = &diag_fils[i];
+        if (d->tid != tid) continue;
+        uint64_t t0 = __atomic_load_n( &d->blq_t0, __ATOMIC_ACQUIRE );
+        if (d->mort) snprintf( b, n, "fil %04x mort", tid );
+        else if (t0) snprintf( b, n, "fil %04x dans l'hote (%s) depuis %.1f s", tid, decrire_appel_fil( d, q, sizeof(q) ), ms( now - t0 ) / 1000 );
+        else snprintf( b, n, "fil %04x dans son vCPU (ou entre deux appels)", tid );
+        return b;
+    }
+    snprintf( b, n, "fil %04x hors de la table de l'ilot (jamais entre, ou sans appel hote note)", tid );
+    return b;
+}
+
+/* (2) vCPU de sonde, cree et garde par le fil des blocages ; configure comme creer_vcpu */
+static int sonde_preparer( char *pourquoi, size_t n )
+{
+    if (sonde_etat) return sonde_etat > 0;
+    if (hv_vcpu_create( &sonde_v, &sonde_e, NULL )) { sonde_etat = -1; snprintf( pourquoi, n, "hv_vcpu_create refuse (plafond de vCPU ?)" ); return 0; }
+    uint64_t a0 = 0;
+    hv_vcpu_set_sys_reg( sonde_v, HV_SYS_REG_MAIR_EL1, 0xff );
+    hv_vcpu_set_sys_reg( sonde_v, HV_SYS_REG_TCR_EL1, 16 | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23) | (2ull << 32) );
+    hv_vcpu_set_sys_reg( sonde_v, HV_SYS_REG_TTBR0_EL1, ipa_de( (uint64_t)table( ZONE_L0 ) ) );
+    hv_vcpu_set_sys_reg( sonde_v, HV_SYS_REG_SCTLR_EL1, 0x30d00800 | 1 | 4 | 0x1000 );
+    hv_vcpu_set_sys_reg( sonde_v, HV_SYS_REG_CPACR_EL1, 3u << 20 );
+    hv_vcpu_set_sys_reg( sonde_v, HV_SYS_REG_VBAR_EL1, (uint64_t)zone + ZONE_VECTEURS );
+    hv_vcpu_get_sys_reg( sonde_v, HV_SYS_REG_ACTLR_EL1, &a0 );
+    hv_vcpu_set_sys_reg( sonde_v, HV_SYS_REG_ACTLR_EL1, ilot_tso ? (a0 | 2) : (a0 & ~2ull) );
+    sonde_etat = 1;
+    return 1;
+}
+/* lance le vCPU de sonde a pc jusqu'a hvc #attendu ; rend 0 si atteint, sinon decrit la sortie */
+static int sonde_courir( uint64_t pc, unsigned int attendu, char *pourquoi, size_t n )
+{
+    hv_vcpu_set_reg( sonde_v, HV_REG_PC, pc );
+    hv_vcpu_set_reg( sonde_v, HV_REG_CPSR, 0x3c5 );
+    for (unsigned int k = 0; k < 1000; k++)
+    {
+        if (hv_vcpu_run( sonde_v )) { snprintf( pourquoi, n, "hv_vcpu_run en echec" ); return -1; }
+        if (sonde_e->reason == HV_EXIT_REASON_CANCELED || sonde_e->reason == HV_EXIT_REASON_VTIMER_ACTIVATED) continue;
+        if (sonde_e->reason != HV_EXIT_REASON_EXCEPTION) { snprintf( pourquoi, n, "sortie de raison %u", sonde_e->reason ); return -1; }
+        uint64_t esr = sonde_e->exception.syndrome, ec = (esr >> 26) & 0x3f;
+        if (ec == 0x16 && (esr & 0xffff) == attendu) return 0;
+        if (ec == 0x16 && (esr & 0xffff) == 1)
+        {   /* exception prise par l'invite (vecteurs : hvc #1) : faute du premier etage */
+            uint64_t esr1 = 0, far = 0;
+            hv_vcpu_get_sys_reg( sonde_v, HV_SYS_REG_ESR_EL1, &esr1 ); hv_vcpu_get_sys_reg( sonde_v, HV_SYS_REG_FAR_EL1, &far );
+            snprintf( pourquoi, n, "faute du premier etage (ESR_EL1 0x%llx, FAR 0x%llx)", (unsigned long long)esr1, (unsigned long long)far );
+            return -1;
+        }
+        if (ec == 0x24 || ec == 0x20)
+        {
+            snprintf( pourquoi, n, "faute du deuxieme etage (ESR 0x%llx, VA 0x%llx, IPA 0x%llx) : page non projetee, rien n'est projete ici",
+                      (unsigned long long)esr, (unsigned long long)sonde_e->exception.virtual_address, (unsigned long long)sonde_e->exception.physical_address );
+            return -1;
+        }
+        snprintf( pourquoi, n, "exception inattendue (ESR 0x%llx)", (unsigned long long)esr );
+        return -1;
+    }
+    snprintf( pourquoi, n, "1000 sorties sans fin" );
+    return -1;
+}
+static void sonde_coherence( uint64_t va )
+{
+    char pourquoi[256] = "", info[400] = ""; uint64_t vcpu = 0, hote = 0, x0 = 0;
+    int lu_h = lire_invite( va, &hote, 8 );
+    uint64_t f = feuille( va ), ipa = ipa_de( va ), page = va & ~(PAGE_HOTE - 1);
+    int projetee = -1;
+    if (ipa)
+    {
+        uint64_t nt = ipa >> 30, k = (ipa & (GIO - 1)) / PAGE_HOTE;
+        if (nt < NB_TRANCHES && tranche_vu[nt]) projetee = (tranche_vu[nt][k / 8] >> (k % 8)) & 1;
+    }
+    {   /* page de l'hote : objet VM, decalage, profondeur, disposition ; region : partage, droits */
+        vm_page_info_basic_data_t pb; mach_msg_type_number_t pn = VM_PAGE_INFO_BASIC_COUNT;
+        mach_vm_address_t ra = page; mach_vm_size_t rs = 0; vm_region_basic_info_data_64_t rb; mach_msg_type_number_t rn = VM_REGION_BASIC_INFO_COUNT_64; mach_port_t obj = MACH_PORT_NULL;
+        int l = 0;
+        if (!mach_vm_page_info( mach_task_self(), page, VM_PAGE_INFO_BASIC, (vm_page_info_t)&pb, &pn ))
+            l += snprintf( info + l, sizeof(info) - l, "objet 0x%llx +0x%llx profondeur %d disposition 0x%x", (unsigned long long)pb.object_id,
+                           (unsigned long long)pb.offset, pb.depth, pb.disposition );
+        if (!mach_vm_region( mach_task_self(), &ra, &rs, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&rb, &rn, &obj ))
+            l += snprintf( info + l, sizeof(info) - l, " ; region 0x%llx+0x%llx droits %d/%d partagee %d", (unsigned long long)ra, (unsigned long long)rs,
+                           rb.protection, rb.max_protection, rb.shared );
+    }
+    if (sonde_preparer( pourquoi, sizeof(pourquoi) ) &&
+        !sonde_courir( (uint64_t)zone + ZONE_TALON_TLBI, 2, pourquoi, sizeof(pourquoi) ))
+    {
+        hv_vcpu_set_reg( sonde_v, HV_REG_X1, va );
+        if (!sonde_courir( (uint64_t)zone + ZONE_SONDE, 3, pourquoi, sizeof(pourquoi) ))
+        {
+            hv_vcpu_get_reg( sonde_v, HV_REG_X0, &x0 ); vcpu = x0;
+            snprintf( pourquoi, sizeof(pourquoi), "%s", !lu_h ? "hote illisible" : vcpu == hote ? "IDENTIQUES" :
+                      (uint32_t)vcpu == (uint32_t)hote ? "32 bits bas identiques, hauts differents" :
+                      "DIFFERENTS : le vCPU voit une autre trame que l'hote (projection perimee ?)" );
+        }
+    }
+    fprintf( stderr, "[CIDRE_ILOT] blocage : coherence 0x%llx : hote 0x%016llx, vCPU 0x%016llx -> %s ; premier etage 0x%llx, IPA 0x%llx, projetee %d ; %s\n",
+             (unsigned long long)va, (unsigned long long)hote, (unsigned long long)vcpu, pourquoi, (unsigned long long)f, (unsigned long long)ipa,
+             projetee, info );
+}
