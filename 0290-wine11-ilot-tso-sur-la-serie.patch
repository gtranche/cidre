+/* appels systeme par numero (x8) et par appelant (x9 : lr du talon Nt*, l'adresse qui a appele la fonction Nt) */
+extern void __wine_syscall_dispatcher(void), __wine_unix_call_dispatcher(void);
+#define NB_NUMEROS 8192   /* x8 : numero dans la table (bits 0-11) et table (bit 12, win32u) */
+static uint64_t appels_par_numero[NB_NUMEROS];
+#define NB_APPELANTS 256
+static struct { uint64_t pc, n; } appelants[NB_APPELANTS];
+static void compter_appel_systeme( uint64_t numero, uint64_t appelant )
+{
+    __atomic_fetch_add( &appels_par_numero[numero % NB_NUMEROS], 1, __ATOMIC_RELAXED );
+    unsigned int h = (unsigned int)((appelant * 0x9E3779B97F4A7C15ull) >> 56);
+    for (unsigned int i = 0; i < NB_APPELANTS; i++, h = (h + 1) % NB_APPELANTS)
+    {
+        uint64_t c = __atomic_load_n( &appelants[h].pc, __ATOMIC_RELAXED );
+        if (c == appelant || (!c && __atomic_compare_exchange_n( &appelants[h].pc, &c, appelant, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED )) || c == appelant)
+        { __atomic_fetch_add( &appelants[h].n, 1, __ATOMIC_RELAXED ); return; }
+    }
+}
+static void releve_appels_systeme( void )
+{
+    extern int ilot_vue_base( const void *addr, uint64_t *base, uint64_t *taille, int *image );
+    uint64_t tot = 0;
+    for (int i = 0; i < NB_NUMEROS; i++) tot += appels_par_numero[i];
+    if (!tot) return;
+    for (int r = 0; r < 10; r++)
+    {
+        int m = -1;
+        for (int i = 0; i < NB_NUMEROS; i++) if (appels_par_numero[i] && (m < 0 || appels_par_numero[i] > appels_par_numero[m])) m = i;
+        if (m < 0) break;
+        fprintf( stderr, "[CIDRE_ILOT] releve appel systeme : %10llu (%5.1f %%) numero 0x%x\n", (unsigned long long)appels_par_numero[m],
+                 100.0 * appels_par_numero[m] / tot, m );
+        appels_par_numero[m] = 0;
+    }
+    memset( appels_par_numero, 0, sizeof(appels_par_numero) );
+    for (int r = 0; r < 10; r++)
+    {
+        int m = -1;
+        for (int i = 0; i < NB_APPELANTS; i++) if (appelants[i].n && (m < 0 || appelants[i].n > appelants[m].n)) m = i;
+        if (m < 0) break;
+        uint64_t base = 0, taille = 0; int image = 0;
+        ilot_vue_base( (void *)appelants[m].pc, &base, &taille, &image );
+        fprintf( stderr, "[CIDRE_ILOT] releve appelant : %10llu (%5.1f %%) 0x%llx : %s base 0x%llx +0x%llx\n", (unsigned long long)appelants[m].n,
+                 100.0 * appelants[m].n / tot, (unsigned long long)appelants[m].pc,
+                 image ? "image" : base ? "vue (JIT ?)" : "hors vue", (unsigned long long)base, (unsigned long long)(appelants[m].pc - base) );
+        appelants[m].n = 0;
+    }
+    for (int i = 0; i < NB_APPELANTS; i++) { appelants[i].n = 0; appelants[i].pc = 0; }
+}
