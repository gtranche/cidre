+            a->rx = (ULONG_PTR)code;
+            a->desarme_ms = 0;
+            if (code) hist_noter( (ULONG_PTR)code, h, FALSE );
+        }
+        else if (!arme_ajouter( view->section_ino, bloc )) { *raison = 6; return 0; }
+        else
+        {
+            if ((a = arme_trouver( view->section_ino, bloc ))) { a->empreinte = h; a->rx = (ULONG_PTR)code; }
+            InterlockedIncrement( &ilot_arm_neufs );
+            if (code) hist_noter( (ULONG_PTR)code, h, TRUE );
+        }
+    }
+    return 1;
+}
