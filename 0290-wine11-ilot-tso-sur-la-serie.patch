+/* etat de chaque fil de l'ilot (CIDRE_ILOT_DIAG) : dernier appel systeme, ses arguments, l'appelant, et s'il est
+ * dans le vCPU (0), dans un appel hote (1) ou bloque dans server_select/futex_wait (2) ; releve toutes les 10 s */
+#define NB_DIAG_FILS 512
+#define NB_ANNEAU 64
+struct diag_trace { uint64_t numero, appelant, a[4], ret; };   /* numero 0xffffffff : appel unix (a[0] handle, a[1] code) */
+static struct diag_fil { uint64_t teb, numero, appelant, a[5], delai, t, n, n_releve; volatile int etat;
+                         uint64_t ech, ech_image, ech_vue, ech_hors;   /* echantillons de l'invite (non biaises) */
+                         /* chronologie par fil (CIDRE_ILOT_CHRONO=2) : temps dans le vCPU et dans l'hote, et pc echantillonnes
+                          * toutes les 10 ms (16 lignes de 64 octets, remises a zero a chaque ligne de chronologie) */
+                         uint64_t c_vcpu, c_hote, av_vcpu, av_hote, c_attente, av_attente;
+                         uint32_t tid;                                  /* lu une fois */
+                         uint32_t att_genre, att_reveil;                /* attente la plus longue du tick : genre, fil qui a reveille */
+                         uint64_t att_duree, att_objet;
+                         struct { uint64_t pc; uint32_t n; } pcs[16];
+                         /* fils bloques (CIDRE_ILOT_BLOQUES) : appel hote en cours depuis blq_t0 (0 : aucun, fil dans le
+                          * vCPU) ; pour wait_on_address, l'entree de RtlWaitOnAddress trouvee sur la pile, l'adresse et sa
+                          * valeur a l'entree dans l'attente (= la valeur attendue, comparee juste avant sous le verrou) */
+                         uint64_t blq_t0, blq_dit, blq_lr, blq_sp, blq_delai_ptr, blq_handle, blq_code, blq_obj[4];
+                         uint32_t blq_num, blq_nb, mort;
+                         uint64_t wa_entree, wa_addr, wa_val, wa_params, wa_cmp, wa_taille, ech_sp, ech_lr;
+                         struct diag_trace anneau[NB_ANNEAU]; unsigned int tete, vide; } diag_fils[NB_DIAG_FILS];
+static int nb_diag_fils;
+static __thread int diag_place;   /* 1 + indice, 0 : pas encore */
+static struct diag_fil *diag_fil( void )
+{
+    if (!diag_place)
+    {
+        extern pthread_key_t cle_teb_globale;
+        int i = __atomic_fetch_add( &nb_diag_fils, 1, __ATOMIC_RELAXED );
+        if (i >= NB_DIAG_FILS) { diag_place = -1; return NULL; }
+        diag_fils[i].teb = (uint64_t)pthread_getspecific( cle_teb_globale );
+        if (diag_fils[i].teb) diag_fils[i].tid = *(volatile uint32_t *)(diag_fils[i].teb + 0x48);   /* ClientId.UniqueThread */
+        diag_place = i + 1;
+    }
+    return diag_place > 0 ? &diag_fils[diag_place - 1] : NULL;
+}
+static void diag_etat( int etat )
+{
+    struct diag_fil *d;
+    if (!ilot_diag || !(d = diag_fil())) return;
+    if (d->etat != etat) { d->etat = etat; d->t = mach_absolute_time(); }
+}
+static void diag_anneau( struct diag_fil *d, uint64_t numero, uint64_t appelant, const uint64_t *x, int unix_appel );
+static void diag_appel( const uint64_t *x )
+{
+    struct diag_fil *d;
+    if (!(d = diag_fil())) return;
+    d->numero = x[8]; d->appelant = x[9];
+    for (int i = 0; i < 5; i++) d->a[i] = x[i];
+    {   /* delai d'attente (LARGE_INTEGER *, 100 ns, negatif = relatif) : NtWaitForSingleObject x2, NtWaitForMultipleObjects x4, NtDelayExecution x1 */
+        uint64_t q = x[8] == 0x4 ? x[2] : x[8] == 0x5b ? x[4] : x[8] == 0x34 ? x[1] : 0, v = 0x8000000000000000ull;
+        mach_vm_size_t lu = 0;
+        if (q) mach_vm_read_overwrite( mach_task_self(), q, 8, (mach_vm_address_t)&v, &lu );
+        int attente = x[8] == 0x4 || x[8] == 0x5b || x[8] == 0x34;
+        d->delai = !attente ? 0x8000000000000000ull : !q ? 0x7ffffffffffffffeull : lu == 8 ? v : 0x7fffffffffffffffull;
+    }
+    d->n++;
+    d->etat = 1; d->t = mach_absolute_time();
+    diag_anneau( d, x[8], x[9], x, 0 );
+}
+/* l'anneau des derniers appels du fil, vide a chaque NtRaiseException, NtCreateUserProcess ou NtTerminateProcess (4 fois) */
+static void diag_anneau( struct diag_fil *d, uint64_t numero, uint64_t appelant, const uint64_t *x, int unix_appel )
+{
+    struct diag_trace *t = &d->anneau[d->tete % NB_ANNEAU];
+    unsigned int tid = 0; mach_vm_size_t lu = 0;
+    t->numero = unix_appel ? 0xffffffffull : numero; t->appelant = appelant;
+    for (int i = 0; i < 4; i++) t->a[i] = x[i];
+    t->ret = 0xdeadull;
+    d->tete++;
+    if (unix_appel || d->vide >= 4 || (numero != 0xd5 && numero != 0x8f && numero != 0x2c)) return;
+    d->vide++;
+    if (d->teb) mach_vm_read_overwrite( mach_task_self(), d->teb + 0x48, 4, (mach_vm_address_t)&tid, &lu );
+    for (unsigned int i = d->tete > NB_ANNEAU ? d->tete - NB_ANNEAU : 0; i < d->tete; i++)
+    {
+        struct diag_trace *e = &d->anneau[i % NB_ANNEAU];
+        fprintf( stderr, "[CIDRE_ILOT] anneau %04x %3d : %s 0x%llx de 0x%llx (%llx %llx %llx %llx) -> 0x%llx\n", tid, (int)(i - d->tete + 1),
+                 e->numero == 0xffffffffull ? "unix" : "appel", (unsigned long long)e->numero, (unsigned long long)e->appelant,
+                 (unsigned long long)e->a[0], (unsigned long long)e->a[1], (unsigned long long)e->a[2], (unsigned long long)e->a[3],
+                 (unsigned long long)e->ret );
+    }
+}
+static void diag_retour( uint64_t x0 )
+{
+    struct diag_fil *d;
+    if (!ilot_diag || diag_place <= 0 || !(d = diag_fil()) || !d->tete) return;
+    d->anneau[(d->tete - 1) % NB_ANNEAU].ret = x0;
+}
+static void releve_fils( void )
+{
+    uint64_t maintenant = mach_absolute_time();
+    int n = __atomic_load_n( &nb_diag_fils, __ATOMIC_RELAXED );
+    if (n > NB_DIAG_FILS) n = NB_DIAG_FILS;
+    for (int i = 0; i < n; i++)
+    {
+        struct diag_fil *d = &diag_fils[i];
+        uint64_t nb = d->n - d->n_releve; d->n_releve = d->n;
+        unsigned int tid = 0; mach_vm_size_t lu = 0;
+        if (d->teb) mach_vm_read_overwrite( mach_task_self(), d->teb + 0x48, 4, (mach_vm_address_t)&tid, &lu );
+        static const char *etats[] = { "vCPU", "appel", "bloque" };
+        char delai[32] = "";
+        if (d->delai == 0x7fffffffffffffffull) snprintf( delai, sizeof(delai), " delai illisible" );
+        else if (d->delai == 0x7ffffffffffffffeull) snprintf( delai, sizeof(delai), " delai infini" );
+        else if (d->delai != 0x8000000000000000ull) snprintf( delai, sizeof(delai), " delai %lld", (long long)d->delai );
+        fprintf( stderr, "[CIDRE_ILOT] releve fil %04x : %-6s depuis %8.1f ms, %8llu appels ; dernier 0x%llx de 0x%llx (%llx %llx %llx %llx %llx)%s\n",
+                 tid, etats[d->etat % 3], ms( maintenant - d->t ), (unsigned long long)nb, (unsigned long long)d->numero,
+                 (unsigned long long)d->appelant, (unsigned long long)d->a[0], (unsigned long long)d->a[1], (unsigned long long)d->a[2],
+                 (unsigned long long)d->a[3], (unsigned long long)d->a[4], delai );
+        if (d->ech)
+            fprintf( stderr, "[CIDRE_ILOT] releve fil %04x : echantillons de l'invite %llu (image %llu, vue/JIT %llu, hors vue %llu)\n",
+                     tid, (unsigned long long)d->ech, (unsigned long long)d->ech_image, (unsigned long long)d->ech_vue,
+                     (unsigned long long)d->ech_hors );
+    }
+}
