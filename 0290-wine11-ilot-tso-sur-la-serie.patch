+/* adresses de code sur une pile (n au plus, 4 Kio) */
+static void pile_courte( uint64_t sp, int n, char *l, size_t t )
+{
+    extern int ilot_pc_executable( const void *addr, uint64_t *base, int *image );
+    uint64_t s[512], prec = 0; int dits = 0, k = 0; char c[160];
+    l[0] = 0;
+    if (!sp || !lire_invite( sp, s, sizeof(s) )) { snprintf( l, t, " pile illisible" ); return; }
+    for (unsigned int i = 0; i < 512 && dits < n; i++)
+    {
+        uint64_t q = s[i], base = 0; int image = 0;
+        if (q < 0x10000 || q == prec || !ilot_pc_executable( (void *)q, &base, &image )) continue;
+        prec = q; dits++;
+        k += snprintf( l + k, t - k, " [%s]", decrire_pc( q, c, sizeof(c) ) );
+        if (k >= (int)t - 1) break;
+    }
+}
+/* chaque fil vivant de l'ilot au moment du blocage : ce qu'il fait et le haut de sa pile (attentes sur adresse : adresse,
+ * taille, *cmp et valeur courante, lues maintenant) */
+static void panorama_fils( void )
+{
+    int nb = __atomic_load_n( &nb_diag_fils, __ATOMIC_RELAXED );
+    uint64_t now = mach_absolute_time();
+    if (nb > NB_DIAG_FILS) nb = NB_DIAG_FILS;
+    fprintf( stderr, "[CIDRE_ILOT] blocage : panorama des fils\n" );
+    for (int i = 0; i < nb; i++)
+    {
+        struct diag_fil *d = &diag_fils[i]; char q[96], p[700], w[200] = "", c[160];
+        if (d->mort) continue;
+        uint64_t t0 = __atomic_load_n( &d->blq_t0, __ATOMIC_ACQUIRE );
+        if (t0)
+        {
+            if (d->blq_num == CHRONO_UNIX && d->blq_code == 8 && d->wa_params &&
+                (d->wa_taille == 1 || d->wa_taille == 2 || d->wa_taille == 4 || d->wa_taille == 8))
+            {
+                uint64_t att = 0, cur = 0;
+                lire_invite( d->wa_cmp, &att, d->wa_taille ); lire_invite( d->wa_addr, &cur, d->wa_taille );
+                snprintf( w, sizeof(w), " adresse 0x%llx taille %llu *cmp 0x%llx courant 0x%llx", (unsigned long long)d->wa_addr,
+                          (unsigned long long)d->wa_taille, (unsigned long long)att, (unsigned long long)cur );
+            }
+            pile_courte( d->blq_sp, 8, p, sizeof(p) );
+            fprintf( stderr, "[CIDRE_ILOT] blocage :   fil %04x hote %s depuis %.3f s%s ; pile%s\n", d->tid, decrire_appel_fil( d, q, sizeof(q) ),
+                     ms( now - t0 ) / 1000, w, p );
+        }
+        else
+        {
+            pile_courte( d->ech_sp, 8, p, sizeof(p) );
+            fprintf( stderr, "[CIDRE_ILOT] blocage :   fil %04x vCPU (lr %s) ; pile echantillonnee%s\n", d->tid,
+                     d->ech_lr ? decrire_pc( d->ech_lr, c, sizeof(c) ) : "-", d->ech_sp ? p : " -" );
+        }
+    }
+}
