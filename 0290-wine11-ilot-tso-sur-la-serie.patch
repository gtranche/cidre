+/* les 4 fils qui ont passe le plus de temps dans le vCPU pendant l'intervalle : temps vCPU, hote, attente, et leurs
+ * deux lignes de pc les plus echantillonnees (image ou vue, decalage) */
+static void chrono_par_fil( const char *quand )
+{
+    extern int ilot_vue_base( const void *addr, uint64_t *base, uint64_t *taille, int *image );
+    int n = __atomic_load_n( &nb_diag_fils, __ATOMIC_RELAXED );
+    static uint64_t dv[NB_DIAG_FILS], dh[NB_DIAG_FILS], da[NB_DIAG_FILS];
+    if (n > NB_DIAG_FILS) n = NB_DIAG_FILS;
+    for (int i = 0; i < n; i++)
+    {
+        struct diag_fil *d = &diag_fils[i];
+        uint64_t v = d->c_vcpu, h = d->c_hote, a = d->c_attente;
+        dv[i] = v - d->av_vcpu; dh[i] = h - d->av_hote; da[i] = a - d->av_attente;
+        d->av_vcpu = v; d->av_hote = h; d->av_attente = a;
+    }
+    int principal_vu = 0;
+    for (int r = 0; r < 5; r++)
+    {
+        int m = -1;
+        if (r < 4) { for (int i = 0; i < n; i++) if (dv[i] != ~0ull && dv[i] && (m < 0 || dv[i] > dv[m])) m = i; }
+        else if (!principal_vu && n) m = 0;   /* le premier fil inscrit (le fil principal) est toujours ecrit, meme a l'arret */
+        if (m < 0) { if (r < 4) { r = 3; continue; } break; }
+        if (m == 0) principal_vu = 1;
+        struct diag_fil *d = &diag_fils[m];
+        unsigned int tid = 0; mach_vm_size_t lu = 0; char pcs[256]; int l = 0;
+        if (d->teb) mach_vm_read_overwrite( mach_task_self(), d->teb + 0x48, 4, (mach_vm_address_t)&tid, &lu );
+        pcs[0] = 0;
+        for (int q = 0; q < 2; q++)
+        {
+            int b = -1;
+            for (int j = 0; j < 16; j++) if (d->pcs[j].n && (b < 0 || d->pcs[j].n > d->pcs[b].n)) b = j;
+            if (b < 0) break;
+            uint64_t base = 0, taille = 0; int image = 0;
+            if (ilot_vue_base( (void *)d->pcs[b].pc, &base, &taille, &image ))
+                l += snprintf( pcs + l, sizeof(pcs) - l, " %s 0x%llx+0x%llx x%u", image ? "image" : "vue", (unsigned long long)base,
+                               (unsigned long long)(d->pcs[b].pc - base), d->pcs[b].n );
+            else l += snprintf( pcs + l, sizeof(pcs) - l, " 0x%llx x%u", (unsigned long long)d->pcs[b].pc, d->pcs[b].n );
+            d->pcs[b].n = 0;
+        }
+        {
+            char att[160] = "";
+            if (d->att_genre)
+            {
+                const char *g = d->att_genre == 0x2008 ? "wait_on_address" : d->att_genre == 0x4 ? "WaitForSingleObject" :
+                                d->att_genre == 0x5b ? "WaitForMultipleObjects" : d->att_genre == 0x34 ? "DelayExecution" :
+                                d->att_genre == 0xd9 ? "RemoveIoCompletionEx" : "?";
+                if (d->att_reveil) snprintf( att, sizeof(att), " ; attente max %s %.1f ms objet 0x%llx reveil fil %04x", g, ms( d->att_duree ),
+                                             (unsigned long long)d->att_objet, d->att_reveil );
+                else snprintf( att, sizeof(att), " ; attente max %s %.1f ms objet 0x%llx reveil -", g, ms( d->att_duree ),
+                               (unsigned long long)d->att_objet );
+            }
+            fprintf( stderr, "[CIDRE_ILOT] chrono %s fil %04x : vCPU %.1f ms, hote %.1f ms (attente %.1f ms) ; pc%s%s\n", quand, tid,
+                     ms( dv[m] == ~0ull ? 0 : dv[m] ), ms( dh[m] ), ms( da[m] ), pcs[0] ? pcs : " -", att );
+        }
+        dv[m] = ~0ull;   /* deja ecrit */
+    }
+    for (int i = 0; i < n; i++)
+    {
+        memset( diag_fils[i].pcs, 0, sizeof(diag_fils[i].pcs) );
+        diag_fils[i].att_duree = 0; diag_fils[i].att_genre = 0; diag_fils[i].att_reveil = 0;
+    }
+}
