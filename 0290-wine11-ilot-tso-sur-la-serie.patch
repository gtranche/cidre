+    int i, pris = 0;
+    for (i = 0; i < 100 && !(pris = !pthread_mutex_trylock( &virtual_mutex )); i++) usleep( 1000 );
+    copies_reecrire( NULL, ~(size_t)0, FALSE );
+    LIST_FOR_EACH_ENTRY( c, &copies_reecrites, struct copie_reecrite, entry ) fsync( c->fd );
+    if (pris) pthread_mutex_unlock( &virtual_mutex );
+    if (copies_reecrites_pages || copies_reecrites_echecs)
+        fprintf( stderr, "[CIDRE_ILOT] vues partagees en copie reecrite : fin, %ld page(s) reecrite(s), %ld echec(s)\n",
+                 (long)copies_reecrites_pages, (long)copies_reecrites_echecs );
