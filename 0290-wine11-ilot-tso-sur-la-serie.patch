+/* depuis __wine_syscall_dispatcher_return et le retour rapide des appels unix : x0 = valeur de retour, sinon le cadre
+ * dit tout (comme le fait l'asm de retour) */
+static void entrer_court( struct ilot_frame *f, uint64_t x0 ) __attribute__((noreturn));
+
+/* reprises apres NtContinue (0x43) et NtRaiseException (0xd5) : le CONTEXT recu (ARM64 : X0 a 0x8, Sp 0x100, Pc 0x108),
+ * le cadre, le chemin pris ; pour la reprise de l'emulation, le CONTEXT x64 donne a KiUserEmulationDispatcher
+ * (Rdx 0x88, Rsp 0x98, Rip 0xf8) */
+static uint64_t c_diag_reprises;
+static int diag_reprise( const struct ilot_frame *f, uint64_t x0 )
+{
+    struct diag_fil *d;
+    uint32_t cf[2] = { 0 }; uint64_t c[34] = { 0 }; mach_vm_size_t lu = 0; unsigned int tid = 0;
+    if (!ilot_diag || diag_place <= 0 || !(d = diag_fil()) || (d->numero != 0x43 && d->numero != 0xd5)) return 0;
+    if (__atomic_fetch_add( &c_diag_reprises, 1, __ATOMIC_RELAXED ) >= 6000) return 0;
+    if (d->teb) mach_vm_read_overwrite( mach_task_self(), d->teb + 0x48, 4, (mach_vm_address_t)&tid, &lu );
+    if (d->numero == 0x43 && d->a[0])
