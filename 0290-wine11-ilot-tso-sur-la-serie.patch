+/* la garde refuse ce qu'elle doit refuser : sinon, rien n'entre dans l'invite */
+static void garde_controle( void )
+{
+    hv_memory_flags_t f; const char *pq;
+    int fd = open( "/usr/lib/dyld", O_RDONLY );
+    void *fic = fd >= 0 ? mmap( NULL, PAGE_HOTE, PROT_READ, MAP_PRIVATE, fd, 0 ) : MAP_FAILED;
+    void *jit = mmap( NULL, PAGE_HOTE, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANON | MAP_JIT, -1, 0 );
+    void *par = mmap( NULL, PAGE_HOTE, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANON, -1, 0 );
+    if (fic != MAP_FAILED) *(volatile char *)fic;
+    if (par != MAP_FAILED) *(volatile char *)par = 1;
+    if (region_sure( (uint64_t)zone, &f, &pq ) != 0) fatal( "garde : zone refusee", (uint64_t)zone, 0, 0 );
+    if (region_sure( (uint64_t)&garde_controle & ~(PAGE_HOTE - 1), &f, &pq ) != 1) fatal( "garde : code de l'hote accepte", 0, 0, 0 );
+    if (fic == MAP_FAILED || region_sure( (uint64_t)fic, &f, &pq ) == 0) fatal( "garde : copie de fichier acceptee", (uint64_t)fic, 0, 0 );
+    if (jit != MAP_FAILED && region_sure( (uint64_t)jit, &f, &pq ) == 0) fatal( "garde : MAP_JIT accepte", (uint64_t)jit, 0, 0 );
+    if (par == MAP_FAILED || region_sure( (uint64_t)par, &f, &pq ) == 0) fatal( "garde : region partagee acceptee", (uint64_t)par, 0, 0 );
+    void *m = malloc( 64 );
+    if (region_sure( (uint64_t)m & ~(PAGE_HOTE - 1), &f, &pq ) == 0) fatal( "garde : malloc accepte", (uint64_t)m, 0, 0 );
+    free( m );
+    if (region_sure( (uint64_t)stderr & ~(PAGE_HOTE - 1), &f, &pq ) == 0) fatal( "garde : donnees de libsystem acceptees", 0, 0, 0 );
+    if (fic != MAP_FAILED) munmap( fic, PAGE_HOTE );
+    if (jit != MAP_FAILED) munmap( jit, PAGE_HOTE );
+    if (par != MAP_FAILED) munmap( par, PAGE_HOTE );
+    if (fd >= 0) close( fd );
+}
+
+/* CIDRE_ILOT_VCPU_CACHES=n (temoins) : n vCPU pris hors du compte, chacun par un fil qui dort pour toujours ; simule
+ * la fuite vue dans ELDEN RING (HV_NO_RESOURCES sous le plafond compte). Aucune projection : le vCPU n'est jamais lance. */
+static void *vcpu_cache_fil( void *p )
+{
+    hv_vcpu_t v; hv_vcpu_exit_t *e;
+    if (hv_vcpu_create( &v, &e, NULL )) return NULL;
+    for (;;) pause();
+    return NULL;
+}
+
+/* signal_init_process : tables de l'invite ; l'hote n'execute deja plus la memoire Windows, donc tout echec est fatal */
+void ilot_init( void )
+{
+    hv_memory_flags_t f; const char *pq;
+    if (!ilot_voulu) return;
+    zone = mmap( NULL, 2 * ZONE_TAILLE, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0 );
+    if (zone == MAP_FAILED) fatal( "zone", 0, 0, 0 );
+    /* zone alignee sur 4 Mio : elle ne chevauche pas deux Gio */
+    uint8_t *z = (uint8_t *)(((uint64_t)zone + ZONE_TAILLE - 1) & ~(ZONE_TAILLE - 1));
+    zone = z; memset( zone, 0, ZONE_TAILLE );
+    marquer( (uint64_t)zone, ZONE_TAILLE, 1 );
+    garde_controle();
+    {   /* miroir KUSER : 0x7ffe0000 (adresse Windows) et user_shared_data (miroir x86-64 de Cidre, 0093) */
+        extern struct _KUSER_SHARED_DATA *user_shared_data;
+        kuser_va[0] = 0x7ffe0000; kuser_va[1] = (uint64_t)user_shared_data;
+        for (int k = 0; k < 2; k++)
