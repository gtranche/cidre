+/* preuve d'origine : pages d'hote de 16 Kio projetees par virtual.c en memoire anonyme privee depuis le choix du
+ * processus (donc jamais executees ni JIT cote hote), 1 bit par page, une carte de 8 Kio par Gio de VA (47 bits) */
+#define NB_GIO_VA (1u << 17)
+static uint8_t *anon_carte[NB_GIO_VA];
+static pthread_mutex_t carte_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static void marquer( uint64_t a, uint64_t len, int oui )
+{
+    uint64_t fin = a + len;
+    pthread_mutex_lock( &carte_mutex );
+    for (a &= ~(PAGE_HOTE - 1); a < fin; a += PAGE_HOTE)
+    {
+        uint64_t g = a >> 30, k = (a & (GIO - 1)) / PAGE_HOTE;
+        if (g >= NB_GIO_VA) break;
+        if (!anon_carte[g]) { if (!oui) { a = ((g + 1) << 30) - PAGE_HOTE; continue; } anon_carte[g] = calloc( GIO / PAGE_HOTE / 8, 1 ); }
+        if (oui) anon_carte[g][k / 8] |= 1 << (k % 8); else anon_carte[g][k / 8] &= ~(1 << (k % 8));
+    }
+    pthread_mutex_unlock( &carte_mutex );
+}
