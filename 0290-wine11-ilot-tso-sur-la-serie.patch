+/* les 6 appels hote de l'intervalle qui ont pris le plus de temps, et les 4 plus nombreux */
+static void chrono_appels( uint64_t *av_n, uint64_t *av_t, const char *quand, int ecrire )
+{
+    static uint64_t dn[CHRONO_NB], dt[CHRONO_NB];
+    char ligne[1024]; int l = 0;
+    for (int i = 0; i < CHRONO_NB; i++)
+    {
+        uint64_t n = __atomic_load_n( &chrono_n[i], __ATOMIC_RELAXED ), t = __atomic_load_n( &chrono_t[i], __ATOMIC_RELAXED );
+        dn[i] = n - av_n[i]; dt[i] = t - av_t[i]; av_n[i] = n; av_t[i] = t;
+    }
+    if (!ecrire) return;
+    l += snprintf( ligne + l, sizeof(ligne) - l, "[CIDRE_ILOT] chrono %s appels par temps :", quand );
+    for (int r = 0; r < 6; r++)
+    {
+        int m = -1;
+        for (int i = 0; i < CHRONO_NB; i++) if (dt[i] && (m < 0 || dt[i] > dt[m])) m = i;
+        if (m < 0) break;
+        l += snprintf( ligne + l, sizeof(ligne) - l, " %s%x %llu/%.1fms", m == CHRONO_UNIX ? "unix" : m == CHRONO_AUTRE ? "autre" : "0x",
+                       m < CHRONO_UNIX ? m : 0, (unsigned long long)dn[m], ms( dt[m] ) );
+        dt[m] = 0;
+    }
+    l += snprintf( ligne + l, sizeof(ligne) - l, " ; par nombre :" );
+    for (int r = 0; r < 4; r++)
+    {
+        int m = -1;
+        for (int i = 0; i < CHRONO_NB; i++) if (dn[i] && (m < 0 || dn[i] > dn[m])) m = i;
+        if (m < 0) break;
+        l += snprintf( ligne + l, sizeof(ligne) - l, " %s%x %llu", m == CHRONO_UNIX ? "unix" : m == CHRONO_AUTRE ? "autre" : "0x",
+                       m < CHRONO_UNIX ? m : 0, (unsigned long long)dn[m] );
+        dn[m] = 0;
+    }
+    fprintf( stderr, "%s\n", ligne );
+    {   /* appels unix de l'intervalle par (bibliotheque, fonction) : les 5 plus longs */
+        static uint64_t av_un[CHRONO_NB_UNIX], av_ut[CHRONO_NB_UNIX];
+        uint64_t un[CHRONO_NB_UNIX], ut[CHRONO_NB_UNIX];
+        l = snprintf( ligne, sizeof(ligne), "[CIDRE_ILOT] chrono %s unix par temps :", quand );
+        for (int i = 0; i < CHRONO_NB_UNIX; i++)
+        {
+            uint64_t n = chrono_unix[i].n, t = chrono_unix[i].t;
+            un[i] = n - av_un[i]; ut[i] = t - av_ut[i]; av_un[i] = n; av_ut[i] = t;
+        }
+        for (int r = 0; r < 5; r++)
+        {
+            int m = -1;
+            for (int i = 0; i < CHRONO_NB_UNIX; i++) if (ut[i] && (m < 0 || ut[i] > ut[m])) m = i;
+            if (m < 0) break;
+            Dl_info di; const char *img = "?";
+            if (dladdr( (void *)chrono_unix[m].handle, &di ) && di.dli_fname)
+                img = strrchr( di.dli_fname, '/' ) ? strrchr( di.dli_fname, '/' ) + 1 : di.dli_fname;
+            l += snprintf( ligne + l, sizeof(ligne) - l, " %s:%llu %llu/%.1fms", img, (unsigned long long)chrono_unix[m].code,
+                           (unsigned long long)un[m], ms( ut[m] ) );
+            ut[m] = 0;
+        }
+        fprintf( stderr, "%s\n", ligne );
+    }
+}
