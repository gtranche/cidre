+/* miroir KUSER : les quatre KSYSTEM_TIME (InterruptTime 0x08, SystemTime 0x14, TimeZoneBias 0x20, TickCount 0x320)
+ * lus de facon coherente (High1 == High2) puis ecrits comme le wineserver (server/fd.c : High2, Low, High1) ; un
+ * seul ecrivain a la fois, pour que le temps ne recule jamais ; le reste de la page, copie mot a mot sans eux */
+static pthread_mutex_t kuser_mutex = PTHREAD_MUTEX_INITIALIZER;
+static volatile uint32_t *kuser_src;
+static const unsigned int kuser_temps[4] = { 0x08, 0x14, 0x20, 0x320 };
+static void kuser_copier( int complet, int attendre )
+{
+    volatile uint32_t *d = (volatile uint32_t *)(zone + ZONE_KUSER), *src = kuser_src;
+    if (!src) return;
+    if (attendre) pthread_mutex_lock( &kuser_mutex );
+    else if (pthread_mutex_trylock( &kuser_mutex )) return;
+    if (complet)
+        for (unsigned int o = 0; o < 0x1000; o += 4)
+        {
+            int temps = 0;
+            for (int t = 0; t < 4; t++) if (o >= kuser_temps[t] && o < kuser_temps[t] + 12) temps = 1;
+            if (!temps) d[o / 4] = src[o / 4];
+        }
+    for (int t = 0; t < 4; t++)
+    {
+        unsigned int i = kuser_temps[t] / 4;
+        uint32_t h1, lo, h2;
+        do { h1 = __atomic_load_n( &src[i + 1], __ATOMIC_ACQUIRE ); lo = __atomic_load_n( &src[i], __ATOMIC_ACQUIRE );
+             h2 = __atomic_load_n( &src[i + 2], __ATOMIC_ACQUIRE ); } while (h1 != h2);
+        if (d[i] == lo && d[i + 1] == h1 && d[i + 2] == h1) continue;
+        __atomic_store_n( &d[i + 2], h1, __ATOMIC_RELEASE );
+        __atomic_store_n( &d[i], lo, __ATOMIC_RELEASE );
+        __atomic_store_n( &d[i + 1], h1, __ATOMIC_RELEASE );
+    }
+    pthread_mutex_unlock( &kuser_mutex );
+}
