+static BOOL copie_reecrite_voulue(void)
+{
+    if (copie_reecrite_mode < 0)
+    {
+        const char *e = getenv( "CIDRE_ILOT_VUES_PARTAGEES" );
+        copie_reecrite_mode = e && !strcmp( e, "copie" );
+    }
