+/* projette [addr, addr + size) (alignee sur la page d'hote) en copie anonyme du fichier ; virtual_mutex tenu */
+static NTSTATUS copie_reecrite_projeter( char *addr, size_t host_size, size_t size, int fd, off_t offset )
