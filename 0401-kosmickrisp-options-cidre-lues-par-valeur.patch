--- /dev/null
+++ b/src/util/cidre_env.h	2026-11-06 10:07:28
@@ -0,0 +1,23 @@
+/*
+ * Cidre (0401) : lecture des options CIDRE_* par leur valeur.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef CIDRE_ENV_H
+#define CIDRE_ENV_H
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Une option booleenne CIDRE_* est active si elle est posee, non vide et
+ * differente de « 0 ». Avant 0401, la plupart se lisaient par
+ * getenv() != NULL : VAR=0 les laissait actives (et partie_d4.sh, qui pose
+ * ${VAR:-1}, ne pouvait pas les couper). Avec VAR=1, rien ne change. */
+static inline bool
+cidre_env_actif(const char *nom)
+{
+   const char *v = getenv(nom);
+   return v != NULL && v[0] != '\0' && strcmp(v, "0") != 0;
+}
+
+#endif
