   HRESULT
   STDMETHODCALLTYPE
   GetFrameStatistics(DXGI_FRAME_STATISTICS *stats) final {
-    DEBUG("DXGISwapChain::GetFrameStatistics: stub");
+    /* cidre 0392 : SyncQPCTime restait a 0. Unity (2020.2+, vsync active) calcule son temps d'image a partir
+     * des statistiques DXGI : avec un horodatage nul, deltaTime/unscaledDeltaTime deviennent faux et la
