   template<IndexType Index>
   void ldp_q(ARMEmitter::VRegister rt, ARMEmitter::VRegister rt2, ARMEmitter::Register rn, int32_t Imm) {
     LOGMAN_THROW_A_FMT(Imm >= -1024 && Imm <= 1008 && ((Imm & 0b1111) == 0), "Unscaled offset too large");
+    if (CidreSansLdpQ) {
+      // Cidre (ilot TSO) : deux ldr q (voir CidreSansLdpQ).
+      if constexpr (Index == IndexType::OFFSET) {
+        if (Imm >= 0) {
+          ldr(rt.Q(), rn, static_cast<uint32_t>(Imm));
+          ldr(rt2.Q(), rn, static_cast<uint32_t>(Imm + 16));
+          return;
+        }
+        if (Imm >= -256) {
+          ldur(rt.Q(), rn, Imm);
+          ldur(rt2.Q(), rn, Imm + 16);
+          return;
+        }
+      } else if constexpr (Index == IndexType::POST) {
+        ldr(rt.Q(), rn, 0U);
+        ldr(rt2.Q(), rn, 16U);
+        if (Imm >= 0) {
+          add(ARMEmitter::Size::i64Bit, rn, rn, static_cast<uint32_t>(Imm));
+        } else {
+          sub(ARMEmitter::Size::i64Bit, rn, rn, static_cast<uint32_t>(-Imm));
+        }
+        return;
+      } else if constexpr (Index == IndexType::PRE) {
+        if (Imm >= 0) {
