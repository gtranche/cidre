+ * au plancher. Et s'il dit libre ailleurs une place qu'il vient de refuser,
+ * on retombe sur le pas simple.
+ */
+static void *candidat_suivant( void *base, void *end, ptrdiff_t step, void *start, size_t size )
+{
+    const size_t align_mask = (step > 0 ? step : -step) - 1;
+    char *essai = start;
 
+    while (essai >= (char *)base && essai + size <= (char *)end)
+    {
+        mach_vm_address_t adresse = (mach_vm_address_t)essai;
+        mach_vm_size_t taille = 0;
+        vm_region_basic_info_data_64_t info;
+        mach_msg_type_number_t compte = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t objet = MACH_PORT_NULL;
+
+        if (essai < (char *)plancher_hote)
+        {
+            if (step < 0) return NULL;
+            essai = ROUND_ADDR( (char *)plancher_hote + align_mask, align_mask );
+            continue;
+        }
+        /* la region qui contient l'adresse, ou a defaut la premiere au-dessus */
+        if (mach_vm_region( mach_task_self(), &adresse, &taille, VM_REGION_BASIC_INFO_64,
+                            (vm_region_info_t)&info, &compte, &objet )) break;
+        if (adresse >= (mach_vm_address_t)essai + size) break;  /* rien ici */
+        if (step > 0) essai = ROUND_ADDR( adresse + taille + align_mask, align_mask );
+        else if (adresse < size) return NULL;
+        else essai = ROUND_ADDR( adresse - size, align_mask );
+    }
+    if (essai == (char *)start) essai += step;
+    return essai;
+}
