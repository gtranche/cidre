+    id<MTLCommandBuffer> cmdbuf = (id<MTLCommandBuffer>)params->cmdbuf;
+    id<MTLFXFrameInterpolator> fi = (id<MTLFXFrameInterpolator>)params->interpolator;
+    const struct WMTFXFrameInterpolatorProps *props = params->props.ptr;
+    fi.colorTexture = (id<MTLTexture>)params->color;
+    fi.prevColorTexture = (id<MTLTexture>)params->prev_color;
+    fi.depthTexture = (id<MTLTexture>)params->depth;
+    fi.motionTexture = (id<MTLTexture>)params->motion;
+    fi.uiTexture = (id<MTLTexture>)params->ui;
+    fi.outputTexture = (id<MTLTexture>)params->output;
+    fi.fence = (id<MTLFence>)params->fence;
+    fi.motionVectorScaleX = props->motion_vector_scale_x;
+    fi.motionVectorScaleY = props->motion_vector_scale_y;
+    fi.deltaTime = props->delta_time;
+    fi.nearPlane = props->near_plane;
+    fi.farPlane = props->far_plane;
+    fi.fieldOfView = props->field_of_view;
+    fi.aspectRatio = props->aspect_ratio;
+    fi.jitterOffsetX = props->jitter_offset_x;
+    fi.jitterOffsetY = props->jitter_offset_y;
+    fi.isUITextureComposited = props->ui_composited;
