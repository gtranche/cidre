+/* Cidre (0420) : une NSError rendue par « error:&err » est autoreleased (+0) et vit
+   dans le pool du fil appelant ; cote PE, WMT::Reference<Error> la prend pour
+   possedee et la relache. Sans retain, elle etait liberee tout de suite et le pool
+   la relachait une seconde fois : sur un fil de compilation de pipelines (sans
+   pool a lui), a la fin du fil, donc a la sortie du jeu (SIGSEGV dans
+   AutoreleasePoolPage::releaseUntil, puis tous les fils suivants figes dans
+   pthread_join). Chaque ret_error est donc rendue retenue (+1). */
 static NTSTATUS
 _MTLDevice_newLibrary(void *obj) {
   struct unixcall_mtldevice_newlibrary *params = obj;
   id<MTLDevice> device = (id<MTLDevice>)params->device;
   NSError *err = NULL;
   params->ret_library = (obj_handle_t)[device newLibraryWithData:(dispatch_data_t)params->data error:&err];
-  params->ret_error = (obj_handle_t)err;
+  params->ret_error = (obj_handle_t)[err retain]; /* Cidre (0420) : WMT::Reference<Error> le relachera */
   return STATUS_SUCCESS;
 }
 
