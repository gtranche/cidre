+void
+CommandChunk::count_command() {
+  queue->CurrentFrameStatistics().command_count++;
+}
+
+void
+CommandQueue::AccumulateCounters(const FrameStatistics &frame) {
+  counters_.frames++;
+  counters_.api_calls += frame.api_call_count;
+  counters_.commands += frame.command_count;
+  counters_.getdata += frame.getdata_count;
+  counters_.getdata_pending += frame.getdata_pending_count;
+  counters_.event_stall += frame.event_stall;
+  counters_.command_buffers += frame.command_buffer_count;
+  counters_.host_copies += frame.host_copy_count;
+  if (counters_.frames % kCounterReportInterval == 0)
+    ReportCounters("periodique");
+}
+
+void
+CommandQueue::ReportCounters(const char *why) {
+  if (!counters_enabled_ || !counters_.frames)
+    return;
+  auto n = counters_.frames;
+  WARN(
+      "DXMT_COUNTERS (", why, ") ", n, " images, par image : appels D3D11=", counters_.api_calls / n,
+      " commandes=", counters_.commands / n, " GetData=", counters_.getdata / n,
+      " (en attente=", counters_.getdata_pending / n, ") flush GetData=", counters_.event_stall / n,
+      " tampons de commandes=", counters_.command_buffers / n, " copies hote (appels Unix)=",
+      counters_.host_copies / n
+  );
+}
