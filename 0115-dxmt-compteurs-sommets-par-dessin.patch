+/*
+ * Compteurs de dessins par passe de rendu (DXMT_COUNTERS=1).
+ *
+ * Pour savoir si le cout de l'etage sommets est par sommet ou par dessin, il
+ * faut, par passe (signature de l'encodeur ci-dessus, sans le nombre de
+ * dessins) : le nombre de dessins, le nombre de sommets soumis (sommets ou
+ * index x instances), leur distribution par dessin, et la part des dessins
+ * indexes, instancies, indirects, geometrie (gs) ou tessellation (ts).
+ *
+ * Tout se compte sur dxmt-encode-thr, en parcourant la liste de commandes de
+ * l'encodeur juste avant de l'encoder (deja en memoire, comme pour
+ * l'etiquette). Les dessins indirects ont leurs arguments sur le GPU : on les
+ * compte, sans sommets. Les dessins geometrie/tessellation lisent leurs
+ * arguments dans le tampon d'arguments, encore mappe a ce moment.
+ *
+ * La distribution des sommets par dessin est un histogramme en quarts d'octave
+ * (bornes 1, 1.25, 1.5, 1.75, 2, 2.5, ... : exactes en entier), d'ou l'on tire
+ * p10/p50/p90 (borne basse de la classe, donc a ~20 % pres) ; les parts < 64,
+ * < 256, < 1024 sont exactes. Une ligne de journal par passe toutes les
+ * 1000 images (DXMT_COUNTERS_INTERVAL pour changer ; tranche, pas cumul : les
+ * compteurs sont remis a zero apres chaque rapport) et a la destruction du
+ * contexte. Rien sans la variable.
+ */
+struct CompteursDessins {
+  static constexpr unsigned kClasses = 1 + 4 * 41; /* 0, puis quarts d'octave jusqu'a 2^41 */
+  uint64_t encodeurs = 0;
+  uint64_t dessins = 0;            /* toutes les commandes de dessin */
+  uint64_t directs = 0;            /* dessins dont le nombre de sommets est connu */
+  uint64_t sommets = 0;            /* somme (sommets ou index) x instances, dessins directs */
+  uint64_t sommets_par_instance = 0;
+  uint64_t instances = 0;
+  uint64_t indexes = 0;
+  uint64_t instancies = 0;         /* instance_count > 1 */
+  uint64_t indirects = 0;
+  uint64_t geometrie = 0;
+  uint64_t tessellation = 0;
+  uint64_t sous64 = 0, sous256 = 0, sous1024 = 0; /* dessins directs, sommets x instances */
+  std::array<uint64_t, kClasses> histo{};
+
+  static unsigned
+  classe(uint64_t n) {
+    if (!n)
+      return 0;
+    unsigned e = 63 - __builtin_clzll(n);
+    unsigned frac = e >= 2 ? (unsigned)((n >> (e - 2)) & 3) : (unsigned)((n << (2 - e)) & 3);
+    return std::min(1 + 4 * e + frac, kClasses - 1);
+  }
+
+  static uint64_t
+  borne_basse(unsigned classe) {
+    if (!classe)
+      return 0;
+    unsigned e = (classe - 1) / 4, frac = (classe - 1) % 4;
+    return ((uint64_t)(4 + frac) << e) >> 2;
+  }
+
+  void
+  direct(uint64_t compte, uint32_t instance_count, bool indexe, uint64_t drapeaux) {
+    uint64_t n = compte * (uint64_t)instance_count;
+    dessins++;
+    directs++;
+    sommets += n;
+    sommets_par_instance += compte;
+    instances += instance_count;
+    indexes += indexe;
+    instancies += instance_count > 1;
+    geometrie += drapeaux & 1;
+    tessellation += (drapeaux >> 1) & 1;
+    sous64 += n < 64;
+    sous256 += n < 256;
+    sous1024 += n < 1024;
+    histo[classe(n)]++;
+  }
+
+  void
+  indirect(bool indexe, uint64_t drapeaux) {
+    dessins++;
+    indirects++;
+    indexes += indexe;
+    geometrie += drapeaux & 1;
+    tessellation += (drapeaux >> 1) & 1;
+  }
+
+  void
+  autre() {
+    dessins++;
+  }
+
+  void
+  ajouter(const CompteursDessins &o) {
+    encodeurs += o.encodeurs;
+    dessins += o.dessins;
+    directs += o.directs;
+    sommets += o.sommets;
+    sommets_par_instance += o.sommets_par_instance;
+    instances += o.instances;
+    indexes += o.indexes;
+    instancies += o.instancies;
+    indirects += o.indirects;
+    geometrie += o.geometrie;
+    tessellation += o.tessellation;
+    sous64 += o.sous64;
+    sous256 += o.sous256;
+    sous1024 += o.sous1024;
+    for (unsigned i = 0; i < kClasses; i++)
+      histo[i] += o.histo[i];
+  }
+
+  /* Borne basse de la classe ou le cumul atteint la fraction p des dessins directs. */
+  uint64_t
+  percentile(double p) const {
+    if (!directs)
+      return 0;
+    uint64_t seuil = (uint64_t)(p * (double)directs), cumul = 0;
+    for (unsigned i = 0; i < kClasses; i++) {
+      cumul += histo[i];
+      if (cumul > seuil)
+        return borne_basse(i);
+    }
+    return borne_basse(kClasses - 1);
+  }
+};
+
+struct CompteursDessinsEtat {
+  uint64_t intervalle = 1000; /* DXMT_COUNTERS_INTERVAL */
+  std::map<std::string, CompteursDessins> par_passe;
+  CompteursDessins total;
+  uint64_t premiere_image = ~0ull;
+  uint64_t derniere_image = ~0ull; /* derniere image de la tranche qui a dessine */
+  uint64_t image_courante = ~0ull;
+
+  void
+  remettre_a_zero(uint64_t image) {
+    par_passe.clear();
+    total = {};
+    premiere_image = image;
+    derniere_image = image;
+  }
+
+  void
+  rapporter(const char *pourquoi) {
+    if (premiere_image == ~0ull)
+      return;
+    uint64_t images = derniere_image - premiere_image + 1;
+    WARN(
+        "DXMT_DESSINS (", pourquoi, ") tranche de ", images, " images (", premiere_image, "-", derniere_image,
+        "), par image : encodeurs de rendu=", total.encodeurs / images, " dessins=", total.dessins / images,
+        " sommets=", total.sommets / images, " (sommets/dessin direct=",
+        total.directs ? total.sommets / total.directs : 0, ")"
+    );
+    std::vector<std::pair<const std::string *, const CompteursDessins *>> lignes;
+    for (auto &[signature, c] : par_passe)
+      lignes.emplace_back(&signature, &c);
+    std::sort(lignes.begin(), lignes.end(), [](auto &a, auto &b) { return a.second->sommets > b.second->sommets; });
+    for (auto &[signature, c] : lignes) {
+      auto pct = [&](uint64_t n, uint64_t d) { return d ? (unsigned)((100 * n + d / 2) / d) : 0u; };
+      WARN(
+          "DXMT_DESSINS   ", *signature, " | enc/img=", c->encodeurs / images, " dessins/img=", c->dessins / images,
+          " sommets/img=", c->sommets / images, " | sommets/dessin p10=", c->percentile(0.10), " p50=",
+          c->percentile(0.50), " p90=", c->percentile(0.90), " moy=", c->directs ? c->sommets / c->directs : 0,
+          " <64=", pct(c->sous64, c->directs), "% <256=", pct(c->sous256, c->directs), "% <1024=",
+          pct(c->sous1024, c->directs), "% | indexes=", pct(c->indexes, c->dessins), "% instancies=",
+          pct(c->instancies, c->dessins), "% (inst/dessin=", c->directs ? c->instances / c->directs : 0,
+          " sommets/instance=", c->directs ? c->sommets_par_instance / c->directs : 0,
+          ") indirects=", pct(c->indirects, c->dessins), "% gs=", pct(c->geometrie, c->dessins), "% ts=",
+          pct(c->tessellation, c->dessins), "%"
+      );
+    }
+  }
+
+  /* Appele a chaque flush avec le numero d'image du chunk (fil d'encodage). */
+  void
+  image(uint64_t image) {
+    if (image == image_courante)
+      return;
+    image_courante = image;
+    if (premiere_image == ~0ull) {
+      premiere_image = image;
+      derniere_image = image;
+      return;
+    }
+    if (image - premiere_image >= intervalle) {
+      /* les dessins accumules appartiennent tous aux images < image */
+      derniere_image = image - 1;
+      rapporter("periodique");
+      remettre_a_zero(image);
+    }
+  }
+
+  /* Une image sans encodeur de rendu en fin de tranche (le flush d'apres le
+     dernier Present) n'allonge pas la tranche. */
+  void
+  accumuler(std::string signature, const CompteursDessins &c) {
+    derniere_image = image_courante;
+    par_passe[std::move(signature)].ajouter(c);
+    total.ajouter(c);
+  }
+};
