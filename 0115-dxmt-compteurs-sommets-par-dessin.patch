+/* Miroirs de DXMT_DRAW_ARGUMENTS / DXMT_DRAW_INDEXED_ARGUMENTS (d3d11_context_impl.cpp),
+   tels que les dessins geometrie/tessellation les ecrivent dans le tampon d'arguments. */
+struct ArgumentsDessin {
+  uint32_t VertexCount, InstanceCount, StartVertex, StartInstance;
+};
+struct ArgumentsDessinIndexe {
+  uint32_t IndexCount, InstanceCount, StartIndex;
+  int32_t BaseVertex;
+  uint32_t StartInstance;
+};
+
+CompteursDessins
+compter_dessins(RenderEncoderData *data) {
+  CompteursDessins c;
+  c.encodeurs = 1;
+  auto arguments = [&](uint64_t offset_final) {
+    return (const char *)data->allocated_argbuf_mapping + (offset_final - data->allocated_argbuf_offset);
+  };
+  for (auto cmd = (wmtcmd_base *)data->cmd_head.next.get(); cmd; cmd = (wmtcmd_base *)cmd->next.get()) {
+    switch (cmd->type) {
+    case WMTRenderCommandDraw: {
+      auto d = (wmtcmd_render_draw *)cmd;
+      c.direct(d->vertex_count, d->instance_count, false, 0);
+      break;
+    }
+    case WMTRenderCommandDrawIndexed: {
+      auto d = (wmtcmd_render_draw_indexed *)cmd;
+      c.direct(d->index_count, d->instance_count, true, 0);
+      break;
+    }
+    case WMTRenderCommandDrawIndirect: c.indirect(false, 0); break;
+    case WMTRenderCommandDrawIndexedIndirect: c.indirect(true, 0); break;
+    case WMTRenderCommandDXMTGeometryDraw: {
+      auto d = (wmtcmd_render_dxmt_geometry_draw *)cmd;
+      auto a = (const ArgumentsDessin *)arguments(d->draw_arguments_offset);
+      c.direct(a->VertexCount, d->instance_count, false, 1);
+      break;
+    }
+    case WMTRenderCommandDXMTGeometryDrawIndexed: {
+      auto d = (wmtcmd_render_dxmt_geometry_draw_indexed *)cmd;
+      auto a = (const ArgumentsDessinIndexe *)arguments(d->draw_arguments_offset);
+      c.direct(a->IndexCount, d->instance_count, true, 1);
+      break;
+    }
+    case WMTRenderCommandDXMTGeometryDrawIndirect: c.indirect(false, 1); break;
+    case WMTRenderCommandDXMTGeometryDrawIndexedIndirect: c.indirect(true, 1); break;
+    case WMTRenderCommandDXMTTessellationMeshDraw: {
+      auto d = (wmtcmd_render_dxmt_tessellation_mesh_draw *)cmd;
+      auto a = (const ArgumentsDessin *)arguments(d->draw_arguments_offset);
+      c.direct(a->VertexCount, d->instance_count, false, 2);
+      break;
+    }
+    case WMTRenderCommandDXMTTessellationMeshDrawIndexed: {
+      auto d = (wmtcmd_render_dxmt_tessellation_mesh_draw_indexed *)cmd;
+      auto a = (const ArgumentsDessinIndexe *)arguments(d->draw_arguments_offset);
+      c.direct(a->IndexCount, d->instance_count, true, 2);
+      break;
+    }
+    case WMTRenderCommandDXMTTessellationMeshDrawIndirect: c.indirect(false, 2); break;
+    case WMTRenderCommandDXMTTessellationMeshDrawIndexedIndirect: c.indirect(true, 2); break;
+    case WMTRenderCommandDrawMeshThreadgroups:
+    case WMTRenderCommandDrawMeshThreadgroupsIndirect: c.autre(); break;
+    default: break;
+    }
+  }
+  return c;
+}
