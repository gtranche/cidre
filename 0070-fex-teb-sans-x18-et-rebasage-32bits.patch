+ARMEmitter::Register Arm64JITCore::RebaseGuestLow(ARMEmitter::Register Base) {
+  if (!FEXCore::IR::Guest64LowBase) {
+    return Base;
+  }
+  /*
+   * Sans branche ET sans toucher aux flags NZCV -- FEX y garde les flags x86
+   * entre operations, donc un csel/cmp ici les corromprait. On fabrique un
+   * masque tout-a-un / tout-a-zero par l'arithmetique :
+   *   hi     = Base >> 32                       (0 si adresse basse)
+   *   masque = asr(hi - 1, 63)                  (-1 si hi==0, 0 sinon)
+   *   ajout  = masque & Guest64LowBase          (base si bas, 0 sinon)
+   *   res    = Base | ajout
+   * Guest64LowBase est un seul bit (32 Gio) : immediats AND/ORR encodables, et
+   * « | » vaut « + » faute de chevauchement.
+   */
+  lsr(ARMEmitter::Size::i64Bit, TMP3, Base, 32);
+  sub(ARMEmitter::Size::i64Bit, TMP3, TMP3, 1);
+  asr(ARMEmitter::Size::i64Bit, TMP3, TMP3, 63);
+  and_(ARMEmitter::Size::i64Bit, TMP3, TMP3, FEXCore::IR::Guest64LowBase);
+  orr(ARMEmitter::Size::i64Bit, TMP4, Base, TMP3);
+  return TMP4;
+}
