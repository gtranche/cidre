--- a/Source/Windows/Common/CallRetStack.h
+++ b/Source/Windows/Common/CallRetStack.h
@@ -13,41 +13,136 @@ struct CallRetStackInfo {
   uint64_t DefaultLocation;
 };
 
+/*
+ * Taille des pages de garde qui encadrent la pile d'appels.
+ *
+ * FEX_PAGE_SIZE vaut 4 Kio, la page du x86. L'hote, lui, arme des pages de
+ * 16 Kio sur Apple Silicon : engager le milieu de la reservation rend
+ * accessibles les deux gardes de 4 Kio qui l'entourent, parce qu'elles
+ * partagent sa page materielle. La comptabilite de Wine continue de les
+ * annoncer reservees et sans acces -- et c'est ce qui trompe -- mais
+ * l'ecriture passe (tests/garde64.c le montre en sept lignes).
+ *
+ * Une garde plus petite que la page de l'hote ne garde donc rien : le pointeur
+ * de pile d'appels la traverse sans faute, sort de la reservation, et la faute
+ * ne tombe qu'un megaoctet plus bas -- hors des bornes que HandleAccessViolation
+ * reconnait, donc rendue a l'invite, ou son gestionnaire refaute sans avancer.
+ *
+ * On prend la granularite d'allocation de Windows, 64 Kio : multiple de toute
+ * taille de page plausible, et le milieu reste aligne dessus, donc l'engagement
+ * ne peut plus deborder sur les gardes.
+ */
+constexpr uint64_t TAILLE_GARDE = 0x10000;
+
 CallRetStackInfo GetInfoThread(FEXCore::Core::InternalThreadState* Thread) {
   uint64_t Base = reinterpret_cast<uint64_t>(Thread->CallRetStackBase);
   // Leave some room from the base for the default location to allow for underflows without constant exceptions
-  return {Base - FEXCore::Utils::FEX_PAGE_SIZE, Base + FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE + FEXCore::Utils::FEX_PAGE_SIZE,
+  return {Base - TAILLE_GARDE, Base + FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE + TAILLE_GARDE,
           Base + FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE / 4};
 }
 
+#ifdef SONDE_FAUTE_INVITE
+/*
+ * Ecrire pendant la course la change : une sonde bavarde fait disparaitre le
+ * symptome -- cinq executions propres avec les traces, quatre sur quatre sans.
+ * On enregistre donc en silence dans un anneau, et on ne parle qu'une fois,
+ * quand le pointeur est sorti de ses bornes : l'instant qui interesse.
+ */
+struct Evenement {
+  uint32_t Fil;
+  const char* Quoi;
+  uint64_t Adresse;
+  uint64_t Sp;
+  uint64_t Base;
+};
+
+constexpr size_t TAILLE_ANNEAU = 256;
+inline Evenement Anneau[TAILLE_ANNEAU] {};
+inline std::atomic<uint32_t> Curseur {0};
+inline std::atomic<bool> DejaVide {false};
+
+inline void Noter(const char* Quoi, uint64_t Adresse, uint64_t Sp, uint64_t Base) {
+  const uint32_t I = Curseur.fetch_add(1, std::memory_order_relaxed) % TAILLE_ANNEAU;
+  Anneau[I] = {GetCurrentThreadId(), Quoi, Adresse, Sp, Base};
+}
+
+inline void Vider(const char* Cause) {
+  if (DejaVide.exchange(true)) {
+    return;
+  }
+  const uint32_t Fin = Curseur.load(std::memory_order_relaxed);
+  const uint32_t Debut = Fin > TAILLE_ANNEAU ? Fin - TAILLE_ANNEAU : 0;
+  LogMan::Msg::EFmt("SONDE anneau ({}) : {} evenements", Cause, Fin - Debut);
+  for (uint32_t N = Debut; N < Fin; ++N) {
+    const auto& E = Anneau[N % TAILLE_ANNEAU];
+    LogMan::Msg::EFmt("  [{}] fil {:#x} {} adresse {:#x} sp {:#x} base {:#x} ecart_sp {}{:#x}", N, E.Fil,
+                      E.Quoi ? E.Quoi : "?", E.Adresse, E.Sp, E.Base, E.Sp < E.Base ? "-" : "+",
+                      E.Sp < E.Base ? E.Base - E.Sp : E.Sp - E.Base);
+  }
+}
+#endif
+
