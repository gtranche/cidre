+   if (shader->info.stage == MESA_SHADER_FRAGMENT && getenv("CIDRE_TEX_STATS")) {
+      unsigned tex_handles = 0, samples = 0;
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_tex) {
