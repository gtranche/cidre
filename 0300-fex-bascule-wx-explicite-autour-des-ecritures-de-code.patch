+// SPDX-License-Identifier: MIT
+#pragma once
+// Cidre 0300 : bascule W^X explicite du fil autour des ecritures de code (macOS, pages MAP_JIT).
+//
+// Le tampon de code de FEX est une projection MAP_JIT : le materiel (APRR/SPRR) n'y laisse a chaque fil que l'ecriture
+// OU l'execution. Sans bascule explicite, chaque compilation coute deux fautes : la premiere ecriture (fil en mode
+// execution) fait faute et Wine passe le fil en ecriture (virtual_handle_fault), puis la premiere execution du code fait
+// faute et Wine le repasse en execution par son tremplin (wx_tremplin) -- quelques microsecondes chacune, plus que la
+// compilation d'un petit bloc. Ici, FEX bascule lui-meme le fil comme pthread_jit_write_protect_np : valeur lue dans la
+// page commune de macOS, ecrite dans le registre de permissions du fil (instruction de l'EL0, comme le fait la libc),
+// puis isb. Les fautes restent le filet : une ecriture ou une execution hors des zones encadrees se rattrape comme avant.
+//
+// Activation par le frontal (Windows sous Wine, hote Darwin, page commune reconnue, CIDRE_WX_DIRECT different de 0).
+#include <cstdint>
+
+namespace FEXCore::CidreWX {
+struct Etat {
+  uint8_t Genre {};       // 0 : inactif ; 1 : APRR (S3_4_C15_C2_7) ; 2, 3 : SPRR (S3_6_C15_C1_5)
+  uint64_t Ecriture {};   // valeur du registre pour ecrire le code
+  uint64_t Execution {};  // valeur du registre pour l'executer
+};
+inline Etat Global {};
+
+inline void Poser(uint64_t V) {
+#if defined(__aarch64__) || defined(_M_ARM64) || defined(_M_ARM64EC) || defined(__arm64ec__)
+  if (Global.Genre == 1) {
+    __asm__ volatile("msr S3_4_C15_C2_7, %0\n\tisb" ::"r"(V) : "memory");
+  } else {
+    __asm__ volatile("msr S3_6_C15_C1_5, %0\n\tisb" ::"r"(V) : "memory");
+  }
+#else
+  (void)V;
+#endif
+}
+
+// Encadre une ecriture dans le tampon de code ; Profondeur est un compteur du fil (imbrication : seule la sortie la plus
+// externe repasse en execution, juste avant de rendre la main au code JIT).
+class Ecriture {
+  uint32_t* Profondeur;
+
+public:
+  explicit Ecriture(uint32_t* P)
+    : Profondeur(Global.Genre ? P : nullptr) {
+    if (Profondeur && (*Profondeur)++ == 0) {
+      Poser(Global.Ecriture);
+    }
+  }
+  ~Ecriture() {
+    if (Profondeur && --*Profondeur == 0) {
+      Poser(Global.Execution);
+    }
+  }
+  Ecriture(const Ecriture&) = delete;
+  Ecriture& operator=(const Ecriture&) = delete;
+};
+} // namespace FEXCore::CidreWX
