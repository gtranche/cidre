+ * invisible, recouverte, mais WindowServer composait chaque image (code de
+ * detachement 0x70017/0xa0017 au lieu de 0, M1 Max, macOS 26, 2026-10-18).
+ * Quand une vue Metal visible ou une couche hebergee couvre toute la vue de
+ * contenu, on ne pose plus cette image. CIDRE_DIRECT_GDI=1 rend l'ancien
+ * comportement. */
+static BOOL cidre_direct_keep_gdi(void)
+{
+    static BOOL keep;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        const char* v = getenv("CIDRE_DIRECT_GDI");
+        keep = v && *v == '1';
