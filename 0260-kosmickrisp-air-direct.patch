+static void
+kk_air_local_write_bytes(const char *dir, NSString *key, const void *air, size_t air_size)
+{
+   NSString *base = [[NSString stringWithUTF8String:dir] stringByAppendingPathComponent:@"air"];
+   NSString *path = [base stringByAppendingPathComponent:[key stringByAppendingString:@".metallib"]];
+   NSFileManager *fm = [NSFileManager defaultManager];
+   if ([fm fileExistsAtPath:path])
+      return;
+   [fm createDirectoryAtPath:base withIntermediateDirectories:YES attributes:nil error:NULL];
+   NSString *tmp = [path stringByAppendingFormat:@".%d.%p.tmp", (int)getpid(), (void *)pthread_self()];
+   NSData *data = [NSData dataWithBytesNoCopy:(void *)air length:air_size freeWhenDone:NO];
+   if ([data writeToFile:tmp atomically:NO] &&
+       rename(tmp.fileSystemRepresentation, path.fileSystemRepresentation) == 0)
+      atomic_fetch_add(&kk_stat_lib_air_written, 1);
+   else
+      unlink(tmp.fileSystemRepresentation);
+}
