+libmsl_air = static_library(
+    'msl_air',
+    ['nir_to_air.cpp'],
+    dependencies : [idep_nir, idep_mesautil],
+    cpp_args : ['-isystem', air_llvm_dir + '/include', '-fno-rtti', '-fno-exceptions',
+                '-D__STDC_CONSTANT_MACROS', '-D__STDC_FORMAT_MACROS', '-D__STDC_LIMIT_MACROS',
+                '-Wno-c99-designator', '-Wno-unused-parameter'],
