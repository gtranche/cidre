index 0000000..bfe5f60
--- /dev/null
+++ b/src/kosmickrisp/compiler/nir_to_air_emit.inc
@@ -0,0 +1,704 @@
+/*
+ * Copyright 2026 Cidre
+ * SPDX-License-Identifier: MIT
+ */
+
+namespace {
+
+/* Values ------------------------------------------------------------------- */
+
+static bool is_handle_def(air_ctx &c, nir_def *def);
+
+static Type *
+handle_type_of(air_ctx &c, nir_def *def);
+
+static Value *
+get_src(air_ctx &c, nir_src *src)
+{
+   nir_def *d = src->ssa;
+   nir_instr *pi = nir_def_instr(d);
+   if (pi->type == nir_instr_type_load_const) {
+      nir_load_const_instr *lc = nir_instr_as_load_const(pi);
+      Type *et = c.int_ty(d->bit_size);
+      std::vector<Constant *> v;
+      for (unsigned i = 0; i < d->num_components; i++) {
+         uint64_t x = nir_const_value_as_uint(lc->value[i], d->bit_size);
+         v.push_back(ConstantInt::get(et, x));
+      }
+      if (d->num_components == 1)
+         return v[0];
+      return ConstantVector::get(v);
+   }
+   if (pi->type == nir_instr_type_undef) {
+      if (is_handle_def(c, d))
+         return Constant::getNullValue(handle_type_of(c, d));
+      return Constant::getNullValue(c.def_ty(d->bit_size, d->num_components));
+   }
+   Value *v = c.defs[d->index];
+   if (!v) {
+      c.fail("use before def");
+      return Constant::getNullValue(c.def_ty(d->bit_size, d->num_components));
+   }
+   return v;
+}
+
+static void
+set_def(air_ctx &c, nir_def *def, Value *v)
+{
+   c.defs[def->index] = v;
+}
+
+static Value *
+extract(air_ctx &c, Value *v, unsigned i)
+{
+   if (!v->getType()->isVectorTy())
+      return v;
+   return c.B.CreateExtractElement(v, (uint64_t)i);
+}
+
+static Value *
+build_vec(air_ctx &c, ArrayRef<Value *> comps)
+{
+   if (comps.size() == 1)
+      return comps[0];
+   Type *t = FixedVectorType::get(comps[0]->getType(), comps.size());
+   Value *r = UndefValue::get(t);
+   for (unsigned i = 0; i < comps.size(); i++)
+      r = c.B.CreateInsertElement(r, comps[i], (uint64_t)i);
+   return r;
+}
+
+static Value *
+first_n(air_ctx &c, Value *v, unsigned n)
+{
+   auto *vt = dyn_cast<FixedVectorType>(v->getType());
+   if (!vt) {
+      if (n == 1)
+         return v;
+      std::vector<Value *> cs(n, v);
+      return build_vec(c, cs);
+   }
+   if (vt->getNumElements() == n)
+      return v;
+   if (n == 1)
+      return c.B.CreateExtractElement(v, (uint64_t)0);
+   std::vector<int> mask;
+   for (unsigned i = 0; i < n; i++)
+      mask.push_back(i < vt->getNumElements() ? i : 0);
+   return c.B.CreateShuffleVector(v, v, mask);
+}
+
+static Value *
+pad_vec(air_ctx &c, Value *v, unsigned n, Value *fill)
+{
+   std::vector<Value *> cs;
+   unsigned have = 1;
+   if (auto *vt = dyn_cast<FixedVectorType>(v->getType()))
+      have = vt->getNumElements();
+   for (unsigned i = 0; i < n; i++)
+      cs.push_back(i < have ? extract(c, v, i) : fill);
+   return build_vec(c, cs);
+}
+
+static Value *
+to_float(air_ctx &c, Value *v)
+{
+   Type *t = v->getType();
+   Type *e = t->getScalarType();
+   if (e->isFloatingPointTy())
+      return v;
+   Type *fe = c.flt_scalar(e->getIntegerBitWidth());
+   Type *ft = t->isVectorTy() ? (Type *)FixedVectorType::get(fe, cast<FixedVectorType>(t)->getNumElements()) : fe;
+   return c.B.CreateBitCast(v, ft);
+}
+
+static Value *
+to_int(air_ctx &c, Value *v)
+{
+   Type *t = v->getType();
+   Type *e = t->getScalarType();
+   if (e->isIntegerTy())
+      return v;
+   Type *ie = c.int_ty(e->getPrimitiveSizeInBits());
+   Type *it = t->isVectorTy() ? (Type *)FixedVectorType::get(ie, cast<FixedVectorType>(t)->getNumElements()) : ie;
+   return c.B.CreateBitCast(v, it);
+}
+
+static Value *
+alu_src(air_ctx &c, nir_alu_instr *alu, unsigned i, unsigned n)
+{
+   Value *v = get_src(c, &alu->src[i].src);
+   unsigned sn = alu->src[i].src.ssa->num_components;
+   if (n == 1) {
+      if (sn == 1)
+         return v;
+      return c.B.CreateExtractElement(v, (uint64_t)alu->src[i].swizzle[0]);
+   }
+   bool ident = sn == n;
+   for (unsigned k = 0; k < n && ident; k++)
+      ident = alu->src[i].swizzle[k] == k;
+   if (ident)
+      return v;
+   std::vector<Value *> cs;
+   for (unsigned k = 0; k < n; k++)
+      cs.push_back(sn == 1 ? v : c.B.CreateExtractElement(v, (uint64_t)alu->src[i].swizzle[k]));
+   return build_vec(c, cs);
+}
+
+/* Handles ------------------------------------------------------------------ */
+
+static const char *
+tex_dim_stem(enum glsl_sampler_dim dim, bool array, bool depth, bool *okp)
+{
+   *okp = true;
+   if (depth) {
+      switch (dim) {
+      case GLSL_SAMPLER_DIM_2D: return array ? "depth_2d_array" : "depth_2d";
+      case GLSL_SAMPLER_DIM_CUBE: return array ? "depth_cube_array" : "depth_cube";
+      case GLSL_SAMPLER_DIM_MS: return array ? "depth_2d_ms_array" : "depth_2d_ms";
+      default: *okp = false; return "";
+      }
+   }
+   switch (dim) {
+   case GLSL_SAMPLER_DIM_1D: return array ? "texture_1d_array" : "texture_1d";
+   case GLSL_SAMPLER_DIM_2D: return array ? "texture_2d_array" : "texture_2d";
+   case GLSL_SAMPLER_DIM_3D: return array ? (*okp = false, "") : "texture_3d";
+   case GLSL_SAMPLER_DIM_CUBE: return array ? "texture_cube_array" : "texture_cube";
+   case GLSL_SAMPLER_DIM_MS: return array ? "texture_2d_ms_array" : "texture_2d_ms";
+   case GLSL_SAMPLER_DIM_BUF: return array ? (*okp = false, "") : "texture_buffer_1d";
+   default: *okp = false; return "";
+   }
+}
+
+static PointerType *
+tex_ptr_type(air_ctx &c, const std::string &stem)
+{
+   std::string name = "struct._" + stem + "_t";
+   StructType *st = StructType::getTypeByName(c.C, name);
+   if (!st)
+      st = StructType::create(c.C, name);
+   return PointerType::get(st, 1);
+}
+
+static nir_intrinsic_instr *
+find_handle_source(air_ctx &c, nir_def *def, std::set<nir_def *> &seen)
+{
+   if (!seen.insert(def).second)
+      return nullptr;
+   nir_instr *in = nir_def_instr(def);
+   if (in->type == nir_instr_type_intrinsic) {
+      nir_intrinsic_instr *ii = nir_instr_as_intrinsic(in);
+      if (ii->intrinsic == nir_intrinsic_load_texture_handle_kk ||
+          ii->intrinsic == nir_intrinsic_load_depth_texture_kk ||
+          ii->intrinsic == nir_intrinsic_load_sampler_handle_kk)
+         return ii;
+      return nullptr;
+   }
+   if (in->type == nir_instr_type_alu) {
+      nir_alu_instr *alu = nir_instr_as_alu(in);
+      if (alu->op == nir_op_mov)
+         return find_handle_source(c, alu->src[0].src.ssa, seen);
+      if (alu->op == nir_op_bcsel) {
+         nir_intrinsic_instr *r = find_handle_source(c, alu->src[1].src.ssa, seen);
+         return r ? r : find_handle_source(c, alu->src[2].src.ssa, seen);
+      }
+      return nullptr;
+   }
+   if (in->type == nir_instr_type_phi) {
+      nir_phi_instr *phi = nir_instr_as_phi(in);
+      nir_foreach_phi_src(ps, phi) {
+         nir_intrinsic_instr *r = find_handle_source(c, ps->src.ssa, seen);
+         if (r)
+            return r;
+      }
+   }
+   return nullptr;
+}
+
+static bool
+is_handle_def(air_ctx &c, nir_def *def)
+{
+   auto it = c.handle_memo.find(def);
+   if (it != c.handle_memo.end())
+      return it->second;
+   std::set<nir_def *> seen;
+   bool r = find_handle_source(c, def, seen) != nullptr;
+   c.handle_memo[def] = r;
+   return r;
+}
+
+static bool
+handle_info(air_ctx &c, nir_def *def, tex_info &ti)
+{
+   std::set<nir_def *> seen;
+   nir_intrinsic_instr *ii = find_handle_source(c, def, seen);
+   if (!ii)
+      return false;
+   if (ii->intrinsic == nir_intrinsic_load_sampler_handle_kk)
+      return false;
+   bool depth = ii->intrinsic == nir_intrinsic_load_depth_texture_kk;
+   ti.dim = nir_intrinsic_image_dim(ii);
+   ti.array = nir_intrinsic_image_array(ii);
+   ti.depth = depth;
+   bool okp;
+   ti.stem = tex_dim_stem(ti.dim, ti.array, depth, &okp);
+   if (!okp)
+      return false;
+   if (depth) {
+      ti.type = nir_type_float32;
+      ti.access = 0;
+      ti.coherent = false;
+   } else {
+      ti.type = nir_intrinsic_dest_type(ii);
+      ti.access = nir_intrinsic_flags(ii);
+      ti.coherent = (nir_intrinsic_access(ii) & ACCESS_COHERENT) ||
+                    ti.access == MSL_ACCESS_READ_WRITE;
+   }
+   return true;
+}
+
+static Type *
+handle_type_of(air_ctx &c, nir_def *def)
+{
+   std::set<nir_def *> seen;
+   nir_intrinsic_instr *ii = find_handle_source(c, def, seen);
+   if (!ii) {
+      c.fail("handle type");
+      return c.t_sampler_ptr;
+   }
+   if (ii->intrinsic == nir_intrinsic_load_sampler_handle_kk)
+      return c.t_sampler_ptr;
+   tex_info ti;
+   if (!handle_info(c, def, ti)) {
+      c.fail("texture kind");
+      return c.t_sampler_ptr;
+   }
+   return tex_ptr_type(c, ti.stem);
+}
+
+/* ALU ---------------------------------------------------------------------- */
+
+static bool
+alu_needs_safe(air_ctx &c, nir_alu_instr *alu, unsigned *ctrl_out)
+{
+   unsigned ctrl = alu->fp_math_ctrl;
+   if (alu->op == nir_op_bcsel) {
+      for (unsigned i = 0; i < 3; i++) {
+         nir_instr *p = nir_def_instr(alu->src[i].src.ssa);
+         if (p->type == nir_instr_type_alu)
+            ctrl |= nir_instr_as_alu(p)->fp_math_ctrl;
+      }
+   }
+   *ctrl_out = ctrl;
+   return false;
+}
+
+static enum fp_mode
+alu_fp_mode(air_ctx &c, nir_alu_instr *alu)
+{
+   unsigned ctrl;
+   alu_needs_safe(c, alu, &ctrl);
+   if (!(c.wa & BITFIELD64_BIT(14))) {
+      bool mm = (alu->op == nir_op_fmin || alu->op == nir_op_fmax) &&
+                (ctrl & nir_fp_preserve_signed_zero);
+      if (mm || nir_alu_instr_is_comparison(alu))
+         return FP_SAFE;
+   }
+   if (ctrl & (nir_fp_no_contract | nir_fp_no_reassoc))
+      return FP_SAFE;
+   if (ctrl & (nir_fp_preserve_inf | nir_fp_preserve_nan | nir_fp_preserve_signed_zero))
+      return FP_RELAXED;
+   return FP_FAST;
+}
+
+static FastMathFlags
+fmf_for(enum fp_mode m)
+{
+   FastMathFlags f;
+   if (m == FP_FAST) {
+      f.setFast();
+   } else if (m == FP_RELAXED) {
+      f.setAllowReassoc();
+      f.setNoSignedZeros();
+      f.setAllowReciprocal();
+      f.setAllowContract();
+      f.setApproxFunc();
+   }
+   return f;
+}
+
+static std::string
+fsuffix(Type *t)
+{
+   Type *e = t->getScalarType();
+   std::string s;
+   if (auto *vt = dyn_cast<FixedVectorType>(t))
+      s = "v" + std::to_string(vt->getNumElements());
+   return s + (e->isHalfTy() ? "f16" : "f32");
+}
+
+static std::string
+isuffix(Type *t, bool sign)
+{
+   Type *e = t->getScalarType();
+   std::string s = sign ? "s." : "u.";
+   if (auto *vt = dyn_cast<FixedVectorType>(t))
+      s += "v" + std::to_string(vt->getNumElements());
+   return s + "i" + std::to_string(e->getIntegerBitWidth());
+}
+
+static std::string
+isuffix_nosign(Type *t)
+{
+   Type *e = t->getScalarType();
+   std::string s;
+   if (auto *vt = dyn_cast<FixedVectorType>(t))
+      s += "v" + std::to_string(vt->getNumElements());
+   return s + "i" + std::to_string(e->getIntegerBitWidth());
+}
+
+static bool
+alu_precise(nir_alu_instr *alu)
+{
+   return alu->def.bit_size == 32 &&
+          (nir_alu_instr_is_inf_preserve(alu) || nir_alu_instr_is_nan_preserve(alu));
+}
+
+static Value *
+fmath1(air_ctx &c, const char *name, bool has_fast, bool precise, Value *x)
+{
+   std::string n = "air.";
+   bool f32 = x->getType()->getScalarType()->isFloatTy();
+   if (has_fast && f32 && !precise)
+      n += "fast_";
+   n += name;
+   n += "." + fsuffix(x->getType());
+   return c.call(n, x->getType(), {x}, A_PURE, true);
+}
+
+static Value *
+fmath2(air_ctx &c, const char *name, bool has_fast, bool precise, Value *x, Value *y)
+{
+   std::string n = "air.";
+   bool f32 = x->getType()->getScalarType()->isFloatTy();
+   if (has_fast && f32 && !precise)
+      n += "fast_";
+   n += name;
+   n += "." + fsuffix(x->getType());
+   return c.call(n, x->getType(), {x, y}, A_PURE, true);
+}
+
+static Value *
+convert(air_ctx &c, Value *v, Type *dst_elem, bool dst_float, bool dst_signed,
+        bool src_float, bool src_signed)
+{
+   Type *st = v->getType();
+   unsigned n = st->isVectorTy() ? cast<FixedVectorType>(st)->getNumElements() : 1;
+   Type *dt = c.vec_ty(dst_elem, n);
+   auto part = [&](Type *t, bool fl, bool sg) {
+      std::string p = fl ? "f." : (sg ? "s." : "u.");
+      if (n > 1)
+         p += "v" + std::to_string(n);
+      Type *e = t->getScalarType();
+      if (fl)
+         p += e->isHalfTy() ? "f16" : "f32";
+      else
+         p += "i" + std::to_string(e->getIntegerBitWidth());
+      return p;
+   };
+   std::string name = "air.convert." + part(dt, dst_float, dst_signed) + "." +
+                      part(st, src_float, src_signed);
+   return c.call(name, dt, {v}, A_PURE, dst_float);
+}
+
+static Value *
+emit_alu_op(air_ctx &c, nir_alu_instr *alu)
+{
+   unsigned n = alu->def.num_components;
+   unsigned bits = alu->def.bit_size;
+   const nir_op_info *info = &nir_op_infos[alu->op];
+   std::vector<Value *> s;
+   for (unsigned i = 0; i < info->num_inputs; i++)
+      s.push_back(alu_src(c, alu, i, nir_ssa_alu_instr_src_components(alu, i)));
+   IRBuilder<> &B = c.B;
+   Type *dty = c.def_ty(bits, n);
+   bool prec = alu_precise(alu);
+
+   auto F = [&](unsigned i) { return to_float(c, s[i]); };
+   auto I = [&](Value *v) { return to_int(c, v); };
+   auto shamt = [&](Value *a, Value *b) {
+      Type *t = a->getType();
+      unsigned w = t->getScalarSizeInBits();
+      b = B.CreateZExtOrTrunc(b, t);
+      return B.CreateAnd(b, ConstantInt::get(t, w - 1));
+   };
+   auto fconst = [&](Type *t, double v) { return ConstantFP::get(t, v); };
+
+   switch (alu->op) {
+   case nir_op_mov:
+      return s[0];
+   case nir_op_vec2:
+   case nir_op_vec3:
+   case nir_op_vec4: {
+      std::vector<Value *> cs(s.begin(), s.end());
+      return build_vec(c, cs);
+   }
+   case nir_op_iadd: return B.CreateAdd(s[0], s[1]);
+   case nir_op_isub: return B.CreateSub(s[0], s[1]);
+   case nir_op_imul: return B.CreateMul(s[0], s[1]);
+   case nir_op_idiv: return B.CreateSDiv(s[0], s[1]);
+   case nir_op_udiv: return B.CreateUDiv(s[0], s[1]);
+   case nir_op_irem:
+   case nir_op_imod: return B.CreateSRem(s[0], s[1]);
+   case nir_op_umod: return B.CreateURem(s[0], s[1]);
+   case nir_op_ishl: return B.CreateShl(s[0], shamt(s[0], s[1]));
+   case nir_op_ishr: return B.CreateAShr(s[0], shamt(s[0], s[1]));
+   case nir_op_ushr: return B.CreateLShr(s[0], shamt(s[0], s[1]));
+   case nir_op_iand: return B.CreateAnd(s[0], s[1]);
+   case nir_op_ior: return B.CreateOr(s[0], s[1]);
+   case nir_op_ixor: return B.CreateXor(s[0], s[1]);
+   case nir_op_inot: return B.CreateNot(s[0]);
+   case nir_op_ineg: return B.CreateNeg(s[0]);
+   case nir_op_ieq: return B.CreateICmpEQ(s[0], s[1]);
+   case nir_op_ine: return B.CreateICmpNE(s[0], s[1]);
+   case nir_op_ilt: return B.CreateICmpSLT(s[0], s[1]);
+   case nir_op_ige: return B.CreateICmpSGE(s[0], s[1]);
+   case nir_op_ult: return B.CreateICmpULT(s[0], s[1]);
+   case nir_op_uge: return B.CreateICmpUGE(s[0], s[1]);
+   case nir_op_imin: return B.CreateSelect(B.CreateICmpSLT(s[0], s[1]), s[0], s[1]);
+   case nir_op_imax: return B.CreateSelect(B.CreateICmpSGT(s[0], s[1]), s[0], s[1]);
+   case nir_op_umin: return B.CreateSelect(B.CreateICmpULT(s[0], s[1]), s[0], s[1]);
+   case nir_op_umax: return B.CreateSelect(B.CreateICmpUGT(s[0], s[1]), s[0], s[1]);
+   case nir_op_iabs: return B.CreateSelect(B.CreateICmpSLT(s[0], Constant::getNullValue(dty)), B.CreateNeg(s[0]), s[0]);
+   case nir_op_isign: {
+      Value *z = Constant::getNullValue(dty);
+      Value *neg = B.CreateSelect(B.CreateICmpSLT(s[0], z), Constant::getAllOnesValue(dty), ConstantInt::get(dty, 1));
+      return B.CreateSelect(B.CreateICmpEQ(s[0], z), z, neg);
+   }
+   case nir_op_uadd_sat:
+      return B.CreateBinaryIntrinsic(Intrinsic::uadd_sat, s[0], s[1]);
+   case nir_op_iadd_sat:
+      return B.CreateBinaryIntrinsic(Intrinsic::sadd_sat, s[0], s[1]);
+   case nir_op_usub_sat:
+      return B.CreateBinaryIntrinsic(Intrinsic::usub_sat, s[0], s[1]);
+   case nir_op_imul_high:
+   case nir_op_umul_high: {
+      bool sg = alu->op == nir_op_imul_high;
+      Type *w = c.def_ty(bits * 2, n);
+      Value *a = sg ? B.CreateSExt(s[0], w) : B.CreateZExt(s[0], w);
+      Value *b = sg ? B.CreateSExt(s[1], w) : B.CreateZExt(s[1], w);
+      Value *m = B.CreateMul(a, b);
+      return B.CreateTrunc(B.CreateLShr(m, ConstantInt::get(w, bits)), dty);
+   }
+   case nir_op_bitfield_insert:
+      return c.call("air.insert_bits." + isuffix(dty, false), dty, {s[0], s[1], s[2], s[3]}, A_PURE);
+   case nir_op_ubitfield_extract:
+      return c.call("air.extract_bits." + isuffix(dty, false), dty, {s[0], s[1], s[2]}, A_PURE);
+   case nir_op_ibitfield_extract:
+      return c.call("air.extract_bits." + isuffix(dty, true), dty, {s[0], s[1], s[2]}, A_PURE);
+   case nir_op_bitfield_reverse:
+      return c.call("air.reverse_bits." + isuffix_nosign(dty), dty, {s[0]}, A_PURE);
+   case nir_op_bit_count: {
+      Value *r = c.call("air.popcount." + isuffix_nosign(s[0]->getType()), s[0]->getType(), {s[0]}, A_PURE);
+      return B.CreateZExtOrTrunc(r, dty);
+   }
+   case nir_op_uclz:
+      return c.call("air.clz." + isuffix_nosign(dty), dty, {s[0], B.getFalse()}, A_PURE);
+
+   case nir_op_b2b1:
+      return B.CreateICmpNE(s[0], Constant::getNullValue(s[0]->getType()));
+   case nir_op_b2b32:
+   case nir_op_b2i8:
+   case nir_op_b2i16:
+   case nir_op_b2i32:
+   case nir_op_b2i64:
+      return B.CreateZExt(s[0], dty);
+   case nir_op_b2f16:
+   case nir_op_b2f32: {
+      Type *ft = c.vec_ty(c.flt_scalar(bits), n);
+      return I(B.CreateSelect(s[0], fconst(ft, 1.0), fconst(ft, 0.0)));
+   }
+   case nir_op_i2i8:
+   case nir_op_i2i16:
+   case nir_op_i2i32:
+   case nir_op_i2i64:
+      return B.CreateSExtOrTrunc(s[0], dty);
+   case nir_op_u2u8:
+   case nir_op_u2u16:
+   case nir_op_u2u32:
+   case nir_op_u2u64:
+      return B.CreateZExtOrTrunc(s[0], dty);
+   case nir_op_i2f16:
+   case nir_op_i2f32:
+      return I(convert(c, s[0], c.flt_scalar(bits), true, false, false, true));
+   case nir_op_u2f16:
+   case nir_op_u2f32:
+      return I(convert(c, s[0], c.flt_scalar(bits), true, false, false, false));
+   case nir_op_f2i8:
+   case nir_op_f2i16:
+   case nir_op_f2i32:
+   case nir_op_f2i64:
+      return convert(c, F(0), c.int_ty(bits), false, true, true, false);
+   case nir_op_f2u8:
+   case nir_op_f2u16:
+   case nir_op_f2u32:
+   case nir_op_f2u64:
+      return convert(c, F(0), c.int_ty(bits), false, false, true, false);
+   case nir_op_f2f16:
+   case nir_op_f2f16_rtne:
+      return I(B.CreateFPTrunc(F(0), c.vec_ty(c.t_f16, n)));
+   case nir_op_f2f32:
+      if (alu->src[0].src.ssa->bit_size == 32)
+         return s[0];
+      return I(B.CreateFPExt(F(0), c.vec_ty(c.t_f32, n)));
+
+   case nir_op_bcsel:
+      return B.CreateSelect(s[0], s[1], s[2]);
+   default:
+      break;
+   }
+
+   /* Floating point. */
+   enum fp_mode mode = alu_fp_mode(c, alu);
+   IRBuilder<>::FastMathFlagGuard guard(B);
+   B.setFastMathFlags(fmf_for(mode));
+
+   switch (alu->op) {
+   case nir_op_fadd: return I(B.CreateFAdd(F(0), F(1)));
+   case nir_op_fsub: return I(B.CreateFSub(F(0), F(1)));
+   case nir_op_fmul: return I(B.CreateFMul(F(0), F(1)));
+   case nir_op_fdiv: return I(B.CreateFDiv(F(0), F(1)));
+   case nir_op_fneg: return I(B.CreateFNeg(F(0)));
+   case nir_op_frcp: {
+      Value *x = F(0);
+      return I(B.CreateFDiv(fconst(x->getType(), 1.0), x));
+   }
+   case nir_op_feq:
+      if (nir_alu_srcs_equal(alu, alu, 0, 1))
+         return B.CreateFCmpORD(F(0), F(0));
+      return B.CreateFCmpOEQ(F(0), F(1));
+   case nir_op_fneu:
+      if (nir_alu_srcs_equal(alu, alu, 0, 1))
+         return B.CreateFCmpUNO(F(0), F(0));
+      return B.CreateFCmpUNE(F(0), F(1));
+   case nir_op_flt: return B.CreateFCmpOLT(F(0), F(1));
+   case nir_op_fge: return B.CreateFCmpOGE(F(0), F(1));
+   case nir_op_fabs: return I(fmath1(c, "fabs", true, prec, F(0)));
+   case nir_op_fceil: return I(fmath1(c, "ceil", true, prec, F(0)));
+   case nir_op_ffloor: return I(fmath1(c, "floor", true, prec, F(0)));
+   case nir_op_ftrunc: return I(fmath1(c, "trunc", true, false, F(0)));
+   case nir_op_fround_even: return I(fmath1(c, "rint", true, false, F(0)));
+   case nir_op_fcos: return I(fmath1(c, "cos", true, prec, F(0)));
+   case nir_op_fsin: return I(fmath1(c, "sin", true, prec, F(0)));
+   case nir_op_fexp2: return I(fmath1(c, "exp2", true, prec, F(0)));
+   case nir_op_flog2: return I(fmath1(c, "log2", true, prec, F(0)));
+   case nir_op_fsqrt: return I(fmath1(c, "sqrt", true, prec, F(0)));
+   case nir_op_frsq: return I(fmath1(c, "rsqrt", true, prec, F(0)));
+   case nir_op_fsat: return I(fmath1(c, "saturate", true, false, F(0)));
+   case nir_op_fsign: return I(fmath1(c, "sign", false, false, F(0)));
+   case nir_op_fpow: return I(fmath2(c, "pow", true, prec, F(0), F(1)));
+   case nir_op_frem: return I(fmath2(c, "fmod", true, prec, F(0), F(1)));
+   case nir_op_ffma: {
+      Value *x = F(0);
+      return I(c.call("air.fma." + fsuffix(x->getType()), x->getType(), {x, F(1), F(2)}, A_PURE, true));
+   }
+   case nir_op_ldexp: {
+      Value *x = F(0);
+      std::string nm = std::string("air.") + (x->getType()->getScalarType()->isFloatTy() && !prec ? "fast_" : "") + "ldexp." + fsuffix(x->getType());
+      return I(c.call(nm, x->getType(), {x, s[1]}, A_PURE, true));
+   }
+   case nir_op_ffract:
+      if (nir_alu_instr_is_inf_preserve(alu) || nir_alu_instr_is_nan_preserve(alu)) {
+         Value *x = F(0);
+         return I(B.CreateFSub(x, fmath1(c, "floor", true, false, x)));
+      }
+      return I(fmath1(c, "fract", true, false, F(0)));
+   case nir_op_fdot2:
+   case nir_op_fdot3:
+   case nir_op_fdot4: {
+      Value *x = F(0);
+      return I(c.call("air.dot." + fsuffix(x->getType()), x->getType()->getScalarType(), {x, F(1)}, A_PURE, true));
+   }
+   case nir_op_flrp: {
+      Value *a = F(0), *b = F(1), *t = F(2);
+      if (nir_alu_instr_is_signed_zero_preserve(alu) || nir_alu_instr_is_inf_preserve(alu) ||
+          nir_alu_instr_is_nan_preserve(alu))
+         return I(B.CreateFAdd(a, B.CreateFMul(B.CreateFSub(b, a), t)));
+      return I(c.call("air.mix." + fsuffix(a->getType()), a->getType(), {a, b, t}, A_PURE, true));
+   }
+   case nir_op_fmin:
+   case nir_op_fmax: {
+      bool is_min = alu->op == nir_op_fmin;
+      Value *x = F(0), *y = F(1);
+      Value *r = fmath2(c, is_min ? "fmin" : "fmax", true, prec, x, y);
+      if (nir_alu_instr_is_signed_zero_preserve(alu)) {
+         IRBuilder<>::FastMathFlagGuard g2(B);
+         B.setFastMathFlags(FastMathFlags());
+         Value *eq = B.CreateFCmpOEQ(x, y);
+         Value *xi = I(x), *yi = I(y);
+         Value *m = is_min ? B.CreateOr(xi, yi) : B.CreateAnd(xi, yi);
+         return B.CreateSelect(eq, m, I(r));
+      }
+      return I(r);
+   }
+   case nir_op_fisfinite: {
+      Value *x = s[0];
+      unsigned w = x->getType()->getScalarSizeInBits();
+      uint64_t em = w == 16 ? 0x7c00 : 0x7f800000;
+      return B.CreateICmpNE(B.CreateAnd(x, ConstantInt::get(x->getType(), em)), ConstantInt::get(x->getType(), em));
+   }
+   case nir_op_fisnormal: {
+      Value *x = s[0];
+      unsigned w = x->getType()->getScalarSizeInBits();
+      uint64_t am = w == 16 ? 0x7fff : 0x7fffffff;
+      uint64_t mn = w == 16 ? 0x0400 : 0x00800000;
+      uint64_t rg = w == 16 ? 0x7800 : 0x7f000000;
+      Value *a = B.CreateAnd(x, ConstantInt::get(x->getType(), am));
+      return B.CreateICmpULT(B.CreateSub(a, ConstantInt::get(x->getType(), mn)), ConstantInt::get(x->getType(), rg));
+   }
+   case nir_op_pack_unorm_4x8:
+      return c.call("air.pack.unorm4x8.v4f32", c.t_i32, {F(0)}, A_PURE);
+   case nir_op_pack_snorm_4x8:
+      return c.call("air.pack.snorm4x8.v4f32", c.t_i32, {F(0)}, A_PURE);
+   case nir_op_pack_unorm_2x16:
+      return c.call("air.pack.unorm2x16.v2f32", c.t_i32, {F(0)}, A_PURE);
+   case nir_op_pack_snorm_2x16:
+      return c.call("air.pack.snorm2x16.v2f32", c.t_i32, {F(0)}, A_PURE);
+   case nir_op_unpack_unorm_4x8:
+      return I(c.call("air.unpack.unorm4x8.v4f32", c.vec_ty(c.t_f32, 4), {s[0]}, A_PURE, true));
+   case nir_op_unpack_snorm_4x8:
+      return I(c.call("air.unpack.snorm4x8.v4f32", c.vec_ty(c.t_f32, 4), {s[0]}, A_PURE, true));
+   case nir_op_unpack_unorm_2x16:
+      return I(c.call("air.unpack.unorm2x16.v2f32", c.vec_ty(c.t_f32, 2), {s[0]}, A_PURE, true));
+   case nir_op_unpack_snorm_2x16:
+      return I(c.call("air.unpack.snorm2x16.v2f32", c.vec_ty(c.t_f32, 2), {s[0]}, A_PURE, true));
+   default:
+      c.fail(std::string("alu ") + info->name);
+      return UndefValue::get(dty);
+   }
+}
+
+static void
+emit_alu(air_ctx &c, nir_alu_instr *alu)
+{
+   Value *v = emit_alu_op(c, alu);
+   if (!c.ok)
+      return;
+   if (!is_handle_def(c, &alu->def)) {
+      Type *want = c.def_ty(alu->def.bit_size, alu->def.num_components);
+      if (v->getType() != want) {
+         if (v->getType()->getPrimitiveSizeInBits() == want->getPrimitiveSizeInBits() &&
+             v->getType()->isVectorTy() == want->isVectorTy())
+            v = c.B.CreateBitCast(v, want);
+         else {
+            c.fail(std::string("alu type ") + nir_op_infos[alu->op].name);
+            return;
+         }
+      }
+   }
+   set_def(c, &alu->def, v);
+}
+
