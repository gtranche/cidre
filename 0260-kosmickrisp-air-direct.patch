@@ -1196,6 +1196,10 @@ kk_physical_device_init_pipeline_cache(struct kk_physical_device *pdev)
       uint8_t pose = getenv(options_codegen[i]) != NULL;
       _mesa_blake3_update(&blake3_ctx, &pose, 1);
