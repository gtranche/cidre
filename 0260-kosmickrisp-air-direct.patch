+
+static const char *
+atomic_name(nir_atomic_op op, bool *is_signed, bool *is_float, bool *ok)
+{
+   *is_signed = false;
+   *is_float = false;
+   *ok = true;
+   switch (op) {
+   case nir_atomic_op_iadd: return "add";
+   case nir_atomic_op_fadd: *is_float = true; return "add";
+   case nir_atomic_op_imin: *is_signed = true; return "min";
+   case nir_atomic_op_umin: return "min";
+   case nir_atomic_op_imax: *is_signed = true; return "max";
+   case nir_atomic_op_umax: return "max";
+   case nir_atomic_op_iand: return "and";
+   case nir_atomic_op_ior: return "or";
+   case nir_atomic_op_ixor: return "xor";
+   case nir_atomic_op_xchg: return "xchg";
+   default: *ok = false; return "";
+   }
+}
+
+static Value *
+emit_mem_atomic(air_ctx &c, nir_intrinsic_instr *in, Value *ptr, Value *val,
+                bool local, unsigned bits)
+{
+   bool sg, fl, ok;
+   nir_atomic_op op = nir_intrinsic_atomic_op(in);
+   const char *nm = atomic_name(op, &sg, &fl, &ok);
+   if (!ok) {
+      c.fail("atomic op");
+      return nullptr;
+   }
+   Type *et = fl ? c.flt_scalar(bits) : c.int_ty(bits);
+   if (fl)
+      val = to_float(c, val);
+   std::string name = std::string("air.atomic.") + (local ? "local." : "global.") + nm;
+   if (op == nir_atomic_op_xchg)
+      name += ".i" + std::to_string(bits);
+   else if (fl)
+      name += ".f" + std::to_string(bits);
+   else
+      name += std::string(sg ? ".s" : ".u") + ".i" + std::to_string(bits);
+   ptr = c.B.CreateBitCast(ptr, PointerType::get(et, local ? 3 : 1));
+   Value *scope = ConstantInt::get(c.t_i32, local ? 1 : 2);
+   bool noresult = bits == 64 && nir_def_is_unused(&in->def) &&
+                   (op == nir_atomic_op_umin || op == nir_atomic_op_umax);
+   if (bits == 64 && !noresult) {
+      c.fail("atomic64");
+      return nullptr;
+   }
+   Value *r = c.call(name, noresult ? Type::getVoidTy(c.C) : et,
+                     {ptr, val, ConstantInt::get(c.t_i32, 0), scope, c.B.getTrue()},
+                     A_SIDE);
+   if (noresult)
+      return ConstantInt::get(c.t_i64, 0);
+   return to_int(c, r);
+}
+
+static AllocaInst *
+entry_alloca(air_ctx &c, Type *t)
+{
+   IRBuilder<> eb(&c.F->getEntryBlock(), c.F->getEntryBlock().begin());
+   return eb.CreateAlloca(t);
+}
+
+static Value *
+emit_mem_cmpxchg(air_ctx &c, Value *ptr, Value *cmp, Value *nv, bool local,
+                 unsigned bits)
+{
+   if (bits != 32) {
+      c.fail("cmpxchg bits");
+      return nullptr;
+   }
+   Type *et = c.t_i32;
+   AllocaInst *exp = entry_alloca(c, et);
+   c.B.CreateStore(cmp, exp);
+   ptr = c.B.CreateBitCast(ptr, PointerType::get(et, local ? 3 : 1));
+   std::string name = std::string("air.atomic.") + (local ? "local" : "global") + ".cmpxchg.weak.i32";
+   c.call(name, et,
+          {ptr, exp, nv, ConstantInt::get(c.t_i32, 0), ConstantInt::get(c.t_i32, 0),
+           ConstantInt::get(c.t_i32, local ? 1 : 2), c.B.getTrue()},
+          A_SIDE);
+   return c.B.CreateLoad(et, exp);
+}
+
+static unsigned
+mem_flags(nir_variable_mode modes)
+{
+   unsigned f = 0;
+   if (modes & (nir_var_mem_ssbo | nir_var_mem_global))
+      f |= 1;
+   if (modes & nir_var_mem_shared)
+      f |= 2;
+   if (modes & nir_var_image)
+      f |= 4;
+   return f;
+}
+
+static Value *
+simd_val_call(air_ctx &c, const std::string &base, Value *v, Value *extra,
+              const char *kind)
+{
+   Type *t = v->getType();
+   if (t->isVectorTy()) {
+      unsigned n = cast<FixedVectorType>(t)->getNumElements();
+      std::vector<Value *> cs;
+      for (unsigned i = 0; i < n; i++)
+         cs.push_back(simd_val_call(c, base, extract(c, v, i), extra, kind));
+      return build_vec(c, cs);
+   }
+   bool b1 = t->isIntegerTy(1);
+   if (b1)
+      v = c.B.CreateZExt(v, c.t_i32);
+   unsigned bits = v->getType()->getScalarSizeInBits();
+   if (bits != 16 && bits != 32) {
+      c.fail("simd bits");
+      return v;
+   }
+   std::string name = "air." + base + "." + (kind ? kind : "u.i") + std::to_string(bits);
+   if (kind && !strcmp(kind, "f")) {
+      v = to_float(c, v);
+      name = "air." + base + ".f" + std::to_string(bits);
+   } else if (kind && !strcmp(kind, "s")) {
+      name = "air." + base + ".s.i" + std::to_string(bits);
+   } else {
+      name = "air." + base + ".u.i" + std::to_string(bits);
+   }
+   std::vector<Value *> args = {v};
+   if (extra)
+      args.push_back(c.B.CreateZExtOrTrunc(extra, c.t_i16));
+   Value *r = c.call(name, v->getType(), args, A_CONV, v->getType()->isFloatingPointTy());
+   r = to_int(c, r);
+   if (b1)
+      r = c.B.CreateTrunc(r, c.t_i1);
+   return r;
+}
