+};
+
+static const char *
+sysval_air(mesa_shader_stage st, unsigned sv, Type **ty, air_ctx &c, const char **tname, const char **name)
+{
+   Type *u = c.t_i32, *u3 = c.vec_ty(c.t_i32, 3);
+   *ty = u;
+   *tname = "uint";
+   switch (sv) {
+   case SYSTEM_VALUE_SUBGROUP_SIZE: *name = "gl_SubGroupSize"; return "air.threads_per_simdgroup";
+   case SYSTEM_VALUE_SUBGROUP_INVOCATION: *name = "gl_SubGroupInvocation"; return "air.thread_index_in_simdgroup";
+   case SYSTEM_VALUE_NUM_SUBGROUPS: *name = "gl_NumSubGroups"; return "air.simdgroups_per_threadgroup";
+   case SYSTEM_VALUE_SUBGROUP_ID: *name = "gl_SubGroupID"; return "air.simdgroup_index_in_threadgroup";
+   case SYSTEM_VALUE_WORKGROUP_ID: *ty = u3; *tname = "uint3"; *name = "gl_WorkGroupID"; return "air.threadgroup_position_in_grid";
+   case SYSTEM_VALUE_LOCAL_INVOCATION_ID: *ty = u3; *tname = "uint3"; *name = "gl_LocalInvocationID"; return "air.thread_position_in_threadgroup";
+   case SYSTEM_VALUE_GLOBAL_INVOCATION_ID: *ty = u3; *tname = "uint3"; *name = "gl_GlobalInvocationID"; return "air.thread_position_in_grid";
+   case SYSTEM_VALUE_NUM_WORKGROUPS: *ty = u3; *tname = "uint3"; *name = "gl_NumWorkGroups"; return "air.threadgroups_per_grid";
+   case SYSTEM_VALUE_LOCAL_INVOCATION_INDEX: *name = "gl_LocalInvocationIndex"; return "air.thread_index_in_threadgroup";
+   case SYSTEM_VALUE_VERTEX_ID: *name = "gl_VertexID"; return "air.vertex_id";
+   case SYSTEM_VALUE_INSTANCE_ID: *name = "gl_InstanceID"; return "air.instance_id";
+   case SYSTEM_VALUE_BASE_INSTANCE: *name = "gl_BaseInstance"; return "air.base_instance";
+   case SYSTEM_VALUE_FIRST_VERTEX: *name = "gl_FirstVertex"; return "air.base_vertex";
+   case SYSTEM_VALUE_AMPLIFICATION_ID_KK: *name = "mtl_AmplificationID"; return "air.amplification_id";
+   case SYSTEM_VALUE_FRAG_COORD: *ty = c.vec_ty(c.t_f32, 4); *tname = "float4"; *name = "gl_FragCoord"; return "air.position";
+   case SYSTEM_VALUE_POINT_COORD: *ty = c.vec_ty(c.t_f32, 2); *tname = "float2"; *name = "gl_PointCoord"; return "air.point_coord";
+   case SYSTEM_VALUE_FRONT_FACE: *ty = c.t_i1; *tname = "bool"; *name = "gl_FrontFacing"; return "air.front_facing";
+   case SYSTEM_VALUE_LAYER_ID: *name = "gl_Layer"; return "air.render_target_array_index";
+   case SYSTEM_VALUE_SAMPLE_ID: *name = "gl_SampleID"; return "air.sample_id";
+   case SYSTEM_VALUE_SAMPLE_MASK_IN: *name = "gl_SampleMask"; return "air.sample_mask_in";
+   case SYSTEM_VALUE_PRIMITIVE_ID: *name = "gl_PrimitiveID"; return "air.primitive_id";
+   case SYSTEM_VALUE_BARYCENTRIC_PERSP_COORD: *ty = c.vec_ty(c.t_f32, 3); *tname = "float3"; *name = "gl_BaryCoord"; return "air.barycentric_coord";
+   default: return nullptr;
+   }
+}
+
+static MDNode *
+buffer_md(air_ctx &c, unsigned argi, unsigned loc, const char *tname, const char *aname, bool indirect_samplers)
+{
+   std::vector<Metadata *> m;
+   m.push_back(c.mdi(argi));
+   if (indirect_samplers) {
+      m.push_back(c.mds("air.indirect_buffer"));
+      m.push_back(c.mds("air.buffer_size"));
+      m.push_back(c.mdi(8 * MSL_MAX_SAMPLERS));
+   } else {
+      m.push_back(c.mds("air.buffer"));
+      m.push_back(c.mds("air.buffer_size"));
+      m.push_back(c.mdi(8));
+   }
+   m.push_back(c.mds("air.location_index"));
+   m.push_back(c.mdi(loc));
+   m.push_back(c.mdi(1));
+   m.push_back(c.mds("air.read"));
+   m.push_back(c.mds("air.address_space"));
+   m.push_back(c.mdi(2));
+   m.push_back(c.mds("air.struct_type_info"));
+   if (indirect_samplers) {
+      MDNode *sm = MDNode::get(c.C, {c.mdi(0), c.mds("air.sampler"), c.mds("air.location_index"), c.mdi(0), c.mdi(1),
+                                     c.mds("air.arg_type_name"), c.mds("sampler"), c.mds("air.arg_name"), c.mds("handles")});
+      m.push_back(MDNode::get(c.C, {c.mdi(0), c.mdi(8), c.mdi(MSL_MAX_SAMPLERS), c.mds("sampler"), c.mds("handles"),
+                                    c.mds("air.indirect_argument"), sm}));
+      m.push_back(c.mds("air.arg_type_size"));
+      m.push_back(c.mdi(8 * MSL_MAX_SAMPLERS));
+   } else {
+      m.push_back(MDNode::get(c.C, {c.mdi(0), c.mdi(8), c.mdi(1), c.mds("ulong"), c.mds("contents")}));
+      m.push_back(c.mds("air.arg_type_size"));
+      m.push_back(c.mdi(8));
+   }
+   m.push_back(c.mds("air.arg_type_align_size"));
+   m.push_back(c.mdi(8));
+   m.push_back(c.mds("air.arg_type_name"));
+   m.push_back(c.mds(tname));
+   m.push_back(c.mds("air.arg_name"));
+   m.push_back(c.mds(aname));
+   return MDNode::get(c.C, m);
+}
+
+static bool
+setup_function(air_ctx &c, std::vector<Metadata *> &arg_mds, std::vector<Metadata *> &out_mds)
+{
+   nir_shader *s = c.s;
+   mesa_shader_stage st = s->info.stage;
+   std::vector<Type *> at;
+   std::vector<std::function<void(Value *)>> binders;
+   std::vector<std::vector<Metadata *>> mds;
+
+   BITSET_DECLARE(svr, SYSTEM_VALUE_MAX);
+   memcpy(svr, s->info.system_values_read, sizeof(svr));
+   if (st == MESA_SHADER_FRAGMENT) {
+      if (BITSET_TEST(svr, SYSTEM_VALUE_SAMPLE_POS)) {
+         BITSET_CLEAR(svr, SYSTEM_VALUE_SAMPLE_POS);
+         BITSET_SET(svr, SYSTEM_VALUE_SAMPLE_ID);
+      }
+      BITSET_CLEAR(svr, SYSTEM_VALUE_HELPER_INVOCATION);
+      if (BITSET_TEST(svr, SYSTEM_VALUE_SAMPLE_MASK_IN))
+         BITSET_SET(svr, SYSTEM_VALUE_SAMPLE_ID);
+   }
+
+   unsigned i;
+   BITSET_FOREACH_SET(i, svr, SYSTEM_VALUE_MAX) {
+      if (st == MESA_SHADER_VERTEX &&
+          (i == SYSTEM_VALUE_SUBGROUP_INVOCATION || i == SYSTEM_VALUE_SUBGROUP_SIZE))
+         continue;
+      Type *ty;
+      const char *tn, *nm;
+      const char *air = sysval_air(st, i, &ty, c, &tn, &nm);
+      if (!air) {
+         c.fail(std::string("sysval ") + gl_system_value_name((gl_system_value)i));
+         return false;
+      }
+      std::vector<Metadata *> m = {nullptr, c.mds(air)};
+      if (i == SYSTEM_VALUE_FRAG_COORD) {
+         m.push_back(c.mds("air.center"));
+         m.push_back(c.mds("air.no_perspective"));
+      } else if (i == SYSTEM_VALUE_BARYCENTRIC_PERSP_COORD) {
+         m.push_back(c.mds("air.center"));
+         m.push_back(c.mds("air.perspective"));
+      } else if (i == SYSTEM_VALUE_SAMPLE_MASK_IN && st == MESA_SHADER_FRAGMENT &&
+                 s->info.fs.post_depth_coverage) {
+         m.push_back(c.mds("air.post_depth_coverage"));
+      }
+      m.push_back(c.mds("air.arg_type_name"));
+      m.push_back(c.mds(tn));
+      m.push_back(c.mds("air.arg_name"));
+      m.push_back(c.mds(nm));
+      at.push_back(ty);
+      mds.push_back(m);
+      unsigned sv = i;
+      binders.push_back([&c, sv](Value *v) { c.sysval[sv] = v; });
+   }
+
+   if (st == MESA_SHADER_FRAGMENT) {
+      u_foreach_bit64(loc, s->info.inputs_read) {
+         io_info &ii = c.in_info[loc];
+         if (!ii.num_components) {
+            c.fail("fs input info");
+            return false;
+         }
+         bool scal = slot_scalarized(loc);
+         unsigned ncomp = scal ? ii.num_components : 1;
+         for (unsigned k = 0; k < ncomp; k++) {
+            unsigned nc = scal ? 1 : ii.num_components;
+            const char *tn = type_name(ii.type, nc);
+            if (!tn) { c.fail("fs input type"); return false; }
+            std::string name = slot_name(loc, k);
+            if (name.empty()) { c.fail("fs input slot"); return false; }
+            std::vector<Metadata *> m = {nullptr};
+            Type *ty;
+            if (slot_user(loc)) {
+               m.push_back(c.mds("air.fragment_input"));
+               m.push_back(c.mds("user(" + name + ")"));
+               if (ii.uses_interpolant) {
+                  m.push_back(c.mds("air.interpolation_function"));
+                  if (ii.interpolation == INTERP_MODE_NOPERSPECTIVE)
+                     m.push_back(c.mds("air.no_perspective"));
+                  else if (ii.interpolation == INTERP_MODE_SMOOTH || ii.interpolation == INTERP_MODE_NONE)
+                     m.push_back(c.mds("air.perspective"));
+                  else { c.fail("interpolant mode"); return false; }
+                  ty = tex_ptr_type(c, "interpolant");
+               } else {
+                  if (ii.interpolation == INTERP_MODE_FLAT) {
+                     m.push_back(c.mds("air.flat"));
+                  } else {
+                     m.push_back(c.mds(ii.centroid ? "air.centroid" : ii.sample ? "air.sample" : "air.center"));
+                     m.push_back(c.mds(ii.interpolation == INTERP_MODE_NOPERSPECTIVE ? "air.no_perspective" : "air.perspective"));
+                  }
+                  ty = io_type(c, ii.type, nc);
+               }
+            } else {
+               if (loc == VARYING_SLOT_PRIMITIVE_ID)
+                  m.push_back(c.mds("air.primitive_id"));
+               else if (loc == VARYING_SLOT_LAYER)
+                  m.push_back(c.mds("air.render_target_array_index"));
+               else if (loc == VARYING_SLOT_VIEWPORT)
+                  m.push_back(c.mds("air.viewport_array_index"));
+               else { c.fail("fs builtin input"); return false; }
+               ty = io_type(c, ii.type, nc);
+            }
+            m.push_back(c.mds("air.arg_type_name"));
+            m.push_back(c.mds(tn));
+            m.push_back(c.mds("air.arg_name"));
+            m.push_back(c.mds(name));
+            at.push_back(ty);
+            mds.push_back(m);
+            std::pair<unsigned, unsigned> key = {(unsigned)loc, scal ? k : 0};
+            binders.push_back([&c, key](Value *v) { c.fs_inputs[key] = v; });
+         }
+      }
+      u_foreach_bit64(loc, s->info.outputs_read) {
+         if (loc < FRAG_RESULT_DATA0 || loc > FRAG_RESULT_DATA7) {
+            c.fail("framebuffer fetch slot");
+            return false;
+         }
+         io_info &oi = c.out_info[loc];
+         unsigned rtn = loc - FRAG_RESULT_DATA0;
+         unsigned nc = c.opts->rts_component_count[rtn];
+         const char *tn = type_name(oi.type, nc);
+         if (!tn) { c.fail("framebuffer fetch type"); return false; }
+         std::string name = "color_" + std::to_string(rtn);
+         std::vector<Metadata *> m = {nullptr, c.mds("air.render_target"), c.mdi(rtn), c.mdi(0),
+                                      c.mds("air.arg_type_name"), c.mds(tn), c.mds("air.arg_name"), c.mds(name)};
+         at.push_back(io_type(c, oi.type, nc));
+         mds.push_back(m);
+         unsigned l = loc;
+         binders.push_back([&c, l](Value *v) { c.fb_inputs[l] = v; });
+      }
+   }
+
+   at.push_back(PointerType::get(c.t_buffer, 2));
+   mds.push_back({});
+   binders.push_back([&c](Value *v) { c.buf0 = v; });
+   unsigned buf0_i = at.size() - 1;
+   at.push_back(PointerType::get(c.t_sampler_table, 2));
+   mds.push_back({});
+   binders.push_back([&c](Value *v) { c.sampler_table = v; });
+   unsigned st_i = at.size() - 1;
+   int pd_i = -1, lk_i = -1;
+   if (c.uses_per_draw) {
+      at.push_back(PointerType::get(c.t_buffer, 2));
+      mds.push_back({});
+      binders.push_back([&c](Value *v) { c.per_draw = v; });
+      pd_i = at.size() - 1;
+   }
+   if (c.uses_locks) {
+      at.push_back(PointerType::get(c.t_i32, 1));
+      mds.push_back({});
+      binders.push_back([&c](Value *v) { c.locks = v; });
+      lk_i = at.size() - 1;
+   }
+
+   /* Outputs. */
+   std::vector<Type *> rt;
+   if (st == MESA_SHADER_VERTEX) {
+      u_foreach_bit64(loc, s->info.outputs_written) {
+         io_info &oi = c.out_info[loc];
+         bool scal = slot_scalarized(loc);
+         unsigned nm = scal ? oi.num_components : 1;
+         for (unsigned k = 0; k < nm; k++) {
+            unsigned nc = scal ? 1 : oi.num_components;
+            const char *tn = type_name(oi.type, nc);
+            std::string name = slot_name(loc, k);
+            if (!tn || name.empty()) { c.fail("vs output"); return false; }
+            std::vector<Metadata *> m;
+            if (slot_user(loc)) {
+               m.push_back(c.mds("air.vertex_output"));
+               m.push_back(c.mds("user(" + name + ")"));
+            } else if (loc == VARYING_SLOT_POS) {
+               m.push_back(c.mds("air.position"));
+            } else if (loc == VARYING_SLOT_PSIZ) {
+               m.push_back(c.mds("air.point_size"));
+            } else if (loc == VARYING_SLOT_LAYER) {
+               m.push_back(c.mds("air.render_target_array_index"));
+            } else if (loc == VARYING_SLOT_VIEWPORT) {
+               m.push_back(c.mds("air.viewport_array_index"));
+            } else {
+               c.fail("vs builtin output");
+               return false;
+            }
+            m.push_back(c.mds("air.arg_type_name"));
+            m.push_back(c.mds(tn));
+            m.push_back(c.mds("air.arg_name"));
+            m.push_back(c.mds(name));
+            Type *ty = io_type(c, oi.type, nc);
+            c.out_index[{(unsigned)loc, scal ? k : 0}] = c.outs.size();
+            c.outs.push_back({ty, nullptr, MDNode::get(c.C, m)});
+            rt.push_back(ty);
+         }
+      }
+      if (s->info.clip_distance_array_size) {
+         unsigned n = s->info.clip_distance_array_size;
+         Type *ty = ArrayType::get(c.t_f32, n);
+         c.clip_member = c.outs.size();
+         c.outs.push_back({ty, nullptr,
+                           MDNode::get(c.C, {c.mds("air.clip_distance"), c.mds("air.clip_distance_array_size"), c.mdi(n),
+                                             c.mds("air.arg_type_name"), c.mds("float"), c.mds("air.arg_name"),
+                                             c.mds("gl_ClipDistance")})});
+         rt.push_back(ty);
+      }
+   } else if (st == MESA_SHADER_FRAGMENT) {
+      static const char *depth_q[] = {"air.any", "air.any", "air.greater", "air.less", "air.any"};
+      u_foreach_bit64(loc, s->info.outputs_written) {
+         io_info &oi = c.out_info[loc];
+         unsigned nc = oi.num_components;
+         if (loc >= FRAG_RESULT_DATA0 && loc <= FRAG_RESULT_DATA7)
+            nc = c.opts->rts_component_count[loc - FRAG_RESULT_DATA0];
+         const char *tn = type_name(oi.type, nc);
+         if (!tn) { c.fail("fs output type"); return false; }
+         std::vector<Metadata *> m;
+         std::string name;
+         if (loc >= FRAG_RESULT_DATA0 && loc <= FRAG_RESULT_DATA7) {
+            unsigned rtn = loc - FRAG_RESULT_DATA0;
+            name = "color_" + std::to_string(rtn);
+            m = {c.mds("air.render_target"), c.mdi(rtn), c.mdi(0)};
+         } else if (loc == FRAG_RESULT_DEPTH) {
+            name = "depth_out";
+            unsigned dl = s->info.fs.depth_layout;
+            m = {c.mds("air.depth"), c.mds("air.depth_qualifier"), c.mds(dl < 5 ? depth_q[dl] : "air.any")};
+         } else if (loc == FRAG_RESULT_STENCIL) {
+            name = "stencil_out";
+            m = {c.mds("air.stencil")};
+         } else if (loc == FRAG_RESULT_SAMPLE_MASK) {
+            name = "sample_mask_out";
+            m = {c.mds("air.sample_mask")};
+         } else {
+            c.fail("fs output slot");
+            return false;
+         }
+         m.push_back(c.mds("air.arg_type_name"));
+         m.push_back(c.mds(tn));
+         m.push_back(c.mds("air.arg_name"));
+         m.push_back(c.mds(name));
+         Type *ty = io_type(c, oi.type, nc);
+         c.out_index[{(unsigned)loc, 0}] = c.outs.size();
+         c.outs.push_back({ty, nullptr, MDNode::get(c.C, m)});
+         rt.push_back(ty);
+      }
+   }
+
+   if (st == MESA_SHADER_VERTEX || st == MESA_SHADER_FRAGMENT)
+      c.ret_type = StructType::get(c.C, rt, true);
+   else
+      c.ret_type = Type::getVoidTy(c.C);
+
+   FunctionType *ft = FunctionType::get(c.ret_type, at, false);
+   c.F = Function::Create(ft, GlobalValue::ExternalLinkage, "main_entrypoint", c.M);
+   c.F->addFnAttr(Attribute::NoUnwind);
+   c.F->addFnAttr("frame-pointer", "all");
+   c.F->addFnAttr("no-trapping-math", "true");
+   c.F->addFnAttr("approx-func-fp-math", "true");
+   for (unsigned a = 0; a < at.size(); a++) {
+      Value *v = c.F->getArg(a);
+      binders[a](v);
+      std::vector<Metadata *> m = mds[a];
+      if (a == buf0_i) {
+         arg_mds.push_back(buffer_md(c, a, 0, "Buffer", "buf0", false));
+         c.F->addParamAttr(a, Attribute::get(c.C, "air-buffer-no-alias"));
+         continue;
+      }
+      if (a == st_i) {
+         arg_mds.push_back(buffer_md(c, a, 1, "SamplerTable", "sampler_table", true));
+         c.F->addParamAttr(a, Attribute::get(c.C, "air-buffer-no-alias"));
+         continue;
+      }
+      if ((int)a == pd_i) {
+         arg_mds.push_back(buffer_md(c, a, 2, "Buffer", "per_draw", false));
+         c.F->addParamAttr(a, Attribute::get(c.C, "air-buffer-no-alias"));
+         continue;
+      }
+      if ((int)a == lk_i) {
+         arg_mds.push_back(MDNode::get(c.C, {c.mdi(a), c.mds("air.buffer"), c.mds("air.location_index"), c.mdi(3), c.mdi(1),
+                                             c.mds("air.read_write"), c.mds("air.address_space"), c.mdi(1),
+                                             c.mds("air.arg_type_size"), c.mdi(4), c.mds("air.arg_type_align_size"), c.mdi(4),
+                                             c.mds("air.arg_type_name"), c.mds("uint"), c.mds("air.arg_name"),
+                                             c.mds("atomic64_locks")}));
+         continue;
+      }
+      m[0] = c.mdi(a);
+      arg_mds.push_back(MDNode::get(c.C, m));
+   }
+   for (auto &o : c.outs)
+      out_mds.push_back(o.md);
+   return true;
+}
+
+static void
+setup_locals(air_ctx &c)
+{
+   nir_shader *s = c.s;
+   IRBuilder<> &B = c.B;
+   for (auto &o : c.outs) {
+      o.slot = B.CreateAlloca(o.ty);
+      B.CreateStore(Constant::getNullValue(o.ty), o.slot);
+   }
+   for (auto &fb : c.fb_inputs) {
+      auto it = c.out_index.find({fb.first, 0});
+      if (it != c.out_index.end() && c.outs[it->second].ty == fb.second->getType())
+         B.CreateStore(fb.second, c.outs[it->second].slot);
+   }
+   if (s->info.shared_size) {
+      Type *t = ArrayType::get(c.t_i8, s->info.shared_size);
+      c.shared = new GlobalVariable(*c.M, t, false, GlobalValue::InternalLinkage, UndefValue::get(t),
+                                    "shared_data", nullptr, GlobalValue::NotThreadLocal, 3);
+      c.shared->setAlignment(Align(16));
+   }
+   if (s->scratch_size) {
+      Type *t = ArrayType::get(c.t_i8, s->scratch_size);
+      AllocaInst *a = B.CreateAlloca(t);
+      a->setAlignment(Align(16));
+      c.scratch = B.CreateBitCast(a, PointerType::get(c.t_i8, 0));
+      if (!(c.wa & BITFIELD64_BIT(1)))
+         B.CreateStore(Constant::getNullValue(t), a);
+   }
+   if (s->constant_data_size) {
+      unsigned words = DIV_ROUND_UP(s->constant_data_size, 4u);
+      std::vector<Constant *> v;
+      const uint8_t *d = (const uint8_t *)s->constant_data;
+      for (unsigned w = 0; w < words; w++) {
+         uint32_t x = 0;
+         for (unsigned b = 0; b < 4 && w * 4 + b < s->constant_data_size; b++)
+            x |= (uint32_t)d[w * 4 + b] << (b * 8);
+         v.push_back(ConstantInt::get(c.t_i32, x));
+      }
+      ArrayType *t = ArrayType::get(c.t_i32, words);
+      c.cdata = new GlobalVariable(*c.M, t, true, GlobalValue::InternalLinkage, ConstantArray::get(t, v),
+                                   "constant_data", nullptr, GlobalValue::NotThreadLocal, 2);
+      c.cdata->setAlignment(Align(16));
+   }
+}
+
+static void
+setup_module(air_ctx &c)
+{
+   Module *M = c.M;
+   M->setTargetTriple("air64_v28-apple-macosx26.0.0");
+   M->setDataLayout("e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-"
+                    "v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-"
+                    "v1024:1024:1024-n8:16:32");
+   M->setSDKVersion(VersionTuple(26, 5));
+   M->addModuleFlag(Module::Error, "wchar_size", 4);
+   M->addModuleFlag(Module::Max, "frame-pointer", 2);
+   M->addModuleFlag(Module::Max, "air.max_device_buffers", 31);
+   M->addModuleFlag(Module::Max, "air.max_constant_buffers", 31);
+   M->addModuleFlag(Module::Max, "air.max_threadgroup_buffers", 31);
+   M->addModuleFlag(Module::Max, "air.max_textures", 128);
+   M->addModuleFlag(Module::Max, "air.max_read_write_textures", 8);
+   M->addModuleFlag(Module::Max, "air.max_samplers", 16);
+
+   c.t_i1 = Type::getInt1Ty(c.C);
+   c.t_i8 = Type::getInt8Ty(c.C);
+   c.t_i16 = Type::getInt16Ty(c.C);
+   c.t_i32 = Type::getInt32Ty(c.C);
+   c.t_i64 = Type::getInt64Ty(c.C);
+   c.t_f16 = Type::getHalfTy(c.C);
+   c.t_f32 = Type::getFloatTy(c.C);
+   c.t_buffer = StructType::create(c.C, {ArrayType::get(c.t_i64, 1)}, "struct.Buffer");
+   c.t_sampler = StructType::create(c.C, "struct._sampler_t");
+   c.t_sampler_ptr = PointerType::get(c.t_sampler, 2);
+   c.t_msampler = StructType::create(c.C, {c.t_sampler_ptr}, "struct.metal::sampler");
+   c.t_sampler_table = StructType::create(c.C, {ArrayType::get(c.t_msampler, MSL_MAX_SAMPLERS)}, "struct.SamplerTable");
+}
+
+static void
+finish_module(air_ctx &c, std::vector<Metadata *> &arg_mds, std::vector<Metadata *> &out_mds)
+{
+   Module *M = c.M;
+   mesa_shader_stage st = c.s->info.stage;
+   std::vector<Metadata *> fm = {c.mdv(c.F), MDNode::get(c.C, out_mds), MDNode::get(c.C, arg_mds)};
+   if (st == MESA_SHADER_FRAGMENT && c.s->info.fs.early_fragment_tests)
+      fm.push_back(c.mds("early_fragment_tests"));
+   const char *kind = st == MESA_SHADER_VERTEX ? "air.vertex" : st == MESA_SHADER_FRAGMENT ? "air.fragment" : "air.kernel";
+   M->getOrInsertNamedMetadata(kind)->addOperand(MDNode::get(c.C, fm));
+   NamedMDNode *co = M->getOrInsertNamedMetadata("air.compile_options");
+   co->addOperand(MDNode::get(c.C, {c.mds("air.compile.denorms_disable")}));
+   co->addOperand(MDNode::get(c.C, {c.mds("air.compile.fast_math_enable")}));
+   co->addOperand(MDNode::get(c.C, {c.mds("air.compile.framebuffer_fetch_enable")}));
+   M->getOrInsertNamedMetadata("llvm.ident")->addOperand(MDNode::get(c.C, {c.mds("Cidre nir_to_air")}));
+   M->getOrInsertNamedMetadata("air.version")->addOperand(MDNode::get(c.C, {c.mdi(2), c.mdi(8), c.mdi(0)}));
+   M->getOrInsertNamedMetadata("air.language_version")
+      ->addOperand(MDNode::get(c.C, {c.mds("Metal"), c.mdi(4), c.mdi(0), c.mdi(0)}));
+   M->getOrInsertNamedMetadata("air.source_file_name")->addOperand(MDNode::get(c.C, {c.mds("kk_air")}));
+}
+
+static bool
+translate(air_ctx &c, std::string &bitcode, std::string *ll)
+{
+   nir_shader *s = c.s;
+   mesa_shader_stage st = s->info.stage;
+   if (st != MESA_SHADER_COMPUTE && st != MESA_SHADER_VERTEX && st != MESA_SHADER_FRAGMENT) {
+      c.fail("stage");
+      return false;
+   }
+   nir_function_impl *impl = nir_shader_get_entrypoint(s);
+   nir_index_ssa_defs(impl);
+   c.defs.assign(impl->ssa_alloc, nullptr);
+   c.uses_per_draw = msl_gather_uses_per_draw_data(s);
+   c.uses_locks = msl_gather_uses_atomic64_locks(s);
+   nir_shader_intrinsics_pass(s, gather_io, nir_metadata_all, &c);
+
+   std::unique_ptr<Module> mod(new Module("kk_air", c.C));
+   c.M = mod.get();
+   setup_module(c);
+
+   std::vector<Metadata *> arg_mds, out_mds;
+   if (!setup_function(c, arg_mds, out_mds))
+      return false;
+
+   BasicBlock *entry = BasicBlock::Create(c.C, "", c.F);
+   c.B.SetInsertPoint(entry);
+   setup_locals(c);
+
+   emit_cf_list(c, &impl->body);
+   if (!c.ok)
+      return false;
+   if (!has_term(c))
+      emit_return(c);
+
+   for (auto &pp : c.phis) {
+      nir_foreach_phi_src(ps, pp.first) {
+         auto it = c.end_bbs.find(ps->pred);
+         if (it == c.end_bbs.end()) {
+            c.fail("phi pred");
+            return false;
+         }
+         Value *v = get_src(c, &ps->src);
+         if (v->getType() != pp.second->getType()) {
+            c.fail("phi type");
+            return false;
+         }
+         pp.second->addIncoming(v, it->second);
+      }
+   }
+   for (BasicBlock &bb : *c.F) {
+      if (!bb.getTerminator()) {
+         c.B.SetInsertPoint(&bb);
+         c.B.CreateUnreachable();
+      }
+   }
+
+   finish_module(c, arg_mds, out_mds);
+
+   std::string err;
+   raw_string_ostream es(err);
+   if (verifyModule(*c.M, &es)) {
+      es.flush();
+      c.fail("verify: " + err.substr(0, 200));
+      if (ll) {
+         raw_string_ostream ls(*ll);
+         c.M->print(ls, nullptr);
+      }
+      return false;
+   }
+   if (ll) {
+      raw_string_ostream ls(*ll);
+      c.M->print(ls, nullptr);
+   }
+   SmallVector<char, 0> buf;
+   raw_svector_ostream bs(buf);
+   WriteBitcodeToFile(*c.M, bs);
+   bitcode.assign(buf.data(), buf.size());
+   c.M = nullptr;
+   return true;
+}
+
+} /* namespace */
+
+extern "C" bool
+nir_to_air_available(void)
+{
+   return true;
+}
+
+extern "C" bool
+nir_to_air(struct nir_shader *shader, const struct air_options *options,
+           bool want_ll, struct air_output *out)
+{
+   memset(out, 0, sizeof(*out));
+   air_ctx c;
+   c.s = shader;
+   c.opts = options;
+   c.wa = options->disabled_workarounds;
+   c.C.setOpaquePointers(false);
+   std::string bc, ll;
+   bool ok = translate(c, bc, want_ll ? &ll : nullptr);
+   if (want_ll && !ll.empty())
+      out->ll = strdup(ll.c_str());
+   if (!ok || !c.ok) {
+      snprintf(out->reason, sizeof(out->reason), "%s", c.why.c_str());
+      return false;
+   }
+   uint8_t ftype = shader->info.stage == MESA_SHADER_VERTEX ? 0 : shader->info.stage == MESA_SHADER_FRAGMENT ? 1 : 2;
+   std::string lib = write_metallib(bc, "main_entrypoint", ftype);
+   out->metallib = malloc(lib.size());
+   memcpy(out->metallib, lib.data(), lib.size());
+   out->metallib_size = lib.size();
+   return true;
+}
+
+extern "C" void
+nir_to_air_free(struct air_output *out)
+{
+   free(out->metallib);
+   free(out->ll);
+   out->metallib = NULL;
+   out->ll = NULL;
+}
diff --git a/src/kosmickrisp/compiler/nir_to_air_tex.inc b/src/kosmickrisp/compiler/nir_to_air_tex.inc
new file mode 100644
index 0000000..cf61874
--- /dev/null
+++ b/src/kosmickrisp/compiler/nir_to_air_tex.inc
@@ -0,0 +1,516 @@
+/*
+ * Copyright 2026 Cidre
+ * SPDX-License-Identifier: MIT
+ */
+
+namespace {
+
+struct elem_kind {
+   Type *et;
+   std::string sfx;
+   bool is_float, is_signed;
+};
+
+static bool
+tex_elem(air_ctx &c, nir_alu_type t, elem_kind &k)
+{
+   switch (t) {
+   case nir_type_float32: k = {c.t_f32, "v4f32", true, false}; return true;
+   case nir_type_float16: k = {c.t_f16, "v4f16", true, false}; return true;
+   case nir_type_int32: k = {c.t_i32, "s.v4i32", false, true}; return true;
+   case nir_type_uint32: k = {c.t_i32, "u.v4i32", false, false}; return true;
+   case nir_type_int16: k = {c.t_i16, "s.v4i16", false, true}; return true;
+   case nir_type_uint16: k = {c.t_i16, "u.v4i16", false, false}; return true;
+   default: return false;
+   }
+}
+
+static bool
+dim_has_offset(enum glsl_sampler_dim d)
+{
+   return d == GLSL_SAMPLER_DIM_2D || d == GLSL_SAMPLER_DIM_3D;
+}
+
+static unsigned
+dim_coord_comps(enum glsl_sampler_dim d)
+{
+   switch (d) {
+   case GLSL_SAMPLER_DIM_1D:
+   case GLSL_SAMPLER_DIM_BUF: return 1;
+   case GLSL_SAMPLER_DIM_2D:
+   case GLSL_SAMPLER_DIM_MS: return 2;
+   default: return 3;
+   }
+}
+
+static Value *
+round_layer(air_ctx &c, Value *a)
+{
+   if (a->getType()->isFloatingPointTy() || true) {
+      Value *f = to_float(c, a);
+      Value *r = c.call("air.fast_rint.f32", c.t_f32, {f}, A_PURE, true);
+      Value *i = c.call("air.convert.s.i32.f.f32", c.t_i32, {r}, A_PURE);
+      return c.B.CreateSelect(c.B.CreateICmpSGT(i, ConstantInt::get(c.t_i32, 0)), i, ConstantInt::get(c.t_i32, 0));
+   }
+   return a;
+}
+
+static Value *
+tex_result(air_ctx &c, Value *res, bool depth, const elem_kind &k, nir_def *def,
+           nir_alu_type dest_type)
+{
+   Value *v = c.B.CreateExtractValue(res, {0});
+   unsigned n = def->num_components;
+   if (!v->getType()->isVectorTy()) {
+      std::vector<Value *> cs(n, v);
+      v = build_vec(c, cs);
+   } else {
+      v = first_n(c, v, n);
+   }
+   Type *et = v->getType()->getScalarType();
+   unsigned want = def->bit_size;
+   if (et->isFloatingPointTy() && et->getPrimitiveSizeInBits() != want) {
+      Type *nt = c.vec_ty(c.flt_scalar(want), n);
+      v = want > et->getPrimitiveSizeInBits() ? c.B.CreateFPExt(v, nt) : c.B.CreateFPTrunc(v, nt);
+   } else if (et->isIntegerTy() && et->getIntegerBitWidth() != want) {
+      Type *nt = c.def_ty(want, n);
+      v = k.is_signed ? c.B.CreateSExtOrTrunc(v, nt) : c.B.CreateZExtOrTrunc(v, nt);
+   }
+   return to_int(c, v);
+}
+
+static nir_src *
+tsrc(nir_tex_instr *tex, nir_tex_src_type t)
+{
+   int i = nir_tex_instr_src_index(tex, t);
+   return i < 0 ? nullptr : &tex->src[i].src;
+}
+
+static Value *
+f32_src(air_ctx &c, nir_src *src, unsigned n)
+{
+   Value *v = to_float(c, n == 1 ? extract(c, get_src(c, src), 0) : first_n(c, get_src(c, src), n));
+   if (v->getType()->getScalarType()->isHalfTy())
+      v = c.B.CreateFPExt(v, c.vec_ty(c.t_f32, n));
+   return v;
+}
+
+static Value *
+zero_offset(air_ctx &c, unsigned n)
+{
+   return Constant::getNullValue(c.vec_ty(c.t_i32, n));
+}
+
+static Value *
+offset_vec(air_ctx &c, nir_src *off, unsigned n)
+{
+   if (!off)
+      return zero_offset(c, n);
+   Value *v = get_src(c, off);
+   v = c.B.CreateSExtOrTrunc(v, c.vec_ty(c.t_i32, v->getType()->isVectorTy() ? cast<FixedVectorType>(v->getType())->getNumElements() : 1));
+   return first_n(c, v, n);
+}
+
+static void
+emit_tex(air_ctx &c, nir_tex_instr *tex)
+{
+   IRBuilder<> &B = c.B;
+   nir_src *th = tsrc(tex, nir_tex_src_texture_handle);
+   nir_src *sh = tsrc(tex, nir_tex_src_sampler_handle);
+   if (!th) {
+      c.fail("tex without handle");
+      return;
+   }
+   tex_info ti;
+   if (!handle_info(c, th->ssa, ti)) {
+      c.fail("tex handle info");
+      return;
+   }
+   Value *T = get_src(c, th);
+   Value *S = sh ? get_src(c, sh) : nullptr;
+   elem_kind k;
+   if (!tex_elem(c, ti.type, k)) {
+      c.fail("tex elem type");
+      return;
+   }
+   bool depth = ti.depth;
+   Type *i32 = c.t_i32;
+   Value *one = ConstantInt::get(i32, 1), *zero = ConstantInt::get(i32, 0);
+   Type *f32 = c.t_f32;
+   enum glsl_sampler_dim dim = ti.dim;
+   bool cube = dim == GLSL_SAMPLER_DIM_CUBE;
+   std::string stem = ti.stem;
+   Type *ret = depth ? (Type *)StructType::get(c.C, {f32, c.t_i8})
+                     : (Type *)StructType::get(c.C, {FixedVectorType::get(k.et, 4), c.t_i8});
+   std::string rsfx = depth ? "f32" : k.sfx;
+
+   nir_src *coord_s = tsrc(tex, nir_tex_src_coord);
+   Value *coord = nullptr, *layer = nullptr;
+   unsigned ncoord = tex->coord_components - (tex->is_array ? 1 : 0);
+   if (coord_s) {
+      Value *cv = get_src(c, coord_s);
+      bool fl = nir_tex_instr_src_type(tex, nir_tex_instr_src_index(tex, nir_tex_src_coord)) == nir_type_float;
+      std::vector<Value *> cs;
+      for (unsigned i = 0; i < ncoord; i++)
+         cs.push_back(extract(c, cv, i));
+      coord = build_vec(c, cs);
+      if (fl) {
+         coord = to_float(c, coord);
+         if (coord->getType()->getScalarType()->isHalfTy())
+            coord = c.B.CreateFPExt(coord, c.vec_ty(c.t_f32, ncoord));
+      } else if (coord->getType()->getScalarSizeInBits() != 32) {
+         coord = c.B.CreateZExtOrTrunc(coord, c.vec_ty(c.t_i32, ncoord));
+      }
+      if (tex->is_array) {
+         Value *a = extract(c, cv, ncoord);
+         if (fl && a->getType()->getScalarSizeInBits() == 16)
+            a = c.B.CreateBitCast(c.B.CreateFPExt(to_float(c, a), c.t_f32), c.t_i32);
+         layer = fl ? round_layer(c, a) : c.B.CreateZExtOrTrunc(a, c.t_i32);
+      }
+   }
+
+   switch (tex->op) {
+   case nir_texop_tex:
+   case nir_texop_txb:
+   case nir_texop_txl:
+   case nir_texop_txd: {
+      if (!S || !coord) { c.fail("sample srcs"); return; }
+      nir_src *bias = tsrc(tex, nir_tex_src_bias), *lod = tsrc(tex, nir_tex_src_lod);
+      nir_src *ddx = tsrc(tex, nir_tex_src_ddx), *ddy = tsrc(tex, nir_tex_src_ddy);
+      nir_src *minlod = tsrc(tex, nir_tex_src_min_lod), *off = tsrc(tex, nir_tex_src_offset);
+      nir_src *cmp = tsrc(tex, nir_tex_src_comparator);
+      bool grad = ddx != nullptr;
+      if (cmp && !depth) { c.fail("compare on color"); return; }
+      std::string name = std::string("air.sample_") + (cmp ? "compare_" : "") + stem + (grad ? "_grad" : "") + "." + rsfx;
+      std::vector<Value *> a = {T, S};
+      if (depth)
+         a.push_back(one);
+      a.push_back(coord);
+      if (layer)
+         a.push_back(layer);
+      if (cmp)
+         a.push_back(f32_src(c, cmp, 1));
+      Value *ml = minlod ? f32_src(c, minlod, 1) : ConstantFP::get(f32, 0.0);
+      if (grad) {
+         a.push_back(f32_src(c, ddx, ncoord));
+         a.push_back(f32_src(c, ddy, ncoord));
+         a.push_back(ml);
+         if (!cube) {
+            a.push_back(B.getTrue());
+            a.push_back(offset_vec(c, off, ncoord));
+         }
+         a.push_back(zero);
+      } else {
+         if (!cube) {
+            if (dim == GLSL_SAMPLER_DIM_1D) {
+               a.push_back(off ? B.getTrue() : B.getFalse());
+               a.push_back(off ? offset_vec(c, off, 1) : zero);
+            } else {
+               a.push_back(B.getTrue());
+               a.push_back(offset_vec(c, off, ncoord));
+            }
+         } else if (off) {
+            c.fail("cube offset");
+            return;
+         }
+         Value *lv = ConstantFP::get(f32, 0.0);
+         bool is_lod = false;
+         if (lod) {
+            is_lod = true;
+            lv = f32_src(c, lod, 1);
+         } else if (bias) {
+            lv = f32_src(c, bias, 1);
+         }
+         a.push_back(is_lod ? B.getTrue() : B.getFalse());
+         a.push_back(lv);
+         a.push_back(ml);
+         a.push_back(zero);
+      }
+      Value *res = c.call(name, ret, a, A_SAMPLE);
+      set_def(c, &tex->def, tex_result(c, res, depth, k, &tex->def, tex->dest_type));
+      return;
+   }
+   case nir_texop_txf:
+   case nir_texop_txf_ms: {
+      if (!coord) { c.fail("txf coord"); return; }
+      std::string name = std::string("air.read_") + stem + (ti.coherent ? ".device_coherent" : "") + "." + rsfx;
+      Value *rs = c.call("air.get_read_sampler", c.t_sampler_ptr, {}, A_INACC);
+      std::vector<Value *> a = {T, rs};
+      if (depth)
+         a.push_back(one);
+      a.push_back(B.CreateZExtOrTrunc(coord, c.vec_ty(i32, ncoord)));
+      if (layer)
+         a.push_back(layer);
+      if (tex->op == nir_texop_txf_ms) {
+         a.push_back(c.B.CreateZExtOrTrunc(extract(c, get_src(c, tsrc(tex, nir_tex_src_ms_index)), 0), i32));
+      } else if (dim != GLSL_SAMPLER_DIM_BUF) {
+         if (dim_has_offset(dim))
+            a.push_back(zero_offset(c, ncoord));
+         nir_src *lod = tsrc(tex, nir_tex_src_lod);
+         a.push_back(lod ? c.B.CreateZExtOrTrunc(extract(c, get_src(c, lod), 0), i32) : zero);
+      }
+      a.push_back(ConstantInt::get(i32, ti.access));
+      Value *res = c.call(name, ret, a, A_READ);
+      set_def(c, &tex->def, tex_result(c, res, depth, k, &tex->def, tex->dest_type));
+      return;
+   }
+   case nir_texop_txs: {
+      nir_src *lod = tsrc(tex, nir_tex_src_lod);
+      bool nolod = dim == GLSL_SAMPLER_DIM_MS || dim == GLSL_SAMPLER_DIM_BUF;
+      Value *lv = lod && !nolod ? c.B.CreateZExtOrTrunc(extract(c, get_src(c, lod), 0), i32) : zero;
+      auto q = [&](const char *what, bool with_lod) {
+         std::vector<Value *> a = {T};
+         if (with_lod)
+            a.push_back(lv);
+         return c.call(std::string("air.get_") + what + "_" + stem, i32, a, A_READ);
+      };
+      std::vector<Value *> cs;
+      cs.push_back(q("width", !nolod));
+      if (dim != GLSL_SAMPLER_DIM_1D && dim != GLSL_SAMPLER_DIM_BUF)
+         cs.push_back(q("height", !nolod));
+      if (dim == GLSL_SAMPLER_DIM_3D)
+         cs.push_back(q("depth", true));
+      if (tex->is_array)
+         cs.push_back(q("array_size", false));
+      Value *v = build_vec(c, cs);
+      v = first_n(c, v, tex->def.num_components);
+      if (tex->def.bit_size != 32) { c.fail("txs bits"); return; }
+      set_def(c, &tex->def, v);
+      return;
+   }
+   case nir_texop_query_levels:
+      set_def(c, &tex->def, c.call("air.get_num_mip_levels_" + stem, i32, {T}, A_READ));
+      return;
+   case nir_texop_texture_samples:
+      set_def(c, &tex->def, c.call("air.get_num_samples_" + stem, i32, {T}, A_READ));
+      return;
+   case nir_texop_tg4: {
+      if (!S || !coord) { c.fail("gather srcs"); return; }
+      nir_src *off = tsrc(tex, nir_tex_src_offset);
+      nir_src *cmp = tsrc(tex, nir_tex_src_comparator);
+      std::string name;
+      Type *gret;
+      if (depth) {
+         name = std::string("air.gather_") + (cmp ? "compare_" : "") + stem + (cmp ? ".f32" : ".v4f32");
+         gret = StructType::get(c.C, {FixedVectorType::get(f32, 4), c.t_i8});
+      } else {
+         if (cmp) { c.fail("gather compare color"); return; }
+         name = "air.gather_" + stem + "." + k.sfx;
+         gret = ret;
+      }
+      std::vector<Value *> a = {T, S};
+      if (depth)
+         a.push_back(one);
+      a.push_back(coord);
+      if (layer)
+         a.push_back(layer);
+      if (cmp)
+         a.push_back(f32_src(c, cmp, 1));
+      if (!cube) {
+         a.push_back(B.getTrue());
+         a.push_back(offset_vec(c, off, ncoord));
+      }
+      if (!depth)
+         a.push_back(ConstantInt::get(i32, tex->component));
+      a.push_back(zero);
+      Value *res = c.call(name, gret, a, A_SAMPLE);
+      elem_kind kk = k;
+      if (depth)
+         kk = {f32, "v4f32", true, false};
+      Value *v = B.CreateExtractValue(res, {0});
+      v = first_n(c, v, tex->def.num_components);
+      Type *et = v->getType()->getScalarType();
+      if (et->isFloatingPointTy() && et->getPrimitiveSizeInBits() != tex->def.bit_size) {
+         Type *nt = c.vec_ty(c.flt_scalar(tex->def.bit_size), tex->def.num_components);
+         v = tex->def.bit_size > et->getPrimitiveSizeInBits() ? B.CreateFPExt(v, nt) : B.CreateFPTrunc(v, nt);
+      } else if (et->isIntegerTy() && et->getIntegerBitWidth() != tex->def.bit_size) {
+         v = kk.is_signed ? B.CreateSExtOrTrunc(v, c.def_ty(tex->def.bit_size, tex->def.num_components))
+                          : B.CreateZExtOrTrunc(v, c.def_ty(tex->def.bit_size, tex->def.num_components));
+      }
+      set_def(c, &tex->def, to_int(c, v));
+      return;
+   }
+   case nir_texop_lod: {
+      if (!S || !coord) { c.fail("lod srcs"); return; }
+      nir_src *bias = tsrc(tex, nir_tex_src_bias), *mn = tsrc(tex, nir_tex_src_min_lod),
+              *mx = tsrc(tex, nir_tex_src_max_lod_kk);
+      if (!bias || !mn || !mx) { c.fail("lod srcs kk"); return; }
+      Value *cl = c.call("air.calculate_clamped_lod_" + stem, f32, {T, S, coord, zero}, A_SAMPLE, true);
+      Value *ul = c.call("air.calculate_unclamped_lod_" + stem, f32, {T, S, coord, zero}, A_SAMPLE, true);
+      IRBuilder<>::FastMathFlagGuard g(B);
+      FastMathFlags f;
+      f.setFast();
+      B.setFastMathFlags(f);
+      Value *x = B.CreateFAdd(cl, f32_src(c, bias, 1));
+      x = c.call("air.fast_fmax.f32", f32, {x, f32_src(c, mn, 1)}, A_PURE, true);
+      x = c.call("air.fast_fmin.f32", f32, {x, f32_src(c, mx, 1)}, A_PURE, true);
+      Value *v = build_vec(c, {x, ul});
+      if (tex->def.bit_size != 32) { c.fail("lod bits"); return; }
+      set_def(c, &tex->def, to_int(c, first_n(c, v, tex->def.num_components)));
+      return;
+   }
+   default:
+      c.fail("texop");
+      return;
+   }
+}
+
+static void
+emit_image(air_ctx &c, nir_intrinsic_instr *in)
+{
+   IRBuilder<> &B = c.B;
+   tex_info ti;
+   if (!handle_info(c, in->src[0].ssa, ti)) {
+      c.fail("image handle");
+      return;
+   }
+   if (ti.depth) { c.fail("depth image"); return; }
+   Value *T = get_src(c, &in->src[0]);
+   Type *i32 = c.t_i32;
+   Value *zero = ConstantInt::get(i32, 0);
+   std::string stem = ti.stem;
+   enum glsl_sampler_dim dim = ti.dim;
+   elem_kind k;
+   if (!tex_elem(c, ti.type, k)) { c.fail("image elem"); return; }
+
+   if (in->intrinsic == nir_intrinsic_bindless_image_levels) {
+      set_def(c, &in->def, c.call("air.get_num_mip_levels_" + stem, i32, {T}, A_READ));
+      return;
+   }
+   if (in->intrinsic == nir_intrinsic_bindless_image_fence_kk) {
+      c.call("air.fence_" + stem, Type::getVoidTy(c.C), {T}, A_SIDE);
+      return;
+   }
+
+   bool cube = dim == GLSL_SAMPLER_DIM_CUBE;
+   if (cube && ti.array) { c.fail("cube array image"); return; }
+   unsigned nc = dim_coord_comps(dim);
+   unsigned ncoord = cube ? 2 : nc;
+   Value *cv = get_src(c, &in->src[1]);
+   std::vector<Value *> cs;
+   for (unsigned i = 0; i < ncoord; i++)
+      cs.push_back(extract(c, cv, i));
+   Value *coord = B.CreateZExtOrTrunc(build_vec(c, cs), c.vec_ty(i32, ncoord));
+   std::vector<Value *> extra;
+   if (cube)
+      extra.push_back(B.CreateZExtOrTrunc(extract(c, cv, 2), i32));
+   if (ti.array)
+      extra.push_back(B.CreateZExtOrTrunc(extract(c, cv, nc), i32));
+   bool ms = dim == GLSL_SAMPLER_DIM_MS;
+   bool buf = dim == GLSL_SAMPLER_DIM_BUF;
+   Value *acc = ConstantInt::get(i32, ti.access);
+   std::string dc = ti.coherent ? ".device_coherent" : "";
+
+   switch (in->intrinsic) {
+   case nir_intrinsic_bindless_image_load: {
+      Type *ret = StructType::get(c.C, {FixedVectorType::get(k.et, 4), c.t_i8});
+      Value *rs = c.call("air.get_read_sampler", c.t_sampler_ptr, {}, A_INACC);
+      std::vector<Value *> a = {T, rs, coord};
+      a.insert(a.end(), extra.begin(), extra.end());
+      if (ms) {
+         a.push_back(B.CreateZExtOrTrunc(extract(c, get_src(c, &in->src[2]), 0), i32));
+      } else if (!buf) {
+         if (dim_has_offset(dim))
+            a.push_back(zero_offset(c, ncoord));
+         a.push_back(B.CreateZExtOrTrunc(extract(c, get_src(c, &in->src[3]), 0), i32));
+      }
+      a.push_back(acc);
+      Value *res = c.call("air.read_" + stem + dc + "." + k.sfx, ret, a, A_READ);
+      set_def(c, &in->def, tex_result(c, res, false, k, &in->def, nir_intrinsic_dest_type(in)));
+      return;
+   }
+   case nir_intrinsic_bindless_image_store: {
+      if (ms) { c.fail("ms store"); return; }
+      Value *v = get_src(c, &in->src[3]);
+      v = pad_vec(c, v, 4, Constant::getNullValue(v->getType()->getScalarType()));
+      unsigned vb = v->getType()->getScalarSizeInBits();
+      Type *want = FixedVectorType::get(k.et, 4);
+      if (k.is_float) {
+         v = to_float(c, v);
+         if (vb != k.et->getPrimitiveSizeInBits())
+            v = vb > k.et->getPrimitiveSizeInBits() ? B.CreateFPTrunc(v, want) : B.CreateFPExt(v, want);
+      } else if (vb != k.et->getIntegerBitWidth()) {
+         v = B.CreateTrunc(v, want);
+      }
+      std::vector<Value *> a = {T, coord};
+      a.insert(a.end(), extra.begin(), extra.end());
+      a.push_back(v);
+      if (!buf)
+         a.push_back(B.CreateZExtOrTrunc(extract(c, get_src(c, &in->src[4]), 0), i32));
+      a.push_back(acc);
+      c.call("air.write_" + stem + dc + "." + k.sfx, Type::getVoidTy(c.C), a, A_WRITE);
+      return;
+   }
+   case nir_intrinsic_bindless_image_atomic:
+   case nir_intrinsic_bindless_image_atomic_swap: {
+      if (k.is_float || k.et != i32) {
+         if (!(in->def.bit_size == 64 && nir_def_is_unused(&in->def))) {
+            c.fail("image atomic type");
+            return;
+         }
+      }
+      if (dim == GLSL_SAMPLER_DIM_1D || cube || ms) { c.fail("image atomic dim"); return; }
+      std::vector<Value *> a = {T, coord};
+      a.insert(a.end(), extra.begin(), extra.end());
+      if (!buf)
+         a.push_back(zero_offset(c, ncoord));
+      nir_atomic_op op = nir_intrinsic_atomic_op(in);
+      std::string sg = k.is_signed ? "s" : "u";
+      if (in->intrinsic == nir_intrinsic_bindless_image_atomic_swap) {
+         Type *vt = FixedVectorType::get(i32, 4);
+         AllocaInst *exp = entry_alloca(c, vt);
+         Value *cmp = extract(c, get_src(c, &in->src[3]), 0);
+         B.CreateStore(pad_vec(c, cmp, 4, cmp), exp);
+         Value *nv = extract(c, get_src(c, &in->src[4]), 0);
+         a.push_back(exp);
+         a.push_back(pad_vec(c, nv, 4, nv));
+         a.push_back(zero);
+         a.push_back(zero);
+         a.push_back(ConstantInt::get(i32, 3));
+         c.call("air.atomic_compare_exchange_weak_explicit_" + stem + "." + sg + ".v4i32", c.t_i1, a, A_SIDE);
+         set_def(c, &in->def, B.CreateExtractElement(B.CreateLoad(vt, exp), (uint64_t)0));
+         return;
+      }
+      const char *nm;
+      switch (op) {
+      case nir_atomic_op_iadd: nm = "fetch_add"; break;
+      case nir_atomic_op_imin: nm = "fetch_min"; sg = "s"; break;
+      case nir_atomic_op_umin: nm = "fetch_min"; sg = "u"; break;
+      case nir_atomic_op_imax: nm = "fetch_max"; sg = "s"; break;
+      case nir_atomic_op_umax: nm = "fetch_max"; sg = "u"; break;
+      case nir_atomic_op_iand: nm = "fetch_and"; break;
+      case nir_atomic_op_ior: nm = "fetch_or"; break;
+      case nir_atomic_op_ixor: nm = "fetch_xor"; break;
+      case nir_atomic_op_xchg: nm = "exchange"; break;
+      default: c.fail("image atomic op"); return;
+      }
+      Value *v = extract(c, get_src(c, &in->src[3]), 0);
+      if (in->def.bit_size == 64) {
+         if (op != nir_atomic_op_umin && op != nir_atomic_op_umax) { c.fail("image atomic64"); return; }
+         Type *vt = FixedVectorType::get(c.t_i64, 4);
+         a.push_back(pad_vec(c, v, 4, v));
+         a.push_back(zero);
+         a.push_back(ConstantInt::get(i32, 3));
+         c.call(std::string("air.atomic_") + (op == nir_atomic_op_umin ? "min" : "max") + "_explicit_" + stem + ".u.v4i64",
+                Type::getVoidTy(c.C), a, A_SIDE);
+         (void)vt;
+         set_def(c, &in->def, ConstantInt::get(c.t_i64, 0));
+         return;
+      }
+      a.push_back(pad_vec(c, v, 4, v));
+      a.push_back(zero);
+      a.push_back(ConstantInt::get(i32, 3));
+      Value *r = c.call(std::string("air.atomic_") + nm + "_explicit_" + stem + "." + sg + ".v4i32",
+                        FixedVectorType::get(i32, 4), a, A_SIDE);
+      set_def(c, &in->def, B.CreateExtractElement(r, (uint64_t)0));
+      return;
+   }
+   default:
+      c.fail("image op");
+      return;
+   }
+}
+
+} /* namespace */
