+namespace {
+
+static bool
+env_flag(const char *name)
+{
+   return getenv(name) != NULL;
+}
+
+static mem_qual
+global_qual(air_ctx &c, enum gl_access_qualifier access)
+{
+   if ((access & ACCESS_CAN_SPECULATE) && !(access & (ACCESS_COHERENT | ACCESS_VOLATILE)))
+      return Q_DEVICE;
+   static int cached = -1;
+   if (cached < 0)
+      cached = env_flag("CIDRE_LECTURES_CACHEES");
+   if (!(c.wa & BITFIELD64_BIT(6)) && cached &&
+       !(access & (ACCESS_COHERENT | ACCESS_VOLATILE | ACCESS_ATOMIC)) &&
+       ((access & ACCESS_NON_WRITEABLE) || !c.s->info.writes_memory))
+      return Q_DEVICE;
+   if (!(c.wa & BITFIELD64_BIT(6)))
+      return Q_COHERENT;
+   if (access & ACCESS_VOLATILE) {
+      bool drop = !(c.wa & BITFIELD64_BIT(15));
+      if ((access & ACCESS_COHERENT) && !drop)
+         return Q_VOLATILE_COHERENT;
+      return Q_VOLATILE;
+   }
+   return (access & ACCESS_COHERENT) ? Q_COHERENT : Q_DEVICE;
+}
+
+static Value *
+addr_add(air_ctx &c, Value *addr, uint64_t off)
+{
+   if (!off)
+      return addr;
+   return c.B.CreateAdd(addr, ConstantInt::get(addr->getType(), off));
+}
+
+static Value *
+to_ptr(air_ctx &c, Value *addr, Type *elem, unsigned as)
+{
+   addr = c.B.CreateZExtOrTrunc(addr, c.t_i64);
+   return c.B.CreateIntToPtr(addr, PointerType::get(elem, as));
+}
+
+static Value *
+load_mem(air_ctx &c, Value *addr, unsigned as, unsigned bits, unsigned n,
+         unsigned align, mem_qual q)
+{
+   Type *et = c.int_ty(bits);
+   unsigned bytes = bits / 8;
+   if (q == Q_COHERENT || q == Q_VOLATILE_COHERENT) {
+      std::string nm = std::string("air.load.device_coherent.") +
+                       (q == Q_VOLATILE_COHERENT ? "volatile." : "") + "i" +
+                       std::to_string(bits) + ".p1i" + std::to_string(bits);
+      std::vector<Value *> cs;
+      for (unsigned i = 0; i < n; i++) {
+         Value *p = to_ptr(c, addr_add(c, addr, i * bytes), et, 1);
+         cs.push_back(c.call(nm, et, {p}, A_READ));
+      }
+      return build_vec(c, cs);
+   }
+   Type *vt = c.vec_ty(et, n);
+   Value *p = to_ptr(c, addr, vt, as);
+   LoadInst *l = c.B.CreateAlignedLoad(vt, p, Align(MAX2(align, 1)));
+   if (q == Q_VOLATILE)
+      l->setVolatile(true);
+   return l;
+}
+
+static void
+store_mem(air_ctx &c, Value *addr, unsigned as, Value *val, unsigned wrmask,
+          unsigned align, mem_qual q)
+{
+   Type *vt = val->getType();
+   unsigned n = vt->isVectorTy() ? cast<FixedVectorType>(vt)->getNumElements() : 1;
+   Type *et = vt->getScalarType();
+   unsigned bits = et->getIntegerBitWidth();
+   unsigned bytes = bits / 8;
+   unsigned full = BITFIELD_MASK(n);
+   if (q == Q_COHERENT || q == Q_VOLATILE_COHERENT) {
+      std::string nm = std::string("air.store.device_coherent.") +
+                       (q == Q_VOLATILE_COHERENT ? "volatile." : "") + "i" +
+                       std::to_string(bits) + ".p1i" + std::to_string(bits);
+      for (unsigned i = 0; i < n; i++) {
+         if (!(wrmask & (1u << i)))
+            continue;
+         Value *p = to_ptr(c, addr_add(c, addr, i * bytes), et, 1);
+         c.call(nm, Type::getVoidTy(c.C), {extract(c, val, i), p}, A_WRITE);
+      }
+      return;
+   }
+   if ((wrmask & full) == full) {
+      Value *p = to_ptr(c, addr, vt, as);
+      StoreInst *st = c.B.CreateAlignedStore(val, p, Align(MAX2(align, 1)));
+      if (q == Q_VOLATILE)
+         st->setVolatile(true);
+      return;
+   }
+   for (unsigned i = 0; i < n; i++) {
+      if (!(wrmask & (1u << i)))
+         continue;
+      Value *p = to_ptr(c, addr_add(c, addr, i * bytes), et, as);
+      StoreInst *st = c.B.CreateAlignedStore(extract(c, val, i), p, Align(bytes));
+      if (q == Q_VOLATILE)
+         st->setVolatile(true);
+   }
+}
+
+static unsigned
+intr_align(nir_intrinsic_instr *in, unsigned bits, unsigned n)
+{
+   unsigned a = nir_intrinsic_has_align_mul(in) ? nir_intrinsic_align(in) : bits / 8;
+   unsigned total = (bits / 8) * util_next_power_of_two(n);
+   return MAX2(MIN2(a, total), 1);
+}
