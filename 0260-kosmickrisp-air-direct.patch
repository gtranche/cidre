+/* Banc hors ligne (Cidre) : retraduit un NIR vide par CIDRE_AIR_DUMP_NIR. */
+PUBLIC int cidre_air_hors_ligne(const char *path, const char *out_metallib,
+                                char *reason, size_t reason_len, double *ms);
+PUBLIC int
+cidre_air_hors_ligne(const char *path, const char *out_metallib, char *reason,
+                     size_t reason_len, double *ms)
+{
+   FILE *f = fopen(path, "rb");
+   if (!f)
+      return -1;
+   fseek(f, 0, SEEK_END);
+   long n = ftell(f);
+   fseek(f, 0, SEEK_SET);
+   void *buf = malloc(n);
+   if (fread(buf, 1, n, f) != (size_t)n) {
+      fclose(f);
+      free(buf);
+      return -1;
+   }
+   fclose(f);
+   struct blob_reader br;
+   blob_reader_init(&br, buf, n);
+   struct air_options ao = {.disabled_workarounds = blob_read_uint64(&br)};
+   blob_copy_bytes(&br, ao.rts_component_count, sizeof(ao.rts_component_count));
+   glsl_type_singleton_init_or_ref();
+   nir_shader *nir = nir_deserialize(NULL, &kk_nir_options, &br);
+   free(buf);
+   if (!nir)
+      return -1;
+   struct air_output air = {0};
+   uint64_t t0 = os_time_get_nano();
+   bool ok = nir_to_air(nir, &ao, getenv("CIDRE_AIR_DUMP_LL") != NULL, &air);
+   *ms = (os_time_get_nano() - t0) / 1e6;
+   if (!ok)
+      snprintf(reason, reason_len, "%s", air.reason);
+   if (ok && out_metallib) {
+      FILE *o = fopen(out_metallib, "wb");
+      if (o) {
+         fwrite(air.metallib, 1, air.metallib_size, o);
+         fclose(o);
+      }
+   }
+   if (air.ll && out_metallib) {
+      char p[1024];
+      snprintf(p, sizeof(p), "%s.ll", out_metallib);
+      FILE *o = fopen(p, "w");
+      if (o) {
+         fputs(air.ll, o);
+         fclose(o);
+      }
+   }
+   nir_to_air_free(&air);
+   ralloc_free(nir);
+   return ok ? 1 : 0;
+}
