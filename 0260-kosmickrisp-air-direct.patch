+static void
+emit_return(air_ctx &c);
+
+static void
+new_dead_block(air_ctx &c)
+{
+   BasicBlock *bb = BasicBlock::Create(c.C, "", c.F);
+   c.B.SetInsertPoint(bb);
+}
+
+static Value *
+input_value(air_ctx &c, unsigned loc, unsigned comp, bool *scal)
+{
+   *scal = slot_scalarized(loc);
+   auto it = c.fs_inputs.find({loc, *scal ? comp : 0});
+   if (it == c.fs_inputs.end()) {
+      c.fail("fs input");
+      return nullptr;
+   }
+   return it->second;
+}
+
+static Value *
+emit_interp(air_ctx &c, nir_intrinsic_instr *in)
+{
+   unsigned idx = nir_src_as_uint(in->src[1]);
+   nir_io_semantics io = nir_intrinsic_io_semantics(in);
+   unsigned comp = nir_intrinsic_component(in);
+   unsigned loc = io.location + idx;
+   bool scal;
+   Value *v = input_value(c, loc, comp, &scal);
+   if (!v)
+      return nullptr;
+   if (c.in_info[loc].uses_interpolant) {
+      nir_intrinsic_instr *bi = nir_src_as_intrinsic(in->src[0]);
+      const io_info &ii = c.in_info[loc];
+      Type *mt = c.vec_ty(c.flt_scalar(nir_alu_type_get_type_size(ii.type) == 16 ? 16 : 32),
+                          scal ? 1 : ii.num_components);
+      const char *persp = ii.interpolation == INTERP_MODE_NOPERSPECTIVE ? "no_perspective" : "perspective";
+      std::string sfx = std::string(persp) + "." + fsuffix(mt);
+      switch (bi->intrinsic) {
+      case nir_intrinsic_load_barycentric_pixel:
+         v = c.call("air.interpolate_center_" + sfx, mt, {v}, A_READ, true);
+         break;
+      case nir_intrinsic_load_barycentric_centroid:
+         v = c.call("air.interpolate_centroid_" + sfx, mt, {v}, A_READ, true);
+         break;
+      case nir_intrinsic_load_barycentric_at_sample:
+         v = c.call("air.interpolate_sample_" + sfx, mt, {v, get_src(c, &bi->src[0])}, A_READ, true);
+         break;
+      case nir_intrinsic_load_barycentric_at_offset: {
+         IRBuilder<>::FastMathFlagGuard g(c.B);
+         FastMathFlags f;
+         f.setFast();
+         c.B.setFastMathFlags(f);
+         Value *o = to_float(c, get_src(c, &bi->src[0]));
+         o = c.B.CreateFAdd(o, ConstantFP::get(o->getType(), 0.5));
+         v = c.call("air.interpolate_offset_" + sfx, mt, {v, o}, A_READ, true);
+         break;
+      }
+      default:
+         c.fail("interp kind");
+         return nullptr;
+      }
+   }
+   v = to_int(c, v);
+   if (scal)
+      return v;
+   unsigned have = v->getType()->isVectorTy() ? cast<FixedVectorType>(v->getType())->getNumElements() : 1;
+   if (in->num_components == have && comp == 0)
+      return v;
+   std::vector<Value *> cs;
+   for (unsigned i = 0; i < in->num_components; i++)
+      cs.push_back(extract(c, v, comp + i));
+   return build_vec(c, cs);
+}
+
+static void
+emit_store_output(air_ctx &c, nir_intrinsic_instr *in)
+{
+   unsigned idx = nir_src_as_uint(in->src[1]);
+   nir_io_semantics io = nir_intrinsic_io_semantics(in);
+   unsigned loc = io.location + idx;
+   unsigned wm = nir_intrinsic_write_mask(in);
+   unsigned comp = nir_intrinsic_component(in);
+   Value *src = get_src(c, &in->src[0]);
+   bool scal = c.s->info.stage == MESA_SHADER_VERTEX && slot_scalarized(loc);
+   for (unsigned i = 0; i < in->num_components; i++) {
+      if (!(wm & (1u << i)))
+         continue;
+      unsigned dc = comp + i;
+      auto it = c.out_index.find({loc, scal ? dc : 0});
+      if (it == c.out_index.end()) {
+         c.fail("output slot");
+         return;
+      }
+      out_member &m = c.outs[it->second];
+      Value *sv = extract(c, src, i);
+      Type *et = m.ty->getScalarType();
+      if (et->isFloatingPointTy())
+         sv = to_float(c, sv);
+      if (sv->getType() != et) {
+         if (sv->getType()->getPrimitiveSizeInBits() == et->getPrimitiveSizeInBits())
+            sv = c.B.CreateBitCast(sv, et);
+         else {
+            c.fail("output type");
+            return;
+         }
+      }
+      if (m.ty->isVectorTy()) {
+         unsigned mn = cast<FixedVectorType>(m.ty)->getNumElements();
+         if (dc >= mn)
+            continue;
+         Value *cur = c.B.CreateLoad(m.ty, m.slot);
+         cur = c.B.CreateInsertElement(cur, sv, (uint64_t)dc);
+         c.B.CreateStore(cur, m.slot);
+      } else {
+         if (!scal && dc != 0)
+            continue;
+         c.B.CreateStore(sv, m.slot);
+      }
+   }
+}
+
+static Value *sysval_or_fail(air_ctx &c, gl_system_value sv)
+{
+   if (!c.sysval[sv]) {
+      c.fail("sysval");
+      return ConstantInt::get(c.t_i32, 0);
+   }
+   return c.sysval[sv];
+}
+
+static void emit_image(air_ctx &c, nir_intrinsic_instr *in);
+
+static void
+emit_intrinsic(air_ctx &c, nir_intrinsic_instr *in)
+{
+   IRBuilder<> &B = c.B;
+   nir_def *def = &in->def;
+   unsigned bits = def->bit_size, n = def->num_components;
+   Value *r = nullptr;
+
+   switch (in->intrinsic) {
+   case nir_intrinsic_load_barycentric_pixel:
+   case nir_intrinsic_load_barycentric_centroid:
+   case nir_intrinsic_load_barycentric_sample:
+   case nir_intrinsic_load_barycentric_at_sample:
+   case nir_intrinsic_load_barycentric_at_offset:
+      return;
+
+   case nir_intrinsic_load_subgroup_size:
+      if (c.s->info.stage == MESA_SHADER_VERTEX)
+         r = ConstantInt::get(c.t_i32, 32);
+      else
+         r = sysval_or_fail(c, SYSTEM_VALUE_SUBGROUP_SIZE);
+      break;
+   case nir_intrinsic_load_subgroup_invocation:
+      if (c.s->info.stage == MESA_SHADER_VERTEX)
+         r = c.call("air.simd_prefix_exclusive_sum.u.i32", c.t_i32, {ConstantInt::get(c.t_i32, 1)}, A_CONV);
+      else
+         r = sysval_or_fail(c, SYSTEM_VALUE_SUBGROUP_INVOCATION);
+      break;
+   case nir_intrinsic_load_num_subgroups: r = sysval_or_fail(c, SYSTEM_VALUE_NUM_SUBGROUPS); break;
+   case nir_intrinsic_load_subgroup_id: r = sysval_or_fail(c, SYSTEM_VALUE_SUBGROUP_ID); break;
+   case nir_intrinsic_load_workgroup_id: r = sysval_or_fail(c, SYSTEM_VALUE_WORKGROUP_ID); break;
+   case nir_intrinsic_load_local_invocation_id: r = sysval_or_fail(c, SYSTEM_VALUE_LOCAL_INVOCATION_ID); break;
+   case nir_intrinsic_load_global_invocation_id: r = sysval_or_fail(c, SYSTEM_VALUE_GLOBAL_INVOCATION_ID); break;
+   case nir_intrinsic_load_num_workgroups: r = sysval_or_fail(c, SYSTEM_VALUE_NUM_WORKGROUPS); break;
+   case nir_intrinsic_load_local_invocation_index: r = sysval_or_fail(c, SYSTEM_VALUE_LOCAL_INVOCATION_INDEX); break;
+   case nir_intrinsic_load_frag_coord: r = to_int(c, sysval_or_fail(c, SYSTEM_VALUE_FRAG_COORD)); break;
+   case nir_intrinsic_load_point_coord: r = to_int(c, sysval_or_fail(c, SYSTEM_VALUE_POINT_COORD)); break;
+   case nir_intrinsic_load_first_vertex: r = sysval_or_fail(c, SYSTEM_VALUE_FIRST_VERTEX); break;
+   case nir_intrinsic_load_vertex_id: r = sysval_or_fail(c, SYSTEM_VALUE_VERTEX_ID); break;
+   case nir_intrinsic_load_instance_id: r = sysval_or_fail(c, SYSTEM_VALUE_INSTANCE_ID); break;
+   case nir_intrinsic_load_base_instance: r = sysval_or_fail(c, SYSTEM_VALUE_BASE_INSTANCE); break;
+   case nir_intrinsic_load_front_face: r = sysval_or_fail(c, SYSTEM_VALUE_FRONT_FACE); break;
+   case nir_intrinsic_load_layer_id: r = sysval_or_fail(c, SYSTEM_VALUE_LAYER_ID); break;
+   case nir_intrinsic_load_sample_id: r = sysval_or_fail(c, SYSTEM_VALUE_SAMPLE_ID); break;
+   case nir_intrinsic_load_sample_mask_in: r = sysval_or_fail(c, SYSTEM_VALUE_SAMPLE_MASK_IN); break;
+   case nir_intrinsic_load_primitive_id: r = sysval_or_fail(c, SYSTEM_VALUE_PRIMITIVE_ID); break;
+   case nir_intrinsic_load_barycentric_coord_pixel: r = to_int(c, sysval_or_fail(c, SYSTEM_VALUE_BARYCENTRIC_PERSP_COORD)); break;
+   case nir_intrinsic_load_amplification_id_kk: r = sysval_or_fail(c, SYSTEM_VALUE_AMPLIFICATION_ID_KK); break;
+   case nir_intrinsic_load_sample_pos:
+      r = to_int(c, c.call("air.get_sample_position.v2f32", c.vec_ty(c.t_f32, 2),
+                           {sysval_or_fail(c, SYSTEM_VALUE_SAMPLE_ID), ConstantInt::get(c.t_i32, 0)}, A_PURE, true));
+      break;
+   case nir_intrinsic_load_sample_pos_from_id:
+      r = to_int(c, c.call("air.get_sample_position.v2f32", c.vec_ty(c.t_f32, 2),
+                           {get_src(c, &in->src[0]), ConstantInt::get(c.t_i32, 0)}, A_PURE, true));
+      break;
+   case nir_intrinsic_load_helper_invocation:
+   case nir_intrinsic_is_helper_invocation:
+      r = c.call("air.simd_is_helper_thread", c.t_i1, {}, A_CONV);
+      break;
+   case nir_intrinsic_ddx:
+   case nir_intrinsic_ddx_coarse:
+   case nir_intrinsic_ddx_fine:
+   case nir_intrinsic_ddy:
+   case nir_intrinsic_ddy_coarse:
+   case nir_intrinsic_ddy_fine: {
+      bool x = in->intrinsic == nir_intrinsic_ddx || in->intrinsic == nir_intrinsic_ddx_coarse ||
+               in->intrinsic == nir_intrinsic_ddx_fine;
+      Value *v = to_float(c, get_src(c, &in->src[0]));
+      r = to_int(c, c.call(std::string(x ? "air.dfdx." : "air.dfdy.") + fsuffix(v->getType()),
+                           v->getType(), {v}, A_CONV, true));
+      break;
+   }
+   case nir_intrinsic_load_interpolated_input:
+   case nir_intrinsic_load_input: {
+      if (in->intrinsic == nir_intrinsic_load_input) {
+         unsigned idx = nir_src_as_uint(in->src[0]);
+         nir_io_semantics io = nir_intrinsic_io_semantics(in);
+         unsigned comp = nir_intrinsic_component(in);
+         unsigned loc = io.location + idx;
+         bool scal;
+         Value *v = input_value(c, loc, comp, &scal);
+         if (!v)
+            return;
+         v = to_int(c, v);
+         if (!scal) {
+            std::vector<Value *> cs;
+            for (unsigned i = 0; i < in->num_components; i++)
+               cs.push_back(extract(c, v, comp + i));
+            v = build_vec(c, cs);
+         }
+         r = v;
+      } else {
+         r = emit_interp(c, in);
+         if (!r)
+            return;
+      }
+      break;
+   }
+   case nir_intrinsic_store_output:
+      emit_store_output(c, in);
+      return;
+   case nir_intrinsic_load_output: {
+      if (c.s->info.stage != MESA_SHADER_FRAGMENT) { c.fail("load_output stage"); return; }
+      nir_io_semantics io = nir_intrinsic_io_semantics(in);
+      unsigned loc = io.location;
+      Value *v;
+      if (c.s->info.outputs_written & BITFIELD64_BIT(loc)) {
+         auto it = c.out_index.find({loc, 0});
+         if (it == c.out_index.end()) { c.fail("load_output slot"); return; }
+         v = B.CreateLoad(c.outs[it->second].ty, c.outs[it->second].slot);
+      } else {
+         auto it = c.fb_inputs.find(loc);
+         if (it == c.fb_inputs.end()) { c.fail("load_output input"); return; }
+         v = it->second;
+      }
+      v = to_int(c, v);
+      Type *et = v->getType()->getScalarType();
+      bool isf = c.out_info[loc].type == nir_type_float32 || c.out_info[loc].type == nir_type_float16;
+      Value *one = isf ? (Value *)to_int(c, ConstantFP::get(c.flt_scalar(et->getIntegerBitWidth()), 1.0)) : ConstantInt::get(et, 1);
+      unsigned have = v->getType()->isVectorTy() ? cast<FixedVectorType>(v->getType())->getNumElements() : 1;
+      std::vector<Value *> cs;
+      for (unsigned i = 0; i < 4; i++)
+         cs.push_back(i < have ? extract(c, v, i) : (i == 3 ? one : ConstantInt::get(et, 0)));
+      unsigned comp = nir_intrinsic_component(in);
+      std::vector<Value *> rc;
+      for (unsigned i = 0; i < n; i++)
+         rc.push_back(cs[MIN2(comp + i, 3)]);
+      r = build_vec(c, rc);
+      break;
+   }
+   case nir_intrinsic_store_clip_distance_kk: {
+      if (c.clip_member < 0) {
+         c.fail("clip distance");
+         return;
+      }
+      out_member &m = c.outs[c.clip_member];
+      Value *p = B.CreateInBoundsGEP(m.ty, m.slot, {ConstantInt::get(c.t_i32, 0), ConstantInt::get(c.t_i32, nir_intrinsic_base(in))});
+      B.CreateStore(to_float(c, extract(c, get_src(c, &in->src[0]), 0)), p);
+      return;
+   }
+   case nir_intrinsic_load_buffer_ptr_kk:
+      if (nir_intrinsic_binding(in) != 0) {
+         c.fail("buffer binding");
+         return;
+      }
+      r = B.CreatePtrToInt(c.buf0, c.t_i64);
+      break;
+   case nir_intrinsic_load_per_draw_ptr_kk:
+      r = B.CreatePtrToInt(c.per_draw, c.t_i64);
+      break;
+   case nir_intrinsic_load_atomic64_locks_ptr_kk:
+      r = B.CreatePtrToInt(c.locks, c.t_i64);
+      break;
+   case nir_intrinsic_load_ro_sink_address_poly:
+      r = ConstantInt::get(c.t_i64, 0);
+      break;
+
+   case nir_intrinsic_load_global: {
+      enum gl_access_qualifier acc = nir_intrinsic_access(in);
+      mem_qual q = global_qual(c, acc);
+      Value *a = get_src(c, &in->src[0]);
+      if (acc & ACCESS_ATOMIC) {
+         if (bits != 32) { c.fail("atomic load bits"); return; }
+         r = c.call("air.atomic.global.load.i32", c.t_i32,
+                    {to_ptr(c, a, c.t_i32, 1), ConstantInt::get(c.t_i32, 0), ConstantInt::get(c.t_i32, 2), B.getTrue()}, A_SIDE);
+      } else {
+         r = load_mem(c, a, 1, bits, n, bits / 8, q);
+      }
+      break;
+   }
+   case nir_intrinsic_load_global_constant:
+      r = load_mem(c, get_src(c, &in->src[0]), 2, bits, n, bits / 8, Q_CONSTANT);
+      break;
+   case nir_intrinsic_load_global_constant_offset: {
+      enum gl_access_qualifier acc = nir_intrinsic_access(in);
+      static int dc = -1;
+      if (dc < 0)
+         dc = env_flag("CIDRE_DESCRIPTEURS_CONSTANT");
+      mem_qual q = dc && !(acc & (ACCESS_ATOMIC | ACCESS_COHERENT | ACCESS_VOLATILE)) ? Q_CONSTANT : global_qual(c, acc);
+      Value *a = B.CreateAdd(get_src(c, &in->src[0]), B.CreateZExtOrTrunc(get_src(c, &in->src[1]), c.t_i64));
+      if (acc & ACCESS_ATOMIC) {
+         if (bits != 32) { c.fail("atomic load bits"); return; }
+         r = c.call("air.atomic.global.load.i32", c.t_i32,
+                    {to_ptr(c, a, c.t_i32, q == Q_CONSTANT ? 2 : 1), ConstantInt::get(c.t_i32, 0), ConstantInt::get(c.t_i32, 2), B.getTrue()}, A_SIDE);
+      } else {
+         r = load_mem(c, a, q == Q_CONSTANT ? 2 : 1, bits, n, bits / 8, q);
+      }
+      break;
+   }
+   case nir_intrinsic_load_global_constant_bounded: {
+      Value *base = get_src(c, &in->src[0]);
+      Value *off = get_src(c, &in->src[1]);
+      Value *bound = get_src(c, &in->src[2]);
+      Value *cond = B.CreateICmpULT(off, bound);
+      BasicBlock *cur = B.GetInsertBlock();
+      BasicBlock *ld = BasicBlock::Create(c.C, "", c.F);
+      BasicBlock *join = BasicBlock::Create(c.C, "", c.F);
+      B.CreateCondBr(cond, ld, join);
+      B.SetInsertPoint(ld);
+      Value *a = B.CreateAdd(base, B.CreateZExtOrTrunc(off, c.t_i64));
+      Value *v = load_mem(c, a, 2, bits, n, bits / 8, Q_CONSTANT);
+      BasicBlock *ldend = B.GetInsertBlock();
+      B.CreateBr(join);
+      B.SetInsertPoint(join);
+      PHINode *p = B.CreatePHI(v->getType(), 2);
+      p->addIncoming(v, ldend);
+      p->addIncoming(Constant::getNullValue(v->getType()), cur);
+      r = p;
+      break;
+   }
+   case nir_intrinsic_store_global: {
+      enum gl_access_qualifier acc = nir_intrinsic_access(in);
+      mem_qual q = global_qual(c, acc);
+      Value *v = get_src(c, &in->src[0]);
+      Value *a = get_src(c, &in->src[1]);
+      if (acc & ACCESS_ATOMIC) {
+         if (in->src[0].ssa->bit_size != 32) { c.fail("atomic store bits"); return; }
+         c.call("air.atomic.global.store.i32", Type::getVoidTy(c.C),
+                {to_ptr(c, a, c.t_i32, 1), extract(c, v, 0), ConstantInt::get(c.t_i32, 0), ConstantInt::get(c.t_i32, 2), B.getTrue()}, A_SIDE);
+      } else {
+         store_mem(c, a, 1, v, nir_intrinsic_write_mask(in), in->src[0].ssa->bit_size / 8, q);
+      }
+      return;
+   }
+   case nir_intrinsic_global_atomic: {
+      Value *a = get_src(c, &in->src[0]);
+      r = emit_mem_atomic(c, in, to_ptr(c, a, c.int_ty(bits), 1), get_src(c, &in->src[1]), false, bits);
+      if (!r) return;
+      if (r->getType() != c.int_ty(bits))
+         r = B.CreateZExtOrTrunc(r, c.int_ty(bits));
+      break;
+   }
+   case nir_intrinsic_global_atomic_swap: {
+      Value *a = get_src(c, &in->src[0]);
+      r = emit_mem_cmpxchg(c, to_ptr(c, a, c.int_ty(bits), 1), get_src(c, &in->src[1]), get_src(c, &in->src[2]), false, bits);
+      if (!r) return;
+      break;
+   }
+   case nir_intrinsic_load_shared: {
+      Type *t = c.def_ty(bits, n);
+      Value *p = shared_addr(c, get_src(c, &in->src[0]), nir_intrinsic_base(in), t);
+      r = B.CreateAlignedLoad(t, p, Align(intr_align(in, bits, n)));
+      break;
+   }
+   case nir_intrinsic_store_shared: {
+      Value *v = get_src(c, &in->src[0]);
+      unsigned wm = nir_intrinsic_write_mask(in);
+      unsigned sb = in->src[0].ssa->bit_size, sn = in->src[0].ssa->num_components;
+      Value *off = get_src(c, &in->src[1]);
+      if ((wm & BITFIELD_MASK(sn)) == BITFIELD_MASK(sn)) {
+         Value *p = shared_addr(c, off, nir_intrinsic_base(in), v->getType());
+         B.CreateAlignedStore(v, p, Align(intr_align(in, sb, sn)));
+      } else {
+         for (unsigned i = 0; i < sn; i++) {
+            if (!(wm & (1u << i)))
+               continue;
+            Value *p = shared_addr(c, off, nir_intrinsic_base(in) + i * sb / 8, c.int_ty(sb));
+            B.CreateAlignedStore(extract(c, v, i), p, Align(sb / 8));
+         }
+      }
+      return;
+   }
+   case nir_intrinsic_shared_atomic: {
+      Value *p = shared_addr(c, get_src(c, &in->src[0]), nir_intrinsic_base(in), c.int_ty(bits));
+      r = emit_mem_atomic(c, in, p, get_src(c, &in->src[1]), true, bits);
+      if (!r) return;
+      break;
+   }
+   case nir_intrinsic_shared_atomic_swap: {
+      Value *p = shared_addr(c, get_src(c, &in->src[0]), nir_intrinsic_base(in), c.int_ty(bits));
+      r = emit_mem_cmpxchg(c, p, get_src(c, &in->src[1]), get_src(c, &in->src[2]), true, bits);
+      if (!r) return;
+      break;
+   }
+   case nir_intrinsic_load_scratch: {
+      if (!c.scratch) { c.fail("scratch"); return; }
+      Type *t = c.def_ty(bits, n);
+      r = B.CreateAlignedLoad(t, scratch_addr(c, get_src(c, &in->src[0]), t), Align(intr_align(in, bits, n)));
+      break;
+   }
+   case nir_intrinsic_store_scratch: {
+      if (!c.scratch) { c.fail("scratch"); return; }
+      Value *v = get_src(c, &in->src[0]);
+      unsigned wm = nir_intrinsic_write_mask(in);
+      unsigned sb = in->src[0].ssa->bit_size, sn = in->src[0].ssa->num_components;
+      Value *off = get_src(c, &in->src[1]);
+      for (unsigned i = 0; i < sn; i++) {
+         if (!(wm & (1u << i)))
+            continue;
+         Value *o = B.CreateAdd(B.CreateZExtOrTrunc(off, c.t_i32), ConstantInt::get(c.t_i32, i * sb / 8));
+         B.CreateAlignedStore(extract(c, v, i), scratch_addr(c, o, c.int_ty(sb)), Align(sb / 8));
+      }
+      return;
+   }
+   case nir_intrinsic_load_constant: {
+      if (!c.cdata) { c.fail("constant data"); return; }
+      Type *t = c.def_ty(bits, n);
+      Value *o = B.CreateZExtOrTrunc(get_src(c, &in->src[0]), c.t_i64);
+      o = addr_add(c, o, nir_intrinsic_base(in));
+      Value *bp = B.CreateBitCast(c.cdata, PointerType::get(c.t_i8, 2));
+      Value *p = B.CreateInBoundsGEP(c.t_i8, bp, {o});
+      p = B.CreateBitCast(p, PointerType::get(t, 2));
+      r = B.CreateAlignedLoad(t, p, Align(bits / 8));
+      break;
+   }
+   case nir_intrinsic_load_constant_agx: {
+      unsigned stride;
+      switch (nir_intrinsic_format(in)) {
+      case PIPE_FORMAT_R8_UINT: case PIPE_FORMAT_R8_SINT: stride = 1; break;
+      case PIPE_FORMAT_R16_FLOAT: case PIPE_FORMAT_R16_UINT: case PIPE_FORMAT_R16_SINT: stride = 2; break;
+      case PIPE_FORMAT_R32_FLOAT: case PIPE_FORMAT_R32_UINT: case PIPE_FORMAT_R32_SINT: stride = 4; break;
+      case PIPE_FORMAT_R64_UINT: case PIPE_FORMAT_R64_SINT: stride = 8; break;
+      default: c.fail("agx format"); return;
+      }
+      if (n == 1)
+         stride = bits / 8;
+      Value *base = get_src(c, &in->src[0]);
+      Value *idx = B.CreateZExtOrTrunc(get_src(c, &in->src[1]), c.t_i64);
+      Value *a = B.CreateAdd(base, B.CreateMul(idx, ConstantInt::get(c.t_i64, stride)));
+      r = load_mem(c, a, 2, bits, n, stride, Q_CONSTANT);
+      break;
+   }
+
+   case nir_intrinsic_load_texture_handle_kk:
+   case nir_intrinsic_load_depth_texture_kk: {
+      tex_info ti;
+      if (!handle_info(c, def, ti)) {
+         c.fail("texture handle kind");
+         return;
+      }
+      Value *a = get_src(c, &in->src[0]);
+      Value *p = to_ptr(c, a, c.t_i64, 2);
+      Value *h = B.CreateAlignedLoad(c.t_i64, p, Align(8));
+      r = B.CreateIntToPtr(h, tex_ptr_type(c, ti.stem));
+      set_def(c, def, r);
+      return;
+   }
+   case nir_intrinsic_load_sampler_handle_kk: {
+      Value *idx = B.CreateZExt(get_src(c, &in->src[0]), c.t_i64);
+      Value *p = B.CreateInBoundsGEP(c.t_sampler_table, c.sampler_table,
+                                     {ConstantInt::get(c.t_i64, 0), ConstantInt::get(c.t_i32, 0), idx, ConstantInt::get(c.t_i32, 0)});
+      r = B.CreateAlignedLoad(c.t_sampler_ptr, p, Align(8));
+      set_def(c, def, r);
+      return;
+   }
+
+   case nir_intrinsic_barrier: {
+      mesa_scope es = nir_intrinsic_execution_scope(in);
+      nir_variable_mode modes = nir_intrinsic_memory_modes(in);
+      unsigned fl = mem_flags(modes);
+      if (es == SCOPE_SUBGROUP) {
+         c.call("air.simdgroup.barrier", Type::getVoidTy(c.C), {ConstantInt::get(c.t_i32, fl), ConstantInt::get(c.t_i32, 4)}, A_CONV);
+      } else if (es == SCOPE_WORKGROUP) {
+         c.call("air.wg.barrier", Type::getVoidTy(c.C), {ConstantInt::get(c.t_i32, fl), ConstantInt::get(c.t_i32, 1)}, A_CONV);
+      } else if (es == SCOPE_NONE) {
+         if (!modes)
+            return;
+         unsigned scope;
+         switch (nir_intrinsic_memory_scope(in)) {
+         case SCOPE_SUBGROUP: scope = 4; break;
+         case SCOPE_WORKGROUP:
+            scope = (modes & (nir_var_mem_global | nir_var_mem_ssbo | nir_var_image)) ? 2 : 1;
+            break;
+         case SCOPE_QUEUE_FAMILY:
+         case SCOPE_DEVICE: scope = 2; break;
+         default: c.fail("fence scope"); return;
+         }
+         c.call("air.atomic.fence", Type::getVoidTy(c.C),
+                {ConstantInt::get(c.t_i32, fl), ConstantInt::get(c.t_i32, 5), ConstantInt::get(c.t_i32, scope)}, A_SIDE);
+      } else {
+         c.fail("barrier scope");
+      }
+      return;
+   }
+   case nir_intrinsic_demote:
+      c.call("air.discard_fragment", Type::getVoidTy(c.C), {}, A_SIDE);
+      return;
+   case nir_intrinsic_demote_if:
+   case nir_intrinsic_terminate_if: {
+      Value *cond = get_src(c, &in->src[0]);
+      BasicBlock *t = BasicBlock::Create(c.C, "", c.F);
+      BasicBlock *j = BasicBlock::Create(c.C, "", c.F);
+      B.CreateCondBr(cond, t, j);
+      B.SetInsertPoint(t);
+      c.call("air.discard_fragment", Type::getVoidTy(c.C), {}, A_SIDE);
+      if (in->intrinsic == nir_intrinsic_terminate_if)
+         emit_return(c);
+      else
+         B.CreateBr(j);
+      B.SetInsertPoint(j);
+      return;
+   }
+   case nir_intrinsic_terminate:
+      c.call("air.discard_fragment", Type::getVoidTy(c.C), {}, A_SIDE);
+      emit_return(c);
+      new_dead_block(c);
+      return;
+   case nir_intrinsic_printf_abort:
+      emit_return(c);
+      new_dead_block(c);
+      return;
+
+   case nir_intrinsic_ballot: {
+      Value *v = c.call("air.simd_ballot.i64", c.t_i64, {get_src(c, &in->src[0])}, A_CONV);
+      r = B.CreateZExtOrTrunc(v, c.int_ty(bits));
+      if (n > 1)
+         r = pad_vec(c, r, n, ConstantInt::get(c.int_ty(bits), 0));
+      break;
+   }
+   case nir_intrinsic_elect:
+      r = c.call("air.simd_is_first", c.t_i1, {}, A_CONV);
+      break;
+   case nir_intrinsic_read_first_invocation:
+      r = simd_val_call(c, "simd_broadcast_first", get_src(c, &in->src[0]), nullptr, nullptr);
+      break;
+   case nir_intrinsic_read_invocation:
+      r = simd_val_call(c, "simd_broadcast", get_src(c, &in->src[0]), get_src(c, &in->src[1]), nullptr);
+      break;
+   case nir_intrinsic_rotate:
+      r = simd_val_call(c, "simd_shuffle_rotate_down", get_src(c, &in->src[0]), get_src(c, &in->src[1]), nullptr);
+      break;
+   case nir_intrinsic_shuffle:
+      r = simd_val_call(c, "simd_shuffle", get_src(c, &in->src[0]), get_src(c, &in->src[1]), nullptr);
+      break;
+   case nir_intrinsic_shuffle_xor:
+      r = simd_val_call(c, "simd_shuffle_xor", get_src(c, &in->src[0]), get_src(c, &in->src[1]), nullptr);
+      break;
+   case nir_intrinsic_shuffle_up:
+      r = simd_val_call(c, "simd_shuffle_up", get_src(c, &in->src[0]), get_src(c, &in->src[1]), nullptr);
+      break;
+   case nir_intrinsic_shuffle_down:
+      r = simd_val_call(c, "simd_shuffle_down", get_src(c, &in->src[0]), get_src(c, &in->src[1]), nullptr);
+      break;
+   case nir_intrinsic_quad_broadcast:
+      r = simd_val_call(c, "quad_broadcast", get_src(c, &in->src[0]), get_src(c, &in->src[1]), nullptr);
+      break;
+   case nir_intrinsic_quad_swap_horizontal:
+   case nir_intrinsic_quad_swap_vertical:
+   case nir_intrinsic_quad_swap_diagonal: {
+      unsigned m = in->intrinsic == nir_intrinsic_quad_swap_horizontal ? 1 :
+                   in->intrinsic == nir_intrinsic_quad_swap_vertical ? 2 : 3;
+      r = simd_val_call(c, "quad_shuffle_xor", get_src(c, &in->src[0]), ConstantInt::get(c.t_i32, m), nullptr);
+      break;
+   }
+   case nir_intrinsic_vote_all:
+      r = c.call("air.simd_all", c.t_i1, {get_src(c, &in->src[0])}, A_CONV);
+      break;
+   case nir_intrinsic_vote_any:
+      r = c.call("air.simd_any", c.t_i1, {get_src(c, &in->src[0])}, A_CONV);
+      break;
+   case nir_intrinsic_quad_vote_all:
+      r = c.call("air.quad_all", c.t_i1, {get_src(c, &in->src[0])}, A_CONV);
+      break;
+   case nir_intrinsic_quad_vote_any:
+      r = c.call("air.quad_any", c.t_i1, {get_src(c, &in->src[0])}, A_CONV);
+      break;
+   case nir_intrinsic_reduce: {
+      const char *base, *kind;
+      switch (nir_intrinsic_reduction_op(in)) {
+      case nir_op_iadd: base = "simd_sum"; kind = "u"; break;
+      case nir_op_fadd: base = "simd_sum"; kind = "f"; break;
+      case nir_op_imul: base = "simd_product"; kind = "u"; break;
+      case nir_op_fmul: base = "simd_product"; kind = "f"; break;
+      case nir_op_imin: base = "simd_min"; kind = "s"; break;
+      case nir_op_umin: base = "simd_min"; kind = "u"; break;
+      case nir_op_fmin: base = "simd_min"; kind = "f"; break;
+      case nir_op_imax: base = "simd_max"; kind = "s"; break;
+      case nir_op_umax: base = "simd_max"; kind = "u"; break;
+      case nir_op_fmax: base = "simd_max"; kind = "f"; break;
+      case nir_op_iand: base = "simd_and"; kind = "u"; break;
+      case nir_op_ior: base = "simd_or"; kind = "u"; break;
+      case nir_op_ixor: base = "simd_xor"; kind = "u"; break;
+      default: c.fail("reduce op"); return;
+      }
+      r = simd_val_call(c, base, get_src(c, &in->src[0]), nullptr, kind);
+      break;
+   }
+
+   case nir_intrinsic_bindless_image_load:
+   case nir_intrinsic_bindless_image_store:
+   case nir_intrinsic_bindless_image_atomic:
+   case nir_intrinsic_bindless_image_atomic_swap:
+   case nir_intrinsic_bindless_image_levels:
+   case nir_intrinsic_bindless_image_fence_kk:
+      emit_image(c, in);
+      return;
+
+   default:
+      c.fail(std::string("intrinsic ") + nir_intrinsic_infos[in->intrinsic].name);
+      return;
+   }
+
+   if (!c.ok || !r)
+      return;
+   Type *want = c.def_ty(bits, n);
+   if (r->getType() != want) {
+      if (r->getType()->getPrimitiveSizeInBits() == want->getPrimitiveSizeInBits() &&
+          r->getType()->isVectorTy() == want->isVectorTy()) {
+         r = B.CreateBitCast(r, want);
+      } else if (!r->getType()->isVectorTy() && !want->isVectorTy() && r->getType()->isIntegerTy()) {
+         r = B.CreateZExtOrTrunc(r, want);
+      } else if (r->getType()->isVectorTy() && want->isVectorTy() &&
+                 cast<FixedVectorType>(r->getType())->getNumElements() > n) {
+         r = first_n(c, r, n);
+         if (r->getType() != want) {
+            c.fail(std::string("intrinsic type ") + nir_intrinsic_infos[in->intrinsic].name);
+            return;
+         }
+      } else {
+         c.fail(std::string("intrinsic type ") + nir_intrinsic_infos[in->intrinsic].name);
+         return;
+      }
+   }
+   set_def(c, def, r);
+}
+
+} /* namespace */
