+   [VARYING_SLOT_CULL_DIST0] = {"cull_0", true, true},
+   [VARYING_SLOT_CULL_DIST1] = {"cull_1", true, true},
+   [VARYING_SLOT_CULL_PRIMITIVE] = {"cull_primitive_0", true, true},
+   [VARYING_SLOT_CULL_PRIMITIVE + 1] = {"cull_primitive_1", true, true},
+};
+
+static std::string
+slot_name(unsigned loc, unsigned comp)
+{
+   if (loc >= VARYING_SLOT_VAR0 && loc <= VARYING_SLOT_VAR31) {
+      char b[16];
+      snprintf(b, sizeof(b), "vary_%02u", loc - VARYING_SLOT_VAR0);
+      return b;
+   }
+   if (!slot_info[loc].name)
+      return "";
+   std::string n = slot_info[loc].name;
+   if (slot_info[loc].scalarized) {
+      n += "_";
+      n += "xyzw"[comp];
+   }
+   return n;
+}
+
+static bool
+slot_user(unsigned loc)
+{
+   return (loc >= VARYING_SLOT_VAR0 && loc <= VARYING_SLOT_VAR31) ||
+          slot_info[loc].user;
+}
+
+static bool
+slot_scalarized(unsigned loc)
+{
+   return loc < NUM_TOTAL_VARYING_SLOTS && slot_info[loc].scalarized;
+}
+
+struct air_ctx {
+   nir_shader *s;
+   const struct air_options *opts;
+   uint64_t wa;
+
+   LLVMContext C;
+   Module *M;
+   IRBuilder<> B;
+   Function *F = nullptr;
+
+   bool ok = true;
+   std::string why;
+
+   Type *t_i1, *t_i8, *t_i16, *t_i32, *t_i64, *t_f16, *t_f32;
+   StructType *t_buffer, *t_sampler, *t_msampler, *t_sampler_table;
+   PointerType *t_sampler_ptr;
+
+   Value *buf0 = nullptr, *sampler_table = nullptr, *per_draw = nullptr,
+         *locks = nullptr;
+   Value *sysval[SYSTEM_VALUE_MAX] = {};
+   GlobalVariable *shared = nullptr, *cdata = nullptr;
+   Value *scratch = nullptr;
+
+   std::vector<Value *> defs;
+   std::unordered_map<nir_block *, BasicBlock *> bbs, end_bbs;
+   std::vector<std::pair<nir_phi_instr *, PHINode *>> phis;
+   std::vector<loop_ctx> loops;
+   std::unordered_map<nir_def *, tex_info> texinfo;
+   std::unordered_map<nir_def *, int> handle_memo;
+
+   io_info in_info[NUM_TOTAL_VARYING_SLOTS] = {};
+   io_info out_info[NUM_TOTAL_VARYING_SLOTS] = {};
+   std::map<std::pair<unsigned, unsigned>, Value *> fs_inputs;
+   std::map<unsigned, Value *> fb_inputs;
+   std::map<std::pair<unsigned, unsigned>, unsigned> out_index;
+   std::vector<out_member> outs;
+   int clip_member = -1;
+   Type *ret_type = nullptr;
+   bool uses_per_draw = false, uses_locks = false;
+
+   air_ctx() : M(nullptr), B(C) {}
+
+   void fail(const std::string &m)
+   {
+      if (ok)
+         why = m;
+      ok = false;
+   }
+
+   Type *int_ty(unsigned bits)
+   {
+      switch (bits) {
+      case 1: return t_i1;
+      case 8: return t_i8;
+      case 16: return t_i16;
+      case 32: return t_i32;
+      case 64: return t_i64;
+      default: fail("bit size"); return t_i32;
+      }
+   }
+
+   Type *vec_ty(Type *e, unsigned n) { return n == 1 ? e : (Type *)FixedVectorType::get(e, n); }
+   Type *def_ty(unsigned bits, unsigned n) { return vec_ty(int_ty(bits), n); }
+   Type *flt_scalar(unsigned bits)
+   {
+      if (bits == 16) return t_f16;
+      if (bits == 32) return t_f32;
+      fail("float bit size");
+      return t_f32;
+   }
+
+   MDString *mds(const std::string &s) { return MDString::get(C, s); }
+   Metadata *mdi(int v) { return ConstantAsMetadata::get(ConstantInt::get(t_i32, v)); }
+   Metadata *mdv(Value *v) { return ValueAsMetadata::get(v); }
+
+   Value *call(const std::string &name, Type *ret, ArrayRef<Value *> args,
+               attr_kind kind, bool fast = false);
+};
+
+/* Intrinsic calls ---------------------------------------------------------- */
+
+Value *
+air_ctx::call(const std::string &name, Type *ret, ArrayRef<Value *> args,
+              attr_kind kind, bool fast)
+{
+   std::vector<Type *> at;
+   for (Value *a : args)
+      at.push_back(a->getType());
+   FunctionType *ft = FunctionType::get(ret, at, false);
+   Function *fn = M->getFunction(name);
+   if (!fn) {
+      fn = Function::Create(ft, GlobalValue::ExternalLinkage, name, M);
+      fn->addFnAttr(Attribute::NoUnwind);
+      fn->addFnAttr(Attribute::WillReturn);
+      switch (kind) {
+      case A_PURE:
+         fn->addFnAttr(Attribute::ReadNone);
+         fn->addFnAttr(Attribute::NoFree);
+         fn->addFnAttr(Attribute::NoSync);
+         break;
+      case A_CONV:
+         fn->addFnAttr(Attribute::Convergent);
+         break;
+      case A_SAMPLE:
+         fn->addFnAttr(Attribute::Convergent);
+         fn->addFnAttr(Attribute::ArgMemOnly);
+         fn->addFnAttr(Attribute::ReadOnly);
+         fn->addFnAttr(Attribute::NoFree);
+         break;
+      case A_READ:
+         fn->addFnAttr(Attribute::ArgMemOnly);
+         fn->addFnAttr(Attribute::ReadOnly);
+         fn->addFnAttr(Attribute::NoFree);
+         break;
+      case A_WRITE:
+         fn->addFnAttr(Attribute::ArgMemOnly);
+         break;
+      case A_SIDE:
+         break;
+      case A_INACC:
+         fn->addFnAttr(Attribute::InaccessibleMemOnly);
+         fn->addFnAttr(Attribute::ReadOnly);
+         fn->addFnAttr(Attribute::NoFree);
+         break;
+      }
+   } else if (fn->getFunctionType() != ft) {
+      fail("signature " + name);
+      return UndefValue::get(ret->isVoidTy() ? t_i32 : ret);
+   }
+   CallInst *ci = B.CreateCall(fn, args);
+   if (fast && isa<FPMathOperator>(ci)) {
+      FastMathFlags f;
+      f.setFast();
+      ci->setFastMathFlags(f);
+   }
+   return ci;
+}
+
+/* Metallib ----------------------------------------------------------------- */
+
+static void
+put(std::string &o, const void *p, size_t n)
+{
+   o.append((const char *)p, n);
+}
+
+template <typename T>
+static void
+putv(std::string &o, T v)
+{
+   put(o, &v, sizeof(v));
+}
+
+static void
+tag(std::string &o, const char *fourcc, uint16_t size)
+{
+   put(o, fourcc, 4);
+   putv<uint16_t>(o, size);
+}
+
+static std::string
+write_metallib(const std::string &bc, const std::string &fname, uint8_t ftype)
+{
+   unsigned char hash[CC_SHA256_DIGEST_LENGTH];
+   CC_SHA256(bc.data(), (CC_LONG)bc.size(), hash);
+
+   std::string fn;
+   tag(fn, "NAME", fname.size() + 1);
+   put(fn, fname.c_str(), fname.size() + 1);
+   tag(fn, "TYPE", 1);
+   putv<uint8_t>(fn, ftype);
+   tag(fn, "HASH", 32);
+   put(fn, hash, 32);
+   tag(fn, "MDSZ", 8);
+   putv<uint64_t>(fn, bc.size());
+   tag(fn, "OFFT", 24);
+   putv<uint64_t>(fn, 0);
+   putv<uint64_t>(fn, 0);
+   putv<uint64_t>(fn, 0);
+   tag(fn, "VERS", 8);
+   putv<uint16_t>(fn, 2);
+   putv<uint16_t>(fn, 8);
+   putv<uint16_t>(fn, 4);
+   putv<uint16_t>(fn, 0);
+   put(fn, "ENDT", 4);
+
+   std::string pub, priv;
+   putv<uint32_t>(pub, 4);
+   put(pub, "ENDT", 4);
+   putv<uint32_t>(priv, 4);
+   put(priv, "ENDT", 4);
+
+   const uint64_t hdr = 88;
+   uint64_t list_size = fn.size() + 4;
+   uint64_t pub_off = hdr + 4 + list_size + 4;
+   uint64_t priv_off = pub_off + pub.size();
+   uint64_t bc_off = priv_off + priv.size();
+   uint64_t total = bc_off + bc.size();
+
+   std::string o;
+   put(o, "MTLB", 4);
+   putv<uint16_t>(o, 0x8001);
+   putv<uint16_t>(o, 2);
+   putv<uint16_t>(o, 9);
+   putv<uint8_t>(o, 0);
+   putv<uint8_t>(o, 0x81);
+   putv<uint16_t>(o, 26);
+   putv<uint16_t>(o, 0);
+   putv<uint64_t>(o, total);
+   putv<uint64_t>(o, hdr);
+   putv<uint64_t>(o, list_size);
+   putv<uint64_t>(o, pub_off);
+   putv<uint64_t>(o, pub.size());
+   putv<uint64_t>(o, priv_off);
+   putv<uint64_t>(o, priv.size());
+   putv<uint64_t>(o, bc_off);
+   putv<uint64_t>(o, bc.size());
+   putv<uint32_t>(o, 1);
+   putv<uint32_t>(o, (uint32_t)list_size);
+   o += fn;
+   put(o, "ENDT", 4);
+   o += pub;
+   o += priv;
+   o += bc;
+   return o;
+}
