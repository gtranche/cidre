+
+namespace {
+
+/* Control flow ------------------------------------------------------------- */
+
+static BasicBlock *
+get_bb(air_ctx &c, nir_block *b)
+{
+   auto it = c.bbs.find(b);
+   if (it != c.bbs.end())
+      return it->second;
+   BasicBlock *bb = BasicBlock::Create(c.C, "", c.F);
+   c.bbs[b] = bb;
+   return bb;
+}
+
+static bool
+has_term(air_ctx &c)
+{
+   return c.B.GetInsertBlock()->getTerminator() != nullptr;
+}
+
+static Value *
+build_return_value(air_ctx &c)
+{
+   if (!c.ret_type || c.ret_type->isVoidTy())
+      return nullptr;
+   Value *r = UndefValue::get(c.ret_type);
+   for (unsigned i = 0; i < c.outs.size(); i++) {
+      Value *v = c.B.CreateLoad(c.outs[i].ty, c.outs[i].slot);
+      r = c.B.CreateInsertValue(r, v, {i});
+   }
+   return r;
+}
+
+static void
+emit_return(air_ctx &c)
+{
+   Value *r = build_return_value(c);
+   if (r)
+      c.B.CreateRet(r);
+   else
+      c.B.CreateRetVoid();
+}
+
+static void emit_cf_list(air_ctx &c, struct exec_list *list);
+
+static void
+emit_jump(air_ctx &c, nir_jump_instr *j)
+{
+   switch (j->type) {
+   case nir_jump_break:
+      if (c.loops.empty()) { c.fail("break"); return; }
+      c.B.CreateBr(c.loops.back().brk);
+      break;
+   case nir_jump_continue:
+      if (c.loops.empty()) { c.fail("continue"); return; }
+      c.B.CreateBr(c.loops.back().cont);
+      break;
+   default:
+      c.fail("jump");
+   }
+}
+
+static void
+emit_block(air_ctx &c, nir_block *b)
+{
+   BasicBlock *bb = get_bb(c, b);
+   if (!has_term(c))
+      c.B.CreateBr(bb);
+   c.B.SetInsertPoint(bb);
+   nir_foreach_instr(instr, b) {
+      if (!c.ok)
+         return;
+      switch (instr->type) {
+      case nir_instr_type_alu:
+         emit_alu(c, nir_instr_as_alu(instr));
+         break;
+      case nir_instr_type_intrinsic:
+         emit_intrinsic(c, nir_instr_as_intrinsic(instr));
+         break;
+      case nir_instr_type_tex:
+         emit_tex(c, nir_instr_as_tex(instr));
+         break;
+      case nir_instr_type_load_const:
+      case nir_instr_type_undef:
+         break;
+      case nir_instr_type_phi: {
+         nir_phi_instr *phi = nir_instr_as_phi(instr);
+         Type *t = is_handle_def(c, &phi->def) ? handle_type_of(c, &phi->def)
+                                                : c.def_ty(phi->def.bit_size, phi->def.num_components);
+         PHINode *p = c.B.CreatePHI(t, 2);
+         c.phis.push_back({phi, p});
+         set_def(c, &phi->def, p);
+         break;
+      }
+      case nir_instr_type_jump:
+         emit_jump(c, nir_instr_as_jump(instr));
+         break;
+      default:
+         c.fail("instr type");
+         return;
+      }
+   }
+   c.end_bbs[b] = c.B.GetInsertBlock();
+}
+
+static void
+emit_if(air_ctx &c, nir_if *nif)
+{
+   Value *cond = get_src(c, &nif->condition);
+   BasicBlock *tb = get_bb(c, nir_if_first_then_block(nif));
+   BasicBlock *eb = get_bb(c, nir_if_first_else_block(nif));
+   BasicBlock *mb = get_bb(c, nir_cf_node_as_block(nir_cf_node_next(&nif->cf_node)));
+   if (!has_term(c))
+      c.B.CreateCondBr(cond, tb, eb);
+   else
+      c.B.SetInsertPoint(BasicBlock::Create(c.C, "", c.F));
+   emit_cf_list(c, &nif->then_list);
+   if (!c.ok) return;
+   if (!has_term(c))
+      c.B.CreateBr(mb);
+   emit_cf_list(c, &nif->else_list);
+   if (!c.ok) return;
+   if (!has_term(c))
+      c.B.CreateBr(mb);
+}
+
+static void
+emit_loop(air_ctx &c, nir_loop *loop)
+{
+   if (nir_loop_has_continue_construct(loop)) {
+      c.fail("continue construct");
+      return;
+   }
+   BasicBlock *hb = get_bb(c, nir_loop_first_block(loop));
+   BasicBlock *xb = get_bb(c, nir_cf_node_as_block(nir_cf_node_next(&loop->cf_node)));
+   c.loops.push_back({hb, xb});
+   emit_cf_list(c, &loop->body);
+   if (c.ok && !has_term(c))
+      c.B.CreateBr(hb);
+   c.loops.pop_back();
+}
+
+static void
+emit_cf_list(air_ctx &c, struct exec_list *list)
+{
+   foreach_list_typed(nir_cf_node, node, node, list) {
+      if (!c.ok)
+         return;
+      switch (node->type) {
+      case nir_cf_node_block:
+         emit_block(c, nir_cf_node_as_block(node));
+         break;
+      case nir_cf_node_if:
+         emit_if(c, nir_cf_node_as_if(node));
+         break;
+      case nir_cf_node_loop:
+         emit_loop(c, nir_cf_node_as_loop(node));
+         break;
+      default:
+         c.fail("cf node");
+         return;
+      }
+   }
+}
+
+/* IO gathering ------------------------------------------------------------- */
+
+static bool
+gather_io(nir_builder *b, nir_intrinsic_instr *in, void *data)
+{
+   air_ctx &c = *(air_ctx *)data;
+   switch (in->intrinsic) {
+   case nir_intrinsic_load_interpolated_input: {
+      unsigned comp = nir_intrinsic_component(in);
+      unsigned loc = nir_src_as_uint(in->src[1]) + nir_intrinsic_io_semantics(in).location;
+      io_info &ii = c.in_info[loc];
+      ii.type = nir_intrinsic_dest_type(in);
+      ii.num_components = MAX2(ii.num_components, in->num_components + comp);
+      nir_intrinsic_instr *bi = nir_src_as_intrinsic(in->src[0]);
+      ii.interpolation = nir_intrinsic_interp_mode(bi);
+      ii.centroid = bi->intrinsic == nir_intrinsic_load_barycentric_centroid;
+      ii.sample = bi->intrinsic == nir_intrinsic_load_barycentric_sample;
+      ii.uses_interpolant |= bi->intrinsic == nir_intrinsic_load_barycentric_at_sample ||
+                             bi->intrinsic == nir_intrinsic_load_barycentric_at_offset;
+      break;
+   }
+   case nir_intrinsic_load_input: {
+      unsigned comp = nir_intrinsic_component(in);
+      unsigned loc = nir_src_as_uint(in->src[0]) + nir_intrinsic_io_semantics(in).location;
+      io_info &ii = c.in_info[loc];
+      ii.type = nir_intrinsic_dest_type(in);
+      ii.interpolation = INTERP_MODE_FLAT;
+      ii.num_components = MAX2(ii.num_components, in->num_components + comp);
+      break;
+   }
+   case nir_intrinsic_load_output: {
+      unsigned comp = nir_intrinsic_component(in);
+      unsigned loc = nir_src_as_uint(in->src[0]) + nir_intrinsic_io_semantics(in).location;
+      io_info &ii = c.out_info[loc];
+      ii.type = nir_intrinsic_dest_type(in);
+      ii.num_components = MAX2(ii.num_components, in->num_components + comp);
+      break;
+   }
+   case nir_intrinsic_store_output: {
+      unsigned comp = nir_intrinsic_component(in);
+      unsigned wm = nir_intrinsic_write_mask(in);
+      unsigned nc = comp + 1, left = 0;
+      for (unsigned i = 0; i < in->num_components; i++)
+         if ((wm >> i) & 1)
+            left = i;
+      nc += left;
+      unsigned loc = nir_src_as_uint(in->src[1]) + nir_intrinsic_io_semantics(in).location;
+      io_info &ii = c.out_info[loc];
+      ii.type = nir_intrinsic_src_type(in);
+      ii.num_components = MAX3(ii.num_components, nc, in->num_components);
+      break;
+   }
+   default:
+      break;
+   }
+   return false;
+}
+
+static const char *
+type_name(nir_alu_type t, unsigned n)
+{
+   static char buf[32];
+   const char *b;
+   switch (t) {
+   case nir_type_uint8: b = "uchar"; break;
+   case nir_type_uint16: b = "ushort"; break;
+   case nir_type_uint32: b = "uint"; break;
+   case nir_type_uint64: b = "ulong"; break;
+   case nir_type_int8: b = "char"; break;
+   case nir_type_int16: b = "short"; break;
+   case nir_type_int32: b = "int"; break;
+   case nir_type_int64: b = "long"; break;
+   case nir_type_float16: b = "half"; break;
+   case nir_type_float32: b = "float"; break;
+   case nir_type_bool1: b = "bool"; break;
+   default: return nullptr;
+   }
+   if (n > 1)
+      snprintf(buf, sizeof(buf), "%s%u", b, n);
+   else
+      snprintf(buf, sizeof(buf), "%s", b);
+   return buf;
+}
+
+static Type *
+io_type(air_ctx &c, nir_alu_type t, unsigned n)
+{
+   unsigned bits = nir_alu_type_get_type_size(t);
+   Type *e;
+   if (nir_alu_type_get_base_type(t) == nir_type_float)
+      e = c.flt_scalar(bits);
+   else
+      e = c.int_ty(bits);
+   return c.vec_ty(e, n);
+}
