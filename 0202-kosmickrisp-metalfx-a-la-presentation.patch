+/* Cidre : agrandissement MetalFX a la presentation (MESA_WSI_METAL_METALFX).
+ * L'image du jeu est copiee dans une texture a la taille de la swapchain, puis
+ * MTLFXSpatialScaler l'agrandit dans le drawable, aux pixels physiques de la
+ * couche, a la place de l'etirement de CoreAnimation. */
+struct wsi_metal_layer_upscaler {
+   id<MTLCommandQueue> commandQueue;
+   id<MTLSharedEvent> frameEvent;
+   id<MTLSharedEvent> doneEvent;
+   id<MTLFXSpatialScaler> scaler;
+   id<MTLResidencySet> residencySet;
+   uint64_t frameValue;
+   uint64_t doneValue;
+   uint32_t image_count;
+   id<MTLTexture> *textures;
+   id<MTLTexture> output;
+   id<MTLCommandBuffer> last;
+   uint64_t *done_values;
+   uint64_t frames;
+   bool stats;
+   double gpu_ms;
+   uint32_t gpu_count;
+   const char *relire;
+};
+
+static void
+wsi_metal_upscaler_relire(struct wsi_metal_layer_upscaler *u,
+                          id<MTLCommandBuffer> commandBuffer, id<MTLTexture> tex)
+{
+   NSUInteger w = tex.width, h = tex.height, pitch = w * 4;
+   if (tex.pixelFormat != MTLPixelFormatBGRA8Unorm &&
+       tex.pixelFormat != MTLPixelFormatBGRA8Unorm_sRGB)
+      return;
+   id<MTLBuffer> buf = [[tex.device newBufferWithLength:pitch * h
+                                                options:MTLResourceStorageModeShared] autorelease];
+   id<MTLBlitCommandEncoder> blit = [commandBuffer blitCommandEncoder];
+   [blit copyFromTexture:tex sourceSlice:0 sourceLevel:0
+            sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(w, h, 1)
+                toBuffer:buf destinationOffset:0
+       destinationBytesPerRow:pitch destinationBytesPerImage:pitch * h];
+   [blit endEncoding];
+   char *path = strdup(u->relire);
+   [commandBuffer addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+      FILE *f = fopen(path, "wb");
+      if (f) {
+         const uint8_t *p = buf.contents;
+         fprintf(f, "P6\n%lu %lu\n255\n", (unsigned long)w, (unsigned long)h);
+         for (NSUInteger i = 0; i < w * h; i++) {
+            uint8_t rgb[3] = { p[i * 4 + 2], p[i * 4 + 1], p[i * 4] };
+            fwrite(rgb, 1, 3, f);
+         }
+         fclose(f);
+         fprintf(stderr, "[CIDRE_METALFX] image %lux%lu relue dans %s\n",
+                 (unsigned long)w, (unsigned long)h, path);
+      }
+      free(path);
+   }];
+}
