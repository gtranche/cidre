+                       u->gpu_ms / u->gpu_count);
+               u->gpu_ms = 0;
+               u->gpu_count = 0;
+            }
+         }];
+      }
+
+      uint64_t done = ++u->doneValue;
+      [commandBuffer encodeSignalEvent:u->doneEvent value:done];
+      u->done_values[index] = done;
+
+      [commandBuffer presentDrawable:drawable];
+      [commandBuffer commit];
+      [u->last release];
+      u->last = [commandBuffer retain];
+
+      *drawable_ptr = nil;
+   }
+}
+
+void
+wsi_metal_layer_upscaler_destroy(struct wsi_metal_layer_upscaler *u,
+   void *mtl4_command_queue)
+{
+   [u->last waitUntilCompleted];
+   [u->last release];
+#if defined(MAC_OS_VERSION_26_0) && __MAC_OS_X_VERSION_MIN_REQUIRED >= MAC_OS_VERSION_26_0
+   if (mtl4_command_queue && u->residencySet)
+      [(id<MTL4CommandQueue>)mtl4_command_queue removeResidencySet:u->residencySet];
+#endif
+   for (uint32_t i = 0; i < u->image_count; i++)
+      [u->textures[i] release];
+   [u->output release];
+   [u->residencySet release];
+   [u->scaler release];
+   [u->frameEvent release];
+   [u->doneEvent release];
+   [u->commandQueue release];
+   free(u->textures);
+   free(u->done_values);
+   free(u);
+}
