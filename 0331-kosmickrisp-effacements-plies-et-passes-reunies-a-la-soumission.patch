+      if (!elig[k]) { /* enregistrement non rejouable : borne tout */
+         ents[ne++] = (struct kk_pp_ent){NULL, (uint16_t)k, KK_PP_TRAVAIL, false};
+         ouvert = -1;
+         continue;
+      }
+      list_for_each_entry(struct vk_cmd_queue_entry, e,
+                          &cbs[k]->vk.cmd_queue.cmds, cmd_link) {
+         uint8_t c = kk_pp_classer(e);
+         ents[ne] = (struct kk_pp_ent){e, (uint16_t)k, c, false};
+         if (c == KK_PP_BEGIN) {
+            ouvert = ne;
+         } else if (c == KK_PP_END && ouvert >= 0) {
+            struct kk_pp_passe *p = &ps[np++];
+            memset(p, 0, sizeof(*p));
+            p->b = (uint32_t)ouvert;
+            p->e = ne;
+            p->ri = ents[ouvert].e->u.begin_rendering.rendering_info;
