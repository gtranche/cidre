+   }
+   struct kk_image_view *d = kk_pp_vue(ri->pDepthAttachment);
+   struct kk_image_view *s = kk_pp_vue(ri->pStencilAttachment);
+   return (d && d->vk.image == iv->vk.image) || (s && s->vk.image == iv->vk.image);
