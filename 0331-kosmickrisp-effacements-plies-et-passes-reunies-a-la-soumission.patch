+   atts[n++] = ri->pDepthAttachment;
+   atts[n++] = ri->pStencilAttachment;
+   for (uint32_t i = 0; i < n; i++) {
+      struct kk_image_view *iv = kk_pp_vue(atts[i]);
+      if (!iv)
