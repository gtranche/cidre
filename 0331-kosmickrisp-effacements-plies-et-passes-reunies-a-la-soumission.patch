+          atts[i]->storeOp != VK_ATTACHMENT_STORE_OP_STORE ||
+          atts[i]->resolveMode != VK_RESOLVE_MODE_NONE ||
+          !kk_pp_zone_entiere(ri, iv))
+         return false;
+      any = true;
+   }
+   return any;
