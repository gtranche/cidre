+      struct kk_image_view *v = kk_pp_vue(&c->pColorAttachments[i]);
+      if (v && kk_pp_touche(d, v))
+         return true;
+   }
+   struct kk_image_view *v = kk_pp_vue(c->pDepthAttachment);
+   if (v && kk_pp_touche(d, v))
+      return true;
