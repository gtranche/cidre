+      while (x < ne) {
+         uint8_t c = ents[x].cls;
+         if (c == KK_PP_NEUTRE || c == KK_PP_BARR) {
+            x++;
+            continue;
+         }
+         if (c != KK_PP_BEGIN || pd >= np || ps[pd].b != x) {
+            kk_pp_st.plis_refus_travail++;
