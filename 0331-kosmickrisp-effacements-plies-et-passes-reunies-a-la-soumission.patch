+            x = ps[pd].e + 1;
+            pd++;
+            continue;
+         }
+         if (ps[pd].efface) { /* deja plie plus loin : on passe par-dessus */
+            if (kk_pp_touche_effacement(ps[pc].ri, ps[pd].ri))
