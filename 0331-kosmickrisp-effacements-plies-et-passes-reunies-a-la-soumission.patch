+/* Plie l'effacement c dans la passe d : chaque attachement de c doit etre
+ * charge par d (meme sous-ressource, toute l'image). Ajoute les
+ * modifications a mods (rendu faux si une seule manque, sans rien ajouter). */
+static bool
+kk_pp_plier(const VkRenderingInfo *c, VkRenderingInfo *d,
+            struct util_dynarray *mods)
+{
+   if (d->flags & (VK_RENDERING_RESUMING_BIT | VK_RENDERING_SUSPENDING_BIT))
+      return false;
+   struct kk_pp_mod m[KK_MAX_RTS + 2];
+   uint32_t nm = 0;
+   for (uint32_t i = 0; i < c->colorAttachmentCount; i++) {
+      const VkRenderingAttachmentInfo *ca = &c->pColorAttachments[i];
+      struct kk_image_view *cv = kk_pp_vue(ca);
+      if (!cv)
+         continue;
+      VkRenderingAttachmentInfo *da = NULL;
+      for (uint32_t k = 0; k < d->colorAttachmentCount; k++) {
+         struct kk_image_view *dv = kk_pp_vue(&d->pColorAttachments[k]);
+         if (kk_pp_meme_sous_ressource(cv, dv)) {
+            da = (VkRenderingAttachmentInfo *)&d->pColorAttachments[k];
+            break;
+         }
+      }
+      if (!da || da->loadOp != VK_ATTACHMENT_LOAD_OP_LOAD ||
+          !kk_pp_zone_entiere(d, cv))
+         return false;
+      m[nm++] = (struct kk_pp_mod){da, VK_ATTACHMENT_LOAD_OP_CLEAR, ca->clearValue};
+   }
+   const VkRenderingAttachmentInfo *cds[2] = {c->pDepthAttachment,
+                                              c->pStencilAttachment};
+   const VkRenderingAttachmentInfo *dds[2] = {d->pDepthAttachment,
+                                              d->pStencilAttachment};
+   for (uint32_t a = 0; a < 2; a++) {
+      struct kk_image_view *cv = kk_pp_vue(cds[a]);
+      if (!cv)
+         continue;
+      struct kk_image_view *dv = kk_pp_vue(dds[a]);
+      if (!kk_pp_meme_sous_ressource(cv, dv) ||
+          dds[a]->loadOp != VK_ATTACHMENT_LOAD_OP_LOAD ||
+          !kk_pp_zone_entiere(d, cv))
+         return false;
+      m[nm++] = (struct kk_pp_mod){(VkRenderingAttachmentInfo *)dds[a],
+                                   VK_ATTACHMENT_LOAD_OP_CLEAR, cds[a]->clearValue};
+   }
+   if (!nm)
+      return false;
+   for (uint32_t i = 0; i < nm; i++)
+      util_dynarray_foreach(mods, struct kk_pp_mod, o)
+         if (o->att == m[i].att)
+            return false;
+   util_dynarray_append_array(mods, struct kk_pp_mod, m, nm);
+   return true;
+}
