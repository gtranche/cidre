+/* Rejoue cbs[i..j] en un enregistrement, sans les entrees sautees, puis le
+ * commite (cf. kk_fusion_commit). Les modifications sont deja appliquees. */
+static VkResult
+kk_pp_commit(struct kk_queue *queue, struct kk_cmd_buffer **cbs, uint32_t i,
+             uint32_t j, struct kk_pp_ent *ents, uint32_t nents)
+{
+   struct kk_device *dev = kk_queue_device(queue);
+   struct vk_command_buffer *vk_cmd = NULL;
+   VkResult result = VK_SUCCESS;
+
+   mtx_lock(&queue->mutex);
+   if (util_dynarray_num_elements(&queue->free_cmd_buffers,
+                                  struct vk_command_buffer *) > 0u) {
+      vk_cmd = util_dynarray_pop(&queue->free_cmd_buffers,
+                                 struct vk_command_buffer *);
+   } else {
+      result = kk_cmd_buffer_ops.create(
+         &queue->cmd_pool->vk, VK_COMMAND_BUFFER_LEVEL_PRIMARY, &vk_cmd);
+      if (result != VK_SUCCESS)
+         goto unlock;
+   }
+   struct kk_cmd_buffer *rr = container_of(vk_cmd, struct kk_cmd_buffer, vk);
+   VkCommandBuffer h = kk_cmd_buffer_to_handle(rr);
+   const VkCommandBufferBeginInfo begin_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   result = kk_BeginCommandBuffer(h, &begin_info);
+   if (result != VK_SUCCESS)
+      goto release;
+   rr->fusion_enfile = false;
+
+   for (uint32_t k = i; k <= j; k++) {
+      /* entrees sautees de cet enregistrement, retirees de la liste le temps
+       * du rejeu (ordre de la liste), remises dans l'ordre inverse */
+      uint32_t ns = 0;
+      for (uint32_t x = 0; x < nents; x++)
+         ns += ents[x].cb == k && ents[x].saute;
+      struct vk_cmd_queue_entry **skip = NULL;
+      struct list_head **prev = NULL;
+      if (ns) {
+         skip = malloc(ns * sizeof(*skip));
+         prev = malloc(ns * sizeof(*prev));
+         if (!skip || !prev) {
+            free(skip);
+            free(prev);
+            result = vk_error(queue, VK_ERROR_OUT_OF_HOST_MEMORY);
+            goto release;
+         }
+         uint32_t s = 0;
+         for (uint32_t x = 0; x < nents; x++) {
+            if (ents[x].cb != k || !ents[x].saute)
+               continue;
+            skip[s] = ents[x].e;
+            prev[s] = skip[s]->cmd_link.prev;
+            list_del(&skip[s]->cmd_link);
+            s++;
+         }
+      }
+      vk_cmd_queue_execute(&cbs[k]->vk.cmd_queue, h, &dev->vk.dispatch_table);
+      for (int s = (int)ns - 1; s >= 0; s--)
+         list_add(&skip[s]->cmd_link, prev[s]);
+      free(skip);
+      free(prev);
+   }
+
+   result = kk_EndCommandBuffer(h);
+   if (result != VK_SUCCESS)
+      goto release;
+   if (!kk_cmd_buffer_has_work(rr)) {
+      if (kk_horodatages_cpu())
+         kk_ts_cpu_pousser(queue, rr);
+      goto release;
+   }
+
+   struct kk_commit_data *commit = vk_alloc(&dev->vk.alloc, sizeof(*commit), 8,
+                                            VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (commit == NULL) {
+      result = vk_error(queue, VK_ERROR_OUT_OF_HOST_MEMORY);
+      goto release;
+   }
+   commit->queue = queue;
+   commit->cmd = rr;
+   kk_device_make_resources_resident(dev);
+   queue->commits_in_flight++;
+   kk_queue_commit(queue, rr, rerecord_commit_callback, commit);
+   mtx_unlock(&queue->mutex);
+   return VK_SUCCESS;
+
+release:
+   kk_queue_release_cmd_buffer_locked(queue, rr);
+unlock:
+   mtx_unlock(&queue->mutex);
+   return result;
+}
