+/* How a Vulkan barrier recorded inside an open compute encoder is honoured.
+ *
+ * On Apple7 (M1, macOS 26), Unreal 5's Lumen renders garbage (bright noise
+ * in blocks, the UI included) when its dependent dispatches only get an
+ * intra-encoder barrier, and renders right once the encoder is closed at
+ * each barrier (the close puts a queue barrier on all stages). Apple8+
+ * renders right with the intra-encoder barrier.
+ *
+ * CIDRE_BARRIERES_CALCUL overrides the choice: "encodeur" (intra-encoder
+ * barrier), "visibilite" (intra-encoder barrier with device visibility),
+ * "couper" (close the encoder). */
+enum kk_compute_barrier_mode {
+   KK_COMPUTE_BARRIER_ENCODER,
+   KK_COMPUTE_BARRIER_DEVICE_VISIBILITY,
+   KK_COMPUTE_BARRIER_CLOSE,
+};
+
+#define KK_COMPUTE_BARRIER_APPLE7_DEFAULT KK_COMPUTE_BARRIER_CLOSE
+
+static enum kk_compute_barrier_mode
+kk_compute_barrier_mode(struct kk_cmd_buffer *cmd)
+{
+   static int forced = -2;
+   if (forced == -2) {
+      const char *v = getenv("CIDRE_BARRIERES_CALCUL");
+      forced = !v                        ? -1
+               : !strcmp(v, "encodeur")   ? KK_COMPUTE_BARRIER_ENCODER
+               : !strcmp(v, "visibilite") ? KK_COMPUTE_BARRIER_DEVICE_VISIBILITY
+               : !strcmp(v, "couper")     ? KK_COMPUTE_BARRIER_CLOSE
+                                          : -1;
+   }
+   if (forced >= 0)
+      return forced;
+
+   const struct kk_physical_device *pdev =
+      kk_device_physical(kk_cmd_buffer_device(cmd));
+   return pdev->info.gpu_apple_family <= 7 ? KK_COMPUTE_BARRIER_APPLE7_DEFAULT
+                                           : KK_COMPUTE_BARRIER_ENCODER;
+}
