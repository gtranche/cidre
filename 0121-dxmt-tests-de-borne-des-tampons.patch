+llvm::Value *
+Converter::CreateGEPInt32WithGroupedBoundCheck(BufferResourceHandle &Buffer, llvm::Value *Index, uint32_t Last) {
+  auto Addr = ir.CreateGEP(ir.getInt32Ty(), Buffer.Pointer, {Index});
+  if (!Buffer.Metadata) {
+    return Addr;
+  }
+  /* Index + Last < mots, sans debordement : Index < mots - Last quand mots > Last */
+  auto Words = ir.CreateLShr(DecodeRawBufferByteLength(Buffer.Metadata), 2);
+  auto Limit =
+      ir.CreateSelect(ir.CreateICmpUGT(Words, ir.getInt32(Last)), ir.CreateSub(Words, ir.getInt32(Last)), ir.getInt32(0));
+  return ir.CreateSelect(ir.CreateICmpULT(Index, Limit), Addr, llvm::Constant::getNullValue(Addr->getType()));
+}
+
 llvm::Value *
 Converter::CreateGEPInt32WithBoundCheck(AtomicBufferResourceHandle &Buffer, llvm::Value *Index) {
   auto Addr = ir.CreateGEP(ir.getInt32Ty(), Buffer.Pointer, {Index});
