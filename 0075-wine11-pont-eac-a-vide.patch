diff -ruN a/dlls/easyanticheat_x64/main.c b/dlls/easyanticheat_x64/main.c
--- a/dlls/easyanticheat_x64/main.c	1970-01-01 01:00:00
+++ b/dlls/easyanticheat_x64/main.c	2026-10-01 08:51:48
@@ -0,0 +1,64 @@
+/*
+ * Cote PE du pont EAC « a vide » : ce que le jeu appelle a la place de la DLL d'Epic.
+ */
+
+#include <stdarg.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(eacbridge);
+
+extern char * CDECL wine_get_unix_file_name( LPCWSTR dos );
+
+BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        struct attach_params params = { 0 };
+        WCHAR chemin[MAX_PATH], *p;
+        char *dossier = NULL;
+
+        DisableThreadLibraryCalls( inst );
+        if (__wine_init_unix_call()) return FALSE;
+
+        /* Le jeu a demande <dossier du jeu>\EasyAntiCheat_x64.dll ; Wine a charge ce
+         * module a la place mais garde le nom demande, qui donne le dossier du jeu. */
+        if (GetModuleFileNameW( inst, chemin, ARRAY_SIZE(chemin) ) && (p = wcsrchr( chemin, '\\' )))
+        {
+            *p = 0;
+            dossier = wine_get_unix_file_name( chemin );
+        }
+        params.dossier_unix = (UINT_PTR)dossier;
+        if (WINE_UNIX_CALL( unix_attach, &params )) return FALSE;
+        HeapFree( GetProcessHeap(), 0, dossier );
+    }
+    return TRUE;
+}
+
+static UINT64 relayer( const char *nom, UINT64 a, UINT64 b, UINT64 c, UINT64 d )
+{
+    struct relayer_params params = { (UINT_PTR)nom, { a, b, c, d }, 0 };
+
+    TRACE( "%s(%#I64x, %#I64x, %#I64x, %#I64x)\n", nom, a, b, c, d );
+    if (WINE_UNIX_CALL( unix_relayer, &params )) return 0;
+    return params.ret;
+}
+
+#define RELAIS(nom) \
+    UINT64 CDECL nom( UINT64 a, UINT64 b, UINT64 c, UINT64 d ) { return relayer( #nom, a, b, c, d ); }
+#include "exports.h"
+#undef RELAIS
+
+/* Propre au pont : decrit le pont et son module natif. Rend la longueur ecrite. */
+UINT CDECL EacMacosBridge_Describe( char *tampon, UINT taille )
+{
+    struct decrire_params params = { (UINT_PTR)tampon, taille, 0 };
+
+    if (WINE_UNIX_CALL( unix_decrire, &params )) return 0;
+    return params.ret;
+}
diff -ruN a/dlls/easyanticheat_x64/unix.c b/dlls/easyanticheat_x64/unix.c
--- a/dlls/easyanticheat_x64/unix.c	1970-01-01 01:00:00
+++ b/dlls/easyanticheat_x64/unix.c	2026-10-01 08:51:48
@@ -0,0 +1,121 @@
+/*
+ * Cote unix du pont EAC « a vide » : cherche un module natif de l'hote a cote de
+ * la DLL demandee par le jeu, le charge, et lui relaie les appels.
+ *
+ * Le module natif attendu est celui que l'editeur d'anti-triche fournirait pour
+ * cet hote. Aujourd'hui il n'en existe aucun pour « jeu Windows sous Wine sur
+ * macOS » ; le seul module que ce pont charge est donc le module de test local du
+ * projet, qui journalise et rend « client non disponible ». Ce code ne fabrique
+ * aucune reponse d'attestation et ne masque rien a un module reel.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(eacbridge);
+
+/* ABI du module natif, definie par ce projet (docs/ARCHITECTURE.md §5.4). */
+typedef int         (*appel_t)( const char *nom, const UINT64 args[4], UINT64 *ret );
+typedef const char *(*decrire_t)( void );
+
+static void     *module;
+static appel_t   module_appel;
+static decrire_t module_decrire;
+static char      chemin_module[1024];
+
+static const char *candidats[] = { "easyanticheat_x64.dylib", "easyanticheat_x64.so" };
+
+static NTSTATUS attach( void *args )
+{
+    const struct attach_params *params = args;
+    const char *dossier = (const char *)(UINT_PTR)params->dossier_unix;
+    const char *force = getenv( "EAC_MACOS_MODULE" );
+    unsigned int i;
+
+    if (force) snprintf( chemin_module, sizeof(chemin_module), "%s", force );
+    else if (dossier)
+    {
+        for (i = 0; i < ARRAY_SIZE(candidats); i++)
+        {
+            snprintf( chemin_module, sizeof(chemin_module), "%s/%s", dossier, candidats[i] );
+            if (!access( chemin_module, R_OK )) break;
+        }
+        if (i == ARRAY_SIZE(candidats)) chemin_module[0] = 0;
+    }
+
+    if (chemin_module[0] && (module = dlopen( chemin_module, RTLD_NOW | RTLD_LOCAL )))
+    {
+        module_appel   = dlsym( module, "eac_macos_module_appel" );
+        module_decrire = dlsym( module, "eac_macos_module_decrire" );
+        FIXME( "pont EAC a vide : module natif %s charge (%s)\n", chemin_module,
+               module_decrire ? module_decrire() : "sans description" );
+        if (!module_appel) WARN( "le module n'exporte pas eac_macos_module_appel : tout appel rendra 0\n" );
+    }
+    else
+    {
+        FIXME( "pont EAC a vide : aucun module natif (%s) ; tout appel rend « client non disponible »\n",
+               chemin_module[0] ? dlerror() : "rien a cote de la DLL" );
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS relayer( void *args )
+{
+    struct relayer_params *params = args;
+    const char *nom = (const char *)(UINT_PTR)params->nom;
+
+    params->ret = 0;
+    if (module_appel)
+    {
+        int rc = module_appel( nom, params->args, &params->ret );
+        TRACE( "%s -> module rc %d, ret %#llx\n", nom, rc, (unsigned long long)params->ret );
+    }
+    else TRACE( "%s -> client non disponible (0)\n", nom );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS decrire( void *args )
+{
+    struct decrire_params *params = args;
+    char *tampon = (char *)(UINT_PTR)params->tampon;
+
+    params->ret = snprintf( tampon, params->taille, "eac-bridge-macos 0.1 (pont a vide) ; module natif : %s%s%s",
+                            module ? chemin_module : "aucun",
+                            module_decrire ? " ; " : "", module_decrire ? module_decrire() : "" );
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    attach,
+    relayer,
+    decrire,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    attach,
+    relayer,
+    decrire,
+};
diff -ruN a/dlls/easyanticheat_x64/unixlib.h b/dlls/easyanticheat_x64/unixlib.h
--- a/dlls/easyanticheat_x64/unixlib.h	1970-01-01 01:00:00
+++ b/dlls/easyanticheat_x64/unixlib.h	2026-10-01 08:51:48
@@ -0,0 +1,46 @@
+/*
+ * Pont EAC « a vide » pour Wine/macOS : interface entre le cote PE et le cote unix.
+ *
+ * Ce module remplace EasyAntiCheat_x64.dll (EAC classique) quand un module natif
+ * est pose a cote, comme le eac-bridge de Proton. Il ne contient aucune logique
+ * anti-triche : il relaie les appels du jeu vers un module natif de l'hote, et
+ * rend « client non disponible » quand il n'y en a pas. Il n'atteste rien.
+ */
+
+#ifndef __WINE_EASYANTICHEAT_X64_UNIXLIB_H
+#define __WINE_EASYANTICHEAT_X64_UNIXLIB_H
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "wine/unixlib.h"
+
+/* Largeurs fixes, comme lsteamclient : la meme disposition sert a tout appelant. */
+struct attach_params
+{
+    UINT64 dossier_unix;   /* const char * : dossier de la DLL demandee par le jeu, ou 0 */
+};
+
+struct relayer_params
+{
+    UINT64 nom;            /* const char * : nom de l'export appele */
+    UINT64 args[4];        /* rcx, rdx, r8, r9 tels que recus */
+    UINT64 ret;            /* valeur a rendre dans rax */
+};
+
+struct decrire_params
+{
+    UINT64 tampon;         /* char * */
+    UINT32 taille;
+    UINT32 ret;            /* longueur ecrite */
+};
+
+enum unix_funcs
+{
+    unix_attach,
+    unix_relayer,
+    unix_decrire,
+    unix_funcs_count,
+};
+
+#endif
diff -ruN a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
--- a/dlls/kernelbase/process.c	2026-10-01 08:51:48
+++ b/dlls/kernelbase/process.c	2026-10-01 08:51:48
@@ -505,6 +505,14 @@
 /**********************************************************************
  *           CreateProcessInternalW   (kernelbase.@)
  */
+static BOOL is_eac_launcher( const WCHAR *app_name )
+{
+    const WCHAR *p = app_name + wcslen( app_name );
+
+    while (p != app_name && p[-1] != '\\' && p[-1] != '/') p--;
+    return !wcsicmp( p, L"EasyAntiCheat_launcher.exe" );
+}
+
 BOOL WINAPI DECLSPEC_HOTPATCH CreateProcessInternalW( HANDLE token, const WCHAR *app_name, WCHAR *cmd_line,
                                                       SECURITY_ATTRIBUTES *process_attr,
                                                       SECURITY_ATTRIBUTES *thread_attr,
@@ -566,6 +574,33 @@
     {
         status = STATUS_NO_MEMORY;
         goto done;
+    }
+
+    /* Pont EAC : le lanceur classique (EasyAntiCheat_launcher.exe) doit garder la DLL
+     * native d'Epic, c'est lui qui telecharge et lance le jeu ; on le marque pour que
+     * ntdll (loadorder.c) ne lui substitue pas le pont. Proton reconnait le lanceur a
+     * son nom de produit ; ici on se contente du nom de fichier. */
+    if (is_eac_launcher( app_name ))
+    {
+        UNICODE_STRING var, val;
+        WCHAR *new_env = RtlAllocateHeap( GetProcessHeap(), 0, params->EnvironmentSize );
+
+        if (new_env)
+        {
+            memcpy( new_env, params->Environment, params->EnvironmentSize );
+            RtlDestroyProcessParameters( params );
+            RtlInitUnicodeString( &var, L"PROTON_EAC_LAUNCHER_PROCESS" );
+            RtlInitUnicodeString( &val, L"1" );
+            RtlSetEnvironmentVariable( &new_env, &var, &val );
+            params = create_process_params( app_name, tidy_cmdline, cur_dir, new_env,
+                                            flags | CREATE_UNICODE_ENVIRONMENT, startup_info );
+            RtlFreeHeap( GetProcessHeap(), 0, new_env );
+            if (!params)
+            {
+                status = STATUS_NO_MEMORY;
+                goto done;
+            }
+        }
     }
 
     if (flags & (DEBUG_PROCESS | DEBUG_ONLY_THIS_PROCESS))
