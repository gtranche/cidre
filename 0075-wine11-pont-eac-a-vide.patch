 /***************************************************************************
+ *	eac_bridge_load_order
+ *
+ * Pont EAC, meme regle que le eac-bridge de Proton : la DLL easyanticheat
+ * (_x64, _x86 ou nue) demandee par le jeu est remplacee par le module integre
+ * (le pont) seulement si un module natif de l'hote est pose a cote d'elle.
+ * Sinon la DLL native d'Epic est chargee, comme sans pont. Le lanceur EAC
+ * garde toujours la DLL native. Rend LO_INVALID si la DLL n'est pas concernee.
+ */
+static enum loadorder eac_bridge_load_order( const WCHAR *module, const WCHAR *basename )
+{
+    static const WCHAR easyanticheatW[] = {'e','a','s','y','a','n','t','i','c','h','e','a','t',0};
+    static const WCHAR x64W[] = {'_','x','6','4',0};
+    static const WCHAR x86W[] = {'_','x','8','6',0};
+    static const WCHAR prefixW[] = {'\\','?','?','\\'};
+    static const WCHAR dylibW[] = {'.','d','y','l','i','b',0};
+    static const WCHAR soW[] = {'.','s','o',0};
+    static const WCHAR *const extensions[] = { dylibW, soW };
+    const WCHAR *suffixe;
+    UNICODE_STRING natif, nt_name;
+    OBJECT_ATTRIBUTES attr;
+    char *unix_name = NULL;
+    NTSTATUS status = STATUS_NO_SUCH_FILE;
+    unsigned int i, len, base_len;
+
+    if (wcsnicmp( basename, easyanticheatW, ARRAY_SIZE(easyanticheatW) - 1 )) return LO_INVALID;
+    suffixe = basename + ARRAY_SIZE(easyanticheatW) - 1;
+    if (*suffixe && wcsicmp( suffixe, x64W ) && wcsicmp( suffixe, x86W )) return LO_INVALID;
+
+    if (eac_launcher_process)
+    {
+        TRACE( "%s : lanceur EAC, DLL native imposee\n", debugstr_w(module) );
+        return LO_NATIVE;
+    }
+
+    /* <dossier>\easyanticheat_x64.<ext> ; une DLL nue est traitee comme _x64 */
+    len = wcslen( module );
+    base_len = basename - module + ARRAY_SIZE(easyanticheatW) - 1;
+    if (!(natif.Buffer = malloc( (len + 16) * sizeof(WCHAR) ))) return LO_INVALID;
+    memcpy( natif.Buffer, prefixW, sizeof(prefixW) );
+    for (i = 0; i < ARRAY_SIZE(extensions) && status; i++)
+    {
+        memcpy( natif.Buffer + 4, module, base_len * sizeof(WCHAR) );
+        natif.Buffer[4 + base_len] = 0;
+        wcscat( natif.Buffer, *suffixe ? suffixe : x64W );
+        wcscat( natif.Buffer, extensions[i] );
+        natif.Length = natif.MaximumLength = wcslen( natif.Buffer ) * sizeof(WCHAR);
+        InitializeObjectAttributes( &attr, &natif, 0, 0, NULL );
+        status = get_nt_and_unix_names( &attr, &nt_name, &unix_name, FILE_OPEN, FALSE );
+        if (!status) TRACE( "%s : module natif %s present, pont impose\n", debugstr_w(module), unix_name );
+        free( nt_name.Buffer );
+        free( unix_name );
+        nt_name.Buffer = NULL; unix_name = NULL;
+    }
+    if (status) TRACE( "%s : aucun module natif a cote (%s), DLL native\n", debugstr_w(module), debugstr_w(natif.Buffer) );
+    free( natif.Buffer );
+    return status ? LO_NATIVE : LO_BUILTIN;
+}
