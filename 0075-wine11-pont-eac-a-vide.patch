+    if (eac_runtime)
+    {
+        static const char *const sous[] = { "/v2/lib32/", "/v2/lib64/" };
+        for (i = 0; i < 2; i++)
+        {
+            p = malloc( strlen(eac_runtime) + strlen(sous[i]) + 1 );
+            strcpy( p, eac_runtime );
+            strcat( p, sous[i] );
+            dll_paths[count++] = p;
+        }
     }
 
     for (i = 0; i < count; i++) dll_path_maxlen = max( dll_path_maxlen, strlen(dll_paths[i]) );
