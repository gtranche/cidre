+/* Chaque commit de la soumission courante tient une reference et ferme un
+ * groupe d'operations. Un retour peut arriver pendant qu'on ajoute un groupe :
+ * le tableau des groupes est reserve (256) a la creation, jamais realloue. */
+static void
+kk_ts_cpu_attacher(mtl_commit_options *options)
+{
+   struct kk_ts_cpu_soum *soum = kk_ts_cpu_courante;
+   if (!soum)
+      return;
+   struct kk_ts_cpu_retour *r = malloc(sizeof(*r));
+   if (!r)
+      return;
+   uint32_t ng = util_dynarray_num_elements(&soum->groupes, struct kk_ts_cpu_groupe);
+   if (ng >= 256) {
+      free(r);
+      return; /* les operations suivantes iront au groupe suivant ou au porteur */
+   }
+   struct kk_ts_cpu_groupe g = {
+      .fin = util_dynarray_num_elements(&soum->ops, struct kk_ts_cpu_op)};
+   util_dynarray_append(&soum->groupes, g);
+   r->soum = soum;
+   r->groupe = ng;
+   p_atomic_inc(&soum->ref);
+   mtl_commit_options_add_feedback_handler(options, kk_ts_cpu_feedback, r);
+}
