 /*
+ * ISteamAppTicket::GetAppOwnershipTicketData (emplacement 0) : le ticket de
+ * possession, que l'enveloppe SteamStub demande une seule fois avant de
+ * dechiffrer le jeu. Le client Steam ne l'a en cache que pour un jeu qu'il a
+ * deja vu tourner. Pour les autres -- un jeu Windows telecharge hors du client,
+ * que celui de macOS ne peut ni installer ni lancer --, la premiere demande
+ * rend zero et declenche la requete a Valve ; le ticket arrive une seconde plus
+ * tard (mesure : tests/h64ticket.c, a condition que le processus se soit
+ * annonce sous l'identifiant du jeu, ce que fait SteamAppId). Sans attendre, le
+ * premier lancement s'arretait sur « Application load error 6:0000065432 ».
+ * On redemande donc, dix secondes au plus.
+ */
+static void attendre_ticket( const char *interface, unsigned emplacement, struct appel_vtable_params *params )
+{
+    unsigned essai;
+
+    if (params->ret || emplacement || !meme_interface( "ISteamAppTicket", interface )) return;
+    for (essai = 0; essai < 40 && !params->ret; essai++)
+    {
+        Sleep( 250 );
+        if (WINE_UNIX_CALL( unix_appel_vtable, params )) return;
+    }
+    if (params->ret) TRACE( "ticket de possession obtenu apres %u nouvelle(s) demande(s)\n", essai );
+    else ERR( "ticket de possession toujours vide apres dix secondes : jeu absent du compte, ou client Steam deconnecte\n" );
+}
+
