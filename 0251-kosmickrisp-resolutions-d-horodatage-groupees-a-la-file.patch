+   }
+   if (kk_enc_stats_enabled()) {
+      kk_enc_stat(KK_ENCS_QFLUSH, __builtin_return_address(0));
+      for (uint32_t i = 0; i < n; i++)
+         kk_enc_stat(KK_ENCS_QENTREES, NULL);
+      for (uint32_t i = 0; i < nz; i++)
+         kk_enc_stat(KK_ENCS_QRUNS, NULL);
+   }
+   if (n && kk_enc_stats_enabled()) {
+      static uint64_t dernier;
+      uint64_t t = os_time_get_nano();
+      if (t - dernier > 5000000000ull) {
+         dernier = t;
+         struct kk_ts_resolve *r = queue->ts_pending.data;
+         fprintf(stderr, "[CIDRE_ENC] qflush n=%u nz=%u :", n, nz);
+         for (uint32_t i = 0; i < n && i < 64; i++)
+            fprintf(stderr, " %llx/%u/%llx", (unsigned long long)((uintptr_t)r[i].heap & 0xfffff),
+                    r[i].index, (unsigned long long)(r[i].dst_addr & 0xffffff));
+         fprintf(stderr, "\n");
+      }
+   }
+   if (n) {
+      kk_ts_emit_resolves(f->cb, queue->ts_pending.data, n);
+      util_dynarray_clear(&queue->ts_pending);
+   }
+   mtl_end_command_buffer(f->cb);
+   mtl_commit_options *options = mtl_new_commit_options();
+   mtl_commit_options_add_feedback_handler(options, kk_ts_flush_done, f);
+   if (kk_enc_stats_enabled()) kk_enc_stat(KK_ENCS_COMMIT, NULL);
+   mtl_command_queue_commit(queue->mtl_handle, &f->cb, 1u, options);
+   mtl_release(options);
+   return attendre ? f : NULL;
+}
+
+static bool
+kk_queue_ts_overlap_locked(struct kk_queue *queue, struct kk_query_pool *pool,
+                           uint32_t first, uint32_t count, bool zeros)
+{
+   struct kk_device *dev = kk_queue_device(queue);
+   if (zeros) {
+      util_dynarray_foreach(&queue->ts_zeros, struct kk_ts_zero, z) {
+         if (z->pool == pool && z->first < first + count && first < z->first + z->count)
+            return true;
+      }
+   }
+   uint64_t lo = kk_ts_report_addr(dev, pool, first);
+   uint64_t hi = kk_ts_report_addr(dev, pool, first + count);
+   util_dynarray_foreach(&queue->ts_pending, struct kk_ts_resolve, r) {
+      if (r->dst_addr >= lo && r->dst_addr < hi)
+         return true;
+   }
+   if (kk_ts_pool_is_ts(pool)) {
+      for (uint32_t qy = first; qy < first + count; qy++) {
+         uint32_t idx;
+         mtl_counter_heap *h = kk_ts_heap_lookup(pool, qy, &idx);
+         util_dynarray_foreach(&queue->ts_pending, struct kk_ts_resolve, r) {
+            if (h == r->heap && idx == r->index)
+               return true;
+         }
+      }
+   }
+   return false;
+}
+
+void
+kk_queue_ts_flush_overlap(struct kk_queue *queue, struct kk_query_pool *pool,
+                          uint32_t first, uint32_t count)
+{
+   struct kk_ts_flush_data *f = NULL;
+   simple_mtx_lock(&queue->ts_lock);
+   if (kk_queue_ts_overlap_locked(queue, pool, first, count, true))
+      f = kk_queue_ts_flush_locked(queue, kk_resolve_groupe() >= 4);
+   simple_mtx_unlock(&queue->ts_lock);
+   if (f) {
+      uint64_t t0 = os_time_get_nano();
+      while (!p_atomic_read(&f->done) && os_time_get_nano() - t0 < 5000000000ull)
+         os_time_sleep(20);
+      kk_ts_flush_unref(f);
+   }
+}
+
+void
+kk_queue_ts_purge(struct kk_queue *queue, uint64_t lo, uint64_t hi)
+{
+   simple_mtx_lock(&queue->ts_lock);
+   struct kk_ts_resolve *r = queue->ts_pending.data;
+   uint32_t n = util_dynarray_num_elements(&queue->ts_pending, struct kk_ts_resolve);
+   uint32_t k = 0;
+   for (uint32_t i = 0; i < n; i++)
+      if (!(r[i].dst_addr >= lo && r[i].dst_addr < hi))
+         r[k++] = r[i];
+   queue->ts_pending.size = k * sizeof(*r);
+   simple_mtx_unlock(&queue->ts_lock);
+}
+
+void
+kk_queue_ts_purge_pool(struct kk_queue *queue, struct kk_query_pool *pool)
+{
+   simple_mtx_lock(&queue->ts_lock);
+   struct kk_ts_zero *z = queue->ts_zeros.data;
+   uint32_t n = util_dynarray_num_elements(&queue->ts_zeros, struct kk_ts_zero);
+   uint32_t k = 0;
+   for (uint32_t i = 0; i < n; i++)
+      if (z[i].pool != pool)
+         z[k++] = z[i];
+   queue->ts_zeros.size = k * sizeof(*z);
+   simple_mtx_unlock(&queue->ts_lock);
+}
+
+static void
+kk_queue_ts_before_commit(struct kk_queue *queue, struct kk_cmd_buffer *cmd)
+{
+   if (kk_resolve_groupe() < 2 ||
+       !util_dynarray_num_elements(&cmd->ts_needs, struct kk_ts_need))
+      return;
+   simple_mtx_lock(&queue->ts_lock);
+   util_dynarray_foreach(&cmd->ts_needs, struct kk_ts_need, need) {
+      if (kk_queue_ts_overlap_locked(queue, need->pool, need->first, need->count,
+                                     need->copie)) {
+         kk_queue_ts_flush_locked(queue, false);
+         break;
+      }
+   }
+   simple_mtx_unlock(&queue->ts_lock);
+}
+
+static void
+kk_queue_ts_after_commit(struct kk_queue *queue, struct kk_cmd_buffer *cmd)
+{
+   uint32_t n = util_dynarray_num_elements(&cmd->ts_resolves, struct kk_ts_resolve);
+   uint32_t nz = util_dynarray_num_elements(&cmd->ts_zeros, struct kk_ts_zero);
+   uint32_t nw = util_dynarray_num_elements(&cmd->ts_written, struct kk_ts_zero);
+   if (kk_resolve_groupe() < 2 || (n == 0 && nz == 0 && nw == 0))
+      return;
+   simple_mtx_lock(&queue->ts_lock);
+   if (nw && util_dynarray_num_elements(&queue->ts_zeros, struct kk_ts_zero)) {
+      util_dynarray_foreach(&cmd->ts_written, struct kk_ts_zero, w)
+         kk_ts_zero_remove_pub(&queue->ts_zeros, w->pool, w->first, w->count);
+   }
+   if (nz)
+      util_dynarray_append_array(&queue->ts_zeros, struct kk_ts_zero,
+                                 cmd->ts_zeros.data, nz);
+   if (n)
+      util_dynarray_append_array(&queue->ts_pending, struct kk_ts_resolve,
+                                 cmd->ts_resolves.data, n);
+   if (util_dynarray_num_elements(&queue->ts_pending, struct kk_ts_resolve) > 8192u ||
+       util_dynarray_num_elements(&queue->ts_zeros, struct kk_ts_zero) > 4096u)
+      kk_queue_ts_flush_locked(queue, false);
+   simple_mtx_unlock(&queue->ts_lock);
+}
+
+static void
+kk_queue_commit(struct kk_queue *queue, struct kk_cmd_buffer *cmd,
+                mtl_feedback_handler_callback callback, void *user_data)
+{
+   kk_queue_ts_before_commit(queue, cmd);
+   kk_queue_commit_inner(queue, cmd, callback, user_data);
+   kk_queue_ts_after_commit(queue, cmd);
+}
