+  LastCodeBlockHint = nullptr;
 }
 
 void IREmitter::ReplaceAllUsesWithRange(Ref Node, Ref NewNode, AllNodesIterator Begin, AllNodesIterator End) {
@@ -166,8 +167,12 @@
   } else {
     LOGMAN_THROW_A_FMT(CurrentCodeBlock != nullptr, "CurrentCodeBlock must not be null here");
 
-    // Find last block
-    auto LastBlock = CurrentCodeBlock;
+    // Find last block. Partir du dernier bloc ajoute en fin plutot que du bloc
+    // courant : les blocs ne sont jamais retires pendant la construction, il
+    // est toujours dans la liste et la fin est a sa suite. Le parcours depuis
+    // le bloc courant rendait la construction quadratique (un bloc par
+    // instruction sous FEX_SMCCHECKS=full : minutes de JIT pour D2R_loader).
+    auto LastBlock = LastCodeBlockHint ? LastCodeBlockHint : CurrentCodeBlock;
 
     while (LastBlock->Header.Next.GetNode(DualListData.ListBegin()) != InvalidNode) {
       LastBlock = LastBlock->Header.Next.GetNode(DualListData.ListBegin());
@@ -175,6 +180,7 @@
 
     // Append it after the last block
     LinkCodeBlocks(LastBlock, CodeNode);
+    LastCodeBlockHint = CodeNode;
   }
 
   SetWriteCursor(OldCursor);
