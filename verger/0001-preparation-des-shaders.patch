+++ b/Verger/Library/ShaderPreparationSheet.swift
@@ -0,0 +1,49 @@
+import CidreBridge
+import SwiftUI
+
+/// « Preparation des shaders » : avant de lancer un jeu D3D12/Vulkan, Cidre
+/// recompile hors du jeu les shaders que celui-ci a utilises lors des parties
+/// precedentes et qui ne sont pas encore compiles pour ce Mac (mise a jour de
+/// Cidre ou de macOS, cache vide), comme « Traitement des shaders Vulkan » de
+/// Steam. Passer lance le jeu tout de suite : le reste se compilera en jeu.
+struct ShaderPreparationSheet: View {
+    @Environment(LibraryModel.self) private var library
+    let request: ShaderPreparationRequest
+
+    private var progress: ShaderPreparation { request.progress }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 14) {
+            Label("Préparation des shaders", systemImage: "cpu")
+                .font(.title2.bold())
+            Text(L10n.format("Avant de lancer %@, Cidre compile pour ce Mac les shaders utilisés lors de tes dernières parties : le jeu les trouvera prêts, sans saccades.", request.game.name))
+                .fixedSize(horizontal: false, vertical: true)
+            ProgressView(value: progress.fraction) {
+                Text(verbatim: L10n.format("%lld sur %lld", progress.done, progress.total))
+                    .monospacedDigit()
+            }
+            Text("Passer lance le jeu tout de suite : le reste se compilera pendant la partie.")
+                .font(.callout)
+                .foregroundStyle(.secondary)
+                .fixedSize(horizontal: false, vertical: true)
+            HStack {
+                Spacer()
+                Button {
+                    library.skipPreparation(request.game)
+                } label: {
+                    if request.skipping {
+                        Text("Lancement…")
+                    } else {
+                        Text("Passer")
+                    }
+                }
+                .keyboardShortcut(.defaultAction)
+                .disabled(request.skipping)
+            }
+        }
+        .padding(20)
+        .frame(width: 440)
+        // la feuille se ferme d'elle-meme quand le jeu part ; Passer seul la quitte
+        .interactiveDismissDisabled()
+    }
+}
