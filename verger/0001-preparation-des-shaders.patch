+import Foundation
+import Testing
+
+@testable import CidreBridge
+
+/// La preparation des shaders d'avant lancement : l'evenement `preparation` de
+/// `cidre play --json` (Cidre tests/preparer_shaders.sh), ecrit avant
+/// l'evenement `lancement`, et rien du tout quand tout est deja compile.
+struct ShaderPreparationTests {
+    @Test func debutEtAvancement() throws {
+        guard case let .preparation(debut)? = PlayEvent.parse(line: #"{"evenement":"preparation","etat":"debut","fait":0,"total":1719}"#) else {
+            Issue.record("evenement preparation non reconnu"); return
+        }
+        #expect(debut.state == .started)
+        #expect(debut.done == 0)
+        #expect(debut.total == 1719)
+        #expect(debut.fraction == 0)
+        #expect(!debut.isFinished)
+        guard case let .preparation(cours)? = PlayEvent.parse(line: #"{"evenement":"preparation","etat":"en_cours","fait":860,"total":1719}"#) else {
+            Issue.record("evenement preparation non reconnu"); return
+        }
+        #expect(cours.state == .running)
+        #expect(abs(cours.fraction - 860.0 / 1719.0) < 1e-9)
+        #expect(!cours.isFinished)
+    }
+
+    @Test func finPasseeEchouee() throws {
+        guard case let .preparation(fin)? = PlayEvent.parse(line: #"{"evenement":"preparation","etat":"finie","fait":1718,"total":1719,"echecs":1,"duree":31}"#) else {
+            Issue.record("evenement preparation non reconnu"); return
+        }
+        #expect(fin.state == .done)
+        #expect(fin.failures == 1)
+        #expect(fin.duration == 31)
+        #expect(fin.isFinished)
+        guard case let .preparation(passee)? = PlayEvent.parse(line: #"{"evenement":"preparation","etat":"passee","fait":120,"total":1719,"echecs":0,"duree":4}"#) else {
+            Issue.record("evenement preparation non reconnu"); return
+        }
+        #expect(passee.state == .skipped)
+        #expect(passee.isFinished)
+        guard case let .preparation(echec)? = PlayEvent.parse(line: #"{"evenement":"preparation","etat":"echouee","fait":0,"total":3,"echecs":0,"duree":1}"#) else {
+            Issue.record("evenement preparation non reconnu"); return
+        }
+        #expect(echec.state == .failed)
+        #expect(echec.isFinished)
+    }
+
+    @Test func etatDeDemainEtChampsManquants() throws {
+        // un Cidre plus recent : rien ne tombe ; un total nul ne divise pas par zero
+        guard case let .preparation(p)? = PlayEvent.parse(line: #"{"evenement":"preparation","etat":"en_pause"}"#) else {
+            Issue.record("evenement preparation non reconnu"); return
+        }
+        #expect(p.state == .unknown)
+        #expect(p.total == 0)
+        #expect(p.fraction == 0)
+        #expect(!p.isFinished)
+        // trop fait (journal plus long que la base filtree) : borne a 1
+        #expect(ShaderPreparation(state: .running, done: 12, total: 10).fraction == 1)
+    }
+
+    @Test func lancementSuitToujours() {
+        #expect(PlayEvent.parse(line: #"{"evenement":"lancement"}"#) == .launching)
+    }
+}
