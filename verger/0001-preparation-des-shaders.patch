+    func skipPreparation(_ game: Game) {
+        guard let cli, preparations[game.id] != nil else { return }
+        skippingPreparation.insert(game.id)
+        Task {
+            do {
+                try await cli.skipShaderPreparation(id: game.id)
+            } catch {
+                // (un Cidre sans `preparation passer` : la preparation va a son terme)
+                skippingPreparation.remove(game.id)
+                lastError = error.localizedDescription
+            }
+        }
+    }
+
+    private func endPreparation(for game: Game) {
+        preparations[game.id] = nil
