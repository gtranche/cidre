+/// La preparation des shaders d'avant lancement : l'evenement `preparation` de
+/// `cidre play --json` (Cidre `tests/preparer_shaders.sh`). Avant le jeu, et
+/// hors de son processus, Cidre recompile les pipelines que le jeu a lies lors
+/// des parties precedentes et que ce KosmicKrisp, ce GPU ou ce macOS n'ont pas
+/// encore compiles, comme « Traitement des shaders Vulkan » de Steam. Rien
+/// n'est ecrit quand tout est deja compile. `cidre preparation <id> passer`
+/// (`CidreCLI.skipShaderPreparation`) l'arrete : le jeu part tout de suite.
+public struct ShaderPreparation: Decodable, Equatable, Sendable {
+    public enum State: String, Sendable {
+        case started = "debut"
+        case running = "en_cours"
+        /// Tout est fait (`failures` : pipelines que KosmicKrisp n'a pas pu compiler).
+        case done = "finie"
+        /// Passee : le reste se compilera en jeu.
+        case skipped = "passee"
+        /// Le rejeu a echoue : le jeu compilera lui-meme, comme sans preparation.
+        case failed = "echouee"
+        /// Un etat que ce Verger ne connait pas (Cidre plus recent).
+        case unknown = "inconnu"
+    }
+
+    public let state: State
+    /// Pipelines prets / a preparer.
+    public let done: Int
+    public let total: Int
+    public let failures: Int?
+    /// En secondes, a la fin.
+    public let duration: Int?
+
+    enum CodingKeys: String, CodingKey {
+        case state = "etat", done = "fait", total, failures = "echecs", duration = "duree"
+    }
+
+    public init(state: State, done: Int, total: Int, failures: Int? = nil, duration: Int? = nil) {
+        self.state = state
+        self.done = done
+        self.total = total
+        self.failures = failures
+        self.duration = duration
+    }
+
+    public init(from decoder: Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        state = (try? c.decode(String.self, forKey: .state)).flatMap(State.init(rawValue:)) ?? .unknown
+        done = ((try? c.decodeIfPresent(Int.self, forKey: .done)) ?? nil) ?? 0
+        total = ((try? c.decodeIfPresent(Int.self, forKey: .total)) ?? nil) ?? 0
+        failures = (try? c.decodeIfPresent(Int.self, forKey: .failures)) ?? nil
+        duration = (try? c.decodeIfPresent(Int.self, forKey: .duration)) ?? nil
+    }
+
+    /// La part faite, de 0 a 1.
+    public var fraction: Double {
+        total > 0 ? min(1, max(0, Double(done) / Double(total))) : 0
+    }
+
+    /// Plus rien ne suivra pour cette preparation : la feuille se ferme.
+    public var isFinished: Bool {
+        switch state {
+        case .done, .skipped, .failed: true
+        case .started, .running, .unknown: false
+        }
+    }
+}
