+static NTSTATUS
+_MetalLayer_isPresentable(void *obj) {
+  struct unixcall_generic_obj_uint64_ret *params = obj;
+  CAMetalLayer *layer = (CAMetalLayer *)params->handle;
+  params->ret = 1;
+
+  if (cidre_test_presentation < 0) {
+    const char *e = getenv("CIDRE_PRESENTATION_CACHEE");
+    cidre_test_presentation = !(e && *e == '1');
+  }
+  if (!cidre_test_presentation)
+    return STATUS_SUCCESS;
+  cidre_suivre_activation();
+
+  if (![layer.delegate isKindOfClass:NSView.class])
+    return STATUS_SUCCESS;
+  NSWindow *window = ((NSView *)layer.delegate).window;
+  if (!window)
+    return STATUS_SUCCESS;
+
+  BOOL visible = (window.occlusionState & NSWindowOcclusionStateVisible) != 0;
+  BOOL plein_ecran = (window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+  /* Le critere « appli inactive » ne vaut qu'avec un seul ecran : avec deux, un
+     jeu plein ecran sur l'un reste visible quand on clique dans une autre appli
+     sur l'autre, et doit continuer d'etre presente. Il ne reste alors que
+     l'occlusion. */
+  if (!visible || (plein_ecran && atomic_load(&cidre_un_seul_ecran) && !atomic_load(&cidre_appli_active)))
