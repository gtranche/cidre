+/*
+ * Cidre : ne plus presenter quand la fenetre quitte l'ecran.
+ *
+ * Le 2026-10-16, Sherlock Holmes Chapter One (DXMT) a fige le M1 au
+ * changement d'espace : WindowServer capturait l'espace plein ecran qu'on
+ * quittait (WSCaptureMenuResolveDesktopChanges -> CaptureSurfaceMetal) et sa
+ * soumission Metal restait bloquee dans le noyau AGX en meme temps que celle
+ * du jeu ; watchdog de WindowServer, puis panique. Le jeu presentait sans
+ * vsync, en continu, pendant toute la transition. Une appli Mac cesse de
+ * dessiner quand sa fenetre n'est plus visible ; on fait de meme.
+ *
+ * Faux quand la fenetre n'est pas visible (occlusion), ou quand elle est dans
+ * un espace plein ecran et que l'appli n'est plus active : la desactivation
+ * (NSApplicationWillResignActive) precede la capture et le changement
+ * d'espace d'environ 250 ms (sonde tests/sonde_gel_espace.m), l'occlusion
+ * arrive apres. Une fenetre ordinaire visible derriere une autre appli
+ * continue d'etre presentee, et avec plusieurs ecrans seule l'occlusion compte. CIDRE_PRESENTATION_CACHEE=1 desactive le test.
+ */
+static _Atomic int cidre_appli_active = 1;
+static _Atomic int cidre_un_seul_ecran = 1;
+static int cidre_test_presentation = -1;
+
+static void
+cidre_suivre_activation(void) {
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    dispatch_async(dispatch_get_main_queue(), ^{
+      NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+      atomic_store(&cidre_appli_active, NSApp ? (int)[NSApp isActive] : 1);
+      atomic_store(&cidre_un_seul_ecran, [NSScreen screens].count <= 1);
+      [nc addObserverForName:NSApplicationDidChangeScreenParametersNotification object:nil queue:nil
+                  usingBlock:^(NSNotification *n) {
+        atomic_store(&cidre_un_seul_ecran, [NSScreen screens].count <= 1); }];
+      [nc addObserverForName:NSApplicationWillResignActiveNotification object:nil queue:nil
+                  usingBlock:^(NSNotification *n) { atomic_store(&cidre_appli_active, 0); }];
+      [nc addObserverForName:NSApplicationDidResignActiveNotification object:nil queue:nil
+                  usingBlock:^(NSNotification *n) { atomic_store(&cidre_appli_active, 0); }];
+      [nc addObserverForName:NSApplicationDidBecomeActiveNotification object:nil queue:nil
+                  usingBlock:^(NSNotification *n) { atomic_store(&cidre_appli_active, 1); }];
+    });
+  });
+}
