+  /* Vidage des textures a leur creation, pour regarder ce que le jeu televerse
+   * plutot que d'en juger a l'ecran. Inerte sans PROTON_OUVERT_VIDER_TEXTURES,
+   * qui nomme le dossier de sortie. Un fichier PGM ou PPM par texture, lisible
+   * sans outil. */
+  static void ViderTextureInitiale(
+    const D3D11_COMMON_TEXTURE_DESC*  pDesc,
+    const D3D11_SUBRESOURCE_DATA*     pInitialData) {
+    const char* dossier = std::getenv("PROTON_OUVERT_VIDER_TEXTURES");
+
+    if (!dossier)
+      return;
+
+    /* D'abord dire ce qu'on voit passer : sans cela on ne sait pas si le
+     * silence vient de l'absence de textures ou du filtre. */
+    Logger::info(str::format("texture vue : ", pDesc->Width, "x", pDesc->Height,
+      " fmt ", uint32_t(pDesc->Format), " mips ", pDesc->MipLevels,
+      " usage ", uint32_t(pDesc->Usage), " bind ", uint32_t(pDesc->BindFlags),
+      pInitialData && pInitialData[0].pSysMem ? " avec donnees" : " sans donnees"));
+
+    if (!pInitialData || !pInitialData[0].pSysMem)
+      return;
+
+    uint32_t octets = 0;
+    bool gris = false;
+
+    switch (pDesc->Format) {
+      case DXGI_FORMAT_A8_UNORM:
+      case DXGI_FORMAT_R8_UNORM:       octets = 1; gris = true;  break;
+      case DXGI_FORMAT_B8G8R8A8_UNORM:
+      case DXGI_FORMAT_R8G8B8A8_UNORM: octets = 4; gris = false; break;
+      default: return;
+    }
+
+    static std::atomic<uint32_t> compteur = { 0u };
+    uint32_t n = compteur++;
+
+    std::string nom = str::format(dossier, "/texture-", n, "-",
+      pDesc->Width, "x", pDesc->Height, "-fmt", uint32_t(pDesc->Format),
+      gris ? ".pgm" : ".ppm");
+
+    std::ofstream f(nom, std::ios::binary);
+    if (!f)
+      return;
+
+    f << (gris ? "P5\n" : "P6\n") << pDesc->Width << " " << pDesc->Height << "\n255\n";
+
+    auto src = reinterpret_cast<const uint8_t*>(pInitialData[0].pSysMem);
+
+    for (uint32_t y = 0; y < pDesc->Height; y++) {
+      const uint8_t* ligne = src + size_t(y) * pInitialData[0].SysMemPitch;
+
+      if (gris) {
+        f.write(reinterpret_cast<const char*>(ligne), pDesc->Width);
+      } else {
+        for (uint32_t x = 0; x < pDesc->Width; x++) {
+          /* On ecrit l'alpha en niveaux de gris dans les trois canaux : c'est
+           * lui qui porte la couverture d'un atlas de police. */
+          char v = char(ligne[x * octets + 3]);
+          char t[3] = { v, v, v };
+          f.write(t, 3);
+        }
+      }
+    }
+
+    Logger::info(str::format("texture videe : ", nom));
+  }
