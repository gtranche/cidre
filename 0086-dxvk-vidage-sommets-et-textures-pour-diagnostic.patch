+
+  template<typename ContextType>
+  void D3D11CommonContext<ContextType>::ViderSommets(const char* quoi, UINT nb, UINT premier) {
+    /* Interroger l'environnement a chaque dessin couterait cher : on le lit une
+     * fois. Sans la variable, le crochet se reduit a un test. */
+    static const char* const ou = std::getenv("PROTON_OUVERT_VIDER_SOMMETS");
+
+    if (!ou || nb > 600u)
+      return;
+
+    /* Les premiers dessins sont ceux du chargement. Compter les dessins est peu
+     * sur -- un menu statique en demande une poignee -- alors on attend un
+     * nombre de secondes, donne par PROTON_OUVERT_VIDER_SOMMETS_APRES. */
+    static const auto debut = std::chrono::steady_clock::now();
+    static std::atomic<uint32_t> nd = { 0u };
+
+    static const char* const apres = std::getenv("PROTON_OUVERT_VIDER_SOMMETS_APRES");
+    long secondes = apres ? strtol(apres, nullptr, 10) : 0;
+
+    auto ecoule = std::chrono::duration_cast<std::chrono::seconds>(
+      std::chrono::steady_clock::now() - debut).count();
+
+    if (ecoule < secondes || nd >= 200u)
+      return;
+
+    /* Le bon discriminant n'est pas la valeur mais la ressource liee : le
+     * dessin du texte est celui dont le nuanceur de fragments a pour texture
+     * l'atlas. PROTON_OUVERT_VIDER_SOMMETS_ATLAS donne sa largeur ; sans elle
+     * on ne filtre pas. Chercher des coordonnees dans quatre mille dessins ne
+     * menait nulle part (§281). */
+    static const char* const largeur = std::getenv("PROTON_OUVERT_VIDER_SOMMETS_ATLAS");
+    uint32_t cote = largeur ? uint32_t(strtoul(largeur, nullptr, 10)) : 0u;
+    int fente = -1;
+
+    if (cote) {
+      auto& srv = m_state.srv[DxbcProgramType::PixelShader];
+
+      for (uint32_t i = 0; i < srv.maxCount && fente < 0; i++) {
+        auto& vue = srv.views[i];
+
+        if (vue == nullptr)
+          continue;
+
+        auto iv = vue->GetImageView();
+
+        if (iv != nullptr && iv->image() != nullptr
+         && iv->image()->info().extent.width  == cote
+         && iv->image()->info().extent.height == cote)
+          fente = int(i);
+      }
+
+      if (fente < 0)
+        return;
+    }
+
+    auto& vb = m_state.ia.vertexBuffers[0];
+
+    if (vb.buffer == nullptr)
+      return;
+
+    /* Chaque dessin commence a son propre sommet : lire le debut du tampon ne
+     * montrait que le premier quadrilatere de l'image, toujours le meme. */
+    auto tranche = vb.buffer->GetBufferSlice(vb.offset + size_t(premier) * vb.stride);
+
+    if (!tranche.mapPtr(0))
+      return;
+
+    uint32_t n = nd++;
+    size_t octets = std::min<size_t>(tranche.length(), size_t(nb) * vb.stride);
+    std::ofstream f(ou, std::ios::app);
+
+    if (!f)
+      return;
+
+    f << "dessin " << n << " par " << quoi << " atlas_en_fente " << fente << " nb " << nb << " premier " << premier
+      << " pas " << vb.stride << " octets " << octets << "\n";
+
+    auto v = reinterpret_cast<const float*>(tranche.mapPtr(0));
+
+    for (size_t i = 0; i < octets / 4u && i < 1536u; i++)
+      f << v[i] << (((i + 1u) % 8u) ? " " : "\n");
+
+    /* Le tampon de sommets ne porte qu'un quadrilatere unite : la position et
+     * les coordonnees d'un libelle viennent d'un tampon de constantes. On
+     * l'ecrit aussi, sans quoi on ne voit rien de ce qui nous interesse. */
+    /* Tous les tampons de constantes des deux nuanceurs, et toute ressource
+     * liee qui est un tampon : la position d'un libelle est forcement dans
+     * l'un d'eux. */
+    static const struct { DxbcProgramType t; const char* nom; } etages[] = {
+      { DxbcProgramType::VertexShader, "vs" },
+      { DxbcProgramType::PixelShader,  "ps" } };
+
+    for (auto& e : etages) {
+      auto& cbv = m_state.cbv[e.t];
+
+      for (uint32_t i = 0; i < cbv.maxCount; i++) {
+        auto& cb = cbv.buffers[i];
+
+        if (cb.buffer == nullptr)
+          continue;
+
+        auto tc = cb.buffer->GetBufferSlice(cb.constantOffset * 16u);
+
+        if (!tc.mapPtr(0))
+          continue;
+
+        size_t nc = std::min<size_t>(tc.length(), 512u);
+        auto c = reinterpret_cast<const float*>(tc.mapPtr(0));
+
+        f << "  cb " << e.nom << i << " (" << tc.length() << " o) :";
+        for (size_t k = 0; k < nc / 4u && k < 40u; k++)
+          f << " " << c[k];
+        f << "\n";
+      }
+
+      auto& srv = m_state.srv[e.t];
+
+      for (uint32_t i = 0; i < srv.maxCount; i++) {
+        auto& vue = srv.views[i];
+
+        if (vue == nullptr || vue->GetResourceType() != D3D11_RESOURCE_DIMENSION_BUFFER)
+          continue;
+
+        auto bv = vue->GetBufferView();
+
+        if (bv == nullptr || bv->buffer() == nullptr || !bv->buffer()->mapPtr(0))
+          continue;
+
+        size_t nb2 = std::min<size_t>(bv->info().size, 512u);
+        auto c = reinterpret_cast<const float*>(bv->buffer()->mapPtr(bv->info().offset));
+
+        f << "  srv " << e.nom << i << " tampon (" << bv->info().size << " o) :";
+        for (size_t k = 0; k < nb2 / 4u && k < 40u; k++)
+          f << " " << c[k];
+        f << "\n";
+      }
     }
+
+    f << "\n";
   }
 
 
