+/* CIDRE_SSBO_SANS_BORNES : les SSBO prennent le format d'adresse sans
+ * robustesse meme si le pipeline la demande (robustBufferAccess2 de vkd3d), comme
+ * le convertisseur d'Apple pour les tampons bruts. Plus de test de borne par
+ * lecture ni de lectures decoupees en scalaires. Risque : faute GPU si le jeu lit
+ * hors d'un tampon ; option par fiche. Les indices de descripteurs restent bornes.
+ */
+static inline nir_address_format
+kk_ssbo_addr_format(VkPipelineRobustnessBufferBehaviorEXT robustness)
+{
+   static int sans_bornes = -1;
+   if (sans_bornes < 0)
+      sans_bornes = getenv("CIDRE_SSBO_SANS_BORNES") != NULL;
+   if (sans_bornes)
+      return nir_address_format_64bit_global_32bit_offset;
+   return kk_buffer_addr_format(robustness);
+}
