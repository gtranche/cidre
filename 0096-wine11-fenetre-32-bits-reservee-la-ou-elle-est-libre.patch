+#ifdef __APPLE__
+/* La fenetre de l'invite 32 bits est-elle a nous ? Voir virtual_init. */
+static BOOL fenetre_reservee;
+
+/* Prendre 4 Gio a cette adresse, si le noyau les accorde la et pas ailleurs. */
+static BOOL reserver_fenetre( ULONG_PTR base )
+{
+    void *p = mmap( (void *)base, limit_4g, PROT_NONE, MAP_PRIVATE | MAP_ANON | MAP_NORESERVE, -1, 0 );
+
+    if (p == MAP_FAILED) return FALSE;
+    if (p != (void *)base)
+    {
+        munmap( p, limit_4g );
+        return FALSE;
+    }
+    mmap_add_reserved_area( p, limit_4g );
+    return TRUE;
 }
+
+/*
+ * Une recherche qui ne vise pas la fenetre de l'invite 32 bits ne doit pas y
+ * tomber : la zone est reservee, donc preferee par map_reserved_area, et
+ * l'hote ou un invite 64 bits y prendraient la place des programmes 32 bits.
+ * Quand la plage demandee enjambe la fenetre, on cherche de part et d'autre.
+ */
+static BOOL enjambe_la_fenetre( const void *start, const void *end )
+{
+    const char *debut = (const char *)user_space_wow_base, *fin = debut + limit_4g;
 
+    if (!fenetre_reservee) return FALSE;
+    if ((const char *)end <= debut || (const char *)start >= fin) return FALSE;      /* a cote */
+    return !((const char *)start >= debut && (const char *)end <= fin);               /* dedans : c'est l'invite */
+}
+#endif
 
