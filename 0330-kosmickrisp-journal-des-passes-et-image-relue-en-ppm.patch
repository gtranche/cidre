+   if (ri->pStencilAttachment && ri->pStencilAttachment->imageView) {
+      const VkRenderingAttachmentInfo *a = ri->pStencilAttachment;
+      VK_FROM_HANDLE(kk_image_view, iv, a->imageView);
+      kk_journal(cmd, " s=%04x/L%dS%d", kk_jimg(iv), a->loadOp, a->storeOp);
+   }
+   kk_journal(cmd, "]");
+}
