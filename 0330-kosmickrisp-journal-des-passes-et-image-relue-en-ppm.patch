+/* ===== Cidre CIDRE_PASSES_JOURNAL=<delai_s>[:<fenetre_ms>] (diagnostic) =====
+ * Pendant une fenetre (defaut 120 ms) commencant <delai_s> secondes apres la
+ * premiere soumission, chaque enregistrement note ses evenements (passes de
+ * rendu avec attachements et operations load/store Vulkan et Metal, raisons
+ * de fermeture des encodeurs, effacements, barrieres, dispatchs) ; ils sont
+ * imprimes a la soumission (CIDRE_PASSES_JOURNAL_FICHIER, sinon stderr) avec
+ * le decoupage des soumissions (file, attentes, signaux). */
+uint64_t kk_journal_t0;
+static double kk_journal_delai = -1.0, kk_journal_fen = 0.12;
+
+static void
+kk_journal_init(void)
+{
+   if (kk_journal_delai > -0.5)
+      return;
+   const char *v = getenv("CIDRE_PASSES_JOURNAL");
+   if (!v) {
+      kk_journal_delai = 1e30;
+      return;
+   }
+   kk_journal_delai = atof(v);
+   const char *c = strchr(v, ':');
+   if (c)
+      kk_journal_fen = atof(c + 1) / 1000.0;
+}
+
+/* 0 avant la fenetre, 1 dedans, 2 apres. */
+int
+kk_journal_phase(void)
+{
+   kk_journal_init();
+   if (kk_journal_delai > 1e29 || !kk_journal_t0)
+      return 0;
+   double t = (os_time_get_nano() - kk_journal_t0) / 1e9;
+   if (t < kk_journal_delai - 0.05)
+      return 0;
+   return t <= kk_journal_delai + kk_journal_fen ? 1 : 2;
+}
+
+bool
+kk_journal_arme(void)
+{
+   return kk_journal_phase() == 1;
+}
+
+void
+kk_journal_c(struct kk_cmd_buffer *cmd, char c)
+{
+   util_dynarray_append(&cmd->journal, c);
+}
+
+void
+kk_journal(struct kk_cmd_buffer *cmd, const char *fmt, ...)
+{
+   char buf[1024];
+   va_list ap;
+   va_start(ap, fmt);
+   int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+   va_end(ap);
+   if (n <= 0)
+      return;
+   if (n >= (int)sizeof(buf))
+      n = sizeof(buf) - 1;
+   util_dynarray_append_array(&cmd->journal, char, buf, n);
+}
+
+static unsigned
+kk_jimg(const struct kk_image_view *iv)
+{
+   return iv ? (unsigned)(((uintptr_t)iv->vk.image >> 4) & 0xffffu) : 0u;
+}
