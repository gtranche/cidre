+              ri->renderArea.offset.y, ri->flags, whole ? "" : " PARTIEL");
+   for (uint32_t i = 0; i < ri->colorAttachmentCount; i++) {
+      const VkRenderingAttachmentInfo *a = &ri->pColorAttachments[i];
+      if (!a->imageView)
+         continue;
+      VK_FROM_HANDLE(kk_image_view, iv, a->imageView);
+      kk_journal(cmd, " c%u=%04x/f%u/L%dS%d%s", i, kk_jimg(iv), iv->vk.format,
+                 a->loadOp, a->storeOp,
+                 a->resolveMode ? "/res" : "");
+   }
+   if (ri->pDepthAttachment && ri->pDepthAttachment->imageView) {
+      const VkRenderingAttachmentInfo *a = ri->pDepthAttachment;
+      VK_FROM_HANDLE(kk_image_view, iv, a->imageView);
