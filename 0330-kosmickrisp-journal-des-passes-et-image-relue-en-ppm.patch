+/* CIDRE_PASSES_JOURNAL : imprime les enregistrements notes (voir
+ * kk_journal_phase), une ligne par enregistrement, precedee de la soumission. */
+static void
+kk_journal_soumission(struct kk_queue *queue, const struct vk_queue_submit *submit)
+{
+   static FILE *f;
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   static uint32_t n_soum;
+   bool any = false;
+   for (uint32_t i = 0; i < submit->command_buffer_count; ++i) {
+      struct kk_cmd_buffer *c =
+         container_of(submit->command_buffers[i], struct kk_cmd_buffer, vk);
+      any |= c->journal_on;
+   }
+   if (!any)
+      return;
+   simple_mtx_lock(&lock);
+   if (!f) {
+      const char *p = getenv("CIDRE_PASSES_JOURNAL_FICHIER");
+      f = p ? fopen(p, "w") : NULL;
+      if (!f)
+         f = stderr;
+   }
+   double t = (os_time_get_nano() - kk_journal_t0) / 1e9;
+   fprintf(f, "SOUM %u t=%.4f file=%p ncb=%u att=%u sig=%u\n", n_soum++, t,
+           (void *)queue, submit->command_buffer_count, submit->wait_count,
+           submit->signal_count);
+   for (uint32_t i = 0; i < submit->command_buffer_count; ++i) {
+      struct kk_cmd_buffer *c =
+         container_of(submit->command_buffers[i], struct kk_cmd_buffer, vk);
+      uint32_t n = util_dynarray_num_elements(&c->journal, char);
+      fprintf(f, " CB%u %s%s%s sc%u : %.*s\n", i, c->journal_on ? "" : "(non note)",
+              c->submitted ? " REJOUE" : "", c->drawable ? " PRESENT" : "",
+              (unsigned)util_dynarray_num_elements(&c->metal.sealed_cmd_bufs, mtl_command_buffer *),
+              (int)n, (const char *)c->journal.data);
+      c->journal_on = false;
+   }
+   fflush(f);
+   simple_mtx_unlock(&lock);
+}
+
