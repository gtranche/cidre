+inline air::MSLScalerOrVectorType to_narrow_msl_type(RegisterComponentType type, uint32_t components) {
+  air::MSLScalerType scaler = air::msl_float;
+  if (type == RegisterComponentType::Uint && components)
+    scaler = air::msl_uint;
+  if (type == RegisterComponentType::Int && components)
+    scaler = air::msl_int;
+  if (components <= 1)
+    return std::visit([](auto s) -> air::MSLScalerOrVectorType { return s; }, scaler);
+  return air::MSLVector{components, scaler};
 }
 
