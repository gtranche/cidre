+IREffect
+init_input_reg_narrow(uint32_t with_fnarg_at, uint32_t to_reg, uint32_t mask) {
+  return make_effect_bind([=](context ctx) {
+    pvalue arg = ctx.function->getArg(with_fnarg_at);
+    auto const_index = llvm::ConstantInt::get(ctx.llvm, llvm::APInt{32, to_reg, false});
+    auto array = arg->getType()->getScalarType()->isFloatTy() ? ctx.resource.input.ptr_float4
+                                                              : ctx.resource.input.ptr_int4;
+    /* chaque composante recue retourne a sa place dans le registre */
+    pvalue vec4;
+    if (!arg->getType()->isVectorTy()) {
+      vec4 = ctx.builder.CreateInsertElement(
+          llvm::UndefValue::get(llvm::FixedVectorType::get(arg->getType(), 4)), arg, (uint64_t)__builtin_ctz(mask)
+      );
+    } else {
+      int placed[4], next = 0;
+      for (int i = 0; i < 4; i++)
+        placed[i] = (mask & (1 << i)) ? next++ : llvm::UndefMaskElem;
+      vec4 = ctx.builder.CreateShuffleVector(arg, {placed[0], placed[1], placed[2], placed[3]});
+    }
+    return store_at_vec4_array_masked(array, const_index, vec4, mask);
+  });
+};
 
