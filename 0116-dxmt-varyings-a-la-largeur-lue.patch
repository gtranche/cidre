+  uint16_t varying_masks[32] = {};
+  bool varyings_narrowable = true;
 
+  /* note l'element de varying (registre, masque de signature) et les
+     composantes `mask` qu'il porte ; tout chevauchement interdit la reduction */
+  void add_varying(uint32_t reg, uint32_t sig_mask, uint32_t mask) {
+    sig_mask &= 0xf;
+    if (reg >= 32 || !sig_mask || !mask || (mask & ~sig_mask)) {
+      varyings_narrowable = false;
+      return;
+    }
+    uint32_t shift = std::countr_zero(sig_mask) * 4;
+    uint32_t others = 0;
+    for (uint32_t first = 0; first < 16; first += 4)
+      if (first != shift)
+        others |= (varying_masks[reg] >> first) & 0xf;
+    uint32_t known = (varying_masks[reg] >> shift) & 0xf;
+    if ((known && known != mask) || (others & mask))
+      varyings_narrowable = false;
+    varying_masks[reg] |= mask << shift;
+  }
