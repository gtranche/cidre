+/* Varyings declares a la largeur lue par le pixel shader (pipeline VS + PS sans
+   GS, tessellation ni stream-output). Vertex shader : read_mask porte 4 bits par
+   registre de sortie (les composantes lues) et chaque varying est reduit a ces
+   composantes ; un varying dont rien n'est lu n'est plus calcule. Pixel
+   shader : la presence de l'argument suffit, chaque entree prend la largeur de
+   son dcl_input_ps. Les deux cotes doivent etre compiles ainsi, avec le masque
+   de SM50NarrowVaryingMasks(). */
+struct SM50_SHADER_NARROW_VARYINGS_DATA {
+  void *next;
+  enum SM50_SHADER_COMPILATION_ARGUMENT_TYPE type;
+  uint32_t read_mask[4];
+};
+
 AIRCONV_API int SM50Initialize(
   const void *pBytecode, size_t BytecodeSize, sm50_shader_t *ppShader,
   struct MTL_SHADER_REFLECTION *pRefl, sm50_error_t *ppError
@@ -362,6 +384,35 @@
 #ifdef __cplusplus
 };
 
+/* Masque des composantes de varyings lues par le pixel shader, par registre de
+   sortie du vertex shader. Renvoie false quand il n'y a rien a reduire ou quand
+   les deux signatures ne se correspondent pas element par element : le pipeline
+   garde alors ses varyings float4. */
+inline bool SM50NarrowVaryingMasks(
+  const struct MTL_SHADER_REFLECTION &VertexShader, const struct MTL_SHADER_REFLECTION &PixelShader,
+  uint32_t ReadMask[4]
+) {
+  ReadMask[0] = ReadMask[1] = ReadMask[2] = ReadMask[3] = 0;
+  if (!VertexShader.VaryingsNarrowable || !PixelShader.VaryingsNarrowable)
+    return false;
+  bool narrowed = false;
+  for (unsigned reg = 0; reg < 32; reg++) {
+    uint32_t read = 0;
+    for (unsigned first = 0; first < 4; first++) {
+      uint32_t ps = (PixelShader.VaryingMasks[reg] >> (first * 4)) & 0xf;
+      uint32_t vs = (VertexShader.VaryingMasks[reg] >> (first * 4)) & 0xf;
+      if (!ps)
+        continue;
+      if (!vs || (ps & ~vs))
+        return false;
+      narrowed |= ps != 0xf;
+      read |= ps;
+    }
+    ReadMask[reg / 8] |= read << ((reg % 8) * 4);
+  }
+  return narrowed;
+};
+
