+std::function<IRValue(pvalue)>
+pop_output_reg_narrow(uint32_t from_reg, uint32_t mask, uint32_t narrow_mask, uint32_t to_element) {
+  return [=](pvalue ret) {
+    return make_irvalue_bind([=](context ctx) -> IRValue {
+      auto const_index = llvm::ConstantInt::get(ctx.llvm, llvm::APInt{32, from_reg, false});
+      pvalue vec4 = co_yield load_from_array_at(ctx.resource.output.ptr_int4, const_index);
+      auto desired_type = ctx.function->getReturnType()->getStructElementType(to_element);
+      if (desired_type->getScalarType()->isFloatTy())
+        vec4 = ctx.builder.CreateBitCast(vec4, ctx.types._float4);
+      /* comme pop_output_reg : une composante que le shader n'a pas declaree reste undef */
+      llvm::SmallVector<int, 4> kept;
+      for (int i = 0; i < 4; i++) {
+        if (narrow_mask & (1 << i))
