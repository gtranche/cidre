+static void
+kk_banc_bind(struct kk_device *dev, struct kk_rejeu_index *ix, const char *d)
+{
+   struct kk_banc b = {0};
+   b.dev = dev;
+   b.ix = ix;
+   b.relus = kk_env_u("CIDRE_BANC_RELUS", 0) != 0;
+   b.max = kk_env_u("CIDRE_REJEU_MAX", 2000);
+   const unsigned nb = kk_env_u("CIDRE_BANC_BIND", 50);
+   const unsigned pause_ms = kk_env_u("CIDRE_BANC_PAUSE_MS", 20);
+   char chemin[1024];
+   snprintf(chemin, sizeof(chemin), "%s/pipelines.bin", d);
+   b.fd_p = open(chemin, O_RDONLY | O_CLOEXEC);
+   const int64_t t0 = os_time_get_nano();
+   atomic_store(&kk_banc_retenue, true);
+   kk_base_parcourir(chemin, KK_BASE_MAGIC_P, NULL, kk_banc_un, &b);
+   const int64_t t1 = os_time_get_nano();
+   fprintf(stderr, "kk: banc bind : %u pipelines crees (%s) en %.1f s, %u absents du cache, "
+                   "%u illisibles ; file de fond %u ; prise=%d cede=%d\n",
+           b.crees, b.relus ? "relus" : "froids", (t1 - t0) / 1e9, b.absents,
+           b.illisibles, atomic_load(&dev->fond_en_file), kk_bind_prise(),
+           kk_fond_cede());
+   const uint32_t fond0 = atomic_load(&kk_stat_fond[1]);
+   atomic_store(&kk_banc_retenue, false);
+   usleep(kk_env_u("CIDRE_BANC_DELAI_MS", 300) * 1000u);
+
+   uint64_t *dt = calloc(nb ? nb : 1, sizeof(uint64_t));
+   unsigned faits = 0, attendus = 0;
+   const unsigned pas = b.crees > nb && nb ? b.crees / nb : 1;
+   const int64_t t2 = os_time_get_nano();
+   for (unsigned k = 0; k < nb && k * pas < b.crees; k++) {
+      const unsigned p = b.crees - 1 - k * pas;
+      struct vk_shader *paire[2] = {b.sh[2 * p], b.sh[2 * p + 1]};
+      const mesa_shader_stage st[2] = {MESA_SHADER_VERTEX, MESA_SHADER_FRAGMENT};
+      const int64_t ta = os_time_get_nano();
+      kk_bind_preparer(2, st, paire);
+      for (unsigned i = 0; i < 2; i++) {
+         struct kk_shader *s = container_of(paire[i], struct kk_shader, vk);
+         kk_shader_kick(s);
+         kk_bind_mesurer(s, true);
+         kk_shader_wait_compiled(s);
+      }
+      kk_bind_finir();
+      dt[faits] = (uint64_t)(os_time_get_nano() - ta) / 1000u;
+      if (dt[faits] > 200)
+         attendus++;
+      faits++;
+      if (pause_ms)
+         usleep(pause_ms * 1000u);
+   }
+   const int64_t t3 = os_time_get_nano();
+   const uint32_t fond1 = atomic_load(&kk_stat_fond[1]);
+   uint64_t somme = 0;
+   for (unsigned k = 0; k < faits; k++)
+      somme += dt[k];
+   qsort(dt, faits, sizeof(uint64_t), kk_banc_cmp);
+   fprintf(stderr, "kk: banc bind : %u binds (%u ont attendu >0,2 ms) en %.2f s ; attente totale %.1f ms, "
+                   "moyenne %.2f ms, p50 %.2f ms, p90 %.2f ms, max %.2f ms ; fond : %u compiles pendant les binds "
+                   "(%.1f/s), %u en file a la fin\n",
+           faits, attendus, (t3 - t2) / 1e9, somme / 1000.0,
+           faits ? somme / 1000.0 / faits : 0.0,
+           faits ? dt[faits / 2] / 1000.0 : 0.0,
+           faits ? dt[(faits * 9) / 10] / 1000.0 : 0.0,
+           faits ? dt[faits - 1] / 1000.0 : 0.0,
+           fond1 - fond0, (fond1 - fond0) / ((t3 - t2) / 1e9),
+           atomic_load(&dev->fond_en_file));
+   free(dt);
+   for (unsigned k = 0; k < 2 * b.crees; k++)
+      vk_pipeline_cache_object_unref(&dev->vk, &b.sh[k]->pipeline.cache_obj);
+   free(b.sh);
+   if (b.fd_p >= 0)
+      close(b.fd_p);
+}
