+      out[1] = out[0] ? kk_banc_relire(b->dev, cles + KK_BASE_CLE) : NULL;
+      if (out[0] == NULL || out[1] == NULL) {
+         if (out[0] != NULL)
+            vk_pipeline_cache_object_unref(&b->dev->vk, &out[0]->pipeline.cache_obj);
+         b->absents++;
+         return;
+      }
+   } else {
+      uint8_t *buf = malloc(taille);
+      if (buf == NULL || pread(b->fd_p, buf, taille, pos) != (ssize_t)taille) {
+         free(buf);
+         return;
+      }
+      struct kk_rejeu_job *j = kk_rejeu_lire(b->dev, b->ix, buf, taille);
+      free(buf);
+      if (j == NULL) {
+         b->illisibles++;
+         return;
+      }
+      VkResult r = kk_compile_shaders(&b->dev->vk, 2, j->infos, &j->state,
+                                      j->features, &b->dev->vk.alloc, out);
+      j->infos[0].nir = j->infos[1].nir = NULL; /* pris ou consommes */
+      if (r == VK_SUCCESS && out[0] != NULL && out[1] != NULL) {
+         vk_cidre_shader_init_cache_obj(&b->dev->vk, out[0], j->vs_cle);
+         vk_cidre_shader_init_cache_obj(&b->dev->vk, out[1], j->fs_cle);
+      } else {
+         b->illisibles++;
+         kk_rejeu_job_free(j);
+         return;
+      }
+      kk_rejeu_job_free(j);
+   }
+   if (b->crees * 2 + 2 > b->cap) {
+      b->cap = b->cap ? b->cap * 2 : 1024;
+      b->sh = realloc(b->sh, b->cap * sizeof(*b->sh));
+   }
+   b->sh[b->crees * 2] = out[0];
+   b->sh[b->crees * 2 + 1] = out[1];
+   b->crees++;
+   kk_shaders_crees(&b->dev->vk, 2, out);
+}
