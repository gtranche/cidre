+// SPDX-License-Identifier: MIT
+/*
+$info$
+tags: ir|opts
+desc: Cidre 0287 : deux lectures TSO GPR voisines (4 ou 8 octets), sans rien entre elles qui touche la memoire, en une seule
+$end_info$
+*/
+
+// Sous TSO, chaque lecture GPR est un ldar, et quatre ldar de suite se serialisent (sur M1, ~3 cycles de plus chacun) :
+// lire un tableau d'indices (gather SSE, table de correspondance) coutait 4x Rosetta. Deux lectures de 4 octets a
+// Addr et Addr + 4, dans le meme bloc, sans acces memoire, barriere, atomique, saut ou appel entre elles, deviennent
+// CidreLoadMemTSOPaire (une lecture de 8 octets alignee : atomique en copie unique, puis ordonnee comme un ldar). Les deux
+// valeurs viennent du meme instant : c'est l'execution TSO ou L2 suit L1 sans evenement entre les deux, donc rien n'est
+// relache. Adresses comparees sous forme base + index << decalage + constante, les registres invites suivis par version
+// (un StoreRegister en change la version). CIDRE_TSO_PAIRES=0 coupe la passe ; elle ne tourne qu'avec le TSO.
+
+#include "Interface/IR/IR.h"
+#include "Interface/IR/IREmitter.h"
+#include "Interface/IR/PassManager.h"
+#include "Interface/IR/Passes.h"
+#include "Interface/IR/RegisterAllocationData.h"
+
+#include <FEXCore/IR/IR.h>
+#include <FEXCore/Utils/LogManager.h>
+#include <FEXCore/Utils/Profiler.h>
+#include <FEXCore/fextl/vector.h>
+
+#include <array>
+#include <cstdlib>
+
+namespace FEXCore::IR {
+namespace {
+  // Forme symbolique d'une adresse : Base (+ Index << Decalage) + Const. Base/Index : 0 = absent,
+  // (1 << 40) | (reg << 20) | version pour un registre invite, (2 << 40) | id pour un autre noeud SSA.
+  struct Sym {
+    uint64_t Base {}, Index {};
+    uint8_t Decalage {};
+    int64_t Const {};
+    bool Ok {};
+  };
+
+  class CidreTSOPairesPass final : public Pass {
+  public:
+    explicit CidreTSOPairesPass(bool TSOEnabled) {
+      const char* E = getenv("CIDRE_TSO_PAIRES");
+      const char* D = getenv("CIDRE_TSO_DEP");
+      Actif = TSOEnabled && !(E && *E == '0') && !(D && *D == '1');
+      Diag = getenv("CIDRE_DIAG_TSO_PAIRES") != nullptr;
+    }
+    void Run(IREmitter* IREmit) override;
+
+  private:
+    bool Actif {};
+    bool Diag {};
+    IRListView* IR {};
+    fextl::vector<Sym> Formes;
+    std::array<uint32_t, 32> Version {};
+
+    Sym Forme(OrderedNodeWrapper A, int Prof = 0);
+  };
+
+  Sym CidreTSOPairesPass::Forme(OrderedNodeWrapper A, int Prof) {
+    const uint32_t ID = A.ID().Value;
+    if (ID < Formes.size() && Formes[ID].Ok) {
+      return Formes[ID];
+    }
+    Sym R {};
+    R.Ok = true;
+    auto Noeud = IR->GetNode(A);
+    const auto* H = IR->GetOp<IROp_Header>(Noeud);
+    const auto Feuille = [&]() {
+      Sym F {};
+      F.Ok = true;
+      F.Base = (2ULL << 40) | ID;
+      return F;
+    };
+    if (Prof > 6) {
+      return Feuille();
+    }
+    switch (H->Op) {
+    case OP_CONSTANT: R.Const = static_cast<int64_t>(H->C<IROp_Constant>()->Constant); break;
+    case OP_INLINECONSTANT: R.Const = static_cast<int64_t>(H->C<IROp_InlineConstant>()->Constant); break;
+    case OP_ENTRYPOINTOFFSET: // adresse relative a RIP : entree du bloc + decalage
+      if (H->Size != OpSize::i64Bit) {
+        R = Feuille();
+        break;
+      }
+      R.Base = 3ULL << 40;
+      R.Const = H->C<IROp_EntrypointOffset>()->Offset;
+      break;
+    case OP_LOADREGISTER: {
+      const auto* Op = H->C<IROp_LoadRegister>();
+      if (Op->Class != RegClass::GPR || Op->Reg >= 32) {
+        R = Feuille();
+      } else {
+        R.Base = (1ULL << 40) | (uint64_t(Op->Reg) << 20) | Version[Op->Reg];
+      }
+      break;
+    }
+    case OP_ADD: {
+      if (H->Size != OpSize::i64Bit) {
+        R = Feuille();
+        break;
+      }
+      const auto* Op = H->C<IROp_Add>();
+      Sym X = Forme(Op->Src1, Prof + 1), Y = Forme(Op->Src2, Prof + 1);
+      if (!Y.Base && !Y.Index) {
+        R = X;
+        R.Const += Y.Const;
+      } else if (!X.Base && !X.Index) {
+        R = Y;
+        R.Const += X.Const;
+      } else if (!X.Index && !Y.Index && Y.Base && !Y.Const) {
+        R = X;
+        R.Index = Y.Base;
+      } else if (!X.Index && !Y.Index && X.Base && !X.Const) {
+        R = Y;
+        R.Index = X.Base;
+      } else {
+        R = Feuille();
+      }
+      break;
+    }
+    case OP_ADDSHIFT: {
+      const auto* Op = H->C<IROp_AddShift>();
+      if (H->Size != OpSize::i64Bit || Op->Shift != ShiftType::LSL) {
+        R = Feuille();
+        break;
+      }
+      Sym X = Forme(Op->Src1, Prof + 1), Y = Forme(Op->Src2, Prof + 1);
+      if (!X.Index && Y.Base && !Y.Index && !Y.Const) {
+        R = X;
+        R.Index = Y.Base;
+        R.Decalage = Op->ShiftAmount;
+      } else {
+        R = Feuille();
+      }
+      break;
+    }
+    default: R = Feuille(); break;
+    }
+    if (ID < Formes.size()) {
+      Formes[ID] = R;
+    }
+    return R;
+  }
+
+  void CidreTSOPairesPass::Run(IREmitter* IREmit) {
+    if (!Actif) {
+      return;
+    }
+    FEXCORE_PROFILE_SCOPED("PassManager::CidreTSOPaires");
+    auto CurrentIR = IREmit->ViewIR();
+    IR = &CurrentIR;
+    Formes.assign(IR->GetSSACount() + 1, Sym {});
+
+    struct Paire {
+      Ref L1, L2;
+    };
+    fextl::vector<Paire> Paires;
+
+    for (auto [BlockNode, BlockHeader] : IR->GetBlocks()) {
+      Version.fill(0);
+      Ref Attente = nullptr;
+      Sym FormeAttente {};
+      OpSize TailleAttente {};
+      for (auto [CodeNode, IROp] : IR->GetCode(BlockNode)) {
+        switch (IROp->Op) {
+        case OP_LOADMEMTSO: {
+          const auto* L = IROp->C<IROp_LoadMemTSO>();
+          const bool Candidat = L->Class == RegClass::GPR && (IROp->Size == OpSize::i32Bit || IROp->Size == OpSize::i64Bit) &&
+                                L->Offset.IsInvalid();
+          if (Diag && getenv("CIDRE_DIAG_TSO_PAIRES")[0] == '2') {
+            Sym F = Forme(L->Addr);
+            const auto* AH = IR->GetOp<IROp_Header>(IR->GetNode(L->Addr));
+            LogMan::Msg::IFmt("cidre tso paires : lecture taille {} classe {} offset {} adr op {} base {:x} index {:x} dec {} const {} attente {}",
+                              (int)IROp->Size, static_cast<int>(L->Class), L->Offset.IsInvalid() ? 0 : 1, GetName(AH->Op), F.Base, F.Index, F.Decalage,
+                              F.Const, Attente ? 1 : 0);
+          }
+          if (Candidat && Attente) {
+            Sym F = Forme(L->Addr);
+            if (IROp->Size == TailleAttente && F.Base == FormeAttente.Base && F.Index == FormeAttente.Index &&
+                F.Decalage == FormeAttente.Decalage && F.Const == FormeAttente.Const + static_cast<int64_t>(IR::OpSizeToSize(IROp->Size))) {
+              Paires.push_back({Attente, CodeNode});
+              Attente = nullptr;
+              break;
+            }
+          }
+          Attente = Candidat ? CodeNode : nullptr;
+          if (Attente) {
+            FormeAttente = Forme(L->Addr);
+            TailleAttente = IROp->Size;
+          }
+          break;
+        }
+        case OP_STOREREGISTER: {
+          const auto Reg = PhysicalRegister(CodeNode);
+          if (Reg.AsRegClass() == RegClass::GPRFixed && Reg.Reg < 32) {
+            ++Version[Reg.Reg];
+          }
+          break;
+        }
+        // Ni memoire de l'invite, ni barriere, ni flot de controle
+        case OP_LOADREGISTER:
+          // forme figee a sa position : la version du registre est celle de ce point (un StoreRegister plus loin
+          // en fait une autre valeur)
+          (void)Forme(IR->WrapNode(CodeNode));
+          break;
+        case OP_COPY:
+        case OP_ADD:
+        case OP_SUB:
+        case OP_ADDSHIFT:
+        case OP_SUBSHIFT:
+        case OP_OR:
+        case OP_XOR:
+        case OP_AND:
+        case OP_ANDN:
+        case OP_LSHL:
+        case OP_LSHR:
+        case OP_ASHR:
+        case OP_BFE:
+        case OP_SBFE:
+        case OP_CONSTANT:
+        case OP_INLINECONSTANT:
+        case OP_GUESTOPCODE:
+        case OP_INVALIDATEFLAGS:
+        // drapeaux, selections, etat du fil : ni memoire de l'invite ni flot de controle (liste de 0226)
+        case OP_ADDWITHFLAGS:
+        case OP_SUBWITHFLAGS:
+        case OP_LOADPF:
+        case OP_LOADAF:
+        case OP_LOADCONTEXT:
+        case OP_STORECONTEXT:
+        case OP_LOADNZCV:
+        case OP_STORENZCV:
+        case OP_LOADDF:
+        case OP_ENTRYPOINTOFFSET:
+        case OP_INLINEENTRYPOINTOFFSET:
+        case OP_NEG:
+        case OP_NOT:
+        case OP_ADC:
+        case OP_SBB:
+        case OP_ADDNZCV:
+        case OP_SUBNZCV:
+        case OP_ADCNZCV:
+        case OP_SBBNZCV:
+        case OP_ADCWITHFLAGS:
+        case OP_SBBWITHFLAGS:
+        case OP_ANDWITHFLAGS:
+        case OP_TESTNZ:
+        case OP_TESTZ:
+        case OP_SETSMALLNZV:
+        case OP_CARRYINVERT:
+        case OP_SHIFTFLAGS:
+        case OP_ROR:
+        case OP_MUL:
+        case OP_UMUL:
+        case OP_BFI:
+        case OP_BFXIL:
+        case OP_SELECT:
+        case OP_NZCVSELECT:
+        case OP_NZCVSELECTINCREMENT: break;
+        default:
+          if (Diag && Attente && getenv("CIDRE_DIAG_TSO_PAIRES")[0] == '2') {
+            LogMan::Msg::IFmt("cidre tso paires : coupe par op {}", GetName(IROp->Op));
+          }
+          Attente = nullptr;
+          break;
+        }
+      }
+    }
+
+    if (Diag && !Paires.empty()) {
+      LogMan::Msg::IFmt("cidre tso paires : {} paire(s)", Paires.size());
+    }
+    for (auto& P : Paires) {
+      const auto* L1 = IR->GetOp<IROp_LoadMemTSO>(P.L1);
+      Ref Addr = IR->GetNode(L1->Addr);
+      IREmit->SetWriteCursor(P.L1);
+      if (IR->GetOp<IROp_Header>(P.L1)->Size == OpSize::i64Bit) {
+        Ref Bas = IREmit->_AllocateGPR(false);
+        Ref Haut = IREmit->_AllocateGPR(false);
+        Ref Paire8 = IREmit->_CidreLoadMemTSOPaire8(OpSize::i64Bit, Addr, Bas, Haut);
+        IREmit->ReplaceUsesWithAfter(P.L1, Bas, Paire8);
+        IREmit->ReplaceUsesWithAfter(P.L2, Haut, P.L2);
+        IREmit->Remove(P.L1);
+        IREmit->Remove(P.L2);
+        continue;
+      }
+      Ref V = IREmit->_CidreLoadMemTSOPaire(OpSize::i64Bit, Addr);
+      Ref B1 = IREmit->_Bfe(OpSize::i64Bit, 32, 0, V);
+      Ref B2 = IREmit->_Bfe(OpSize::i64Bit, 32, 32, V);
+      IREmit->ReplaceUsesWithAfter(P.L1, B1, B2);
+      IREmit->ReplaceUsesWithAfter(P.L2, B2, P.L2);
+      IREmit->Remove(P.L1);
+      IREmit->Remove(P.L2);
+    }
+  }
+} // namespace
