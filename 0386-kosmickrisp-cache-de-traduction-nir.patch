+/* Banc hors ligne (Cidre) : rejoue la traduction (cache de traduction compris)
+ * d'un NIR vide par CIDRE_AIR_DUMP_NIR ; MSL et AIR rendus par malloc. */
+PUBLIC int cidre_trad_hors_ligne(const char *path, const uint8_t *codegen_key,
+                                 char **msl, void **air, size_t *air_size,
+                                 double *ms);
+PUBLIC int
+cidre_trad_hors_ligne(const char *path, const uint8_t *codegen_key, char **msl,
+                      void **air, size_t *air_size, double *ms)
+{
+   FILE *f = fopen(path, "rb");
+   if (!f)
+      return -1;
+   fseek(f, 0, SEEK_END);
+   long n = ftell(f);
+   fseek(f, 0, SEEK_SET);
+   void *buf = malloc(n);
+   if (fread(buf, 1, n, f) != (size_t)n) {
+      fclose(f);
+      free(buf);
+      return -1;
+   }
+   fclose(f);
+   if (codegen_key)
+      kk_trad_cache_set_codegen_key(codegen_key, VK_UUID_SIZE);
+   struct blob_reader br;
+   blob_reader_init(&br, buf, n);
+   struct nir_to_msl_options options = {
+      .disabled_workarounds = blob_read_uint64(&br),
+   };
+   blob_copy_bytes(&br, options.rts_component_count,
+                   sizeof(options.rts_component_count));
+   glsl_type_singleton_init_or_ref();
+   nir_shader *nir = nir_deserialize(NULL, &kk_nir_options, &br);
+   free(buf);
+   if (!nir)
+      return -1;
+   struct msl_compile_data data = {0};
+   uint64_t t0 = os_time_get_nano();
+   kk_nir_translate(nir, &options, &data);
+   *ms = (os_time_get_nano() - t0) / 1e6;
+   ralloc_free(nir);
+   *msl = data.code ? strdup(data.code) : NULL;
+   *air_size = data.air ? data.air_size : 0;
+   *air = NULL;
+   if (*air_size) {
+      *air = malloc(*air_size);
+      memcpy(*air, data.air, *air_size);
+   }
+   ralloc_free(data.code);
+   ralloc_free(data.entrypoint_name);
+   return *msl ? 1 : 0;
+}
diff --git a/src/kosmickrisp/vulkan/kk_trad_cache.c b/src/kosmickrisp/vulkan/kk_trad_cache.c
