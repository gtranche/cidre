+ * macOS scale une resolution de jeu plus basse pour remplir l'ecran, et le
+ * Game Mode s'active. Active par l'env CIDRE_FULLSCREEN_SPACE (pose par le
+ * launcher), lu une seule fois. */
+static BOOL cidre_wants_fullscreen_space(void)
+{
+    static BOOL want;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        const char* v = getenv("CIDRE_FULLSCREEN_SPACE");
+        want = v && (*v == '1' || *v == 'y' || *v == 'Y' || *v == 't' || *v == 'T');
+    });
+    return want;
+}
