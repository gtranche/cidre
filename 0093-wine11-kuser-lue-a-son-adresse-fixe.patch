-        return FALSE;
 #ifdef SONDE_EMU_COMPTE
-    { static LONG n; LONG v = InterlockedIncrement( &n ); if ((v % 2000) == 1) ERR( "SONDE_EMU_COMPTE %ld acces hote emules (pc=%p guest=%p)\n", (long)v, (void *)PC_sig(ctx), (void *)guest_addr ); }
+    { static LONG n; LONG v = InterlockedIncrement( &n ); if ((v % 2000) == 1) ERR( "SONDE_EMU_COMPTE %ld acces hote emules (pc=%p guest=%p)\n", (long)v, (void *)PC_sig(ctx), (void *)host ); }
 #endif
 
     /* Rn : 31 = SP.  Rt : 31 = registre zero. */
@@ -1391,6 +1382,27 @@
             else { UINT64 v = XT_READ(Rt); memcpy((void*)host, &v, nb); }
         }
         if (sub == 1 || sub == 3) SET_XN( Rn, XN(Rn) + (INT64)imm9 );       /* writeback pre/post */
+        PC_sig(ctx) += 4;
+        return TRUE;
+    }
+
+    /* --- Chargements ordonnes, ceux qu'un emulateur emet pour respecter
+     *     l'ordre memoire x86 :
+     *       LDAR   (size 001000 110 11111 1 11111 Rn Rt)
+     *       LDAPR  (size 111000 101 11111 110000 Rn Rt)
+     *       LDAPUR (size 011001 opc 0 imm9 00 Rn Rt ; opc 01 charge, 1x signe) --- */
+    if ((insn & 0x3ffffc00u) == 0x08dffc00u || (insn & 0x3ffffc00u) == 0x38bfc000u)
+    {
+        XT_WRITE( insn & 31, CHARGE_ENTIER( 1u << (insn >> 30), FALSE ) );
+        PC_sig(ctx) += 4;
+        return TRUE;
+    }
+    if ((insn & 0x3f200c00u) == 0x19000000u && ((insn >> 22) & 3))
+    {
+        UINT opc = (insn >> 22) & 3;
+        UINT64 v = CHARGE_ENTIER( 1u << (insn >> 30), opc >= 2 );
+        if (opc == 3) v &= 0xffffffffull;   /* signe sur 32 bits, haut a zero */
+        XT_WRITE( insn & 31, v );
         PC_sig(ctx) += 4;
         return TRUE;
     }
@@ -1403,6 +1415,21 @@
     #undef VREG
     #undef CHARGE_ENTIER
 }
+
+static BOOL emuler_acces_fenetre_basse( ucontext_t *ctx, ULONG_PTR guest_addr )
+{
+    const ULONG_PTR host = guest_addr | luajit_low_base;
+
+    /* Si le miroir n'est pas engage (pointeur bas invalide -- typiquement une
+     * sonde IsBadStringPtr sur un petit entier), ne pas le dereferencer : cela
+     * refauterait DANS le handler (exception imbriquee sur la pile de signal,
+     * abandon du fil). On rend FALSE et la violation part vers le __except de
+     * l'invite. Plage maximale d'un acces (paire Q) = 32 octets. */
+    if (!luajit_miroir_engage( (const void *)host, FALSE ) ||
+        !luajit_miroir_engage( (const void *)(host + 31), FALSE ))
+        return FALSE;
+    return emuler_acces_vers( ctx, host );
+}
 #endif /* __APPLE__ */
 
