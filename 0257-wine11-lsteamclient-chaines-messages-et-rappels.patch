+/*
+ * Recopier une chaine native dans la memoire du PE.
+ *
+ * Le PE 64 bits pouvait lire lui-meme le const char * rendu par le client :
+ * meme espace d'adressage. Mais la chaine vit dans steamclient.dylib (sa
+ * section de donnees, son tas), memoire que l'ilot (vCPU de
+ * Hypervisor.framework) refuse de projeter : ELDEN RING y lisait sa chaine
+ * et l'ilot arretait le processus sur une faute de deuxieme etage. Seul le
+ * cote hote la lit, ici.
+ */
+static NTSTATUS lire_chaine( void *args )
+{
+    struct lire_chaine_params *params = args;
+    const char *src = (const char *)(ULONG_PTR)params->natif;
+    char *dst = (char *)(ULONG_PTR)params->tampon;
+    size_t n, c;
+
+    if (!src || !dst || params->capacite <= 0) return STATUS_INVALID_PARAMETER;
+    n = strlen( src );
+    params->longueur = n > 0x7fffffff ? 0x7fffffff : (INT32)n;
+    c = n < (size_t)params->capacite ? n : (size_t)params->capacite - 1;
+    memcpy( dst, src, c );
+    dst[c] = 0;
+    return STATUS_SUCCESS;
+}
+
+/* Appeler une fonction native a un argument (m_pfnRelease d'un message). */
+static NTSTATUS appeler_natif1( void *args )
+{
+    struct appeler_natif1_params *params = args;
+    void (*fn)( void * ) = (void (*)( void * ))(ULONG_PTR)params->fonction;
+
+    if (!fn) return STATUS_INVALID_PARAMETER;
+    fn( (void *)(ULONG_PTR)params->arg );
+    return STATUS_SUCCESS;
+}
+
+/* m_pfnFreeData natif pour les donnees recopiees par copier_message : le
+ * client l'appelle (System V) quand il a fini d'envoyer. m_pData est le
+ * premier champ de SteamNetworkingMessage_t. */
+static void liberer_donnees_copiees( void *message )
+{
+    void **donnees = message;
+
+    free( *donnees );
+    *donnees = NULL;
+}
+
+static NTSTATUS copier_message( void *args )
+{
+    struct copier_message_params *params = args;
+    void *copie;
+
+    if (params->taille < 0) return STATUS_INVALID_PARAMETER;
+    if (!(copie = malloc( params->taille ? params->taille : 1 ))) return STATUS_NO_MEMORY;
+    if (params->taille) memcpy( copie, (const void *)(ULONG_PTR)params->source, params->taille );
+    params->copie = (UINT64)(ULONG_PTR)copie;
+    params->liberer = (UINT64)(ULONG_PTR)liberer_donnees_copiees;
+    return STATUS_SUCCESS;
+}
+
+/* --- Fonctions rappelees par le client natif (voir adresses_rappels_params) --- */
+static void sortie_debogage_natif( int type, const char *msg )
+{
+    MESSAGE( "lsteamclient : [SteamNetworkingSockets %d] %s\n", type, msg ? msg : "" );
+}
+
+static void avertissement_natif( int gravite, const char *texte )
+{
+    MESSAGE( "lsteamclient : [avertissement Steam %d] %s\n", gravite, texte ? texte : "" );
+}
+
+#define NB_FILE_RAPPELS 256
+static struct { INT32 valeur, taille; unsigned char donnees[TAILLE_RAPPEL_MAX]; } file_rappels[NB_FILE_RAPPELS];
+static unsigned tete_rappels, queue_rappels;
+static pthread_mutex_t verrou_rappels = PTHREAD_MUTEX_INITIALIZER;
+
+static void enfiler_rappel( int valeur, const void *donnees, int taille )
+{
+    pthread_mutex_lock( &verrou_rappels );
+    if (queue_rappels - tete_rappels < NB_FILE_RAPPELS && donnees && taille <= TAILLE_RAPPEL_MAX)
+    {
+        unsigned r = queue_rappels++ % NB_FILE_RAPPELS;
+        file_rappels[r].valeur = valeur;
+        file_rappels[r].taille = taille;
+        memcpy( file_rappels[r].donnees, donnees, taille );
+    }
+    else ERR( "rappel de configuration %d perdu (file pleine ou %d octets)\n", valeur, taille );
+    pthread_mutex_unlock( &verrou_rappels );
+}
+
+/* Tailles natives : SteamNetConnectionStatusChangedCallback_t 704,
+ * SteamNetAuthenticationStatus_t 260, SteamRelayNetworkStatus_t 272,
+ * SteamNetworkingMessagesSessionRequest_t 136, ..SessionFailed_t 696,
+ * (206 : signalisation, non geree), SteamNetworkingFakeIPResult_t 160. */
+static void rappel_201( void *p ) { enfiler_rappel( 201, p, 704 ); }
+static void rappel_202( void *p ) { enfiler_rappel( 202, p, 260 ); }
+static void rappel_203( void *p ) { enfiler_rappel( 203, p, 272 ); }
+static void rappel_204( void *p ) { enfiler_rappel( 204, p, 136 ); }
+static void rappel_205( void *p ) { enfiler_rappel( 205, p, 696 ); }
+static void rappel_207( void *p ) { enfiler_rappel( 207, p, 160 ); }
+
+static NTSTATUS adresses_rappels( void *args )
+{
+    struct adresses_rappels_params *params = args;
+
+    params->debogage = (UINT64)(ULONG_PTR)sortie_debogage_natif;
+    params->avertissement = (UINT64)(ULONG_PTR)avertissement_natif;
+    params->config[0] = (UINT64)(ULONG_PTR)rappel_201;
+    params->config[1] = (UINT64)(ULONG_PTR)rappel_202;
+    params->config[2] = (UINT64)(ULONG_PTR)rappel_203;
+    params->config[3] = (UINT64)(ULONG_PTR)rappel_204;
+    params->config[4] = (UINT64)(ULONG_PTR)rappel_205;
+    params->config[5] = 0;
+    params->config[6] = (UINT64)(ULONG_PTR)rappel_207;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS defiler_rappel( void *args )
+{
+    struct defiler_rappel_params *params = args;
+
+    params->valeur = params->taille = 0;
+    pthread_mutex_lock( &verrou_rappels );
+    if (tete_rappels != queue_rappels)
+    {
+        unsigned r = tete_rappels++ % NB_FILE_RAPPELS;
+        params->valeur = file_rappels[r].valeur;
+        params->taille = file_rappels[r].taille;
+        memcpy( (void *)(ULONG_PTR)params->tampon, file_rappels[r].donnees, params->taille );
+    }
+    pthread_mutex_unlock( &verrou_rappels );
+    return STATUS_SUCCESS;
+}
