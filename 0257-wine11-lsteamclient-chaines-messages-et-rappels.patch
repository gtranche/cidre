+/* Recopier une chaine rendue par le client natif (const char * hote) dans un
+ * tampon fourni par le cote PE. « longueur » rend la longueur complete de la
+ * chaine native (sans le NUL) : si elle atteint « capacite », la copie est
+ * tronquee et l'appelant redemande avec un tampon assez grand. Ajoutee en fin
+ * de table : les PE qui ne la connaissent pas gardent les memes numeros. */
+struct lire_chaine_params
+{
+    UINT64 natif;     /* const char * hote */
+    UINT64 tampon;    /* char * invite */
+    INT32  capacite;
+    INT32  longueur;
+};
+
+/* Messages de SteamNetworkingSockets (SteamNetworkingMessage_t) : leurs
+ * m_pfnRelease / m_pfnFreeData sont des fonctions natives (System V, arm64
+ * macOS) que le jeu appelle lui-meme -- msg->Release() est en ligne dans les
+ * en-tetes Steamworks. Le cote PE les remplace par les siennes et appelle la
+ * native par ici. Ajoutees en fin de table. */
+struct appeler_natif1_params
+{
+    UINT64 fonction;  /* void (*)(void *) native */
+    UINT64 arg;
+};
+
+/* Recopier les donnees d'un message que le jeu envoie avec SA fonction de
+ * liberation (m_pfnFreeData PE, que le client natif ne peut pas appeler) dans
+ * un tampon natif, libere par une fonction native du cote unix. */
+struct copier_message_params
+{
+    UINT64 source;
+    INT32  taille;
+    INT32  bourrage;
+    UINT64 copie;     /* rendu : tampon natif (malloc) */
+    UINT64 liberer;   /* rendu : void (*)(SteamNetworkingMessage_t *) native */
+};
+
+/* Fonctions que le jeu confie au client pour qu'il les rappelle : sortie de
+ * debogage de SteamNetworkingSockets (SetDebugOutputFunction), crochet
+ * d'avertissement (SetWarningMessageHook), rappels de configuration
+ * (k_ESteamNetworkingConfig_Callback_*, 201..207). Le client natif ne peut
+ * pas appeler du code x86_64 : on lui donne des fonctions natives du cote
+ * unix. Les rappels de configuration sont mis en file et livres au jeu par le
+ * cote PE, sur son fil, apres RunCallbacks. */
+#define PREMIER_RAPPEL_CONFIG 201
+#define NB_RAPPELS_CONFIG     7
+#define TAILLE_RAPPEL_MAX     720
+
+struct adresses_rappels_params
+{
+    UINT64 debogage;                      /* void (*)( int type, const char *msg ) */
+    UINT64 avertissement;                 /* void (*)( int gravite, const char *texte ) */
+    UINT64 config[NB_RAPPELS_CONFIG];     /* 201..207 */
+};
+
+struct defiler_rappel_params
+{
+    UINT64 tampon;    /* TAILLE_RAPPEL_MAX octets, cote PE */
+    INT32  valeur;    /* rendu : 201..207, 0 si la file est vide */
+    INT32  taille;    /* rendu : taille native */
+};
