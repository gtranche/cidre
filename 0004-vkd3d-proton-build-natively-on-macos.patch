+
+static inline bool vkd3d_darwin_sync_wait(struct vkd3d_darwin_sync_object *obj,
+        const struct timespec *deadline)
+{
+    bool signalled = true;
+
+    pthread_mutex_lock(&obj->lock);
+
+    while (obj->count == 0)
+    {
+        int rc = deadline ? pthread_cond_timedwait(&obj->cond, &obj->lock, deadline)
+                          : pthread_cond_wait(&obj->cond, &obj->lock);
+        if (rc == ETIMEDOUT)
+        {
+            signalled = false;
+            break;
+        }
+    }
