+/*
+ * La disposition d'une version exacte d'interface.
+ *
+ * signatures32.h est indexe par NOM d'interface, d'apres un steam_api
+ * d'epoque SteamClient019 : faux pour toute autre version. Fahrenheit:
+ * Indigo Prophecy Remastered (312840, steam_api i386 de novembre 2013) parle
+ * SteamClient012, ou GetISteamHTTP occupe l'emplacement 23 -- celui de
+ * BShutdownIfAllPipesClosed en 019, sans argument. Le thunk ne depilait donc
+ * rien des trois mots de l'appel (utilisateur, tuyau, version) : au retour de
+ * SteamAPI_Init, esi recevait la chaine « STEAMHTTP_INTERFACE_VERSION002 »
+ * et le ret sautait sur l'objet application du jeu, en .data -- instruction
+ * illegale a 0x962839.
+ *
+ * versions32.h donne, pour chacune des 212 versions que connait le
+ * lsteamclient de Proton, l'ordre des methodes et leur discipline de pile
+ * __thiscall (tests/engendrer_versions32.py). La table est triee par version :
+ * une recherche dichotomique trouve la premiere methode, les suivantes sont
+ * contigues. Une version absente laisse tout a NULL : on retombe alors sur la
+ * table mesuree, comme avant.
+ */
+static void disposition( const char *version, const struct methode_versionnee **meth )
+{
+    unsigned bas = 0, haut = ARRAY_SIZE(methodes_versionnees), k;
+
+    memset( meth, 0, NB_SIGNATURES * sizeof(*meth) );
+    if (!version || !version[0]) return;
+    while (bas < haut)
+    {
+        unsigned milieu = (bas + haut) / 2;
+        if (strcmp( methodes_versionnees[milieu].version, version ) < 0) bas = milieu + 1;
+        else haut = milieu;
+    }
+    for (k = bas; k < ARRAY_SIZE(methodes_versionnees) &&
+                  !strcmp( methodes_versionnees[k].version, version ); k++)
+        if (methodes_versionnees[k].emplacement < NB_SIGNATURES)
+            meth[methodes_versionnees[k].emplacement] = &methodes_versionnees[k];
+}
+
+/* L'emplacement d'ISteamClient rend-il une interface ? La version exacte le
+ * dit quand on la connait ; sinon la carte de la version 019. */
+static BOOL rend_interface_objet( const struct objet_pe *objet, unsigned emplacement )
+{
+    const struct methode_versionnee *m = emplacement < NB_SIGNATURES ? objet->meth[emplacement] : NULL;
+
+    if (m) return m->rendu == 'i';
+    return rend_interface( emplacement );
