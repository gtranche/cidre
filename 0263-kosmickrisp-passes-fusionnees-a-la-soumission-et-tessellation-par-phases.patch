+/* Barriere dont toutes les sources sont des acces d'attachement (ecriture /
+ * lecture couleur ou profondeur) : entre deux passes fusionnees sur les MEMES
+ * attachements, elle ne peut rien ordonner (une image liee comme attachement
+ * ne peut pas etre lue comme texture dans la passe, D3D12 l'interdit, et ces
+ * ecritures-la restent en tuile) ; tout ce qui suit la passe fusionnee est
+ * ordonne par la barriere de fin d'encodeur. vkd3d en pose une a la fin de
+ * chaque liste (COLOR_ATTACHMENT_WRITE -> SHADER_READ). Sautee au rejeu. */
+static bool
+kk_fusion_barriere_attachements(const VkDependencyInfo *dep)
+{
+   const VkAccessFlags2 att =
+      VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
+      VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |
+      VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
+      VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+   static int off = -1;
+   if (off < 0)
+      off = getenv("CIDRE_FUSION_SANS_SAUT") != NULL;
+   if (off || dep == NULL)
+      return false;
+   /* Sources permises : acces d'attachement et lectures (dependance
+    * ecriture-apres-lecture : la passe suivante n'ecrit que ses attachements,
+    * deja attachements de la precedente). Toute autre ecriture refuse. */
+   const VkAccessFlags2 ecritures =
+      VK_ACCESS_2_SHADER_WRITE_BIT | VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT |
+      VK_ACCESS_2_TRANSFER_WRITE_BIT | VK_ACCESS_2_HOST_WRITE_BIT |
+      VK_ACCESS_2_MEMORY_WRITE_BIT |
+      VK_ACCESS_2_TRANSFORM_FEEDBACK_WRITE_BIT_EXT |
+      VK_ACCESS_2_TRANSFORM_FEEDBACK_COUNTER_WRITE_BIT_EXT |
+      VK_ACCESS_2_COMMAND_PREPROCESS_WRITE_BIT_EXT |
+      VK_ACCESS_2_ACCELERATION_STRUCTURE_WRITE_BIT_KHR;
+   (void)att;
+   for (uint32_t i = 0; i < dep->memoryBarrierCount; i++)
+      if (dep->pMemoryBarriers[i].srcAccessMask & ecritures)
+         return false;
+   for (uint32_t i = 0; i < dep->bufferMemoryBarrierCount; i++)
+      if (dep->pBufferMemoryBarriers[i].srcAccessMask & ecritures)
+         return false;
+   for (uint32_t i = 0; i < dep->imageMemoryBarrierCount; i++)
+      if (dep->pImageMemoryBarriers[i].srcAccessMask & ecritures)
+         return false;
+   return true;
+}
