+static bool
+kk_fusion_att_eq(const VkRenderingAttachmentInfo *a,
+                 const VkRenderingAttachmentInfo *b)
+{
+   VkImageView va = a ? a->imageView : VK_NULL_HANDLE;
+   VkImageView vb = b ? b->imageView : VK_NULL_HANDLE;
+   if (va != vb)
+      return false;
+   if (va == VK_NULL_HANDLE)
+      return true;
+   if (a->resolveMode != VK_RESOLVE_MODE_NONE ||
+       b->resolveMode != VK_RESOLVE_MODE_NONE)
+      return false;
+   if (b->loadOp == VK_ATTACHMENT_LOAD_OP_CLEAR)
+      return false;
+   if (a->storeOp != b->storeOp || a->imageLayout != b->imageLayout)
+      return false;
+   return true;
+}
