+static void
+kk_fusion_analyser(struct kk_cmd_buffer *c, struct kk_fusion_info *f)
+{
+   memset(f, 0, sizeof(*f));
+   f->head_ok = true;
+   f->head_bloque = f->tail_bloque = VK_CMD_TYPE_COUNT;
+   list_for_each_entry(struct vk_cmd_queue_entry, e, &c->vk.cmd_queue.cmds,
+                       cmd_link) {
+      if (e->type == VK_CMD_BEGIN_RENDERING) {
+         if (!f->first_begin)
+            f->first_begin = e;
+         f->last_begin = e;
+         f->last_end = NULL;
+         f->tail_ok = false;
+         f->n_tail_saut = 0;
+         continue;
+      }
+      if (e->type == VK_CMD_END_RENDERING ||
+          e->type == VK_CMD_END_RENDERING2_KHR) {
+         f->last_end = e;
+         f->tail_ok = true;
+         f->tail_coupe = false;
+         f->n_tail_saut = 0;
+         f->tail_bloque = VK_CMD_TYPE_COUNT;
+         continue;
+      }
+      bool neutre = kk_fusion_cmd_neutre(e->type);
+      if (e->type == VK_CMD_PIPELINE_BARRIER2) {
+         neutre = true;
+         const VkDependencyInfo *dep = e->u.pipeline_barrier2.dependency_info;
+         bool saut = kk_fusion_barriere_attachements(dep);
+         bool coupe = !saut && kk_fusion_barriere_coupe(dep);
+         if (!f->first_begin) {
+            if (saut && f->n_head_saut < KK_FUS_MAX_SAUTS)
+               f->head_saut[f->n_head_saut++] = e;
+            else
+               f->head_coupe |= coupe || saut;
+         }
+         if (f->last_end) {
+            if (saut && f->n_tail_saut < KK_FUS_MAX_SAUTS)
+               f->tail_saut[f->n_tail_saut++] = e;
+            else
+               f->tail_coupe |= coupe || saut;
+         }
+      }
+      if (!f->first_begin && !neutre && f->head_ok) {
+         f->head_ok = false;
+         f->head_bloque = e->type;
+      }
+      if (f->last_end && !neutre && f->tail_ok) {
+         f->tail_ok = false;
+         f->tail_bloque = e->type;
+      }
+   }
+   if (!f->first_begin)
+      f->head_ok = false;
