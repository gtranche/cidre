+// Result in \reg, \tmp is clobbered.
+.macro LOAD_TEB reg, tmp
+  mrs \tmp, tpidrro_el0
+  and \tmp, \tmp, #0xfffffffffffffff8
+  adrp \reg, FEX_TEBSlotOffset
+  ldr \reg, [\reg, #:lo12:FEX_TEBSlotOffset]
+  ldr \reg, [\tmp, \reg]
+.endm
+#else
+.macro LOAD_TEB reg, tmp
+  mov \reg, x18
+.endm
+#endif
