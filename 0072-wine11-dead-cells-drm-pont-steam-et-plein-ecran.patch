+/* La couche offscreen est creee avec un cadre fixe et n'est jamais un
+ * sous-vue qui suivrait le redimensionnement de la fenetre. Sans ce resize,
+ * son bounds reste celui de la creation : le WSI Metal (qui publie
+ * currentExtent = bounds x contentsScale) annonce alors une surface trop
+ * petite quand la fenetre s'agrandit (passage en plein ecran), et l'image
+ * finit dans un coin. On reaccorde donc le bounds au cadre courant. */
+- (void) resize:(CGRect)bounds
+{
+    CAMetalLayer *layer = offscreen_layer;
+    CGRect mac = cgrect_mac_from_win(bounds);
+
+    OnMainThreadAsync(^{
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        [layer setBounds:mac];
+        [CATransaction commit];
+    });
+}
