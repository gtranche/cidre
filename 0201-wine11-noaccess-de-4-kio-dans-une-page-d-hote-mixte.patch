+#ifdef __APPLE__
+/***********************************************************************
+ *           bascule_wx_page
+ *
+ * W^X a la main pour une page d'hote hors MAP_JIT que Windows dit a la fois
+ * inscriptible et executable (union des droits de ses pages de 4 Kio). macOS
+ * refuse les deux ensemble et mprotect_exec retire l'execution : le code natif
+ * de la page faute alors a l'execution. Cas mesure : le chargeur protege de
+ * Diablo II Resurrected pose un crochet dans ntdll (page passee en
+ * PAGE_EXECUTE_READWRITE) ; le code ARM64EC de ntdll qui partage cette page
+ * d'hote de 16 Kio (NtQueryPerformanceCounter$hybpatch_thunk) fautait, et le
+ * fil partait dans le chemin d'exception de l'emulateur, qui s'interbloquait.
+ * A une faute d'execution permise par la page de 4 Kio, on passe la page d'hote
+ * en lecture-execution ; a une ecriture permise, on la remet en
+ * lecture-ecriture. virtual_mutex tenu.
+ */
+static BOOL bascule_wx_page( char *page, const void *addr, BOOL executer )
+{
+    BYTE v = get_page_vprot( addr );
+    int prot;
+
+    if (!sous_page_ouverte( v ) || page_hote_mixte( page )) return FALSE;
+    prot = get_host_page_unix_prot( page, 0, 0 );
+    if (!(prot & PROT_WRITE) || !(prot & PROT_EXEC)) return FALSE;
+    if (executer)
+    {
+        if (!(v & VPROT_EXEC)) return FALSE;
+        if (mprotect( page, host_page_size, PROT_READ | PROT_EXEC )) return FALSE;
+    }
+    else
+    {
+        if (!(v & (VPROT_WRITE | VPROT_WRITECOPY)) || (v & VPROT_WRITEWATCH)) return FALSE;
+        if (mprotect( page, host_page_size, PROT_READ | PROT_WRITE )) return FALSE;
+    }
+    if (sous_pages_diag)
+    {
+        static LONG n;
+        LONG k = InterlockedIncrement( &n );
+        if (k <= 16 || !(k & (k - 1)))
+            ERR( "page d'hote %p basculee en %s (faute a %p, %ld)\n", page, executer ? "RX" : "RW", addr, (long)k );
+    }
+    return TRUE;
+}
+#endif
