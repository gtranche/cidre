+ * sauts encore chiffree, lue sans faute parce qu'une voisine etait deja
+ * dechiffree, envoyait le jeu dans des octets chiffres (tests/h64sous_page.c).
+ *
+ * Une page d'hote est dite mixte quand l'une de ses pages de 4 Kio est engagee
+ * sans aucun droit pendant qu'une autre est accessible. On la protege alors a
+ * l'intersection : PROT_NONE. Un acces a la page fermee fait faute comme sous
+ * Windows ; un acces permis a une voisine fait faute aussi, et le gestionnaire
+ * de signal (signal_arm64.c) le rejoue par virtual_acces_sous_page, a travers un
+ * alias de la page d'hote. Seules les vues de section sont concernees (le cas du
+ * chargeur) : les allocations de Wine, de l'emulateur et du tas restent a
+ * l'union, comme avant. CIDRE_SOUS_PAGES=0 rend le comportement d'avant.
+ */
+static int sous_pages_mode = -1;      /* -1 : pas encore lu */
+BOOL sous_pages_actives;              /* une page mixte a existe : signal_arm64.c regarde */
+static LONG sous_pages_emulees, sous_pages_mixtes;
+static BOOL sous_pages_diag;
+
+static inline BOOL sous_page_ouverte( BYTE v )
+{
+    return (v & VPROT_COMMITTED) && !(v & VPROT_GUARD) &&
+           (v & (VPROT_READ | VPROT_WRITE | VPROT_WRITECOPY | VPROT_EXEC));
+}
+
+static inline BOOL sous_page_fermee( BYTE v )
+{
+    return (v & VPROT_COMMITTED) &&
+           !(v & (VPROT_GUARD | VPROT_READ | VPROT_WRITE | VPROT_WRITECOPY | VPROT_EXEC));
+}
+
+/* virtual_mutex tenu */
+static BOOL page_hote_mixte( const char *host )
+{
+    BOOL fermee = FALSE, ouverte = FALSE;
+    struct file_view *view;
+    size_t i;
+
+    if (host_page_size == page_size) return FALSE;
+    if (sous_pages_mode < 0)
+    {
+        const char *e = getenv( "CIDRE_SOUS_PAGES" );
+        sous_pages_mode = e ? atoi( e ) : 1;
+        sous_pages_diag = getenv( "CIDRE_DIAG_SOUS_PAGES" ) != NULL;
+    }
+    if (!sous_pages_mode) return FALSE;
+    for (i = 0; i < host_page_size; i += page_size)
+    {
+        BYTE v = get_page_vprot( host + i );
+        if (sous_page_fermee( v )) fermee = TRUE;
+        else if (sous_page_ouverte( v )) ouverte = TRUE;
+    }
+    if (!fermee || !ouverte) return FALSE;
+    if (!(view = find_view( host, host_page_size ))) return FALSE;
+    if ((view->protect & (VPROT_JIT | VPROT_SYSTEM)) || (is_view_valloc( view ) && sous_pages_mode < 2))
+    {
+        if (sous_pages_diag)
+        {
+            static const char *vues[32];
+            static int nb_vues;
+            int i;
+            for (i = 0; i < nb_vues; i++) if (vues[i] == view->base) break;
+            if (i == nb_vues && nb_vues < 32)
+            {
+                vues[nb_vues++] = view->base;
+                ERR( "page d'hote mixte %p laissee a l'union : vue %p+%#zx protect %#x\n",
+                     host, view->base, view->size, view->protect );
+            }
+        }
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* Droits unix d'une page d'hote : l'union, ou rien pour une page mixte. */
+static int get_host_page_unix_prot( char *host, BYTE set, BYTE clear )
+{
+    if (page_hote_mixte( host ))
+    {
+        if (!sous_pages_actives || sous_pages_diag)
+        {
+            LONG n = InterlockedIncrement( &sous_pages_mixtes );
+            if (sous_pages_diag && (n <= 16 || !(n & (n - 1))))
+                ERR( "page d'hote mixte %p fermee (%ld)\n", host, (long)n );
+        }
+        sous_pages_actives = TRUE;
+        return PROT_NONE;
+    }
+    return get_unix_prot( (get_host_page_vprot( host ) & ~clear) | set );
+}
+
+/*
+ * Alias des pages d'hote mixtes : une seconde projection des memes pages
+ * physiques (mach_vm_remap sans copie), lisible et, si la projection le permet,
+ * inscriptible. Gardees en cache ; toute projection ou deprojection les perime.
+ */
+#define ALIAS_NB 64
+static struct alias_hote { char *hote; char *alias; unsigned int gen; BOOL inscriptible; } alias_cache[ALIAS_NB];
+
+/* virtual_mutex tenu */
+static char *alias_de( char *host, BOOL ecriture )
+{
+    struct alias_hote *e = &alias_cache[((UINT_PTR)host / host_page_size) % ALIAS_NB];
+    mach_vm_address_t cible = 0;
+    vm_prot_t cur, max;
+    kern_return_t kr;
+
+    if (e->alias && e->hote == host && e->gen == alias_gen && (!ecriture || e->inscriptible))
+        return e->alias;
+    if (e->alias) mach_vm_deallocate( mach_task_self(), (mach_vm_address_t)(UINT_PTR)e->alias, host_page_size );
+    e->alias = NULL;
+    kr = mach_vm_remap( mach_task_self(), &cible, host_page_size, 0, VM_FLAGS_ANYWHERE,
+                        mach_task_self(), (mach_vm_address_t)(UINT_PTR)host, FALSE, &cur, &max, VM_INHERIT_NONE );
+    if (kr != KERN_SUCCESS)
+    {
+        ERR( "mach_vm_remap %p : %d\n", host, kr );
+        return NULL;
+    }
+    kr = mach_vm_protect( mach_task_self(), cible, host_page_size, FALSE, VM_PROT_READ | (max & VM_PROT_WRITE) );
+    if (kr != KERN_SUCCESS)
+    {
+        ERR( "mach_vm_protect alias %p : %d\n", host, kr );
+        mach_vm_deallocate( mach_task_self(), cible, host_page_size );
+        return NULL;
+    }
+    e->hote = host;
+    e->alias = (char *)(UINT_PTR)cible;
+    e->gen = alias_gen;
+    e->inscriptible = (max & VM_PROT_WRITE) != 0;
+    if (ecriture && !e->inscriptible) return NULL;
+    return e->alias;
+}
+
+void virtual_sous_page_verrouiller( BOOL verrou )
+{
+    if (verrou) mutex_lock( &virtual_mutex );
+    else mutex_unlock( &virtual_mutex );
+}
+
+/***********************************************************************
+ *           virtual_acces_sous_page
+ *
+ * Rejoue un acces de size octets a addr (lecture vers buf, ou ecriture depuis
+ * buf) quand il a fait faute sur une page d'hote mixte et que les pages de
+ * 4 Kio touchees le permettent. Rend FALSE sans rien toucher sinon : la faute
+ * suit alors son chemin (violation d'acces de l'invite). Sur pile de signal.
+ */
+BOOL virtual_acces_sous_page( void *addr, void *buf, size_t size, BOOL ecriture )
+{
+    char *a = addr, *fin = a + size;
+    BOOL mixte = FALSE, ok = TRUE;
+    char *p;
+
+    if (!size || fin < a) return FALSE;
+    mutex_lock( &virtual_mutex );
+    /* premiere passe : droits et mixite, sans rien copier */
+    for (p = a; p < fin && ok; p = ROUND_ADDR( p, host_page_mask ) + host_page_size)
+    {
+        char *host = ROUND_ADDR( p, host_page_mask ), *sous;
+        char *bout = min( fin, host + host_page_size );
+
+        if (page_hote_mixte( host )) mixte = TRUE;
+        else if (!(get_host_page_unix_prot( host, 0, 0 ) & (ecriture ? PROT_WRITE : PROT_READ))) ok = FALSE;
+        for (sous = ROUND_ADDR( p, page_mask ); ok && sous < bout; sous += page_size)
+        {
+            BYTE v = get_page_vprot( sous );
+            if (!sous_page_ouverte( v )) ok = FALSE;
+            else if (ecriture && (!(v & (VPROT_WRITE | VPROT_WRITECOPY)) || (v & VPROT_WRITEWATCH))) ok = FALSE;
+        }
+    }
+    if (!ok || !mixte) goto refus;
+    for (p = a; p < fin; )
+    {
+        char *host = ROUND_ADDR( p, host_page_mask );
+        char *bout = min( fin, host + host_page_size );
+        char *cible = p;
+
+        if (page_hote_mixte( host ))
+        {
+            char *alias = alias_de( host, ecriture );
+            if (!alias) goto refus;   /* rien n'a encore ete ecrit si c'est la premiere page */
+            cible = alias + (p - host);
+        }
+        if (ecriture) memcpy( cible, (char *)buf + (p - a), bout - p );
+        else memcpy( (char *)buf + (p - a), cible, bout - p );
+        p = bout;
+    }
+    mutex_unlock( &virtual_mutex );
+    if (sous_pages_diag)
+    {
+        LONG n = InterlockedIncrement( &sous_pages_emulees );
+        if (n <= 16 || !(n & (n - 1)))
+            ERR( "acces %s emule %p+%u (%ld)\n", ecriture ? "en ecriture" : "en lecture", addr, (UINT)size, (long)n );
+    }
+    return TRUE;
+refus:
+    mutex_unlock( &virtual_mutex );
+    return FALSE;
+}
+#else
+static inline BOOL page_hote_mixte( const char *host ) { return FALSE; }
+static int get_host_page_unix_prot( char *host, BYTE set, BYTE clear )
+{
+    return get_unix_prot( (get_host_page_vprot( host ) & ~clear) | set );
+}
+#endif
