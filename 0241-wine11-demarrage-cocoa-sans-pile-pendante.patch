+/* Cidre (0241) : la structure vit sur le tas et porte un compteur de
+ * references partage entre macdrv_start_cocoa_app() et run_cocoa_app().
+ * Elle etait sur la pile de l'appelant : quand le fil principal ne traitait
+ * pas la source avant l'echeance (Diablo IV dans l'ilot TSO sature le
+ * processeur au demarrage), l'appelant abandonnait et rendait sa pile ;
+ * run_cocoa_app() lisait ensuite un verrou pendant
+ * (-[OS_hv_vcpu_config lock]: unrecognized selector), levait une
+ * NSException, et le fil principal mourait dans abort : plus aucun NSEvent
+ * (souris, clavier, activation) pour tout le processus. */
 struct cocoa_app_startup_info {
     NSConditionLock*    lock;
     unsigned long long  tickcount;
     uint64_t            uptime_ns;
     BOOL                success;
+    int                 refs;       /* 2 au depart : l'appelant et la source */
+    int                 abandoned;  /* l'appelant n'attend plus */
 };
 
 
+static void release_startup_info(struct cocoa_app_startup_info* startup_info)
+{
+    if (__atomic_sub_fetch(&startup_info->refs, 1, __ATOMIC_RELEASE) <= 0)
+    {
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        [startup_info->lock release];
+        free(startup_info);
+    }
+}
+
+
+/* Cidre (0241) : echeance de l'attente du fil principal, en secondes
+ * (CIDRE_COCOA_DELAI_DEMARRAGE, 60 par defaut au lieu des 5 de Wine). */
+static NSTimeInterval startup_time_limit(void)
+{
+    const char* v = getenv("CIDRE_COCOA_DELAI_DEMARRAGE");
+    double secs = v ? atof(v) : 0;
+    return secs > 0 ? secs : 60;
+}
+
