+      my = MAX2(my, MIN2((int64_t)r->offset.y + r->extent.height, ey));
+   }
+   if (dyn->vp.scissor_count == 0u) {
+      mx = ex;
+      my = ey;
+   }
+   *w = (uint32_t)MAX2(mx, 1);
