+ * d'un autre fil reste possible, comme sous Windows entre deux fils.
+ */
+volatile unsigned int sous_pages_gen = 1;
+BOOL sous_pages_fex;
+
+#define FEX_ALIAS_NB 8192          /* puissance de 2 ; au plus la moitie occupee */
+#define FEX_ALIAS_TOMBE ((char *)1)
+static struct fex_alias { char *hote; char *alias; BOOL inscriptible; } fex_alias[FEX_ALIAS_NB];
+static unsigned int fex_alias_nb;   /* entrees vivantes */
+static pthread_mutex_t fex_alias_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static inline unsigned int fex_alias_hache( const char *host )
+{
+    return (unsigned int)(((UINT_PTR)host >> 14) * 0x9e3779b1u) & (FEX_ALIAS_NB - 1);
+}
+
+/* fex_alias_mutex tenu */
+static struct fex_alias *fex_alias_trouver( const char *host )
+{
+    unsigned int i, h = fex_alias_hache( host );
+    for (i = 0; i < FEX_ALIAS_NB; i++)
+    {
+        struct fex_alias *e = &fex_alias[(h + i) & (FEX_ALIAS_NB - 1)];
+        if (!e->hote) return NULL;
+        if (e->hote == host) return e;
+    }
+    return NULL;
+}
+
+/* fex_alias_mutex tenu */
+static void fex_alias_retirer( struct fex_alias *e )
+{
+    mach_vm_deallocate( mach_task_self(), (mach_vm_address_t)(UINT_PTR)e->alias, host_page_size );
+    e->hote = FEX_ALIAS_TOMBE;
+    e->alias = NULL;
+    fex_alias_nb--;
+}
+
+/* Une projection change sur [start, start+size) : les alias de FEX qui la
+ * touchent ne designent plus la bonne memoire. */
+static void sous_pages_projection( const void *start, size_t size )
+{
+    char *debut = ROUND_ADDR( start, host_page_mask ), *fin = (char *)start + size;
+    struct fex_alias *e;
+    unsigned int i;
+
+    __atomic_fetch_add( &sous_pages_gen, 1, __ATOMIC_SEQ_CST );
+    if (!sous_pages_fex || !fex_alias_nb) return;
+    pthread_mutex_lock( &fex_alias_mutex );
+    if ((size_t)(fin - debut) / host_page_size <= 256)
+    {
+        char *p;
+        for (p = debut; p < fin; p += host_page_size)
+            if ((e = fex_alias_trouver( p ))) fex_alias_retirer( e );
+    }
+    else for (i = 0; i < FEX_ALIAS_NB; i++)
+    {
+        e = &fex_alias[i];
+        if (e->hote > FEX_ALIAS_TOMBE && e->hote >= debut && e->hote < fin) fex_alias_retirer( e );
+    }
+    pthread_mutex_unlock( &fex_alias_mutex );
+}
+
+/* virtual_mutex tenu ; alias permanent de la page d'hote host pour FEX */
+static struct fex_alias *fex_alias_de( char *host )
+{
+    struct fex_alias *e, *libre = NULL;
+    unsigned int i, h = fex_alias_hache( host );
+    mach_vm_address_t cible = 0;
+    vm_prot_t cur, max;
+    kern_return_t kr;
+
+    pthread_mutex_lock( &fex_alias_mutex );
+    for (i = 0; i < FEX_ALIAS_NB; i++)
+    {
+        e = &fex_alias[(h + i) & (FEX_ALIAS_NB - 1)];
+        if (e->hote == host) goto fini;
+        if (e->hote == FEX_ALIAS_TOMBE) { if (!libre) libre = e; continue; }
+        if (!e->hote) { if (!libre) libre = e; break; }
+    }
+    e = NULL;
+    if (!libre || fex_alias_nb >= FEX_ALIAS_NB / 2) goto fini;
+    kr = mach_vm_remap( mach_task_self(), &cible, host_page_size, 0, VM_FLAGS_ANYWHERE,
+                        mach_task_self(), (mach_vm_address_t)(UINT_PTR)host, FALSE, &cur, &max, VM_INHERIT_NONE );
+    if (kr != KERN_SUCCESS) goto fini;
+    if (mach_vm_protect( mach_task_self(), cible, host_page_size, FALSE, VM_PROT_READ | (max & VM_PROT_WRITE) ))
+    {
+        mach_vm_deallocate( mach_task_self(), cible, host_page_size );
+        goto fini;
+    }
+    e = libre;
+    e->hote = host;
+    e->alias = (char *)(UINT_PTR)cible;
+    e->inscriptible = (max & VM_PROT_WRITE) != 0;
+    fex_alias_nb++;
+fini:
+    pthread_mutex_unlock( &fex_alias_mutex );
+    return e;
+}
+
+/***********************************************************************
+ *           virtual_alias_sous_page
+ *
+ * Adresse, dans l'alias permanent de sa page d'hote, d'un acces de size octets
+ * a addr que les pages de 4 Kio permettent (et qui ne deborde pas de la page
+ * d'hote), pour un atomique rejoue par signal_arm64.c : il s'y fait en vrai,
+ * comme ceux que FEX fait par son talon. NULL sinon. Sur pile de signal.
+ */
+void *virtual_alias_sous_page( void *addr, size_t size, BOOL ecriture )
+{
+    char *a = addr, *host = ROUND_ADDR( a, host_page_mask ), *sous;
+    struct fex_alias *e;
+    void *ret = NULL;
+
+    if (!size || ROUND_ADDR( a + size - 1, host_page_mask ) != host) return NULL;
+    mutex_lock( &virtual_mutex );
+    if (!page_hote_mixte( host )) goto fin;
+    for (sous = ROUND_ADDR( a, page_mask ); sous < a + size; sous += page_size)
+    {
+        BYTE v = get_page_vprot( sous );
+        if (!sous_page_ouverte( v )) goto fin;
+        if (ecriture && (!(v & (VPROT_WRITE | VPROT_WRITECOPY)) || (v & VPROT_WRITEWATCH))) goto fin;
+    }
+    if (!(e = fex_alias_de( host )) || (ecriture && !e->inscriptible)) goto fin;
+    ret = e->alias + (a - host);
+fin:
+    mutex_unlock( &virtual_mutex );
+    return ret;
+}
+
+/***********************************************************************
+ *           cidre_sous_pages   (appel unix de ntdll, depuis FEX)
+ *
+ * op 0 : FEX annonce qu'il reecrit ses acces ; rend l'adresse de
+ *        sous_pages_gen et le code de l'exception de proposition. Par
+ *        NtQueryVirtualMemory( MemoryCidreSousPages ) seulement.
+ * op 1 : etat de la page d'hote hote : mixte, alias, droits de lecture et
+ *        d'ecriture par page de 4 Kio (bit i = page i), generation.
+ * op 2 : (sans effet) FEX a remis une instruction d'origine.
+ * op 3 : FEX ne reecrira pas l'instruction hote (pc) d'encodage code.
+ */
+NTSTATUS cidre_sous_pages( void *args )
+{
+    struct cidre_sous_pages_params *p = args;
+    char *host;
+    struct fex_alias *e;
+    unsigned int i;
+    sigset_t sigset;
+
+    if (p->op == 0)
+    {
+        const char *env = getenv( "CIDRE_SOUS_PAGES_FEX" );
+        if (env && !atoi( env )) return STATUS_NOT_SUPPORTED;
+        if (host_page_size == page_size) return STATUS_NOT_SUPPORTED;
+        p->gen_ptr = (UINT64)(UINT_PTR)&sous_pages_gen;
+        p->code = STATUS_CIDRE_SOUS_PAGE;
+        sous_pages_fex = TRUE;
+        return STATUS_SUCCESS;
+    }
+    if (p->op == 2) return STATUS_SUCCESS;   /* ancienne annonce de remise : plus rien a oublier */
+    if (p->op == 3)
+    {
+        sous_pages_refuser( (ULONG_PTR)p->hote, p->code );
+        return STATUS_SUCCESS;
+    }
+    if (p->op != 1) return STATUS_INVALID_PARAMETER;
+
+    host = ROUND_ADDR( (char *)(UINT_PTR)p->hote, host_page_mask );
+    p->mixte = p->lecture = p->ecriture = 0;
+    p->alias = 0;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    p->gen = sous_pages_gen;
+    if (page_hote_mixte( host ) && (e = fex_alias_de( host )))
+    {
+        for (i = 0; i < host_page_size / page_size; i++)
+        {
+            BYTE v = get_page_vprot( host + i * page_size );
+            if (!sous_page_ouverte( v )) continue;
+            p->lecture |= 1u << i;
+            if (e->inscriptible && (v & (VPROT_WRITE | VPROT_WRITECOPY)) && !(v & VPROT_WRITEWATCH))
+                p->ecriture |= 1u << i;
+        }
+        p->alias = (UINT64)(UINT_PTR)e->alias;
+        p->mixte = 1;
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return STATUS_SUCCESS;
+}
