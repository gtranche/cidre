+/* Cidre : DLSS servi par MetalFX spatial (famille Apple < 9, ou le temporel gele
+   le GPU). Recopie la zone rendue de l'entree dans une texture a sa taille, en
+   retirant le jitter du moteur (decalage en pixels de rendu, filtre lineaire) :
+   sans historique, l'image tremblerait d'une fraction de pixel a chaque image. */
+struct cidre_dlss_recadrer_desc {
+  float2 decalage;
+  float2 taille_entree;
+  float2 taille_contenu;
+};
+
+[[kernel]] void cs_cidre_dlss_recadrer(
+  uint2 pos [[thread_position_in_grid]],
+  constant cidre_dlss_recadrer_desc& desc [[buffer(0)]],
+  texture2d<float, access::sample> entree [[texture(0)]],
+  texture2d<float, access::write> sortie [[texture(1)]]
+) {
+  if (pos.x >= uint(desc.taille_contenu.x) || pos.y >= uint(desc.taille_contenu.y))
+    return;
+  constexpr sampler lineaire(coord::normalized, address::clamp_to_edge, filter::linear);
+  float2 p = clamp(float2(pos) + 0.5 + desc.decalage, float2(0.5), desc.taille_contenu - 0.5);
+  sortie.write(entree.sample(lineaire, p / desc.taille_entree, level(0)), pos);
+}
+
