+static void
+kk_banc_dessins_charger(const char *chemin)
+{
+   int fd = open(chemin, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return;
+   kk_banc_dessins = _mesa_hash_table_create(NULL, kk_var_hash, kk_var_egal);
+   uint8_t buf[8 + KK_VAR_REC2];
+   unsigned pos = 0, nv = 0;
+   for (;;) {
+      if (read(fd, buf, 8) != 8)
+         break;
+      uint32_t magic, octets;
+      memcpy(&magic, buf, 4);
+      memcpy(&octets, buf + 4, 4);
+      if (magic != KK_VAR_MAGIC || (octets != KK_VAR_REC1 && octets != KK_VAR_REC2))
+         break;
+      if (read(fd, buf + 8, octets) != (ssize_t)octets)
+         break;
+      uint32_t rang = pos++;
+      if (octets == KK_VAR_REC2)
+         memcpy(&rang, buf + 8 + KK_VAR_REC1, 4);
+      struct hash_entry *e = _mesa_hash_table_search(kk_banc_dessins, buf + 8);
+      struct kk_banc_d *d = e ? e->data : NULL;
+      if (d == NULL) {
+         d = rzalloc(kk_banc_dessins, struct kk_banc_d);
+         memcpy(d->cles, buf + 8, sizeof(d->cles));
+         d->rang_min = UINT32_MAX;
+         _mesa_hash_table_insert(kk_banc_dessins, d->cles, d);
+      }
+      if (d->n < ARRAY_SIZE(d->v)) {
+         memset(&d->v[d->n], 0, sizeof(d->v[0]));
+         memcpy((char *)&d->v[d->n] + KK_VAR_DEBUT, buf + 8 + 2 * KK_BASE_CLE, KK_VAR_OCTETS);
+         d->n++;
+         nv++;
+      }
+      d->rang_min = MIN2(d->rang_min, rang);
+   }
+   close(fd);
+   fprintf(stderr, "kk: banc : dessins a rejouer : %u variantes, %u paires (%s)\n", nv,
+           kk_banc_dessins->entries, chemin);
+}
