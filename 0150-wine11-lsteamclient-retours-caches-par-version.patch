-    const struct signature_steam *sig;
 
     /* Un appel par methode et par image : en ERR, le journal coutait plus cher
      * que le pont lui-meme. En TRACE, il ne s'active qu'a la demande. */
@@ -355,11 +395,29 @@
     if (objet->nom[0])
     {
         UINT64 neutre;
+        unsigned tampon;
 
         if (voix_non_relayee( objet->nom, emplacement, &neutre )) return neutre;
-        sig = emplacement < NB_SIGNATURES ? objet->sigs[emplacement] : NULL;
-        if (sig && sig->tampon)
+        tampon = emplacement < NB_SIGNATURES ? objet->tampons[emplacement] : 0;
+
+        /*
+         * Un pointeur de sortie est une adresse d'utilisateur, sous 2^47. Au-dela,
+         * le premier argument est une valeur -- un CSteamID porte l'univers dans
+         * son octet haut (0x01 pour Public) -- et la disposition connue ne
+         * correspond pas a la version du jeu. Relayer sans decalage vaut mieux
+         * qu'ecrire a cette adresse.
+         */
+        if (tampon && (a >> 47))
         {
+            static unsigned char signale[NB_SIGNATURES];
+
+            if (!signale[emplacement]++)
+                ERR( "%s emplacement %u : %s n'est pas un tampon de sortie, relaye sans decalage\n",
+                     ou, emplacement, wine_dbgstr_longlong(a) );
+            tampon = 0;
+        }
+        if (tampon)
+        {
             /*
              * Retour par pointeur cache (un CSteamID : classe a constructeur,
              * que MSVC ne rend jamais dans RAX). Cote Microsoft x64 le pointeur
@@ -378,7 +436,7 @@
              * registre -- classe MEMORY ou mixte entier/flottant -- et le
              * relais ne sait pas encore la traiter.
              */
-            if (sig->tampon != 8) { ERR( "%s emplacement %u : tampon de %u octets, non traite\n", ou, emplacement, sig->tampon ); return 0; }
+            if (tampon != 8) { ERR( "%s emplacement %u : tampon de %u octets, non traite\n", ou, emplacement, tampon ); return 0; }
             if (!a) return 0;
             params.a = b; params.b = c; params.c = d; params.d = e; params.e = f; params.f = g;
             params.g = h; params.h = i; params.i = 0;
@@ -719,7 +777,12 @@
 
     /* Les signatures d'abord : la table de methodes en depend en 32 bits. */
     for (k = 0; k < NB_SIGNATURES; k++)
+    {
         objet->sigs[k] = signature( objet->nom[0] ? objet->nom : "SteamClient", k );
+#ifdef _WIN64
+        objet->tampons[k] = taille_retour64( objet->nom, k, objet->sigs[k] );
+#endif
+    }
 
 #ifdef _WIN64
     objet->table = table_steam_client;
