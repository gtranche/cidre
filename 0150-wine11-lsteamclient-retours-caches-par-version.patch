@@ -293,6 +299,41 @@
 }
 
 #ifdef _WIN64
+#include "retours64.h"
+
+/*
+ * Retour par pointeur cache, version par version.
+ *
+ * signatures32.h decrit les methodes par NOM d'interface, d'apres un steam_api
+ * d'epoque SteamFriends017. Mais les emplacements bougent d'une version a
+ * l'autre : SteamFriends018 a retire SetPersonaName (emplacement 1), et tout
+ * ISteamFriends a glisse d'un cran. Sur Demonologist (UE 5.6, SteamFriends018),
+ * GetFriendRelationship -- nouvel emplacement 4 -- etait pris pour
+ * GetFriendByIndex : le CSteamID passe en argument (0x0110000114532c3b) servait
+ * d'adresse de sortie, et le jeu tombait en ACCESS_VIOLATION a l'ecriture sur
+ * son fil principal, avant le menu.
+ *
+ * retours64.h donne la disposition par chaine de version exacte, relevee dans
+ * les steam_api64.dll des jeux (tests/engendrer_retours64.py). Une version
+ * relevee sans ligne n'a aucun retour cache ; seule une version inconnue
+ * retombe sur la table i386.
+ */
+static unsigned taille_retour64( const char *version, unsigned emplacement,
+                                 const struct signature_steam *sig )
+{
+    unsigned i;
+
+    if (version && version[0])
+    {
+        for (i = 0; i < ARRAY_SIZE(retours64); i++)
+            if (retours64[i].emplacement == emplacement && !strcmp( retours64[i].version, version ))
+                return retours64[i].taille;
+        for (i = 0; i < ARRAY_SIZE(versions64); i++)
+            if (!strcmp( versions64[i], version )) return 0;
+    }
+    return sig ? sig->tampon : 0;
+}
