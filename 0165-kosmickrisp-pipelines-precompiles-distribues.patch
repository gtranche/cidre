+static NSString *
+kk_library_key(const char *src, uint32_t version, uint32_t math_mode, uint32_t fp_fns)
+{
+   CC_SHA256_CTX c;
+   unsigned char h[CC_SHA256_DIGEST_LENGTH];
+   uint32_t opts[3] = {version, math_mode, fp_fns};
+   CC_SHA256_Init(&c);
+   CC_SHA256_Update(&c, src, (CC_LONG)strlen(src));
+   CC_SHA256_Update(&c, opts, sizeof(opts));
+   CC_SHA256_Final(h, &c);
+   char hex[2 * CC_SHA256_DIGEST_LENGTH + 1];
+   for (unsigned i = 0; i < CC_SHA256_DIGEST_LENGTH; i++)
+      snprintf(hex + 2 * i, 3, "%02x", h[i]);
+   return [NSString stringWithUTF8String:hex];
+}
+
+/* Ecrit un fichier une fois (s'il existe deja, rien), en passant par un
+ * fichier temporaire pour qu'un autre processus ne lise jamais une moitie. */
+static void
+kk_write_once(NSString *path, NSData *data)
+{
+   NSFileManager *fm = [NSFileManager defaultManager];
+   if ([fm fileExistsAtPath:path])
+      return;
+   NSString *tmp = [path stringByAppendingFormat:@".%d.tmp", (int)getpid()];
+   if ([data writeToFile:tmp atomically:NO])
+      [fm moveItemAtPath:tmp toPath:path error:NULL];
+   [fm removeItemAtPath:tmp error:NULL];
+}
+
+static void
+kk_recolte_library(const char *dir, NSString *key, const char *src,
+                   uint32_t version, uint32_t math_mode, uint32_t fp_fns)
+{
+   NSString *base = [[NSString stringWithUTF8String:dir] stringByAppendingPathComponent:@"msl"];
+   [[NSFileManager defaultManager] createDirectoryAtPath:base withIntermediateDirectories:YES
+                                              attributes:nil error:NULL];
+   NSString *opts = [NSString stringWithFormat:@"%u %u %u\n", version, math_mode, fp_fns];
+   kk_write_once([base stringByAppendingPathComponent:[key stringByAppendingString:@".opts"]],
+                 [opts dataUsingEncoding:NSUTF8StringEncoding]);
+   kk_write_once([base stringByAppendingPathComponent:[key stringByAppendingString:@".metal"]],
+                 [NSData dataWithBytes:src length:strlen(src)]);
+}
+
+static void
+kk_recolte_line(NSString *line)
+{
+   const char *dir = kk_env_dir("MESA_KK_RECOLTE");
+   if (!dir)
+      return;
+   pthread_mutex_lock(&kk_recolte_mutex);
+   if (!kk_recolte_pipelines) {
+      [[NSFileManager defaultManager] createDirectoryAtPath:[NSString stringWithUTF8String:dir]
+                                withIntermediateDirectories:YES attributes:nil error:NULL];
+      char path[2048];
+      snprintf(path, sizeof(path), "%s/pipelines.%d.jsonl", dir, (int)getpid());
+      kk_recolte_pipelines = fopen(path, "a");
+   }
+   if (kk_recolte_pipelines) {
+      fputs(line.UTF8String, kk_recolte_pipelines);
+      fputc('\n', kk_recolte_pipelines);
+      fflush(kk_recolte_pipelines);
+   }
+   pthread_mutex_unlock(&kk_recolte_mutex);
+}
