+   NSString *key = objc_getAssociatedObject(lfd.library, kk_lib_key_key);
+   if (key == nil || lfd.name == nil)
+      return @"null";
+   return [NSString stringWithFormat:@"[\"%@\",\"%@\"]", key, lfd.name];
+}
