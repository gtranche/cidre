+/* Cidre (0205) : sous un mode d'ecran emule (CIDRE_EMULATE_MODESET), win32u
+ * etend la fenetre plein ecran a tout l'ecran et y centre le rectangle client
+ * a l'aspect du mode. Un mode d'un aspect presque egal a celui de l'espace
+ * laisse une bande de quelques points : Little Nightmares en 1168x730 (1,600)
+ * dans un espace de 1728x1084 (1,594) a une couche de 1728x1080 et 2 points
+ * a nu en haut et en bas. Cette bande suffit a faire composer chaque image
+ * (plus d'affichage direct, detachement 0x70017) et montrait la surface GDI
+ * blanche. Quand l'ecart est d'au plus 1 % sur chaque dimension (reglable par
+ * CIDRE_EMULE_ETIREMENT, en pour cent, 0 pour ne jamais etirer), la vue du jeu
+ * couvre toute la fenetre : l'image est etiree de moins de 1 %, invisible, et
+ * le pointeur reste a moins de 1 % de sa place. Un mode d'un autre format
+ * (4:3 sur 16:10) garde ses bandes noires et son centrage (0172).
+ * rect est relatif au rectangle visible de la fenetre, comme monitor_rect. */
+static BOOL cidre_etirer_a_la_fenetre(const struct macdrv_win_data *data, const RECT *rect)
+{
+    static int tolerance = -1;
+    int vw = data->rects.visible.right - data->rects.visible.left;
+    int vh = data->rects.visible.bottom - data->rects.visible.top;
+    int w = rect->right - rect->left, h = rect->bottom - rect->top;
+
+    if (tolerance < 0)
+    {
+        const char *emule = getenv("CIDRE_EMULATE_MODESET"), *env = getenv("CIDRE_EMULE_ETIREMENT");
+        if (!emule || !*emule || !strchr("1yYtT", *emule)) tolerance = 0;
+        else tolerance = (env && *env) ? atoi(env) : 1;
+        if (tolerance < 0) tolerance = 0;
+    }
+    if (!tolerance || vw <= 0 || vh <= 0 || w <= 0 || h <= 0) return FALSE;
+    if (EqualRect(&data->rects.window, &data->rects.visible)) return FALSE;
+    if (w == vw && h == vh) return FALSE;
+    if (rect->left < 0 || rect->top < 0 || rect->right > vw || rect->bottom > vh) return FALSE;
+    return (vw - w) * 100 <= vw * tolerance && (vh - h) * 100 <= vh * tolerance;
+}
