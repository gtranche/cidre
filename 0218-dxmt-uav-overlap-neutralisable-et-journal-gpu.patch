+/*
+ * Cidre : journal GPU (CIDRE_DXMT_JOURNAL_GPU=1, ou =<chemin Unix>).
+ *
+ * Chaque tampon de commandes recoit un gestionnaire de fin et, par son
+ * descripteur, MTLCommandBufferErrorOptionEncoderExecutionStatus : un tampon en
+ * erreur (faute GPU, expiration, victime d'une recuperation) donne une ligne avec
+ * le code, la description et l'etat de chacun de ses encodeurs (etiquette avec
+ * DXMT_ENCODER_LABELS=1 ; « Faulted » nomme l'encodeur fautif). Un tampon dont le
+ * GPU a pris plus de 250 ms est note lui aussi. Un fil de garde ecrit toutes les
+ * 2 s un releve (tampons soumis/termines, erreurs, temps GPU maximal, memoire du
+ * device) et, tant qu'aucun tampon ne se termine alors que d'autres sont en vol,
+ * une ligne par seconde : c'est la trace d'un gel du GPU. Chaque ligne est poussee
+ * sur le disque (fsync) : un gel du M1 finit en panique du noyau, et le journal
+ * DXMT, en tampon, s'y perdait au milieu d'une ligne. Fichier par defaut :
+ * /tmp/cidre-journal-gpu-<pid>.txt. Rien n'est change sans la variable.
+ */
+#include <fcntl.h>
+#include <pthread.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+static int cidre_jgpu_fd = -1;
+static _Atomic uint64_t cidre_jgpu_crees, cidre_jgpu_finis, cidre_jgpu_erreurs, cidre_jgpu_lents;
+static _Atomic uint64_t cidre_jgpu_max_us; /* temps GPU maximal depuis le dernier releve */
+static _Atomic uint64_t cidre_jgpu_derniere_fin_ms; /* horloge monotone */
+static id<MTLDevice> cidre_jgpu_device;
+
+static uint64_t
+cidre_jgpu_ms(void) {
+  return (uint64_t)(CACurrentMediaTime() * 1000.0);
+}
+
+static void
+cidre_jgpu_ecrire(const char *fmt, ...) {
+  char ligne[4096];
+  struct timeval tv;
+  struct tm tm;
+  gettimeofday(&tv, NULL);
+  localtime_r(&tv.tv_sec, &tm);
+  int n = snprintf(ligne, sizeof(ligne), "%02d:%02d:%02d.%03d cidre-gpu: ", tm.tm_hour, tm.tm_min, tm.tm_sec,
+                   (int)(tv.tv_usec / 1000));
+  va_list ap;
+  va_start(ap, fmt);
+  n += vsnprintf(ligne + n, sizeof(ligne) - n - 1, fmt, ap);
+  va_end(ap);
+  if (n > (int)sizeof(ligne) - 2)
+    n = sizeof(ligne) - 2;
+  ligne[n++] = '\n';
+  write(cidre_jgpu_fd, ligne, n);
+  fsync(cidre_jgpu_fd);
+}
+
+static const char *
+cidre_jgpu_etat_encodeur(MTLCommandEncoderErrorState e) {
+  switch (e) {
+  case MTLCommandEncoderErrorStateUnknown: return "inconnu";
+  case MTLCommandEncoderErrorStateCompleted: return "fini";
+  case MTLCommandEncoderErrorStateAffected: return "touche";
+  case MTLCommandEncoderErrorStatePending: return "en attente";
+  case MTLCommandEncoderErrorStateFaulted: return "FAUTIF";
+  }
+  return "?";
+}
+
+static void
+cidre_jgpu_fin(id<MTLCommandBuffer> cb) {
+  @autoreleasepool {
+    uint64_t n = atomic_fetch_add(&cidre_jgpu_finis, 1) + 1;
+    atomic_store(&cidre_jgpu_derniere_fin_ms, cidre_jgpu_ms());
+    double gpu_ms = (cb.GPUEndTime - cb.GPUStartTime) * 1000.0;
+    if (gpu_ms > 0) {
+      uint64_t us = (uint64_t)(gpu_ms * 1000.0), m = atomic_load(&cidre_jgpu_max_us);
+      while (us > m && !atomic_compare_exchange_weak(&cidre_jgpu_max_us, &m, us))
+        ;
+    }
+    if (cb.status == MTLCommandBufferStatusError) {
+      atomic_fetch_add(&cidre_jgpu_erreurs, 1);
+      NSError *err = cb.error;
+      cidre_jgpu_ecrire("ERREUR tampon %llu (%s) : code %ld, %s, GPU %.1f ms", n,
+                        cb.label ? cb.label.UTF8String : "sans etiquette", (long)err.code,
+                        err.localizedDescription.UTF8String ?: "?", gpu_ms);
+      NSArray *infos = err.userInfo[MTLCommandBufferEncoderInfoErrorKey];
+      for (id<MTLCommandBufferEncoderInfo> info in infos) {
+        NSString *signets = info.debugSignposts.count ? [info.debugSignposts componentsJoinedByString:@","] : @"";
+        cidre_jgpu_ecrire("  encodeur %s : %s %s", info.label ? info.label.UTF8String : "sans etiquette",
+                          cidre_jgpu_etat_encodeur(info.errorState), signets.UTF8String);
+      }
+      if (!infos.count)
+        cidre_jgpu_ecrire("  (aucun etat d'encodeur ; userInfo %s)", err.userInfo.description.UTF8String ?: "?");
+    } else if (gpu_ms > 250.0) {
+      atomic_fetch_add(&cidre_jgpu_lents, 1);
+      cidre_jgpu_ecrire("lent : tampon %llu, GPU %.1f ms", n, gpu_ms);
+    }
+  }
+}
+
+static void *
+cidre_jgpu_garde(void *arg) {
+  (void)arg;
+  uint64_t tours = 0;
+  for (;;) {
+    sleep(1);
+    tours++;
+    uint64_t crees = atomic_load(&cidre_jgpu_crees), finis = atomic_load(&cidre_jgpu_finis);
+    uint64_t silence = cidre_jgpu_ms() - atomic_load(&cidre_jgpu_derniere_fin_ms);
+    if (crees > finis && silence >= 1000)
+      cidre_jgpu_ecrire("GEL ? aucun tampon termine depuis %.1f s, %llu en vol", silence / 1000.0, crees - finis);
+    if (tours % 2 == 0) {
+      uint64_t max_us = atomic_exchange(&cidre_jgpu_max_us, 0);
+      cidre_jgpu_ecrire("releve : %llu soumis, %llu finis, %llu erreurs, %llu lents, GPU max %.1f ms, memoire %.0f Mo",
+                        crees, finis, atomic_load(&cidre_jgpu_erreurs), atomic_load(&cidre_jgpu_lents), max_us / 1000.0,
+                        cidre_jgpu_device ? cidre_jgpu_device.currentAllocatedSize / 1048576.0 : 0.0);
+    }
+  }
+  return NULL;
+}
+
+static bool
+cidre_jgpu_actif(void) {
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    const char *e = getenv("CIDRE_DXMT_JOURNAL_GPU");
+    if (!e || !*e || !strcmp(e, "0"))
+      return;
+    char chemin[1024];
+    if (!strcmp(e, "1"))
+      snprintf(chemin, sizeof(chemin), "/tmp/cidre-journal-gpu-%d.txt", (int)getpid());
+    else
+      snprintf(chemin, sizeof(chemin), "%s", e);
+    cidre_jgpu_fd = open(chemin, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+    if (cidre_jgpu_fd < 0) {
+      fprintf(stderr, "cidre-gpu: journal %s impossible a ouvrir\n", chemin);
+      return;
+    }
+    atomic_store(&cidre_jgpu_derniere_fin_ms, cidre_jgpu_ms());
+    cidre_jgpu_ecrire("journal ouvert (pid %d)", (int)getpid());
+    pthread_t t;
+    pthread_create(&t, NULL, cidre_jgpu_garde, NULL);
+    pthread_detach(t);
+  });
+  return cidre_jgpu_fd >= 0;
+}
+
+/* tampon de commandes journalise (autorelease, comme [queue commandBuffer]) */
+static id<MTLCommandBuffer>
+cidre_jgpu_tampon(id<MTLCommandQueue> queue) {
+  MTLCommandBufferDescriptor *desc = [[MTLCommandBufferDescriptor alloc] init];
+  desc.errorOptions = MTLCommandBufferErrorOptionEncoderExecutionStatus;
+  id<MTLCommandBuffer> cb = [queue commandBufferWithDescriptor:desc];
+  [desc release];
+  if (!cidre_jgpu_device)
+    cidre_jgpu_device = [queue.device retain];
+  [cb addCompletedHandler:^(id<MTLCommandBuffer> fini) {
+    cidre_jgpu_fin(fini);
+  }];
+  return cb;
+}
+
+/* a l'envoi (commit) : un tampon cree mais jamais soumis ne compte pas en vol */
+static void
+cidre_jgpu_soumis(void) {
+  if (cidre_jgpu_fd >= 0)
+    atomic_fetch_add(&cidre_jgpu_crees, 1);
+}
