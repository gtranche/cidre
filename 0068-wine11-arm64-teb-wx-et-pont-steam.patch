+/*
+ * Cote PE du pont Steamworks : ce que le steam_api du jeu appelle.
+ */
+
+#include <stdarg.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+#include "signatures32.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(lsteamclient);
+
+BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls( inst );
+        if (__wine_init_unix_call()) return FALSE;
+        if (WINE_UNIX_CALL( unix_attach, NULL )) return FALSE;
+    }
+    return TRUE;
+}
+
+static void *envelopper( UINT64 natif, const char *nom );
+
+/*
+ * Traduire un pointeur de l'invite vers l'espace de l'hote.
+ *
+ * L'unixlib vit chez l'hote et dereference ce qu'on lui passe. En 64 bits les
+ * deux espaces se confondent et ceci est l'identite. En 32 bits sur macOS la
+ * fenetre de l'invite est deplacee -- le noyau lui interdit les adresses sous
+ * 4 Gio -- et ntdll publie la base a laquelle elle a ete posee.
+ */
+#ifndef _WIN64
+extern __declspec(dllimport) ULONG64 __wine_wow64_guest_base;
+
+static inline UINT64 vers_hote( const void *p )
+{
+    return p ? (UINT64)(ULONG_PTR)p + __wine_wow64_guest_base : 0;
+}
+
+/*
+ * Un mot d'argument : entier ou pointeur ?
+ *
+ * La table mesuree donne le nombre de mots empiles, pas leur nature -- celle-ci
+ * n'est publiee que dans le SDK Steamworks, qu'on ne veut pas. On interroge
+ * donc l'adresse : un mot qui designe de la memoire lisible de l'invite est
+ * traite comme un pointeur, les autres passent tels quels.
+ *
+ * Deux garde-fous :
+ *   - sous 0x110000 vit la zone DOS, que l'invite libere au demarrage : jamais
+ *     une adresse valide, et c'est la que tombent les poignees Steam
+ *     (HSteamPipe, HSteamUser) et la plupart des identifiants d'application ;
+ *   - IsBadReadPtr lit sous garde, sans appel systeme.
+ *
+ * Reste un risque, borne et assume : un entier au-dela de 0x110000 qui
+ * tomberait sur une page engagee serait traduit a tort. La trace le dit.
+ */
+static UINT64 mot_vers_hote( UINT32 mot )
+{
+    if (mot < 0x110000) return mot;
+    if (IsBadReadPtr( (const void *)(ULONG_PTR)mot, 1 )) return mot;
+    TRACE( "mot %#x pris pour un pointeur\n", (unsigned)mot );
+    return vers_hote( (const void *)(ULONG_PTR)mot );
+}
+#else
+static inline UINT64 vers_hote( const void *p ) { return (UINT64)(ULONG_PTR)p; }
+#endif
+
+/* Ce que le steam_api du jeu appelle en premier. L'interface rendue doit etre
+ * un objet PE : rendre l'objet natif ferait entrer le jeu en ABI System V. */
+void * CDECL CreateInterface( const char *version, int *err )
+{
+    struct create_interface_params params = { vers_hote( version ), vers_hote( err ), 0 };
+    void *objet;
+
+    if (WINE_UNIX_CALL( unix_create_interface, &params )) return NULL;
+    if (!params.ret) { ERR( "%s : le client natif ne connait pas cette interface\n", debugstr_a(version) ); return NULL; }
+
+    objet = envelopper( params.ret, NULL );
+    /* L'adresse native fait 64 bits ; la tronquer a la largeur du PE rendrait
+     * la trace trompeuse cote 32 bits. */
+    TRACE( "%s : natif %s -> objet PE %p\n", debugstr_a(version),
+           wine_dbgstr_longlong(params.ret), objet );
+    return objet;
+}
+
+int CDECL SondeCreateSteamPipe( void *iface )
+{
+    struct create_steam_pipe_params params = { (ULONG_PTR)iface, 0 };
+
+    if (WINE_UNIX_CALL( unix_create_steam_pipe, &params )) return 0;
+    TRACE( "%p -> %d\n", iface, params.ret );
+    return params.ret;
+}
+
+/*
+ * L'objet que le jeu croira Windows.
+ *
+ * Un jeu appelle une methode virtuelle en ABI Microsoft x64 : « this » dans
+ * RCX. L'objet natif, lui, attend System V : « this » dans RDI. On fabrique
+ * donc cote PE un objet dont la table de methodes contient nos thunks ; chacun
+ * recoit l'appel a la mode Windows, retrouve l'interface native, et passe par
+ * l'unixlib qui fera l'appel a la mode System V.
+ *
+ * Le compilateur PE emettant du Microsoft x64, une simple fonction C dont le
+ * premier parametre est l'objet suffit a recevoir un appel virtuel.
+ */
+struct objet_pe
+{
+    const void **table;   /* doit rester en tete : c'est ce que le jeu deref */
+    UINT64       natif;   /* adresse 64 bits, qu'un « void * » de PE 32 bits
+                           * ne pourrait pas contenir */
+    /* La chaine de version appartient a l'appelant et peut etre temporaire :
+     * la garder par pointeur donnait un nom corrompu quelques milliers
+     * d'appels plus tard, et donc une signature choisie au hasard. On la
+     * recopie. Vide pour ISteamClient. */
+    char         nom[64];
+    /* Signature resolue une fois par emplacement, a l'enveloppement. La
+     * chercher a chaque appel revenait a parcourir les 876 entrees de la table
+     * plusieurs centaines de fois par seconde, pour un resultat constant. */
+    const struct signature_steam *sigs[NB_SIGNATURES];
+};
+
+/*
+ * Table de decouverte.
+ *
+ * L'ordre des methodes d'ISteamClient n'est publie que dans le SDK
+ * Steamworks, qui est proprietaire : le deviner reviendrait a appeler des
+ * fonctions inconnues sur la session Steam vivante de l'utilisateur, ce qui
+ * peut le deconnecter. On fait donc l'inverse : la table est peuplee de
+ * thunks qui journalisent leur emplacement et rendent zero. Le steam_api du
+ * jeu, lui, sait ou il appelle ; il suffit de le laisser parler pour obtenir
+ * la liste exacte, dans l'ordre, des emplacements qui comptent -- et les
+ * chaines de version qu'il transmet identifient les interfaces demandees.
+ *
+ * Seuls les emplacements deja eprouves sont reellement suivis ; les autres
+ * rendent zero, ce qui echoue proprement au lieu de sauter n'importe ou.
+ */
+#define NB_EMPLACEMENTS 64
+
+/*
+ * Retrouver la signature d'une methode.
+ *
+ * Le jeu designe une interface par sa chaine de version : « SteamUser021 », ou
+ * « STEAMAPPS_INTERFACE_VERSION008 ». La table mesuree, elle, les nomme
+ * « ISteamUser », « ISteamApps ». On compare donc la partie utile, sans tenir
+ * compte de la casse que la premiere forme a perdue.
+ */
+static BOOL meme_interface( const char *interface, const char *version )
+{
+    const char *v = version, *i = interface;
+    const char *sep;
+
+    if (!version) return FALSE;
+    if (strncmp( i, "ISteam", 6 )) return FALSE;
+    i += 6;
+
+    if ((sep = strstr( v, "_INTERFACE_VERSION" )))
+    {
+        if (!strncasecmp( v, "STEAM", 5 )) v += 5;
+        if (sep - v != (int)strlen( i )) return FALSE;
+        return !strncasecmp( v, i, sep - v );
+    }
+    if (!strncasecmp( v, "Steam", 5 )) v += 5;
+    /* « SteamUser021 » : la partie utile s'arrete au premier chiffre. */
+    {
+        size_t n = 0;
+        while (v[n] && (v[n] < '0' || v[n] > '9')) n++;
+        if (n != strlen( i )) return FALSE;
+        return !strncasecmp( v, i, n );
+    }
+}
+
+/* Les emplacements d'ISteamClient qui rendent une interface. Identiques de la
+ * version 017 a la version 021 : elles ne divergent qu'a partir de 19. */
+static BOOL rend_interface( unsigned emplacement )
+{
+    switch (emplacement)
+    {
+    case 5: case 6: case 8: case 9: case 10: case 11:
+    case 12: case 13: case 14: case 15: case 16: case 17: case 18:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+static const struct signature_steam *signature( const char *version, unsigned emplacement )
+{
+    unsigned i;
+
+    if (!version) return NULL;
+    for (i = 0; i < ARRAY_SIZE(signatures); i++)
+        if (signatures[i].emplacement == emplacement &&
+            meme_interface( signatures[i].interface, version ))
+            return &signatures[i];
+    return NULL;
+}
+
+#ifdef _WIN64
+static UINT64 repartir( unsigned emplacement, void *self,
+                        UINT64 a, UINT64 b, UINT64 c, UINT64 d, UINT64 e, UINT64 f )
+{
+    struct objet_pe *objet = self;
+    struct appel_vtable_params params = { objet->natif, emplacement, 0, a, b, c, d, e, f, 0 };
+    const char *ou = objet->nom[0] ? objet->nom : "ISteamClient";
+    const struct signature_steam *sig;
+
+    /* Un appel par methode et par image : en ERR, le journal coutait plus cher
+     * que le pont lui-meme. En TRACE, il ne s'active qu'a la demande. */
+    if (!IsBadStringPtrA( (LPCSTR)(ULONG_PTR)a, 64 ))
+        TRACE( "%s emplacement %u( \"%s\", %p, %p )\n", ou, emplacement,
+             (const char *)(ULONG_PTR)a, (void *)(ULONG_PTR)b, (void *)(ULONG_PTR)c );
+    else if (!IsBadStringPtrA( (LPCSTR)(ULONG_PTR)b, 64 ))
+        TRACE( "%s emplacement %u( %p, \"%s\", %p )\n", ou, emplacement,
+             (void *)(ULONG_PTR)a, (const char *)(ULONG_PTR)b, (void *)(ULONG_PTR)c );
+    else if (!IsBadStringPtrA( (LPCSTR)(ULONG_PTR)c, 64 ))
+        TRACE( "%s emplacement %u( %p, %p, \"%s\" )\n", ou, emplacement,
+             (void *)(ULONG_PTR)a, (void *)(ULONG_PTR)b, (const char *)(ULONG_PTR)c );
+    else
+        TRACE( "%s emplacement %u( %p, %p, %p )\n", ou, emplacement,
+             (void *)(ULONG_PTR)a, (void *)(ULONG_PTR)b, (void *)(ULONG_PTR)c );
+
+    /*
+     * Pour une sous-interface, le relais se passe de carte : l'emplacement N de
+     * notre table designe l'emplacement N de la table native du meme objet.
+     * Aucun nom n'est necessaire -- c'est le jeu qui choisit la methode, et
+     * elle atterrit sur celle qu'il visait.
+     *
+     * ISteamClient, lui, demande un traitement : certaines de ses methodes
+     * rendent une interface, qu'il faut envelopper avant de la donner au jeu.
+     */
+    if (objet->nom[0])
+    {
+        if (WINE_UNIX_CALL( unix_appel_vtable, &params )) return 0;
+
+        sig = emplacement < NB_SIGNATURES ? objet->sigs[emplacement] : NULL;
+        if (sig && sig->tampon)
+        {
+            /* Le natif a rendu la valeur dans RAX ; l'appelant attend qu'elle
+             * soit ecrite dans son tampon et que RAX en porte l'adresse. Au-dela
+             * de huit octets la structure ne revient plus dans un seul registre
+             * -- classe MEMORY ou mixte entier/flottant -- et le relais ne sait
+             * pas encore la traiter. */
+            if (sig->tampon != 8) { ERR( "%s emplacement %u : tampon de %u octets, non traite\n", ou, emplacement, sig->tampon ); return 0; }
+            if (!a) return 0;
+            *(UINT64 *)(ULONG_PTR)a = params.ret;
+            TRACE( "structure de 8 octets rendue via le tampon %p\n", (void *)(ULONG_PTR)a );
+            return a;
+        }
+        return params.ret;
+    }
+
+    /*
+     * Les emplacements 0 a 18 d'ISteamClient sont identiques d'une version a
+     * l'autre -- verifie sur 017, 020 et 021, qui ne divergent qu'a partir de
+     * 19. Au-dela, savoir lesquels rendent une interface demanderait la carte
+     * de la version exacte, alors on relaie sans envelopper.
+     */
+    if (WINE_UNIX_CALL( unix_appel_vtable, &params )) return 0;
+    if (!params.ret) return 0;
+
+    if (rend_interface( emplacement ))
+    {
+        /* Rend une interface : l'envelopper, sinon le jeu recevrait un objet
+         * System V. Le nom ne sert qu'au journal ; c'est la chaine de version,
+         * en dernier argument pour les getters a trois parametres, en
+         * avant-dernier pour ceux qui se passent d'utilisateur. */
+        const char *nom = NULL;
+
+        if (!IsBadStringPtrA( (LPCSTR)(ULONG_PTR)c, 64 )) nom = (const char *)(ULONG_PTR)c;
+        else if (!IsBadStringPtrA( (LPCSTR)(ULONG_PTR)b, 64 )) nom = (const char *)(ULONG_PTR)b;
+        return (ULONG_PTR)envelopper( params.ret, nom );
+    }
+    return params.ret;
+}
+
