+
+#include "thunks32.h"
+
+#ifndef _WIN64
+/*
+ * Le relais __thiscall.
+ *
+ * Le thunk a deja fait le plus difficile : il depilera le bon nombre d'octets,
+ * parce que sa signature a ete choisie a l'enveloppement d'apres la table
+ * mesuree. Reste a transporter les arguments. Chaque mot de pile devient un
+ * argument de 64 bits ; une methode prenant un entier long occupe deux mots et
+ * n'est donc pas encore traitee -- elle est signalee plutot que mal appelee.
+ */
+static UINT64 repartir32( unsigned emplacement, void *self, unsigned mots, const UINT32 *args )
+{
+    struct objet_pe *objet = self;
+    const char *ou = objet->nom[0] ? objet->nom : "ISteamClient";
+    const struct signature_steam *sig = emplacement < NB_SIGNATURES ? objet->sigs[emplacement] : NULL;
+    struct appel_vtable_params params = { objet->natif, emplacement, 0, 0, 0, 0, 0, 0, 0, 0 };
+    unsigned tampon = sig ? sig->tampon : 0;
+    unsigned debut = tampon ? 1 : 0;   /* le pointeur cache occupe le premier mot */
+    UINT64 *dest[6];
+    unsigned i;
+
+    TRACE( "%s emplacement %u (%u mots%s)\n", ou, emplacement, mots,
+           tampon ? ", retour par pointeur cache" : "" );
+
+    dest[0] = &params.a; dest[1] = &params.b; dest[2] = &params.c;
+    dest[3] = &params.d; dest[4] = &params.e; dest[5] = &params.f;
+    for (i = debut; i < mots && i - debut < 6; i++)
+        *dest[i - debut] = mot_vers_hote( args[i] );
+
+    if (WINE_UNIX_CALL( unix_appel_vtable, &params )) return 0;
+
+    if (tampon)
+    {
+        if (tampon != 8)
+        {
+            ERR( "%s emplacement %u : tampon de %u octets, non traite\n", ou, emplacement, tampon );
+            return 0;
+        }
+        *(UINT64 *)(ULONG_PTR)args[0] = params.ret;
+        return args[0];
+    }
+
+    /* Les methodes d'ISteamClient qui rendent une interface doivent la rendre
+     * enveloppee : le jeu recevrait sinon un pointeur natif de 64 bits, qu'un
+     * registre de 32 bits ne peut meme pas contenir. La chaine de version est
+     * le dernier argument. */
+    if (!objet->nom[0] && params.ret && rend_interface( emplacement ))
+    {
+        const char *nom = NULL;
+        unsigned k;
+
+        for (k = mots; k > debut; k--)
+            if (!IsBadStringPtrA( (LPCSTR)(ULONG_PTR)args[k - 1], 64 ))
+            { nom = (const char *)(ULONG_PTR)args[k - 1]; break; }
+        return (ULONG_PTR)envelopper( params.ret, nom );
+    }
+    return params.ret;
+}
+
+/* Construit la table de methodes d'une interface : pour chaque emplacement, le
+ * thunk dont la discipline de pile correspond a la methode mesuree. */
+static const void **table_pour( const struct objet_pe *objet )
+{
+    const void **table = HeapAlloc( GetProcessHeap(), 0, NB_EMPLACEMENTS32 * sizeof(*table) );
+    unsigned k;
+
+    if (!table) return NULL;
+    for (k = 0; k < NB_EMPLACEMENTS32; k++)
+    {
+        const struct signature_steam *sig = k < NB_SIGNATURES ? objet->sigs[k] : NULL;
+        table[k] = table32[k][sig ? sig->mots : 0];
+    }
+    return table;
+}
+#endif
