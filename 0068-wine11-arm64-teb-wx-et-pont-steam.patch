+/*
+ * Recopier l'environnement en memoire basse avant d'executer.
+ *
+ * Sur macOS arm64, execve rend EFAULT quand le tableau d'environnement se
+ * trouve tres haut dans l'espace d'adressage. Mesure : les appels dont
+ * « environ » etait vers 47 Gio echouaient, ceux dont il tenait sous 5 Gio
+ * reussissaient -- y compris avec un argv haut. Wine reservant de vastes
+ * plages basses, un realloc de putenv dans le fils de fork peut atterrir
+ * n'importe ou.
+ *
+ * On recopie donc le tableau et ses chaines dans une seule projection demandee
+ * en bas. En cas d'echec on rend l'environnement d'origine : mieux vaut
+ * retenter tel quel que ne rien faire.
+ */
+static char **env_bas(void)
+{
+    extern char **environ;
+    size_t taille = sizeof(char *), n = 0;
+    char *bloc, **tab;
+    unsigned int i;
 
+    if (!environ) return environ;
+    for (n = 0; environ[n]; n++) taille += sizeof(char *) + strlen( environ[n] ) + 1;
 
+    bloc = mmap( (void *)0x110000000, taille, PROT_READ | PROT_WRITE,
+                 MAP_PRIVATE | MAP_ANON, -1, 0 );
+    if (bloc == MAP_FAILED) return environ;
+
+    tab = (char **)bloc;
+    bloc += (n + 1) * sizeof(char *);
+    for (i = 0; i < n; i++)
+    {
+        size_t l = strlen( environ[i] ) + 1;
+        memcpy( bloc, environ[i], l );
+        tab[i] = bloc;
+        bloc += l;
+    }
+    tab[n] = NULL;
+    return tab;
+}
