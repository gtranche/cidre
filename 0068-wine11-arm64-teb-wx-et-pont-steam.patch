+static inline ULONG_PTR wow64_host_base(void)
+{
+    static ULONG_PTR base = (ULONG_PTR)-1;
+
+    if (base == (ULONG_PTR)-1) base = __wine_wow64_host_base();
+    return base;
+}
+
+/* Une adresse de 32 bits vue par l'invite, rendue dans le monde de l'hote. */
+static inline void *wow64_host_ptr( ULONG addr )
+{
+    return addr ? (void *)(wow64_host_base() + addr) : NULL;
+}
