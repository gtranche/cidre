+ * pointeur », pas l'adresse zero. */
+static inline void *ptr_32to64( ULONG addr )
+{
+    return addr ? (void *)(ULONG_PTR)(guest_base + addr) : NULL;
+}
+
+/*
+ * Et le retour. L'emulateur suit la memoire dans le monde de l'invite : ses
+ * intervalles de pages executables sont indexes par les adresses que l'invite
+ * voit, parce que c'est avec elles qu'il demande « ai-je le droit de traduire
+ * ici ». On lui rend donc les notifications dans ce monde-la.
+ *
+ * Mesure a l'appui : traduire l'autre frontiere -- la consultation des
+ * intervalles -- avait fait passer les exceptions de 259 a 1497.
+ *
+ * Tronquer suffit, la base etant un multiple de 4 Gio.
+ */
+static inline void *ptr_64to32( void *p )
+{
+    return (void *)(ULONG_PTR)PtrToUlong( p );
