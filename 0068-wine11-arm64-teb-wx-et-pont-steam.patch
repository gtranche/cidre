+/*
+ * L'invite 32 bits voit A la ou l'hote utilise base + A. winevulkan porte ses
+ * relais wow64 du cote unix, comme opengl32 : c'est donc ici qu'il faut
+ * traduire, et non dans wow64win.dll.
+ *
+ * On le fait en redefinissant UlongToPtr plutot qu'en reecrivant les 2137
+ * appels engendres, parce que dans ce module ils convertissent *tous* une
+ * adresse de l'invite -- y compris les poignees VkDevice, VkQueue et
+ * VkCommandBuffer, qui ne sont pas des entiers opaques mais des objets PE dont
+ * l'hote lit le champ unix_handle (voir vulkan_device_from_handle). La
+ * redefinition vient apres toutes les inclusions, et ne vaut que du cote unix.
+ *
+ * Hors wow64 la base vaut zero et tout ceci est l'identite.
+ */
+NTSYSAPI ULONG_PTR CDECL __wine_wow64_host_base(void);
+
+static inline ULONG_PTR vk_base_invite(void)
+{
+    static ULONG_PTR base = (ULONG_PTR)-1;
+
+    if (base == (ULONG_PTR)-1) base = __wine_wow64_host_base();
+    return base;
+}
+
+static inline void *vk_ptr_32to64( ULONG addr )
+{
+    return addr ? (void *)(vk_base_invite() + addr) : NULL;
+}
+
+#undef UlongToPtr
+#define UlongToPtr(a) vk_ptr_32to64( (ULONG)(ULONG_PTR)(a) )
+
+/*
+ * VkCommandPool n'est pas une poignee « dispatchable » : Vulkan la transporte
+ * comme un entier de 64 bits, meme en 32 bits, et elle ne passe donc par aucun
+ * UlongToPtr. Sa valeur est pourtant l'adresse d'un objet PE de l'invite, que
+ * l'hote deref erence -- il faut la rebaser a la main.
+ *
+ * Hors wow64 la base vaut zero et la poignee porte deja une adresse complete de
+ * 64 bits : la tronquer serait une faute, d'ou les deux chemins.
+ */
+static inline void *vk_client_ptr( UINT64 handle )
+{
+    ULONG_PTR base = vk_base_invite();
+
+    if (!handle) return NULL;
+    /* La base peut etre installee alors que l'appelant du moment est un invite
+     * 64 bits : ne rebaser que ce qui tient dans 32 bits, c'est-a-dire ce qui
+     * vient vraiment de la fenetre. */
+    if (base && !(handle >> 32)) return (void *)(base + (ULONG)handle);
+    return (void *)(UINT_PTR)handle;
+}
