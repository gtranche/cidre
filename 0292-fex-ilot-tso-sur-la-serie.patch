+int64_t FEX::Windows::SousPages::DecalageLecture(uint64_t Adresse, uint64_t Taille) {
+  const uint64_t Hote = Adresse & ~HostPageMask;
+  if (!Actif || !Taille || ((Adresse + Taille - 1) & ~HostPageMask) != Hote) {
+    return 0;
+  }
+  const uint32_t Gen = *Generation;
+  Etat E;
+  if (!LireCache(Hote, Gen, E)) {
+    Params P {};
+    P.Op = 1;
+    P.Hote = Hote;
+    if (Appel(&P)) {
+      return 0;
+    }
+    E = {P.Gen, P.Alias, P.Lecture, P.Ecriture, P.Mixte, P.Code};
+    EcrireCache(Hote, E);
+  }
+  // Lecture permise sans faute par chaque page de 4 Kio touchee (ni fermee, ni garde, ni execution seule).
+  const uint32_t Premiere = (Adresse >> 12) & 3, Derniere = ((Adresse + Taille - 1) >> 12) & 3;
+  const uint32_t Masque = ((2u << Derniere) - 1) & ~((1u << Premiere) - 1);
+  if (!E.Mixte || !E.Alias || (E.Lecture & Masque) != Masque) {
+    return 0;
+  }
+  return static_cast<int64_t>(E.Alias - Hote);
+}
