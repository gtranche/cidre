+      LogMan::Msg::IFmt("DUMP_INVITE t={:.1f} page {:#x} protection {:#x} etat {:#x}", S, Page, Info.Protect, Info.State);
+    }
+    for (uint64_t A = CidreDumpDebut & ~uint64_t {31}; A < CidreDumpDebut + CidreDumpTaille; A += 32) {
