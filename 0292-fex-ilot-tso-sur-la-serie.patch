+  // CIDRE_SMC_ARME : pages de 4 Kio de code dont Wine a arme le suivi d'ecriture sur les vues jumelles (autres vues de la
+  // meme section, meme decalage) par l'op 6. Une ecriture dans une jumelle armee leve CodeEcrit (FEX invalide la page et
+  // reprend l'ecriture) ; une ecriture du noyau (appel systeme), une nouvelle vue inscriptible ou une reprotection
+  // inscriptible font seulement monter le compteur de Wine, relu par VerifierSections.
+  constexpr uint32_t OpArmer = 6;
+  std::mutex ArmeesVerrou;
+  fextl::unordered_set<uint64_t> Armees;
