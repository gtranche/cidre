+bool Arm64JITCore::EmitMixedCheck(IR::OpSize AccessSize, bool Write, ARMEmitter::Register Base, IR::OrderedNodeWrapper Offset,
+                                  IR::MemOffsetType OffsetType, uint8_t OffsetScale, ARMEmitter::ForwardLabel* Miss) {
+  if (!CTX->GuestMixedSite || FEXCore::IR::Guest64LowBase || !CidreGuestRIP) {
+    return false;
+  }
+  if (CTX->GuestMixedPrewrite) {
+    // P : pas de controle en ligne ; l'acces d'origine d'un RIP connu sera reecrit vers son talon apres compilation.
+    if (CTX->GuestMixedSite(CidreGuestRIP)) {
+      CidrePreDebut = GetCursorAddress<uint8_t*>();
+    }
+    return false;
+  }
+  const uint64_t Size = IR::OpSizeToSize(AccessSize);
+  if (Size == 0 || Size > 8) {
+    return false;
+  }
+  // Forme de l'adresse : base seule, base + immediat (moins de 4 Kio), base + registre etendu.
+  uint64_t Const = 0;
+  bool AvecRegistre = false;
+  if (!Offset.IsInvalid()) {
+    if (IsInlineConstant(Offset, &Const)) {
+      if (static_cast<int64_t>(Const) >= 4096 || static_cast<int64_t>(Const) <= -4096) {
+        return false;
+      }
+    } else {
+      if (OffsetType != IR::MemOffsetType::SXTX && OffsetType != IR::MemOffsetType::UXTW && OffsetType != IR::MemOffsetType::SXTW) {
+        return false;
+      }
+      AvecRegistre = true;
+    }
+  }
+  void* Site = CTX->GuestMixedSite(CidreGuestRIP);
+  if (!Site) {
+    return false;
+  }
+  CidreSite = Site;
+  CidreDebut = GetCursorAddress<uint8_t*>();
+
+  // TMP1 = adresse effective
+  if (AvecRegistre) {
+    const auto RegOffset = GetReg(Offset);
+    const auto Ext = OffsetType == IR::MemOffsetType::SXTX ? ARMEmitter::ExtendedType::SXTX :
+                     OffsetType == IR::MemOffsetType::UXTW ? ARMEmitter::ExtendedType::UXTW :
+                                                             ARMEmitter::ExtendedType::SXTW;
+    add(ARMEmitter::Size::i64Bit, TMP1, Base.X(), RegOffset.X(), Ext, FEXCore::ilog2(OffsetScale));
+  } else if (static_cast<int64_t>(Const) < 0) {
+    sub(ARMEmitter::Size::i64Bit, TMP1, Base.X(), -static_cast<int64_t>(Const));
+  } else {
+    add(ARMEmitter::Size::i64Bit, TMP1, Base.X(), Const);
+  }
+  // Entree du site (litteral pose par EmitMixedTail) : cle (page d'hote, generation), decalage et masques ;
+  // generation courante de Wine.
+  ldr(TMP2, &CidreLitteral);
+  if (*reinterpret_cast<const uint64_t*>(static_cast<const uint8_t*>(Site) + 40)) {
+    // Generation de la case de la page lue : table de Wine, case (adresse >> 14) modulo 4096.
+    ldr(TMP3, TMP2, 16);
+    ubfx(ARMEmitter::Size::i64Bit, TMP4, TMP1, 14, 12);
+    ldr(TMP3.W(), ARMEmitter::ExtendedMemOperand(TMP3, TMP4, ARMEmitter::ExtendedType::LSL_64, 2));
+    ldp<ARMEmitter::IndexType::OFFSET>(TMP2, TMP4, TMP2, 0);
+    eor(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP1, ARMEmitter::ShiftType::LSR, 14);
+    eor(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP3, ARMEmitter::ShiftType::LSL, 34);
+    (void)cbnz(ARMEmitter::Size::i64Bit, TMP2, Miss);
+  } else {
+    ldp<ARMEmitter::IndexType::OFFSET>(TMP3, TMP4, TMP2, 0);
+    ldr(TMP2, TMP2, 16);
+    ldr(TMP2.W(), TMP2, 0);
+    eor(ARMEmitter::Size::i64Bit, TMP3, TMP3, TMP1, ARMEmitter::ShiftType::LSR, 14);
+    eor(ARMEmitter::Size::i64Bit, TMP3, TMP3, TMP2, ARMEmitter::ShiftType::LSL, 34);
+    (void)cbnz(ARMEmitter::Size::i64Bit, TMP3, Miss);
+  }
+  // Tout l'acces dans une meme page de 4 Kio (donc une seule sous-page, et une seule page d'hote).
+  if (Size > 1) {
+    add(ARMEmitter::Size::i64Bit, TMP2, TMP1, Size - 1);
+    eor(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP1);
+    lsr(ARMEmitter::Size::i64Bit, TMP2, TMP2, 12);
+    (void)cbnz(ARMEmitter::Size::i64Bit, TMP2, Miss);
+  }
+  ubfx(ARMEmitter::Size::i64Bit, TMP3, TMP1, 12, 2);
+  lsrv(ARMEmitter::Size::i64Bit, TMP3, TMP4, TMP3);
+  (void)tbz(TMP3, Write ? 4 : 0, Miss);
+  and_(ARMEmitter::Size::i64Bit, TMP4, TMP4, ~uint64_t {0xff});
+  add(ARMEmitter::Size::i64Bit, TMP1, TMP1, TMP4);
+  return true;
+}
