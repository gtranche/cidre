+void* FEX::Windows::SousPages::SiteEnLigne(uint64_t GuestRIP) {
+  if (!Actif) {
+    return nullptr;
+  }
+  // Oubli : un RIP dont l'entree n'a pas ete remplie depuis plus d'une seconde ne voit plus de page mixte ; son
+  // acces redevient natif (comme un talon remis apres 256 acces hors page mixte). S'il refait faute sur une page
+  // mixte, le talon le reinscrit. La fenetre d'une seconde evite d'oublier au milieu d'une meme compilation, qui
+  // interroge plusieurs fois le meme RIP.
+  EntreeEnLigne* E = nullptr;
+  bool Oubli = false;
+  {
+    std::scoped_lock Lock(EnLigneVerrou);
+    auto It = EnLigneParRip.find(GuestRIP);
+    if (It != EnLigneParRip.end()) {
+      E = It->second;
+      const uint32_t R = std::atomic_ref<uint32_t>(E->Remplissages).load(std::memory_order_relaxed);
+      const uint64_t Maintenant = Millisecondes();
+      if (R != E->Vus) {
+        E->Vus = R;
+        E->Instant = Maintenant;
+      } else if (Maintenant - E->Instant > 1000) {
+        // Pas de remplissage recent : soit l'entree reste valide (generation par page inchangee, le cas courant
+        // avec la table), soit le site ne voit plus de page mixte. On tranche sur la page retenue par l'entree.
+        if (PageEncoreMixte(std::atomic_ref<uint64_t>(E->Cle).load(std::memory_order_relaxed))) {
+          E->Instant = Maintenant;
+        } else {
+          EnLigneParRip.erase(It); // l'entree reste allouee : du code deja emis la lit encore
+          E = nullptr;
+          Oubli = true;
+        }
+      }
+    }
+  }
+  if (Diag) {
+    if (Oubli) {
+      Compter(NbOublis, "R2 : RIP oublie");
+    } else if (E) {
+      Compter(NbEnLigneEmis, "R2 : acces emis en ligne");
+    }
+  }
+  return E;
+}
