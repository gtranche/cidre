+  // mixte...) et instant du refus (ms) : l'op 6 parcourt toutes les vues, la redemander a chaque compilation ralentit
+  // tout (demarrage de D2R). Redemande au plus une fois par RefusMs.
+  fextl::unordered_map<uint64_t, uint64_t> Refusees;
+  constexpr uint64_t RefusMs = 200;
+  uint64_t Desarmements {}; // sous ArmeesVerrou : une page desarmee pendant l'appel a Wine n'est pas inscrite
+  const volatile uint32_t* GenSections {};
+  uint32_t GenSectionsVue {}; // sous ArmeesVerrou : compteur de Wine au dernier traitement
+  std::atomic<uint64_t> NbRefusRaison[7];
+  std::atomic<uint64_t> NbArmees, NbArmementsRefuses, NbEcritsArmes, NbGenSections, NbRefusCompteur, NbRefusCourse, NbDejaArmees;
