+
+bool FEX::Windows::SousPages::CodeArme(uint64_t Adresse, uint64_t Taille) {
+  if (!Actif || !Taille) {
+    return false;
+  }
+  for (uint64_t Page = Adresse & ~uint64_t {0xfff}; Page < Adresse + Taille; Page += 0x1000) {
+    uint64_t Avant;
+    {
+      std::scoped_lock Lock(ArmeesVerrou);
+      // Compteur de Wine change et pas encore traite (VerifierSections) : des pages ont pu etre ecrites sans
+      // exception ; ne rien armer de plus d'ici la.
+      if (GenSections && *GenSections != GenSectionsVue) {
+        Compter(NbRefusCompteur, "SMC arme : refus, compteur des sections change (pas encore traite)");
+        return false;
+      }
+      if (Armees.contains(Page)) {
+        Compter(NbDejaArmees, "SMC arme : page deja armee");
+        continue;
+      }
+      if (const auto It = Refusees.find(Page); It != Refusees.end() && Millisecondes() - It->second < RefusMs) {
+        return false; // refus recent : garder la validation sans redemander
+      }
+      Avant = Desarmements;
+    }
+    Params P {};
+    P.Op = OpArmer;
+    P.Hote = Page;
+    P.Alias = 0x1000;
+    if (Appel(&P) || P.Code != 1) {
+      Compter(NbArmementsRefuses, "SMC arme : armement refuse");
+      // Raison rendue par Wine dans Mixte (jumelles 4) : 1 hors vue de section, 2 aucune ou plusieurs vues executables,
+      // 3 vue inscriptible JIT ou systeme, 4 page d'hote mixte cote RW, 5 delai apres une ecriture, 6 table pleine.
+      static constexpr const char* Raisons[7] = {"SMC arme : refus, raison inconnue", "SMC arme : refus, hors vue de section",
+                                                 "SMC arme : refus, aucune ou plusieurs vues executables",
+                                                 "SMC arme : refus, vue inscriptible JIT ou systeme", "SMC arme : refus, page d'hote mixte cote RW",
+                                                 "SMC arme : refus, delai apres une ecriture", "SMC arme : refus, table pleine"};
+      const uint32_t R = P.Mixte < 7 ? P.Mixte : 0;
+      Compter(NbRefusRaison[R], Raisons[R]);
+      std::scoped_lock Lock(ArmeesVerrou);
+      if (Refusees.size() > 65536) {
+        Refusees.clear();
+      }
+      Refusees[Page] = Millisecondes();
+      return false;
+    }
+    std::scoped_lock Lock(ArmeesVerrou);
+    if (!GenSections && P.GenPtr) {
+      GenSections = reinterpret_cast<const volatile uint32_t*>(P.GenPtr);
+      GenSectionsVue = P.Gen;
+    }
+    if (Desarmements != Avant || (GenSections && *GenSections != GenSectionsVue)) {
+      Compter(NbRefusCourse, "SMC arme : refus, desarmement ou compteur pendant l'appel a Wine");
+      return false; // une ecriture ou une projection a pu desarmer la page entre-temps : garder la validation
+    }
+    Armees.insert(Page);
+    Refusees.erase(Page);
+    Compter(NbArmees, "SMC arme : page armee");
+  }
+  return true;
 }
 
+void FEX::Windows::SousPages::Desarmer(uint64_t Adresse, uint64_t Taille) {
+  std::scoped_lock Lock(ArmeesVerrou);
+  ++Desarmements;
+  if (Armees.empty()) {
+    return;
+  }
+  const uint64_t Debut = Adresse & ~uint64_t {0xfff}, Fin = Adresse + Taille;
+  if ((Fin - Debut) / 0x1000 <= 64) {
+    for (uint64_t Page = Debut; Page < Fin; Page += 0x1000) {
+      Armees.erase(Page);
+    }
+  } else {
+    std::erase_if(Armees, [&](uint64_t Page) { return Page >= Debut && Page < Fin; });
+  }
+}
+
+fextl::vector<uint64_t> FEX::Windows::SousPages::VerifierSections() {
+  fextl::vector<uint64_t> Pages;
+  std::scoped_lock Lock(ArmeesVerrou);
+  if (!GenSections || *GenSections == GenSectionsVue) {
+    return Pages;
+  }
+  // Une jumelle a pu etre ecrite sans exception (ou n'est plus suivie) : toutes les pages armees perdent leur traduction
+  // sans validation et seront rearmees a la prochaine compilation.
+  GenSectionsVue = *GenSections;
+  ++Desarmements;
+  Pages.assign(Armees.begin(), Armees.end());
+  Armees.clear();
+  Compter(NbGenSections, "SMC arme : compteur des sections change, pages desarmees");
+  return Pages;
+}
+
+fextl::vector<uint64_t> FEX::Windows::SousPages::ToutDesarmer() {
+  std::scoped_lock Lock(ArmeesVerrou);
+  ++Desarmements;
+  fextl::vector<uint64_t> Pages(Armees.begin(), Armees.end());
+  Armees.clear();
+  return Pages;
+}
+
+fextl::vector<uint64_t> FEX::Windows::SousPages::CodeEcrit(const EXCEPTION_RECORD* Rec) {
+  fextl::vector<uint64_t> Pages;
+  Compter(NbEcritsArmes, "SMC arme : ecriture dans une jumelle armee");
+  const uint64_t Rx = Rec->NumberParameters > 2 ? Rec->ExceptionInformation[2] : 0;
+  std::scoped_lock Lock(ArmeesVerrou);
+  ++Desarmements;
+  if (Rx) {
+    // [3] : taille du bloc desarme (une page d'hote, 0x4000), sinon une page.
+    const uint64_t Taille = Rec->NumberParameters > 3 && Rec->ExceptionInformation[3] ? Rec->ExceptionInformation[3] : 0x1000;
+    for (uint64_t Page = Rx & ~uint64_t {0xfff}; Page < Rx + Taille; Page += 0x1000) {
+      Pages.push_back(Page);
+      Armees.erase(Page);
+    }
+  } else {
+    Pages.assign(Armees.begin(), Armees.end());
+    Armees.clear();
+  }
+  return Pages;
+}
