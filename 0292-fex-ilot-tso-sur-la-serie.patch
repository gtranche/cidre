+// Cidre, armement groupe (actif par defaut ; CIDRE_ARME_GROUPE=0 : un GuestCodeArmed par instruction, comme avant) :
+// GenerateIR arme d'un coup la fin de la page de 4 Kio de l'instruction ([InstAddress, fin de page)), puis relit et compare
+// les octets de chaque instruction de cet intervalle sans rappeler Wine. Exact : chaque instruction est relue APRES
+// l'armement qui la couvre (une ecriture entre les deux leve une CodeEcrit, qui invalide le bloc des que la compilation
+// rend le verrou) ; armer plus d'octets que le code n'ajoute que des fautes d'ecriture sur la meme page, deja suivie a
+// 16 Kio cote hote. Echec de l'armement large (page a cheval sur deux vues...) : repli sur l'instruction seule.
+bool CidreArmeGroupe() {
+  static const bool G = [] {
+    const char* E = getenv("CIDRE_ARME_GROUPE");
+    return !(E && E[0] == '0');
+  }();
+  return G;
+}
+// Cidre (CIDRE_COMPIL_RAPIDE=1) : compilation a deux niveaux, phase A. La PREMIERE compilation d'un RIP est de premier
+// niveau : sans les passes d'optimisation facultatives (X87StackOptimization, DeadFlagCalculationEliminination ; le
+// RA reste) et, si CIDRE_COMPIL_RAPIDE_MAXINST=n, avec au plus n instructions (multibloc garde : les boucles courtes
+// restent dans le bloc). Toute compilation suivante au meme RIP (apres une invalidation, une reecriture) est optimisee :
+// le code reecrit souvent se promeut de lui-meme. Le code stable garde sa version rapide (phase B : compteur d'entrees
+// dans le prologue, si la phase A paie). Table des RIP deja compiles sans verrou, insertion seule, 1 Mi entrees ;
+// pleine, la compilation est optimisee.
+bool CidreCompilRapide() {
+  static const bool R = [] {
+    const char* E = getenv("CIDRE_COMPIL_RAPIDE");
+    return E && E[0] == '1';
+  }();
+  return R;
+}
+uint64_t CidreCompilRapideMaxInst() {
+  static const uint64_t N = [] {
+    const char* E = getenv("CIDRE_COMPIL_RAPIDE_MAXINST");
+    return E ? strtoull(E, nullptr, 10) : 0ULL;
+  }();
+  return N;
+}
+struct CidreRipsCompiles {
+  static constexpr size_t NB = size_t {1} << 20;
+  std::atomic<uint64_t>* T = nullptr;
+  // vrai si Rip n'avait jamais ete compile (et le note) ; faux s'il l'a ete, ou si la table est pleine ou absente
+  bool Premiere(uint64_t Rip) {
+    if (!T) {
+      return false;
+    }
+    const uint64_t Cle = Rip + 1;
+    for (size_t i = 0, h = (Cle * 0x9E3779B97F4A7C15ULL) >> 44; i < 64; i++, h = (h + 1) & (NB - 1)) {
+      uint64_t c = T[h].load(std::memory_order_relaxed);
+      if (c == Cle) {
+        return false;
+      }
+      if (!c && T[h].compare_exchange_strong(c, Cle, std::memory_order_relaxed)) {
+        return true;
+      }
+      if (c == Cle) {
+        return false;
+      }
+    }
+    return false;
+  }
+};
+CidreRipsCompiles* CidreRips() {
+  static CidreRipsCompiles* R = [] {
+    if (!CidreCompilRapide()) {
+      return static_cast<CidreRipsCompiles*>(nullptr);
+    }
+    auto* N = new CidreRipsCompiles;
+    N->T = static_cast<std::atomic<uint64_t>*>(FEXCore::Allocator::VirtualAlloc(CidreRipsCompiles::NB * sizeof(uint64_t)));
+    if (!N->T || N->T == reinterpret_cast<std::atomic<uint64_t>*>(-1)) {
+      N->T = nullptr;
+      LogMan::Msg::IFmt("cidre compil : table des RIP non allouee, compilation rapide coupee");
+    } else {
+      LogMan::Msg::IFmt("cidre compil : compilation rapide (premier niveau) active, MaxInst {}", CidreCompilRapideMaxInst());
+    }
+    return N;
+  }();
+  return R;
+}
+
+// Cidre (CIDRE_ARME_MAXINST=n, 0 ou absent : coupe) : les blocs dont l'entree est sur une page deja armee (vue par
+// GuestCodeArmed) sont compiles avec au plus n instructions et sans multibloc : plus petits, plus vite compiles, invalides
+// plus finement. Table des pages armees sans verrou (insertion seule ; une page reste « armee » une fois vue).
+uint64_t CidreArmeMaxInst() {
+  static const uint64_t N = [] {
+    const char* E = getenv("CIDRE_ARME_MAXINST");
+    return E ? strtoull(E, nullptr, 10) : 0ULL;
+  }();
+  return N;
+}
+struct CidrePagesArmees {
+  static constexpr size_t NB = size_t {1} << 16;
+  std::atomic<uint64_t> T[NB] {};
+  static uint64_t H(uint64_t p) {
+    p *= 0x9E3779B97F4A7C15ULL;
+    return p >> 48;
+  }
+  void Ajouter(uint64_t Page) {
+    const uint64_t P = Page + 1;
+    for (size_t i = 0, h = H(P); i < 32; i++, h = (h + 1) & (NB - 1)) {
+      uint64_t c = T[h].load(std::memory_order_relaxed);
+      if (c == P) return;
+      if (!c && T[h].compare_exchange_strong(c, P, std::memory_order_relaxed)) return;
+      if (c == P) return;
+    }
+  }
+  bool Contient(uint64_t Page) const {
+    const uint64_t P = Page + 1;
+    for (size_t i = 0, h = H(P); i < 32; i++, h = (h + 1) & (NB - 1)) {
+      uint64_t c = T[h].load(std::memory_order_relaxed);
+      if (c == P) return true;
+      if (!c) return false;
+    }
+    return false;
+  }
+};
+CidrePagesArmees CidrePages;
+
+// Cidre (CIDRE_CACHE_BLOCS=1) : cache du code compile par bloc invite. Une invalidation (CodeEcrit, jumelle armee) retire
+// le bloc du LookupCache sans liberer son code hote ; si le jeu remet les memes octets, on le reinstalle au lieu de le
+// recompiler. Exactitude :
+//  - les octets x64 de chaque instruction sont gardes et compares octet par octet (memcmp, jamais une seule empreinte),
+//    relus par le Decoder (intervalle executable et alias redemandes : une page liberee ou fermee refuse le candidat) ;
+//  - les instructions compilees sans validation (CodeArme) sont rearmees, puis relues et recomparees, comme GenerateIR ;
+//    un rearmement refuse rejette le candidat (la compilation normale suit) ;
+//  - meme carte partagee (GuestToHostMap, donc meme tampon de code) et meme generation (aucun ClearCodeCache depuis) ;
+//    sinon le code hote ou ses liens ne sont plus suivis ;
+//  - reinstallation comme le cache disque : pages de code (AddBlockExecutableRange, MarkGuestExecutableRange), sites
+//    d'acces des pages mixtes (GuestMixedPrewrite), puis points d'entree (AddBlockMapping). Les liens entrants ont ete
+//    coupes par Erase a l'invalidation et se refont a la demande ; les sortants sont restes suivis par leurs delieurs.
+//  - tout se fait sous CodeInvalidationMutex partage (CompileBlock) : aucune invalidation ne s'intercale.
+// Borne : anneau de NB_ENTREES blocs (plus ancien remplace), au plus 4 par RIP, au plus 1024 instructions par bloc.
+struct CidreBloc {
+  uint64_t Rip {}, MaxInst {}, Generation {};
+  bool TF {};
+  void* Carte {};
+  fextl::vector<std::pair<uint64_t, uint8_t*>> Entrees;
+  fextl::vector<uint64_t> Pages, PointsEntree;
+  fextl::vector<std::pair<uint64_t, uint64_t>> PreSites;
+  fextl::vector<FEXCore::Frontend::Decoder::CidreSegment> Segments;
+};
+struct CidreCacheBlocs {
+  static constexpr size_t NB_ENTREES = 16384;
+  std::mutex Mutex;
+  fextl::vector<CidreBloc> Anneau;
+  size_t Tete = 0;
+  fextl::unordered_map<uint64_t, fextl::vector<uint32_t>> ParRip;
+
+  CidreCacheBlocs() {
+    Anneau.resize(NB_ENTREES);
+  }
+  void Garder(CidreBloc&& B) {
+    std::scoped_lock lk(Mutex);
+    auto& V = ParRip[B.Rip];
+    // un bloc identique deja garde est remplace sur place
+    for (auto i : V) {
+      auto& A = Anneau[i];
+      if (A.Carte == B.Carte && A.MaxInst == B.MaxInst && A.TF == B.TF && A.Segments.size() == B.Segments.size() &&
+          std::equal(A.Segments.begin(), A.Segments.end(), B.Segments.begin(), [](const auto& x, const auto& y) {
+            return x.Adresse == y.Adresse && x.Taille == y.Taille && !memcmp(x.Octets, y.Octets, x.Taille);
+          })) {
+        A = std::move(B);
+        return;
+      }
+    }
+    if (V.size() >= 4) {
+      // le plus ancien de ce RIP laisse sa place
+      Anneau[V.front()] = CidreBloc {};
+      V.erase(V.begin());
+    }
+    const uint32_t i = Tete;
+    Tete = (Tete + 1) % NB_ENTREES;
+    if (Anneau[i].Rip) {
+      auto it = ParRip.find(Anneau[i].Rip);
+      if (it != ParRip.end()) {
+        std::erase(it->second, i);
+        if (it->second.empty()) {
+          ParRip.erase(it);
+        }
+      }
+    }
+    Anneau[i] = std::move(B);
+    ParRip[Anneau[i].Rip].push_back(i);
+  }
+  // copies des candidats de ce RIP, du plus recent au plus ancien (verifies hors verrou)
+  fextl::vector<CidreBloc> Candidats(uint64_t Rip) {
+    fextl::vector<CidreBloc> R;
+    std::scoped_lock lk(Mutex);
+    auto it = ParRip.find(Rip);
+    if (it != ParRip.end()) {
+      for (auto k = it->second.rbegin(); k != it->second.rend(); ++k) {
+        R.push_back(Anneau[*k]);
+      }
+    }
+    return R;
+  }
+};
+CidreCacheBlocs* CidreCache() {
+  static CidreCacheBlocs* C = [] {
+    const char* E = getenv("CIDRE_CACHE_BLOCS");
+    if (!E || E[0] != '1') {
+      return static_cast<CidreCacheBlocs*>(nullptr);
+    }
+    LogMan::Msg::IFmt("cidre compil : cache de blocs actif ({} blocs au plus)", CidreCacheBlocs::NB_ENTREES);
+    return new CidreCacheBlocs;
+  }();
+  return C;
+}
