+// Cidre, diag (CIDRE_COMPTE_RDTSC=1) : toutes les 5 s, une ligne par fil qui a execute des RDTSC depuis la releve
+// precedente : « COMPTE_RDTSC t=<s depuis le debut> fil <tid Windows> n <nombre> » (format de SONDE_HORLOGE).
+static NTSTATUS WINAPI CidreReleveRdtsc(void*) {
+  LARGE_INTEGER F, T0, T;
+  NtQueryPerformanceCounter(&T0, &F);
+  fextl::unordered_map<DWORD, uint64_t> Avant;
+  LARGE_INTEGER Delai;
+  Delai.QuadPart = -50000000LL; // 5 s
+  for (;;) {
+    NtDelayExecution(FALSE, &Delai);
+    NtQueryPerformanceCounter(&T, nullptr);
+    const double S = static_cast<double>(T.QuadPart - T0.QuadPart) / static_cast<double>(F.QuadPart);
+    std::scoped_lock Lock(ThreadCreationMutex);
+    for (const auto& [Tid, Thread] : Threads) {
+      const uint64_t N = std::atomic_ref<uint64_t>(Thread->CurrentFrame->CidreRdtsc).load(std::memory_order_relaxed);
+      auto& A = Avant[Tid];
+      if (N != A) {
+        LogMan::Msg::IFmt("COMPTE_RDTSC t={:.1f} fil {:x} n {}", S, Tid, N - A);
+        A = N;
+      }
+    }
+  }
+  return 0;
+}
+
+// Cidre, diag (CIDRE_DUMP_INVITE=<adresse>:<octets>) : toutes les 20 s (6 fois), les octets invites de la plage, en
+// hexa au journal (« DUMP_INVITE t=<s> <adresse> : <32 octets> »), avec la protection de chaque page de 4 Kio. Lus par
+// l'alias de Wine si la page d'hote est mixte et la page lisible, sinon par NtReadVirtualMemory (une page fermee est
+// signalee, sans faute). Pour desassembler hors ligne le code dechiffre d'une protection logicielle (D2R).
+// CIDRE_SMC_ARME=1 (voir ProcessInit, CidreVerifierSections).
+static bool CidreSmcArme {};
+static uint64_t CidreDumpDebut, CidreDumpTaille;
+static NTSTATUS WINAPI CidreDumpInvite(void*) {
+  LARGE_INTEGER F, T0, T;
+  NtQueryPerformanceCounter(&T0, &F);
+  LARGE_INTEGER Delai;
+  Delai.QuadPart = -200000000LL; // 20 s
+  for (int Tour = 0; Tour < 6; ++Tour) {
+    NtDelayExecution(FALSE, &Delai);
+    NtQueryPerformanceCounter(&T, nullptr);
+    const double S = static_cast<double>(T.QuadPart - T0.QuadPart) / static_cast<double>(F.QuadPart);
