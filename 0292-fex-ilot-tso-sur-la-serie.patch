+namespace {
+  // La page d'hote retenue par une cle d'entree en ligne est-elle encore mixte (avec un alias) ? Cache des pages,
+  // requete a Wine sinon. Cle vide : non.
+  bool PageEncoreMixte(uint64_t Cle) {
+    const uint64_t Hote = (Cle & ((uint64_t {1} << 34) - 1)) << 14;
+    if (!Hote) {
+      return false;
+    }
+    Etat E;
+    if (!LireCache(Hote, *Generation, E)) {
+      Params P {};
+      P.Op = 1;
+      P.Hote = Hote;
+      if (Appel(&P)) {
+        return false;
+      }
+      E = {P.Gen, P.Alias, P.Lecture, P.Ecriture, P.Mixte, P.Code};
+      EcrireCache(Hote, E);
+    }
+    return E.Mixte && E.Alias;
+  }
