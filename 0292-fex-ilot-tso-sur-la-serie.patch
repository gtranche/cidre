+}
 
+// Cidre : compteurs de FEX pour la chronologie de l'ilot (FEXCore/Utils/CidreCompteurs.h). L'ilot sert
+// NtQueryVirtualMemory(classe 0xc1d1, adresse = les compteurs) dans la boucle du vCPU et rend STATUS_SUCCESS ; hors ilot,
+// Wine refuse la classe (STATUS_INVALID_INFO_CLASS).
+static uint32_t CidreTidCourant() {
+  return GetCurrentThreadId();
+}
+static bool CidreAnnoncerCompteurs() {
+  static std::atomic<uint32_t> Essais {0};
+  if (FEXCore::CidreCompteurs::Annonce.load(std::memory_order_relaxed) || Essais.fetch_add(1, std::memory_order_relaxed) >= 128) {
+    return FEXCore::CidreCompteurs::Annonce.load(std::memory_order_relaxed);
+  }
+  uint64_t Freq;
+  __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(Freq));
+  FEXCore::CidreCompteurs::Partages.Freq = Freq;
+  SIZE_T Rendu = 0;
+  const NTSTATUS St = NtQueryVirtualMemory(NtCurrentProcess(), &FEXCore::CidreCompteurs::Partages, static_cast<MEMORY_INFORMATION_CLASS>(0xc1d1),
+                                           &FEXCore::CidreCompteurs::Partages, sizeof(FEXCore::CidreCompteurs::Partages), &Rendu);
+  if (St == STATUS_SUCCESS) {
+    FEXCore::CidreCompteurs::Annonce.store(true, std::memory_order_relaxed);
+    return true;
+  }
+  return false;
+}
