+void Arm64JITCore::EmitMixedTail(ARMEmitter::ForwardLabel* Fin, ARMEmitter::ForwardLabel* Miss) {
+  (void)b(Fin);
+  if (CidreSite) {
+    (void)Bind(&CidreLitteral);
+    dc64(reinterpret_cast<uint64_t>(CidreSite));
+  }
+  (void)Bind(Miss);
+  CidreLitteral = {};
+  CidreOctetsEnLigne += GetCursorAddress<uint8_t*>() - CidreDebut;
+}
