+// SPDX-License-Identifier: MIT
+#pragma once
+// Cidre, compteurs de FEX pour la chronologie de l'ilot (CIDRE_ILOT_CHRONO) : JIT (blocs compiles, temps, par fil),
+// invalidations de code par origine, blocs jetes, vidages complets. Toujours comptes (atomiques relaxes, une lecture de
+// CNTVCT par evenement deja faite par la mesure existante) ; FEX ne les imprime jamais. L'ilot (Wine,
+// dlls/ntdll/unix/ilot.c, struct cidre_fex_cpt) les lit depuis l'hote : FEX lui en donne l'adresse par
+// NtQueryVirtualMemory(classe 0xc1d1), servi dans la boucle du vCPU ; hors ilot, Wine refuse la classe
+// (STATUS_INVALID_INFO_CLASS) et rien d'autre ne se passe. Disposition figee (version 1) : seulement des uint64_t.
+#include <atomic>
+#include <cstdint>
+
+namespace FEXCore::CidreCompteurs {
+enum Source : uint32_t {
+  SRC_PROTECT = 0, // HandleMemoryProtectionNotification (alloc, protect, map) et toute origine non marquee
+  SRC_FREE = 1,    // NotifyMemoryFree
+  SRC_UNMAP = 2,   // NotifyUnmapViewOfSection
+  SRC_FLUSH = 3,   // FlushInstructionCache(Heavy)
+  SRC_DIRTY = 4,   // NotifyMemoryDirty
+  SRC_JUMELLES = 5, // CIDRE_SMC_ARME : jumelles ecrites (CidreInvaliderPages)
+  SRC_SMC = 6,     // faute d'ecriture sur page RWX piegee (HandleRWXAccessViolation)
+  SRC_JIT = 7,     // InvalidateGuestCodeRange (depuis le JIT : ThreadRemoveCodeEntryFromJit...)
+  NB_SOURCES = 8,
+};
+constexpr uint64_t MAGIE = 0x31545043584546ULL; // "FEXCPT1"
+constexpr uint32_t NB_FILS = 32;
+
+struct Fil {
+  std::atomic<uint64_t> Tid;
+  std::atomic<uint64_t> Blocs;
+  std::atomic<uint64_t> Ticks;
+};
+
+struct Compteurs {
+  uint64_t Magie;
+  uint64_t VersionTaille; // version << 32 | taille
+  uint64_t Freq;          // CNTFRQ
+  std::atomic<uint64_t> Blocs, TicksCompil, MaxTicksCompil; // MaxTicksCompil : remis a 0 par l'ilot (echange)
+  std::atomic<uint64_t> InvalNb[NB_SOURCES], InvalOctets[NB_SOURCES];
+  std::atomic<uint64_t> InvalTicks;  // attente + tenue de CodeInvalidationMutex
+  std::atomic<uint64_t> BlocsJetes;  // blocs retires des LookupCache partages par une invalidation
+  std::atomic<uint64_t> Vidages, TicksVidages; // ClearCodeCache
+  std::atomic<uint64_t> CallRetVidages;        // piles call/ret videes (VirtualDontNeed) par une invalidation
+  std::atomic<uint64_t> FilsPleins;            // compilations d'un fil hors table
+  Fil Fils[NB_FILS];
+};
+static_assert(sizeof(std::atomic<uint64_t>) == 8);
+static_assert(sizeof(Compteurs) == (3 + 3 + 2 * NB_SOURCES + 6 + 3 * NB_FILS) * 8);
+
+alignas(64) inline Compteurs Partages {MAGIE, (uint64_t {1} << 32) | sizeof(Compteurs), 0};
+
+// Fixes par le module Windows (ARM64EC/Module.cpp) : identifiant du fil courant, annonce a l'ilot (rend true une fois
+// acceptee). Nuls ailleurs (aucun compte par fil, aucune annonce).
+inline uint32_t (*TidCourant)() = nullptr;
+inline bool (*Annoncer)() = nullptr;
+inline std::atomic<bool> Annonce {false};
+
+inline void NoterCompil(uint64_t Ticks) {
+  const uint64_t N = Partages.Blocs.fetch_add(1, std::memory_order_relaxed);
+  Partages.TicksCompil.fetch_add(Ticks, std::memory_order_relaxed);
+  uint64_t M = Partages.MaxTicksCompil.load(std::memory_order_relaxed);
+  while (Ticks > M && !Partages.MaxTicksCompil.compare_exchange_weak(M, Ticks, std::memory_order_relaxed)) {
+  }
+  if (TidCourant) {
+    const uint64_t T = TidCourant();
+    uint32_t H = static_cast<uint32_t>((T * 0x9E3779B97F4A7C15ULL) >> 59) % NB_FILS;
+    bool Pris = false;
+    for (uint32_t I = 0; I < NB_FILS; I++, H = (H + 1) % NB_FILS) {
+      uint64_t C = Partages.Fils[H].Tid.load(std::memory_order_relaxed);
+      if (C == T || (C == 0 && Partages.Fils[H].Tid.compare_exchange_strong(C, T, std::memory_order_relaxed)) || C == T) {
+        Partages.Fils[H].Blocs.fetch_add(1, std::memory_order_relaxed);
+        Partages.Fils[H].Ticks.fetch_add(Ticks, std::memory_order_relaxed);
+        Pris = true;
+        break;
+      }
+    }
+    if (!Pris) {
+      Partages.FilsPleins.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  // Annonce paresseuse : le premier fil peut compiler avant d'entrer dans l'ilot ; un essai toutes les 256 compilations,
+  // 64 au plus (hors ilot : 64 refus de Wine, puis plus rien)
+  if (Annoncer && !Annonce.load(std::memory_order_relaxed) && (N & 255) == 0 && N < 256 * 64) {
+    if (Annoncer()) {
+      Annonce.store(true, std::memory_order_relaxed);
+    }
+  }
+}
+
+inline void NoterInval(uint32_t Src, uint64_t Octets, uint64_t Ticks) {
+  Src = Src < NB_SOURCES ? Src : SRC_PROTECT;
+  Partages.InvalNb[Src].fetch_add(1, std::memory_order_relaxed);
+  Partages.InvalOctets[Src].fetch_add(Octets, std::memory_order_relaxed);
+  Partages.InvalTicks.fetch_add(Ticks, std::memory_order_relaxed);
+}
+} // namespace FEXCore::CidreCompteurs
