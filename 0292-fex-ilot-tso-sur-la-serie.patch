+  bool AvecRegistre = false;
+  if (!Offset.IsInvalid()) {
+    if (IsInlineConstant(Offset, &Const)) {
+      if (static_cast<int64_t>(Const) >= 4096 || static_cast<int64_t>(Const) <= -4096) {
+        return false;
+      }
+    } else {
+      if (OffsetType != IR::MemOffsetType::SXTX && OffsetType != IR::MemOffsetType::UXTW && OffsetType != IR::MemOffsetType::SXTW) {
+        return false;
+      }
+      AvecRegistre = true;
+    }
+  }
+  // La page de 4 Kio de l'instruction, lisible, sur une page d'hote mixte : sa lisibilite et son alias tiennent pour
+  // toute la vie du bloc (une NtProtect de la page l'invalide).
+  const uint64_t Page = CidreGuestRIP & ~uint64_t {0xfff};
+  const int64_t Delta = CTX->GuestReadAlias(Page, 1);
+  if (!Delta) {
+    return false;
+  }
+  CidreSite = nullptr;
+  CidreDebut = GetCursorAddress<uint8_t*>();
+  if (AvecRegistre) {
+    const auto RegOffset = GetReg(Offset);
+    const auto Ext = OffsetType == IR::MemOffsetType::SXTX ? ARMEmitter::ExtendedType::SXTX :
+                     OffsetType == IR::MemOffsetType::UXTW ? ARMEmitter::ExtendedType::UXTW :
+                                                             ARMEmitter::ExtendedType::SXTW;
+    add(ARMEmitter::Size::i64Bit, TMP1, Base.X(), RegOffset.X(), Ext, FEXCore::ilog2(OffsetScale));
+  } else if (static_cast<int64_t>(Const) < 0) {
+    sub(ARMEmitter::Size::i64Bit, TMP1, Base.X(), -static_cast<int64_t>(Const));
+  } else {
+    add(ARMEmitter::Size::i64Bit, TMP1, Base.X(), Const);
+  }
+  // Sans drapeaux : TMP2 = adresse - page ; debut et fin de l'acces dans [0, 4096), sinon acces d'origine.
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP2, Page);
+  sub(ARMEmitter::Size::i64Bit, TMP2, TMP1, TMP2);
+  add(ARMEmitter::Size::i64Bit, TMP3, TMP2, Size - 1);
+  orr(ARMEmitter::Size::i64Bit, TMP3, TMP3, TMP2);
+  lsr(ARMEmitter::Size::i64Bit, TMP3, TMP3, 12);
+  (void)cbnz(ARMEmitter::Size::i64Bit, TMP3, Miss);
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP3, Page + Delta);
+  add(ARMEmitter::Size::i64Bit, TMP1, TMP3, TMP2);
+  const uint64_t N = CidreNbMemePage.fetch_add(1, std::memory_order_relaxed) + 1;
+  if ((N & (N - 1)) == 0) {
+    LogMan::Msg::IFmt("cidre : controles meme page emis {} (page {:#x}, RIP {:#x})", N, Page, CidreGuestRIP);
+  }
+  return true;
+}
+static void CidreCompterRefus(std::atomic<uint64_t>& N, const char* Quoi, uint64_t A, uint64_t Rip) {
+  const uint64_t V = N.fetch_add(1, std::memory_order_relaxed) + 1;
+  if ((V & (V - 1)) == 0) {
+    LogMan::Msg::IFmt("cidre : lecture directe refusee, {} {} (derniere : {:#x} a RIP {:#x})", Quoi, V, A, Rip);
+  }
+}
+
+bool Arm64JITCore::CidreLectureDirecte(IR::OpSize AccessSize, IR::Ref Node) {
+  if (!CTX->GuestReadAlias || FEXCore::IR::Guest64LowBase || !CidreGuestRIP) {
+    return false;
+  }
+  const uint64_t Size = IR::OpSizeToSize(AccessSize);
+  if (Size == 0 || Size > 16) {
+    return false;
+  }
+  // Adresse relevee avant l'allocation des registres (Core.cpp, GenerateIR).
+  const auto It = CidreAdressesConstantes.find(IR->GetID(Node).Value);
+  if (It == CidreAdressesConstantes.end()) {
+    return false;
+  }
+  const uint64_t A = It->second;
+  if ((A >> 12) != (CidreGuestRIP >> 12) || ((A + Size - 1) >> 12) != (A >> 12)) {
+    CidreCompterRefus(CidreNbHorsPage, "hors de la page du RIP", A, CidreGuestRIP);
+    return false;
+  }
+  const int64_t Delta = CTX->GuestReadAlias(A, Size);
+  if (!Delta) {
+    CidreCompterRefus(CidreNbSansAlias, "page non mixte ou non lisible", A, CidreGuestRIP);
+    return false;
+  }
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, A + Delta);
+  const uint64_t N = CidreNbLecturesDirectes.fetch_add(1, std::memory_order_relaxed) + 1;
+  if ((N & (N - 1)) == 0) {
+    LogMan::Msg::IFmt("cidre : lectures directes par l'alias emises {} (derniere : {:#x} a RIP {:#x})", N, A, CidreGuestRIP);
+  }
+  return true;
 }
 
