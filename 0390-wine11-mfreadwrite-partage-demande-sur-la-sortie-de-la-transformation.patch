+/* cidre 0390 : partage demande pour les echantillons rendus par le lecteur. Le client (Unity) peut le demander sur
+ * les attributs du flux de sortie de la derniere transformation (GetServiceForStream + GetOutputStreamAttributes :
+ * MF_SA_D3D11_SHARED_WITHOUT_MUTEX), apres SetCurrentMediaType ; sous Windows ces echantillons lui arrivent tels
+ * quels. Ici le lecteur recopie la sortie dans les echantillons de son propre allocateur, qui ne lisait que ses
+ * attributs a lui : textures non partagees, IDXGIResource::GetSharedHandle rendait NULL (videos Unity noires).
+ * 0 = rien, 1 = MF_SA_D3D11_SHARED, 2 = MF_SA_D3D11_SHARED_WITHOUT_MUTEX. */
+static UINT32 source_reader_stream_shared(const struct source_reader *reader, const struct media_stream *stream)
+{
+    UINT32 shared = 0, shared_without_mutex = 0;
+    IMFAttributes *attributes;
+
+    IMFAttributes_GetUINT32(reader->attributes, &MF_SA_D3D11_SHARED, &shared);
+    IMFAttributes_GetUINT32(reader->attributes, &MF_SA_D3D11_SHARED_WITHOUT_MUTEX, &shared_without_mutex);
+    if (!shared && !shared_without_mutex && stream && stream->transform_service
+            && SUCCEEDED(IMFTransform_GetOutputStreamAttributes(stream->transform_service, 0, &attributes)))
+    {
+        IMFAttributes_GetUINT32(attributes, &MF_SA_D3D11_SHARED, &shared);
+        IMFAttributes_GetUINT32(attributes, &MF_SA_D3D11_SHARED_WITHOUT_MUTEX, &shared_without_mutex);
+        IMFAttributes_Release(attributes);
+    }
+    return shared_without_mutex ? 2 : shared ? 1 : 0;
 }
 
