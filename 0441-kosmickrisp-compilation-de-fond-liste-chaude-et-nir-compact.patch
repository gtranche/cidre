+   if (_mesa_set_search(kk_chaud_set, cle) == NULL &&
+       kk_chaud_set->entries < KK_CHAUD_MAX) {
+      kk_chaud_inserer_locked(cle);
+      /* Ecrit tout de suite (O_APPEND, 32 octets) : le jeu est souvent tue. */
+      if (kk_chaud_fd >= 0 && write(kk_chaud_fd, cle, KK_CHAUD_CLE) < 0) {
+         close(kk_chaud_fd);
+         kk_chaud_fd = -1;
+      }
+      atomic_fetch_add(&kk_stat_fond[8], 1);
+   }
+   simple_mtx_unlock(&kk_chaud_lock);
+}
+
+/* --- file de fond --- */
+static void
+kk_fond_execute(void *data, UNUSED void *gdata, UNUSED int thread_index)
+{
+   struct kk_shader *s = data;
+   struct kk_device *dev = s->compile_dev;
+   const char *q = getenv("CIDRE_FOND_QOS");
+   kk_qos_fil(q != NULL && strcmp(q, "background") == 0 ? QOS_CLASS_BACKGROUND
+                                                        : QOS_CLASS_UTILITY);
+   bool fait = false;
+
+   /* Seule la reference du ticket : plus personne ne peut le lier. */
+   if (!atomic_load(&dev->fond_arret) &&
+       p_atomic_read(&s->vk.pipeline.cache_obj.ref_cnt) > 1) {
+      struct kk_frontal_job *job = atomic_load(&s->lazy_job);
+      if (job != NULL) {
+         bool lance = false;
+         simple_mtx_lock(&job->lock);
+         int e = KK_TRAVAIL_EN_ATTENTE;
+         if (atomic_compare_exchange_strong(&job->etat, &e,
+                                            KK_TRAVAIL_EN_COURS)) {
+            job->refs++;
+            job->par_fond = true;
+            lance = true;
+         }
+         simple_mtx_unlock(&job->lock);
+         if (lance) {
+            atomic_fetch_add(&kk_travaux_en_file, 1);
+            kk_frontal_execute(job, NULL, thread_index);
+            kk_frontal_cleanup(job, NULL, thread_index);
+            fait = true;
+         }
+      } else {
+         int e = KK_TRAVAIL_EN_ATTENTE;
+         if (atomic_compare_exchange_strong(&s->lib_etat, &e,
+                                            KK_TRAVAIL_PRISE)) {
+            /* La barriere d'une bibliotheque paresseuse est signalee tant
+             * que le travail n'est pas lance (kk_lazy_library) : l'armer
+             * avant de publier EN_COURS (kk_shader_kick attend PRISE). */
+            util_queue_fence_reset(&s->compile_ready);
+            atomic_store(&s->fond_fil, (void *)pthread_self());
+            atomic_fetch_or(&s->fond, KK_FOND_EN_COURS);
+            atomic_fetch_add(&kk_travaux_en_file, 1);
+            atomic_store(&s->lib_etat, KK_TRAVAIL_EN_COURS);
+            kk_async_compile_execute(s, NULL, thread_index);
+            atomic_fetch_or(&s->fond, KK_FOND_FAIT);
+            util_queue_fence_signal(&s->compile_ready);
+            kk_async_compile_cleanup(s, NULL, thread_index);
+            fait = true;
+         }
+      }
+   }
+
+   atomic_fetch_add(&kk_stat_fond[fait ? 1 : 2], 1);
+   vk_pipeline_cache_object_unref(&dev->vk, &s->vk.pipeline.cache_obj);
+   atomic_fetch_sub(&dev->fond_en_file, 1);
+}
+
+static bool
+kk_fond_en_attente(struct kk_shader *s)
+{
+   struct kk_frontal_job *job = atomic_load(&s->lazy_job);
+   if (job != NULL)
+      return atomic_load(&job->etat) == KK_TRAVAIL_EN_ATTENTE;
+   return atomic_load(&s->lib_etat) == KK_TRAVAIL_EN_ATTENTE;
+}
+
+/* Crochet du runtime : nuanceurs definitifs d'un pipeline graphique cree. */
+static void
+kk_shaders_crees(struct vk_device *vk_dev, uint32_t count,
+                 struct vk_shader *const *shaders)
+{
+   struct kk_device *dev = container_of(vk_dev, struct kk_device, vk);
+   if (!dev->fond_queue_ok || atomic_load(&dev->fond_arret))
+      return;
+   const bool tout = kk_fond_tout();
+   for (uint32_t i = 0; i < count; i++) {
+      struct kk_shader *s = container_of(shaders[i], struct kk_shader, vk);
+      if (s->vk.stage != MESA_SHADER_VERTEX &&
+          s->vk.stage != MESA_SHADER_FRAGMENT)
+         continue;
+      if (!kk_fond_en_attente(s))
+         continue;
+      if (!tout && !kk_chaud_contient(s->vk.pipeline.cache_key))
+         continue;
+      if (atomic_fetch_or(&s->fond, KK_FOND_ENFILE) & KK_FOND_ENFILE)
+         continue;
+      /* Un seul ticket par paire VS+FS (meme travail frontal). */
+      struct kk_frontal_job *job = atomic_load(&s->lazy_job);
+      if (job != NULL && atomic_exchange(&job->fond_enfile, true))
+         continue;
+      vk_pipeline_cache_object_ref(&s->vk.pipeline.cache_obj);
+      atomic_fetch_add(&dev->fond_en_file, 1);
+      atomic_fetch_add(&kk_stat_fond[0], 1);
+      util_queue_add_job(&dev->fond_queue, s, NULL, kk_fond_execute, NULL, 0);
+   }
+}
+
+static void
+kk_fond_init(struct kk_device *device)
+{
+   device->fond_queue_ok = false;
+   atomic_store(&device->fond_arret, false);
+   atomic_store(&device->fond_en_file, 0);
+   unsigned n = kk_fond_fils();
+   if (n == 0 || !device->compile_queue_ok || !kk_paresseux())
+      return;
+   kk_chaud_charger(device);
+   device->fond_queue_ok =
+      util_queue_init(&device->fond_queue, "kkfond", 4096, n,
+                      UTIL_QUEUE_INIT_RESIZE_IF_FULL, NULL);
+   if (device->fond_queue_ok) {
+      device->vk.cidre_shaders_crees = kk_shaders_crees;
+      fprintf(stderr, "kk: file de fond, %u fils%s\n", n,
+              kk_fond_tout() ? " (tout)" : "");
+   }
+}
+
+static void
+kk_fond_finish(struct kk_device *device)
+{
+   if (!device->fond_queue_ok)
+      return;
+   device->vk.cidre_shaders_crees = NULL;
+   /* Les tickets restants deviennent sans objet ; un travail en vol finit. */
+   atomic_store(&device->fond_arret, true);
+   for (unsigned n = 0; atomic_load(&device->fond_en_file) != 0; n++) {
+      if (n == 60000) {
+         fprintf(stderr, "[CIDRE] vkDestroyDevice : %u tickets de fond "
+                         "toujours en file apres 60 s\n",
+                 atomic_load(&device->fond_en_file));
+         break;
+      }
+      usleep(1000);
+   }
+   util_queue_destroy(&device->fond_queue);
+   device->fond_queue_ok = false;
+}
+
+/* Bind : mesure l'attente et note le nuanceur dans la liste chaude. */
+static void
+kk_bind_mesurer(struct kk_shader *shader, bool graphics)
+{
+   if (shader == NULL)
+      return;
+   if (graphics && kk_chaud_actif &&
+       !(atomic_load_explicit(&shader->fond, memory_order_relaxed) & KK_FOND_NOTE) &&
+       !(atomic_fetch_or(&shader->fond, KK_FOND_NOTE) & KK_FOND_NOTE))
+      kk_chaud_noter(shader->vk.pipeline.cache_key);
+   if (!shader->compile_async)
+      return;
+   kk_shader_kick(shader);
+   if (util_queue_fence_is_signalled(&shader->compile_ready)) {
+      uint32_t f = atomic_load_explicit(&shader->fond, memory_order_relaxed);
+      if (graphics && (f & KK_FOND_FAIT) && !(f & KK_FOND_COMPTE) &&
+          !(atomic_fetch_or(&shader->fond, KK_FOND_COMPTE) & KK_FOND_COMPTE))
+         atomic_fetch_add(&kk_stat_fond[3], 1);
+      return;
+   }
+   const bool sur_fond = atomic_load(&shader->fond) & KK_FOND_EN_COURS;
+   /* Le fil de fond (QoS utility) porte ce travail : lui preter la QoS
+    * user-interactive le temps de l'attente (inversion de priorite). Les
+    * fils kkfond vivent jusqu'a vkDestroyDevice : le pthread reste valide. */
+   pthread_override_t pret = NULL;
+   void *fil = sur_fond ? atomic_load(&shader->fond_fil) : NULL;
+   if (fil != NULL && kk_fond_pret_qos())
+      pret = pthread_override_qos_class_start_np((pthread_t)fil,
+                                                 QOS_CLASS_USER_INTERACTIVE, 0);
+   const int64_t t0 = os_time_get_nano();
+   util_queue_fence_wait(&shader->compile_ready);
+   if (pret != NULL)
+      pthread_override_qos_class_end_np(pret);
+   const uint64_t us = (uint64_t)(os_time_get_nano() - t0) / 1000u;
+   const uint32_t us32 = us > UINT32_MAX ? UINT32_MAX : (uint32_t)us;
+   if (graphics) {
+      atomic_fetch_add(&kk_stat_fond[4], 1);
+      atomic_fetch_add(&kk_stat_fond_us[0], us);
+      kk_stat_max(&kk_stat_fond[5], us32);
+      if (sur_fond)
+         atomic_fetch_add(&kk_stat_fond[6], 1);
+   } else {
+      atomic_fetch_add(&kk_stat_fond[11], 1);
+      atomic_fetch_add(&kk_stat_fond_us[2], us);
+      kk_stat_max(&kk_stat_fond[12], us32);
+   }
+}
