index e167ae4..e577c42 100644
--- a/src/airconv/airconv_public.h
+++ b/src/airconv/airconv_public.h
@@ -237,6 +237,11 @@ enum SM50_SHADER_METAL_VERSION {
 enum SM50_SHADER_FLAG {
   SM50_SHADER_FLAG_SAMPLE_NAN_TO_ZERO = 1 << 0,
   SM50_SHADER_FLAG_DEFUSE_FMA = 1 << 1,
+  /* fast-math (contraction, reassociation, reciproque) sur toutes les operations
+     flottantes et tous les etages, y compris celles que DXBC marque « precise ». */
+  SM50_SHADER_FLAG_FAST_MATH = 1 << 2,
+  /* acces a la memoire de groupe (TGSM) sans volatile : les barrieres suffisent. */
+  SM50_SHADER_FLAG_TGSM_NO_VOLATILE = 1 << 3,
 };
 
 struct SM50_SHADER_COMMON_DATA {
