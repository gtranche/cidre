+/* Choisit le travail a lancer (retire de la reserve), sous p->mtx. Les
+ * travaux morts sont retires et rendus dans *morts. */
+static struct kk_var_job *
+kk_var_choisir_locked(struct kk_var_pool *p, struct util_dynarray *morts)
+{
+   struct kk_var_job **t = util_dynarray_begin(&p->jobs);
+   unsigned n = util_dynarray_num_elements(&p->jobs, struct kk_var_job *);
+   int meilleur = -1;
+   for (unsigned i = 0; i < n; i++) {
+      struct kk_var_job *j = t[i];
+      if (kk_var_mort(j->vs) || kk_var_mort(j->fs)) {
+         util_dynarray_append_typed(morts, struct kk_var_job *, j);
+         t[i] = NULL;
+         continue;
+      }
+      const bool pret = kk_var_biblio_prete(j->vs) && kk_var_biblio_prete(j->fs);
+      if (!pret && !(p->prendre && (j->urgent || !p->ordre)))
+         continue;
+      if (meilleur < 0) {
+         meilleur = (int)i;
+         continue;
+      }
+      const struct kk_var_job *m = t[meilleur];
+      bool mieux;
+      if (!p->ordre)
+         mieux = j->seq < m->seq;
+      else if ((j->urgent != 0) != (m->urgent != 0))
+         mieux = j->urgent != 0;
+      else if (j->urgent != 0)
+         mieux = j->urgent < m->urgent;
+      else
+         mieux = j->rang_min < m->rang_min ||
+                 (j->rang_min == m->rang_min && j->seq < m->seq);
+      if (mieux)
+         meilleur = (int)i;
+   }
+   struct kk_var_job *choisi = meilleur >= 0 ? t[meilleur] : NULL;
+   if (choisi != NULL)
+      t[meilleur] = NULL;
+   /* compacter (ordre conserve) */
+   unsigned k = 0;
+   for (unsigned i = 0; i < n; i++) {
+      if (t[i] != NULL)
+         t[k++] = t[i];
+   }
+   p->jobs.size = k * sizeof(struct kk_var_job *);
+   for (unsigned i = 0; i < util_dynarray_num_elements(morts, struct kk_var_job *); i++) {
+      struct kk_var_job *j = *util_dynarray_element(morts, struct kk_var_job *, i);
+      _mesa_hash_table_remove_key(p->par_vs, j->vs);
+   }
+   if (choisi != NULL)
+      _mesa_hash_table_remove_key(p->par_vs, choisi->vs);
+   return choisi;
+}
