 /***********************************************************************
+ *           luajit_miroir_engage
+ *
+ * Le miroir de la fenetre basse (adresse hote) est-il engage et accessible ?
+ * Lecture seule du bitmap vprot, donc sur pile de signal. Sert a l'emulateur
+ * d'acces hote (signal_arm64.c) : si le pointeur invite bas est invalide (page
+ * non engagee -- typiquement une sonde IsBadStringPtr), l'emulateur ne doit PAS
+ * dereferencer le miroir, sinon il refaute DANS le handler (exception imbriquee
+ * sur la pile de signal, abandon du fil). Il rend alors FALSE et la violation
+ * d'acces part normalement vers le __except de l'invite.
+ */
+BOOL luajit_miroir_engage( const void *host, BOOL ecriture )
+{
+    BYTE v = get_host_page_vprot( host );
+    if (!(v & VPROT_COMMITTED) || (v & VPROT_GUARD)) return FALSE;
+    if (ecriture) return (v & VPROT_WRITE) != 0;
+    return (v & (VPROT_READ | VPROT_WRITE | VPROT_EXEC)) != 0;
+}
