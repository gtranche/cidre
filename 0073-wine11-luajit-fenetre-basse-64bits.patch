+/*
+ * Fenetre basse d'un invite 64 bits (macOS arm64 uniquement).
+ *
+ * Un invite 64 bits est en 1:1 avec l'hote : ses adresses sont celles de
+ * l'hote. Mais l'hote arm64 ne peut rien poser sous 4 Gio (__PAGEZERO), donc
+ * un invite qui exige des adresses sous 4 Gio -- LuaJIT sans GC64, qui stocke
+ * des pointeurs sur 32 bits -- ne peut pas fonctionner en 1:1.
+ *
+ * On lui reserve alors une fenetre de 4 Gio ailleurs dans l'espace de l'hote
+ * (luajit_low_base, multiple de 4 Gio), et on lui rend, pour ses reservations
+ * basses, des adresses INVITE sous 4 Gio. L'emulateur (FEX) rebase chaque
+ * acces dont l'adresse invite est sous 4 Gio : hote = invite | luajit_low_base.
+ * Le reste de l'invite 64 bits garde le 1:1 (adresses hautes, non touchees).
+ *
+ * Comme pour la fenetre 32 bits, la base est un multiple de 4 Gio : tronquer a
+ * 32 bits revient a soustraire la base, donc les conversions sont un masque et
+ * un « orr ». Zero = inactif (invite 64 bits ordinaire). Active par la variable
+ * d'environnement PROTON_OUVERT_LUAJIT.
+ */
+ULONG_PTR luajit_low_base = 0;
+
+/* Une adresse invite sous 4 Gio designe-t-elle la fenetre basse ? Zero reste
+ * zero (pointeur nul), et hors fenetre active tout est 1:1. */
+static inline int in_luajit_low_window( ULONG_PTR guest )
+{
+    return luajit_low_base && guest && guest < 0x100000000ull;
+}
+
+/* Adresse invite -> adresse hote, pour une reference qui peut viser la fenetre
+ * basse. Les adresses hautes (>= 4 Gio) et le zero passent inchangees. */
+static inline ULONG_PTR host_from_luajit_low( ULONG_PTR guest )
+{
+    return in_luajit_low_window( guest ) ? (guest | luajit_low_base) : guest;
+}
+
+/* Adresse hote -> adresse invite : une adresse dans la fenetre est rendue sous
+ * 4 Gio (masque), les autres inchangees. */
+static inline ULONG_PTR guest_from_luajit_low( ULONG_PTR host )
+{
+    return (luajit_low_base && host >= luajit_low_base && host < luajit_low_base + 0x100000000ull)
+        ? (host & 0xffffffffull) : host;
+}
