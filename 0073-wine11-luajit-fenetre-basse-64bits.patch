diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -1258,7 +1258,153 @@
  *		segv_handler
  *
  * Handler for SIGSEGV and related errors.
+ */
+#ifdef __APPLE__
+/*
+ * Redirection d'un acces HOTE a un pointeur invite de la fenetre basse.
+ *
+ * Fenetre basse active (LuaJIT) : la donnee d'une adresse invite sous 4 Gio
+ * vit a son miroir hote (adresse | luajit_low_base). Le code invite est deja
+ * rebase par FEX -- une dereference invite de NULL fauterait a luajit_low_base,
+ * pas sous 4 Gio. Donc toute faute de DONNEE sous 4 Gio (au-dela de la zone DOS)
+ * vient du code hote ARM64EC de Wine, qui accede au pointeur en 1:1. On decode
+ * le load/store, on le rejoue vers le miroir, on applique le writeback eventuel
+ * et on avance le PC. Rend TRUE si emule.
+ *
+ * Couvre les formes qu'un compilateur C emet : registre a offset immediat
+ * (non signe, non echelonne, pre/post-indexe), a offset registre, et les paires
+ * (LDP/STP). Entier et SIMD.
  */
+static BOOL emuler_acces_fenetre_basse( ucontext_t *ctx, ULONG_PTR guest_addr )
+{
+    const UINT insn = *(const UINT *)PC_sig( ctx );
+    const ULONG_PTR host = guest_addr | luajit_low_base;
+
+    /* Si le miroir n'est pas engage (pointeur bas invalide -- typiquement une
+     * sonde IsBadStringPtr sur un petit entier), ne pas le dereferencer : cela
+     * refauterait DANS le handler (exception imbriquee sur la pile de signal,
+     * abandon du fil). On rend FALSE et la violation part vers le __except de
+     * l'invite. Plage maximale d'un acces (paire Q) = 32 octets. */
+    if (!luajit_miroir_engage( (const void *)host, FALSE ) ||
+        !luajit_miroir_engage( (const void *)(host + 31), FALSE ))
+        return FALSE;
+#ifdef SONDE_EMU_COMPTE
+    { static LONG n; LONG v = InterlockedIncrement( &n ); if ((v % 2000) == 1) ERR( "SONDE_EMU_COMPTE %ld acces hote emules (pc=%p guest=%p)\n", (long)v, (void *)PC_sig(ctx), (void *)guest_addr ); }
+#endif
+
+    /* Rn : 31 = SP.  Rt : 31 = registre zero. */
+    #define XN(n)      ((n) == 31 ? SP_sig(ctx) : REGn_sig((n), ctx))
+    #define SET_XN(n,v) do { if ((n) == 31) SP_sig(ctx) = (v); else REGn_sig((n), ctx) = (v); } while (0)
+    #define XT_READ(n) ((n) == 31 ? 0ull : REGn_sig((n), ctx))
+    #define XT_WRITE(n,v) do { if ((n) != 31) REGn_sig((n), ctx) = (v); } while (0)
+    #define VREG(n)    ((UINT64 *)&ctx->uc_mcontext->__ns.__v[(n)])
+
+    /* Charge nb octets depuis host, etend a 64 bits selon signe. */
+    #define CHARGE_ENTIER(nb, signe) ({                                   \
+        UINT64 _v = 0; memcpy( &_v, (void *)host, (nb) );                 \
+        if (signe) { UINT _b = (nb) * 8; _v = (UINT64)(((INT64)(_v << (64 - _b))) >> (64 - _b)); } \
+        _v; })
+
+    /* --- Paires : LDP/STP (opc 101 V idx L imm7 Rt2 Rn Rt) --- */
+    if ((insn & 0x3a000000u) == 0x28000000u)
+    {
+        UINT opc = insn >> 30;            /* 00=32b,01=(LDPSW/D),10=64b/Q */
+        UINT V   = (insn >> 26) & 1;
+        UINT idx = (insn >> 23) & 3;      /* 01 post, 10 offset, 11 pre */
+        UINT L   = (insn >> 22) & 1;
+        INT  imm7 = (INT)((insn >> 15) & 0x7f); if (imm7 & 0x40) imm7 -= 0x80;
+        UINT Rt2 = (insn >> 10) & 31;
+        UINT Rn  = (insn >> 5) & 31;
+        UINT Rt  = insn & 31;
+        UINT esz = V ? (4u << opc) : ((opc & 2) ? 8u : 4u);   /* octets par registre */
+        BOOL signe = (!V && opc == 1);                        /* LDPSW */
+        ULONG_PTR h2 = host + esz;
+        if (idx == 0) return FALSE;                           /* variante STGP/non geree */
+        if (L)
+        {
+            if (V) { UINT64 a[2]={0,0},b[2]={0,0}; memcpy(a,(void*)host,esz); memcpy(b,(void*)h2,esz);
+                     memcpy(VREG(Rt),a,16); memcpy(VREG(Rt2),b,16); }
+            else {
+                UINT64 v1=0,v2=0; memcpy(&v1,(void*)host,esz); memcpy(&v2,(void*)h2,esz);
+                if (signe){ v1=(UINT64)(((INT64)(v1<<32))>>32); v2=(UINT64)(((INT64)(v2<<32))>>32); }
+                XT_WRITE(Rt,v1); XT_WRITE(Rt2,v2);
+            }
+        }
+        else
+        {
+            if (V) { memcpy((void*)host,VREG(Rt),esz); memcpy((void*)h2,VREG(Rt2),esz); }
+            else { UINT64 v1=XT_READ(Rt),v2=XT_READ(Rt2); memcpy((void*)host,&v1,esz); memcpy((void*)h2,&v2,esz); }
+        }
+        if (idx == 1 || idx == 3) SET_XN( Rn, XN(Rn) + (INT64)imm7 * esz );   /* writeback pre/post */
+        PC_sig(ctx) += 4;
+        return TRUE;
+    }
+
+    /* --- Registre, offset immediat non signe : (size 111 V 01 opc imm12 Rn Rt) --- */
+    if ((insn & 0x3b000000u) == 0x39000000u)
+    {
+        UINT size = insn >> 30, V = (insn >> 26) & 1, opc = (insn >> 22) & 3;
+        UINT Rt = insn & 31;
+        if (V)
+        {
+            UINT vsz = ((opc & 2) && size == 0) ? 16u : (1u << size);
+            BOOL load = opc & 1;
+            if (load) { UINT64 t[2]={0,0}; memcpy(t,(void*)host,vsz); memcpy(VREG(Rt),t,16); }
+            else memcpy((void*)host, VREG(Rt), vsz);
+        }
+        else
+        {
+            if (size == 3 && opc == 2) { PC_sig(ctx) += 4; return TRUE; }   /* PRFM : rien */
+            UINT nb = 1u << size;
+            BOOL load = opc != 0;
+            BOOL signe = (opc == 2 || opc == 3);
+            if (load) XT_WRITE(Rt, CHARGE_ENTIER(nb, signe));
+            else { UINT64 v = XT_READ(Rt); memcpy((void*)host, &v, nb); }
+        }
+        PC_sig(ctx) += 4;
+        return TRUE;
+    }
+
+    /* --- Registre, non echelonne / pre / post / offset registre :
+     *     (size 111 V 00 opc ... Rn Rt), sous-type en bits 11:10 --- */
+    if ((insn & 0x3b200000u) == 0x38000000u ||       /* imm : unscaled/pre/post */
+        (insn & 0x3b200c00u) == 0x38200800u)         /* offset registre */
+    {
+        UINT size = insn >> 30, V = (insn >> 26) & 1, opc = (insn >> 22) & 3;
+        UINT Rn = (insn >> 5) & 31, Rt = insn & 31;
+        UINT sub = (insn >> 10) & 3;                 /* 00 unscaled,01 post,11 pre,10 reg-offset */
+        INT  imm9 = (INT)((insn >> 12) & 0x1ff); if (imm9 & 0x100) imm9 -= 0x200;
+        if (V)
+        {
+            UINT vsz = ((opc & 2) && size == 0) ? 16u : (1u << size);
+            BOOL load = opc & 1;
+            if (load) { UINT64 t[2]={0,0}; memcpy(t,(void*)host,vsz); memcpy(VREG(Rt),t,16); }
+            else memcpy((void*)host, VREG(Rt), vsz);
+        }
+        else
+        {
+            if (size == 3 && opc == 2) { PC_sig(ctx) += 4; return TRUE; }   /* PRFM unscaled */
+            UINT nb = 1u << size;
+            BOOL load = opc != 0;
+            BOOL signe = (opc == 2 || opc == 3);
+            if (load) XT_WRITE(Rt, CHARGE_ENTIER(nb, signe));
+            else { UINT64 v = XT_READ(Rt); memcpy((void*)host, &v, nb); }
+        }
+        if (sub == 1 || sub == 3) SET_XN( Rn, XN(Rn) + (INT64)imm9 );       /* writeback pre/post */
+        PC_sig(ctx) += 4;
+        return TRUE;
+    }
+
+    return FALSE;   /* forme non geree : laisser suivre le chemin normal */
+    #undef XN
+    #undef SET_XN
+    #undef XT_READ
+    #undef XT_WRITE
+    #undef VREG
+    #undef CHARGE_ENTIER
+}
+#endif /* __APPLE__ */
+
