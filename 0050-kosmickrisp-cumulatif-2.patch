+bool
+poly_nir_lower_tes_index_fetch(nir_shader *tes)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(tes);
+   struct util_dynarray uses;
+
+   util_dynarray_init(&uses, NULL);
+
+   struct util_dynarray slots;
+
+   util_dynarray_init(&slots, NULL);
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic == nir_intrinsic_load_vertex_id)
+            util_dynarray_append_typed(&uses, nir_intrinsic_instr *, intr);
+         else if (intr->intrinsic == nir_intrinsic_load_raw_vertex_id)
+            util_dynarray_append_typed(&slots, nir_intrinsic_instr *, intr);
+      }
+   }
+
+   if (util_dynarray_num_elements(&uses, nir_intrinsic_instr *) == 0 &&
+       util_dynarray_num_elements(&slots, nir_intrinsic_instr *) == 0) {
+      util_dynarray_fini(&uses);
+      util_dynarray_fini(&slots);
+      return false;
+   }
+
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *p = nir_load_tess_param_buffer_poly(&b);
+   nir_def *pos = nir_load_vertex_id(&b);
+   nir_def *index = poly_load_tes_index_raw(&b, p, pos);
+   nir_def *slot = poly_tes_ccw_slot(&b, p, pos);
+
+   util_dynarray_foreach(&uses, nir_intrinsic_instr *, it)
+      nir_def_replace(&(*it)->def, index);
+
+   util_dynarray_foreach(&slots, nir_intrinsic_instr *, it)
+      nir_def_replace(&(*it)->def, slot);
+
+   util_dynarray_fini(&uses);
+   util_dynarray_fini(&slots);
+   return nir_progress(true, impl, nir_metadata_control_flow);
