+    /* cidre 0391 : position du serveur Wine recalee sur le pointeur quand la fenetre devient cle ou entre
+     * dans son espace plein ecran. Cocoa n'envoie aucun mouseMoved tant que la souris ne bouge pas : une
+     * fenetre de jeu qui apparait sous un pointeur immobile laissait la position du serveur a 0,0 (relevee
+     * dans Escape Academy : « pointer at (1185,880) server pos 0,0 » pendant tout le menu) alors que
+     * GetCursorPos rend le pointeur reel. Le jeu voyait deux positions (survol, WM_MOUSEMOVE, hit-test au
+     * coin haut-gauche ; GetCursorPos au pointeur) : souris « pas au bon endroit », selection du menu qui
+     * saute toute seule. Sous X11, EnterNotify fait ce recalage. Rien sous la capture du curseur (0122/0205 :
+     * mouvements relatifs seulement) ni si le pointeur est hors de la fenetre. CIDRE_SYNC_POINTEUR=0 coupe. */
+    - (void) cidrePostPointerPosition
+    {
+        WineApplicationController* controller = [WineApplicationController sharedController];
+        NSPoint loc = [NSEvent mouseLocation];
+        const char* env = getenv("CIDRE_SYNC_POINTEUR");
+        macdrv_event* event;
+        CGPoint pt;
+
+        if (env && *env == '0') return;
+        if (![self isVisible] || !NSMouseInRect(loc, [self frame], NO)) return;
+        if ([[controller valueForKey:@"cidreCursorCaptured"] boolValue]) return;
+
+        pt = cgpoint_win_from_mac(NSPointToCGPoint([controller flippedMouseLocation:loc]));
+        event = macdrv_create_event(MOUSE_MOVED_ABSOLUTE, self);
+        event->mouse_moved.x = floor(pt.x);
+        event->mouse_moved.y = floor(pt.y);
+        event->mouse_moved.time_ms = [controller ticksForEventTime:[[NSProcessInfo processInfo] systemUptime]];
+        event->mouse_moved.drag = FALSE;
+        [self.queue postEvent:event];
+        macdrv_release_event(event);
+    }
+
