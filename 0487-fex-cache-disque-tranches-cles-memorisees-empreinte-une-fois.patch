+  void DiskCache::CidreMemoCharger(const fextl::string& Chemin) {
+    auto* T = static_cast<CidreMemo*>(FEXCore::Allocator::VirtualAlloc(CIDRE_MEMO_NB * sizeof(CidreMemo)));
+    if (!T) {
+      return;
+    }
+    CidreMemos = T; // memoire neuve : tout a zero
+    CidreMemoFichier = fextl::make_unique<File::File>(Chemin.c_str(), File::FileModes::READ | File::FileModes::WRITE | File::FileModes::CREATE, false);
+    if (!CidreMemoFichier->IsValid()) {
+      CidreMemoFichier.reset();
+      return;
+    }
+    const ssize_t Taille = CidreMemoFichier->Size();
+    if (Taille <= 0 || Taille > (64 << 20)) {
+      return;
+    }
+    fextl::vector<uint64_t> Mots(Taille / sizeof(uint64_t));
+    if (CidreMemoFichier->PRead(Mots.data(), Mots.size() * sizeof(uint64_t), 0) != (ssize_t)(Mots.size() * sizeof(uint64_t))) {
+      return;
+    }
+    uint64_t N = 0, Rejets = 0;
+    for (size_t i = 0; i + 2 < Mots.size();) {
+      if (Mots[i] && Mots[i + 2] == CidreMemoMelange(Mots[i], Mots[i + 1])) {
+        CidreMemoNoter(Mots[i], Mots[i + 1], false);
+        N++;
+        i += 3;
+      } else {
+        Rejets++;
+        i++;
+      }
+    }
+    CidreMemoCharges.store(N, std::memory_order_relaxed);
+    LogMan::Msg::IFmt("cidre disque : cles memorisees : {} chargees ({} mots rejetes)", N, Rejets);
+  }
