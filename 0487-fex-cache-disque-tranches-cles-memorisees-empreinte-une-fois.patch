+  static inline uint64_t CidreMemoMelange(uint64_t B, uint64_t K) {
+    return (B ^ (K * 0x9E37'79B9'7F4A'7C15ULL) ^ 0xC1D4'0485'0485'C1D4ULL) | 1;
+  }
+
+  bool DiskCache::CidreMemoChercher(uint64_t B, uint64_t& K) {
+    const uint32_t H = (uint32_t)(B >> 20) & (CIDRE_MEMO_NB - 1);
+    for (uint32_t i = 0; i < 8; i++) {
+      auto& M = CidreMemos[(H + i) & (CIDRE_MEMO_NB - 1)];
+      const uint64_t C = M.C.load(std::memory_order_acquire);
+      if (!C) {
+        return false;
+      }
+      const uint64_t MB = M.B.load(std::memory_order_relaxed), MK = M.K.load(std::memory_order_relaxed);
+      std::atomic_thread_fence(std::memory_order_acquire);
+      if (MB == B && M.C.load(std::memory_order_relaxed) == C && CidreMemoMelange(MB, MK) == C) {
+        K = MK;
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void DiskCache::CidreMemoNoter(uint64_t B, uint64_t K, bool Persister) {
+    const uint32_t H = (uint32_t)(B >> 20) & (CIDRE_MEMO_NB - 1);
+    uint32_t Choix = H;
+    for (uint32_t i = 0; i < 8; i++) {
+      const uint32_t j = (H + i) & (CIDRE_MEMO_NB - 1);
+      const uint64_t C = CidreMemos[j].C.load(std::memory_order_relaxed);
+      if (!C || CidreMemos[j].B.load(std::memory_order_relaxed) == B) {
+        Choix = j;
+        break;
+      }
+    }
+    auto& M = CidreMemos[Choix];
+    if (M.C.load(std::memory_order_relaxed) == CidreMemoMelange(B, K) && M.B.load(std::memory_order_relaxed) == B &&
+        M.K.load(std::memory_order_relaxed) == K) {
+      return;
+    }
+    // ecrivains concurrents : la case peut finir melangee, alors C ne correspond plus et la lecture l'ignore
+    M.C.store(0, std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_release);
+    M.B.store(B, std::memory_order_relaxed);
+    M.K.store(K, std::memory_order_relaxed);
+    M.C.store(CidreMemoMelange(B, K), std::memory_order_release);
+    if (!Persister || !CidreMemoFichier) {
+      return;
+    }
+    CidreMemoNotes.fetch_add(1, std::memory_order_relaxed);
+    bool Demander = false;
+    {
+      std::lock_guard Guard(CidreMemoVerrou);
+      CidreMemoNeufs.push_back(B);
+      CidreMemoNeufs.push_back(K);
+      CidreMemoNeufs.push_back(CidreMemoMelange(B, K));
+      if (CidreMemoNeufs.size() >= 3 * 512 && !CidreMemoDemande) {
+        CidreMemoDemande = Demander = true;
+      }
+    }
+    if (Demander && Writer) {
+      Writer->QueueWork(fextl::make_unique<CidreMemoWorkItem>(this));
+    }
+  }
+
+  void DiskCache::CidreMemoEcrire() {
+    fextl::vector<uint64_t> Lot;
+    {
+      std::lock_guard Guard(CidreMemoVerrou);
+      Lot.swap(CidreMemoNeufs);
+      CidreMemoDemande = false;
+    }
+    if (Lot.empty() || !CidreMemoFichier) {
+      return;
+    }
+    const ssize_t Fin = CidreMemoFichier->Size();
+    if (Fin >= 0) {
+      CidreMemoFichier->PWrite(Lot.data(), Lot.size() * sizeof(uint64_t), (uint64_t)Fin);
+    }
+  }
