+  // Faux : lire en direct.
+  bool DiskCache::CidreLireTranche(IndexedDB* DB, uint64_t Offset, std::span<uint8_t> Out) {
+    if (!CidreTranchesPretes) {
+      CidreTranchesInit();
+    }
+    const uint64_t T = CidreTailleTranche;
+    if (!T || DB != RWCacheDB.get() || Out.size() > T / 2 || Out.empty()) {
+      return false;
+    }
+    if (CidrePause.load(std::memory_order_relaxed) > 0 && CidrePause.fetch_sub(1, std::memory_order_relaxed) > 0) {
+      return false;
+    }
+    const uint64_t Num = Offset / T;
+    if ((Offset + Out.size() - 1) / T != Num) {
+      return false;
+    }
+    const uint64_t Rel = Offset - Num * T;
+    const uint32_t Case = (uint32_t)(Num % CidreNbCases);
+    auto& K = CidreCases[Case];
+    const uint8_t* Base = CidreTranchesMem + (uint64_t)Case * T;
+    for (int Essai = 0; Essai < 3; Essai++) {
+      const uint64_t Seq = K.Seq.load(std::memory_order_acquire);
+      if (!(Seq & 1) && K.Num.load(std::memory_order_relaxed) == Num && Rel + Out.size() <= K.Valides.load(std::memory_order_relaxed)) {
+        memcpy(Out.data(), Base + Rel, Out.size());
+        std::atomic_thread_fence(std::memory_order_acquire);
+        if (K.Seq.load(std::memory_order_relaxed) == Seq) {
+          CidreTranchesServis.fetch_add(1, std::memory_order_relaxed);
+          CidreFenServis.fetch_add(Out.size(), std::memory_order_relaxed);
+          return true;
+        }
+        continue;
+      }
+      if ((Seq & 1) && K.Num.load(std::memory_order_relaxed) == Num) {
+        CidreTranchesAttentes.fetch_add(1, std::memory_order_relaxed);
+      }
+      uint32_t C;
+      uint64_t S;
+      bool Lire;
+      if (!CidreCasePour(Num, Rel + Out.size(), C, S, Lire, true)) {
+        return false;
+      }
+      if (Lire) {
+        CidreRemplirCase(DB, C, Num, S);
+        // lecture anticipee des tranches suivantes (blobs ecrits dans l'ordre de compilation), sur un fil a part
+        if (CidreLecteur && CidreAnticipees.load(std::memory_order_relaxed) < 8) {
+          for (uint32_t i = 1; i <= CidreAnticipe; i++) {
+            CidreAnticipees.fetch_add(1, std::memory_order_relaxed);
+            CidreLecteur->QueueWork(fextl::make_unique<CidreAnticipeWorkItem>(this, DB, Num + i));
+          }
+        }
+        if (Rel + Out.size() > K.Valides.load(std::memory_order_relaxed)) {
+          return false; // fin de fichier : blob pas dans la tranche lue
+        }
+      }
+    }
+    return false;
+  }
