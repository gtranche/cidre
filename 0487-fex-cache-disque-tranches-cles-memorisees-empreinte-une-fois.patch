+  // Cidre 0487 : empreinte brute des octets [RIP, RIP + 64), bornee a la page de 4 Kio si la suite n'est pas executable
+  bool DiskCache::CidreEmpreinteBrute(Core::InternalThreadState* Thread, uint64_t GuestRIP, uint64_t& B) {
+    uint8_t Octets[AnonPrefixGuestBytes];
+    size_t N = AnonPrefixGuestBytes;
+    if (!Thread->FrontendDecoder->CidreRelire(reinterpret_cast<const uint8_t*>(GuestRIP), Octets, N)) {
+      N = std::min<size_t>(N, 0x1000 - (GuestRIP & 0xfff));
+      if (!Thread->FrontendDecoder->CidreRelire(reinterpret_cast<const uint8_t*>(GuestRIP), Octets, N)) {
+        return false;
       }
+    }
+    B = XXH3_64bits_withSeed(Octets, N, 0xC1D4'0485'0000ULL ^ N) | 1;
+    return true;
+  }
