 namespace dxmt {
 
+/*
+ * Etiquettes d'encodeur pour la trace GPU (DXMT_ENCODER_LABELS=1).
+ *
+ * Instruments (Metal System Trace, xctrace export) donne le temps GPU de chaque
+ * encodeur mais ne sait rien de ce qu'il dessine. L'etiquette resume la passe :
+ *   R <largeur>x<hauteur>[x<couches>] c<i>=<format>:<chargement><stockage> ...
+ *     d=<format>:<chargement><stockage> s=<chargement><stockage> draws=<n> [vis] [ts] [gs]
+ *   C disp=<n>        (passes de calcul : nombre de dispatch)
+ *   B cmds=<n>        (copies, mipmaps, remplissages)
+ * chargement : x = sans importance, L = charge, C = efface ;
+ * stockage   : x = sans importance, S = stocke, R = resout, SR = stocke et resout.
+ * Deux appels Unix par encodeur quand c'est actif, rien sinon.
+ */
+namespace {
+
+const char *
+abrege_chargement(WMTLoadAction a) {
+  switch (a) {
+  case WMTLoadActionDontCare: return "x";
+  case WMTLoadActionLoad: return "L";
+  case WMTLoadActionClear: return "C";
+  }
+  return "?";
+}
+
+const char *
+abrege_stockage(WMTStoreAction a) {
+  switch (a) {
+  case WMTStoreActionDontCare: return "x";
+  case WMTStoreActionStore: return "S";
+  case WMTStoreActionMultisampleResolve: return "R";
+  case WMTStoreActionStoreAndMultisampleResolve: return "SR";
+  default: break;
+  }
+  return "?";
+}
+
+std::string
+nom_format(dxmt::TextureViewRef const &vue) {
+  std::ostringstream os;
+  os << vue->allocation->descriptor->pixelFormat(vue->key);
+  auto s = os.str();
+  if (s.starts_with("WMTPixelFormat"))
+    s.erase(0, 14);
+  return s;
+}
+
+template <typename Tete, typename Pred>
+unsigned
+compter_commandes(Tete &tete, Pred pred) {
+  unsigned n = 0;
+  for (auto c = (wmtcmd_base *)tete.next.get(); c; c = (wmtcmd_base *)c->next.get())
+    if (pred(c->type))
+      n++;
+  return n;
+}
+
+std::string
+etiquette_render(dxmt::RenderEncoderData *data) {
+  std::ostringstream os;
+  os << "R " << data->render_target_width << "x" << data->render_target_height;
+  if (data->render_target_array_length > 1)
+    os << "x" << data->render_target_array_length;
+  for (unsigned i = 0; i < std::size(data->colors); i++) {
+    auto &c = data->colors[i];
+    if (!c.attachment)
+      continue;
+    os << " c" << i << "=" << nom_format(c.attachment) << ":" << abrege_chargement(c.load_action)
+       << abrege_stockage(c.store_action);
+  }
+  if (data->depth.attachment)
+    os << " d=" << nom_format(data->depth.attachment) << ":" << abrege_chargement(data->depth.load_action)
+       << abrege_stockage(data->depth.store_action);
+  if (data->stencil.attachment)
+    os << " s=" << abrege_chargement(data->stencil.load_action) << abrege_stockage(data->stencil.store_action);
+  os << " draws=" << compter_commandes(data->cmd_head, [](uint16_t t) {
+    switch (t) {
+    case WMTRenderCommandDraw:
+    case WMTRenderCommandDrawIndexed:
+    case WMTRenderCommandDrawIndirect:
+    case WMTRenderCommandDrawIndexedIndirect:
+    case WMTRenderCommandDrawMeshThreadgroups:
+    case WMTRenderCommandDrawMeshThreadgroupsIndirect:
+    case WMTRenderCommandDXMTGeometryDraw:
+    case WMTRenderCommandDXMTGeometryDrawIndexed:
+    case WMTRenderCommandDXMTGeometryDrawIndirect:
+    case WMTRenderCommandDXMTGeometryDrawIndexedIndirect: return true;
+    default: return false;
+    }
+  });
+  if (data->use_visibility_result)
+    os << " vis";
+  if (data->use_tessellation)
+    os << " ts";
+  if (data->use_geometry)
+    os << " gs";
+  return os.str();
+}
+
+std::string
+etiquette_compute(dxmt::ComputeEncoderData *data) {
+  std::ostringstream os;
+  os << "C disp=" << compter_commandes(data->cmd_head, [](uint16_t t) {
+    switch (t) {
+    case WMTComputeCommandDispatch:
+    case WMTComputeCommandDispatchIndirect:
+    case WMTComputeCommandDispatchThreads:
+    case WMTComputeCommandExecuteCommandsInBuffer: return true;
+    default: return false;
+    }
+  });
+  return os.str();
+}
+
+std::string
+etiquette_blit(dxmt::BlitEncoderData *data) {
+  std::ostringstream os;
+  os << "B cmds=" << compter_commandes(data->cmd_head, [](uint16_t t) {
+    switch (t) {
+    case WMTBlitCommandWaitForFence:
+    case WMTBlitCommandUpdateFence:
+    case WMTBlitCommandNop: return false;
+    default: return true;
+    }
+  });
+  return os.str();
+}
+
+} // namespace
