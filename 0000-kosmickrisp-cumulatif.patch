+   const VkGeneratedCommandsInfoEXT *pGeneratedCommandsInfo)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_indirect_commands_layout, layout,
+                  pGeneratedCommandsInfo->indirectCommandsLayout);
