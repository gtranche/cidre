+static void
+kk_flush_xfb_state(struct kk_cmd_buffer *cmd, const struct kk_draw_command *data)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_descriptor_state *desc = &gfx->descriptors;
+   const struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+
+   gfx->xfb.tess_snapshot = (struct kk_ptr){0};
+
+   /* Only shaders that capture read any of this. */
+   if (vs == NULL || !vs->info.vs.has_xfb)
+      return;
+
+   desc->root_dirty = true;
+
+   struct kk_ptr counters = kk_xfb_counters(cmd);
+   for (unsigned i = 0u; i < MAX_XFB_BUFFERS; ++i) {
+      desc->root.draw.xfb_counter[i] =
+         counters.gpu ? counters.gpu + i * sizeof(uint32_t) : 0u;
+   }
+
+   uint64_t prims = kk_prims_for_vertices(data->prim,
+                                          kk_draw_vertex_count(data)) *
+                    kk_draw_instance_count(data);
+
+   if (!kk_xfb_draw_captures(cmd, data)) {
+      memset(desc->root.draw.xfb_size, 0, sizeof(desc->root.draw.xfb_size));
+
+      /* The stream still produces primitives, they are just not captured. */
+      if (gfx->xfb.query[0].active)
+         gfx->xfb.query[0].generated += prims;
+
+      return;
+   }
+
+   if (cmd->state.shaders[MESA_SHADER_TESS_EVAL] != NULL) {
+      for (unsigned i = 0; i < MAX_XFB_BUFFERS; ++i) {
+         uint64_t size = gfx->xfb.buffers[i].size;
+         uint64_t used = gfx->xfb.written[i];
+
+         if (vs->info.vs.xfb_stride[i] == 0u)
+            continue;
+
+         desc->root.draw.xfb_address[i] =
+            used >= size ? 0u : gfx->xfb.buffers[i].addr + used;
+         desc->root.draw.xfb_size[i] =
+            used >= size ? 0u : MIN2(size - used, UINT32_MAX);
+      }
+
+      gfx->xfb.tess_snapshot =
+         kk_pool_alloc(cmd, MAX_XFB_BUFFERS * sizeof(uint32_t), 4u);
+
+      for (unsigned i = 0u; i < MAX_XFB_BUFFERS; ++i) {
+         desc->root.draw.xfb_counter[i] =
+            gfx->xfb.tess_snapshot.gpu
+               ? gfx->xfb.tess_snapshot.gpu + i * sizeof(uint32_t)
+               : 0u;
