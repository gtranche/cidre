+void
 wsi_metal_layer_make_queue_resident(const CAMetalLayer *metal_layer,
    void *mtl4_command_queue);
 
diff -urN a/src/vulkan/wsi/wsi_common_metal_layer.m b/src/vulkan/wsi/wsi_common_metal_layer.m
--- a/src/vulkan/wsi/wsi_common_metal_layer.m
+++ b/src/vulkan/wsi/wsi_common_metal_layer.m
@@ -364,7 +364,71 @@
    @autoreleasepool {
       id<CAMetalDrawable> drawable = [(id<CAMetalDrawable>)*drawable_ptr autorelease];
       [drawable present];
+
+      *drawable_ptr = nil;
+   }
+}
+
+struct wsi_metal_layer_present_context {
+   id<MTLCommandQueue> commandQueue;
+   id<MTLSharedEvent> event;
+   uint64_t eventValue;
+};
+
+struct wsi_metal_layer_present_context *
+wsi_create_metal_layer_present_context(const CAMetalLayer *metal_layer)
+{
+   @autoreleasepool {
+      id<MTLDevice> device = metal_layer.device;
+      if (device == nil)
+         return NULL;
+
+      struct wsi_metal_layer_present_context *context =
+         calloc(1, sizeof(struct wsi_metal_layer_present_context));
+      if (context == NULL)
+         return NULL;
+
+      context->commandQueue = [device newCommandQueue];
+      context->event = [device newSharedEvent];
+      if (context->commandQueue == nil || context->event == nil) {
+         wsi_destroy_metal_layer_present_context(context);
+         return NULL;
+      }
+
+      return context;
+   }
+}
 
+void
+wsi_destroy_metal_layer_present_context(struct wsi_metal_layer_present_context *context)
+{
+   [context->commandQueue release];
+   [context->event release];
+   free(context);
+}
+
+void
+wsi_metal_layer_present_with_command_buffer(struct wsi_metal_layer_present_context *context,
+   CAMetalDrawable **drawable_ptr, void *mtl4_command_queue)
+{
+   @autoreleasepool {
+      id<CAMetalDrawable> drawable = [(id<CAMetalDrawable>)*drawable_ptr autorelease];
+      id<MTLCommandBuffer> commandBuffer = [context->commandQueue commandBuffer];
+
+      if (mtl4_command_queue != NULL) {
+         /* The frame, down to its final blit into the drawable, was committed
+          * to the Metal 4 queue. Whatever gets encoded in this command buffer
+          * draws over that frame, so it must run after it: signal from the
+          * Metal 4 queue, wait here. */
+         id<MTL4CommandQueue> queue = (id<MTL4CommandQueue>)mtl4_command_queue;
+         uint64_t value = ++context->eventValue;
+         [queue signalEvent:context->event value:value];
+         [commandBuffer encodeWaitForEvent:context->event value:value];
+      }
+
+      [commandBuffer presentDrawable:drawable];
+      [commandBuffer commit];
+
       *drawable_ptr = nil;
    }
 }
