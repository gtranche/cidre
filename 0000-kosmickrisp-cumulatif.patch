+bool
+msl_lower_alpha_to_coverage(nir_shader *nir, uint32_t sample_count)
+{
+   assert(nir->info.stage == MESA_SHADER_FRAGMENT);
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_intrinsic_instr *store = NULL;
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic != nir_intrinsic_store_output)
+            continue;
+
+         unsigned location = nir_intrinsic_io_semantics(intr).location;
+         if (location != FRAG_RESULT_DATA0 && location != FRAG_RESULT_COLOR)
+            continue;
+
+         unsigned first = nir_intrinsic_component(intr);
+         unsigned count = intr->src[0].ssa->num_components;
+         if (first + count <= 3u)
+            continue;
+
+         store = intr;
+         break;
+      }
+      if (store)
+         break;
+   }
+
+   if (store == NULL)
+      return false;
+
+   nir_builder b = nir_builder_at(nir_after_instr(&store->instr));
+
+   nir_def *alpha =
+      nir_channel(&b, store->src[0].ssa, 3u - nir_intrinsic_component(store));
+   nir_def *scaled = nir_fmul_imm(&b, nir_fsat(&b, alpha), sample_count);
+   nir_def *covered = nir_f2u32(&b, nir_fround_even(&b, scaled));
+   nir_def *mask = nir_iadd_imm(&b, nir_ishl(&b, nir_imm_int(&b, 1u), covered),
+                                -1);
+
+   struct nir_io_semantics io_semantics = {
+      .location = FRAG_RESULT_SAMPLE_MASK,
+      .num_slots = 1u,
+   };
+   nir_store_output(&b, mask, nir_imm_int(&b, 0u), .base = 0u, .range = 1u,
+                    .write_mask = 0x1, .component = 0u,
+                    .src_type = nir_type_uint32,
+                    .io_semantics = io_semantics);
+
+   nir->info.outputs_written |= BITFIELD64_BIT(FRAG_RESULT_SAMPLE_MASK);
+
+   return nir_progress(true, impl, nir_metadata_none);
 }
 
