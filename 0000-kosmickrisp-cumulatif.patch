+void
+kk_dgc_dispatch(struct kk_cmd_buffer *cmd,
+                const struct kk_indirect_commands_layout *layout,
+                const VkGeneratedCommandsInfoEXT *info)
+{
+   uint64_t roots = kk_dgc_build_roots(cmd, layout, info,
+                                       VK_PIPELINE_BIND_POINT_COMPUTE);
+   if (layout->push_token_count != 0u && !roots)
+      return;
+
+   uint64_t args = info->indirectAddress + layout->action_offset;
+   uint32_t stride = layout->indirect_stride;
+
+   if (info->sequenceCountAddress) {
+      struct kk_ptr patched = kk_pool_alloc(
+         cmd, info->maxSequenceCount * sizeof(VkDispatchIndirectCommand), 4u);
+      if (unlikely(!patched.gpu))
+         return;
+
+      libkk_predicate_indirect_gt_draw_id(
+         cmd, kk_grid_1d(info->maxSequenceCount), false, patched.gpu, args,
+         info->sequenceCountAddress, 3u, stride / sizeof(uint32_t));
+
+      args = patched.gpu;
+      stride = sizeof(VkDispatchIndirectCommand);
+   }
+
+   if (cmd->state.cond_render.enabled) {
+      struct kk_ptr patched = kk_pool_alloc(
+         cmd, info->maxSequenceCount * sizeof(VkDispatchIndirectCommand), 4u);
+      if (unlikely(!patched.gpu))
+         return;
+
+      uint64_t cond = cmd->state.cond_render.address;
+      struct kk_grid grid = kk_grid_1d(info->maxSequenceCount);
+      if (cmd->state.cond_render.inverted) {
+         libkk_predicate_indirect_eq_zero(cmd, grid, false, patched.gpu, args,
+                                          cond, 3u,
+                                          stride / sizeof(uint32_t));
+      } else {
+         libkk_predicate_indirect_neq_zero(cmd, grid, false, patched.gpu, args,
+                                           cond, 3u,
+                                           stride / sizeof(uint32_t));
+      }
+
+      args = patched.gpu;
+      stride = sizeof(VkDispatchIndirectCommand);
+   }
+
+   struct kk_shader *cs = cmd->state.shaders[MESA_SHADER_COMPUTE];
+   struct mtl_size local_size = cs->info.cs.local_size;
+   mtl_compute_encoder *encoder = cs_get_compute(cmd);
+
+   kk_flush_compute_state(cmd);
+
+   for (uint32_t i = 0; i < info->maxSequenceCount; i++) {
+      if (roots) {
+         kk_cmd_bind_root_to_argument_table(
+            cmd, roots + (uint64_t)i * sizeof(struct kk_root_descriptor_table));
+      }
+
+      mtl_dispatch_threadgroups_with_indirect_buffer(
+         encoder, args + (uint64_t)i * stride, local_size);
    }
 }
