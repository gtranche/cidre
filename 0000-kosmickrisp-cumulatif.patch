+static VkResult
+kk_build_stage_library(struct kk_device *device, struct kk_shader *shader)
+{
+   struct kk_physical_device *pdev = kk_device_physical(device);
+   const struct msl_compile_data *data = &shader->msl_data[shader->info.stage];
+
+   shader->library =
+      mtl_new_library(device->mtl_compiler_handle, data->code,
+                      pdev->info.msl_version, MTL_MATH_MODE_FAST,
+                      MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
+   if (shader->library == NULL)
+      return VK_ERROR_INVALID_SHADER_NV;
+
+   shader->function = mtl_new_library_function_descriptor(
+      shader->library, data->entrypoint_name);
+   if (shader->function == NULL) {
+      mtl_release(shader->library);
+      shader->library = NULL;
+      return VK_ERROR_INVALID_SHADER_NV;
+   }
+
+   return VK_SUCCESS;
+}
