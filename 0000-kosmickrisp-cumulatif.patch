+static uint16_t
+kk_encode_view_swizzle(VkComponentMapping swizzle)
+{
+   const VkComponentSwizzle comps[4] = {swizzle.r, swizzle.g, swizzle.b,
+                                        swizzle.a};
+   uint16_t encoded = 0u;
+
+   for (uint32_t i = 0u; i < 4u; ++i) {
+      uint32_t value;
+      switch (comps[i]) {
+      case VK_COMPONENT_SWIZZLE_R: value = 0u; break;
+      case VK_COMPONENT_SWIZZLE_G: value = 1u; break;
+      case VK_COMPONENT_SWIZZLE_B: value = 2u; break;
+      case VK_COMPONENT_SWIZZLE_A: value = 3u; break;
+      case VK_COMPONENT_SWIZZLE_ZERO: value = 4u; break;
+      case VK_COMPONENT_SWIZZLE_ONE: value = 5u; break;
+      default: value = i; break;
+      }
+      encoded |= value << (3u * i);
+   }
+
+   return encoded;
+}
