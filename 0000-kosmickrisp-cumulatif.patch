+/* Vertex count of a direct draw, indexed or not. */
+static uint32_t
+kk_draw_vertex_count(const struct kk_draw_command *data)
+{
+   if (data->indirect || data->draw_count != 1)
+      return 0u;
+
+   return data->indexed ? data->indexed_draws[0].indexCount
+                        : data->draws[0].vertexCount;
+}
+
+static uint32_t
+kk_draw_instance_count(const struct kk_draw_command *data)
+{
+   if (data->indirect || data->draw_count != 1)
+      return 0u;
+
+   return data->indexed ? data->indexed_draws[0].instanceCount
+                        : data->draws[0].instanceCount;
+}
