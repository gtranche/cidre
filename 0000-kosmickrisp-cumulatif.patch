+static void
+kk_nir_guard_grid_overrun(nir_shader *nir, bool geometry)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+
+   nir_cf_list body;
+   nir_cf_extract(&body, nir_before_impl(impl), nir_after_impl(impl));
+
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+
+   nir_def *params = geometry ? nir_load_geometry_param_buffer_poly(&b)
+                              : nir_load_vertex_param_buffer_poly(&b);
+   const uint32_t offset = geometry
+                              ? offsetof(struct poly_geometry_params, grid)
+                              : offsetof(struct poly_vertex_params, grid);
+
+   nir_def *limit =
+      nir_load_global(&b, 1u, 32u, nir_iadd_imm(&b, params, offset));
+   nir_def *id = nir_channel(&b, nir_load_global_invocation_id(&b, 32), 0);
+
+   nir_if *nif = nir_push_if(&b, nir_ult(&b, id, limit));
+   b.cursor = nir_cf_reinsert(&body, b.cursor);
+   nir_pop_if(&b, nif);
+
+   BITSET_SET(nir->info.system_values_read, SYSTEM_VALUE_GLOBAL_INVOCATION_ID);
+   nir_progress(true, impl, nir_metadata_none);
+}
