+#ifndef KK_ROOT_LAYOUT_H
+#define KK_ROOT_LAYOUT_H 1
+
+#include <stdint.h>
+
+enum kk_root_field {
+   KK_ROOT_CS_BASE_GROUP,
+   KK_ROOT_ATTRIBS,
+   KK_ROOT_BLEND_CONSTANT,
