+   b->cursor = nir_before_instr(&intr->instr);
+   nir_src_rewrite(&intr->src[0], nir_trim_vector(b, value, keep));
+   nir_intrinsic_set_write_mask(intr, nir_component_mask(keep));
+   return true;
