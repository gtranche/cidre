+   uint64_t vertices_that_fit = UINT64_MAX;
+
+   for (unsigned i = 0; i < MAX_XFB_BUFFERS; ++i) {
+      /* info.vs.xfb_stride is in words, like nir_shader_info. */
+      uint64_t stride = (uint64_t)vs->info.vs.xfb_stride[i] * 4u;
+      uint64_t size = gfx->xfb.buffers[i].size;
+      uint64_t used = gfx->xfb.written[i];
+
+      if (stride == 0u)
