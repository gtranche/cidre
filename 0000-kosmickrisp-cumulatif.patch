+   for (uint32_t i = 0u; i < MAX_XFB_BUFFERS; ++i) {
+      uint64_t dst = counters.gpu + i * sizeof(uint32_t);
+      const struct kk_buffer *counter = NULL;
+      uint64_t src_offset = 0u;
+
+      if (i >= firstCounterBuffer && pCounterBuffers != NULL &&
+          i < firstCounterBuffer + counterBufferCount) {
+         uint32_t slot = i - firstCounterBuffer;
+
+         if (pCounterBuffers[slot] != VK_NULL_HANDLE) {
+            counter = kk_buffer_from_handle(pCounterBuffers[slot]);
+            src_offset = pCounterBufferOffsets != NULL
+                            ? pCounterBufferOffsets[slot]
+                            : 0u;
