+           "table_arg poses=%llu cache=%llu (%.1f%%)\n",
+           (unsigned long long)kk_draw_calls,
+           (unsigned long long)kk_draw_fastpath,
+           100.0 * (double)kk_draw_fastpath / (double)kk_draw_calls,
+           (unsigned long long)kk_root_uploads,
+           (double)kk_root_uploads / (double)kk_draw_calls,
+           (unsigned long long)kk_root_bytes,
+           (double)kk_root_bytes / (double)kk_draw_calls,
+           (double)kk_push_calls / (double)kk_draw_calls,
+           (double)kk_setoff_calls / (double)kk_draw_calls,
+           (double)kk_bindsets_calls / (double)kk_draw_calls,
