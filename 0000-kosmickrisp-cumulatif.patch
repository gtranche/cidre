 VKAPI_ATTR void VKAPI_CALL
+kk_CmdBeginQueryIndexedEXT(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
+                           uint32_t query, VkQueryControlFlags flags,
+                           uint32_t index)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_query_pool, pool, queryPool);
+
+   if (!kk_pool_is_xfb(pool)) {
+      assert(index == 0 && "only transform feedback queries are indexed");
+      kk_CmdBeginQuery(commandBuffer, queryPool, query, flags);
+      return;
+   }
+
+   assert(index < POLY_MAX_VERTEX_STREAMS);
+
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   struct kk_xfb_query *q = &gfx->xfb.query[index];
+
+   q->report_addr = kk_query_report_addr(dev, pool, query);
+   q->available_addr = kk_query_available_addr(pool, query);
+   q->generated = 0u;
+   q->written = 0u;
+   q->counters =
+      kk_pool_alloc(cmd, 2u * POLY_MAX_VERTEX_STREAMS * sizeof(uint32_t), 4u);
+
+   if (q->counters.cpu != NULL)
+      memset(q->counters.cpu, 0,
+             2u * POLY_MAX_VERTEX_STREAMS * sizeof(uint32_t));
+
+   q->active = true;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdEndQueryIndexedEXT(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
+                         uint32_t query, uint32_t index)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_query_pool, pool, queryPool);
+
+   if (!kk_pool_is_xfb(pool)) {
+      assert(index == 0 && "only transform feedback queries are indexed");
+      kk_CmdEndQuery(commandBuffer, queryPool, query);
+      return;
+   }
+
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   assert(index < POLY_MAX_VERTEX_STREAMS);
+   struct kk_xfb_query *q = &gfx->xfb.query[index];
+
+   if (!q->active)
+      return;
+
+   uint64_t addr = q->report_addr;
+   uint32_t written =
+      index == 0u ? (uint32_t)MIN2(q->written, UINT32_MAX) : 0u;
+   uint32_t generated =
+      index == 0u ? (uint32_t)MIN2(q->generated, UINT32_MAX) : 0u;
+
+   if (q->counters.gpu != 0u) {
+      libkk_xfb_save_query(cmd, kk_grid_1d(1u), true, addr,
+                           q->counters.gpu + 2u * index * sizeof(uint32_t),
+                           written, generated);
+   } else {
+      kk_cmd_write(cmd, (struct libkk_imm_write){addr, written});
+      kk_cmd_write(cmd, (struct libkk_imm_write){addr + 4u, 0u});
+      kk_cmd_write(cmd, (struct libkk_imm_write){addr + 8u, generated});
+      kk_cmd_write(cmd, (struct libkk_imm_write){addr + 12u, 0u});
+   }
+
+   kk_cmd_write(cmd, (struct libkk_imm_write){q->available_addr, true});
+
+   q->active = false;
+}
