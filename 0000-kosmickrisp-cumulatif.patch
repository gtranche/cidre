+/* Vertex count of a direct draw, indexed or not. */
+static uint32_t
+kk_draw_vertex_count(const struct kk_draw_command *data)
+{
+   if (data->indirect || data->draw_count != 1)
+      return 0u;
+
+   return data->indexed ? data->indexed_draws[0].indexCount
+                        : data->draws[0].vertexCount;
+}
+
+static uint32_t
+kk_draw_instance_count(const struct kk_draw_command *data)
+{
+   if (data->indirect || data->draw_count != 1)
+      return 0u;
+
+   return data->indexed ? data->indexed_draws[0].instanceCount
+                        : data->draws[0].instanceCount;
+}
+
 static void
+kk_flush_xfb_state(struct kk_cmd_buffer *cmd, const struct kk_draw_command *data)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_descriptor_state *desc = &gfx->descriptors;
+   const struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+
+   /* Only shaders that capture read any of this. */
+   if (vs == NULL || !vs->info.vs.has_xfb)
+      return;
+
+   desc->root_dirty = true;
+
+   struct kk_ptr counters = kk_xfb_counters(cmd);
+   for (unsigned i = 0u; i < MAX_XFB_BUFFERS; ++i) {
+      desc->root.draw.xfb_counter[i] =
+         counters.gpu ? counters.gpu + i * sizeof(uint32_t) : 0u;
+   }
+
+   uint64_t prims = kk_prims_for_vertices(data->prim,
+                                          kk_draw_vertex_count(data)) *
+                    kk_draw_instance_count(data);
+
+   if (!kk_xfb_draw_captures(cmd, data)) {
+      memset(desc->root.draw.xfb_size, 0, sizeof(desc->root.draw.xfb_size));
+
+      /* The stream still produces primitives, they are just not captured. */
+      if (gfx->xfb.query[0].active)
+         gfx->xfb.query[0].generated += prims;
+
+      return;
+   }
+
+   const VkDrawIndirectCommand *draw = &data->draws[0];
+
+   /* Vertices that still fit in every buffer this shader captures into. */
+   uint64_t vertices_that_fit = UINT64_MAX;
+
+   for (unsigned i = 0; i < MAX_XFB_BUFFERS; ++i) {
+      /* info.vs.xfb_stride is in words, like nir_shader_info. */
+      uint64_t stride = (uint64_t)vs->info.vs.xfb_stride[i] * 4u;
+      uint64_t size = gfx->xfb.buffers[i].size;
+      uint64_t used = gfx->xfb.written[i];
+
+      if (stride == 0u)
+         continue;
+
+      if (used >= size) {
+         desc->root.draw.xfb_address[i] = 0u;
+         desc->root.draw.xfb_size[i] = 0u;
+         vertices_that_fit = 0u;
+         continue;
+      }
+
+      desc->root.draw.xfb_address[i] = gfx->xfb.buffers[i].addr + used;
+      desc->root.draw.xfb_size[i] = MIN2(size - used, UINT32_MAX);
+
+      vertices_that_fit = MIN2(vertices_that_fit, (size - used) / stride);
