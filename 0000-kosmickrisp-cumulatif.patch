+/* Metal's indirect compute dispatch counts threadgroups, so an indirect draw
+ * has to round the grid up and ends up running invocations past the real
+ * vertex or primitive count. poly's programs do not bound-check, so wrap the
+ * body in a test here. The limit sits in the parameter buffer the program
+ * already reads and is filled in for direct draws too, so the guard costs one
+ * scalar load whichever kind of draw follows.
+ */
+static bool
+kk_gather_fs_input_components(nir_builder *b, nir_intrinsic_instr *intr,
+                              void *data)
+{
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_input:
+   case nir_intrinsic_load_interpolated_input:
+   case nir_intrinsic_load_per_primitive_input:
+      break;
+   default:
+      return false;
+   }
+
+   uint8_t *comps = data;
+   unsigned slot = nir_intrinsic_io_semantics(intr).location;
+   unsigned end = nir_intrinsic_component(intr) + intr->def.num_components;
+
+   comps[slot] = MAX2(comps[slot], end);
+   return false;
+}
+
+static bool
+kk_trim_gs_rast_outputs(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   const uint8_t *comps = data;
+   unsigned slot = nir_intrinsic_io_semantics(intr).location;
+   unsigned keep = comps[slot];
+   nir_def *value = intr->src[0].ssa;
+
+   if (keep == 0u || keep >= value->num_components)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_src_rewrite(&intr->src[0], nir_trim_vector(b, value, keep));
+   nir_intrinsic_set_write_mask(intr, nir_component_mask(keep));
+   return true;
+}
