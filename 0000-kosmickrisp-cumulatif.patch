+   if (vi != NULL) {
+      u_foreach_bit(i, vi->attributes_valid) {
+         if (i >= KK_MAX_ATTRIBS)
+            continue;
+         const struct vk_vertex_attribute_state *a = &vi->attributes[i];
+         const struct vk_vertex_binding_state *b = &vi->bindings[a->binding];
+         key.attribs[i].valid = 1u;
+         key.attribs[i].format = a->format;
+         key.attribs[i].binding = a->binding;
+         key.attribs[i].divisor = b->divisor;
+         key.attribs[i].input_rate = (uint8_t)b->input_rate;
+      }
+   }
+
+   simple_mtx_lock(&vs->emu_vs_lock);
+   struct hash_entry *entry =
+      _mesa_hash_table_search(vs->emu_vs_pipelines, &key);
+   mtl_compute_pipeline_state *pipe = entry ? entry->data : NULL;
+
+   if (pipe == NULL) {
+      nir_shader *clone = nir_shader_clone(NULL, vs->emu_vs_nir);
+      struct vk_vertex_input_state empty_vi;
+      const struct vk_vertex_input_state *use_vi = vi;
+      if (use_vi == NULL) {
+         memset(&empty_vi, 0, sizeof(empty_vi));
+         use_vi = &empty_vi;
+      }
+      kk_lower_vs_vbo_vi(clone, use_vi, vs->vs_robustness2);
+      NIR_PASS(_, clone, poly_nir_lower_vs_before_gs);
+      NIR_PASS(_, clone, kk_nir_lower_vertex_id_zero_base);
+      clone->info.stage = MESA_SHADER_COMPUTE;
+      memset(&clone->info.cs, 0, sizeof(clone->info.cs));
+      clone->xfb_info = NULL;
+      NIR_PASS(_, clone, poly_nir_lower_sw_vs);
