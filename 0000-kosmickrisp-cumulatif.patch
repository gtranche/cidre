+static VkResult
+kk_compile_graphics_vertex_side(struct kk_device *device, struct kk_shader *vs)
+{
+   struct kk_physical_device *pdev = kk_device_physical(device);
+   VkResult result = VK_SUCCESS;
+   struct kk_pipeline_handles *pipe = &vs->pipeline;
+   const struct msl_compile_data *vs_data;
+
+   if (vs->info.has_gs) {
+      static const struct {
+         enum kk_gs_program slot;
+         size_t handle_offset;
+      } gs_programs[] = {
+         {KK_GS_PROGRAM_COUNT,
+          offsetof(struct kk_pipeline_handles, gfx.gs_count)},
+         {KK_GS_PROGRAM_PRE_GS,
+          offsetof(struct kk_pipeline_handles, gfx.gs_pre)},
+      };
+
+      if (vs->info.vs.additional_stages_bits &
+          BITFIELD_BIT(MESA_SHADER_TESS_CTRL)) {
+         return vk_errorf(device, VK_ERROR_FEATURE_NOT_PRESENT,
+                          "a geometry shader fed by tessellation is not "
+                          "implemented yet");
+      }
+
+      if (vs->emu_vs_nir == NULL) {
+         result = kk_compile_compute_pipeline(
+            device, &vs->msl_data[MESA_SHADER_VERTEX], KK_GS_WORKGROUP_SIZE,
+            &pipe->gfx.pre_render[0]);
+         if (result != VK_SUCCESS)
+            return VK_ERROR_INVALID_SHADER_NV;
+      }
+      pipe->gfx.pre_render_count = 1u;
 
+      result = kk_compile_compute_pipeline(
+         device, &vs->msl_data[MESA_SHADER_GEOMETRY], KK_GS_WORKGROUP_SIZE,
+         &pipe->gfx.gs_main);
+      if (result != VK_SUCCESS)
+         return VK_ERROR_INVALID_SHADER_NV;
+
+      for (unsigned i = 0u; i < ARRAY_SIZE(gs_programs); ++i) {
+         const struct msl_compile_data *data =
+            &vs->gs_msl_data[gs_programs[i].slot];
+         if (data->code == NULL)
+            continue;
+
+         mtl_compute_pipeline_state **handle =
+            (mtl_compute_pipeline_state **)((char *)pipe +
+                                            gs_programs[i].handle_offset);
+
+         result = kk_compile_compute_pipeline(device, data,
+                                              KK_GS_WORKGROUP_SIZE, handle);
+         if (result != VK_SUCCESS)
+            return VK_ERROR_INVALID_SHADER_NV;
+      }
+
+      vs_data = &vs->gs_msl_data[KK_GS_PROGRAM_RAST];
+   } else {
+      if (vs->emu_vs_nir == NULL) {
+         result = kk_compile_compute_pipeline(
+            device, &vs->msl_data[MESA_SHADER_VERTEX], 64u,
+            &pipe->gfx.pre_render[0]);
+         if (result != VK_SUCCESS)
+            return VK_ERROR_INVALID_SHADER_NV;
+      }
+
+      result = kk_compile_compute_pipeline(
+         device, &vs->msl_data[MESA_SHADER_TESS_CTRL],
+         vs->info.vs.tess_local_thread_size, &pipe->gfx.pre_render[1]);
+      if (result != VK_SUCCESS)
+         return VK_ERROR_INVALID_SHADER_NV;
+      pipe->gfx.pre_render_count = 2u;
+
+      vs_data = &vs->msl_data[MESA_SHADER_TESS_EVAL];
+   }
+
+   vs->library =
+      mtl_new_library(device->mtl_compiler_handle, vs_data->code,
+                      pdev->info.msl_version, MTL_MATH_MODE_FAST,
+                      MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
+   if (vs->library == NULL)
+      return VK_ERROR_INVALID_SHADER_NV;
+
+   vs->function = mtl_new_library_function_descriptor(
+      vs->library, vs_data->entrypoint_name);
+   if (vs->function == NULL) {
+      mtl_release(vs->library);
+      vs->library = NULL;
+      return VK_ERROR_INVALID_SHADER_NV;
+   }
+
    return result;
 }
 
+struct kk_shader *
+kk_get_empty_fs_shader(struct kk_device *device)
+{
+   simple_mtx_lock(&device->empty_fs_lock);
+   if (device->empty_fs == NULL) {
+      nir_shader *nir = get_empty_nir(device, MESA_SHADER_FRAGMENT, NULL, 0);
+      struct kk_shader *fs = NULL;
+      VkResult result = kk_compile_shader(device, nir, NULL, &rs_none, NULL,
+                                          NULL, NULL, &fs);
+      if (result == VK_SUCCESS) {
+         result = kk_build_stage_library(device, fs);
+         if (result != VK_SUCCESS) {
+            kk_shader_destroy(&device->vk, fs, NULL);
+            fs = NULL;
+         }
+      }
+      device->empty_fs = fs;
+   }
+   simple_mtx_unlock(&device->empty_fs_lock);
+   return device->empty_fs;
+}
