+
+#include "compiler/libcl/libcl_vk.h"
+#include "poly/geometry.h"
+
+KERNEL(1)
+libkk_xfb_save_counter(global uint32_t *dst, constant uint32_t *counter,
+                       uint32_t added)
+{
+   *dst = *counter + added;
+}
+
+KERNEL(1024)
+libkk_prefix_sum_geom(constant struct poly_geometry_params *p)
+{
+   local uint scratch[32];
+   poly_prefix_sum(scratch, p->count_buffer, p->input_primitives,
+                   p->count_buffer_stride / 4, cl_group_id.x, 1024);
+}
+
+KERNEL(1)
+libkk_xfb_save_query(global uint64_t *dst, constant uint32_t *counters,
+                     uint32_t cpu_written, uint32_t cpu_generated)
+{
+   dst[0] = (uint64_t)counters[1] + cpu_written;
+   dst[1] = (uint64_t)counters[0] + cpu_generated;
+}
+
+KERNEL(1)
+libkk_xfb_draw_indirect_byte_count(global uint32_t *out,
+                                   constant uint32_t *counter,
+                                   uint32_t counter_offset,
+                                   uint32_t vertex_stride,
+                                   uint32_t instance_count,
+                                   uint32_t first_instance)
+{
+   uint32_t bytes = *counter;
+
+   bytes = bytes > counter_offset ? (bytes - counter_offset) : 0u;
+
+   out[0] = vertex_stride ? (bytes / vertex_stride) : 0u;
+   out[1] = instance_count;
+   out[2] = 0u;
+   out[3] = first_instance;
+}
+
+KERNEL(1)
+libkk_xfb_account_tess(global uint32_t *counters, global uint32_t *snapshot,
+                       global uint32_t *query, constant uint32_t *draw,
+                       uint32_t verts_per_prim, uint32_t stride0,
+                       uint32_t stride1, uint32_t stride2, uint32_t stride3,
+                       uint32_t size0, uint32_t size1, uint32_t size2,
+                       uint32_t size3)
+{
+   uint32_t strides[4] = {stride0, stride1, stride2, stride3};
+   uint32_t sizes[4] = {size0, size1, size2, size3};
+   uint32_t total = draw[0];
+   uint32_t fits = 0xffffffffu;
+
+   for (uint32_t i = 0u; i < 4u; ++i) {
+      uint32_t used = counters[i];
+
+      snapshot[i] = used;
+
+      if (strides[i] == 0u)
+         continue;
+
+      uint32_t room = sizes[i] > used ? sizes[i] - used : 0u;
+
+      fits = min(fits, room / strides[i]);
+      counters[i] = used + total * strides[i];
+   }
+
+   if (query && verts_per_prim) {
+      uint32_t prims = total / verts_per_prim;
+      uint32_t captured = min(total, fits) / verts_per_prim;
+
+      query[0] += prims;
+      query[1] += min(prims, captured);
+   }
+}
