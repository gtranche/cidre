+   desc[7] = 0;
+   desc[8] = 0;
 }
+
+/* Geometry shader emulation, indirect draw. Only the GPU knows the vertex and
+ * instance counts, so poly fills in the parameter buffers here, and we turn
+ * the thread counts it computed into the threadgroup counts Metal's indirect
+ * dispatch expects. Invocations past the real count are dropped by the guard
+ * kk_shader.c puts at the top of each emulated program.
+ */
+KERNEL(1)
+libkk_gs_setup_indirect(uint64_t index_buffer, constant uint *draw,
+                        global struct poly_vertex_params *vp /* output */,
+                        global struct poly_geometry_params *p /* output */,
+                        global struct poly_heap *heap,
+                        global uint32_t *grids /* output: VS then GS */,
+                        uint32_t local_size_x, uint64_t vs_outputs,
+                        uint32_t index_size_B, uint32_t index_buffer_range_el,
+                        uint32_t prim, int is_prefix_summing,
+                        uint32_t max_indices, uint32_t shape)
+{
+   poly_gs_setup_indirect(index_buffer, draw, vp, p, heap, vs_outputs,
+                          index_size_B, index_buffer_range_el, prim,
+                          is_prefix_summing, max_indices,
+                          (enum poly_gs_shape)shape);
+
+   grids[0] = DIV_ROUND_UP(vp->grid[0], local_size_x);
+   grids[1] = vp->grid[1];
+   grids[2] = 1;
+
+   grids[3] = DIV_ROUND_UP(p->grid[0], local_size_x);
+   grids[4] = p->grid[1];
+   grids[5] = 1;
+}
