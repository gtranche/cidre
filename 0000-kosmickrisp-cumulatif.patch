+++ b/src/kosmickrisp/vulkan/kk_indirect_commands.c
@@ -0,0 +1,256 @@
+/*
+ * Copyright 2026 Guillaume Tranchepain
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kk_indirect_commands.h"
+
+#include "kk_cmd_buffer.h"
+#include "kk_device.h"
+#include "kk_entrypoints.h"
+
+#include <string.h>
+#include "kk_physical_device.h"
+
+#include "kosmickrisp/libkk/libkk.h"
+
+static VkResult
+kk_dgc_layout_add_push(struct kk_indirect_commands_layout *layout,
+                       const VkIndirectCommandsLayoutTokenEXT *token,
+                       bool sequence_index)
+{
+   if (layout->push_token_count >= KK_MAX_DGC_PUSH_TOKENS)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   const VkIndirectCommandsPushConstantTokenEXT *pc = token->data.pPushConstant;
+   if (pc == NULL)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   if (pc->updateRange.offset + pc->updateRange.size > KK_MAX_PUSH_SIZE)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   struct kk_dgc_push_token *dst =
+      &layout->push_tokens[layout->push_token_count++];
+
+   dst->stream_offset = token->offset;
+   dst->push_offset = pc->updateRange.offset;
+   dst->size = pc->updateRange.size;
+   dst->sequence_index = sequence_index;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+kk_dgc_layout_set_action(struct kk_indirect_commands_layout *layout,
+                         enum kk_dgc_action action, uint32_t offset)
+{
+   if (layout->action != KK_DGC_ACTION_NONE)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   layout->action = action;
+   layout->action_offset = offset;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+kk_dgc_layout_parse(struct kk_indirect_commands_layout *layout,
+                    const VkIndirectCommandsLayoutCreateInfoEXT *info)
+{
+   for (uint32_t i = 0; i < info->tokenCount; i++) {
+      const VkIndirectCommandsLayoutTokenEXT *token = &info->pTokens[i];
+      VkResult result;
+
+      switch (token->type) {
+      case VK_INDIRECT_COMMANDS_TOKEN_TYPE_PUSH_CONSTANT_EXT:
+      case VK_INDIRECT_COMMANDS_TOKEN_TYPE_PUSH_DATA_EXT:
+         result = kk_dgc_layout_add_push(layout, token, false);
+         break;
+
+      case VK_INDIRECT_COMMANDS_TOKEN_TYPE_SEQUENCE_INDEX_EXT:
+      case VK_INDIRECT_COMMANDS_TOKEN_TYPE_PUSH_DATA_SEQUENCE_INDEX_EXT:
+         result = kk_dgc_layout_add_push(layout, token, true);
+         break;
+
+      case VK_INDIRECT_COMMANDS_TOKEN_TYPE_DRAW_EXT:
+         result = kk_dgc_layout_set_action(layout, KK_DGC_ACTION_DRAW,
+                                           token->offset);
+         break;
+
+      case VK_INDIRECT_COMMANDS_TOKEN_TYPE_DRAW_INDEXED_EXT:
+         result = kk_dgc_layout_set_action(layout, KK_DGC_ACTION_DRAW_INDEXED,
+                                           token->offset);
+         break;
+
+      case VK_INDIRECT_COMMANDS_TOKEN_TYPE_DISPATCH_EXT:
+         result = kk_dgc_layout_set_action(layout, KK_DGC_ACTION_DISPATCH,
+                                           token->offset);
+         break;
+
+      default:
+         result = VK_ERROR_FEATURE_NOT_PRESENT;
+         break;
+      }
+
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   if (layout->action == KK_DGC_ACTION_NONE)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_CreateIndirectCommandsLayoutEXT(
+   VkDevice device, const VkIndirectCommandsLayoutCreateInfoEXT *pCreateInfo,
+   const VkAllocationCallbacks *pAllocator,
+   VkIndirectCommandsLayoutEXT *pIndirectCommandsLayout)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   struct kk_indirect_commands_layout *layout;
+
+   layout = vk_object_zalloc(&dev->vk, pAllocator, sizeof(*layout),
+                             VK_OBJECT_TYPE_INDIRECT_COMMANDS_LAYOUT_EXT);
+   if (!layout)
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   layout->flags = pCreateInfo->flags;
+   layout->shader_stages = pCreateInfo->shaderStages;
+   layout->indirect_stride = pCreateInfo->indirectStride;
+
+   VkResult result = kk_dgc_layout_parse(layout, pCreateInfo);
+   if (result != VK_SUCCESS) {
+      vk_object_free(&dev->vk, pAllocator, layout);
+      return vk_error(dev, result);
+   }
+
+   *pIndirectCommandsLayout = kk_indirect_commands_layout_to_handle(layout);
+
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_DestroyIndirectCommandsLayoutEXT(
+   VkDevice device, VkIndirectCommandsLayoutEXT indirectCommandsLayout,
+   const VkAllocationCallbacks *pAllocator)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   VK_FROM_HANDLE(kk_indirect_commands_layout, layout, indirectCommandsLayout);
+
+   if (!layout)
+      return;
+
+   vk_object_free(&dev->vk, pAllocator, layout);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_GetGeneratedCommandsMemoryRequirementsEXT(
+   VkDevice device, const VkGeneratedCommandsMemoryRequirementsInfoEXT *pInfo,
+   VkMemoryRequirements2 *pMemoryRequirements)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   VK_FROM_HANDLE(kk_indirect_commands_layout, layout,
+                  pInfo->indirectCommandsLayout);
+   struct kk_physical_device *pdev = kk_device_physical(dev);
+
+   uint64_t size = 0u;
+   if (layout->push_token_count != 0u) {
+      size = (uint64_t)pInfo->maxSequenceCount *
+             sizeof(struct kk_root_descriptor_table);
+   }
+
+   pMemoryRequirements->memoryRequirements = (VkMemoryRequirements){
+      .size = size,
+      .alignment = 256u,
+      .memoryTypeBits = BITFIELD_MASK(pdev->mem_type_count),
+   };
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_CreateIndirectExecutionSetEXT(
+   VkDevice device, const VkIndirectExecutionSetCreateInfoEXT *pCreateInfo,
+   const VkAllocationCallbacks *pAllocator,
+   VkIndirectExecutionSetEXT *pIndirectExecutionSet)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+
+   return vk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_DestroyIndirectExecutionSetEXT(
+   VkDevice device, VkIndirectExecutionSetEXT indirectExecutionSet,
+   const VkAllocationCallbacks *pAllocator)
+{
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_UpdateIndirectExecutionSetPipelineEXT(
+   VkDevice device, VkIndirectExecutionSetEXT indirectExecutionSet,
+   uint32_t executionSetWriteCount,
+   const VkWriteIndirectExecutionSetPipelineEXT *pExecutionSetWrites)
+{
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_UpdateIndirectExecutionSetShaderEXT(
+   VkDevice device, VkIndirectExecutionSetEXT indirectExecutionSet,
+   uint32_t executionSetWriteCount,
+   const VkWriteIndirectExecutionSetShaderEXT *pExecutionSetWrites)
+{
+}
+
+uint64_t
+kk_dgc_build_roots(struct kk_cmd_buffer *cmd,
+                   const struct kk_indirect_commands_layout *layout,
+                   const VkGeneratedCommandsInfoEXT *info,
+                   VkPipelineBindPoint bind_point)
+{
+   if (layout->push_token_count == 0u)
+      return 0u;
+
+   struct kk_descriptor_state *desc =
+      kk_get_descriptors_state(cmd, bind_point);
+
+   if (desc->push_dirty)
+      kk_cmd_buffer_flush_push_descriptors(cmd, desc);
+
+   uint64_t base_root = kk_upload_descriptor_root(cmd, bind_point);
+   if (unlikely(!base_root))
+      return 0u;
+
+   uint32_t token_data[KK_MAX_DGC_PUSH_TOKENS * 4u];
+   for (uint32_t i = 0; i < layout->push_token_count; i++) {
+      const struct kk_dgc_push_token *t = &layout->push_tokens[i];
+      token_data[i * 4u + 0u] = t->stream_offset / 4u;
+      token_data[i * 4u + 1u] = t->push_offset / 4u;
+      token_data[i * 4u + 2u] = t->size / 4u;
+      token_data[i * 4u + 3u] = t->sequence_index ? 1u : 0u;
+   }
+
+   struct kk_ptr tokens = kk_pool_upload(
+      cmd, token_data, layout->push_token_count * 4u * sizeof(uint32_t), 4u);
+   if (unlikely(!tokens.gpu))
+      return 0u;
+
+   uint64_t out_va = info->preprocessAddress;
+
+   libkk_dgc_patch_root_struct(
+      cmd, kk_grid_1d(info->maxSequenceCount), true,
+      ((struct libkk_dgc_patch_root_args){
+         .out_roots = out_va,
+         .base_root = base_root,
+         .stream = info->indirectAddress,
+         .tokens = tokens.gpu,
+         .out_base_va = out_va,
+         .root_dwords = sizeof(struct kk_root_descriptor_table) / 4u,
+         .stream_stride_dw = layout->indirect_stride / 4u,
+         .token_count = layout->push_token_count,
+         .push_base_dw = offsetof(struct kk_root_descriptor_table, push) / 4u,
+      }));
+
+   return out_va;
+}
+
