+mtl_function_descriptor *
+kk_get_vs_function(struct kk_device *device, struct kk_shader *vs,
+                   const struct vk_vertex_input_state *vi)
+{
+   if (vs->vs_nir == NULL)
+      return vs->function;
+
+   struct kk_physical_device *pdev = kk_device_physical(device);
+
+   struct kk_vs_variant_key key;
+   memset(&key, 0, sizeof(key));
+   if (vi != NULL) {
+      u_foreach_bit(i, vi->attributes_valid) {
+         if (i >= KK_MAX_ATTRIBS)
+            continue;
+         const struct vk_vertex_attribute_state *a = &vi->attributes[i];
+         const struct vk_vertex_binding_state *b = &vi->bindings[a->binding];
+         key.attribs[i].valid = 1u;
+         key.attribs[i].format = a->format;
+         key.attribs[i].binding = a->binding;
+         key.attribs[i].divisor = b->divisor;
+         key.attribs[i].input_rate = (uint8_t)b->input_rate;
+      }
+   }
+
+   simple_mtx_lock(&vs->vs_variant_lock);
+   struct hash_entry *entry = _mesa_hash_table_search(vs->vs_variants, &key);
+   struct kk_vs_variant *variant = entry ? entry->data : NULL;
+
+   if (variant == NULL) {
+      nir_shader *clone = nir_shader_clone(NULL, vs->vs_nir);
+      struct vk_vertex_input_state empty_vi;
+      const struct vk_vertex_input_state *use_vi = vi;
+      if (use_vi == NULL) {
+         memset(&empty_vi, 0, sizeof(empty_vi));
+         use_vi = &empty_vi;
+      }
+      kk_lower_vs_vbo_vi(clone, use_vi, vs->vs_robustness2);
+      NIR_PASS(_, clone, msl_nir_lower_instance_id);
+
+      struct nir_to_msl_options opts = {
+         .mem_ctx = NULL,
+         .disabled_workarounds = pdev->settings.disabled_workarounds,
+      };
+      struct msl_compile_data data = {0};
+      kk_nir_to_msl_data(clone, &opts, &data);
+      ralloc_free(clone);
+
+      mtl_library *lib = mtl_new_library(
+         device->mtl_compiler_handle, data.code, pdev->info.msl_version,
+         MTL_MATH_MODE_FAST, MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
+      mtl_function_descriptor *fn =
+         lib ? mtl_new_library_function_descriptor(lib, data.entrypoint_name)
+             : NULL;
+
+      ralloc_free((void *)data.code);
+      ralloc_free((void *)data.entrypoint_name);
+
+      if (fn != NULL) {
+         variant = ralloc(vs->vs_variants, struct kk_vs_variant);
+         struct kk_vs_variant_key *stored =
+            ralloc(vs->vs_variants, struct kk_vs_variant_key);
+         if (variant != NULL && stored != NULL) {
+            variant->library = lib;
+            variant->function = fn;
+            *stored = key;
+            _mesa_hash_table_insert(vs->vs_variants, stored, variant);
+         } else {
+            mtl_release(fn);
+            mtl_release(lib);
+            variant = NULL;
+         }
+      } else if (lib != NULL) {
+         mtl_release(lib);
+      }
+   }
+
+   mtl_function_descriptor *result = variant ? variant->function : NULL;
+   simple_mtx_unlock(&vs->vs_variant_lock);
+   return result;
+}
