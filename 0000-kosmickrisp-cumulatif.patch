+       * primitives whose vertices all fit count as written. */
+      uint64_t captured_vertices =
+         MIN2((uint64_t)draw->vertexCount * draw->instanceCount,
+              vertices_that_fit);
+
+      gfx->xfb.query[0].written +=
+         MIN2(prims, kk_prims_for_vertices(data->prim, captured_vertices));
+   }
+}
