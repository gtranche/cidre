+   uint32_t components;
+   uint32_t int_format;
+};
+
+static uint32_t
+kk_texel_view_hash(const void *key)
+{
+   return _mesa_hash_data(key, sizeof(struct kk_texel_view_key));
+}
+
+static bool
+kk_texel_view_equal(const void *a, const void *b)
+{
+   return memcmp(a, b, sizeof(struct kk_texel_view_key)) == 0;
+}
+
+void
+kk_address_registry_init(struct kk_address_registry *registry)
+{
+   simple_mtx_init(&registry->mutex, mtx_plain);
+   util_dynarray_init(&registry->bos, NULL);
+}
+
+void
+kk_address_registry_finish(struct kk_address_registry *registry)
+{
+   util_dynarray_fini(&registry->bos);
+   simple_mtx_destroy(&registry->mutex);
+}
+
+static uint32_t
+kk_address_registry_first_above(struct kk_address_registry *registry,
+                                uint64_t address)
+{
+   struct kk_bo **data = util_dynarray_begin(&registry->bos);
+   uint32_t count = util_dynarray_num_elements(&registry->bos, struct kk_bo *);
+   uint32_t lo = 0u, hi = count;
+
+   while (lo < hi) {
+      uint32_t mid = lo + (hi - lo) / 2u;
+      if (data[mid]->gpu <= address)
+         lo = mid + 1u;
+      else
+         hi = mid;
+   }
+
+   return lo;
+}
+
+void
+kk_address_registry_add(struct kk_address_registry *registry,
+                        struct kk_bo *bo)
+{
+   simple_mtx_lock(&registry->mutex);
+
+   uint32_t at = kk_address_registry_first_above(registry, bo->gpu);
+   uint32_t count = util_dynarray_num_elements(&registry->bos, struct kk_bo *);
+
+   struct kk_bo **slot =
+      util_dynarray_grow(&registry->bos, struct kk_bo *, 1u);
+   if (slot != NULL) {
+      struct kk_bo **data = util_dynarray_begin(&registry->bos);
+      memmove(data + at + 1u, data + at, (count - at) * sizeof(*data));
+      data[at] = bo;
+   }
+
+   simple_mtx_unlock(&registry->mutex);
+}
+
+void
+kk_address_registry_remove(struct kk_address_registry *registry,
+                           struct kk_bo *bo)
+{
+   simple_mtx_lock(&registry->mutex);
+
+   struct kk_bo **data = util_dynarray_begin(&registry->bos);
+   uint32_t count = util_dynarray_num_elements(&registry->bos, struct kk_bo *);
+
+   for (uint32_t i = 0u; i < count; ++i) {
+      if (data[i] != bo)
+         continue;
+
+      memmove(data + i, data + i + 1u, (count - i - 1u) * sizeof(*data));
+      registry->bos.size -= sizeof(*data);
+      break;
+   }
+
+   simple_mtx_unlock(&registry->mutex);
+}
+
+struct kk_bo *
+kk_address_registry_lookup(struct kk_address_registry *registry,
+                           uint64_t address, uint64_t *offset_B_out)
+{
+   struct kk_bo *found = NULL;
+
+   simple_mtx_lock(&registry->mutex);
+
+   uint32_t at = kk_address_registry_first_above(registry, address);
+   if (at > 0u) {
+      struct kk_bo **data = util_dynarray_begin(&registry->bos);
+      struct kk_bo *bo = data[at - 1u];
+
+      if (address >= bo->gpu && address < bo->gpu + bo->size_B) {
+         found = bo;
+         if (offset_B_out != NULL)
+            *offset_B_out = address - bo->gpu;
+      }
+   }
+
+   simple_mtx_unlock(&registry->mutex);
+
+   return found;
+}
+
+void
+kk_texel_view_cache_init(struct kk_texel_view_cache *cache)
+{
+   simple_mtx_init(&cache->mutex, mtx_plain);
+   cache->views = (struct hash_table_u64 *)_mesa_hash_table_create(
+      NULL, kk_texel_view_hash, kk_texel_view_equal);
+}
+
+void
+kk_texel_view_cache_finish(struct kk_texel_view_cache *cache)
+{
+   struct hash_table *table = (struct hash_table *)cache->views;
+
+   if (table != NULL) {
+      hash_table_foreach(table, slot) {
+         struct kk_texel_view_entry *entry = slot->data;
+         list_del(&entry->link);
+         mtl_release(entry->handle);
+         FREE(entry);
+      }
+      _mesa_hash_table_destroy(table, NULL);
+      cache->views = NULL;
+   }
+
+   simple_mtx_destroy(&cache->mutex);
+}
+
+void
+kk_texel_view_cache_drop_bo(struct kk_device *dev, struct kk_bo *bo)
+{
+   struct kk_texel_view_cache *cache = &dev->texel_views;
+   struct hash_table *table = (struct hash_table *)cache->views;
+
+   if (table == NULL)
+      return;
+
+   simple_mtx_lock(&cache->mutex);
+
+   list_for_each_entry_safe(struct kk_texel_view_entry, entry, &bo->texel_views,
+                            link) {
+      struct hash_entry *slot = _mesa_hash_table_search(table, &entry->key);
+
+      if (slot != NULL)
+         _mesa_hash_table_remove(table, slot);
+
+      list_del(&entry->link);
+      mtl_release(entry->handle);
+      FREE(entry);
+   }
+
+   simple_mtx_unlock(&cache->mutex);
+}
+
+static struct kk_texel_view_entry *
+kk_texel_view_create(struct kk_device *dev, const struct kk_texel_view_key *key)
+{
+   uint64_t offset_B = 0u;
+   struct kk_bo *bo =
+      kk_address_registry_lookup(&dev->addresses, key->base, &offset_B);
+
+   if (bo == NULL || bo->map == NULL || offset_B != 0u)
+      return NULL;
+
+   uint32_t components = 1u;
+   VkFormat vk_format = key->format;
+
+   switch (vk_format) {
+   case VK_FORMAT_R32G32B32_UINT:
+      vk_format = VK_FORMAT_R32_UINT;
+      components = 3u;
+      break;
+   case VK_FORMAT_R32G32B32_SINT:
+      vk_format = VK_FORMAT_R32_SINT;
+      components = 3u;
+      break;
+   case VK_FORMAT_R32G32B32_SFLOAT:
+      vk_format = VK_FORMAT_R32_SFLOAT;
+      components = 3u;
+      break;
+   default:
+      break;
+   }
+
+   enum pipe_format p_format = vk_format_to_pipe_format(vk_format);
+   const struct kk_va_format *supported = kk_get_va_format(p_format);
+
+   if (supported == NULL)
+      return NULL;
+
+   uint32_t texel_size_B = util_format_get_blocksize(p_format);
+   if (texel_size_B == 0u)
+      return NULL;
+
+   uint64_t elements = bo->size_B / texel_size_B;
+   if (elements == 0u || elements > KK_MAX_TEXEL_BUFFER_ELEMENTS)
+      return NULL;
+
+   enum mtl_texture_usage usage = MTL_TEXTURE_USAGE_SHADER_READ;
+   if (supported->texel_buffer.write)
+      usage |= MTL_TEXTURE_USAGE_SHADER_WRITE;
+   if (vk_format == VK_FORMAT_R32_UINT || vk_format == VK_FORMAT_R32_SINT)
+      usage |= MTL_TEXTURE_USAGE_SHADER_ATOMIC;
+
+   struct kk_image_layout layout = {
+      .width_px = elements,
+      .height_px = 1u,
+      .depth_px = 1u,
+      .layers = 1u,
+      .type = MTL_TEXTURE_TYPE_TEXTURE_BUFFER,
+      .sample_count_sa = 1u,
+      .levels = 1u,
+      .linear = true,
+      .optimized_layout = false,
+      .usage = usage,
+      .format = {.pipe = p_format, .mtl = supported->mtl_pixel_format},
+      .swizzle =
+         {
+            .red = supported->unswizzle.red,
+            .green = supported->unswizzle.green,
+            .blue = supported->unswizzle.blue,
+            .alpha = supported->unswizzle.alpha,
+         },
+      .linear_stride_B = elements * texel_size_B,
+   };
+
+   mtl_texture *handle =
+      mtl_new_texture_with_descriptor_linear(bo->map, &layout, 0u);
+   if (handle == NULL)
+      return NULL;
+
+   struct kk_texel_view_entry *entry = CALLOC_STRUCT(kk_texel_view_entry);
+   if (entry == NULL) {
+      mtl_release(handle);
+      return NULL;
+   }
+
+   entry->key = *key;
+   entry->bo = bo;
+   list_addtail(&entry->link, &bo->texel_views);
+   entry->handle = handle;
+   entry->gpu_resource_id = mtl_texture_get_gpu_resource_id(handle);
+   entry->texel_size_B = texel_size_B;
+   entry->components = components;
+   entry->int_format = util_format_is_pure_integer(p_format) ? 1u : 0u;
+
+   return entry;
+}
+
+static void
+kk_get_texel_buffer_desc(struct kk_device *dev,
+                         const VkDescriptorAddressInfoEXT *info, void *dst,
+                         size_t dst_size)
+{
+   struct kk_texel_buffer_descriptor desc = {};
+
+   if (info != NULL && info->address != 0u && info->range != 0u) {
+      uint64_t offset_B = 0u;
+      struct kk_bo *bo =
+         kk_address_registry_lookup(&dev->addresses, info->address, &offset_B);
+
+      if (bo != NULL) {
+         struct kk_texel_view_key key = {
+            .base = bo->gpu,
+            .format = info->format,
+         };
+         struct kk_texel_view_cache *cache = &dev->texel_views;
+         struct hash_table *table = (struct hash_table *)cache->views;
+
+         simple_mtx_lock(&cache->mutex);
+
+         struct hash_entry *slot =
+            table ? _mesa_hash_table_search(table, &key) : NULL;
+         struct kk_texel_view_entry *entry = slot ? slot->data : NULL;
+
+         if (entry == NULL && table != NULL) {
+            entry = kk_texel_view_create(dev, &key);
+            if (entry != NULL)
+               _mesa_hash_table_insert(table, &entry->key, entry);
+         }
+
+         if (entry != NULL && offset_B % entry->texel_size_B == 0u) {
+            uint64_t element_B = entry->texel_size_B * entry->components;
+            uint64_t count = info->range / element_B;
+
+            desc.image_gpu_resource_id = entry->gpu_resource_id;
+            desc.texel_offset = offset_B / entry->texel_size_B;
+            desc.texel_count =
+               MIN2(count, KK_TEXEL_COUNT_MASK) |
+               ((entry->components == 3u ? KK_TEXEL_MUL_THREE : KK_TEXEL_MUL_ONE)
+                << KK_TEXEL_MUL_SHIFT) |
+               (entry->int_format << KK_TEXEL_INT_SHIFT);
+         }
+
+         simple_mtx_unlock(&cache->mutex);
+
+      }
+   }
+
+   assert(sizeof(desc) <= dst_size);
+   memcpy(dst, &desc, MIN2(sizeof(desc), dst_size));
+}
+
+static void
+kk_get_buffer_address_desc(const VkDescriptorAddressInfoEXT *info, void *dst,
+                           size_t dst_size)
+{
+   struct kk_buffer_address desc = {};
+
+   if (info != NULL && info->address != 0u) {
+      desc.base_addr = info->address;
+      desc.size = MIN2(info->range, UINT32_MAX);
+   }
+
+   assert(sizeof(desc) <= dst_size);
+   memcpy(dst, &desc, MIN2(sizeof(desc), dst_size));
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_GetDescriptorEXT(VkDevice _device,
+                    const VkDescriptorGetInfoEXT *pDescriptorInfo,
+                    size_t dataSize, void *pDescriptor)
+{
+   VK_FROM_HANDLE(kk_device, dev, _device);
+
+   switch (pDescriptorInfo->type) {
+   case VK_DESCRIPTOR_TYPE_SAMPLER: {
+      VkDescriptorImageInfo info = {
+         .sampler = pDescriptorInfo->data.pSampler
+                       ? *pDescriptorInfo->data.pSampler
+                       : VK_NULL_HANDLE,
+      };
+      if (info.sampler == VK_NULL_HANDLE)
+         memset(pDescriptor, 0, dataSize);
+      else
+         kk_get_sampled_image_view_desc(pDescriptorInfo->type, &info,
+                                        pDescriptor, dataSize, false);
+      break;
+   }
+
+   case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+      kk_get_sampled_image_view_desc(
+         pDescriptorInfo->type, pDescriptorInfo->data.pCombinedImageSampler,
+         pDescriptor, dataSize, false);
+      break;
+
+   case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+      kk_get_sampled_image_view_desc(pDescriptorInfo->type,
+                                     pDescriptorInfo->data.pSampledImage,
+                                     pDescriptor, dataSize, false);
+      break;
+
+   case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+      kk_get_sampled_image_view_desc(
+         pDescriptorInfo->type, pDescriptorInfo->data.pInputAttachmentImage,
+         pDescriptor, dataSize, true);
+      break;
+
+   case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+      kk_get_storage_image_view_desc(pDescriptorInfo->data.pStorageImage,
+                                     pDescriptor, dataSize);
+      break;
+
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+      kk_get_buffer_address_desc(pDescriptorInfo->data.pUniformBuffer,
+                                 pDescriptor, dataSize);
+      break;
+
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+      kk_get_buffer_address_desc(pDescriptorInfo->data.pStorageBuffer,
+                                 pDescriptor, dataSize);
+      break;
+
+   case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+      kk_get_texel_buffer_desc(dev, pDescriptorInfo->data.pUniformTexelBuffer,
+                               pDescriptor, dataSize);
+      break;
+
+   case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+      kk_get_texel_buffer_desc(dev, pDescriptorInfo->data.pStorageTexelBuffer,
+                               pDescriptor, dataSize);
+      break;
+
+   default:
+      memset(pDescriptor, 0, dataSize);
+      break;
+   }
+}
