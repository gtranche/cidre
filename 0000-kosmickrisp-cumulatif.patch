+   full.topology = key->topology;
+   memcpy(full.blend, key->blend, sizeof(full.blend));
+   memcpy(full.blend_write_mask, key->blend_write_mask,
+          sizeof(full.blend_write_mask));
+   full.vs_function = vs_function;
+   full.fs_function = fs->function;
+
+   simple_mtx_lock(&device->rp_variant_lock);
+
+   struct hash_entry *entry =
+      _mesa_hash_table_search(device->rp_variant_cache, &full);
+   mtl_render_pipeline_state *state = entry ? entry->data : NULL;
+
+   if (state == NULL) {
+      state = kk_build_render_pipeline(device, vs_function, vs, fs, &full);
+      if (state != NULL) {
+         struct kk_rp_variant_key *stored =
+            ralloc(device->rp_variant_cache, struct kk_rp_variant_key);
