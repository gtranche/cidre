+kk_shm_create(uint64_t size_B)
+{
+   static uint32_t serial;
+   char name[64];
+   int fd = -1;
+
+   for (unsigned i = 0u; i < 64u && fd < 0; ++i) {
+      snprintf(name, sizeof(name), "/kk-%d-%u", (int)getpid(),
+               p_atomic_inc_return(&serial));
