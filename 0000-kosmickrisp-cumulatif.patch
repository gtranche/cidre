+static bool
+kk_blend_factor_to_mtl(VkBlendFactor factor, enum mtl_blend_factor *out)
+{
+   switch (factor) {
+   case VK_BLEND_FACTOR_ZERO: *out = MTL_BLEND_FACTOR_ZERO; return true;
+   case VK_BLEND_FACTOR_ONE: *out = MTL_BLEND_FACTOR_ONE; return true;
+   case VK_BLEND_FACTOR_SRC_COLOR: *out = MTL_BLEND_FACTOR_SRC_COLOR; return true;
+   case VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR:
+      *out = MTL_BLEND_FACTOR_ONE_MINUS_SRC_COLOR; return true;
+   case VK_BLEND_FACTOR_DST_COLOR: *out = MTL_BLEND_FACTOR_DST_COLOR; return true;
+   case VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR:
+      *out = MTL_BLEND_FACTOR_ONE_MINUS_DST_COLOR; return true;
+   case VK_BLEND_FACTOR_SRC_ALPHA: *out = MTL_BLEND_FACTOR_SRC_ALPHA; return true;
+   case VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA:
+      *out = MTL_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA; return true;
+   case VK_BLEND_FACTOR_DST_ALPHA: *out = MTL_BLEND_FACTOR_DST_ALPHA; return true;
+   case VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA:
+      *out = MTL_BLEND_FACTOR_ONE_MINUS_DST_ALPHA; return true;
+   case VK_BLEND_FACTOR_SRC_ALPHA_SATURATE:
+      *out = MTL_BLEND_FACTOR_SRC_ALPHA_SATURATED; return true;
+   default:
+      return false;
+   }
+}
+
+static bool
+kk_blend_op_to_mtl(VkBlendOp op, enum mtl_blend_operation *out)
+{
+   switch (op) {
+   case VK_BLEND_OP_ADD: *out = MTL_BLEND_OPERATION_ADD; return true;
+   case VK_BLEND_OP_SUBTRACT: *out = MTL_BLEND_OPERATION_SUBTRACT; return true;
+   case VK_BLEND_OP_REVERSE_SUBTRACT:
+      *out = MTL_BLEND_OPERATION_REVERSE_SUBTRACT; return true;
+   case VK_BLEND_OP_MIN: *out = MTL_BLEND_OPERATION_MIN; return true;
+   case VK_BLEND_OP_MAX: *out = MTL_BLEND_OPERATION_MAX; return true;
+   default:
+      return false;
+   }
 }
 
+static bool
+kk_blend_factor_uses_alpha(VkBlendFactor factor)
+{
+   switch (factor) {
+   case VK_BLEND_FACTOR_SRC_ALPHA:
+   case VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA:
+   case VK_BLEND_FACTOR_DST_ALPHA:
+   case VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA:
+   case VK_BLEND_FACTOR_SRC_ALPHA_SATURATE:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static bool
+kk_native_blend_cb(const struct vk_color_blend_state *cb, uint32_t i,
+                   enum pipe_format format, struct mtl_blend_state *blend,
+                   uint8_t *write_mask)
+{
+   if (cb == NULL || cb->logic_op_enable)
+      return false;
+
+   const struct vk_color_blend_attachment_state *att = &cb->attachments[i];
+
+   if (!att->blend_enable || att->write_mask != BITFIELD_MASK(4))
+      return false;
+
+   if (att->color_blend_op >= VK_BLEND_OP_ZERO_EXT ||
+       att->alpha_blend_op >= VK_BLEND_OP_ZERO_EXT)
+      return false;
+
+   bool uses_alpha =
+      kk_blend_factor_uses_alpha(att->src_color_blend_factor) ||
+      kk_blend_factor_uses_alpha(att->dst_color_blend_factor) ||
+      kk_blend_factor_uses_alpha(att->src_alpha_blend_factor) ||
+      kk_blend_factor_uses_alpha(att->dst_alpha_blend_factor);
+
+   if (uses_alpha &&
+       (format == PIPE_FORMAT_NONE || !util_format_has_alpha(format)))
+      return false;
+
+   struct mtl_blend_state out = {.enable = true};
+
+   if (!kk_blend_factor_to_mtl(att->src_color_blend_factor, &out.src_rgb) ||
+       !kk_blend_factor_to_mtl(att->dst_color_blend_factor, &out.dst_rgb) ||
+       !kk_blend_factor_to_mtl(att->src_alpha_blend_factor, &out.src_alpha) ||
+       !kk_blend_factor_to_mtl(att->dst_alpha_blend_factor, &out.dst_alpha) ||
+       !kk_blend_op_to_mtl(att->color_blend_op, &out.rgb_op) ||
+       !kk_blend_op_to_mtl(att->alpha_blend_op, &out.alpha_op))
+      return false;
+
+   *blend = out;
+   *write_mask = BITFIELD_MASK(4);
+   return true;
+}
+
+static bool
+kk_native_blend_rt(const struct vk_graphics_pipeline_state *state, uint32_t i,
+                   struct mtl_blend_state *blend, uint8_t *write_mask)
+{
+   enum pipe_format format =
+      state->rp ? vk_format_to_pipe_format(state->rp->color_attachment_formats[i])
+                : PIPE_FORMAT_NONE;
+   return kk_native_blend_cb(state->cb, i, format, blend, write_mask);
+}
+
+void
+kk_dynamic_blend(const struct vk_color_blend_state *cb, uint32_t rt,
+                 VkFormat format, struct mtl_blend_state *blend,
+                 uint8_t *write_mask)
+{
+   *blend = (struct mtl_blend_state){
+      .enable = false,
+      .src_rgb = MTL_BLEND_FACTOR_ONE,
+      .dst_rgb = MTL_BLEND_FACTOR_ZERO,
+      .rgb_op = MTL_BLEND_OPERATION_ADD,
+      .src_alpha = MTL_BLEND_FACTOR_ONE,
+      .dst_alpha = MTL_BLEND_FACTOR_ZERO,
+      .alpha_op = MTL_BLEND_OPERATION_ADD,
+   };
+   *write_mask =
+      cb != NULL ? cb->attachments[rt].write_mask : BITFIELD_MASK(4);
+
+   struct mtl_blend_state native;
+   uint8_t native_mask;
+   if (kk_native_blend_cb(cb, rt, vk_format_to_pipe_format(format), &native,
+                          &native_mask)) {
+      *blend = native;
+      *write_mask = native_mask;
+   }
+}
