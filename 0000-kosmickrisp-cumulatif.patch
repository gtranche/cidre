 #include "kk_cmd_buffer.h"
+#include "kk_debug.h"
+
+#include "util/u_atomic.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+/* Chantier barrieres : relachement CIBLE des barrieres ALL->ALL de cloture
+ * d'encodeur, par type d'encodeur. L'A/B a prouve ~20-30% de gain GPU en
+ * relachant ces barrieres, mais le frag->frag GLOBAL cassait les encodeurs
+ * compute/blit (corruption/freeze). Ici on met les vraies stages par type.
+ *
+ * CIDRE_NARROW_BARRIERS :
+ *   non defini / 0 -> ALL->ALL (connu-bon).
+ *   1 (ou "targeted") -> relachement cible (defaut du relachement).
+ *   "global" -> ancien frag->frag global (pour comparaison/debug uniquement).
+ * Off par defaut : comportement connu-bon inchange. */
+enum kk_encoder_kind { KK_ENC_RENDER, KK_ENC_COMPUTE };
+
+static int
+kk_narrow_mode(void)
+{
+   static int mode = -1; /* 0=off, 1=targeted, 2=global */
+   if (mode < 0) {
+      const char *v = getenv("CIDRE_NARROW_BARRIERS");
+      if (!v)
+         mode = 0;
+      else if (!strcmp(v, "global"))
+         mode = 2;
+      else
+         mode = 1;
+   }
+   return mode;
+}
+
+static void
+kk_close_barrier_stages(enum kk_encoder_kind kind, enum mtl_stages *after,
+                        enum mtl_stages *before)
+{
+   int mode = kk_narrow_mode();
+
+   if (mode == 0) {
+      *after = MTL_STAGE_ALL;
+      *before = MTL_STAGE_ALL;
+      return;
+   }
+   if (mode == 2) {
+      *after = MTL_STAGE_FRAGMENT;
+      *before = MTL_STAGE_FRAGMENT;
+      return;
+   }
+
+   /* mode == 1 : cible. */
+   if (kind == KK_ENC_RENDER) {
+      /* Un encodeur de rendu ecrit couleur/profondeur (et storage) au stage
+       * FRAGMENT ; le vertex peut ecrire via storage/xfb emules. Ce qui le lit
+       * ensuite echantillonne au FRAGMENT, ou le lit en compute/blit. On EXCLUT
+       * VERTEX du cote consommateur pour laisser le tiling/vertex de la passe
+       * suivante recouvrir ce FRAGMENT (= le gain mesure), tout en protegeant
+       * l'echantillonnage fragment, les lectures compute et blit. */
+      *after = MTL_STAGE_VERTEX | MTL_STAGE_FRAGMENT;
+      *before = MTL_STAGE_FRAGMENT | MTL_STAGE_DISPATCH | MTL_STAGE_BLIT;
+   } else {
+      /* Un encodeur compute produit au DISPATCH/BLIT et peut alimenter
+       * n'importe quoi en aval (buffers de sommets, textures...). Conservateur
+       * cote consommateur (VERTEX inclus) : pas de recouvrement, mais correct.
+       * C'est la correction du cas que le frag->frag global cassait. */
+      *after = MTL_STAGE_DISPATCH | MTL_STAGE_BLIT;
+      *before = MTL_STAGE_VERTEX | MTL_STAGE_FRAGMENT | MTL_STAGE_DISPATCH |
+                MTL_STAGE_BLIT;
+   }
+}
+
+/* Traduit un masque de stages Vulkan (pDependencyInfo) en stages Metal. On
+ * regroupe tout le pipeline graphique amont (sommet/tess/geo/mesh/entree) sur
+ * VERTEX et la sortie fragment sur FRAGMENT, le compute sur DISPATCH, les copies
+ * sur BLIT. Les stages « tout le pipeline » et NONE retombent sur ALL (sur). */
+static enum mtl_stages
+kk_vk_pipeline_stages_to_mtl(VkPipelineStageFlags2 vk)
+{
+   if (vk & (VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT |
+             VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT |
+             VK_PIPELINE_STAGE_2_BOTTOM_OF_PIPE_BIT))
+      return MTL_STAGE_ALL;
+
+   const VkPipelineStageFlags2 vertex_bits =
+      VK_PIPELINE_STAGE_2_DRAW_INDIRECT_BIT |
+      VK_PIPELINE_STAGE_2_INDEX_INPUT_BIT |
+      VK_PIPELINE_STAGE_2_VERTEX_ATTRIBUTE_INPUT_BIT |
+      VK_PIPELINE_STAGE_2_VERTEX_INPUT_BIT |
+      VK_PIPELINE_STAGE_2_VERTEX_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_TESSELLATION_CONTROL_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_TESSELLATION_EVALUATION_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_GEOMETRY_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_TASK_SHADER_BIT_EXT |
+      VK_PIPELINE_STAGE_2_MESH_SHADER_BIT_EXT |
+      VK_PIPELINE_STAGE_2_PRE_RASTERIZATION_SHADERS_BIT;
+   const VkPipelineStageFlags2 fragment_bits =
+      VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+      VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT |
+      VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
+   const VkPipelineStageFlags2 blit_bits =
+      VK_PIPELINE_STAGE_2_COPY_BIT | VK_PIPELINE_STAGE_2_RESOLVE_BIT |
+      VK_PIPELINE_STAGE_2_BLIT_BIT | VK_PIPELINE_STAGE_2_CLEAR_BIT |
+      VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT | VK_PIPELINE_STAGE_2_HOST_BIT;
+
+   enum mtl_stages m = 0;
+   if (vk & VK_PIPELINE_STAGE_2_ALL_GRAPHICS_BIT)
+      m |= MTL_STAGE_VERTEX | MTL_STAGE_FRAGMENT;
+   if (vk & vertex_bits)
+      m |= MTL_STAGE_VERTEX;
+   if (vk & fragment_bits)
+      m |= MTL_STAGE_FRAGMENT;
+   if (vk & VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT)
+      m |= MTL_STAGE_DISPATCH;
+   if (vk & blit_bits)
+      m |= MTL_STAGE_BLIT;
 
+   return m ? m : MTL_STAGE_ALL;
+}
+
+static void
+kk_resolve_close_stages(struct kk_cmd_buffer *cmd, enum kk_encoder_kind kind,
+                        enum mtl_stages *after, enum mtl_stages *before)
+{
+   kk_close_barrier_stages(kind, after, before);
+
+   if (kk_narrow_mode() == 1 && cmd->metal.pending_barrier_before != 0) {
+      enum mtl_stages real_before = cmd->metal.pending_barrier_before;
+      enum mtl_stages narrowed = *before & real_before;
+      *before = narrowed ? narrowed : real_before;
+      cmd->metal.pending_barrier_after = 0;
+      cmd->metal.pending_barrier_before = 0;
+   }
+}
+
