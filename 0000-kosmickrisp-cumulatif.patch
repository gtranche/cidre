+mtl_render_pipeline_state *
+kk_get_render_pipeline_variant(struct kk_device *device,
+                               mtl_function_descriptor *vs_function,
+                               struct kk_shader *vs, struct kk_shader *fs,
+                               const struct kk_rp_variant_key *key)
