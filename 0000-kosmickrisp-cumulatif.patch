+/* Presents through a Metal 3 MTLCommandBuffer (presentDrawable: + commit)
+ * instead of -[CAMetalDrawable present]. This is the only presentation path
+ * in-process overlays hook (Steam's gameoverlayrenderer swizzles
+ * -[MTLCommandBuffer presentDrawable:] and draws into that command buffer).
+ * mtl4_command_queue, when not NULL, is the Metal 4 queue the frame was
+ * rendered with: the command buffer then waits on the GPU for that queue, as
+ * Metal does not order work between the two queues by itself. */
+struct wsi_metal_layer_present_context;
+
+struct wsi_metal_layer_present_context *
+wsi_create_metal_layer_present_context(const CAMetalLayer *metal_layer);
+
 void
+wsi_destroy_metal_layer_present_context(struct wsi_metal_layer_present_context *context);
+
+void
+wsi_metal_layer_present_with_command_buffer(struct wsi_metal_layer_present_context *context,
+   CAMetalDrawable **drawable_ptr, void *mtl4_command_queue);
