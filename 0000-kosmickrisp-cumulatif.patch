+
+   if (layout->action == KK_DGC_ACTION_DISPATCH) {
+      kk_dgc_dispatch(cmd, layout, pGeneratedCommandsInfo);
+      return;
+   }
+
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+   bool indexed = layout->action == KK_DGC_ACTION_DRAW_INDEXED;
+
+   enum kk_predicate_op predicate_op[2] = {0};
+   uint64_t predicate_addr[2] = {0};
+   uint32_t count_predicates = 0u;
+
+   if (pGeneratedCommandsInfo->sequenceCountAddress) {
+      predicate_op[count_predicates] = KK_PREDICATE_GT_DRAW_ID;
+      predicate_addr[count_predicates] =
+         pGeneratedCommandsInfo->sequenceCountAddress;
+      count_predicates++;
+   }
+
+   if (cmd->state.cond_render.enabled) {
+      predicate_op[count_predicates] = cmd->state.cond_render.inverted
+                                          ? KK_PREDICATE_EQ_ZERO
+                                          : KK_PREDICATE_NEQ_ZERO;
+      predicate_addr[count_predicates] = cmd->state.cond_render.address;
+      count_predicates++;
+   }
+
+   struct kk_draw_command data = {
+      .prim = vk_topology_to_mesa(dyn->ia.primitive_topology),
+      .upload_mask = build_per_draw_upload_mask(cmd),
+      .index_buffer = indexed ? cmd->state.gfx.index.gpu
+                              : (struct kk_addr_range){0},
+      .index_buffer_el_size_B =
+         indexed ? cmd->state.gfx.index.bytes_per_index : 0u,
+      .indirect = true,
+      .indexed = indexed,
+      .predicate_count = count_predicates,
+      .predicate_op[0] = predicate_op[0],
+      .predicate_op[1] = predicate_op[1],
+      .predicate_addr[0] = predicate_addr[0],
+      .predicate_addr[1] = predicate_addr[1],
+      .draw_count = pGeneratedCommandsInfo->maxSequenceCount,
+      .per_sequence_root_stride = sizeof(struct kk_root_descriptor_table),
+      .dgc_layout = layout,
+      .dgc_info = pGeneratedCommandsInfo,
+      .indirect_command.addr =
+         pGeneratedCommandsInfo->indirectAddress + layout->action_offset,
+      .indirect_command.stride = layout->indirect_stride,
    };
 
    kk_draw(cmd, &data);
