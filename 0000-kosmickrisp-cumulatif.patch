+/*
+ * VK_EXT_transform_feedback.
+ *
+ * Capture happens inside the drawing vertex function (see
+ * kk_nir_lower_xfb.c), which indexes each buffer by
+ *
+ *    (instance_id * num_vertices + raw_vertex_id) * stride + offset
+ *
