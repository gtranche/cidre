+#define KK_ROOT_LEN(f) sizeof(((struct kk_root_descriptor_table *)0)->f)
+
+static void
+kk_root_place(struct kk_root_layout *l, enum kk_root_field f, uint32_t len,
+              uint32_t align_b, uint32_t *cursor)
+{
+   if (len == 0u) {
+      l->off[f] = 0u;
+      l->len[f] = 0u;
+      return;
+   }
+
+   *cursor = align(*cursor, align_b);
+   l->off[f] = *cursor;
+   l->len[f] = len;
+   *cursor += len;
 }
 
+void
+kk_root_layout_compute(uint32_t set_count, const uint8_t *dyn_per_set,
+                       uint32_t push_size, struct kk_root_layout *out)
+{
+   uint32_t dyn_total = 0u;
+   uint32_t cursor = 0u;
+
+   for (uint32_t i = 0; i < set_count; i++)
+      dyn_total += dyn_per_set ? dyn_per_set[i] : 0u;
+
+   memset(out, 0, sizeof(*out));
+   out->set_count = set_count;
+
+   kk_root_place(out, KK_ROOT_SETS, set_count * sizeof(uint64_t), 8u, &cursor);
+   kk_root_place(out, KK_ROOT_PUSH, push_size, 8u, &cursor);
+   kk_root_place(out, KK_ROOT_SET_DYN_START, set_count, 1u, &cursor);
+   kk_root_place(out, KK_ROOT_DYNAMIC_BUFFERS,
+                 dyn_total * sizeof(struct kk_buffer_address), 8u, &cursor);
+   kk_root_place(out, KK_ROOT_ATTRIBS, KK_ROOT_LEN(draw.attribs), 8u, &cursor);
+   kk_root_place(out, KK_ROOT_CS_BASE_GROUP, KK_ROOT_LEN(cs.base_group), 4u,
+                 &cursor);
+   kk_root_place(out, KK_ROOT_BLEND_CONSTANT, KK_ROOT_LEN(draw.blend_constant),
+                 4u, &cursor);
+   kk_root_place(out, KK_ROOT_CLIP_Z_COEFF, KK_ROOT_LEN(draw.clip_z_coeff), 4u,
+                 &cursor);
+   kk_root_place(out, KK_ROOT_VIEWPORT_Z_RANGE,
+                 KK_ROOT_LEN(draw.viewport_z_range), 4u, &cursor);
+   kk_root_place(out, KK_ROOT_EMULATE_DEPTH_CLAMP,
+                 KK_ROOT_LEN(draw.emulate_depth_clamp), 1u, &cursor);
+   kk_root_place(out, KK_ROOT_EMULATE_VIEWPORT_Z,
+                 KK_ROOT_LEN(draw.emulate_viewport_z), 1u, &cursor);
+   kk_root_place(out, KK_ROOT_XFB_ADDRESS, KK_ROOT_LEN(draw.xfb_address), 8u,
+                 &cursor);
+   kk_root_place(out, KK_ROOT_XFB_COUNTER, KK_ROOT_LEN(draw.xfb_counter), 8u,
+                 &cursor);
+   kk_root_place(out, KK_ROOT_XFB_SIZE, KK_ROOT_LEN(draw.xfb_size), 4u,
+                 &cursor);
+   kk_root_place(out, KK_ROOT_XFB_NUM_VERTICES,
+                 KK_ROOT_LEN(draw.xfb_num_vertices), 4u, &cursor);
+   kk_root_place(out, KK_ROOT_XFB_FIRST_VERTEX,
+                 KK_ROOT_LEN(draw.xfb_first_vertex), 4u, &cursor);
+
+   out->size = align(cursor, 8u);
+}
+
+uint32_t
+kk_root_layout_extent(const struct kk_root_layout *l, uint32_t fields_read,
+                      uint32_t attrib_count)
+{
+   uint32_t end = 8u;
+
+   for (uint32_t f = 0; f < KK_ROOT_FIELD_COUNT; f++) {
+      uint32_t len = l->len[f];
+
+      if (!(fields_read & (1u << f)) || len == 0u)
+         continue;
+
+      if (f == KK_ROOT_ATTRIBS)
+         len = MIN2(len, attrib_count * sizeof(struct kk_root_attribute));
+
+      end = MAX2(end, (uint32_t)l->off[f] + len);
+   }
+
+   return align(end, 8u);
+}
+
+void
+kk_root_layout_pack(void *dst, const void *src, uint32_t size,
+                    const struct kk_root_layout *l,
+                    const struct kk_root_layout *src_layout)
+{
+   for (uint32_t f = 0; f < KK_ROOT_FIELD_COUNT; f++) {
+      uint32_t len = l->len[f];
+
+      if (len == 0u || l->off[f] >= size)
+         continue;
+
+      len = MIN2(len, size - l->off[f]);
+      memcpy((char *)dst + l->off[f], (const char *)src + src_layout->off[f],
+             len);
+   }
+}
