+KERNEL(32)
+libkk_dgc_patch_root(global uint32_t *out_roots, constant uint32_t *base_root,
+                     constant uint32_t *stream, constant uint32_t *tokens,
+                     uint64_t out_base_va, uint32_t root_dwords,
+                     uint32_t stream_stride_dw, uint32_t token_count,
+                     uint32_t push_base_dw)
+{
+   uint seq = cl_global_id.x;
+   global uint32_t *dst = out_roots + seq * root_dwords;
+
+   for (uint i = 0; i < root_dwords; ++i)
+      dst[i] = base_root[i];
+
+   constant uint32_t *src = stream + seq * stream_stride_dw;
+
+   for (uint t = 0; t < token_count; ++t) {
+      uint src_dw = tokens[t * 4u + 0u];
+      uint dst_dw = push_base_dw + tokens[t * 4u + 1u];
+      uint size_dw = tokens[t * 4u + 2u];
+      bool seq_index = tokens[t * 4u + 3u] != 0u;
+
+      if (seq_index) {
+         dst[dst_dw] = seq;
+      } else {
+         for (uint j = 0; j < size_dw; ++j)
+            dst[dst_dw + j] = src[src_dw + j];
+      }
+   }
+
+   uint64_t va = out_base_va + (uint64_t)(seq * root_dwords) * 4ul;
+   dst[0] = (uint32_t)va;
+   dst[1] = (uint32_t)(va >> 32ul);
+}
