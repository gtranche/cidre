+      desc->root.draw.xfb_address[i] = gfx->xfb.buffers[i].addr + used;
+      desc->root.draw.xfb_size[i] = MIN2(size - used, UINT32_MAX);
+
+      vertices_that_fit = MIN2(vertices_that_fit, (size - used) / stride);
