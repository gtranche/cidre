+/*
+ * Copyright 2026 Guillaume Tranchepain
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KK_INDIRECT_COMMANDS_H
+#define KK_INDIRECT_COMMANDS_H 1
+
+#include "kk_private.h"
+
+#include "vk_object.h"
+
+#define KK_MAX_DGC_PUSH_TOKENS 8
+
+enum kk_dgc_action {
+   KK_DGC_ACTION_NONE = 0,
+   KK_DGC_ACTION_DRAW,
+   KK_DGC_ACTION_DRAW_INDEXED,
+   KK_DGC_ACTION_DISPATCH,
+};
+
+struct kk_dgc_push_token {
+   uint32_t stream_offset;
+   uint32_t push_offset;
+   uint32_t size;
+   bool sequence_index;
+};
+
+struct kk_indirect_commands_layout {
+   struct vk_object_base base;
+
+   VkIndirectCommandsLayoutUsageFlagsEXT flags;
+   VkShaderStageFlags shader_stages;
+   uint32_t indirect_stride;
+
+   enum kk_dgc_action action;
+   uint32_t action_offset;
+
+   uint32_t push_token_count;
+   struct kk_dgc_push_token push_tokens[KK_MAX_DGC_PUSH_TOKENS];
+};
+
+VK_DEFINE_NONDISP_HANDLE_CASTS(kk_indirect_commands_layout, base,
+                               VkIndirectCommandsLayoutEXT,
+                               VK_OBJECT_TYPE_INDIRECT_COMMANDS_LAYOUT_EXT)
+
+struct kk_indirect_execution_set {
+   struct vk_object_base base;
+};
+
+VK_DEFINE_NONDISP_HANDLE_CASTS(kk_indirect_execution_set, base,
+                               VkIndirectExecutionSetEXT,
+                               VK_OBJECT_TYPE_INDIRECT_EXECUTION_SET_EXT)
+
+struct kk_cmd_buffer;
+
+uint64_t kk_dgc_build_roots(struct kk_cmd_buffer *cmd,
+                            const struct kk_indirect_commands_layout *layout,
+                            const VkGeneratedCommandsInfoEXT *info,
+                            VkPipelineBindPoint bind_point);
+
+void kk_dgc_dispatch(struct kk_cmd_buffer *cmd,
+                     const struct kk_indirect_commands_layout *layout,
+                     const VkGeneratedCommandsInfoEXT *info);
+
+#endif /* KK_INDIRECT_COMMANDS_H */
