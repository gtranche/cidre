+   struct kk_passthrough_io *io = data;
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   unsigned slot = sem.location + nir_src_as_uint(intr->src[1]);
+   unsigned end = nir_intrinsic_component(intr) +
+                  util_last_bit(nir_intrinsic_write_mask(intr));
