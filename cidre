cmd=${1:-help}; [ $# -gt 0 ] && shift
# --json (n'importe ou) : sortie pour une interface (Verger), stable et parsable
JSON=non; MAJ=non; SANS_MAJ=non
# `run` transmet ses arguments tels quels au programme
[ "$cmd" = run ] || for a in "$@"; do
   shift
   case $a in --json) JSON=oui ;; --refresh) MAJ=oui ;; --sans-maj|--no-update) SANS_MAJ=oui ;; *) set -- "$@" "$a" ;; esac
done
case "$cmd" in
  list|ls)
    if [ "$JSON" = oui ]; then
      sep='['
      for id in $(ids); do printf '%s\n  ' "$sep"; fiche_json "$id"; printf '}'; sep=','; done
      [ "$sep" = '[' ] && echo '[]' || printf '\n]\n'
      exit 0
    fi
    printf "%-18s %-26s %-10s %s\n" ID JEU PLATEFORME LANCEMENT
    for id in $(ids); do
      p=$(plat "$id"); [ "$p" = macos ] && l="natif (Steam)" || l="Cidre"
      case $(source_de "$id") in
        cidre) l="Cidre (dossier Cidre)" ;;
        local) l="Cidre (hors Steam)" ;;
        steam) [ "$(cidre_wrap "$id")" = non ] && [ "$p" = windows ] && l="Cidre (wrapper absent!)" ;;
      esac
      printf "%-18s %-26.26s %-10s %s\n" "$id" "$(nom "$id")" "$p" "$l"
    done ;;
  info)
    id=${1:?usage: cidre info <id> [--json]}
    connu "$id" || { echo "jeu inconnu : $id" >&2; exit 1; }
    opts=$(sh "$R/tests/profil_cidre.sh" "$id" json)
    { [ -n "$(saves_ids | grep -x "$id")" ] || [ -n "$(saves_steam "$id")" ]; } && sv=true || sv=false
    # ou en est sa mise a jour (jeu du dossier Cidre), d'apres ce qu'on sait deja : pas de reseau ici
    mj=null; [ "$(source_de "$id")" = cidre ] && { maj_etat "$id" cache; mj="{$(maj_json "$id")}"; }
    if [ "$JSON" = oui ]; then
      # "fiche" : la fiche de la base de profils (profils/README.md), ou null
      fiche_json "$id"; printf ',"sauvegardes":%s,"options":%s,"options_perso":%s,"maj":%s,"fiche":%s}\n' "$sv" "$opts" "$(sh "$R/tests/profil_cidre.sh" "$id" perso)" "$mj" "$(sh "$R/tests/fiche_profil.sh" json "$id")"
    else
      echo "id          : $id"
      echo "nom         : $(nom "$id")"
      echo "plateforme  : $(plat "$id")"
      echo "source      : $(source_de "$id")"
      echo "chemin      : $(chemin "$id")"
      t=$(champ "$id" SizeOnDisk); echo "taille      : $(( ${t:-0} / 1048576 )) Mo"
      echo "sauvegardes : $sv"
      [ "$mj" = null ] || echo "mise a jour : $MAJ_ETAT${MAJ_RAISON:+ ($MAJ_RAISON)}${MAJ_DISPO:+, build $MAJ_INSTALLE -> $MAJ_DISPO}"
      echo "options     : $(sh "$R/tests/profil_cidre.sh" "$id" | tr '\n' ' ')"
      f=$(sh "$R/tests/fiche_profil.sh" chemin "$id")
      if [ -n "$f" ]; then
        echo "fiche       : $f"
        echo "compat      : $(sh "$R/tests/fiche_profil.sh" toml "$f" | awk -F"\t" '$1 == "compat" && $2 != "notes" { printf "%s=%s  ", $2, $4 }')"
        n=$(sh "$R/tests/fiche_profil.sh" toml "$f" | awk -F"\t" '$1 == "compat" && $2 == "notes" { print $4 }'); [ -z "$n" ] || echo "notes       : $n"
        n=$(sh "$R/tests/fiche_profil.sh" variantes "$id" | tr '\n' ';' | sed 's/;$//; s/;/ ; /g'); [ -z "$n" ] || echo "variante    : pour cette machine (si $n)"
      else echo "fiche       : aucune (cidre profils maj)"; fi
    fi ;;
  play|jouer)
    id=${1:?usage: cidre play <id> [--sans-maj] [--json]}
    CDIR="$CIDRE_GAMES/$id"
    # --json : l'evenement « lancement » clot la sortie standard ; tout ce qui
    # suit (le lanceur, le jeu) ecrit a l'erreur.
    partir() { evenement '{"evenement":"lancement"}'; [ "$JSON" != oui ] || exec >&2; }
    if est_local "$id"; then
      # Jeu hors Steam : pas d'appid, son profil de lancement est range sous son id.
      EXE=$(local_champ "$id" 3)
      [ -n "$EXE" ] || { echo "jeu inconnu : $id" >&2; exit 1; }
      [ -f "$EXE" ] || { echo "executable introuvable : $EXE" >&2; exit 1; }
      partir
      echo "lancement Cidre : $(basename "$EXE")  ($id)"
      temoin_en_cours "$id"
      CIDRE_JEU=$id sh "$LANCEUR" "$EXE"
    elif [ -d "$CDIR" ]; then
      # Jeu telecharge par Cidre (hors client) : c'est Cidre qui le tient a
      # jour, puis on lance par la pile Cidre.
      maj_avant_lancement "$id"
      EXE=$(exe_principal "$CDIR")
      [ -n "$EXE" ] || { dire "aucun .exe dans $CDIR"; exit 1; }
      partir
      echo "lancement Cidre : $(basename "$EXE")  (appid $id)"
      echo "  (dossier : $CDIR)"
      temoin_en_cours "$id"
      SteamAppId=$id SteamGameId=$id SteamOverlayGameId=$id \
        sh "$LANCEUR" "$EXE"
    else
      # Jeu du client Steam (natif, ou Windows par le wrapper) : Steam le met a
      # jour lui-meme avant de le lancer.
      partir
      echo "lancement de $(nom "$id") ($id) via Steam..."
      open "steam://run/$id"
    fi
    # `play` a attendu le jeu : on sort ici, sans rien lire de plus.
    exit $? ;;
  running|en-cours)
    # Les jeux en cours, par leur id. Deux sources : le jeu que Steam dit avoir
    # lance (natif, ou Windows par notre wrapper), et les temoins de `cidre play`.
    en_cours=""
    if pgrep -x steam_osx >/dev/null 2>&1; then
      a=$(sed -n 's/.*"RunningAppID"[[:space:]]*"\([0-9]*\)".*/\1/p' "$STEAM/registry.vdf" 2>/dev/null | head -1)
      [ -n "$a" ] && [ "$a" != 0 ] && en_cours=$a
    fi
    for f in "$EN_COURS"/*; do
      [ -f "$f" ] || continue
      # un temoin dont le processus n'existe plus est un reste : on l'enleve
      if kill -0 "$(cat "$f" 2>/dev/null)" 2>/dev/null; then en_cours="$en_cours $(basename "$f")"; else rm -f "$f"; fi
    done
    en_cours=$(printf '%s\n' $en_cours | sort -u)
    if [ "$JSON" = oui ]; then
