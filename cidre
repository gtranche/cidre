    echo "arrete" ;;
  log|journal)
    # La fin utile du journal d'un jeu, pour un rapport d'incident : son dernier
    # lancement, sans les lignes de trace (elles pesent des dizaines de Mo).
    id=${1:?usage: cidre log <id> [lignes]}; n=${2:-200}
    case $id in ''|*[!a-z0-9-]*) echo "id invalide : $id" >&2; exit 2 ;; esac
    case $n in ''|*[!0-9]*) echo "usage: cidre log <id> [lignes]" >&2; exit 2 ;; esac
    J="$R/build/logs/steam-$id.log"
    [ -f "$J" ] || exit 0
    # Le dernier lancement, depuis sa ligne d'en-tete. Des lignes de trace on
    # ne garde que les premieres exceptions (journal detaille, +seh) : c'est la
    # premiere qui dit pourquoi un jeu tombe, les suivantes se repetent.
    debut=$(LC_ALL=C grep -ab '^=== [0-9]' "$J" | tail -1 | cut -d: -f1)
