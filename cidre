    # pas encore repris : "source":"bouteille" (cidre import), sans peser leur dossier.
    if [ "$JSON" = oui ]; then
      sh "$R/tests/trouver_jeux_bouteilles.sh" --rapide | "$OUTIL" bibliotheque --bouteilles - "$CACHE" $(appids)
    else
      sh "$R/tests/trouver_jeux_bouteilles.sh" --rapide | "$OUTIL" bibliotheque --texte --bouteilles - "$CACHE" $(appids)
    fi ;;
  updates|majs)
    # Le build installe de chaque jeu, compare a celui de la branche publique.
    # Information publique : SteamCMD la lit sans compte, donc sans session.
    # Gardee en cache une demi-heure ; --refresh la redemande, et un jeu
    # installe depuis aussi. Un jeu du dossier Cidre porte en plus l'etat de sa
    # mise a jour (maj_etat) : c'est Cidre qui la fait.
    neuf=non
    [ "$MAJ" = oui ] || appinfo_perime && neuf=oui
    [ "$neuf" = oui ] || for id in $(appids); do appinfo_sans "$id" && { neuf=oui; break; }; done
    if [ "$neuf" = oui ]; then
      appinfo_rafraichir
      case $? in
        0) ;;
        2) echo "SteamCMD introuvable (ni tools/steamcmd/ ni PATH)." >&2; exit 1 ;;
        *) # ce qu'on savait reste vrai : un build publie ne recule pas
           [ -s "$APPINFO" ] || { echo "Steam n'a pas repondu (hors ligne ?)." >&2; exit 1; }
           echo "Steam n'a pas repondu (hors ligne ?) : etat lu le $(date -r "$(stat -f %m "$APPINFO")" '+%Y-%m-%d a %H:%M')." >&2 ;;
      esac
    fi
    [ -s "$APPINFO" ] || { [ "$JSON" = oui ] && echo "[]"; exit 0; }
    [ "$JSON" = oui ] && printf '['
    sep=""
    builds >"$APPINFO.builds.$$"
    while IFS="$TAB" read -r u_a u_i u_p; do
      [ "$u_p" -le "$u_i" ] && u_j=true || u_j=false
      if [ "$(source_de "$u_a")" = cidre ]; then
        maj_etat "$u_a" cache
        [ "$MAJ_ETAT" = en_cours ] && MAJ_DISPO=${MAJ_DISPO:-$u_p}
        if [ "$JSON" = oui ]; then
          printf '%s{"appid": %s, "build_installe": %s, "build_disponible": %s, "a_jour": %s, "source": "cidre", %s}' "$sep" "$u_a" "$u_i" "$u_p" "$u_j" "$(maj_json "$u_a" | sed 's/"build_installe":[^,]*,"build_disponible":[^,]*,//')"
        else
          case $MAJ_ETAT in
            a_jour)   u_t="a jour" ;;
            en_cours) u_t="MISE A JOUR EN COURS : build $u_i -> $u_p" ;;
            echouee)  u_t="MISE A JOUR : build $u_i -> $u_p (derniere tentative echouee : $MAJ_RAISON)" ;;
            ignoree)  u_t="MISE A JOUR : build $u_i -> $u_p (laissee de cote : $MAJ_RAISON)" ;;
            *)        [ $u_j = true ] && u_t="a jour" || u_t="MISE A JOUR : build $u_i -> $u_p" ;;
          esac
          printf '%-9d %s\n' "$u_a" "$u_t"
        fi
      elif [ "$JSON" = oui ]; then
        [ $u_j = true ] && u_e=a_jour || u_e=disponible
        printf '%s{"appid": %s, "build_installe": %s, "build_disponible": %s, "a_jour": %s, "source": "steam", "etat": "%s"}' "$sep" "$u_a" "$u_i" "$u_p" "$u_j" "$u_e"
      else
        [ $u_j = true ] && u_t="a jour" || u_t="MISE A JOUR : build $u_i -> $u_p"
        printf '%-9d %s\n' "$u_a" "$u_t"
      fi
      sep=", "
    done <"$APPINFO.builds.$$"
    rm -f "${APPINFO:?}.builds.$$"
    [ "$JSON" = oui ] && echo "]"
    exit 0 ;;
  login)
    SCMD=$(resolve_steamcmd)
    [ -n "$SCMD" ] || { echo "SteamCMD introuvable (ni tools/steamcmd/ ni PATH)." >&2; exit 1; }
    U=$(steam_user)
    [ -n "$U" ] || { echo "Compte Steam introuvable. Exporte CIDRE_STEAM_USER=<ton_login> et relance." >&2; exit 1; }
    echo "Connexion SteamCMD pour '$U' : tape ton mot de passe (+ Steam Guard) a SteamCMD."
    echo "Une seule fois ; Cidre ne voit jamais ton mot de passe."
    scmd +login "$U" +quit ;;
  add|ajouter)
    exe=${1:?usage: cidre add <jeu.exe> [nom]}
    [ -f "$exe" ] || { echo "fichier introuvable : $exe" >&2; exit 1; }
    [ "$(head -c 2 "$exe" 2>/dev/null)" = MZ ] || { echo "pas un executable Windows : $exe" >&2; exit 1; }
    exe=$(cd "$(dirname "$exe")" && pwd)/$(basename "$exe")
    n=$(printf '%s' "${2:-$(basename "$exe" | sed 's/\.[Ee][Xx][Ee]$//')}" | tr '\t' ' ')
    # deja dans la bibliotheque : on rend le jeu existant
    id=$(awk -F'\t' -v e="$exe" '$3==e {print $1; exit}' "$LOCAUX" 2>/dev/null)
    if [ -z "$id" ]; then
      slug=$(printf '%s' "$n" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//')
      [ -n "$slug" ] || slug=jeu
      id=local-$slug; i=2
      while [ -n "$(local_champ "$id" 1)" ]; do id=local-$slug-$i; i=$((i + 1)); done
      mkdir -p "$CIDRE_DIR"
      printf '%s\t%s\t%s\n' "$id" "$n" "$exe" >>"$LOCAUX"
    fi
    if [ "$JSON" = oui ]; then fiche_json "$id"; printf '}\n'
    else echo "ajoute : $(nom "$id")  ($id)"; fi ;;
  run)
    exe=${1:?usage: cidre run <fichier.exe> [args]}; shift
    [ -f "$exe" ] || { echo "fichier introuvable : $exe" >&2; exit 1; }
    exe=$(cd "$(dirname "$exe")" && pwd)/$(basename "$exe")
    sh "$R/tests/lancer_depuis_steam.sh" "$exe" "$@" ;;
  prefix|prefixe)
    echo "${WINEPREFIX:-$R/wine/pfx-arm64ec}/drive_c" ;;
  rm|retirer)
    id=${1:?usage: cidre rm <id>}
    if est_local "$id"; then
      connu "$id" || { echo "jeu inconnu : $id" >&2; exit 1; }
      awk -F'\t' -v i="$id" '$1!=i' "$LOCAUX" >"$LOCAUX.tmp" && mv "$LOCAUX.tmp" "$LOCAUX"
      echo "retire de la bibliotheque : $id (les fichiers du jeu ne sont pas touches)"
    else
      # un appid, rien d'autre : pas de chemin, pas de vide
      case $id in ''|*[!0-9]*) echo "id invalide : $id" >&2; exit 2 ;; esac
      [ -d "$CIDRE_GAMES/$id" ] || { echo "$id n'est pas dans le dossier Cidre ; un jeu du client Steam se desinstalle depuis Steam." >&2; exit 1; }
      # Certains jeux rangent leurs sauvegardes dans leur propre dossier : on
      # les met a l'abri avant de l'effacer.
      # (une copie Cidre meme si Steam synchronise ce jeu : ceinture et bretelles)
      CIDRE_SAVES_STEAM=0 WINEPREFIX="${WINEPREFIX:-$R/wine/pfx-arm64ec}" sh "$R/tests/sync_saves_steam.sh" "$id" backup
      rm -rf "${CIDRE_GAMES:?}/${id:?}"
      t_id=$id; rm -f "${MAJ_ETATS:?}/${id:?}"; maj_oublier sortie avancement rc
      echo "desinstalle : $CIDRE_GAMES/$id"
    fi ;;
  help|*) usage ;;
esac
exit $?
}
