      [ -n "$slug" ] || slug=jeu
      id=local-$slug; i=2
      while [ -n "$(local_champ "$id" 1)" ]; do id=local-$slug-$i; i=$((i + 1)); done
      mkdir -p "$CIDRE_DIR"
      printf '%s\t%s\t%s\n' "$id" "$n" "$exe" >>"$LOCAUX"
    fi
    if [ "$JSON" = oui ]; then fiche_json "$id"; printf '}\n'
    else echo "ajoute : $(nom "$id")  ($id)"; fi ;;
  run)
    exe=${1:?usage: cidre run <fichier.exe> [args]}; shift
    [ -f "$exe" ] || { echo "fichier introuvable : $exe" >&2; exit 1; }
    exe=$(cd "$(dirname "$exe")" && pwd)/$(basename "$exe")
    sh "$R/tests/lancer_depuis_steam.sh" "$exe" "$@" ;;
  prefix|prefixe)
    echo "${WINEPREFIX:-$R/wine/pfx-arm64ec}/drive_c" ;;
  rm|retirer)
    id=${1:?usage: cidre rm <id>}
    if est_local "$id"; then
      connu "$id" || { echo "jeu inconnu : $id" >&2; exit 1; }
      awk -F'\t' -v i="$id" '$1!=i' "$LOCAUX" >"$LOCAUX.tmp" && mv "$LOCAUX.tmp" "$LOCAUX"
      echo "retire de la bibliotheque : $id (les fichiers du jeu ne sont pas touches)"
    else
      # un appid, rien d'autre : pas de chemin, pas de vide
      case $id in ''|*[!0-9]*) echo "id invalide : $id" >&2; exit 2 ;; esac
      hors_ligne "$id" && { hors_ligne_message "$id" >&2; echo >&2; exit 8; }
      depl_en_cours "$id" && { echo "Ce jeu est en cours de deplacement : attends la fin." >&2; exit 4; }
      G=$(jd "$id") || { echo "$id n'est pas dans un emplacement Cidre ; un jeu du client Steam se desinstalle depuis Steam." >&2; exit 1; }
      # Certains jeux rangent leurs sauvegardes dans leur propre dossier : on
      # les met a l'abri avant de l'effacer.
      # (une copie Cidre meme si Steam synchronise ce jeu : ceinture et bretelles)
      CIDRE_SAVES_STEAM=0 WINEPREFIX="${WINEPREFIX:-$R/wine/pfx-arm64ec}" sh "$R/tests/sync_saves_steam.sh" "$id" backup
      # (le dossier d'un jeu, jamais l'emplacement lui-meme)
      case $G in */*/?*) ;; *) echo "dossier inattendu : $G" >&2; exit 1 ;; esac
      effacer "${G:?}" || { echo "$G n'a pas pu etre efface entierement" >&2; exit 1; }
      t_id=$id; rm -f "${MAJ_ETATS:?}/${id:?}"; maj_oublier sortie avancement rc
      echo "desinstalle : $G"
    fi ;;
  emplacements|emplacement|stockage|libraries|locations)
    # Ou vivent les jeux Cidre (voir « Emplacements » en tete) : les lister,
    # en ajouter un (un disque externe), en retirer un (ses jeux restent sur le
    # disque), choisir celui ou vont les nouveaux jeux.
    sous=${1:-}; [ $# -gt 0 ] && shift
    case $sous in
      ''|liste|list) empl_lister ;;
      ajouter|add) empl_ajouter "${1:-}" ;;
      retirer|remove|rm) empl_retirer "${1:-}" ;;
      defaut|default) empl_choisir_defaut "${1:-}" ;;
      *) echo "usage: cidre emplacements [ajouter <dossier ou disque> | retirer <emplacement> | defaut <emplacement>] [--json]" >&2; exit 2 ;;
    esac ;;
  move|deplacer|mv)
    # Deplace un jeu Cidre vers un autre emplacement (tests/deplacer_jeu.sh :
    # copie verifiee, puis suppression ; reprise possible).
    id=${1:-}; dv=${2:-}
    case $id in ''|*[!0-9]*) echo "usage: cidre move <appid> <emplacement> [--verifier-contenu] [--json] | cidre move <appid> --annuler" >&2; exit 2 ;; esac
    mv_refus() { # <code> <raison> <message>
      evenement "$(printf '{"evenement":"deplacement","etat":"refuse","raison":"%s","message":%s}' "$2" "$(json "$3")")"
      echo "$3" >&2; exit "$1"
    }
    connu "$id" || mv_refus 1 inconnu "jeu inconnu : $id"
    case $(source_de "$id") in
      steam) mv_refus 1 steam "$(nom "$id") est installe par le client Steam : il se deplace depuis Steam (Reglages > Stockage)." ;;
      local) mv_refus 1 local "$(nom "$id") est un jeu hors Steam : deplace son dossier toi-meme, puis \`cidre rm $id\` et \`cidre add\`." ;;
    esac
    if [ $ARRETER = oui ]; then
      # Arreter un deplacement qui tourne (lance d'ailleurs) : la copie entamee
      # reste, un nouveau move la reprend.
      if depl_en_cours "$id"; then
        p=$(cat "$DEPLACEMENTS/$id.verrou/pid" 2>/dev/null); kill -TERM "$p" 2>/dev/null
        i=0; while [ $i -lt 50 ] && kill -0 "$p" 2>/dev/null; do sleep 0.2; i=$((i + 1)); done
        dire "deplacement arrete : $(nom "$id") reste ou il etait ; \`cidre move $id <emplacement>\` le reprendra"
      else dire "aucun deplacement de $(nom "$id") ne tourne"; fi
      exit 0
    fi
    if [ $ANNULER = oui ]; then
      # Abandonner un deplacement : l'arreter s'il tourne, effacer la copie
      # entamee. L'original n'a jamais ete touche.
      if depl_en_cours "$id"; then
        p=$(cat "$DEPLACEMENTS/$id.verrou/pid" 2>/dev/null); kill -TERM "$p" 2>/dev/null
        i=0; while [ $i -lt 50 ] && kill -0 "$p" 2>/dev/null; do sleep 0.2; i=$((i + 1)); done
      fi
      c=$(depl_champ "$id" cible)
      [ -n "$c" ] && [ -d "$c/.cidre-deplacement-$id" ] && effacer "${c:?}/.cidre-deplacement-${id:?}"
      rm -f "${DEPLACEMENTS:?}/${id:?}" "${DEPLACEMENTS:?}/${id:?}.avancement" "${DEPLACEMENTS:?}/${id:?}.erreurs" "${DEPLACEMENTS:?}/${id:?}".liste-*
      evenement '{"evenement":"deplacement","etat":"annule"}'
      dire "deplacement abandonne : $(nom "$id") reste ou il etait"
      exit 0
    fi
    hors_ligne "$id" && mv_refus 8 debranche "$(hors_ligne_message "$id")"
    [ -n "$dv" ] || { echo "usage: cidre move <appid> <emplacement> (voir \`cidre emplacements\`)" >&2; exit 2; }
    empl_resoudre "$dv"
    case $? in
      1) mv_refus 2 emplacement "emplacement inconnu : $dv (voir \`cidre emplacements\` ; un disque s'ajoute par \`cidre emplacements ajouter <disque>\`)" ;;
      2) mv_refus 2 emplacement "plusieurs emplacements repondent a « $dv » : donne son id (voir \`cidre emplacements\`)" ;;
    esac
    vn=$(empl_nom "$ER_ID" "$ER_CHEMIN")
    [ "$ER_EN_LIGNE" = oui ] || mv_refus 8 debranche "L'emplacement « $vn » n'est pas branche : branche son disque, puis recommence."
    se=$(empl_de "$id")
    if [ "$ER_ID" = "$se" ]; then
      # Deja la. Un deplacement vers ici arrete pendant l'effacement de
      # l'original est fini : on range son etat et ce qui reste de l'original.
      # (Un deplacement inacheve vers ailleurs reste a reprendre ou a annuler.)
      if ! depl_en_cours "$id" && [ "$(depl_champ "$id" vers)" = "$ER_ID" ]; then
        o=$(depl_champ "$id" source)
        for r in "${o%/*}"/.cidre-supprime-"$id".*; do [ -d "$r" ] && effacer "$r"; done
        rm -f "${DEPLACEMENTS:?}/${id:?}" "${DEPLACEMENTS:?}/${id:?}.avancement" "${DEPLACEMENTS:?}/${id:?}.erreurs"
      fi
      evenement "$(printf '{"evenement":"deplacement","etat":"fait","emplacement":%s,"chemin":%s,"octets":null,"duree":0}' "$(json "$ER_ID")" "$(json "$(jd "$id")")")"
      dire "$(nom "$id") est deja dans « $vn »"
      exit 0
    fi
    depl_en_cours "$id" && mv_refus 4 en_cours "Ce jeu est deja en cours de deplacement (processus $(depl_champ "$id" pid))."
    maj_en_cours "$id" && mv_refus 4 maj "Une mise a jour de ce jeu est en cours : attends sa fin, puis deplace-le."
    # Un deplacement inacheve vers un autre emplacement : sa copie entamee y reste.
    c=$(depl_champ "$id" cible)
    if [ -n "$c" ] && [ "$c" != "$ER_CHEMIN" ] && [ -d "$c/.cidre-deplacement-$id" ]; then
      dire "copie entamee vers $c abandonnee (autre destination) : effacee"
      effacer "${c:?}/.cidre-deplacement-${id:?}"
    fi
    exec env DEPL_DE="$se" DEPL_VERS="$ER_ID" DEPL_NOM="$(nom "$id")" DEPL_VOLUME="$vn" DEPL_JSON="$JSON" DEPL_VERIFIER="$VERIFIER" \
      CIDRE_DIR="$CIDRE_DIR" sh "$R/tests/deplacer_jeu.sh" "$id" "$(jd "$id")" "$ER_CHEMIN" ;;
  help|*) usage ;;
esac
exit $?
}
