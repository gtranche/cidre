#!/bin/sh
# Cidre launcher (CLI MVP) : installer / lancer / gerer tes jeux Steam, natif OU
# via Cidre, sans jongler avec la console Steam. Les jeux restent dans Steam
# (amis/succes/overlay via le Steam natif + notre pont). Install auto via SteamCMD.
# Tout le corps est entre accolades, ferme par `exit` : le shell lit ainsi le
# fichier ENTIER avant d'executer quoi que ce soit, et n'y revient jamais. Sans
# cela, il lit au fil de l'execution : un fichier modifie pendant qu'un jeu
# tourne (mise a jour, edition) est repris a l'ancien decalage, au milieu d'une
# autre commande -- le 2026-10-13, `cidre play` a ainsi fini dans la
# desinstallation et efface le jeu. tests/tester_profils.sh verifie l'enveloppe.
{
set -u
R=$(cd "$(dirname "$0")" && pwd)
STEAM="$HOME/Library/Application Support/Steam"
SA="$STEAM/steamapps"
STEAMCMD=${STEAMCMD:-/opt/homebrew/bin/steamcmd}
CIDRE_DIR=${CIDRE_DIR:-$HOME/Library/Application Support/Cidre}
TAB=$(printf '\t'); NL='
'
# Les jeux telecharges par Cidre vivent HORS du client Steam (zero ecrasement),
# dans des emplacements, comme les dossiers de bibliotheque de Steam : le
# principal (id `principal`, sur ce Mac, toujours la), et ceux que l'on ajoute
# (`cidre emplacements ajouter`), sur un disque externe par exemple. Un jeu y
# est un dossier qui porte son manifeste SteamCMD
# (<dossier>/steamapps/appmanifest_<appid>.acf), nomme d'apres son appid -- ou
# autrement, s'il a ete copie a la main. Les dossiers caches (.xxx) sont des
# travaux en cours (deplacement, reprise d'une bouteille) : jamais des jeux.
CIDRE_GAMES="$CIDRE_DIR/games"
# Les emplacements ajoutes, TAB-separe : id, chemin (le dernier ou on l'a vu).
EMPLACEMENTS="$CIDRE_DIR/emplacements.conf"
# l'id de l'emplacement ou vont les nouveaux jeux (absent : principal)
EMPL_DEFAUT="$CIDRE_DIR/emplacements.defaut"
# Ce qu'on sait des jeux de chaque emplacement (<id>.jeux), pour en parler
# quand son disque est debranche : ils sont alors « hors ligne », ni
# desinstalles ni perdus, et reviennent quand on le rebranche.
EMPL_CACHE="$CIDRE_DIR/emplacements"
# Chaque emplacement ajoute porte une marque a sa racine (id=<id>) : c'est elle
# qui le fait reconnaitre quand son volume change de nom ou de point de montage.
MARQUE=.cidre-emplacement
VOLUMES=${CIDRE_VOLUMES:-/Volumes}
VOLUMES=$(cd "$VOLUMES" 2>/dev/null && pwd -P || printf '%s' "$VOLUMES")
# l'etat de chaque deplacement de jeu (`cidre move`), en lignes `cle=valeur`
DEPLACEMENTS="$CIDRE_DIR/deplacements"
# Jeux hors Steam, ajoutes par `cidre add`. TAB-separe : id (local-...), nom,
# chemin de l'executable. Un jeu = une ligne.
LOCAUX="$CIDRE_DIR/jeux-locaux.conf"

# Un jeu vit dans un emplacement Cidre (telecharge par `cidre dl`, prioritaire,
# comme pour `cidre play`), dans le client Steam, ou hors Steam (id local-...).
# L'index des emplacements (empl_indexer, au lancement) dit ou.
est_local() { case $1 in local-*) return 0 ;; esac; return 1; }
local_champ() { awk -F'\t' -v i="$1" -v n="$2" '$1==i {print $n; exit}' "$LOCAUX" 2>/dev/null; }
# le dossier d'un jeu sur un emplacement branche (rien, et 1, sinon) ; jd_q :
# le meme dans jd_r, sans rien ecrire (sans sous-shell : champ() en abuse)
jd_q() { case $1 in ''|*[!0-9]*) return 1 ;; esac; eval "jd_r=\${JD_$1:-}"; [ -n "$jd_r" ]; }
jd() { jd_q "$1" && printf '%s' "$jd_r"; }
# un jeu dont l'emplacement est debranche
hors_ligne() { case $1 in ''|*[!0-9]*) return 1 ;; esac; eval "[ -n \"\${JH_$1:-}\" ]"; }
# l'id de l'emplacement d'un jeu (rien : client Steam, hors Steam)
empl_de() { case $1 in ''|*[!0-9]*) return 1 ;; esac; eval "printf '%s' \"\${JE_$1:-}\""; }
source_de() { est_local "$1" && { echo local; return; }; { jd "$1" >/dev/null || hors_ligne "$1"; } && echo cidre || echo steam; }
acf()   { if jd_q "$1"; then echo "$jd_r/steamapps/appmanifest_$1.acf"; else echo "$SA/appmanifest_$1.acf"; fi; }
champ() {
   est_local "$1" && return
   # emplacement debranche : ce qu'en garde son cache
   if hors_ligne "$1"; then
      case $2 in name) ch_v=JN ;; SizeOnDisk) ch_v=JT ;; StateFlags) ch_v=JS ;; buildid) ch_v=JB ;; LastPlayed) ch_v=JL ;; *) return ;; esac
      eval "printf '%s' \"\${${ch_v}_$1:-}\""; return
   fi
   sed -n 's/.*"'"$2"'"[[:space:]]*"\(.*\)".*/\1/p' "$(acf "$1")" 2>/dev/null | head -1
}
nom()   { est_local "$1" && { local_champ "$1" 2; return; }; champ "$1" name | sed 's/\\"/"/g; s/\\\\/\\/g'; }
dir()   { champ "$1" installdir; }
chemin() {
   est_local "$1" && { dirname "$(local_champ "$1" 3)"; return; }
   jd "$1" && return
   # hors ligne : le dernier chemin connu (absent tant que le disque l'est)
   hors_ligne "$1" && { eval "printf '%s\n' \"\${JH_$1}\""; return; }
   echo "$SA/common/$(dir "$1")"
}
connu() { # le jeu existe-t-il pour Cidre ?
   est_local "$1" && { [ -n "$(local_champ "$1" 1)" ]; return; }
   [ -f "$(acf "$1")" ] || jd "$1" >/dev/null || hors_ligne "$1"
}
# appids Steam : manifestes du client + jeux des emplacements, branches ou non
# (sans Steamworks Redist 228980)
appids() {
   { for f in "$SA"/appmanifest_*.acf; do [ -f "$f" ] && basename "$f" | sed 's/[^0-9]//g'; done
     printf '%s\n' $IDS_EMPL
   } | grep -E '^[0-9]+$' | grep -vx 228980 | sort -un
}

# --- Emplacements -----------------------------------------------------------
# Efface un dossier. Sur exFAT (macOS 26), un nom accentue que lit `rm -rf`
# (decompose, NFD) ne s'efface pas : le volume ne l'efface que sous sa forme
# composee (NFC). Une seconde passe, entree par entree, sous cette forme.
effacer() { # <dossier>
   rm -rf "${1:?}" 2>/dev/null
   [ -e "$1" ] || [ -L "$1" ] || return 0
   find "$1" -depth 2>/dev/null | /usr/bin/iconv -f UTF-8-MAC -t UTF-8 2>/dev/null | while IFS= read -r ef_f; do
      if [ -d "$ef_f" ] && [ ! -L "$ef_f" ]; then rmdir "$ef_f" 2>/dev/null; else rm -f "$ef_f" 2>/dev/null; fi
   done
   rm -rf "${1:?}" 2>/dev/null
   [ ! -e "$1" ]
}
marque_id() { sed -n 's/^id=//p' "$1/$MARQUE" 2>/dev/null | head -1; }
empl_marquer() { # <id> <dossier>
   printf 'id=%s\n' "$1" >"$2/$MARQUE.tmp.$$" 2>/dev/null && mv "$2/$MARQUE.tmp.$$" "$2/$MARQUE" 2>/dev/null &&
      rm -f "$2/._$MARQUE" 2>/dev/null; [ -f "$2/$MARQUE" ]
}
# principal, puis les emplacements ajoutes : id TAB chemin note
empl_conf() {
   printf 'principal\t%s\n' "$CIDRE_GAMES"
   [ -f "$EMPLACEMENTS" ] && awk -F'\t' '$1 ~ /^[a-z0-9-]+$/ && $1 != "principal" && $2 ~ /^\// && !vu[$1]++ { print $1 "\t" $2 }' "$EMPLACEMENTS"
}
empl_noter_chemin() { # <id> <chemin> : un emplacement retrouve ailleurs (volume renomme)
   I=$1 C=$2 awk -F'\t' -v OFS='\t' '$1 == ENVIRON["I"] { $2 = ENVIRON["C"] } { print }' "$EMPLACEMENTS" >"$EMPLACEMENTS.tmp.$$" &&
      mv "$EMPLACEMENTS.tmp.$$" "$EMPLACEMENTS"
}
# le volume d'un chemin sous /Volumes (rien ailleurs)
volume_de() { case $1 in "$VOLUMES"/?*) vd_v=${1#"$VOLUMES"/}; printf '%s' "${vd_v%%/*}" ;; esac; }
# un chemin sur un volume qui n'est pas monte
volume_absent() { va_v=$(volume_de "$1"); [ -n "$va_v" ] && [ ! -d "$VOLUMES/$va_v" ]; }
# Ou est l'emplacement <id>, note en <chemin> ? A son chemin, s'il y porte sa
# marque. Sinon son volume a pu changer de nom ou de point de montage : on
# cherche la marque au meme endroit des autres volumes, puis a leur racine et
# un niveau plus bas. Rien : il est debranche.
empl_trouver() { # <id> <chemin>
   et_m=$(marque_id "$2")
   [ "$et_m" = "$1" ] && { printf '%s' "$2"; return 0; }
   # un dossier sans marque (effacee) au chemin note : c'est le notre ; un
   # dossier qui porte une autre marque est un autre emplacement
   if [ -z "$et_m" ] && [ -d "$2" ] && [ -n "$(volume_de "$2")" ] && empl_marquer "$1" "$2"; then printf '%s' "$2"; return 0; fi
   case $2 in "$VOLUMES"/?*) ;; *) [ -z "$et_m" ] && [ -d "$2" ] && { printf '%s' "$2"; return 0; }; return 1 ;; esac
   et_r=${2#"$VOLUMES"/}; case $et_r in */*) et_r=${et_r#*/} ;; *) et_r= ;; esac
   for et_v in "$VOLUMES"/*; do
      [ -d "$et_v" ] && [ ! -L "$et_v" ] || continue     # (Macintosh HD : un lien vers /)
      for et_c in "$et_v${et_r:+/$et_r}" "$et_v" "$et_v"/*; do
         [ -f "$et_c/$MARQUE" ] && [ "$(marque_id "$et_c")" = "$1" ] && { printf '%s' "$et_c"; return 0; }
      done
   done
   return 1
}
acf_flags() { sed -n 's/.*"StateFlags"[[:space:]]*"\(.*\)".*/\1/p' "$1/steamapps/appmanifest_$2.acf" 2>/dev/null | head -1; }
# Un jeu trouve sur un emplacement branche. Deux exemplaires (copie a la main,
# deplacement inacheve) : le premier trouve reste -- principal d'abord, puis
# dans l'ordre des ajouts --, sauf s'il est inacheve et l'autre entier ; les
# autres sont notes dans JX_<appid>.
empl_retenir() { # <appid> <dossier> <emplacement>
   eval "er_v=\${JD_$1:-}"
   if [ -n "$er_v" ]; then
      if [ "$(acf_flags "$er_v" "$1")" != 4 ] && [ "$(acf_flags "$2" "$1")" = 4 ]; then
         eval "JX_$1=\${JX_$1:-}\$er_v\$TAB; JD_$1=\$2; JE_$1=\$3"
      else eval "JX_$1=\${JX_$1:-}\$2\$TAB"; fi
      return
   fi
   eval "JD_$1=\$2; JE_$1=\$3; JH_$1="
   IDS_EMPL="$IDS_EMPL $1"
}
# Les jeux d'un emplacement debranche, d'apres son cache (un jeu deja vu
# ailleurs, branche, y reste).
empl_hors_ligne() { # <id> <chemin>
   [ -f "$EMPL_CACHE/$1.jeux" ] || return 0
   while IFS="$TAB" read -r eh_a eh_d eh_n eh_t eh_p eh_s eh_b eh_l eh_m; do
      entier "$eh_a" || continue
      eval "eh_v=\${JD_$eh_a:-}\${JH_$eh_a:-}"; [ -z "$eh_v" ] || continue
      for eh_x in eh_n eh_t eh_p eh_s eh_b eh_l; do eval "[ \"\$$eh_x\" != - ] || $eh_x="; done
      eval "JH_$eh_a=\$2/\$eh_d; JE_$eh_a=\$1; JN_$eh_a=\$eh_n; JT_$eh_a=\$eh_t; JP_$eh_a=\$eh_p; JS_$eh_a=\$eh_s; JB_$eh_a=\$eh_b; JL_$eh_a=\$eh_l"
      IDS_EMPL="$IDS_EMPL $eh_a"
   done <"$EMPL_CACHE/$1.jeux"
}
# Le cache d'un emplacement branche : une ligne par jeu -- appid, dossier, nom,
# taille, plateforme, StateFlags, buildid, dernier lancement, date du manifeste
# (- pour un champ vide). Une ligne n'est refaite que si le manifeste a change,
# le fichier n'est recrit que s'il change.
empl_cache_maj() { # <id>
   ec_f="$EMPL_CACHE/$1.jeux"
   # les jeux de cet emplacement (appid TAB dossier), et la date de leur manifeste
   ec_q=$(for ec_a in $IDS_EMPL; do
             eval "ec_e=\${JE_$ec_a:-}; ec_d=\${JD_$ec_a:-}"
             [ "$ec_e" = "$1" ] && [ -n "$ec_d" ] && printf '%s\t%s\n' "$ec_a" "$ec_d"
          done)
   [ -n "$ec_q" ] || [ -f "$ec_f" ] || return 0
   ec_v=$ec_f; [ -f "$ec_v" ] || ec_v=/dev/null
   # Une passe : la ligne du cache quand le manifeste n'a pas change, sinon
   # « ? appid dossier date », a refaire.
   ec_n=$( { printf '%s\n' "$ec_q" | while IFS="$TAB" read -r ec_a ec_d; do
                [ -n "$ec_a" ] && printf '%s\0' "$ec_d/steamapps/appmanifest_$ec_a.acf"
             done | xargs -0 stat -f "M$TAB%m$TAB%N" 2>/dev/null
             printf '%s\n' "$ec_q" | sed "s/^/Q$TAB/"
           } | awk -F'\t' -v OFS='\t' '
         FILENAME != "-" { vieux[$1 FS $2 FS $9] = $0; next }
         $1 == "M" { a = $3; sub(/.*\/appmanifest_/, "", a); sub(/\.acf$/, "", a); m[a] = $2; next }
         $1 == "Q" && $2 != "" { d = $3; sub(/.*\//, "", d); t = ($2 in m) ? m[$2] : "-"
                                 k = $2 FS d FS t
                                 if (t != "-" && (k in vieux)) print vieux[k]; else print "?", $2, d, t }' "$ec_v" - 2>/dev/null)
   case $ec_n in *"?$TAB"*)
      ec_r=
      while IFS= read -r ec_l; do
         case $ec_l in
           "?$TAB"*)
              IFS="$TAB" read -r ec_x ec_a ec_d ec_m <<EOF
$ec_l
EOF
              ec_l=$ec_a$TAB$ec_d
              for ec_v in "$(champ "$ec_a" name)" "$(champ "$ec_a" SizeOnDisk)" "$(plat "$ec_a")" "$(champ "$ec_a" StateFlags)" \
                          "$(champ "$ec_a" buildid)" "$(champ "$ec_a" LastPlayed)" "$ec_m"; do
                 ec_l=$ec_l$TAB$(printf '%s' "${ec_v:--}" | tr '\t\n' '  ')
              done ;;
         esac
         [ -n "$ec_l" ] && ec_r=$ec_r$ec_l$NL
      done <<EOF
$ec_n
EOF
      ec_n=$ec_r ;;
   *) [ -z "$ec_n" ] || ec_n=$ec_n$NL ;;
   esac
   [ "$(printf '%s' "$ec_n")" = "$(cat "$ec_f" 2>/dev/null)" ] && return 0
   mkdir -p "$EMPL_CACHE" 2>/dev/null && printf '%s' "$ec_n" >"$ec_f.tmp.$$" 2>/dev/null && mv "$ec_f.tmp.$$" "$ec_f"
}
# L'index des jeux des emplacements, fait une fois au lancement de `cidre` :
#   EMPL_LISTE   id TAB chemin TAB en_ligne (oui|non), une ligne par
#                emplacement, principal d'abord
#   JD_<appid>   le dossier du jeu, sur un emplacement branche
#   JE_<appid>   l'id de son emplacement
#   JH_<appid>   le dernier chemin connu d'un jeu dont l'emplacement est
#                debranche ; JN_, JT_, JP_, JS_, JB_, JL_ : son nom, sa taille,
#                sa plateforme, StateFlags, buildid et dernier lancement, lus
#                dans le cache de l'emplacement
#   JX_<appid>   ses autres exemplaires (TAB apres chacun)
#   IDS_EMPL     tous ces appids
empl_indexer() {
   EMPL_LISTE=; IDS_EMPL=
   while IFS="$TAB" read -r ei_id ei_c; do
      [ -n "$ei_id" ] || continue
      if [ "$ei_id" = principal ]; then ei_p=$ei_c
      elif ei_p=$(empl_trouver "$ei_id" "$ei_c"); then
         [ "$ei_p" = "$ei_c" ] || empl_noter_chemin "$ei_id" "$ei_p"
      else
         EMPL_LISTE=$EMPL_LISTE$ei_id$TAB$ei_c${TAB}non$NL
         empl_hors_ligne "$ei_id" "$ei_c"
         continue
      fi
      EMPL_LISTE=$EMPL_LISTE$ei_id$TAB$ei_p${TAB}oui$NL
      for ei_d in "$ei_p"/*; do
         [ -d "$ei_d" ] || continue
         ei_a=
         for ei_m in "$ei_d"/steamapps/appmanifest_*.acf; do
            [ -f "$ei_m" ] || continue
            ei_a=${ei_m##*/appmanifest_}; ei_a=${ei_a%.acf}; break
         done
         # un telechargement qui commence n'a pas encore de manifeste
         [ -n "$ei_a" ] || ei_a=${ei_d##*/}
         entier "$ei_a" && [ "$ei_a" != 228980 ] || continue
         empl_retenir "$ei_a" "$ei_d" "$ei_id"
      done
      empl_cache_maj "$ei_id"
   done <<EOF
$(empl_conf)
EOF
}
# Un emplacement designe par son id, son chemin, le nom de son volume (ou un
# chemin sous la racine de ce volume) : ER_ID, ER_CHEMIN, ER_EN_LIGNE.
# 1 : aucun ; 2 : plusieurs.
empl_resoudre() { # <designation>
   ER_ID=; ER_CHEMIN=; ER_EN_LIGNE=; er_n=0
   case $1 in interne|mac|"Ce Mac") set -- principal ;; esac
   er_p=; [ -d "$1" ] && er_p=$(cd "$1" && pwd -P)
   while IFS="$TAB" read -r er_i er_c er_e; do
      [ -n "$er_i" ] || continue
      [ "$1" = "$er_i" ] && { ER_ID=$er_i; ER_CHEMIN=$er_c; ER_EN_LIGNE=$er_e; return 0; }
      er_ok=non
      if [ "${1%/}" = "$er_c" ] || [ "$1" = "$(empl_nom "$er_i" "$er_c")" ]; then er_ok=oui
      elif [ -n "$er_p" ] && [ "$er_e" = oui ]; then
         er_q=$(cd "$er_c" && pwd -P)
         if [ "$er_p" = "$er_q" ]; then er_ok=oui
         # la racine d'un volume : l'emplacement qu'il porte
         elif [ "$(volume_de "$er_p")" != "" ] && [ "$er_p" = "$VOLUMES/$(volume_de "$er_p")" ]; then
            case $er_q in "$er_p"/*) er_ok=oui ;; esac
         fi
      fi
      [ $er_ok = oui ] || continue
      er_n=$((er_n + 1)); ER_ID=$er_i; ER_CHEMIN=$er_c; ER_EN_LIGNE=$er_e
   done <<EOF
$EMPL_LISTE
EOF
   [ $er_n -eq 1 ] && return 0
   [ $er_n -eq 0 ] && return 1
   return 2
}
# le nom d'un emplacement pour le joueur : « Ce Mac », son volume, ou son dossier
empl_nom() { # <id> <chemin>
   [ "$1" = principal ] && { printf 'Ce Mac'; return; }
   en_v=$(volume_de "$2"); [ -n "$en_v" ] && { printf '%s' "$en_v"; return; }
   case $2 in "$HOME"/*) printf '~/%s' "${2#"$HOME"/}" ;; *) printf '%s' "$2" ;; esac
}
# l'emplacement ou vont les nouveaux jeux (principal s'il n'existe plus)
empl_defaut() {
   ed_i=$(cat "$EMPL_DEFAUT" 2>/dev/null)
   printf '%s' "$EMPL_LISTE" | awk -F'\t' -v i="$ed_i" '$1 == i { t = 1 } END { exit !t }' || ed_i=principal
   printf '%s' "$ed_i"
}
empl_champ() { # <id> <2 : chemin, 3 : en_ligne>
   printf '%s' "$EMPL_LISTE" | awk -F'\t' -v i="$1" -v n="$2" '$1 == i { print $n; exit }'
}
# Le message d'un jeu dont l'emplacement est debranche (code 8 des commandes).
hors_ligne_message() { # <id>
   hm_e=$(empl_de "$1"); hm_c=$(empl_champ "$hm_e" 2)
   printf "%s est sur « %s », qui n'est pas branche : branche ce disque, puis recommence. Le jeu n'est ni desinstalle ni perdu." \
      "$(nom "$1")" "$(empl_nom "$hm_e" "$hm_c")"
}
# l'etat du dernier deplacement d'un jeu (`cidre move`)
depl_champ() { sed -n "s/^$2=//p" "$DEPLACEMENTS/$1" 2>/dev/null | head -1; }
# (le verrou de tests/deplacer_jeu.sh, tenu des la preparation, fait foi)
depl_en_cours() { kill -0 "$(cat "$DEPLACEMENTS/$1.verrou/pid" 2>/dev/null)" 2>/dev/null; }
# Le volume d'un dossier : VI_MONTAGE (point de montage), VI_FS (apfs, exfat,
# msdos, hfs, smbfs...), VI_LIBRE et VI_TOTAL (octets). 1 : illisible.
volume_infos() { # <chemin>
   VI_MONTAGE=; VI_FS=; VI_LIBRE=; VI_TOTAL=
   vi_l=$(df -Pk "$1" 2>/dev/null | awk 'NR == 2 { t = $2; l = $4; for (i = 1; i <= 5; i++) $i = ""; sub(/^ +/, ""); print t "\t" l "\t" $0 }')
   [ -n "$vi_l" ] || return 1
   IFS="$TAB" read -r vi_t vi_f VI_MONTAGE <<EOF
$vi_l
EOF
   VI_TOTAL=$((vi_t * 1024)); VI_LIBRE=$((vi_f * 1024))
   VI_FS=$(mount | M=" on $VI_MONTAGE (" awk 'index($0, ENVIRON["M"]) { s = substr($0, index($0, ENVIRON["M"]) + length(ENVIRON["M"])); sub(/[,)].*/, "", s); print s; exit }')
}
# les jeux d'un emplacement (d'apres l'index) : nombre, puis octets
empl_jeux() { # <id>
   ej_n=0; ej_o=0
   for ej_a in $IDS_EMPL; do
      [ "$(empl_de "$ej_a")" = "$1" ] || continue
      ej_n=$((ej_n + 1)); ej_t=$(champ "$ej_a" SizeOnDisk); entier "$ej_t" && ej_o=$((ej_o + ej_t))
   done
   printf '%s %s' "$ej_n" "$ej_o"
}
# essayer d'ecrire dans un dossier, plutot que demander les droits (NTFS : lecture seule)
inscriptible() { : >"$1/.cidre-essai.$$" 2>/dev/null && rm -f "${1:?}/.cidre-essai.$$"; }
# Un emplacement en JSON (`cidre emplacements --json`) :
#   id, nom (« Ce Mac », le volume, ou le dossier), chemin, volume (null sur ce
#   Mac), en_ligne, defaut (les nouveaux jeux y vont), principal, amovible,
#   systeme_fichiers, libre et total (octets ; null debranche), inscriptible,
#   jeux et taille_jeux (d'apres le cache s'il est debranche), remarque (une
#   phrase pour le joueur, ou null).
empl_json() { # <id> <chemin> <en_ligne>
   ej_d=false; [ "$(empl_defaut)" = "$1" ] && ej_d=true
   ej_p=false; [ "$1" = principal ] && ej_p=true
   ej_v=$(volume_de "$2")
   set -- "$1" "$2" "$3" $(empl_jeux "$1")
   ej_fs=null; ej_li=null; ej_to=null; ej_am=false; ej_w=null; ej_r=
   if [ "$3" = oui ]; then
      [ "$1" = principal ] && mkdir -p "$2" 2>/dev/null
      if volume_infos "$2"; then
         ej_fs=$(json "$VI_FS"); ej_li=$VI_LIBRE; ej_to=$VI_TOTAL
      fi
      if [ "$1" != principal ]; then
         ej_i=$(diskutil info -plist "$VI_MONTAGE" 2>/dev/null | plutil -extract Internal raw - 2>/dev/null)
         [ "$ej_i" = false ] && ej_am=true
      fi
      inscriptible "$2" && ej_w=true || ej_w=false
      case $VI_FS in
        exfat) ej_r="exFAT : lisible aussi par Windows, mais sans droits Unix ni clones APFS ; APFS convient mieux a un disque reserve au Mac." ;;
        msdos) ej_r="FAT32 : aucun fichier de plus de 4 Go ; beaucoup de jeux n'y tiennent pas. Reformate le disque en APFS ou exFAT." ;;
        smbfs|nfs|afpfs|webdav) ej_r="Volume reseau : les jeux y chargent lentement." ;;
      esac
      [ $ej_w = false ] && ej_r="Lecture seule (NTFS ?) : Cidre ne peut rien y installer ni y deplacer."
   else
      # (debranche : c'est donc un disque qu'on retire)
      ej_am=true
      ej_r="Debranche : branche le disque « $(empl_nom "$1" "$2") » pour retrouver ses $4 jeux."
      [ "$4" -gt 1 ] || ej_r="Debranche : branche le disque « $(empl_nom "$1" "$2") » pour retrouver ses jeux."
   fi
   [ "$3" = oui ] && ej_l=true || ej_l=false
   printf '{"id":%s,"nom":%s,"chemin":%s,"volume":%s,"en_ligne":%s,"defaut":%s,"principal":%s,"amovible":%s,"systeme_fichiers":%s,"libre":%s,"total":%s,"inscriptible":%s,"jeux":%s,"taille_jeux":%s,"remarque":%s}' \
      "$(json "$1")" "$(json "$(empl_nom "$1" "$2")")" "$(json "$2")" "$(json_ou_null "$ej_v")" "$ej_l" "$ej_d" "$ej_p" "$ej_am" \
      "$ej_fs" "$ej_li" "$ej_to" "$ej_w" "$4" "$5" "$(json_ou_null "$ej_r")"
}
# Les emplacements Cidre presents sur les volumes branches et pas encore
# ajoutes (retires, ou venus d'un autre Mac) : chemin TAB id TAB nombre de jeux.
empl_detecter() {
   for dt_v in "$VOLUMES"/*; do
      [ -d "$dt_v" ] && [ ! -L "$dt_v" ] || continue
      for dt_c in "$dt_v" "$dt_v"/*; do
         [ -f "$dt_c/$MARQUE" ] || continue
         dt_i=$(marque_id "$dt_c")
         printf '%s' "$EMPL_LISTE" | awk -F'\t' -v i="$dt_i" '$1 == i { t = 1 } END { exit !t }' && continue
         dt_n=0; for dt_m in "$dt_c"/*/steamapps/appmanifest_*.acf; do [ -f "$dt_m" ] && dt_n=$((dt_n + 1)); done
         printf '%s\t%s\t%s\n' "$dt_c" "$dt_i" "$dt_n"
      done
   done
}
empl_lister() {
   if [ "$JSON" = oui ]; then
      printf '{"emplacements":['; el_s=
      while IFS="$TAB" read -r el_i el_c el_e; do
         [ -n "$el_i" ] || continue
         printf '%s\n  ' "$el_s"; empl_json "$el_i" "$el_c" "$el_e"; el_s=,
      done <<EOF
$EMPL_LISTE
EOF
      printf '\n],"detectes":['; el_s=
      empl_detecter | while IFS="$TAB" read -r el_c el_i el_n; do
         printf '%s{"chemin":%s,"id":%s,"volume":%s,"jeux":%s}' "$el_s" "$(json "$el_c")" "$(json "$el_i")" "$(json_ou_null "$(volume_de "$el_c")")" "$el_n"; el_s=,
      done
      printf ']}\n'
      return
   fi
   printf "%-22s %-18s %-10s %-9s %-5s %s\n" ID EMPLACEMENT ETAT LIBRE JEUX CHEMIN
   el_df=$(empl_defaut)
   while IFS="$TAB" read -r el_i el_c el_e; do
      [ -n "$el_i" ] || continue
      set -- $(empl_jeux "$el_i")
      if [ "$el_e" = oui ]; then el_t=branche; volume_infos "$el_c" && el_l=$(awk -v o="$VI_LIBRE" 'BEGIN { if (o >= 10737418240) printf "%.0f Go", o / 1073741824; else if (o >= 1073741824) printf "%.1f Go", o / 1073741824; else printf "%.0f Mo", o / 1048576 }') || el_l=?
      else el_t=DEBRANCHE; el_l=-; fi
      el_m=$el_i; [ "$el_i" = "$el_df" ] && el_m="$el_i *"
      printf "%-22s %-18.18s %-10s %-9s %-5s %s\n" "$el_m" "$(empl_nom "$el_i" "$el_c")" "$el_t" "$el_l" "$1" "$el_c"
   done <<EOF
$EMPL_LISTE
EOF
   echo "(* : les nouveaux jeux y vont ; \`cidre emplacements defaut <id>\` pour changer)"
   empl_detecter | while IFS="$TAB" read -r el_c el_i el_n; do
      echo "detecte, pas encore ajoute : $el_c ($el_n jeux) -- cidre emplacements ajouter '$el_c'"
   done
}
# un id neuf, lisible : le nom du volume ou du dossier, et quatre chiffres hexa
empl_nouvel_id() { # <chemin>
   ni_b=$(volume_de "$1"); [ -n "$ni_b" ] || ni_b=$(basename "$1")
   ni_b=$(printf '%s' "$ni_b" | /usr/bin/iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//' | cut -c1-20)
   while :; do
      ni_i=${ni_b:-disque}-$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n')
      printf '%s' "$EMPL_LISTE" | awk -F'\t' -v i="$ni_i" '$1 == i { t = 1 } END { exit !t }' || { printf '%s' "$ni_i"; return; }
   done
}
empl_refus() { # <code> <message>
   echo "$2" >&2
   [ "$JSON" = oui ] && printf '{"erreur":%s}\n' "$(json "$2")"
   exit "$1"
}
empl_ajouter() { # <chemin>
   [ -n "$1" ] || { echo "usage: cidre emplacements ajouter <dossier ou disque>" >&2; exit 2; }
   ea_c=$1; case $ea_c in /*) ;; *) ea_c="$PWD/$ea_c" ;; esac
   [ -d "$ea_c" ] && ea_c=$(cd "$ea_c" && pwd -P)
   # La racine d'un volume : l'emplacement qu'il porte deja, sinon un dossier
   # « Jeux Cidre » dessus (le reste du disque n'est pas a Cidre).
   if [ -n "$(volume_de "$ea_c")" ] && [ "$ea_c" = "$VOLUMES/$(volume_de "$ea_c")" ]; then
      ea_r=$ea_c; ea_c="$ea_r/Jeux Cidre"
      for ea_x in "$ea_r" "$ea_r"/*; do [ -f "$ea_x/$MARQUE" ] && { ea_c=$ea_x; break; }; done
   fi
   if [ ! -d "$ea_c" ]; then
      [ -d "$(dirname "$ea_c")" ] || empl_refus 1 "dossier introuvable : $(dirname "$ea_c")"
      mkdir "$ea_c" 2>/dev/null || empl_refus 1 "impossible de creer $ea_c (disque en lecture seule ?)"
   fi
   ea_c=$(cd "$ea_c" && pwd -P)
   # deja un emplacement ? ni dedans, ni autour d'un autre
   while IFS="$TAB" read -r ea_i ea_k ea_e; do
      [ -n "$ea_i" ] || continue
      [ "$ea_e" = oui ] && [ -d "$ea_k" ] && ea_k=$(cd "$ea_k" && pwd -P)
      if [ "$ea_k" = "$ea_c" ]; then
         echo "deja un emplacement : $ea_i ($ea_c)" >&2
         [ "$JSON" = oui ] && { empl_json "$ea_i" "$ea_c" "$ea_e"; echo; }
         exit 0
      fi
      case $ea_c in "$ea_k"/*) empl_refus 1 "$ea_c est dans l'emplacement « $(empl_nom "$ea_i" "$ea_k") » ($ea_k)" ;; esac
      case $ea_k in "$ea_c"/*) empl_refus 1 "$ea_c contient l'emplacement « $(empl_nom "$ea_i" "$ea_k") » ($ea_k)" ;; esac
   done <<EOF
$EMPL_LISTE
EOF
   volume_infos "$ea_c"
   [ "$VI_FS" = msdos ] && empl_refus 1 "$(empl_nom - "$ea_c") est en FAT32 : aucun fichier de plus de 4 Go, beaucoup de jeux n'y tiennent pas. Reformate-le en APFS (Mac seulement) ou exFAT (Mac et Windows)."
   inscriptible "$ea_c" || empl_refus 1 "$ea_c est en lecture seule (NTFS ?) : Cidre ne pourrait rien y installer."
   # L'id : celui de sa marque (un emplacement retire puis rajoute, ou venu
   # d'un autre Mac : ses jeux sont retrouves tels quels), sinon un neuf.
   ea_i=$(marque_id "$ea_c")
   if [ -n "$ea_i" ] && printf '%s' "$EMPL_LISTE" | awk -F'\t' -v i="$ea_i" '$1 == i { t = 1 } END { exit !t }'; then
      # deja connu, debranche ailleurs : c'est lui, a un autre endroit
      empl_noter_chemin "$ea_i" "$ea_c"
   else
      case $ea_i in ''|principal|*[!a-z0-9-]*) ea_i=$(empl_nouvel_id "$ea_c") ;; esac
      empl_marquer "$ea_i" "$ea_c" || empl_refus 1 "impossible d'ecrire la marque de l'emplacement dans $ea_c"
      mkdir -p "$CIDRE_DIR" && printf '%s\t%s\n' "$ea_i" "$ea_c" >>"$EMPLACEMENTS"
   fi
   empl_indexer
   set -- $(empl_jeux "$ea_i")
   if [ "$JSON" = oui ]; then empl_json "$ea_i" "$ea_c" oui; echo
   else
      echo "emplacement ajoute : $ea_i  « $(empl_nom "$ea_i" "$ea_c") »  $ea_c"
      [ "$1" -eq 0 ] || echo "  $1 jeu(x) deja la, reconnus"
      case $VI_FS in exfat) echo "  exFAT : lisible aussi par Windows ; sans droits Unix ni clones APFS (APFS convient mieux a un disque reserve au Mac)" ;; esac
      echo "  y installer un jeu : cidre dl <appid> --vers $ea_i ; y deplacer un jeu : cidre move <appid> $ea_i"
   fi
}
empl_retirer() { # <emplacement>
   [ -n "$1" ] || { echo "usage: cidre emplacements retirer <emplacement>" >&2; exit 2; }
   empl_resoudre "$1"; case $? in 1) empl_refus 2 "emplacement inconnu : $1" ;; 2) empl_refus 2 "plusieurs emplacements repondent a « $1 » : donne son id" ;; esac
   [ "$ER_ID" = principal ] && empl_refus 1 "l'emplacement principal (ce Mac) ne se retire pas"
   for er_f in "$DEPLACEMENTS"/*; do
      case ${er_f##*/} in *[!0-9]*) continue ;; esac
      [ -f "$er_f" ] || continue; er_a=${er_f##*/}
      depl_en_cours "$er_a" || continue
      { [ "$(depl_champ "$er_a" de)" = "$ER_ID" ] || [ "$(depl_champ "$er_a" vers)" = "$ER_ID" ]; } &&
         empl_refus 4 "un deplacement de jeu vers ou depuis cet emplacement est en cours (appid $er_a) : attends sa fin"
   done
   set -- $(empl_jeux "$ER_ID")
   I=$ER_ID awk -F'\t' '$1 != ENVIRON["I"]' "$EMPLACEMENTS" >"$EMPLACEMENTS.tmp.$$" && mv "$EMPLACEMENTS.tmp.$$" "$EMPLACEMENTS"
   rm -f "${EMPL_CACHE:?}/${ER_ID:?}.jeux"
   [ "$(cat "$EMPL_DEFAUT" 2>/dev/null)" = "$ER_ID" ] && rm -f "${EMPL_DEFAUT:?}"
   if [ "$JSON" = oui ]; then printf '{"retire":%s,"jeux":%s}\n' "$(json "$ER_ID")" "$1"
   else
      echo "emplacement retire : $ER_ID ($ER_CHEMIN)"
      [ "$1" -eq 0 ] || echo "  ses $1 jeu(x) restent sur le disque, sans etre listes ; \`cidre emplacements ajouter '$ER_CHEMIN'\` les retrouve"
   fi
}
empl_choisir_defaut() { # <emplacement>
   [ -n "$1" ] || { echo "usage: cidre emplacements defaut <emplacement>" >&2; exit 2; }
   empl_resoudre "$1"; case $? in 1) empl_refus 2 "emplacement inconnu : $1" ;; 2) empl_refus 2 "plusieurs emplacements repondent a « $1 » : donne son id" ;; esac
   if [ "$ER_ID" = principal ]; then rm -f "${EMPL_DEFAUT:?}"
   else mkdir -p "$CIDRE_DIR" && printf '%s\n' "$ER_ID" >"$EMPL_DEFAUT"; fi
   if [ "$JSON" = oui ]; then printf '{"defaut":%s}\n' "$(json "$ER_ID")"
   else
      echo "les nouveaux jeux iront dans : $(empl_nom "$ER_ID" "$ER_CHEMIN") ($ER_ID)"
      [ "$ER_EN_LIGNE" = oui ] || echo "  (il est debranche : rebranche-le avant d'installer un jeu)"
   fi
}
# tous les jeux : appids Steam, puis jeux hors Steam
ids() { appids; awk -F'\t' '/^local-/ {print $1}' "$LOCAUX" 2>/dev/null; }
# Temoin « en cours » pour un jeu que cidre lance lui-meme et attend (dossier
# Cidre, hors Steam). Steam, lui, note dans son registre le jeu qu'il a lance.
EN_COURS="$CIDRE_DIR/en-cours"
temoin_en_cours() { # <id>
   case $1 in ''|*[!a-z0-9-]*) return ;; esac
   mkdir -p "$EN_COURS" && echo $$ >"$EN_COURS/$1"
   trap 'rm -f "$EN_COURS/'"$1"'"' EXIT
}

# Les jeux dont on sait ou sont les sauvegardes : le fichier livre, et celui de
# l'utilisateur (`cidre saves set`), qui passe avant.
SAVES_PERSO="$CIDRE_DIR/saves.conf"
saves_ids() { cat "$SAVES_PERSO" "$R/outil-steam/saves.conf" 2>/dev/null | awk -F'\t' '!/^#/ && NF>=2 && !vu[$1]++ {print $1}'; }
# Steam synchronise-t-il lui-meme les sauvegardes de ce jeu (`api`, `lien`) ?
saves_steam() { est_local "$1" && return 1; sh "$R/tests/lier_saves_steam.sh" "$1" mode 2>/dev/null; }
# les jeux dont les sauvegardes sont suivies : par Steam, ou par la copie Cidre
saves_suivis() { { saves_ids; for a in $(appids); do [ -n "$(saves_steam "$a")" ] && echo "$a"; done; } | awk '!vu[$0]++'; }

# chaine JSON (echappe \ " et tabulation)
json() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g')"; }
# la fiche JSON d'un jeu (sans l'accolade fermante : `info` y ajoute des champs)
fiche_json() {
   p=$(plat "$1"); s=$(source_de "$1")
   [ "$p" = macos ] && l=natif || l=cidre
   [ "$p" = absent ] && inst=false || inst=true
   # dossier Cidre : un telechargement interrompu n'est pas un jeu installe...
   # sauf si c'est la mise a jour d'un jeu qui l'etait : il reste lancable
   [ "$s" = cidre ] && [ "$(champ "$1" StateFlags)" != 4 ] && [ -z "$(maj_champ "$1" build_avant)" ] && inst=false
   # le wrapper ne concerne que les jeux lances par Steam
   w=null; [ "$s" = steam ] && { [ "$(cidre_wrap "$1")" = oui ] && w=true || w=false; }
   t=$(champ "$1" SizeOnDisk); d=$(champ "$1" LastPlayed)
   # un jeu hors Steam n'a pas d'appid : `id` est la cle commune a tous les jeux
   est_local "$1" && a=null || a=$1
   # "emplacement" : l'id de l'emplacement d'un jeu Cidre (null ailleurs) ;
   # "en_ligne" : false quand son disque est debranche (il reste installe) ;
   # "deplacement" : son deplacement en cours ou inacheve (null sinon)
   fj_e=null; fj_l=true
   if est_local "$1"; then [ ! -f "$(local_champ "$1" 3)" ] && volume_absent "$(local_champ "$1" 3)" && fj_l=false
   elif [ "$s" = cidre ]; then eval "fj_e=\\\"\${JE_$1:-}\\\""; hors_ligne "$1" && fj_l=false; fi
   printf '{"id":"%s","appid":%s,"nom":%s,"plateforme":"%s","lancement":"%s","source":"%s","installe":%s,"wrapper":%s,"chemin":%s,"taille":%s,"dernier_lancement":%s,"emplacement":%s,"en_ligne":%s,"deplacement":%s' \
      "$1" "$a" "$(json "$(nom "$1")")" "$p" "$l" "$s" "$inst" "$w" "$(json "$(chemin "$1")")" "${t:-0}" "${d:-0}" "$fj_e" "$fj_l" "$(depl_json "$1")"
}
# Le deplacement d'un jeu, en JSON : null, ou {"etat": en_cours (avec
# "phase", "avancement" en %, "octets", "total"), interrompu ou echoue (avec
# "raison" et "message") ; "de" et "vers" : les ids des emplacements}.
depl_json() { # <id>
   [ -f "$DEPLACEMENTS/$1" ] || depl_en_cours "$1" || { printf null; return; }
   dj_e=$(depl_champ "$1" etat)
   # arrete pendant l'effacement de l'original : le jeu est arrive, c'est fait
   if ! depl_en_cours "$1" && [ -n "$(depl_champ "$1" vers)" ] && [ "$(depl_champ "$1" vers)" = "$(empl_de "$1")" ]; then printf null; return; fi
   [ "$dj_e" = en_cours ] && ! depl_en_cours "$1" && dj_e=interrompu
   depl_en_cours "$1" && dj_e=en_cours
   dj_p=; dj_o=; dj_t=
   [ "$dj_e" != en_cours ] || [ ! -f "$DEPLACEMENTS/$1.avancement" ] || read -r dj_p dj_o dj_t <"$DEPLACEMENTS/$1.avancement"
   case $dj_p in ''|*[!0-9.]*) dj_p=null ;; esac
   printf '{"etat":"%s","phase":%s,"de":%s,"vers":%s,"avancement":%s,"octets":%s,"total":%s,"raison":%s,"message":%s}' \
      "$dj_e" "$(json_ou_null "$(depl_champ "$1" phase)")" "$(json_ou_null "$(depl_champ "$1" de)")" "$(json_ou_null "$(depl_champ "$1" vers)")" \
      "$dj_p" "$(nombre "$dj_o")" "$(nombre "$dj_t")" \
      "$(json_ou_null "$(depl_champ "$1" raison)")" "$(json_ou_null "$(depl_champ "$1" message)")"
}

# SteamCMD a son propre dossier de travail, a part du client Steam. Par defaut
# ils partagent ~/Library/Application Support/Steam, et le client, en ecrivant
# sa configuration, efface la session que SteamCMD y avait memorisee : il
# fallait se reconnecter apres chaque lancement de Steam. SteamCMD suit HOME.
SCMD_HOME="$CIDRE_DIR/steamcmd"
# Sur la meme machine, SteamCMD et le client Steam annoncent a Steam la meme
# adresse privee, et Steam coupe alors le client des que SteamCMD se connecte au
# compte (« Session Replaced ») : amis et chat hors ligne, sans reconnexion.
# SteamCMD sait annoncer une autre adresse ; rien n'y est envoye, elle ne sert
# qu'a distinguer sa session. Une par lancement, hors des plages des box.
SCMD_ID="-private_ip_override 10.$((254 - ($$ >> 16 & 1))).$(($$ >> 8 & 255)).$(($$ & 255))"
# session memorisee, mot de passe demande au terminal s'il le faut
scmd() { mkdir -p "$SCMD_HOME"; scmd_garde env HOME="$SCMD_HOME" "$SCMD" $SCMD_ID "$@"; }
# Le petit outil natif (tests/cidre_outil.c) : le pseudo-terminal prete a
# SteamCMD et la lecture des caches binaires du client Steam. Un runtime
# installe le livre construit -- un Mac sans outils de developpement n'a ni
# Python ni compilateur. Un depot de developpement, lui, a la source : on l'y
# construit au premier besoin, et quand elle a change.
OUTIL="$R/build/cidre-outil"
outil_pret() {
   if [ -f "$R/tests/cidre_outil.c" ] && { [ ! -x "$OUTIL" ] || [ "$R/tests/cidre_outil.c" -nt "$OUTIL" ]; }; then
      sh "$R/tests/construire_cidre_outil.sh" >&2 || return 1
   fi
   [ -x "$OUTIL" ] || { echo "Runtime incomplet : $OUTIL absent. Reinstalle le runtime Cidre." >&2; return 1; }
}
# session memorisee ou rien : jamais de tentative de mot de passe (code 3)
scmd_memorise() { outil_pret || return 1; mkdir -p "$SCMD_HOME"; scmd_garde env HOME="$SCMD_HOME" "$OUTIL" session "$SCMD" $SCMD_ID "$@"; }
# Filet : l'option n'est pas documentee et SteamCMD se met a jour seul. Si le
# client a quand meme ete coupe pendant la commande, il ne se reconnecte pas de
# lui-meme : on le lui demande, et on le dit (fd 3 : la sortie de SteamCMD est
# parfois capturee).
exec 3>&2
scmd_garde() {
   jc="$STEAM/logs/connection_log.txt"; nc=$(wc -l 2>/dev/null <"$jc"); nc=${nc:-0}
   "$@"; rcs=$?
   if tail -n +$((nc + 1)) "$jc" 2>/dev/null | grep -q "not auto reconnecting due to Session Replaced"; then
      open -g "steam://open/goonline"
      echo "Cidre : SteamCMD a deconnecte le client Steam (amis hors ligne) ; reconnexion demandee." >&3
   fi
   return $rcs
}
# sans compte : les informations publiques de Steam (versions des jeux)
scmd_anonyme() { mkdir -p "$CIDRE_DIR/steamcmd-anonyme"; HOME="$CIDRE_DIR/steamcmd-anonyme" "$SCMD" +login anonymous "$@" </dev/null; }

# binaire SteamCMD : le notre d'abord, puis PATH/brew. CIDRE_STEAMCMD l'impose
# (pour les essais) : celui-la, ou aucun.
resolve_steamcmd() {
   if [ -n "${CIDRE_STEAMCMD:-}" ]; then [ -x "$CIDRE_STEAMCMD" ] && echo "$CIDRE_STEAMCMD"; return; fi
   for c in "$R/tools/steamcmd/steamcmd.sh" "$STEAMCMD" "$(command -v steamcmd 2>/dev/null)"; do
      [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return; }
   done
}
# nom de compte Steam (MostRecent) depuis loginusers.vdf, sinon CIDRE_STEAM_USER
steam_user() {
   [ -n "${CIDRE_STEAM_USER:-}" ] && { echo "$CIDRE_STEAM_USER"; return; }
   sh "$R/tests/compte_steam.sh" "$STEAM/config/loginusers.vdf" 2>/dev/null
}

# plateforme reellement INSTALLEE (definitif d'apres les fichiers)
plat() {
   # (un jeu hors Steam dont le disque est debranche reste un jeu Windows)
   est_local "$1" && { pl_e=$(local_champ "$1" 3); { [ -f "$pl_e" ] || volume_absent "$pl_e"; } && echo windows || echo absent; return; }
   # emplacement debranche : ce qu'on en savait
   hors_ligne "$1" && { eval "pl_p=\${JP_$1:-}"; echo "${pl_p:-inconnu}"; return; }
   d=$(chemin "$1")
   [ -d "$d" ] || { echo absent; return; }
   find "$d" -maxdepth 3 -name '*.app' -type d 2>/dev/null | grep -q . && { echo macos; return; }
   find "$d" -maxdepth 2 -name '*.exe' 2>/dev/null | grep -q . && { echo windows; return; }
   echo inconnu
}
# L'executable principal d'un jeu du dossier Cidre : on ecarte les variantes
# (_gl), lanceurs, serveurs et handlers de crash ; a defaut, le premier .exe trouve.
exe_principal() {
   e=$(find "$1" -maxdepth 1 -name '*.exe' 2>/dev/null \
         | grep -viE '_gl\.exe$|_server|server\.exe$|launcher|crash|unitycrash|vcredist|redist|setup|dxsetup|install' \
         | head -1)
   [ -n "$e" ] || e=$(find "$1" -maxdepth 2 -name '*.exe' 2>/dev/null | head -1)
   # Unreal sans amorceur a la racine (Sherlock Holmes Chapter One :
   # SH9/Binaries/Win64/SHCO.exe) : le binaire du projet, pas ceux du moteur
   [ -n "$e" ] || e=$(find "$1" -maxdepth 4 -path '*/Binaries/Win64/*.exe' 2>/dev/null \
         | grep -v '/Engine/Binaries/' | grep -viE 'crash|prereq|unrealcef|epicwebhelper' | head -1)
   [ -n "$e" ] && echo "$e"
}
# L'executable d'un jeu du dossier Cidre : celui de sa fiche (`exe` de [jeu],
# relatif au dossier du jeu) s'il est sur le disque, sinon le premier .exe de la
# racine. Steam lance la cible de sa configuration, pas forcement l'exe de la
# racine : Still Wakes the Deep a a la racine un amorceur qui cherche un binaire
# absent de la version Steam (Habitat-Win64-Shipping.exe, code 45).
exe_du_jeu() { # <appid> <dossier du jeu>
   f=$(sh "$R/tests/fiche_profil.sh" chemin "$1" 2>/dev/null)
   if [ -n "$f" ]; then
      e=$(sh "$R/tests/fiche_profil.sh" toml "$f" 2>/dev/null | awk -F'\t' '$1 == "jeu" && $2 == "exe" { print $4; exit }')
      [ -n "$e" ] && [ -f "$2/$e" ] && { echo "$2/$e"; return; }
   fi
   exe_principal "$2"
}
# Cidre (notre wrapper) pose sur ce jeu ?
cidre_wrap() { grep -A6 "\"$1\"$" "$STEAM"/userdata/*/config/localconfig.vdf 2>/dev/null | grep -q "lancer_depuis_steam.sh" && echo oui || echo non; }

# --- Mises a jour des jeux du dossier Cidre ---------------------------------
# Le build installe d'un jeu (son manifeste) face a celui que publie Steam.
# APPINFO garde la fiche publique des jeux installes, lue par SteamCMD sans
# compte ; MAJ_ETATS/<appid> la derniere mise a jour de chaque jeu (en cours,
# echouee et pourquoi, faite), en lignes `cle=valeur`. `cidre updates`, `cidre
# info` et `cidre play` en tirent le meme etat (maj_etat).
APPINFO="$CIDRE_DIR/cache/appinfo.txt"
MAJ_ETATS="$CIDRE_DIR/maj"
MAJ_TTL=${CIDRE_MAJ_TTL:-30}                 # minutes pendant lesquelles APPINFO fait foi
MAJ_BUDGET=${CIDRE_MAJ_BUDGET:-8}            # secondes accordees a Steam avant un lancement
MAJ_LIBRE_MIN=${CIDRE_MAJ_LIBRE_MIN:-1024}   # Mo libres sous lesquels on ne telecharge rien
CR=$(printf '\r')
# le lanceur de la pile Cidre (CIDRE_LANCEUR : un autre, pour les essais)
LANCEUR=${CIDRE_LANCEUR:-$R/tests/lancer_depuis_steam.sh}
entier() { case $1 in ''|*[!0-9]*) return 1 ;; esac; }
nombre() { entier "$1" && printf '%s' "$1" || printf null; }
json_ou_null() { [ -n "$1" ] && json "$1" || printf null; }
# En --json, la sortie standard de `cidre play` porte des evenements, un objet
# JSON par ligne ; ce qui se lit (et la sortie de SteamCMD) va a l'erreur.
dire() { if [ "$JSON" = oui ]; then printf '%s\n' "$*" >&2; else printf '%s\n' "$*"; fi; }
evenement() { [ "$JSON" != oui ] || printf '%s\n' "$1"; }

# Deux sources pour le build que publie Steam : APPINFO, que remplit SteamCMD
# sans compte (quelques secondes, davantage quand il se met lui-meme a jour), et
# le cache du client Steam (CLIENT_APPINFO), qui suit de lui-meme les fiches des
# jeux du compte et que cidre-outil lit en quelques millisecondes, sans reseau.
# Un build publie ne recule pas : des deux, le plus grand fait foi.
CLIENT_APPINFO="$STEAM/appcache/appinfo.vdf"
CLIENT_JOURNAL="$STEAM/logs/appinfo_log.txt"
appinfo_perime() { [ ! -s "$APPINFO" ] || [ -n "$(find "$APPINFO" -mmin +"$MAJ_TTL" 2>/dev/null)" ]; }
# Le client Steam redemande les fiches de son compte toutes les quinze minutes
# environ (une ligne dans son appinfo_log.txt a chaque fois) et ne recrit son
# cache que si l'une a change (journal du client, 2026-10-14). Son cache est
# donc juste s'il a ete ecrit recemment, ou si le client tourne et vient de
# redemander, aussi ancien soit-il.
client_tourne() {
   if [ -n "${CIDRE_STEAM_TOURNE:-}" ]; then sh -c "$CIDRE_STEAM_TOURNE" >/dev/null 2>&1
   else pgrep -x steam_osx >/dev/null 2>&1; fi
}
client_frais() {
   [ -s "$CLIENT_APPINFO" ] || return 1
   [ -n "$(find "$CLIENT_APPINFO" -mmin -"$MAJ_TTL" 2>/dev/null)" ] && return 0
   [ -n "$(find "$CLIENT_JOURNAL" -mmin -"$MAJ_TTL" 2>/dev/null)" ] && client_tourne
}
# « appid <TAB> build » que le cache du client donne pour ces jeux (rien sans lui)
builds_client() { [ $# -gt 0 ] && [ -s "$CLIENT_APPINFO" ] && outil_pret 2>/dev/null && "$OUTIL" builds "$CLIENT_APPINFO" "$@" 2>/dev/null | cut -f1,2; }
# un jeu installe depuis la derniere lecture n'y est pas encore
appinfo_sans() { [ "$(acf "$1")" -nt "$APPINFO" ] && ! grep -q "^AppID : $1," "$APPINFO" 2>/dev/null; }
# Sait-on, de fraiche date (moins de MAJ_TTL minutes), ce que Steam publie pour ce jeu ?
connu_frais() {
   { ! appinfo_perime && grep -q "^AppID : $1," "$APPINFO" 2>/dev/null; } ||
   { client_frais && [ -n "$(builds_client "$1")" ]; }
}
# la date de ce qu'on sait : la plus recente des deux sources (pour le client,
# sa derniere relecture quand il tourne, sinon l'ecriture de son cache)
verifie_le() {
   vl_a=$(stat -f %m "$APPINFO" 2>/dev/null); vl_c=$(stat -f %m "$CLIENT_APPINFO" 2>/dev/null)
   vl_j=$(stat -f %m "$CLIENT_JOURNAL" 2>/dev/null)
   [ -n "$vl_j" ] && [ -n "$vl_c" ] && [ "$vl_j" -gt "$vl_c" ] && client_tourne && vl_c=$vl_j
   [ -n "$vl_c" ] && [ -n "$(builds_client "$1")" ] && [ "$vl_c" -gt "${vl_a:-0}" ] && vl_a=$vl_c
   printf '%s' "$vl_a"
}
# Une seule demande a SteamCMD a la fois (lancement, `cidre updates`, sa
# variante en fond) : la seconde attend la fin de la premiere et s'en sert.
# 0 : le verrou est a nous ; 1 : une autre a refait le cache pendant qu'on
# attendait ; 2 : elle n'a rien rapporte. Un verrou de plus de 2 minutes est
# un reste (commande tuee) : on le reprend.
appinfo_verrou() {
   av_v="$APPINFO.verrou"; mkdir -p "$(dirname "$APPINFO")"
   av_t=$(stat -f %m "$APPINFO" 2>/dev/null); av_n=0
   while ! mkdir "$av_v" 2>/dev/null; do
      if [ -n "$(find "$av_v" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then rmdir "$av_v" 2>/dev/null; continue; fi
      sleep 0.2; av_n=$((av_n + 1))
      if [ ! -d "$av_v" ]; then
         [ "$(stat -f %m "$APPINFO" 2>/dev/null)" != "$av_t" ] && return 1
         return 2
      fi
      [ $av_n -lt 900 ] || return 2
   done
   return 0
}
# Redemande a Steam la fiche publique des jeux installes. 0 : cache neuf ;
# 1 : Steam n'a pas repondu ; 2 : SteamCMD introuvable.
appinfo_rafraichir() {
   [ -n "$(resolve_steamcmd)" ] || return 2
   appinfo_verrou
   case $? in 1) return 0 ;; 2) return 1 ;; esac
   appinfo_demander; ar_rc=$?
   rmdir "$APPINFO.verrou" 2>/dev/null
   return $ar_rc
}
appinfo_demander() {
   ar_d=""
   for ar_a in $(appids); do [ -n "$(champ "$ar_a" buildid)" ] && ar_d="$ar_d +app_info_print $ar_a"; done
   [ -n "$ar_d" ] || return 0
   SCMD=$(resolve_steamcmd); [ -n "$SCMD" ] || return 2
   scmd_anonyme +app_info_update 1 $ar_d +quit >"$APPINFO.tmp.$$" 2>&1
   grep -q "^AppID : " "$APPINFO.tmp.$$" || { rm -f "${APPINFO:?}.tmp.$$"; return 1; }
   mv "$APPINFO.tmp.$$" "$APPINFO"
}
# Un jeu qu'on installe sans fiche dans la base de profils : une fiche provisoire
# (resume ProtonDB, nom et plateformes du magasin Steam ; tests/fiche_profil.sh
# provisoire), ecrite en fond pendant le telechargement : `cidre info --json` en
# dit deja quelque chose. Jamais un obstacle : hors ligne ou jeu inconnu, rien.
fiche_provisoire() { # <appid>
   ( sh "$R/tests/fiche_profil.sh" provisoire "$1" ) >/dev/null 2>&1 3>&- &
}
# La meme, sans faire attendre un lancement plus de MAJ_BUDGET secondes (3 :
# trop lent). La demande finit alors en fond : elle servira la fois suivante,
# et efface derriere elle ce qu'on n'attend plus.
appinfo_rafraichir_borne() {
   [ -n "$(resolve_steamcmd)" ] || return 2
   mkdir -p "$(dirname "$APPINFO")"
   find "$(dirname "$APPINFO")" -name 'appinfo.txt.rc.*' -mmin +2 -delete 2>/dev/null
   ab_f="$APPINFO.rc.$$"; : >"$ab_f"
   ( appinfo_rafraichir; ab_r=$?
     if [ -f "$ab_f.abandon" ]; then rm -f "${ab_f:?}" "${ab_f:?}.abandon"; else echo $ab_r >"$ab_f"; fi
   ) >/dev/null 2>&1 3>&- &
   ab_n=$((MAJ_BUDGET * 5))
   while [ $ab_n -gt 0 ] && [ ! -s "$ab_f" ]; do sleep 0.2; ab_n=$((ab_n - 1)); done
   if [ ! -s "$ab_f" ]; then
      : >"$ab_f.abandon"
      [ -s "$ab_f" ] || return 3     # (sinon : finie a l'instant)
   fi
   ab_rc=$(cat "$ab_f"); rm -f "${ab_f:?}" "${ab_f:?}.abandon"
   return "${ab_rc:-1}"
}
# « appid, build installe, build publie » (tabulations) des jeux dont on connait
# les deux ; le build publie est le plus grand que donnent APPINFO et le client.
builds() { # [appid] : ce jeu seulement
   bu_p=""; bu_i=""
   for bu_a in ${1:-$(appids)}; do bu_b=$(champ "$bu_a" buildid); [ -n "$bu_b" ] && { bu_p="$bu_p $bu_a=$bu_b"; bu_i="$bu_i $bu_a"; }; done
   [ -n "$bu_i" ] || return 0
   { [ ! -s "$APPINFO" ] || LC_ALL=C awk -v paires="$bu_p" -v texte=2 -f "$R/tests/majs_steam.awk" "$APPINFO" | cut -f1,3
     builds_client $bu_i
   } | LC_ALL=C awk -F'\t' -v paires="$bu_p" '
      $2 ~ /^[0-9]+$/ { if (!($1 in pub) || $2 + 0 > pub[$1] + 0) pub[$1] = $2 }
      END { n = split(paires, p, " ")
            for (i = 1; i <= n; i++) { split(p[i], q, "="); if (q[2] ~ /^[0-9]+$/ && q[1] in pub) printf "%s\t%s\t%s\n", q[1], q[2], pub[q[1]] } }'
}
build_publie() { builds "$1" | cut -f3; }
# la branche Steam que suit le jeu (rien : la branche publique)
branche() { sed -n 's/.*"[Bb]eta[Kk]ey"[[:space:]]*"\([^"]*\)".*/\1/p' "$(acf "$1")" 2>/dev/null | head -1; }

maj_champ() { sed -n "s/^$2=//p" "$MAJ_ETATS/$1" 2>/dev/null | head -1; }
maj_noter() { # <appid> cle=valeur... : l'etat de sa derniere mise a jour (remplace le precedent)
   mn_a=$1; shift
   mkdir -p "$MAJ_ETATS" && printf '%s\n' "$@" "date=$(date +%s)" >"$MAJ_ETATS/$mn_a.tmp" && mv "$MAJ_ETATS/$mn_a.tmp" "$MAJ_ETATS/$mn_a"
}
# les fichiers de travail d'un telechargement (pas son etat)
maj_oublier() { for mo_s in "$@"; do rm -f "${MAJ_ETATS:?}/${t_id:?}.$mo_s"; done; }
maj_en_cours() { [ "$(maj_champ "$1" etat)" = en_cours ] && kill -0 "$(maj_champ "$1" pid)" 2>/dev/null; }
# Met-on le jeu a jour avant de le lancer ? L'environnement garde la main
# (CIDRE_MAJ_AVANT_LANCEMENT = 0 ou 1), sinon l'option maj_avant_lancement.
maj_voulue() {
   case ${CIDRE_MAJ_AVANT_LANCEMENT:-} in 0) return 1 ;; 1) return 0 ;; esac
   [ "$(sh "$R/tests/profil_cidre.sh" "$1" 2>/dev/null | sed -n 's/^maj_avant_lancement=//p')" != false ]
}
# Ce qu'on dit au joueur, en une ligne : la cause probable, et quoi faire.
maj_message() { # <raison> [detail]
   case $1 in
     hors_ligne)      echo "Mise a jour non verifiee : Steam n'a pas repondu (hors ligne ?)." ;;
     trop_lent)       echo "Mise a jour non verifiee : Steam met plus de $MAJ_BUDGET s a repondre ; sa reponse servira au prochain lancement." ;;
     steamcmd_absent) echo "Mise a jour non verifiee : SteamCMD est introuvable. Relance \`cidre setup\` pour le reinstaller." ;;
     session)         echo "Mise a jour impossible : la session Steam n'est pas memorisee. Connecte-toi (\`cidre login\`, ou « Connexion a Steam » dans Verger), puis relance le jeu." ;;
     compte)          echo "Mise a jour impossible : compte Steam introuvable. Connecte-toi (\`cidre login\`), ou exporte CIDRE_STEAM_USER=<ton_login>." ;;
     disque)          echo "Mise a jour impossible : place insuffisante sur le disque des jeux${2:+ ($2)}. Libere de la place, puis relance le jeu." ;;
     reseau)          echo "Mise a jour interrompue : la connexion a Steam a ete perdue${2:+ ($2)}. Elle reprendra ou elle en etait au prochain lancement." ;;
     licence)         echo "Mise a jour impossible : ce compte Steam n'a pas ce jeu${2:+ ($2)}. Verifie le compte (\`cidre session\`)." ;;
     interrompue)     echo "Mise a jour interrompue avant la fin ; elle reprendra ou elle en etait au prochain lancement." ;;
     *)               echo "Mise a jour echouee : SteamCMD n'a pas pu la terminer${2:+ ($2)}. Relance le jeu pour reessayer, ou \`cidre dl <appid>\` pour en voir le detail." ;;
   esac
}
# L'etat de mise a jour d'un jeu du dossier Cidre, dans MAJ_ETAT :
#   a_jour      le build installe est celui que publie Steam (ou plus recent :
#               un cache en retard ne fait pas un jeu perime)
#   disponible  un build plus recent est publie
#   en_cours    son telechargement tourne (avancement dans MAJ_ETATS/<appid>.avancement)
#   echouee     la derniere tentative vers ce build a echoue ; MAJ_RAISON (session,
#               disque, reseau, licence, compte, interrompue, steamcmd) et MAJ_MESSAGE
#               disent pourquoi. Le build reste a installer.
#   ignoree     un build plus recent existe et on n'y va pas : MAJ_RAISON = option
#               (maj_avant_lancement = false), branche (le jeu suit une branche beta :
#               il est epingle), sans_effet (Steam ne donne pas ce build a ce compte)
#   inconnu     MAJ_RAISON = sans_build, jamais_verifie, hors_ligne, steamcmd_absent, trop_lent
# MAJ_INSTALLE et MAJ_DISPO portent les deux builds. Sans second argument,
# redemande a Steam quand APPINFO a plus de MAJ_TTL minutes, sans depasser
# MAJ_BUDGET secondes ; `cache` : jamais de reseau.
maj_etat() { # <appid> [cache]
   MAJ_ETAT=inconnu; MAJ_RAISON=; MAJ_DISPO=; MAJ_MESSAGE=
   MAJ_INSTALLE=$(champ "$1" buildid)
   maj_voulue "$1" && MAJ_VOULUE=true || MAJ_VOULUE=false
   if maj_en_cours "$1"; then MAJ_ETAT=en_cours; MAJ_DISPO=$(maj_champ "$1" build_vise); return; fi
   # un premier telechargement inacheve n'est pas un jeu a mettre a jour
   if ! entier "$MAJ_INSTALLE" || { [ "$(champ "$1" StateFlags)" != 4 ] && [ -z "$(maj_champ "$1" build_avant)" ]; }; then
      MAJ_RAISON=sans_build; return
   fi
   MAJ_DISPO=$(build_publie "$1")
   me_f=$(maj_champ "$1" etat); me_v=$(maj_champ "$1" build_vise)
   # Un build publie ne recule pas : « plus recent que l'installe » reste vrai
   # meme lu dans un cache ancien. « A jour » se redemande, et « plus recent,
   # mais deja tente sans effet » aussi.
   me_revoir=non
   if ! entier "$MAJ_DISPO"; then me_revoir=oui
   elif ! connu_frais "$1" && { [ "$MAJ_DISPO" -le "$MAJ_INSTALLE" ] || { [ "$me_f" = sans_effet ] && [ "$me_v" = "$MAJ_DISPO" ]; }; }; then me_revoir=oui; fi
   if [ $me_revoir = oui ]; then
      if [ "${2:-}" != cache ] && { appinfo_perime || appinfo_sans "$1"; }; then
         appinfo_rafraichir_borne
         case $? in 0) ;; 2) MAJ_RAISON=steamcmd_absent ;; 3) MAJ_RAISON=trop_lent ;; *) MAJ_RAISON=hors_ligne ;; esac
         [ -z "$MAJ_RAISON" ] || return
         MAJ_DISPO=$(build_publie "$1")
      fi
      if ! entier "$MAJ_DISPO"; then
         MAJ_DISPO=; [ -s "$APPINFO" ] && MAJ_RAISON=sans_build || MAJ_RAISON=jamais_verifie
         return
      fi
   fi
   if [ "$MAJ_DISPO" -le "$MAJ_INSTALLE" ]; then MAJ_ETAT=a_jour; return; fi
   MAJ_ETAT=disponible
   me_b=$(branche "$1")
   if [ -n "$me_b" ] && [ "$me_b" != public ]; then MAJ_ETAT=ignoree; MAJ_RAISON=branche; return; fi
   case $me_f in
     # (« faite » : ecrit ainsi par un Cidre d'avant le 16/10 pour une passe sans effet)
     sans_effet|faite) [ "$me_v" = "$MAJ_DISPO" ] && { MAJ_ETAT=ignoree; MAJ_RAISON=sans_effet; return; } ;;
     echouee|en_cours)
        if [ -z "$me_v" ] || [ "$me_v" = "$MAJ_DISPO" ]; then
           MAJ_ETAT=echouee; MAJ_RAISON=$(maj_champ "$1" raison); MAJ_RAISON=${MAJ_RAISON:-interrompue}
           MAJ_MESSAGE=$(maj_champ "$1" message); MAJ_MESSAGE=${MAJ_MESSAGE:-$(maj_message "$MAJ_RAISON")}
           return
        fi ;;
   esac
   [ "$MAJ_VOULUE" = true ] || { MAJ_ETAT=ignoree; MAJ_RAISON=option; }
}
# l'etat rendu par maj_etat, en JSON (sans les accolades)
maj_json() { # <appid>
   mj_p=; mj_o=; mj_t=; mj_ph=
   [ "$MAJ_ETAT" != en_cours ] || [ ! -f "$MAJ_ETATS/$1.avancement" ] || read -r mj_p mj_o mj_t mj_ph <"$MAJ_ETATS/$1.avancement"
   case $mj_p in ''|*[!0-9.]*) mj_p=null ;; esac
   printf '"etat":"%s","build_installe":%s,"build_disponible":%s,"raison":%s,"message":%s,"avancement":%s,"octets":%s,"total":%s,"phase":%s,"avant_lancement":%s,"verifie":%s' \
      "$MAJ_ETAT" "$(nombre "$MAJ_INSTALLE")" "$(nombre "$MAJ_DISPO")" "$(json_ou_null "$MAJ_RAISON")" "$(json_ou_null "$MAJ_MESSAGE")" \
      "$mj_p" "$(nombre "$mj_o")" "$(nombre "$mj_t")" "$(json_ou_null "$mj_ph")" "${MAJ_VOULUE:-true}" "$(nombre "$(verifie_le "$1")")"
}
evenement_maj() { evenement "$(printf '{"evenement":"maj",%s}' "$(maj_json "$1")")"; }

# Lit la sortie de SteamCMD : la relaie, la garde (MAJ_ETATS/<appid>.sortie, pour
# dire pourquoi un echec) et en tire l'avancement, ligne
# ` Update state (0x61) downloading, progress: 37.93 (32564012 / 85850313)`.
maj_suivre() { # <appid>
   while IFS= read -r ms_l || [ -n "$ms_l" ]; do
      ms_l=${ms_l%"$CR"}
      dire "$ms_l"
      printf '%s\n' "$ms_l" >>"$MAJ_ETATS/$1.sortie"
      case $ms_l in *"progress: "*"("*" / "*")"*) ;; *) continue ;; esac
      ms_p=${ms_l#*progress: }; ms_pct=${ms_p%% *}; ms_r=${ms_p#*\(}; ms_o=${ms_r%% /*}; ms_t=${ms_r#*/ }; ms_t=${ms_t%%\)*}
      ms_ph=${ms_l%%, progress:*}; ms_ph=${ms_ph##*\) }
      case $ms_pct in ''|*[!0-9.]*) continue ;; esac
      entier "$ms_o" && entier "$ms_t" || continue
      case $ms_ph in ''|*[!a-z]*) ms_ph= ;; esac
      printf '%s %s %s %s\n' "$ms_pct" "$ms_o" "$ms_t" "$ms_ph" >"$MAJ_ETATS/$1.avancement"
      evenement "$(printf '{"evenement":"maj","etat":"en_cours","avancement":%s,"octets":%s,"total":%s,"phase":%s}' "$ms_pct" "$ms_o" "$ms_t" "$(json_ou_null "$ms_ph")")"
   done
}
tuer_arbre() { for ta_c in $(pgrep -P "$1" 2>/dev/null); do tuer_arbre "$ta_c"; done; kill -TERM "$1" 2>/dev/null; }
# `cidre` recoit l'ordre de s'arreter pendant un telechargement (Ctrl-C,
# « Annuler » de Verger) : SteamCMD s'arrete avec lui, et on le note.
maj_interrompre() {
   trap - INT TERM HUP
   for mi_p in $(pgrep -P $$ 2>/dev/null); do tuer_arbre "$mi_p"; done
   maj_noter "$t_id" etat=echouee raison=interrompue "message=$(maj_message interrompue)" "build_avant=$t_avant" "build_vise=$t_vise"
   maj_oublier avancement rc
   exit 130
}
# La langue Steam d'un jeu (french...) : son option `langue` (CIDRE_LANGUE la
# remplace) ; « auto » = la langue du Mac, sinon l'anglais (tests/langue_cidre.sh).
# SteamCMD installe les depots de cette langue (app_update -language), comme le
# client Steam ceux de la sienne : sans elle, il prenait l'anglais.
langue_steam() { # <appid>
   ls_l=${CIDRE_LANGUE:-$(sh "$R/tests/profil_cidre.sh" "$1" 2>/dev/null | sed -n 's/^langue=//p' | head -1)}
   sh "$R/tests/langue_cidre.sh" "${ls_l:-auto}" 2>/dev/null | sed -n 's/^steam=//p'
}
# Les depots de cette langue que Steam publie pour le jeu et que son
# installation n'a pas (lu dans APPINFO, sans reseau ; tests/depots_langue.awk).
# Rien : le jeu est entier, ou on n'en sait rien.
depots_langue_manquants() { # <appid> <langue steam> <windows|macos>
   dm_f=$(acf "$1")
   [ -n "$2" ] && [ -s "$dm_f" ] && [ -s "$APPINFO" ] || return 0
   LC_ALL=C awk -v appid="$1" -v langue="$2" -v os="$3" -f "$R/tests/depots_langue.awk" "$dm_f" "$APPINFO"
}

# Telecharge un jeu dans un emplacement Cidre, ou l'y met a jour : c'est `cidre dl`
# (mode dl : fichiers reverifies ; au terminal, SteamCMD peut demander le mot de
# passe) et la mise a jour d'avant lancement de `cidre play` (mode maj : session
# memorisee ou rien, seul ce qui a change est telecharge, et les fichiers que
# Cidre a poses dans le jeu ne sont pas remis d'origine). Un jeu deja installe
# doit rester lancable si la mise a jour echoue : on note d'ou l'on part
# (build_avant), ou l'on va (build_vise) et pourquoi on s'est arrete. Rend 0, ou
# le code de SteamCMD (3 : pas de session) ; MAJ_RAISON et MAJ_MESSAGE disent
# alors pourquoi. Le jeu va la ou il est deja, sinon dans DL_DEST (`cidre dl`).
telecharger() { # <appid> <windows|macos> <dl|maj>
   t_id=$1; t_os=$2; t_mode=$3; MAJ_RAISON=; MAJ_MESSAGE=
   # (emplacement debranche : surtout pas un second exemplaire ailleurs)
   if hors_ligne "$t_id"; then MAJ_RAISON=debranche; MAJ_MESSAGE=$(hors_ligne_message "$t_id"); return 8; fi
   DEST=$(jd "$t_id") || DEST=${DL_DEST:-$CIDRE_GAMES/$t_id}
   t_acf="$DEST/steamapps/appmanifest_$t_id.acf"
   SCMD=$(resolve_steamcmd)
   [ -n "$SCMD" ] || { MAJ_RAISON=steamcmd_absent; MAJ_MESSAGE="SteamCMD introuvable (ni tools/steamcmd/ ni PATH)."; return 1; }
   U=$(steam_user)
   [ -n "$U" ] || { MAJ_RAISON=compte; MAJ_MESSAGE="Compte Steam introuvable. Exporte CIDRE_STEAM_USER=<ton_login> et relance."; return 1; }
   # D'ou l'on part : le build installe, ou celui d'avant une mise a jour restee en route.
   t_avant=; t_vise=
   if [ -f "$t_acf" ]; then
      [ "$(maj_champ "$t_id" etat)" = faite ] || t_avant=$(maj_champ "$t_id" build_avant)
      [ "$(champ "$t_id" StateFlags)" = 4 ] && t_avant=$(champ "$t_id" buildid)
      t_vise=$(build_publie "$t_id")
   fi
   mkdir -p "$(dirname "$DEST")"
   t_libre=${CIDRE_ESSAI_LIBRE_KO:-$(df -Pk "$(dirname "$DEST")" 2>/dev/null | awk 'NR == 2 { print $4 }')}
   if entier "$t_libre" && [ "$t_libre" -lt $((MAJ_LIBRE_MIN * 1024)) ]; then
      MAJ_RAISON=disque; MAJ_MESSAGE=$(maj_message disque "$((t_libre / 1024)) Mo libres, il en faut au moins $MAJ_LIBRE_MIN")
      [ ! -f "$t_acf" ] || maj_noter "$t_id" etat=echouee "raison=$MAJ_RAISON" "message=$MAJ_MESSAGE" "build_avant=$t_avant" "build_vise=$t_vise"
      return 1
   fi
   mkdir -p "$DEST"
   # un nouveau jeu entre dans l'index (champ, plat... le trouvent la)
   jd "$t_id" >/dev/null || { eval "JD_$t_id=\$DEST; JE_$t_id=\${DL_EMPL:-principal}; JH_$t_id="; IDS_EMPL="$IDS_EMPL $t_id"; }
   maj_noter "$t_id" etat=en_cours "pid=$$" "build_avant=$t_avant" "build_vise=$t_vise"
   maj_oublier avancement rc; : >"$MAJ_ETATS/$t_id.sortie"
   t_val=validate; [ "$t_mode" = maj ] && [ "${CIDRE_MAJ_VALIDER:-0}" != 1 ] && t_val=
   # les fichiers de la langue du jeu (et ceux sans langue) ; une installation
   # faite dans une autre langue recoit ceux qui lui manquent, sans le reste
   t_langue=$(langue_steam "$t_id"); t_langue=${t_langue:+-language $t_langue}
   if [ "$t_mode" = dl ] && [ -t 0 ]; then
      scmd +@sSteamCmdForcePlatformType "$t_os" +force_install_dir "$DEST" +login "$U" +app_update "$t_id" $t_langue $t_val +quit
      t_rc=$?
   else
      # En fond, et on l'attend : `wait` se laisse interrompre par un signal, une
      # commande au premier plan non.
      { scmd_memorise +@sSteamCmdForcePlatformType "$t_os" +force_install_dir "$DEST" +login "$U" +app_update "$t_id" $t_langue $t_val +quit 2>&1
        echo $? >"$MAJ_ETATS/$t_id.rc"; } | maj_suivre "$t_id" &
      t_pid=$!
      trap 'maj_interrompre' INT TERM HUP
      wait $t_pid
      trap - INT TERM HUP
      t_rc=$(cat "$MAJ_ETATS/$t_id.rc" 2>/dev/null); entier "$t_rc" || t_rc=1
   fi
   # rien de telecharge : ne pas laisser un dossier vide passer pour un jeu
   rmdir "$DEST/steamapps" "$DEST" 2>/dev/null
   t_err=$(grep -iE 'error|failed|no subscription' "$MAJ_ETATS/$t_id.sortie" 2>/dev/null | tail -1 | tr '\t' ' ' | sed 's/^ *//; s/ *$//')
   # SteamCMD rend parfois 0 sur un echec : le manifeste, lui, dit si le jeu est entier
   if [ "$t_rc" -eq 0 ] && { grep -q "Error! App '" "$MAJ_ETATS/$t_id.sortie" 2>/dev/null || ! grep -q '"StateFlags"[[:space:]]*"4"' "$t_acf" 2>/dev/null; }; then t_rc=1; fi
   maj_oublier avancement rc
   if [ "$t_rc" -eq 0 ]; then
      # SteamCMD a fini sans erreur. S'il a laisse le build sous celui qu'on
      # visait (« already up to date », ou « fully installed » apres une
      # verification), rien n'a ete installe : c'est une passe sans effet, pas
      # une mise a jour faite. (Essai reel du 16/10 : manifeste abaisse a la
      # main, fichiers deja a jour, SteamCMD ne recrit pas le buildid.)
      t_apres=$(champ "$t_id" buildid); t_e=faite
      entier "$t_vise" && entier "$t_apres" && [ "$t_apres" -lt "$t_vise" ] && t_e=sans_effet
      maj_noter "$t_id" "etat=$t_e" "build_avant=$t_avant" "build_vise=$t_vise" "build_apres=$t_apres"
      # APPINFO ignore le jeu, ou dit plus ancien que ce qu'on vient
      # d'installer : il est en retard. (Plus recent : la mise a jour a ete sans
      # effet, et il dit vrai.)
      t_p=$(build_publie "$t_id"); t_b=$(champ "$t_id" buildid)
      if ! entier "$t_p" || { entier "$t_b" && [ "$t_b" -gt "$t_p" ]; }; then rm -f "${APPINFO:?}"; fi
      return 0
   fi
   if [ "$t_rc" -eq 3 ]; then MAJ_RAISON=session
   elif grep -qiE '0x202|disk space|disk write' "$MAJ_ETATS/$t_id.sortie" 2>/dev/null; then MAJ_RAISON=disque
   elif grep -qi 'no subscription' "$MAJ_ETATS/$t_id.sortie" 2>/dev/null; then MAJ_RAISON=licence
   elif grep -qiE '0x402|0x602|timeout|timed out|no connection|connection failure|offline' "$MAJ_ETATS/$t_id.sortie" 2>/dev/null; then MAJ_RAISON=reseau
   else MAJ_RAISON=steamcmd; fi
   MAJ_MESSAGE=$(maj_message "$MAJ_RAISON" "$t_err")
   if [ -d "$DEST" ]; then maj_noter "$t_id" etat=echouee "raison=$MAJ_RAISON" "message=$MAJ_MESSAGE" "build_avant=$t_avant" "build_vise=$t_vise"
   else rm -f "${MAJ_ETATS:?}/${t_id:?}"; maj_oublier sortie; fi
   return "$t_rc"
}
# Avant de lancer un jeu du dossier Cidre : s'il existe un build plus recent,
# l'installer d'abord. Jamais un obstacle : verification impossible, session
# absente, place manquante, echec en route... on le dit en une ligne et le jeu
# part dans sa version installee. Seule une mise a jour deja en cours ailleurs
# arrete le lancement : le jeu serait pris a moitie remplace.
maj_avant_lancement() { # <appid>
   if maj_en_cours "$1"; then
      maj_etat "$1" cache; evenement_maj "$1"
      echo "Une mise a jour de ce jeu est deja en cours (processus $(maj_champ "$1" pid)) : attends sa fin, puis relance-le. Le lancer maintenant le prendrait a moitie remplace." >&2
      exit 4
   fi
   # le jeu tourne deja : on ne touche pas a ses fichiers
   [ -f "$EN_COURS/$1" ] && kill -0 "$(cat "$EN_COURS/$1" 2>/dev/null)" 2>/dev/null && return 0
   if [ "$SANS_MAJ" = oui ] || ! maj_voulue "$1"; then
      # on ne demande rien a Steam ; si l'on sait deja qu'un build attend, on le dit
      maj_etat "$1" cache
      if entier "$MAJ_DISPO" && entier "$MAJ_INSTALLE" && [ "$MAJ_DISPO" -gt "$MAJ_INSTALLE" ]; then
         MAJ_ETAT=ignoree; MAJ_MESSAGE=
         if [ "$SANS_MAJ" = oui ]; then MAJ_RAISON=demande; ml_q="a ta demande (--sans-maj)"
         else MAJ_RAISON=option; ml_q="maj_avant_lancement = false (\`cidre set $1 maj_avant_lancement true\` pour la reprendre)"; fi
         dire "Mise a jour disponible (build $MAJ_INSTALLE -> $MAJ_DISPO), laissee de cote : $ml_q."
         evenement_maj "$1"
      fi
      return 0
   fi
   evenement '{"evenement":"maj","etat":"verification"}'
   maj_etat "$1"
   langue_avant_lancement "$1" && return 0
   case $MAJ_ETAT in
     disponible|echouee) ;;
     ignoree)
        case $MAJ_RAISON in
          branche)    dire "Mise a jour disponible sur la branche publique (build $MAJ_INSTALLE -> $MAJ_DISPO), laissee de cote : le jeu suit la branche « $(branche "$1") »." ;;
          sans_effet) dire "Mise a jour annoncee (build $MAJ_INSTALLE -> $MAJ_DISPO), laissee de cote : Steam ne la donne pas a ce compte (deja tentee, sans effet)." ;;
        esac
        evenement_maj "$1"; return 0 ;;
     inconnu)
        case $MAJ_RAISON in sans_build|jamais_verifie) ;; *) MAJ_MESSAGE=$(maj_message "$MAJ_RAISON"); dire "$MAJ_MESSAGE Lancement de la version installee." ;; esac
        evenement_maj "$1"; return 0 ;;
     *) evenement_maj "$1"; return 0 ;;
   esac
   dire "Mise a jour avant le lancement : build $MAJ_INSTALLE -> $MAJ_DISPO (\`cidre play $1 --sans-maj\` pour jouer sans attendre)."
   MAJ_ETAT=en_cours; MAJ_RAISON=; MAJ_MESSAGE=; evenement_maj "$1"
   ml_os=windows; [ "$(plat "$1")" = macos ] && ml_os=macos
   ml_vise=$MAJ_DISPO
   if telecharger "$1" "$ml_os" maj; then
      MAJ_INSTALLE=$(champ "$1" buildid)
      if entier "$ml_vise" && entier "$MAJ_INSTALLE" && [ "$MAJ_INSTALLE" -lt "$ml_vise" ]; then
         # SteamCMD a fini sans rien installer (« already up to date ») : le
         # build reste en retard. Pas une mise a jour faite, et pas de nouvelle
         # tentative pour ce build (maj_etat : ignoree, sans_effet).
         MAJ_ETAT=ignoree; MAJ_RAISON=sans_effet; MAJ_DISPO=$ml_vise
         dire "Mise a jour sans effet : SteamCMD dit le jeu a jour mais le laisse au build $MAJ_INSTALLE (publie : $ml_vise) ; elle ne sera pas retentee pour ce build. Lancement de la version installee."
      else
         MAJ_ETAT=faite
         dire "Mise a jour faite : build $MAJ_INSTALLE."
      fi
   else
      MAJ_ETAT=echouee; MAJ_INSTALLE=$(champ "$1" buildid)
      dire "$MAJ_MESSAGE Lancement de la version installee (build $MAJ_INSTALLE)."
   fi
   evenement_maj "$1"
   return 0
}

# Un jeu a jour mais installe dans une autre langue (telecharge avant que Cidre
# ne demande celle du Mac, ou langue changee depuis) : si Steam publie des depots
# de la langue voulue, ils sont ajoutes avant le lancement -- eux seuls, pas le
# reste du jeu. Une fois par langue et par build (MAJ_ETATS/<appid>.langue) :
# un depot que SteamCMD ne donne pas ne fait pas attendre chaque lancement.
# Jamais un obstacle, comme la mise a jour. Rend 1 quand il n'y a rien a ajouter.
langue_avant_lancement() { # <appid>
   case $MAJ_ETAT in
     a_jour) ;;
     ignoree) [ "$MAJ_RAISON" = sans_effet ] || return 1 ;;
     *) return 1 ;;
   esac
   la_os=windows; [ "$(plat "$1")" = macos ] && la_os=macos
   la_l=$(langue_steam "$1")
   la_d=$(depots_langue_manquants "$1" "$la_l" "$la_os" | sort -n | tr '\n' ' ' | sed 's/ $//')
   [ -n "$la_d" ] || return 1
   la_t="$la_l:$(champ "$1" buildid)"
   [ "$(cat "$MAJ_ETATS/$1.langue" 2>/dev/null)" != "$la_t" ] || return 1
   dire "Fichiers de langue a ajouter ($la_l : depot $la_d) avant le lancement (\`cidre play $1 --sans-maj\` pour jouer sans attendre)."
   MAJ_ETAT=en_cours; MAJ_RAISON=; MAJ_MESSAGE=; evenement_maj "$1"
   if telecharger "$1" "$la_os" maj; then
      la_r=$(depots_langue_manquants "$1" "$la_l" "$la_os" | tr '\n' ' ' | sed 's/ $//')
      if [ -z "$la_r" ]; then dire "Fichiers de langue ajoutes ($la_l)."
      else dire "Fichiers de langue : SteamCMD n'a pas installe le depot $la_r ; ce ne sera pas retente pour ce build. Lancement tel quel."; fi
      MAJ_ETAT=faite
      mkdir -p "$MAJ_ETATS" && printf '%s\n' "$la_t" >"$MAJ_ETATS/$1.langue"
   else
      # (hors ligne, session...) : retente au prochain lancement
      MAJ_ETAT=echouee
      dire "$MAJ_MESSAGE Lancement de la version installee."
   fi
   MAJ_INSTALLE=$(champ "$1" buildid)
   evenement_maj "$1"
   return 0
}

usage() {
   cat <<USAGE
cidre — launcher Cidre (jeux Steam ou non, natifs ou via Cidre)
  cidre list [--json]             liste tes jeux + plateforme + mode de lancement
                                  --json : "emplacement" (id de l'emplacement d'un jeu Cidre, null ailleurs),
                                  "en_ligne" (false : son disque est debranche ; il reste installe),
                                  "deplacement" (null, ou etat d'un deplacement en cours ou inacheve)
  cidre info <id> [--json]        fiche d'un jeu : plateforme, taille, chemin, options actives
                                  --json : "maj" dit ou en est sa mise a jour (jeu du dossier Cidre ; voir updates)
  cidre play <id> [--sans-maj] [--accord-nuage] [--json] [-- <arguments du jeu>]
                                  lance le jeu (natif via Steam, ou par la pile Cidre). Un jeu du dossier
                                  Cidre dont Steam publie un build plus recent est d'abord mis a jour ; si
                                  ce n'est pas possible (hors ligne, session absente, place...), on le dit
                                  et il part dans sa version installee. --sans-maj : jouer tout de suite ;
                                  option maj_avant_lancement = false : ne jamais mettre a jour au lancement.
                                  --json : la sortie standard porte des evenements, un objet par ligne
                                  ({"evenement":"maj","etat":...} puis {"evenement":"lancement"}), le reste
                                  va a l'erreur ; {"evenement":"avertissement","code":"steam_cpu","cpu":<%>,
                                  "message":...} avant le lancement si le client Steam mange deja le processeur ;
                                  pour un jeu Windows, {"evenement":"shaders","etat":"premier_lancement"|
                                  "cache_invalide"|"en_cache","raison":...,"message":...} : ses shaders sont-ils
                                  deja compiles sur ce Mac (premier lancement : minutes d'ecran noir possibles)
                                  Le client Steam est ouvert en arriere-plan (sans fenetre) s'il etait ferme,
                                  sa fenetre masquee s'il en montrait une ; il n'est jamais ferme
                                  Un jeu du dossier Cidre dont Steam croit des sauvegardes sur ce Mac qui n'y
                                  sont plus ne part pas (code 7) : sa sortie les ferait retirer du nuage.
                                  --accord-nuage : le lancer quand meme
                                  -- <arguments> : options passees au jeu pour ce lancement (jeu Cidre ou hors
                                  Steam), en plus de l'option arguments de sa fiche (ex. -- -force-gfx-direct)
                                  Un jeu dont le disque est debranche ne part pas (code 8, et en --json
                                  {"evenement":"erreur","code":"hors_ligne","message":...}) ; un jeu en cours
                                  de deplacement non plus (code 4)
  cidre running [--json]          les jeux en cours
  cidre stop [<id>]               force l'arret d'un jeu lance par Cidre (et de tout ce que Wine fait tourner)
  cidre log <id> [lignes]         la fin du journal du dernier lancement d'un jeu (sans les traces)
  cidre set <id> <option> <valeur>   regle une option de lancement du jeu (profils.toml)
  cidre unset <id> [option]       revient au reglage livre (sans option : toutes)
                                  <id> = defaut : le reglage general, que suit tout jeu sans reglage propre
  cidre options [--json]          les reglages generaux
  cidre profils [--json]          la base de profils par jeu (fiches : options, compatibilite, rapports)
  cidre profils maj [--json]      met la base a jour depuis GitHub (sans reseau : la copie livree sert)
  cidre saves [<id>] [--json]     les sauvegardes : synchronisees par Steam Cloud quand il le peut (le jeu
                                  ecrit par l'API de Steam, ou declare un dossier macOS : Cidre y lie le
                                  sien), sinon copiees par Cidre dans un dossier de ce Mac
                                  Regle : ce que Steam Cloud synchronise a toujours la priorite -- ni la copie
                                  de Cidre, ni iCloud, ni une bouteille ne remplacent un fichier que Steam
                                  detient ; ils ne font que combler un dossier que Steam a vide
                                  --json : "synchro" dit qui synchronise -- steam_api (API de Steam, par le
                                  pont), steam_macos (dossier lie, le client Steam s'en charge), copie (Cidre,
                                  vers le dossier "copie"), aucune (dossier inconnu) -- et "synchro_detail"
                                  le dit en une phrase ; "reprise" : ce que cidre import a ramene de la
                                  bouteille d'origine du jeu (null s'il n'en vient pas)
  cidre saves set <id> <dossier>  dire ou un jeu range ses sauvegardes (unset : revenir au reglage livre)
  cidre saves dossier [<chemin>|icloud|defaut] [--json]
                                  ou vont les copies de Cidre (defaut : ~/Library/Application Support/Cidre/saves ;
                                  icloud : iCloud Drive/CidreSaves ; sans argument : le dossier actuel)
  cidre sync <id|all> [backup|restore]   copier les sauvegardes dans ce dossier, ou reprendre ce qui y est plus recent
  cidre status [--json]           version du runtime, prerequis, etat de l'installation
  cidre doctor                    diagnostic : ce qui est la, ce qui tourne, et si Wine demarre (texte a copier)
  cidre setup                     configure le runtime apres une installation ou une mise a jour
 Steam
  cidre library [--json] [--refresh]   les jeux que possede ton compte (installes ou non)
                                  --json : "source":"bouteille" (avec "origine", "bouteille", "chemin") sur
                                  un jeu deja installe par CrossOver, Whisky ou Heroic, que cidre import reprend
  cidre updates [--json] [--refresh] [--fond]   les jeux installes dont une version plus recente est publiee
                                  (lue dans le cache du client Steam, sinon demandee a Steam par SteamCMD)
                                  --fond : rafraichir en arriere-plan et rendre la main aussitot
                                  --json : "etat" par jeu -- a_jour, disponible, en_cours ("avancement" en %,
                                  "octets", "total"), echouee ("raison", "message"), ignoree ("raison" :
                                  option, branche, sans_effet), inconnu -- et "source" (cidre : Cidre met a
                                  jour ; steam : le client Steam s'en charge)
  cidre dl <appid> [windows|macos] [--vers <emplacement>]
                                  telecharge (ou met a jour) le jeu dans un emplacement Cidre, hors du client :
                                  la ou il est deja, sinon --vers, sinon l'emplacement par defaut
  cidre bottles [--json]          les jeux Steam Windows deja installes par CrossOver, Whisky ou Heroic
  cidre import <appid> [<bouteille>] [--move] [--vers <emplacement>] [--json]
                                  reprend un de ces jeux dans le dossier Cidre sans le retelecharger : clone
                                  APFS, immediat et sans place prise ; la bouteille n'est pas modifiee
                                  ses sauvegardes sont ramenees de la bouteille la ou le jeu les cherchera,
                                  sans ecraser une sauvegarde plus recente (l'ancienne version est gardee) ;
                                  Steam d'abord : rien n'est copie quand Steam Cloud a deja des sauvegardes
                                  du jeu (API de Steam, ou dossier macOS lie qui en contient)
                                  --move : deplace le jeu au lieu de le cloner (la bouteille ne l'a plus) ;
                                  refuse tant que la bouteille est en cours d'usage
                                  --json : la fiche du jeu, et "reprise_sauvegardes" : "etat" (copie, a_jour,
                                  steam, steam_prioritaire, avec_le_jeu, absentes, introuvable, erreur),
                                  "fichiers", "remplaces", "gardes", "origine", "bouteille", "depuis", "vers",
                                  "steam_fichiers", "conflit_possible", "message"
  cidre import <appid> [<bouteille>] --saves [--dossier <chemin>] [--forcer] [--json]
                                  ramene seulement les sauvegardes d'un jeu deja repris (ou rejoue depuis dans
                                  la bouteille) ; <bouteille> : pour un jeu qui n'en vient pas
                                  --dossier : le dossier de la bouteille ou elles sont, si Cidre ne le trouve pas
                                  --forcer : copier celles de la bouteille par-dessus celles qui sont la, meme
                                  celles que Steam Cloud synchronise (les versions remplacees sont gardees)
  cidre login                     memorise la session SteamCMD (mot de passe tape a SteamCMD, une fois)
  cidre session [--json]          le compte Steam, et si sa session est memorisee
  cidre logout                    oublie la session Steam (les jeux installes restent jouables)
  cidre install <appid> [auto|macos|windows]   installe le depot dans le client Steam
  cidre wrap                      (re)pose le wrapper Cidre sur les jeux Windows-only
 Emplacements (ou vivent les jeux Cidre : ce Mac, un disque externe...)
  cidre emplacements [--json]     les emplacements : branches ou non, place libre, nombre de jeux ; ceux
                                  detectes sur un disque branche mais pas encore ajoutes
                                  --json : {"emplacements":[{"id","nom","chemin","volume","en_ligne","defaut",
                                  "principal","amovible","systeme_fichiers","libre","total","inscriptible",
                                  "jeux","taille_jeux","remarque"}],"detectes":[{"chemin","id","volume","jeux"}]}
  cidre emplacements ajouter <dossier ou disque> [--json]
                                  ajoute un emplacement (la racine d'un disque : un dossier « Jeux Cidre »
                                  dessus) ; ses jeux sont reconnus, meme copies a la main ; FAT32 et lecture
                                  seule refuses. Une marque a sa racine le fait retrouver si le disque change
                                  de nom. Debranche, ses jeux sont « hors ligne » (ni desinstalles ni perdus)
  cidre emplacements retirer <emplacement> [--json]   l'oublier (ses jeux restent sur le disque)
  cidre emplacements defaut <emplacement> [--json]    ou vont les nouveaux jeux (dl, import)
                                  <emplacement> : son id, son nom (volume), ou son chemin ; principal = ce Mac
  cidre move <appid> <emplacement> [--verifier-contenu] [--json]
                                  deplace un jeu Cidre : copie verifiee (fichiers, tailles, liens ; octets avec
                                  --verifier-contenu), puis suppression de l'original ; sauvegardes, prefixe et
                                  options ne bougent pas. Refuse si le jeu tourne (4), si la place manque (5),
                                  si un disque est debranche (8) ; interrompu (130), il reprend ou il en etait
                                  au move suivant. --json : evenements {"evenement":"deplacement","etat":
                                  en_cours ("phase" preparation|copie|verification|bascule|suppression,
                                  "avancement" en %, "octets", "total") | fait | echoue | refuse | interrompu,
                                  "raison", "message"}
  cidre move <appid> --arreter    arrete un deplacement en cours (la copie entamee reste, pour reprendre)
  cidre move <appid> --annuler    abandonne un deplacement (arrete, et efface la copie entamee)
 Hors Steam
  cidre add <jeu.exe> [nom] [--json]   ajoute un jeu Windows a la bibliotheque
  cidre run <fichier.exe> [args]  lance un .exe une fois (un installeur, par exemple)
  cidre prefix                    le disque C: ou atterrissent les installeurs
  cidre rm <id>                   retire un jeu hors Steam, ou desinstalle un jeu d'un emplacement Cidre
USAGE
}

# Ou sont les jeux des emplacements, branches ou non (une fois par commande).
empl_indexer
cmd=${1:-help}; [ $# -gt 0 ] && shift
# --json (n'importe ou) : sortie pour une interface (Verger), stable et parsable
JSON=non; MAJ=non; SANS_MAJ=non; FOND=non; ACCORD_NUAGE=non
# --vers <emplacement> (dl, import), --verifier-contenu, --arreter et --annuler (move)
VERS=; VERS_ATTENDU=non; VERIFIER=non; ANNULER=non; ARRETER=non
# `run` transmet ses arguments tels quels au programme
# Apres `--`, plus rien n'est interprete : ce sont les arguments du jeu (`play`).
FIN_OPTIONS=non
[ "$cmd" = run ] || for a in "$@"; do
   shift
   if [ $FIN_OPTIONS = oui ]; then set -- "$@" "$a"; continue; fi
   if [ $VERS_ATTENDU = oui ]; then VERS=$a; VERS_ATTENDU=non; continue; fi
