      # (les reprises de page de code ne sont pas des exceptions : on en garde trois)
      /:trace:seh:wx_/ { if (++wx > 3) { coupe++; next } else { l[++n] = $0; next } }
      /:trace:/ { if ($0 ~ /:trace:seh:/ && t < max) t++; else { coupe++; next } }
      { l[++n] = $0 }
