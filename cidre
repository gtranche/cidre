    { [ -n "$(saves_ids | grep -x "$id")" ] || [ -n "$(saves_steam "$id")" ]; } && sv=true || sv=false
    # ou en est sa mise a jour (jeu du dossier Cidre), d'apres ce qu'on sait deja : pas de reseau ici
    mj=null; [ "$(source_de "$id")" = cidre ] && { maj_etat "$id" cache; mj="{$(maj_json "$id")}"; }
    # ses shaders sur ce Mac (tests/etat_shaders.sh), pour un jeu Windows (ou sans .exe pres de la racine)
    sh_=null; case $(plat "$id") in windows|inconnu) sh_=$(CIDRE_CHEMIN_JEU=$(chemin "$id") sh "$R/tests/etat_shaders.sh" json "$id" 2>/dev/null || echo null) ;; esac
    if [ "$JSON" = oui ]; then
      # "fiche" : la fiche de la base de profils (profils/README.md), ou null
      # "shaders" : {"etat","raison","voie","dernier","cumul","macos","message"}, ou null
      fiche_json "$id"; printf ',"sauvegardes":%s,"options":%s,"options_perso":%s,"maj":%s,"fiche":%s,"shaders":%s}\n' "$sv" "$opts" "$(sh "$R/tests/profil_cidre.sh" "$id" perso)" "$mj" "$(sh "$R/tests/fiche_profil.sh" json "$id")" "$sh_"
    else
      echo "id          : $id"
      echo "nom         : $(nom "$id")"
      echo "plateforme  : $(plat "$id")"
      echo "source      : $(source_de "$id")"
      echo "chemin      : $(chemin "$id")"
      if [ "$(source_de "$id")" = cidre ]; then
        ie=$(empl_de "$id")
        echo "emplacement : $(empl_nom "$ie" "$(empl_champ "$ie" 2)") ($ie)$(hors_ligne "$id" && echo ", HORS LIGNE : disque debranche")"
        eval "ix=\${JX_$id:-}"; [ -z "$ix" ] || echo "autres exemplaires : $(printf '%s' "$ix" | tr '\t' ' ')"
        [ -f "$DEPLACEMENTS/$id" ] && echo "deplacement : $(depl_json "$id")"
      fi
      t=$(champ "$id" SizeOnDisk); echo "taille      : $(( ${t:-0} / 1048576 )) Mo"
      echo "sauvegardes : $sv"
      [ "$mj" = null ] || echo "mise a jour : $MAJ_ETAT${MAJ_RAISON:+ ($MAJ_RAISON)}${MAJ_DISPO:+, build $MAJ_INSTALLE -> $MAJ_DISPO}"
      if [ "$sh_" != null ]; then
        se=$(CIDRE_CHEMIN_JEU=$(chemin "$id") sh "$R/tests/etat_shaders.sh" etat "$id" 2>/dev/null)
        sv_=$(printf '%s\n' "$se" | sed -n 's/^voie=//p'); sd=$(printf '%s\n' "$se" | sed -n 's/^dernier=//p')
        echo "shaders     : $(printf '%s\n' "$se" | sed -n 's/^etat=//p')$(printf '%s\n' "$se" | sed -n 's/^raison=\(..*\)/ (\1)/p') -- voie $sv_${sd:+, derniere partie le $(date -r "$sd" '+%F %H:%M')}"
      fi
      echo "options     : $(sh "$R/tests/profil_cidre.sh" "$id" | tr '\n' ' ')"
      f=$(sh "$R/tests/fiche_profil.sh" chemin "$id")
      if [ -n "$f" ]; then
        echo "fiche       : $f"
        # la compat sur ce Mac (l'entree par famille qui vaut ici, sinon [compat]), puis les familles
        c=$(sh "$R/tests/fiche_profil.sh" compat "$id")
        echo "compat      : $(printf '%s\n' "$c" | awk -F"\t" '$1 != "notes" && $1 != "machines" { printf "%s=%s  ", $1, $2 }')"
        n=$(printf '%s\n' "$c" | awk -F"\t" '$1 == "notes" { print $2 }'); [ -z "$n" ] || echo "notes       : $n"
        printf '%s\n' "$c" | awk -F"\t" '$1 == "machines" { printf "par famille : %s, %s : %s%s\n", $2, $3, $4, ($5 == "true" ? " (ce Mac)" : "") }'
        n=$(sh "$R/tests/fiche_profil.sh" variantes "$id" | tr '\n' ';' | sed 's/;$//; s/;/ ; /g'); [ -z "$n" ] || echo "variante    : pour cette machine (si $n)"
      else echo "fiche       : aucune (cidre profils maj)"; fi
    fi ;;
  play|jouer)
    id=${1:?usage: cidre play <id> [--sans-maj] [--json] [-- <arguments du jeu>]}
    shift
    # Les arguments du jeu ne viennent que d'apres `--` ; le reste est ignore,
    # comme avant.
    if [ "${1:-}" = -- ]; then shift; else set --; fi
    CDIR=$(jd "$id")
    # --json : l'evenement « lancement » clot la sortie standard ; tout ce qui
    # suit (le lanceur, le jeu) ecrit a l'erreur.
    # Avant lui, en --json, un client Steam qui mange deja le processeur (le
    # 2026-10-15 sur le M4 : 100 % deux jours durant, sans jeu) devient un
    # avertissement pour Verger :
    #   {"evenement":"avertissement","code":"steam_cpu","cpu":<%>,"message":...}
    # La mesure passe au lanceur (CIDRE_STEAM_CPU), qui ne la refait pas ; sans
    # --json, c'est le lanceur qui le dit. On ne ferme jamais le client.
    # Avant lui aussi, pour un jeu Windows : ses shaders sont-ils deja compiles
    # sur ce Mac (tests/etat_shaders.sh) ? En --json,
    #   {"evenement":"shaders","etat":"premier_lancement"|"cache_invalide"|"en_cache",
    #    "raison":null|"macos"|"machine"|"cidre","voie":...,"message":...}
    # que Verger annonce ; au terminal, la phrase, s'il y a quelque chose a dire.
    annoncer_shaders() {
      # (« inconnu » : un jeu sans .exe pres de la racine, Unreal sans amorceur)
      case $(plat "$id") in windows|inconnu) ;; *) return 0 ;; esac
      if [ "$JSON" = oui ]; then
        sj=$(CIDRE_CHEMIN_JEU=$(chemin "$id") sh "$R/tests/etat_shaders.sh" json "$id" 2>/dev/null) || return 0
        evenement "{\"evenement\":\"shaders\",${sj#\{}"
      else
        sm=$(CIDRE_CHEMIN_JEU=$(chemin "$id") sh "$R/tests/etat_shaders.sh" message "$id" 2>/dev/null) || true
        [ -z "$sm" ] || echo "$sm"
      fi
    }
    partir() {
      annoncer_shaders
      if [ "$JSON" = oui ] && [ "${CIDRE_SANS_STEAM:-}" != 1 ]; then
        sc=$(sh "$R/tests/client_steam_natif.sh" cpu 2>/dev/null) || true
        sc_p=$(printf '%s\n' "$sc" | sed -n 1p); sc_m=$(printf '%s\n' "$sc" | sed -n 2p)
        if entier "$sc_p"; then
          export CIDRE_STEAM_CPU=$sc_p
          [ -z "$sc_m" ] || evenement "$(printf '{"evenement":"avertissement","code":"steam_cpu","cpu":%s,"message":%s}' "$sc_p" "$(json "$sc_m")")"
        fi
      fi
      evenement '{"evenement":"lancement"}'; [ "$JSON" != oui ] || exec >&2; }
    if est_local "$id"; then
      # Jeu hors Steam : pas d'appid, son profil de lancement est range sous son id.
      EXE=$(local_champ "$id" 3)
      [ -n "$EXE" ] || { echo "jeu inconnu : $id" >&2; exit 1; }
      if [ ! -f "$EXE" ] && volume_absent "$EXE"; then
        m="$(nom "$id") est sur « $(volume_de "$EXE") », qui n'est pas branche : branche ce disque, puis recommence."
        evenement "$(printf '{"evenement":"erreur","code":"hors_ligne","emplacement":null,"message":%s}' "$(json "$m")")"
        echo "$m" >&2; exit 8
      fi
      [ -f "$EXE" ] || { echo "executable introuvable : $EXE" >&2; exit 1; }
      partir
      echo "lancement Cidre : $(basename "$EXE")  ($id)"
      temoin_en_cours "$id"
      CIDRE_JEU=$id sh "$LANCEUR" "$EXE" "$@"
    elif hors_ligne "$id"; then
      # Son disque est debranche : on le dit, sans rien toucher (code 8).
      m=$(hors_ligne_message "$id")
      evenement "$(printf '{"evenement":"erreur","code":"hors_ligne","emplacement":%s,"message":%s}' "$(json "$(empl_de "$id")")" "$(json "$m")")"
      echo "$m" >&2
      exit 8
    elif [ -n "$CDIR" ] && [ -d "$CDIR" ]; then
      # Jeu telecharge par Cidre (hors client) : c'est Cidre qui le tient a
      # jour, puis on lance par la pile Cidre. Pas pendant qu'on le deplace.
      if depl_en_cours "$id"; then
        m="Ce jeu est en cours de deplacement (processus $(depl_champ "$id" pid)) : attends la fin, puis relance-le."
        evenement "$(printf '{"evenement":"erreur","code":"deplacement","message":%s}' "$(json "$m")")"
        echo "$m" >&2; exit 4
      fi
      maj_avant_lancement "$id"
      EXE=$(exe_du_jeu "$id" "$CDIR")
      [ -n "$EXE" ] || { dire "aucun .exe dans $CDIR"; exit 1; }
      partir
      echo "lancement Cidre : $(basename "$EXE")  (appid $id)"
      echo "  (dossier : $CDIR)"
      temoin_en_cours "$id"
      # (CIDRE_SEANCE : le client ne synchronisera pas le nuage au lancement,
      # le lanceur l'y pousse -- tests/seance_steam_cloud.sh)
      [ $ACCORD_NUAGE = oui ] && export CIDRE_ACCORD_NUAGE=1
