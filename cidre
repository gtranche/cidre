              [ -d "$HOME/Library/Mobile Documents/com~apple~CloudDocs" ] || { echo "iCloud Drive n'est pas active sur ce Mac" >&2; exit 1; } ;;
            esac
            mkdir -p "$d" 2>/dev/null && [ -w "$d" ] || { echo "dossier inutilisable : $d" >&2; exit 1; }
            mkdir -p "$CIDRE_DIR" && printf '%s\n' "$d" >"$F" ;;
        esac
        d=$(sh "$R/tests/sync_saves_steam.sh" - dossier)
        if [ "$JSON" = oui ]; then
          case $d in "$HOME/Library/Mobile Documents/"*) ic=true ;; *) ic=false ;; esac
          [ -s "$F" ] && c=true || c=false
          printf '{"dossier":%s,"icloud":%s,"choisi":%s}\n' "$(json "$d")" "$ic" "$c"
        else echo "$d"; fi ;;
      unset)
        # Oublier le reglage de l'utilisateur : on revient a ce que livre Cidre.
        id=${2:?usage: cidre saves unset <id>}
        [ -f "$SAVES_PERSO" ] && awk -F'\t' -v i="$id" '$1!=i' "$SAVES_PERSO" >"$SAVES_PERSO.tmp" && mv "$SAVES_PERSO.tmp" "$SAVES_PERSO"
        [ "$JSON" = oui ] && sh "$R/tests/sync_saves_steam.sh" "$id" etat || true ;;
