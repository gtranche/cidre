              *'"steam":"lien"'*) t="Steam Cloud (dossier lie au prochain lancement)" ;;
              *) t="copie Cidre : $(printf '%s' "$e" | sed -n 's/.*"etat":"\([a-z_]*\)".*/\1/p')" ;;
            esac
            printf '%-18s %-26.26s %s\n' "$a" "$(nom "$a")" "$t"
          done
        fi ;;
      *)
        connu "$1" || { echo "jeu inconnu : $1" >&2; exit 1; }
        sh "$R/tests/sync_saves_steam.sh" "$1" etat ;;
    esac ;;
  wrap)
    sh "$R/tests/brancher_jeux_steam.sh" --ecrire ;;
  install|installer)
    case ${1:-} in *[!0-9]*|'') ;; *) [ "${2:-auto}" = macos ] || fiche_provisoire "$1" ;; esac
    sh "$R/tests/cidre_install.sh" "$@" ;;
  dl|download|telecharger)
    id=${1:?usage: cidre dl <appid> [windows|macos] [--vers <emplacement>]}; os=${2:-windows}
