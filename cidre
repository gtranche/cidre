#!/bin/sh
# Cidre launcher (CLI MVP) : installer / lancer / gerer tes jeux Steam, natif OU
# via Cidre, sans jongler avec la console Steam. Les jeux restent dans Steam
# (amis/succes/overlay via le Steam natif + notre pont). Install auto via SteamCMD.
set -u
R=$(cd "$(dirname "$0")" && pwd)
STEAM="$HOME/Library/Application Support/Steam"
SA="$STEAM/steamapps"
STEAMCMD=${STEAMCMD:-/opt/homebrew/bin/steamcmd}
CIDRE_DIR=${CIDRE_DIR:-$HOME/Library/Application Support/Cidre}
# Dossier des jeux telecharges par Cidre, HORS du client Steam (zero ecrasement).
CIDRE_GAMES="$CIDRE_DIR/games"
# Jeux hors Steam, ajoutes par `cidre add`. TAB-separe : id (local-...), nom,
# chemin de l'executable. Un jeu = une ligne.
LOCAUX="$CIDRE_DIR/jeux-locaux.conf"

# Un jeu vit dans le dossier Cidre (telecharge par `cidre dl`, prioritaire,
# comme pour `cidre play`), dans le client Steam, ou hors Steam (id local-...).
est_local() { case $1 in local-*) return 0 ;; esac; return 1; }
local_champ() { awk -F'\t' -v i="$1" -v n="$2" '$1==i {print $n; exit}' "$LOCAUX" 2>/dev/null; }
source_de() { est_local "$1" && { echo local; return; }; [ -d "$CIDRE_GAMES/$1" ] && echo cidre || echo steam; }
acf()   { [ -d "$CIDRE_GAMES/$1" ] && echo "$CIDRE_GAMES/$1/steamapps/appmanifest_$1.acf" || echo "$SA/appmanifest_$1.acf"; }
champ() { est_local "$1" && return; sed -n 's/.*"'"$2"'"[[:space:]]*"\(.*\)".*/\1/p' "$(acf "$1")" 2>/dev/null | head -1; }
nom()   { est_local "$1" && { local_champ "$1" 2; return; }; champ "$1" name | sed 's/\\"/"/g; s/\\\\/\\/g'; }
dir()   { champ "$1" installdir; }
chemin() {
   est_local "$1" && { dirname "$(local_champ "$1" 3)"; return; }
   [ -d "$CIDRE_GAMES/$1" ] && echo "$CIDRE_GAMES/$1" || echo "$SA/common/$(dir "$1")"
}
connu() { # le jeu existe-t-il pour Cidre ?
   est_local "$1" && { [ -n "$(local_champ "$1" 1)" ]; return; }
   [ -f "$(acf "$1")" ] || [ -d "$CIDRE_GAMES/$1" ]
}
# appids Steam : manifestes du client + dossiers Cidre (sans Steamworks Redist 228980)
appids() {
   { for f in "$SA"/appmanifest_*.acf; do [ -f "$f" ] && basename "$f" | sed 's/[^0-9]//g'; done
     for d in "$CIDRE_GAMES"/*/; do [ -d "$d" ] && basename "$d"; done
   } | grep -E '^[0-9]+$' | grep -vx 228980 | sort -un
}
# tous les jeux : appids Steam, puis jeux hors Steam
ids() { appids; awk -F'\t' '/^local-/ {print $1}' "$LOCAUX" 2>/dev/null; }
# Temoin « en cours » pour un jeu que cidre lance lui-meme et attend (dossier
# Cidre, hors Steam). Steam, lui, note dans son registre le jeu qu'il a lance.
EN_COURS="$CIDRE_DIR/en-cours"
temoin_en_cours() { # <id>
   case $1 in ''|*[!a-z0-9-]*) return ;; esac
   mkdir -p "$EN_COURS" && echo $$ >"$EN_COURS/$1"
   trap 'rm -f "$EN_COURS/'"$1"'"' EXIT
}

# Les jeux dont on sait ou sont les sauvegardes : le fichier livre, et celui de
# l'utilisateur (`cidre saves set`), qui passe avant.
SAVES_PERSO="$CIDRE_DIR/saves.conf"
saves_ids() { cat "$SAVES_PERSO" "$R/outil-steam/saves.conf" 2>/dev/null | awk -F'\t' '!/^#/ && NF>=2 && !vu[$1]++ {print $1}'; }

# chaine JSON (echappe \ " et tabulation)
json() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g')"; }
# la fiche JSON d'un jeu (sans l'accolade fermante : `info` y ajoute des champs)
fiche_json() {
   p=$(plat "$1"); s=$(source_de "$1")
   [ "$p" = macos ] && l=natif || l=cidre
   [ "$p" = absent ] && inst=false || inst=true
   # dossier Cidre : un telechargement interrompu n'est pas un jeu installe
   [ "$s" = cidre ] && [ "$(champ "$1" StateFlags)" != 4 ] && inst=false
   # le wrapper ne concerne que les jeux lances par Steam
   w=null; [ "$s" = steam ] && { [ "$(cidre_wrap "$1")" = oui ] && w=true || w=false; }
   t=$(champ "$1" SizeOnDisk); d=$(champ "$1" LastPlayed)
   # un jeu hors Steam n'a pas d'appid : `id` est la cle commune a tous les jeux
   est_local "$1" && a=null || a=$1
   printf '{"id":"%s","appid":%s,"nom":%s,"plateforme":"%s","lancement":"%s","source":"%s","installe":%s,"wrapper":%s,"chemin":%s,"taille":%s,"dernier_lancement":%s' \
      "$1" "$a" "$(json "$(nom "$1")")" "$p" "$l" "$s" "$inst" "$w" "$(json "$(chemin "$1")")" "${t:-0}" "${d:-0}"
}

# SteamCMD a son propre dossier de travail, a part du client Steam. Par defaut
# ils partagent ~/Library/Application Support/Steam, et le client, en ecrivant
# sa configuration, efface la session que SteamCMD y avait memorisee : il
# fallait se reconnecter apres chaque lancement de Steam. SteamCMD suit HOME.
SCMD_HOME="$CIDRE_DIR/steamcmd"
# Sur la meme machine, SteamCMD et le client Steam annoncent a Steam la meme
# adresse privee, et Steam coupe alors le client des que SteamCMD se connecte au
# compte (« Session Replaced ») : amis et chat hors ligne, sans reconnexion.
# SteamCMD sait annoncer une autre adresse ; rien n'y est envoye, elle ne sert
# qu'a distinguer sa session. Une par lancement, hors des plages des box.
SCMD_ID="-private_ip_override 10.$((254 - ($$ >> 16 & 1))).$(($$ >> 8 & 255)).$(($$ & 255))"
# session memorisee, mot de passe demande au terminal s'il le faut
scmd() { mkdir -p "$SCMD_HOME"; scmd_garde env HOME="$SCMD_HOME" "$SCMD" $SCMD_ID "$@"; }
# Le petit outil natif (tests/cidre_outil.c) : le pseudo-terminal prete a
# SteamCMD et la lecture des caches binaires du client Steam. Un runtime
# installe le livre construit -- un Mac sans outils de developpement n'a ni
# Python ni compilateur. Un depot de developpement, lui, a la source : on l'y
# construit au premier besoin, et quand elle a change.
OUTIL="$R/build/cidre-outil"
outil_pret() {
   if [ -f "$R/tests/cidre_outil.c" ] && { [ ! -x "$OUTIL" ] || [ "$R/tests/cidre_outil.c" -nt "$OUTIL" ]; }; then
      sh "$R/tests/construire_cidre_outil.sh" >&2 || return 1
   fi
   [ -x "$OUTIL" ] || { echo "Runtime incomplet : $OUTIL absent. Reinstalle le runtime Cidre." >&2; return 1; }
}
# session memorisee ou rien : jamais de tentative de mot de passe (code 3)
scmd_memorise() { outil_pret || return 1; mkdir -p "$SCMD_HOME"; scmd_garde env HOME="$SCMD_HOME" "$OUTIL" session "$SCMD" $SCMD_ID "$@"; }
# Filet : l'option n'est pas documentee et SteamCMD se met a jour seul. Si le
# client a quand meme ete coupe pendant la commande, il ne se reconnecte pas de
# lui-meme : on le lui demande, et on le dit (fd 3 : la sortie de SteamCMD est
# parfois capturee).
exec 3>&2
scmd_garde() {
   jc="$STEAM/logs/connection_log.txt"; nc=$(wc -l 2>/dev/null <"$jc"); nc=${nc:-0}
   "$@"; rcs=$?
   if tail -n +$((nc + 1)) "$jc" 2>/dev/null | grep -q "not auto reconnecting due to Session Replaced"; then
      open -g "steam://open/goonline"
      echo "Cidre : SteamCMD a deconnecte le client Steam (amis hors ligne) ; reconnexion demandee." >&3
   fi
   return $rcs
}
# sans compte : les informations publiques de Steam (versions des jeux)
scmd_anonyme() { mkdir -p "$CIDRE_DIR/steamcmd-anonyme"; HOME="$CIDRE_DIR/steamcmd-anonyme" "$SCMD" +login anonymous "$@" </dev/null; }

# binaire SteamCMD : le notre d'abord, puis PATH/brew
resolve_steamcmd() {
   for c in "$R/tools/steamcmd/steamcmd.sh" "$STEAMCMD" "$(command -v steamcmd 2>/dev/null)"; do
      [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return; }
   done
}
# nom de compte Steam (MostRecent) depuis loginusers.vdf, sinon CIDRE_STEAM_USER
steam_user() {
   [ -n "${CIDRE_STEAM_USER:-}" ] && { echo "$CIDRE_STEAM_USER"; return; }
   sh "$R/tests/compte_steam.sh" "$STEAM/config/loginusers.vdf" 2>/dev/null
}

# plateforme reellement INSTALLEE (definitif d'apres les fichiers)
plat() {
   est_local "$1" && { [ -f "$(local_champ "$1" 3)" ] && echo windows || echo absent; return; }
   d=$(chemin "$1")
   [ -d "$d" ] || { echo absent; return; }
   find "$d" -maxdepth 3 -name '*.app' -type d 2>/dev/null | grep -q . && { echo macos; return; }
   find "$d" -maxdepth 2 -name '*.exe' 2>/dev/null | grep -q . && { echo windows; return; }
   echo inconnu
}
# Cidre (notre wrapper) pose sur ce jeu ?
cidre_wrap() { grep -A6 "\"$1\"$" "$STEAM"/userdata/*/config/localconfig.vdf 2>/dev/null | grep -q "lancer_depuis_steam.sh" && echo oui || echo non; }

usage() {
   cat <<USAGE
cidre — launcher Cidre (jeux Steam ou non, natifs ou via Cidre)
  cidre list [--json]             liste tes jeux + plateforme + mode de lancement
  cidre info <id> [--json]        fiche d'un jeu : plateforme, taille, chemin, options actives
  cidre play <id>                 lance le jeu (natif via Steam, ou par la pile Cidre)
  cidre running [--json]          les jeux en cours
  cidre stop [<id>]               force l'arret d'un jeu lance par Cidre (et de tout ce que Wine fait tourner)
  cidre log <id> [lignes]         la fin du journal du dernier lancement d'un jeu (sans les traces)
  cidre set <id> <option> <valeur>   regle une option de lancement du jeu (profils.toml)
  cidre unset <id> [option]       revient au reglage livre (sans option : toutes)
                                  <id> = defaut : le reglage general, que suit tout jeu sans reglage propre
  cidre options [--json]          les reglages generaux
  cidre saves [<id>] [--json]     ou en est la synchro des sauvegardes (iCloud)
  cidre saves set <id> <dossier>  dire ou un jeu range ses sauvegardes (unset : revenir au reglage livre)
  cidre sync <id|all> [backup|restore]   sauvegarder vers iCloud, ou restaurer ce qui y est plus recent
  cidre status [--json]           version du runtime, prerequis, etat de l'installation
  cidre doctor                    diagnostic : ce qui est la, ce qui tourne, et si Wine demarre (texte a copier)
  cidre setup                     configure le runtime apres une installation ou une mise a jour
 Steam
  cidre library [--json] [--refresh]   les jeux que possede ton compte (installes ou non)
  cidre updates [--json] [--refresh]   les jeux installes dont une version plus recente est publiee
  cidre dl <appid> [windows|macos]   telecharge (ou met a jour) le jeu DANS le dossier Cidre, hors du client
  cidre login                     memorise la session SteamCMD (mot de passe tape a SteamCMD, une fois)
  cidre session [--json]          le compte Steam, et si sa session est memorisee
  cidre logout                    oublie la session Steam (les jeux installes restent jouables)
  cidre install <appid> [auto|macos|windows]   installe le depot dans le client Steam
  cidre wrap                      (re)pose le wrapper Cidre sur les jeux Windows-only
 Hors Steam
  cidre add <jeu.exe> [nom] [--json]   ajoute un jeu Windows a la bibliotheque
  cidre run <fichier.exe> [args]  lance un .exe une fois (un installeur, par exemple)
  cidre prefix                    le disque C: ou atterrissent les installeurs
  cidre rm <id>                   retire un jeu hors Steam, ou desinstalle un jeu du dossier Cidre
USAGE
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
# --json (n'importe ou) : sortie pour une interface (Verger), stable et parsable
JSON=non; MAJ=non
# `run` transmet ses arguments tels quels au programme
[ "$cmd" = run ] || for a in "$@"; do
   shift
   case $a in --json) JSON=oui ;; --refresh) MAJ=oui ;; *) set -- "$@" "$a" ;; esac
done
case "$cmd" in
  list|ls)
    if [ "$JSON" = oui ]; then
      sep='['
      for id in $(ids); do printf '%s\n  ' "$sep"; fiche_json "$id"; printf '}'; sep=','; done
      [ "$sep" = '[' ] && echo '[]' || printf '\n]\n'
      exit 0
    fi
    printf "%-18s %-26s %-10s %s\n" ID JEU PLATEFORME LANCEMENT
    for id in $(ids); do
      p=$(plat "$id"); [ "$p" = macos ] && l="natif (Steam)" || l="Cidre"
      case $(source_de "$id") in
        cidre) l="Cidre (dossier Cidre)" ;;
        local) l="Cidre (hors Steam)" ;;
        steam) [ "$(cidre_wrap "$id")" = non ] && [ "$p" = windows ] && l="Cidre (wrapper absent!)" ;;
      esac
      printf "%-18s %-26.26s %-10s %s\n" "$id" "$(nom "$id")" "$p" "$l"
    done ;;
  info)
    id=${1:?usage: cidre info <id> [--json]}
    connu "$id" || { echo "jeu inconnu : $id" >&2; exit 1; }
    opts=$(sh "$R/tests/profil_cidre.sh" "$id" json)
    [ -n "$(saves_ids | grep -x "$id")" ] && sv=true || sv=false
    if [ "$JSON" = oui ]; then
      fiche_json "$id"; printf ',"sauvegardes":%s,"options":%s,"options_perso":%s}\n' "$sv" "$opts" "$(sh "$R/tests/profil_cidre.sh" "$id" perso)"
    else
      echo "id          : $id"
      echo "nom         : $(nom "$id")"
      echo "plateforme  : $(plat "$id")"
      echo "source      : $(source_de "$id")"
      echo "chemin      : $(chemin "$id")"
      t=$(champ "$id" SizeOnDisk); echo "taille      : $(( ${t:-0} / 1048576 )) Mo"
      echo "sauvegardes : $sv"
      echo "options     : $(sh "$R/tests/profil_cidre.sh" "$id" | tr '\n' ' ')"
    fi ;;
  play|jouer)
    id=${1:?usage: cidre play <id>}
    CDIR="$CIDRE_GAMES/$id"
    if est_local "$id"; then
      # Jeu hors Steam : pas d'appid, son profil de lancement est range sous son id.
      EXE=$(local_champ "$id" 3)
      [ -n "$EXE" ] || { echo "jeu inconnu : $id" >&2; exit 1; }
      [ -f "$EXE" ] || { echo "executable introuvable : $EXE" >&2; exit 1; }
      echo "lancement Cidre : $(basename "$EXE")  ($id)"
      temoin_en_cours "$id"
      CIDRE_JEU=$id sh "$R/tests/lancer_depuis_steam.sh" "$EXE"
    elif [ -d "$CDIR" ]; then
      # Jeu telecharge par Cidre (hors client) : on lance par la pile Cidre.
      # On choisit l'exe principal : on ecarte les variantes (_gl), lanceurs,
      # serveurs et handlers de crash ; a defaut, le premier .exe trouve.
      EXE=$(find "$CDIR" -maxdepth 1 -name '*.exe' 2>/dev/null \
            | grep -viE '_gl\.exe$|_server|server\.exe$|launcher|crash|unitycrash|vcredist|redist|setup|dxsetup|install' \
            | head -1)
      [ -n "$EXE" ] || EXE=$(find "$CDIR" -maxdepth 2 -name '*.exe' 2>/dev/null | head -1)
      [ -n "$EXE" ] || { echo "aucun .exe dans $CDIR"; exit 1; }
      echo "lancement Cidre : $(basename "$EXE")  (appid $id)"
      echo "  (dossier : $CDIR)"
      temoin_en_cours "$id"
      SteamAppId=$id SteamGameId=$id SteamOverlayGameId=$id \
        sh "$R/tests/lancer_depuis_steam.sh" "$EXE"
    else
      echo "lancement de $(nom "$id") ($id) via Steam..."
      open "steam://run/$id"
    fi ;;
  running|en-cours)
    # Les jeux en cours, par leur id. Deux sources : le jeu que Steam dit avoir
    # lance (natif, ou Windows par notre wrapper), et les temoins de `cidre play`.
    en_cours=""
    if pgrep -x steam_osx >/dev/null 2>&1; then
      a=$(sed -n 's/.*"RunningAppID"[[:space:]]*"\([0-9]*\)".*/\1/p' "$STEAM/registry.vdf" 2>/dev/null | head -1)
      [ -n "$a" ] && [ "$a" != 0 ] && en_cours=$a
    fi
    for f in "$EN_COURS"/*; do
      [ -f "$f" ] || continue
      # un temoin dont le processus n'existe plus est un reste : on l'enleve
      if kill -0 "$(cat "$f" 2>/dev/null)" 2>/dev/null; then en_cours="$en_cours $(basename "$f")"; else rm -f "$f"; fi
    done
    en_cours=$(printf '%s\n' $en_cours | sort -u)
    if [ "$JSON" = oui ]; then
      sep='['; [ -n "$en_cours" ] || printf '['
      for i in $en_cours; do printf '%s"%s"' "$sep" "$i"; sep=','; done
      echo ']'
    else
      [ -n "$en_cours" ] && printf '%s\n' $en_cours
    fi ;;
  stop|arreter)
    # Force l'arret de ce qui tourne par la pile Cidre : un jeu qui ne repond
    # plus, ou qui n'a jamais affiche sa fenetre. Wine n'a qu'un prefixe : on
    # arrete tout ce qu'il fait tourner, pas un jeu parmi d'autres.
    id=${1:-}
    if [ -n "$id" ]; then
      connu "$id" || { echo "jeu inconnu : $id" >&2; exit 1; }
      [ "$(plat "$id")" = macos ] && { echo "$(nom "$id") est un jeu natif : quitte-le depuis le jeu, ou depuis Steam." >&2; exit 1; }
    fi
    export WINEPREFIX="${WINEPREFIX:-$R/wine/pfx-arm64ec}"
    WS="$R/wine/wine11-arm64/bin/wineserver"
    # un chemin, en motif pour pgrep (les points et les espaces y comptent)
    motif() { printf '%s' "$1" | sed 's/[][\.*^$()+?{}|]/\\&/g'; }
    LANCEURS="$(motif "$R/tests/")(lancer_depuis_steam|etape2_pile_arm64ec)\\.sh"
    # 1. Demander a Wine d'arreter ses processus. Le lanceur du jeu voit alors
    #    le jeu se terminer et finit son travail (sauvegardes, Mode Jeu).
    [ -x "$WS" ] && "$WS" -k 2>/dev/null
    # 2. Lui laisser quelques secondes pour ca...
    i=0; while [ $i -lt 8 ] && pgrep -f "$LANCEURS" >/dev/null 2>&1; do sleep 1; i=$((i + 1)); done
    # 3. ...puis arreter ce qui reste : un lanceur bloque avant meme d'avoir
    #    demarre Wine, un serveur Wine qui ne repond plus.
    if pgrep -f "$LANCEURS" >/dev/null 2>&1; then
      pkill -TERM -f "$LANCEURS" 2>/dev/null; sleep 2
      pkill -KILL -f "$LANCEURS" 2>/dev/null
    fi
    [ -x "$WS" ] && "$WS" -k9 2>/dev/null
    # 4. Les orphelins : des processus Windows de CE runtime qui ont survecu a
    #    leur serveur (vu sur macOS 27 : services.exe, plugplay.exe... restes
    #    des heures). On les reconnait au binaire Wine qu'ils ont en memoire --
    #    ceux d'un autre Wine (CrossOver, Whisky) ne sont pas touches.
    for pid in $(ps -axo pid=,command= | awk '$2 ~ /^[A-Za-z]:\\/ { print $1 }'); do
      lsof -a -p "$pid" -d txt -Fn 2>/dev/null | grep -qF "n$R/wine/" && kill -KILL "$pid" 2>/dev/null
    done
    rm -f "${EN_COURS:?}"/* 2>/dev/null
    echo "arrete" ;;
  log|journal)
    # La fin utile du journal d'un jeu, pour un rapport d'incident : son dernier
    # lancement, sans les lignes de trace (elles pesent des dizaines de Mo).
    id=${1:?usage: cidre log <id> [lignes]}; n=${2:-200}
    case $id in ''|*[!a-z0-9-]*) echo "id invalide : $id" >&2; exit 2 ;; esac
    case $n in ''|*[!0-9]*) echo "usage: cidre log <id> [lignes]" >&2; exit 2 ;; esac
    J="$R/build/logs/steam-$id.log"
    [ -f "$J" ] || exit 0
    # On ne relit que la fin du fichier : le debut d'un lancement tres bavard
    # peut en sortir, on donne alors ce qu'on a.
    tail -c 12000000 "$J" | LC_ALL=C grep -av ':trace:' | LC_ALL=C awk '
      /^=== [0-9]/ { n = 0 }          # un nouveau lancement : on repart de la
      { l[++n] = $0 }
      END { for (i = 1; i <= n; i++) print l[i] }' | tail -n "$n" ;;
  chemin)
    # le dossier d'un jeu (pour les scripts du runtime)
    id=${1:?usage: cidre chemin <id>}
    connu "$id" && chemin "$id" ;;
  sync)
    id=${1:?usage: cidre sync <id|all> [backup|restore]}; sens=${2:-backup}
    case $sens in backup|restore) ;; *) echo "usage: cidre sync <id|all> [backup|restore]" >&2; exit 2 ;; esac
    export WINEPREFIX="${WINEPREFIX:-$R/wine/pfx-arm64ec}"
    if [ "$id" = all ]; then
      saves_ids | while read -r a; do sh "$R/tests/sync_saves_steam.sh" "$a" "$sens"; done
    else sh "$R/tests/sync_saves_steam.sh" "$id" "$sens"; fi ;;
  saves|sauvegardes)
    export WINEPREFIX="${WINEPREFIX:-$R/wine/pfx-arm64ec}"
    case ${1:-} in
      set)
        # Dire ou un jeu range ses sauvegardes : un dossier du jeu lui-meme, ou
        # du disque C: (dossier utilisateur du prefixe).
        id=${2:-}; d=${3:-}
        [ -n "$id" ] && [ -n "$d" ] || { echo "usage: cidre saves set <id> <dossier>" >&2; exit 2; }
        connu "$id" || { echo "jeu inconnu : $id" >&2; exit 1; }
        [ -d "$d" ] || { echo "dossier introuvable : $d" >&2; exit 1; }
        d=$(cd "$d" && pwd -P)
        jeu=$(cd "$(chemin "$id")" 2>/dev/null && pwd -P)
        util=$(ls -d "$WINEPREFIX/drive_c/users/"*/AppData 2>/dev/null | head -1)
        util=$(cd "$(dirname "${util:-/nonexistent/x}")" 2>/dev/null && pwd -P)
        case $d in
          "$jeu") echo "choisis le dossier des sauvegardes, pas celui du jeu entier" >&2; exit 1 ;;
          "$jeu"/*) rel="jeu:${d#$jeu/}" ;;
          "${util:-/nonexistent}"/*) rel=${d#$util/} ;;
          *) echo "ce dossier n'est ni dans le jeu ni sur le disque C: de Cidre : $d" >&2; exit 1 ;;
        esac
        mkdir -p "$CIDRE_DIR"; touch "$SAVES_PERSO"
        awk -F'\t' -v i="$id" '$1!=i' "$SAVES_PERSO" >"$SAVES_PERSO.tmp"
        printf '%s\t%s\n' "$id" "$rel" >>"$SAVES_PERSO.tmp"
        mv "$SAVES_PERSO.tmp" "$SAVES_PERSO"
        [ "$JSON" = oui ] && sh "$R/tests/sync_saves_steam.sh" "$id" etat || echo "sauvegardes de $id : $rel" ;;
      unset)
        # Oublier le reglage de l'utilisateur : on revient a ce que livre Cidre.
        id=${2:?usage: cidre saves unset <id>}
        [ -f "$SAVES_PERSO" ] && awk -F'\t' -v i="$id" '$1!=i' "$SAVES_PERSO" >"$SAVES_PERSO.tmp" && mv "$SAVES_PERSO.tmp" "$SAVES_PERSO"
        [ "$JSON" = oui ] && sh "$R/tests/sync_saves_steam.sh" "$id" etat || true ;;
      '')
        # l'etat de tous les jeux configures et presents
        if [ "$JSON" = oui ]; then
          sep='['
          for a in $(saves_ids); do connu "$a" || continue; printf '%s\n  %s' "$sep" "$(sh "$R/tests/sync_saves_steam.sh" "$a" etat)"; sep=','; done
          [ "$sep" = '[' ] && echo '[]' || printf '\n]\n'
        else
          for a in $(saves_ids); do
            connu "$a" || continue
            printf '%-18s %-26.26s %s\n' "$a" "$(nom "$a")" "$(sh "$R/tests/sync_saves_steam.sh" "$a" etat | sed -n 's/.*"etat":"\([a-z_]*\)".*/\1/p')"
          done
        fi ;;
      *)
        connu "$1" || { echo "jeu inconnu : $1" >&2; exit 1; }
        sh "$R/tests/sync_saves_steam.sh" "$1" etat ;;
    esac ;;
  wrap)
    sh "$R/tests/brancher_jeux_steam.sh" --ecrire ;;
  install|installer)
    sh "$R/tests/cidre_install.sh" "$@" ;;
  dl|download|telecharger)
    id=${1:?usage: cidre dl <appid> [windows|macos]}; os=${2:-windows}
    SCMD=$(resolve_steamcmd)
    [ -n "$SCMD" ] || { echo "SteamCMD introuvable (ni tools/steamcmd/ ni PATH)."; exit 1; }
    U=$(steam_user)
    [ -n "$U" ] || { echo "Compte Steam introuvable. Exporte CIDRE_STEAM_USER=<ton_login> et relance."; exit 1; }
    DEST="$CIDRE_GAMES/$id"
    mkdir -p "$DEST"
    echo "== Cidre dl =="
    echo "  app     : $id"
    echo "  os      : $os"
    echo "  compte  : $U"
    echo "  dossier : $DEST   (hors du client Steam)"
    echo "  -> Si demande : tape TON mot de passe + code Steam Guard (une fois ; ensuite memorise)."
    echo
    # Au terminal, SteamCMD peut demander le mot de passe ; lance par une
    # interface, il ne le peut pas : session memorisee, ou code 3.
    if [ -t 0 ]; then session=scmd; else session=scmd_memorise; fi
    $session +@sSteamCmdForcePlatformType "$os" \
            +force_install_dir "$DEST" \
            +login "$U" \
            +app_update "$id" validate \
            +quit
    rc=$?
    # rien de telecharge : ne pas laisser un dossier vide passer pour un jeu
    rmdir "$DEST/steamapps" "$DEST" 2>/dev/null
    [ $rc -eq 3 ] && { echo "Session Steam non memorisee : connecte-toi (\`cidre login\`)." >&2; exit 3; }
    echo
    if [ $rc -eq 0 ]; then
      echo "OK. Contenu telecharge :"
      ls -la "$DEST" 2>/dev/null | head
      find "$DEST" -maxdepth 3 \( -name '*.exe' -o -name '*.app' \) 2>/dev/null | head
    else
      echo "Echec SteamCMD (rc=$rc). Si 'Invalid Password', relance et saisis bien mot de passe + Steam Guard."
      exit $rc
    fi ;;
  status|etat)
    # VERSION est pose par l'empaqueteur ; un depot de developpement n'en a pas.
    v=$(cat "$R/VERSION" 2>/dev/null); v=${v:-dev}
    oui() { "$@" >/dev/null 2>&1 && echo true || echo false; }
    rt=$(oui test -d "$R/wine/wine11-arm64")
    pf=$(oui test -d "${WINEPREFIX:-$R/wine/pfx-arm64ec}/drive_c/windows/system32")
    # Le pilote Vulkan lie SPIRV-Tools, Wine rasterise ses polices avec FreeType.
    # Un runtime installe les embarque (libs/) ; un depot de developpement les
    # prend dans Homebrew.
    sp=$(oui test -f "$R/libs/libSPIRV-Tools.dylib" -o -f /opt/homebrew/opt/spirv-tools/lib/libSPIRV-Tools.dylib)
    ft=$(oui test -f "$R/libs/libfreetype.6.dylib" -o -f /opt/homebrew/lib/libfreetype.6.dylib)
    # SteamCMD : la, ET capable de tourner sur ce processeur. L'ancienne
    # archive de Valve ne contient qu'un binaire Intel, inutilisable sur un Mac
    # Apple Silicon sans Rosetta.
    sc=false; s=$(resolve_steamcmd)
    if [ -n "$s" ]; then
      b="$(dirname "$s")/steamcmd"
      if [ "$(uname -m)" != arm64 ] || [ ! -f "$b" ] || file "$b" 2>/dev/null | grep -q arm64 \
         || arch -x86_64 /usr/bin/true 2>/dev/null; then sc=true; fi
    fi
    # Le client Steam : il lance les jeux Steam, et c'est dans son cache que
    # Cidre lit le nom des jeux du compte.
    cs=$(oui test -d "$STEAM/Steam.AppBundle" -o -d /Applications/Steam.app)
    ec=$(oui pgrep -f "$R/wine/.*wineserver")
    if [ "$JSON" = oui ]; then
      printf '{"version":%s,"racine":%s,"runtime":%s,"prefixe":%s,"steamcmd":%s,"client_steam":%s,"compte_steam":%s,"jeu_en_cours":%s,"prerequis":{"spirv_tools":%s,"freetype":%s}}\n' \
        "$(json "$v")" "$(json "$R")" "$rt" "$pf" "$sc" "$cs" "$(json "$(steam_user)")" "$ec" "$sp" "$ft"
    else
      echo "version      : $v"
      echo "racine       : $R"
      echo "runtime      : $rt"
      echo "prefixe      : $pf"
      echo "steamcmd     : $sc"
      echo "client steam : $cs"
      echo "compte steam : $(steam_user)"
      echo "jeu en cours : $ec"
      echo "spirv-tools  : $sp   (brew install spirv-tools)"
      echo "freetype     : $ft   (brew install freetype)"
    fi ;;
  doctor|diagnostic)
    sh "$R/tests/diagnostic_cidre.sh" ;;
  setup|configurer)
    sh "$R/tests/configurer_cidre.sh" ;;
  set)
    id=${1:-}; cle=${2:-}; val=${3:-}
    [ -n "$id" ] && [ -n "$cle" ] && [ -n "$val" ] || { echo "usage: cidre set <id|defaut> <option> <valeur>" >&2; exit 2; }
    [ "$id" = defaut ] || connu "$id" || { echo "jeu inconnu : $id" >&2; exit 1; }
    case $cle in
      journal_detaille|tso|vsync|hud|overlay|async|narrow_barriers|eac_untrusted|luajit|plein_ecran|gamemode)
        case $val in true|false) ;; *) echo "$cle attend true ou false" >&2; exit 2 ;; esac ;;
      fils_compilation)
        case $val in ''|*[!0-9]*) echo "fils_compilation attend un entier (0 = defaut DXVK)" >&2; exit 2 ;; esac
        [ "$val" -le 64 ] || { echo "fils_compilation : 64 au plus" >&2; exit 2; } ;;
      langue)
        # une chaine : ecrite entre guillemets dans le profil (TOML)
        case $val in auto|fr|en|de|es|it|pt|ru|pl|ja|ko|zh) val="\"$val\"" ;;
          *) echo "langue attend auto ou un code : fr, en, de, es, it, pt, ru, pl, ja, ko, zh" >&2; exit 2 ;; esac ;;
      *) echo "option inconnue : $cle (journal_detaille, tso, vsync, hud, overlay, async, narrow_barriers, fils_compilation, eac_untrusted, luajit, plein_ecran, gamemode, langue)" >&2; exit 2 ;;
    esac
    CIDRE_PROFILS=${CIDRE_PROFILS:-$CIDRE_DIR/profils.toml} sh "$R/tests/profil_cidre.sh" "$id" set "$cle" "$val" ;;
  unset)
    id=${1:?usage: cidre unset <id|defaut> [option]}
    [ "$id" = defaut ] || connu "$id" || { echo "jeu inconnu : $id" >&2; exit 1; }
    CIDRE_PROFILS=${CIDRE_PROFILS:-$CIDRE_DIR/profils.toml} sh "$R/tests/profil_cidre.sh" "$id" unset "${2:-}" ;;
  options)
    # Les reglages generaux : la section [defaut], livree puis surchargee par
    # l'utilisateur. Un jeu les suit pour toute option qu'il ne regle pas lui-meme.
    if [ "$JSON" = oui ]; then
      printf '{"options":%s,"options_perso":%s}\n' \
        "$(sh "$R/tests/profil_cidre.sh" defaut json)" "$(sh "$R/tests/profil_cidre.sh" defaut perso)"
    else
      sh "$R/tests/profil_cidre.sh" defaut
    fi ;;
  session)
    # La session est-elle memorisee ? On le demande a SteamCMD, sans jamais
    # tenter de mot de passe (code 3 = non).
    U=$(steam_user); ok=false
    SCMD=$(resolve_steamcmd)
    if [ -n "$U" ] && [ -n "$SCMD" ]; then
      scmd_memorise +login "$U" +quit >/dev/null 2>&1 && ok=true
    fi
    if [ "$JSON" = oui ]; then printf '{"compte":%s,"connecte":%s}\n' "$(json "$U")" "$ok"
    else echo "compte   : ${U:-(aucun)}"; echo "connecte : $ok"; fi ;;
  logout|deconnexion)
    # SteamCMD garde sa session dans son dossier a lui : l'oublier, c'est
    # l'effacer. La liste des jeux du compte part avec ; les jeux installes
    # restent ou ils sont, et jouables.
    S="$SCMD_HOME/Library/Application Support/Steam"
    rm -f "$S/config/config.vdf" "$S/config/loginusers.vdf" "$S/local.vdf" "$CIDRE_DIR/cache/licences.txt"
    echo "session Steam oubliee" ;;
  library|lib|bibliotheque)
    # Ce que possede le compte : SteamCMD (session memorisee) donne les licences,
    # le cache du client Steam donne les noms et les plateformes. Les licences
    # sont gardees en cache ; --refresh les redemande.
    CACHE="$CIDRE_DIR/cache/licences.txt"
    outil_pret || exit 1
    if [ ! -s "$CACHE" ] || [ "$MAJ" = oui ]; then
      SCMD=$(resolve_steamcmd)
      [ -n "$SCMD" ] || { echo "SteamCMD introuvable (ni tools/steamcmd/ ni PATH)." >&2; exit 1; }
      U=$(steam_user)
      [ -n "$U" ] || { echo "Compte Steam introuvable. Exporte CIDRE_STEAM_USER=<ton_login> et relance." >&2; exit 1; }
      mkdir -p "$(dirname "$CACHE")"
      scmd_memorise +login "$U" +licenses_print +quit >"$CACHE.tmp" 2>&1
      # la sortie vient d'un terminal : fins de ligne CR LF
      tr -d '\r' <"$CACHE.tmp" >"$CACHE.tmp2" && mv "$CACHE.tmp2" "$CACHE.tmp"
      if ! grep -q "^License packageID" "$CACHE.tmp"; then
        rm -f "$CACHE.tmp"
        echo "Session Steam non memorisee : connecte-toi (\`cidre login\`)." >&2
        exit 3
      fi
      mv "$CACHE.tmp" "$CACHE"
    fi
    if [ "$JSON" = oui ]; then
      "$OUTIL" bibliotheque "$CACHE" $(appids)
    else
      "$OUTIL" bibliotheque --texte "$CACHE" $(appids)
    fi ;;
  updates|majs)
    # Le build installe de chaque jeu, compare a celui de la branche publique.
    # Information publique : SteamCMD la lit sans compte, donc sans session.
    # Gardee en cache une demi-heure ; --refresh la redemande.
    CACHE="$CIDRE_DIR/cache/appinfo.txt"
    paires=""; demandes=""
    for id in $(appids); do
      b=$(champ "$id" buildid); [ -n "$b" ] || continue
      paires="$paires $id=$b"; demandes="$demandes +app_info_print $id"
    done
    if [ -n "$demandes" ] && { [ ! -s "$CACHE" ] || [ "$MAJ" = oui ] || [ -n "$(find "$CACHE" -mmin +30 2>/dev/null)" ]; }; then
      SCMD=$(resolve_steamcmd)
      [ -n "$SCMD" ] || { echo "SteamCMD introuvable (ni tools/steamcmd/ ni PATH)." >&2; exit 1; }
      mkdir -p "$(dirname "$CACHE")"
      scmd_anonyme +app_info_update 1 $demandes +quit >"$CACHE.tmp" 2>&1
      grep -q "^AppID : " "$CACHE.tmp" || { rm -f "$CACHE.tmp"; echo "Steam n'a pas repondu (hors ligne ?)." >&2; exit 1; }
      mv "$CACHE.tmp" "$CACHE"
    fi
    [ -s "$CACHE" ] || { [ "$JSON" = oui ] && echo "[]"; exit 0; }
    [ "$JSON" = oui ] && texte=0 || texte=1
    LC_ALL=C awk -v paires="$paires" -v texte=$texte -f "$R/tests/majs_steam.awk" "$CACHE" ;;
  login)
    SCMD=$(resolve_steamcmd)
    [ -n "$SCMD" ] || { echo "SteamCMD introuvable (ni tools/steamcmd/ ni PATH)." >&2; exit 1; }
    U=$(steam_user)
    [ -n "$U" ] || { echo "Compte Steam introuvable. Exporte CIDRE_STEAM_USER=<ton_login> et relance." >&2; exit 1; }
    echo "Connexion SteamCMD pour '$U' : tape ton mot de passe (+ Steam Guard) a SteamCMD."
    echo "Une seule fois ; Cidre ne voit jamais ton mot de passe."
    scmd +login "$U" +quit ;;
  add|ajouter)
    exe=${1:?usage: cidre add <jeu.exe> [nom]}
    [ -f "$exe" ] || { echo "fichier introuvable : $exe" >&2; exit 1; }
    [ "$(head -c 2 "$exe" 2>/dev/null)" = MZ ] || { echo "pas un executable Windows : $exe" >&2; exit 1; }
    exe=$(cd "$(dirname "$exe")" && pwd)/$(basename "$exe")
    n=$(printf '%s' "${2:-$(basename "$exe" | sed 's/\.[Ee][Xx][Ee]$//')}" | tr '\t' ' ')
    # deja dans la bibliotheque : on rend le jeu existant
    id=$(awk -F'\t' -v e="$exe" '$3==e {print $1; exit}' "$LOCAUX" 2>/dev/null)
    if [ -z "$id" ]; then
      slug=$(printf '%s' "$n" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//')
      [ -n "$slug" ] || slug=jeu
      id=local-$slug; i=2
      while [ -n "$(local_champ "$id" 1)" ]; do id=local-$slug-$i; i=$((i + 1)); done
      mkdir -p "$CIDRE_DIR"
      printf '%s\t%s\t%s\n' "$id" "$n" "$exe" >>"$LOCAUX"
    fi
    if [ "$JSON" = oui ]; then fiche_json "$id"; printf '}\n'
    else echo "ajoute : $(nom "$id")  ($id)"; fi ;;
  run)
    exe=${1:?usage: cidre run <fichier.exe> [args]}; shift
    [ -f "$exe" ] || { echo "fichier introuvable : $exe" >&2; exit 1; }
    exe=$(cd "$(dirname "$exe")" && pwd)/$(basename "$exe")
    sh "$R/tests/lancer_depuis_steam.sh" "$exe" "$@" ;;
  prefix|prefixe)
    echo "${WINEPREFIX:-$R/wine/pfx-arm64ec}/drive_c" ;;
  rm|retirer)
    id=${1:?usage: cidre rm <id>}
    if est_local "$id"; then
      connu "$id" || { echo "jeu inconnu : $id" >&2; exit 1; }
      awk -F'\t' -v i="$id" '$1!=i' "$LOCAUX" >"$LOCAUX.tmp" && mv "$LOCAUX.tmp" "$LOCAUX"
      echo "retire de la bibliotheque : $id (les fichiers du jeu ne sont pas touches)"
    else
      # un appid, rien d'autre : pas de chemin, pas de vide
      case $id in ''|*[!0-9]*) echo "id invalide : $id" >&2; exit 2 ;; esac
      [ -d "$CIDRE_GAMES/$id" ] || { echo "$id n'est pas dans le dossier Cidre ; un jeu du client Steam se desinstalle depuis Steam." >&2; exit 1; }
      # Certains jeux rangent leurs sauvegardes dans leur propre dossier : on
      # les met a l'abri avant de l'effacer.
      WINEPREFIX="${WINEPREFIX:-$R/wine/pfx-arm64ec}" sh "$R/tests/sync_saves_steam.sh" "$id" backup
      rm -rf "${CIDRE_GAMES:?}/${id:?}"
      echo "desinstalle : $CIDRE_GAMES/$id"
    fi ;;
  help|*) usage ;;
esac
