+/*
+ * La voix n'est pas relayee.
+ *
+ * ISteamUser 7..11 (StartVoiceRecording, StopVoiceRecording, GetAvailableVoice,
+ * GetVoice, DecompressVoice) feraient capturer le micro de la machine par le
+ * client Steam macOS, sans que l'utilisateur l'ait demande. Et mesure sur
+ * Vermintide 2 : a l'entree dans le Donjon, StartVoiceRecording a ete la
+ * derniere ligne du journal de connexion de Steam avant que le client
+ * disparaisse (« Created OPUS PLC voice encoder », puis plus rien), et les
+ * lancements suivants mouraient sur « fatal stalled cross-thread pipe (pipe
+ * is disconnected) ». On repond donc « pas d'enregistrement » sans appeler le
+ * natif : k_EVoiceResultNotRecording = 2 pour les lectures, rien pour les
+ * ordres. Les emplacements sont ceux de SteamUser017 a 023, stables.
+ */
+static BOOL voix_non_relayee( const char *interface, unsigned emplacement, UINT64 *ret )
+{
+    if (!meme_interface( "ISteamUser", interface )) return FALSE;
+    switch (emplacement)
+    {
+    case 7: case 8:              *ret = 0; break;   /* Start/StopVoiceRecording : void */
+    case 9: case 10: case 11:    *ret = 2; break;   /* k_EVoiceResultNotRecording */
+    default: return FALSE;
+    }
+    TRACE( "%s emplacement %u : voix non relayee\n", interface, emplacement );
+    return TRUE;
+}
