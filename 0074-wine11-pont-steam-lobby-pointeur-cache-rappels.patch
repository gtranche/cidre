+ * Le resultat d'un appel asynchrone (CallResult).
+ *
+ * Quand une methode rend un SteamAPICall_t (CreateLobby, RequestLobbyList,
+ * les requetes de stats...), le client annonce la fin par le rappel 703
+ * (SteamAPICallCompleted_t), puis steam_api vient chercher la structure de
+ * resultat par cet export plat. Le laisser en stub rendait 0 : CreateLobby
+ * aboutissait cote Steam, LobbyEnter_t arrivait, mais le LobbyCreated_t
+ * attendu par le jeu n'arrivait jamais -> « Failed to create Steam lobby »
+ * (Vermintide 2). Le dernier parametre est un bool natif : un seul octet.
+ */
+BOOL CDECL Steam_GetAPICallResult( int pipe, UINT64 call, void *tampon, int taille,
+                                   int attendu, unsigned char *echec )
 {
-    static int dit;
-    if (!dit) { dit = 1; FIXME( "export plat sollicite : Steam_GetAPICallResult\n" ); }
-    return 0;
+    static unsigned char charge[8192];
+    struct get_api_call_result_params params = { pipe, taille, call, vers_hote( charge ), attendu, 0, 0, 0 };
+
+    if (!tampon || taille <= 0 || taille > (int)sizeof(charge))
+    {
+        ERR( "tampon %p de %d octets : refuse\n", tampon, taille );
+        return FALSE;
+    }
+    if (WINE_UNIX_CALL( unix_get_api_call_result, &params )) return FALSE;
+    if (echec) *echec = params.echec ? 1 : 0;
+    if (!params.ret) return FALSE;
+    /* Le natif a rempli sa disposition a lui ; le jeu attend la sienne, et
+     * dit laquelle par l'identifiant attendu. On ne connait pas la taille
+     * native rendue : la table la porte (0 = « prends la tienne »). */
+    {
+        int n = convertir_rappel( attendu, charge, 0, sizeof(charge) );
+        if (n <= 0 || n > taille) n = taille;
+        memcpy( tampon, charge, n );
+    }
+    TRACE( "appel %s, rappel %d, %d octets -> %p (echec %d)\n",
+           wine_dbgstr_longlong(call), attendu, taille, tampon, params.echec );
