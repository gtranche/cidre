+/*
+ * Disposition des rappels : Windows contre natif.
+ *
+ * Les en-tetes Steamworks empaquetent les structures de rappel sur 8 octets
+ * sous Windows et sur 4 ailleurs. Un uint64 qui suit un champ de 4 octets
+ * n'est donc pas au meme endroit : LobbyCreated_t { EResult ; uint64 lobby }
+ * fait 12 octets cote macOS (lobby a l'offset 4) et 16 cote jeu (offset 8).
+ * Recopie brute, le jeu lisait le mot HAUT du lobby suivi de zeros :
+ * 0x0000000001860000, et interrogeait GetLobbyOwner la-dessus a chaque image
+ * sans jamais devenir hote (Vermintide 2, 15 000 appels en trois minutes).
+ *
+ * Pour les structures connues ou la difference se reduit a quatre octets de
+ * bourrage inseres a l'offset 4, on les insere. Les autres rappels mesures
+ * (504, 505, 304, 703, 1222, 1281...) ne different que par le bourrage final,
+ * sans effet sur la lecture. A completer rappel par rappel, sur mesure.
+ */
+static int convertir_rappel( int id, unsigned char *tampon, int taille_native, int capacite )
+{
+    static const struct { int id; int taille_native; } inserer4[] =
+    {
+        { 513,  12 },  /* LobbyCreated_t : { EResult ; uint64 } */
+        { 1221, 704 }, /* SteamNetConnectionStatusChangedCallback_t : m_info passe de 4 a 8 */
+    };
+    unsigned i;
+
+    for (i = 0; i < ARRAY_SIZE(inserer4); i++)
+    {
+        if (inserer4[i].id != id) continue;
+        if (taille_native <= 0) taille_native = inserer4[i].taille_native;
+        if (taille_native != inserer4[i].taille_native || capacite < taille_native + 4)
+        {
+            ERR( "rappel %d : %d octets natifs, %d attendus, capacite %d\n",
+                 id, taille_native, inserer4[i].taille_native, capacite );
+            return taille_native;
+        }
+        memmove( tampon + 8, tampon + 4, taille_native - 4 );
+        memset( tampon + 4, 0, 4 );
+        TRACE( "rappel %d : disposition native %d -> Windows %d octets\n", id, taille_native, taille_native + 4 );
+        return taille_native + 4;
+    }
+    return taille_native;
+}
