+/***********************************************************************
+ *              macdrv_cidre_space_desktop
+ *
+ * Cidre : le bureau presente a Windows est-il l'espace plein ecran du jeu ?
+ *
+ * Avec le vrai plein ecran macOS (CIDRE_FULLSCREEN_SPACE) et l'emulation des
+ * changements de mode (CIDRE_EMULATE_MODESET, lue par win32u), la fenetre de
+ * jeu finit dans un espace plein ecran. Sur un ecran a encoche cet espace
+ * s'arrete sous la barre de menus : il est moins haut que l'ecran. Si Windows
+ * croyait l'ecran entier disponible, macOS retaillerait la fenetre a son
+ * entree dans l'espace, et sous un mode emule ce retaillage revient au jeu
+ * comme une taille qui n'est celle d'aucun mode (1280x695 dans un ecran de
+ * 1280x720). On annonce donc d'emblee a win32u la zone de l'espace comme
+ * ecran physique : la fenetre de jeu y entre sans changer de taille, et un
+ * mode emule y est mis a l'echelle et centre.
+ */
+int macdrv_cidre_space_desktop(void)
+{
+    static int want;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        const char* space = getenv("CIDRE_FULLSCREEN_SPACE");
+        const char* emule = getenv("CIDRE_EMULATE_MODESET");
+        want = space && strchr("1yYtT", *space) && *space &&
+               emule && strchr("1yYtT", *emule) && *emule;
+    });
+    return want;
+}
+
+/***********************************************************************
+ *              macdrv_cidre_space_top_inset
+ *
+ * Cidre : hauteur que l'espace plein ecran laisse a la barre de menus, en haut
+ * d'un ecran a encoche (0 ailleurs : la barre s'y revele par-dessus la
+ * fenetre). C'est l'epaisseur de la barre de menus ; quand elle est masquee
+ * sur le bureau, visibleFrame ne la dit plus et on prend la zone sure de
+ * l'encoche plus le filet (32 + 1 sur un MacBook Pro 16 pouces).
+ */
+CGFloat macdrv_cidre_space_top_inset(NSScreen* screen)
+{
+    CGFloat safe, bar;
+
+    if (!macdrv_cidre_space_desktop()) return 0;
+    if (![screen respondsToSelector:@selector(safeAreaInsets)]) return 0;
+    safe = screen.safeAreaInsets.top;
+    if (safe <= 0) return 0;
+    bar = NSMaxY(screen.frame) - NSMaxY(screen.visibleFrame);
+    return bar >= safe ? bar : safe + 1;
 }
 
 
