+{
+   switch (op) {
+   case nir_atomic_op_iadd: return nir_iadd(b, old, data);
+   case nir_atomic_op_imin: return nir_imin(b, old, data);
+   case nir_atomic_op_umin: return nir_umin(b, old, data);
+   case nir_atomic_op_imax: return nir_imax(b, old, data);
+   case nir_atomic_op_umax: return nir_umax(b, old, data);
+   case nir_atomic_op_iand: return nir_iand(b, old, data);
+   case nir_atomic_op_ior: return nir_ior(b, old, data);
+   case nir_atomic_op_ixor: return nir_ixor(b, old, data);
+   case nir_atomic_op_xchg: return data;
+   default: UNREACHABLE("unsupported 64-bit atomic op");
+   }
+}
+
+/* True when the high word alone shows that min/max leaves the value as is. */
+static nir_def *
+high_word_settles(nir_builder *b, nir_atomic_op op, nir_def *cur_hi,
+                  nir_def *data)
+{
+   nir_def *hi = nir_unpack_64_2x32_split_y(b, data);
+   switch (op) {
+   case nir_atomic_op_umax: return nir_ult(b, hi, cur_hi);
+   case nir_atomic_op_imax: return nir_ilt(b, hi, cur_hi);
+   case nir_atomic_op_umin: return nir_ult(b, cur_hi, hi);
+   case nir_atomic_op_imin: return nir_ilt(b, cur_hi, hi);
+   default: return NULL;
+   }
+}
+
+/* Emits the locked read-modify-write and returns the old value (NULL when the
+ * result is unused). cmp is only for compare-exchange. */
+static nir_def *
+emit_locked_rmw(nir_builder *b, const struct word_access *w, nir_def *key,
+                nir_atomic_op op, bool swap, nir_def *cmp, nir_def *data,
+                bool result_used)
+{
+   nir_variable_mode modes = w->shared ? nir_var_mem_shared : nir_var_mem_global;
+   nir_def *lock = lock_word_addr(b, key);
+
+   nir_if *skip_if = NULL;
+   if (!swap && !result_used &&
+       (op == nir_atomic_op_umax || op == nir_atomic_op_imax ||
+        op == nir_atomic_op_umin || op == nir_atomic_op_imin)) {
+      nir_def *settles =
+         high_word_settles(b, op, load_word(b, w, 4, false), data);
+      skip_if = nir_push_if(b, nir_inot(b, settles));
+   }
+
+   /* The loop exits on the result of the release, which keeps the release
+    * inside the loop. With the more usual
+    * "if (acquired) { ...; release; break; }", the Apple7 Metal compiler
+    * moves the critical section past the loop: lanes of one SIMD group that
+    * share a lock then wait forever for each other (GPU watchdog,
+    * kIOGPUCommandBufferCallbackErrorImpactingInteractivity). Plain exchange,
+    * no test-and-test-and-set: on Apple7 a relaxed atomic load of the lock
+    * keeps seeing it taken long after its release (up to 40x slower). */
+   nir_loop *loop = nir_push_loop(b);
+   nir_def *prev = nir_global_atomic(b, 32, lock, nir_imm_int(b, 1),
+                                     .atomic_op = nir_atomic_op_xchg);
+   nir_def *got = nir_ieq_imm(b, prev, 0);
+
+   nir_if *got_if = nir_push_if(b, got);
+   device_fence(b, modes);
+   nir_def *lo = load_word(b, w, 0, true);
+   nir_def *hi = load_word(b, w, 4, true);
+   nir_def *old = nir_pack_64_2x32_split(b, lo, hi);
+   nir_def *val = swap ? nir_bcsel(b, nir_ieq(b, old, cmp), data, old)
+                       : apply_op(b, op, old, data);
+   nir_push_if(b, nir_ine(b, val, old));
+   store_word(b, w, 0, nir_unpack_64_2x32_split_x(b, val));
+   store_word(b, w, 4, nir_unpack_64_2x32_split_y(b, val));
+   nir_pop_if(b, NULL);
+   device_fence(b, modes);
+   nir_def *released = nir_global_atomic(b, 32, lock, nir_imm_int(b, 0),
+                                         .atomic_op = nir_atomic_op_xchg);
+   nir_def *fin = nir_ine_imm(b, released, 0);
+   nir_push_else(b, got_if);
+   nir_def *not_yet = nir_imm_false(b);
+   nir_def *no_old = nir_imm_int64(b, 0);
+   nir_pop_if(b, got_if);
+   nir_def *done = nir_if_phi(b, fin, not_yet);
+   nir_def *old_out = nir_if_phi(b, old, no_old);
+
+   nir_push_if(b, done);
+   nir_jump(b, nir_jump_break);
+   nir_pop_if(b, NULL);
+   nir_pop_loop(b, loop);
+
+   if (skip_if != NULL) {
+      nir_pop_if(b, skip_if);
+      return NULL;
+   }
+   return old_out;
+}
+
+static bool
+lower_memory_atomic(nir_builder *b, nir_intrinsic_instr *intr)
+{
+   bool shared;
+   switch (intr->intrinsic) {
+   case nir_intrinsic_global_atomic:
+   case nir_intrinsic_global_atomic_swap:
+      shared = false;
+      break;
+   case nir_intrinsic_shared_atomic:
+   case nir_intrinsic_shared_atomic_swap:
+      shared = true;
+      break;
+   default:
+      return false;
+   }
+   if (intr->def.bit_size != 64)
+      return false;
+
+   bool swap = intr->intrinsic == nir_intrinsic_global_atomic_swap ||
+               intr->intrinsic == nir_intrinsic_shared_atomic_swap;
+   nir_atomic_op op = nir_intrinsic_atomic_op(intr);
+
+   b->cursor = nir_before_instr(&intr->instr);
+   struct word_access w = {
+      .shared = shared,
+      .addr = intr->src[0].ssa,
+      .base = shared ? nir_intrinsic_base(intr) : 0,
+   };
+
+   /* Shared words are hashed by offset only: workgroups whose words share a
+    * lock merely wait for each other. */
+   nir_def *key =
+      shared ? nir_ushr_imm(b, nir_iadd_imm(b, w.addr, w.base), 3)
+             : nir_u2u32(b, nir_ushr_imm(b, w.addr, 3));
+
+   bool used = !nir_def_is_unused(&intr->def);
+   nir_def *old = emit_locked_rmw(b, &w, key, op, swap,
+                                  swap ? intr->src[1].ssa : NULL,
+                                  intr->src[swap ? 2 : 1].ssa, used);
+   if (used)
+      nir_def_rewrite_uses(&intr->def, old);
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+/* --- 64-bit images ------------------------------------------------------ */
+
+static bool
+image_is_64bit(nir_intrinsic_instr *intr)
+{
+   switch (intr->intrinsic) {
+   case nir_intrinsic_bindless_image_load:
+   case nir_intrinsic_bindless_image_atomic:
+   case nir_intrinsic_bindless_image_atomic_swap:
+      return intr->def.bit_size == 64;
+   case nir_intrinsic_bindless_image_store:
+      return intr->src[3].ssa->bit_size == 64;
+   default:
+      return false;
+   }
+}
+
+static void
+warn_once(const char *what)
+{
+   static bool said = false;
+   if (!said) {
+      said = true;
+      fprintf(stderr, "KK: atomiques 64 bits emulees : %s\n", what);
+   }
+}
+
+static nir_intrinsic_instr *
+texture_handle_of(nir_intrinsic_instr *intr)
+{
+   nir_instr *parent = nir_def_instr(intr->src[0].ssa);
+   if (parent->type != nir_instr_type_intrinsic)
+      return NULL;
+   nir_intrinsic_instr *h = nir_instr_as_intrinsic(parent);
+   return h->intrinsic == nir_intrinsic_load_texture_handle_kk ? h : NULL;
+}
+
+/* 32-bit image load returning the two words of the R32G32 texel. */
+static nir_def *
+fallback_texture_load(nir_builder *b, nir_intrinsic_instr *intr)
+{
+   nir_intrinsic_instr *ld =
+      nir_intrinsic_instr_create(b->shader, nir_intrinsic_bindless_image_load);
+   for (unsigned i = 0; i < 4; i++)
+      ld->src[i] = nir_src_for_ssa(intr->src[i].ssa);
+   ld->num_components = 4;
+   nir_intrinsic_set_image_dim(ld, nir_intrinsic_image_dim(intr));
+   nir_intrinsic_set_image_array(ld, nir_intrinsic_image_array(intr));
+   nir_intrinsic_set_format(ld, PIPE_FORMAT_R32G32_UINT);
+   nir_intrinsic_set_access(ld, nir_intrinsic_access(intr));
+   nir_intrinsic_set_dest_type(ld, nir_type_uint32);
+   nir_def_init(&ld->instr, &ld->def, 4, 32);
+   nir_builder_instr_insert(b, &ld->instr);
+   return nir_pack_64_2x32(b, nir_channels(b, &ld->def, 0x3));
+}
+
+static void
+fallback_texture_store(nir_builder *b, nir_intrinsic_instr *intr,
+                       nir_def *value)
+{
+   nir_def *words = nir_unpack_64_2x32(b, value);
+   nir_def *texel = nir_vec4(b, nir_channel(b, words, 0),
+                             nir_channel(b, words, 1), nir_imm_int(b, 0),
+                             nir_imm_int(b, 0));
+   nir_intrinsic_instr *st =
+      nir_intrinsic_instr_create(b->shader, nir_intrinsic_bindless_image_store);
+   st->src[0] = nir_src_for_ssa(intr->src[0].ssa);
+   st->src[1] = nir_src_for_ssa(intr->src[1].ssa);
+   st->src[2] = nir_src_for_ssa(intr->src[2].ssa);
+   st->src[3] = nir_src_for_ssa(texel);
+   st->src[4] = nir_src_for_ssa(intr->src[4].ssa);
+   st->num_components = 4;
+   nir_intrinsic_set_image_dim(st, nir_intrinsic_image_dim(intr));
+   nir_intrinsic_set_image_array(st, nir_intrinsic_image_array(intr));
+   nir_intrinsic_set_format(st, PIPE_FORMAT_R32G32_UINT);
+   nir_intrinsic_set_access(st, nir_intrinsic_access(intr));
+   nir_intrinsic_set_src_type(st, nir_type_uint32);
+   nir_builder_instr_insert(b, &st->instr);
+}
+
+static nir_def *
+texel_result(nir_builder *b, nir_intrinsic_instr *intr, nir_def *v)
+{
+   if (intr->def.num_components == 1)
+      return v;
+   nir_def *zero = nir_imm_int64(b, 0);
+   nir_def *chan[4] = {v, zero, zero, nir_imm_int64(b, 1)};
+   return nir_vec(b, chan, intr->def.num_components);
+}
+
+static bool
+lower_image64(nir_builder *b, nir_intrinsic_instr *intr)
+{
+   if (!image_is_64bit(intr))
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   nir_intrinsic_instr *handle = texture_handle_of(intr);
+   enum glsl_sampler_dim dim = nir_intrinsic_image_dim(intr);
+   bool array = nir_intrinsic_image_array(intr);
+   bool is_load = intr->intrinsic == nir_intrinsic_bindless_image_load;
+   bool is_store = intr->intrinsic == nir_intrinsic_bindless_image_store;
+   bool is_swap = intr->intrinsic == nir_intrinsic_bindless_image_atomic_swap;
+
+   if (handle == NULL || dim != GLSL_SAMPLER_DIM_2D || array) {
+      warn_once("image 64 bits non 2D, en tableau ou a poignee indirecte : "
+                "atomiques ignorees");
+      if (is_load) {
+         nir_def_replace(&intr->def,
+                         texel_result(b, intr, fallback_texture_load(b, intr)));
+      } else if (is_store) {
+         fallback_texture_store(b, intr, nir_channel(b, intr->src[3].ssa, 0));
+         nir_instr_remove(&intr->instr);
+      } else {
+         nir_def_replace(&intr->def, nir_imm_int64(b, 0));
+      }
+      return true;
+   }
+
+   /* The handle reads the resource id at this address (2D, not an array);
+    * the next word of struct kk_storage_image_descriptor holds the texel
+    * address and the row pitch (KK_ATOMIC64_ADDR_BITS). */
+   nir_def *word = nir_build_load_global_constant(
+      b, 1, 64,
+      nir_iadd_imm(b, handle->src[0].ssa,
+                   offsetof(struct kk_storage_image_descriptor,
+                            array_image_gpu_resource_id)),
+      .align_mul = 8);
+   nir_def *base =
+      nir_iand_imm(b, word, (1ull << KK_ATOMIC64_ADDR_BITS) - 1ull);
+   nir_def *pitch = nir_ishl_imm(
+      b, nir_u2u32(b, nir_ushr_imm(b, word, KK_ATOMIC64_ADDR_BITS)), 3);
+
+   nir_intrinsic_instr *sz =
+      nir_intrinsic_instr_create(b->shader, nir_intrinsic_bindless_image_size);
+   sz->src[0] = nir_src_for_ssa(intr->src[0].ssa);
+   sz->src[1] = nir_src_for_ssa(nir_imm_int(b, 0));
+   sz->num_components = 2;
+   nir_intrinsic_set_image_dim(sz, GLSL_SAMPLER_DIM_2D);
+   nir_intrinsic_set_image_array(sz, false);
+   nir_intrinsic_set_format(sz, PIPE_FORMAT_R32G32_UINT);
+   nir_intrinsic_set_access(sz, nir_intrinsic_access(intr));
+   nir_def_init(&sz->instr, &sz->def, 2, 32);
+   nir_builder_instr_insert(b, &sz->instr);
+   nir_def *width = nir_channel(b, &sz->def, 0);
+   nir_def *height = nir_channel(b, &sz->def, 1);
+
+   nir_def *coord = intr->src[1].ssa;
+   nir_def *x = nir_u2u32(b, nir_channel(b, coord, 0));
+   nir_def *y = nir_u2u32(b, nir_channel(b, coord, 1));
+   nir_def *inside = nir_iand(b, nir_ult(b, x, width), nir_ult(b, y, height));
+   nir_def *addr =
+      nir_iadd(b, base,
+               nir_iadd(b, nir_imul(b, nir_u2u64(b, y), nir_u2u64(b, pitch)),
+                        nir_u2u64(b, nir_ishl_imm(b, x, 3))));
+   nir_def *has_mem = nir_ine_imm(b, base, 0);
+
+   nir_if *mem_if = nir_push_if(b, has_mem);
+   nir_def *mem_val = NULL;
+   {
+      nir_if *in_if = nir_push_if(b, inside);
+      nir_def *in_val = NULL;
+      if (is_load) {
+         nir_def *words = nir_build_load_global(
+            b, 2, 32, addr, .align_mul = 8,
+            .access = nir_intrinsic_access(intr) & (ACCESS_COHERENT |
+                                                    ACCESS_VOLATILE));
+         in_val = nir_pack_64_2x32(b, words);
+      } else if (is_store) {
+         nir_build_store_global(
+            b, nir_unpack_64_2x32(b, nir_channel(b, intr->src[3].ssa, 0)),
+            addr, .align_mul = 8,
+            .access = nir_intrinsic_access(intr) & (ACCESS_COHERENT |
+                                                    ACCESS_VOLATILE));
+      } else if (is_swap) {
+         in_val = nir_global_atomic_swap(b, 64, addr, intr->src[3].ssa,
+                                         intr->src[4].ssa,
+                                         .atomic_op = nir_intrinsic_atomic_op(intr));
+      } else {
+         in_val = nir_global_atomic(b, 64, addr, intr->src[3].ssa,
+                                    .atomic_op = nir_intrinsic_atomic_op(intr));
+      }
+      nir_push_else(b, in_if);
+      nir_def *out_val = is_store ? NULL : nir_imm_int64(b, 0);
+      nir_pop_if(b, in_if);
+      if (!is_store)
+         mem_val = nir_if_phi(b, in_val, out_val);
+   }
+   nir_push_else(b, mem_if);
+   nir_def *tex_val = NULL;
+   if (is_load)
+      tex_val = fallback_texture_load(b, intr);
+   else if (is_store)
+      fallback_texture_store(b, intr, nir_channel(b, intr->src[3].ssa, 0));
+   else
+      tex_val = nir_imm_int64(b, 0);
+   nir_pop_if(b, mem_if);
+
+   if (is_store) {
+      nir_instr_remove(&intr->instr);
+   } else {
+      nir_def *v = nir_if_phi(b, mem_val, tex_val);
+      nir_def_replace(&intr->def, is_load ? texel_result(b, intr, v) : v);
+   }
+   return true;
+}
+
+static bool
+lower_image64_instr(nir_builder *b, nir_intrinsic_instr *intr,
+                    UNUSED void *data)
+{
+   return lower_image64(b, intr);
+}
+
+/* What remains of a 64-bit image handle is used with 32-bit texture ops (the
+ * fallbacks and size queries): Apple7 has no ulong textures. */
+static bool
+retype_handle_instr(UNUSED nir_builder *b, nir_intrinsic_instr *intr,
+                    UNUSED void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_texture_handle_kk)
+      return false;
+   nir_alu_type t = nir_intrinsic_dest_type(intr);
+   if (nir_alu_type_get_type_size(t) != 64)
+      return false;
+   nir_intrinsic_set_dest_type(intr, nir_type_uint32);
+   return true;
+}
+
+static bool
+lower_memory_atomic_instr(nir_builder *b, nir_intrinsic_instr *intr,
+                          UNUSED void *data)
+{
+   return lower_memory_atomic(b, intr);
+}
+
+bool
+kk_nir_lower_atomic64_emul(nir_shader *nir)
+{
+   bool progress = false;
+
+   /* Images first: they turn into 64-bit global atomics lowered next. */
+   progress |= nir_shader_intrinsics_pass(nir, lower_image64_instr,
+                                          nir_metadata_none, NULL);
+   progress |= nir_shader_intrinsics_pass(nir, retype_handle_instr,
+                                          nir_metadata_all, NULL);
+   /* Drops the phis of unread image atomic results, so their global atomics
+    * are seen unused and get the lock-free peek. */
+   if (progress)
+      nir_opt_dce(nir);
+   progress |= nir_shader_intrinsics_pass(nir, lower_memory_atomic_instr,
+                                          nir_metadata_none, NULL);
+   return progress;
+}
