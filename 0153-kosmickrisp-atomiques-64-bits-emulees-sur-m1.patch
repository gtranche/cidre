+static nir_def *
+lock_word_addr(nir_builder *b, nir_def *key)
+{
+   nir_def *locks = nir_load_atomic64_locks_ptr_kk(b, 1, 64);
+   nir_def *idx = nir_iand_imm(b, key, KK_ATOMIC64_LOCK_COUNT - 1u);
+   return nir_iadd(b, locks, nir_u2u64(b, nir_ishl_imm(b, idx, 2)));
+}
+
+static void
+device_fence(nir_builder *b, nir_variable_mode modes)
+{
+   nir_barrier(b, .execution_scope = SCOPE_NONE,
+               .memory_scope = SCOPE_DEVICE,
+               .memory_semantics = NIR_MEMORY_ACQ_REL, .memory_modes = modes);
+}
+
+struct word_access {
+   bool shared;
+   nir_def *addr; /* 64-bit global address or 32-bit shared offset */
+   unsigned base; /* shared base */
+};
+
+/* Under the lock the words are read with a read-modify-write (add 0), not an
+ * atomic load: the Apple7 Metal backend (AGXMetalG13X, macOS 26) crashes
+ * compiling a 64-bit value assembled from two atomic_load results and then
+ * compared or added (XPC_ERROR_CONNECTION_INTERRUPTED); from RMW results it
+ * compiles. The lock-free peek of the high word stays a 32-bit load and a
+ * 32-bit compare, which compile. */
+static nir_def *
+load_word(nir_builder *b, const struct word_access *w, unsigned off, bool rmw)
+{
+   nir_def *a = nir_iadd_imm(b, w->addr, off);
+   if (w->shared) {
+      return nir_shared_atomic(b, 32, a, nir_imm_int(b, 0),
+                               .atomic_op = nir_atomic_op_iadd,
+                               .base = w->base);
+   }
+   if (rmw) {
+      return nir_global_atomic(b, 32, a, nir_imm_int(b, 0),
+                               .atomic_op = nir_atomic_op_iadd);
+   }
+   return nir_build_load_global(b, 1, 32, a, .align_mul = 4,
+                                .access = ACCESS_ATOMIC | ACCESS_COHERENT |
+                                          ACCESS_VOLATILE);
+}
+
+static void
+store_word(nir_builder *b, const struct word_access *w, unsigned off,
+           nir_def *v)
+{
+   nir_def *a = nir_iadd_imm(b, w->addr, off);
+   if (w->shared) {
+      nir_shared_atomic(b, 32, a, v, .atomic_op = nir_atomic_op_xchg,
+                        .base = w->base);
+      return;
+   }
+   nir_build_store_global(b, v, a, .align_mul = 4,
+                          .access = ACCESS_ATOMIC | ACCESS_COHERENT |
+                                    ACCESS_VOLATILE);
+}
