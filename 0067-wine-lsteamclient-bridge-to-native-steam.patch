diff --git a/dlls/lsteamclient/main.c b/dlls/lsteamclient/main.c
new file mode 100644
index 00000000..c3549f1b
--- /dev/null
+++ b/dlls/lsteamclient/main.c
@@ -0,0 +1,96 @@
+/*
+ * Cote PE du pont Steamworks : ce que le steam_api du jeu appelle.
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(lsteamclient);
+
+BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls( inst );
+        if (__wine_init_unix_call()) return FALSE;
+        if (WINE_UNIX_CALL( unix_attach, NULL )) return FALSE;
+    }
+    return TRUE;
+}
+
+void * CDECL CreateInterface( const char *version, int *err )
+{
+    struct create_interface_params params = { version, err, NULL };
+
+    if (WINE_UNIX_CALL( unix_create_interface, &params )) return NULL;
+    TRACE( "%s -> %p\n", debugstr_a(version), params.ret );
+    return params.ret;
+}
+
+int CDECL SondeCreateSteamPipe( void *iface )
+{
+    struct create_steam_pipe_params params = { iface, 0 };
+
+    if (WINE_UNIX_CALL( unix_create_steam_pipe, &params )) return 0;
+    TRACE( "%p -> %d\n", iface, params.ret );
+    return params.ret;
+}
+
+/*
+ * L'objet que le jeu croira Windows.
+ *
+ * Un jeu appelle une methode virtuelle en ABI Microsoft x64 : « this » dans
+ * RCX. L'objet natif, lui, attend System V : « this » dans RDI. On fabrique
+ * donc cote PE un objet dont la table de methodes contient nos thunks ; chacun
+ * recoit l'appel a la mode Windows, retrouve l'interface native, et passe par
+ * l'unixlib qui fera l'appel a la mode System V.
+ *
+ * Le compilateur PE emettant du Microsoft x64, une simple fonction C dont le
+ * premier parametre est l'objet suffit a recevoir un appel virtuel.
+ */
+struct objet_pe
+{
+    const void **table;   /* doit rester en tete : c'est ce que le jeu deref */
+    void        *natif;
+};
+
+static int thunk_CreateSteamPipe( struct objet_pe *self )
+{
+    struct create_steam_pipe_params params = { self->natif, 0 };
+
+    TRACE( "objet PE %p, interface native %p\n", self, self->natif );
+    if (WINE_UNIX_CALL( unix_create_steam_pipe, &params )) return 0;
+    return params.ret;
+}
+
+static int thunk_BReleaseSteamPipe( struct objet_pe *self, int pipe )
+{
+    struct release_steam_pipe_params params = { self->natif, pipe, 0 };
+
+    TRACE( "objet PE %p, tuyau %d\n", self, pipe );
+    if (WINE_UNIX_CALL( unix_release_steam_pipe, &params )) return 0;
+    return params.ret;
+}
+
+static const void *table_steam_client[] =
+{
+    thunk_CreateSteamPipe,
+    thunk_BReleaseSteamPipe,
+};
+
+void * CDECL SondeEnvelopperSteamClient( void *natif )
+{
+    struct objet_pe *objet;
+
+    if (!natif) return NULL;
+    if (!(objet = HeapAlloc( GetProcessHeap(), 0, sizeof(*objet) ))) return NULL;
+    objet->table = table_steam_client;
+    objet->natif = natif;
+    TRACE( "interface native %p -> objet PE %p\n", natif, objet );
+    return objet;
+}
diff --git a/dlls/lsteamclient/unix.c b/dlls/lsteamclient/unix.c
new file mode 100644
index 00000000..94d245f2
--- /dev/null
+++ b/dlls/lsteamclient/unix.c
@@ -0,0 +1,131 @@
+/*
+ * Cote unix du pont Steamworks : charge le steamclient.dylib du client Steam
+ * natif et lui demande ses interfaces.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(lsteamclient);
+
+typedef void *(*create_interface_t)( const char *version, int *err );
+
+static void *steamclient;
+static create_interface_t p_CreateInterface;
+
+static const char *chemins[] =
+{
+    "%s/Library/Application Support/Steam/Steam.AppBundle/Steam/Contents/MacOS/steamclient.dylib",
+    "%s/Library/Application Support/Steam/steamclient.dylib",
+};
+
+static NTSTATUS attach( void *args )
+{
+    const char *home = getenv( "HOME" );
+    char chemin[1024];
+    unsigned int i;
+
+    if (steamclient) return STATUS_SUCCESS;
+    if (!home) return STATUS_DLL_NOT_FOUND;
+
+    for (i = 0; i < ARRAY_SIZE(chemins); i++)
+    {
+        snprintf( chemin, sizeof(chemin), chemins[i], home );
+        if ((steamclient = dlopen( chemin, RTLD_NOW | RTLD_LOCAL ))) break;
+        TRACE( "%s : %s\n", chemin, dlerror() );
+    }
+    if (!steamclient)
+    {
+        ERR( "steamclient.dylib introuvable\n" );
+        return STATUS_DLL_NOT_FOUND;
+    }
+
+    if (!(p_CreateInterface = dlsym( steamclient, "CreateInterface" )))
+    {
+        ERR( "CreateInterface absent de steamclient.dylib\n" );
+        return STATUS_ENTRYPOINT_NOT_FOUND;
+    }
+
+    TRACE( "steamclient.dylib charge, CreateInterface a %p\n", p_CreateInterface );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS create_interface( void *args )
+{
+    struct create_interface_params *params = args;
+
+    if (!p_CreateInterface) return STATUS_DLL_NOT_FOUND;
+    params->ret = p_CreateInterface( params->version, params->err );
+    TRACE( "%s -> %p\n", debugstr_a(params->version), params->ret );
+    return STATUS_SUCCESS;
+}
+
+/*
+ * ISteamClient::CreateSteamPipe occupe le premier emplacement de la table de
+ * methodes. L'objet rendu par steamclient.dylib est un objet C++ natif : sa
+ * table suit l'ABI System V, ou « this » passe dans le premier registre
+ * d'argument, ce qui est exactement ce qu'une fonction C a un parametre fait
+ * ici. Le jeu Windows, lui, appellera en ABI Microsoft x64 -- c'est la
+ * traduction que les thunks devront assurer.
+ */
+static NTSTATUS create_steam_pipe( void *args )
+{
+    struct create_steam_pipe_params *params = args;
+    typedef int (*methode_t)( void *iface );
+    methode_t *table;
+
+    if (!params->iface) return STATUS_INVALID_PARAMETER;
+
+    table = *(methode_t **)params->iface;
+    TRACE( "iface %p, table %p, emplacement 0 = %p\n", params->iface, table, table[0] );
+
+    params->ret = table[0]( params->iface );
+    TRACE( "CreateSteamPipe -> %d\n", params->ret );
+    return STATUS_SUCCESS;
+}
+
+/* ISteamClient::BReleaseSteamPipe occupe l'emplacement 1 et prend un argument :
+ * de quoi eprouver le passage de parametre, que CreateSteamPipe ne testait pas. */
+static NTSTATUS release_steam_pipe( void *args )
+{
+    struct release_steam_pipe_params *params = args;
+    /* La methode rend un bool d'un octet : elle ne renseigne que AL, et lire
+     * EAX entier ramene les bits de poids fort laisses indefinis. Le type de
+     * retour doit donc etre declare a sa vraie largeur. */
+    typedef unsigned char (*methode_t)( void *iface, int pipe );
+    methode_t *table;
+
+    if (!params->iface) return STATUS_INVALID_PARAMETER;
+
+    table = *(methode_t **)params->iface;
+    params->ret = table[1]( params->iface, params->pipe );
+    TRACE( "BReleaseSteamPipe(%d) -> %d\n", params->pipe, params->ret );
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    attach,
+    create_interface,
+    create_steam_pipe,
+    release_steam_pipe,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
diff --git a/dlls/lsteamclient/unixlib.h b/dlls/lsteamclient/unixlib.h
new file mode 100644
index 00000000..675c74ac
--- /dev/null
+++ b/dlls/lsteamclient/unixlib.h
@@ -0,0 +1,42 @@
+/*
+ * Pont Steamworks : interface entre le cote PE et le cote unix.
+ */
+
+#ifndef __WINE_LSTEAMCLIENT_UNIXLIB_H
+#define __WINE_LSTEAMCLIENT_UNIXLIB_H
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "wine/unixlib.h"
+
+struct create_interface_params
+{
+    const char *version;
+    int        *err;
+    void       *ret;
+};
+
+struct create_steam_pipe_params
+{
+    void *iface;
+    int   ret;
+};
+
+struct release_steam_pipe_params
+{
+    void *iface;
+    int   pipe;
+    int   ret;
+};
+
+enum lsteamclient_funcs
+{
+    unix_attach,
+    unix_create_interface,
+    unix_create_steam_pipe,
+    unix_release_steam_pipe,
+    unix_funcs_count
+};
+
+#endif
