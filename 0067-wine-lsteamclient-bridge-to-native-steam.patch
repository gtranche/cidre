+/*
+ * Pont Steamworks : interface entre le cote PE et le cote unix.
+ */
+
+#ifndef __WINE_LSTEAMCLIENT_UNIXLIB_H
+#define __WINE_LSTEAMCLIENT_UNIXLIB_H
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "wine/unixlib.h"
+
+struct create_interface_params
+{
+    const char *version;
+    int        *err;
+    void       *ret;
+};
+
+struct create_steam_pipe_params
+{
+    void *iface;
+    int   ret;
+};
+
+struct release_steam_pipe_params
+{
+    void *iface;
+    int   pipe;
+    int   ret;
+};
+
+/* Les fonctions plates prenant (utilisateur, tuyau) ou (tuyau) seul partagent
+ * cette forme ; « quoi » designe laquelle appeler. */
+enum fonction_plate
+{
+    plate_connect_to_global_user,   /* (tuyau) -> utilisateur */
+    plate_release_user,             /* (tuyau, utilisateur) */
+    plate_b_connected,              /* (utilisateur, tuyau) -> bool */
+    plate_b_logged_on,              /* (utilisateur, tuyau) -> bool */
+    plate_create_steam_pipe,        /* () -> tuyau */
+};
+
+struct appel_plat_params
+{
+    int quoi;
+    int pipe;
+    int user;
+    int ret;
+};
+
+/* Copie du CallbackMsg_t de Steamworks. Le cote unix ne la passe jamais telle
+ * quelle au client natif : il remplit sa propre structure native puis recopie
+ * champ par champ, pour qu'aucune hypothese d'alignement ne traverse la
+ * frontiere. */
+struct generic_interface_params
+{
+    void       *iface;
+    int         user;
+    int         pipe;
+    const char *version;
+    void       *ret;
+};
+
+struct callback_msg
+{
+    int    user;
+    int    callback;
+    void  *param;
+    int    taille;
+};
+
+struct get_callback_params
+{
+    int                 pipe;
+    struct callback_msg msg;
+    int                 call;
+    int                 ret;
+};
+
+struct free_last_callback_params
+{
+    int pipe;
+};
+
+enum lsteamclient_funcs
+{
+    unix_attach,
+    unix_create_interface,
+    unix_create_steam_pipe,
+    unix_release_steam_pipe,
+    unix_appel_plat,
+    unix_get_callback,
+    unix_free_last_callback,
+    unix_get_generic_interface,
+    unix_funcs_count
+};
+
+#endif
