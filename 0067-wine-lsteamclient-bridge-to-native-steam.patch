+++ b/dlls/lsteamclient/main.c
@@ -0,0 +1,334 @@
+/*
+ * Cote PE du pont Steamworks : ce que le steam_api du jeu appelle.
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(lsteamclient);
+
+BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls( inst );
+        if (__wine_init_unix_call()) return FALSE;
+        if (WINE_UNIX_CALL( unix_attach, NULL )) return FALSE;
+    }
+    return TRUE;
+}
+
+static void *envelopper( void *natif, const char *nom );
+
+/* Ce que le steam_api du jeu appelle en premier. L'interface rendue doit etre
+ * un objet PE : rendre l'objet natif ferait entrer le jeu en ABI System V. */
+void * CDECL CreateInterface( const char *version, int *err )
+{
+    struct create_interface_params params = { version, err, NULL };
+    void *objet;
+
+    if (WINE_UNIX_CALL( unix_create_interface, &params )) return NULL;
+    if (!params.ret) { ERR( "%s : le client natif ne connait pas cette interface\n", debugstr_a(version) ); return NULL; }
+
+    objet = envelopper( params.ret, NULL );
+    ERR( "%s : natif %p -> objet PE %p\n", debugstr_a(version), params.ret, objet );
+    return objet;
+}
+
+int CDECL SondeCreateSteamPipe( void *iface )
+{
+    struct create_steam_pipe_params params = { iface, 0 };
+
+    if (WINE_UNIX_CALL( unix_create_steam_pipe, &params )) return 0;
+    TRACE( "%p -> %d\n", iface, params.ret );
+    return params.ret;
+}
+
+/*
+ * L'objet que le jeu croira Windows.
+ *
+ * Un jeu appelle une methode virtuelle en ABI Microsoft x64 : « this » dans
+ * RCX. L'objet natif, lui, attend System V : « this » dans RDI. On fabrique
+ * donc cote PE un objet dont la table de methodes contient nos thunks ; chacun
+ * recoit l'appel a la mode Windows, retrouve l'interface native, et passe par
+ * l'unixlib qui fera l'appel a la mode System V.
+ *
+ * Le compilateur PE emettant du Microsoft x64, une simple fonction C dont le
+ * premier parametre est l'objet suffit a recevoir un appel virtuel.
+ */
+struct objet_pe
+{
+    const void **table;   /* doit rester en tete : c'est ce que le jeu deref */
+    void        *natif;
+    const char  *nom;     /* NULL pour ISteamClient ; sinon, sous-interface */
+};
+
+/*
+ * Table de decouverte.
+ *
+ * L'ordre des methodes d'ISteamClient n'est publie que dans le SDK
+ * Steamworks, qui est proprietaire : le deviner reviendrait a appeler des
+ * fonctions inconnues sur la session Steam vivante de l'utilisateur, ce qui
+ * peut le deconnecter. On fait donc l'inverse : la table est peuplee de
+ * thunks qui journalisent leur emplacement et rendent zero. Le steam_api du
+ * jeu, lui, sait ou il appelle ; il suffit de le laisser parler pour obtenir
+ * la liste exacte, dans l'ordre, des emplacements qui comptent -- et les
+ * chaines de version qu'il transmet identifient les interfaces demandees.
+ *
+ * Seuls les emplacements deja eprouves sont reellement suivis ; les autres
+ * rendent zero, ce qui echoue proprement au lieu de sauter n'importe ou.
+ */
+#define NB_EMPLACEMENTS 64
+
+static UINT64 repartir( unsigned emplacement, void *self, UINT64 a, UINT64 b, UINT64 c )
+{
+    struct objet_pe *objet = self;
+
+    if (!IsBadStringPtrA( (LPCSTR)(ULONG_PTR)a, 64 ))
+        ERR( "emplacement %u( \"%s\", %p, %p )\n", emplacement,
+             (const char *)(ULONG_PTR)a, (void *)(ULONG_PTR)b, (void *)(ULONG_PTR)c );
+    else if (!IsBadStringPtrA( (LPCSTR)(ULONG_PTR)b, 64 ))
+        ERR( "emplacement %u( %p, \"%s\", %p )\n", emplacement,
+             (void *)(ULONG_PTR)a, (const char *)(ULONG_PTR)b, (void *)(ULONG_PTR)c );
+    else
+        ERR( "emplacement %u( %p, %p, %p )\n", emplacement,
+             (void *)(ULONG_PTR)a, (void *)(ULONG_PTR)b, (void *)(ULONG_PTR)c );
+
+    /* Une sous-interface n'a pas encore de carte : on journalise, on ne relaie
+     * rien. Relayer d'apres les emplacements d'ISteamClient sauterait au
+     * hasard dans une table qui n'est pas la sienne. */
+    if (objet->nom)
+    {
+        ERR( "%s : emplacement %u non cartographie\n", objet->nom, emplacement );
+        return 0;
+    }
+
+    switch (emplacement)
+    {
+    case 0:   /* CreateSteamPipe() */
+    {
+        struct create_steam_pipe_params params = { objet->natif, 0 };
+        if (WINE_UNIX_CALL( unix_create_steam_pipe, &params )) return 0;
+        return params.ret;
+    }
+    case 1:   /* BReleaseSteamPipe(tuyau) */
+    {
+        struct release_steam_pipe_params params = { objet->natif, (int)a, 0 };
+        if (WINE_UNIX_CALL( unix_release_steam_pipe, &params )) return 0;
+        return params.ret;
+    }
+    case 12:  /* GetISteamGenericInterface(utilisateur, tuyau, version) */
+    {
+        struct generic_interface_params params =
+            { objet->natif, (int)a, (int)b, (const char *)(ULONG_PTR)c, NULL };
+        if (WINE_UNIX_CALL( unix_get_generic_interface, &params )) return 0;
+        if (!params.ret) return 0;
+        return (ULONG_PTR)envelopper( params.ret, params.version );
+    }
+    default:
+        return 0;
+    }
+}
+
+#define EMPLACEMENT(n) \
+    static UINT64 thunk_##n( void *self, UINT64 a, UINT64 b, UINT64 c ) \
+    { return repartir( n, self, a, b, c ); }
+EMPLACEMENT(0)
+EMPLACEMENT(1)
+EMPLACEMENT(2)
+EMPLACEMENT(3)
+EMPLACEMENT(4)
+EMPLACEMENT(5)
+EMPLACEMENT(6)
+EMPLACEMENT(7)
+EMPLACEMENT(8)
+EMPLACEMENT(9)
+EMPLACEMENT(10)
+EMPLACEMENT(11)
+EMPLACEMENT(12)
+EMPLACEMENT(13)
+EMPLACEMENT(14)
+EMPLACEMENT(15)
+EMPLACEMENT(16)
+EMPLACEMENT(17)
+EMPLACEMENT(18)
+EMPLACEMENT(19)
+EMPLACEMENT(20)
+EMPLACEMENT(21)
+EMPLACEMENT(22)
+EMPLACEMENT(23)
+EMPLACEMENT(24)
+EMPLACEMENT(25)
+EMPLACEMENT(26)
+EMPLACEMENT(27)
+EMPLACEMENT(28)
+EMPLACEMENT(29)
+EMPLACEMENT(30)
+EMPLACEMENT(31)
+EMPLACEMENT(32)
+EMPLACEMENT(33)
+EMPLACEMENT(34)
+EMPLACEMENT(35)
+EMPLACEMENT(36)
+EMPLACEMENT(37)
+EMPLACEMENT(38)
+EMPLACEMENT(39)
+EMPLACEMENT(40)
+EMPLACEMENT(41)
+EMPLACEMENT(42)
+EMPLACEMENT(43)
+EMPLACEMENT(44)
+EMPLACEMENT(45)
+EMPLACEMENT(46)
+EMPLACEMENT(47)
+EMPLACEMENT(48)
+EMPLACEMENT(49)
+EMPLACEMENT(50)
+EMPLACEMENT(51)
+EMPLACEMENT(52)
+EMPLACEMENT(53)
+EMPLACEMENT(54)
+EMPLACEMENT(55)
+EMPLACEMENT(56)
+EMPLACEMENT(57)
+EMPLACEMENT(58)
+EMPLACEMENT(59)
+EMPLACEMENT(60)
+EMPLACEMENT(61)
+EMPLACEMENT(62)
+EMPLACEMENT(63)
+#undef EMPLACEMENT
+
+static const void *table_steam_client[NB_EMPLACEMENTS] =
+{
+    thunk_0, thunk_1, thunk_2, thunk_3, thunk_4, thunk_5, thunk_6, thunk_7,
+    thunk_8, thunk_9, thunk_10, thunk_11, thunk_12, thunk_13, thunk_14, thunk_15,
+    thunk_16, thunk_17, thunk_18, thunk_19, thunk_20, thunk_21, thunk_22, thunk_23,
+    thunk_24, thunk_25, thunk_26, thunk_27, thunk_28, thunk_29, thunk_30, thunk_31,
+    thunk_32, thunk_33, thunk_34, thunk_35, thunk_36, thunk_37, thunk_38, thunk_39,
+    thunk_40, thunk_41, thunk_42, thunk_43, thunk_44, thunk_45, thunk_46, thunk_47,
+    thunk_48, thunk_49, thunk_50, thunk_51, thunk_52, thunk_53, thunk_54, thunk_55,
+    thunk_56, thunk_57, thunk_58, thunk_59, thunk_60, thunk_61, thunk_62, thunk_63,
+};
+
+static void *envelopper( void *natif, const char *nom )
+{
+    struct objet_pe *objet;
+
+    if (!natif) return NULL;
+    if (!(objet = HeapAlloc( GetProcessHeap(), 0, sizeof(*objet) ))) return NULL;
+    objet->table = table_steam_client;
+    objet->natif = natif;
+    objet->nom   = nom;
+    TRACE( "interface native %p -> objet PE %p\n", natif, objet );
+    return objet;
+}
+
+void * CDECL SondeEnvelopperSteamClient( void *natif )
+{
+    return envelopper( natif, NULL );
+}
+
+/* Atteindre une sous-interface par son nom, via l'emplacement 12. L'objet
+ * rendu est enveloppe lui aussi, mais sans aucun relais : sa table de methodes
+ * n'est pas encore cartographiee, alors ses emplacements journalisent et
+ * rendent zero plutot que de sauter dans du code inconnu. */
+void * CDECL SondeInterfaceGenerique( void *client, int user, int pipe, const char *version )
+{
+    struct objet_pe *objet = client;
+    struct generic_interface_params params = { objet ? objet->natif : NULL, user, pipe, version, NULL };
+
+    if (!objet) return NULL;
+    if (WINE_UNIX_CALL( unix_get_generic_interface, &params )) return NULL;
+    if (!params.ret) return NULL;
+    return envelopper( params.ret, version );
+}
+
+void * CDECL SondeInterfaceNative( void *enveloppe )
+{
+    struct objet_pe *objet = enveloppe;
+    return objet ? objet->natif : NULL;
+}
+
+/*
+ * Les fonctions plates de steamclient.
+ *
+ * Le steam_api.dll livre avec le jeu ne passe pas par une table de methodes
+ * pour ces sept-la : il fait un GetProcAddress sur steamclient.dll. Elles
+ * doivent donc exister sous leur nom exact. Sur x86_64 les deux ABI se
+ * rejoignent pour des entiers -- quatre au plus, aucun flottant, aucune
+ * structure -- si bien que la traduction se reduit au passage par l'unixlib.
+ */
+static int plate( int quoi, int pipe, int user )
+{
+    struct appel_plat_params params = { quoi, pipe, user, 0 };
+
+    if (WINE_UNIX_CALL( unix_appel_plat, &params )) return 0;
+    return params.ret;
+}
+
+int CDECL Steam_CreateSteamPipe(void)
+{
+    return plate( plate_create_steam_pipe, 0, 0 );
+}
+
+int CDECL Steam_ConnectToGlobalUser( int pipe )
+{
+    return plate( plate_connect_to_global_user, pipe, 0 );
+}
+
+void CDECL Steam_ReleaseUser( int pipe, int user )
+{
+    plate( plate_release_user, pipe, user );
+}
+
+BOOL CDECL Steam_BConnected( int user, int pipe )
+{
+    return plate( plate_b_connected, pipe, user ) != 0;
+}
+
+BOOL CDECL Steam_BLoggedOn( int user, int pipe )
+{
+    return plate( plate_b_logged_on, pipe, user ) != 0;
+}
+
+/* Disposition Windows du CallbackMsg_t : identique a la native sur x86_64,
+ * mais on la redeclare ici plutot que de supposer que les deux cotes ont lu la
+ * meme definition. */
+typedef struct
+{
+    int            m_hSteamUser;
+    int            m_iCallback;
+    unsigned char *m_pubParam;
+    int            m_cubParam;
+} CallbackMsg_t;
+
+BOOL CDECL Steam_BGetCallback( int pipe, CallbackMsg_t *msg, int *call )
+{
+    struct get_callback_params params = { pipe };
+
+    if (!msg) return FALSE;
+    if (WINE_UNIX_CALL( unix_get_callback, &params )) return FALSE;
+    if (!params.ret) return FALSE;
+
+    msg->m_hSteamUser = params.msg.user;
+    msg->m_iCallback  = params.msg.callback;
+    msg->m_pubParam   = params.msg.param;
+    msg->m_cubParam   = params.msg.taille;
+    if (call) *call = params.call;
+
+    TRACE( "rappel %d, %d octets\n", msg->m_iCallback, msg->m_cubParam );
+    return TRUE;
+}
+
+void CDECL Steam_FreeLastCallback( int pipe )
+{
+    struct free_last_callback_params params = { pipe };
+
+    WINE_UNIX_CALL( unix_free_last_callback, &params );
+}
diff --git a/dlls/lsteamclient/unix.c b/dlls/lsteamclient/unix.c
new file mode 100644
index 00000000..92c1998c
--- /dev/null
+++ b/dlls/lsteamclient/unix.c
@@ -0,0 +1,273 @@
+/*
+ * Cote unix du pont Steamworks : charge le steamclient.dylib du client Steam
+ * natif et lui demande ses interfaces.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(lsteamclient);
+
+typedef void *(*create_interface_t)( const char *version, int *err );
+
+/* Toutes ces fonctions rendent un bool d'un octet ou un entier ; les bools
+ * sont declares « unsigned char » car le natif ne renseigne que AL. */
+typedef int           (*plate_pipe_t)( int pipe );
+typedef void          (*plate_pipe_user_t)( int pipe, int user );
+typedef unsigned char (*plate_user_pipe_t)( int user, int pipe );
+typedef int           (*plate_rien_t)( void );
+
+/* Disposition exacte du CallbackMsg_t de Steamworks, cote natif. */
+struct callback_msg_natif
+{
+    int            m_hSteamUser;
+    int            m_iCallback;
+    unsigned char *m_pubParam;
+    int            m_cubParam;
+};
+
+typedef unsigned char (*b_get_callback_t)( int pipe, struct callback_msg_natif *msg, int *call );
+typedef void          (*free_last_callback_t)( int pipe );
+
+static void *steamclient;
+static create_interface_t p_CreateInterface;
+static plate_pipe_t         p_ConnectToGlobalUser;
+static plate_pipe_user_t    p_ReleaseUser;
+static plate_user_pipe_t    p_BConnected;
+static plate_user_pipe_t    p_BLoggedOn;
+static plate_rien_t         p_CreateSteamPipe;
+static b_get_callback_t     p_BGetCallback;
+static free_last_callback_t p_FreeLastCallback;
+
+static const char *chemins[] =
+{
+    "%s/Library/Application Support/Steam/Steam.AppBundle/Steam/Contents/MacOS/steamclient.dylib",
+    "%s/Library/Application Support/Steam/steamclient.dylib",
+};
+
+static NTSTATUS attach( void *args )
+{
+    const char *home = getenv( "HOME" );
+    char chemin[1024];
+    unsigned int i;
+
+    if (steamclient) return STATUS_SUCCESS;
+    if (!home) return STATUS_DLL_NOT_FOUND;
+
+    for (i = 0; i < ARRAY_SIZE(chemins); i++)
+    {
+        snprintf( chemin, sizeof(chemin), chemins[i], home );
+        if ((steamclient = dlopen( chemin, RTLD_NOW | RTLD_LOCAL ))) break;
+        TRACE( "%s : %s\n", chemin, dlerror() );
+    }
+    if (!steamclient)
+    {
+        ERR( "steamclient.dylib introuvable\n" );
+        return STATUS_DLL_NOT_FOUND;
+    }
+
+    if (!(p_CreateInterface = dlsym( steamclient, "CreateInterface" )))
+    {
+        ERR( "CreateInterface absent de steamclient.dylib\n" );
+        return STATUS_ENTRYPOINT_NOT_FOUND;
+    }
+
+    /* Les fonctions de gestion d'utilisateur et la pompe a rappels ne sont pas
+     * des methodes virtuelles : steamclient.dylib les exporte a plat. Un
+     * dlsym suffit, aucune table de methodes a deviner. */
+    p_ConnectToGlobalUser = dlsym( steamclient, "Steam_ConnectToGlobalUser" );
+    p_ReleaseUser         = dlsym( steamclient, "Steam_ReleaseUser" );
+    p_BConnected          = dlsym( steamclient, "Steam_BConnected" );
+    p_BLoggedOn           = dlsym( steamclient, "Steam_BLoggedOn" );
+    p_CreateSteamPipe     = dlsym( steamclient, "Steam_CreateSteamPipe" );
+    p_BGetCallback        = dlsym( steamclient, "Steam_BGetCallback" );
+    p_FreeLastCallback    = dlsym( steamclient, "Steam_FreeLastCallback" );
+
+    TRACE( "steamclient.dylib charge, CreateInterface a %p, BGetCallback a %p\n",
+           p_CreateInterface, p_BGetCallback );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS create_interface( void *args )
+{
+    struct create_interface_params *params = args;
+
+    if (!p_CreateInterface) return STATUS_DLL_NOT_FOUND;
+    params->ret = p_CreateInterface( params->version, params->err );
+    TRACE( "%s -> %p\n", debugstr_a(params->version), params->ret );
+    return STATUS_SUCCESS;
+}
+
+/*
+ * ISteamClient::CreateSteamPipe occupe le premier emplacement de la table de
+ * methodes. L'objet rendu par steamclient.dylib est un objet C++ natif : sa
+ * table suit l'ABI System V, ou « this » passe dans le premier registre
+ * d'argument, ce qui est exactement ce qu'une fonction C a un parametre fait
+ * ici. Le jeu Windows, lui, appellera en ABI Microsoft x64 -- c'est la
+ * traduction que les thunks devront assurer.
+ */
+static NTSTATUS create_steam_pipe( void *args )
+{
+    struct create_steam_pipe_params *params = args;
+    typedef int (*methode_t)( void *iface );
+    methode_t *table;
+
+    if (!params->iface) return STATUS_INVALID_PARAMETER;
+
+    table = *(methode_t **)params->iface;
+    TRACE( "iface %p, table %p, emplacement 0 = %p\n", params->iface, table, table[0] );
+
+    params->ret = table[0]( params->iface );
+    TRACE( "CreateSteamPipe -> %d\n", params->ret );
+    return STATUS_SUCCESS;
+}
+
+/* ISteamClient::BReleaseSteamPipe occupe l'emplacement 1 et prend un argument :
+ * de quoi eprouver le passage de parametre, que CreateSteamPipe ne testait pas. */
+static NTSTATUS release_steam_pipe( void *args )
+{
+    struct release_steam_pipe_params *params = args;
+    /* La methode rend un bool d'un octet : elle ne renseigne que AL, et lire
+     * EAX entier ramene les bits de poids fort laisses indefinis. Le type de
+     * retour doit donc etre declare a sa vraie largeur. */
+    typedef unsigned char (*methode_t)( void *iface, int pipe );
+    methode_t *table;
+
+    if (!params->iface) return STATUS_INVALID_PARAMETER;
+
+    table = *(methode_t **)params->iface;
+    params->ret = table[1]( params->iface, params->pipe );
+    TRACE( "BReleaseSteamPipe(%d) -> %d\n", params->pipe, params->ret );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS appel_plat( void *args )
+{
+    struct appel_plat_params *params = args;
+
+    switch (params->quoi)
+    {
+    case plate_connect_to_global_user:
+        if (!p_ConnectToGlobalUser) return STATUS_ENTRYPOINT_NOT_FOUND;
+        params->ret = p_ConnectToGlobalUser( params->pipe );
+        break;
+    case plate_release_user:
+        if (!p_ReleaseUser) return STATUS_ENTRYPOINT_NOT_FOUND;
+        p_ReleaseUser( params->pipe, params->user );
+        params->ret = 0;
+        break;
+    case plate_b_connected:
+        if (!p_BConnected) return STATUS_ENTRYPOINT_NOT_FOUND;
+        params->ret = p_BConnected( params->user, params->pipe );
+        break;
+    case plate_b_logged_on:
+        if (!p_BLoggedOn) return STATUS_ENTRYPOINT_NOT_FOUND;
+        params->ret = p_BLoggedOn( params->user, params->pipe );
+        break;
+    case plate_create_steam_pipe:
+        if (!p_CreateSteamPipe) return STATUS_ENTRYPOINT_NOT_FOUND;
+        params->ret = p_CreateSteamPipe();
+        break;
+    default:
+        return STATUS_INVALID_PARAMETER;
+    }
+    TRACE( "plate %d (tuyau %d, utilisateur %d) -> %d\n",
+           params->quoi, params->pipe, params->user, params->ret );
+    return STATUS_SUCCESS;
+}
+
+/*
+ * La pompe a rappels.
+ *
+ * Steamworks ne rappelle jamais le jeu de lui-meme : c'est le jeu qui vient
+ * chercher ses evenements, en boucle, depuis son propre fil. La frontiere ne
+ * se franchit donc que dans le sens jeu -> client, comme le reste. Le champ
+ * m_pubParam pointe dans la memoire du client ; unixlib partageant l'espace
+ * d'adressage du PE, le jeu pourra le lire directement, sans recopie.
+ */
+static NTSTATUS get_callback( void *args )
+{
+    struct get_callback_params *params = args;
+    struct callback_msg_natif msg = { 0 };
+    int call = 0;
+
+    if (!p_BGetCallback) return STATUS_ENTRYPOINT_NOT_FOUND;
+
+    params->ret = p_BGetCallback( params->pipe, &msg, &call );
+    if (params->ret)
+    {
+        params->msg.user     = msg.m_hSteamUser;
+        params->msg.callback = msg.m_iCallback;
+        params->msg.param    = msg.m_pubParam;
+        params->msg.taille   = msg.m_cubParam;
+        params->call         = call;
+        TRACE( "rappel %d, utilisateur %d, %d octets a %p\n",
+               msg.m_iCallback, msg.m_hSteamUser, msg.m_cubParam, msg.m_pubParam );
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS free_last_callback( void *args )
+{
+    struct free_last_callback_params *params = args;
+
+    if (!p_FreeLastCallback) return STATUS_ENTRYPOINT_NOT_FOUND;
+    p_FreeLastCallback( params->pipe );
+    return STATUS_SUCCESS;
+}
+
+/*
+ * ISteamClient::GetISteamGenericInterface, emplacement 12.
+ *
+ * Les GetISteamXxx nommes chargent une chaine constante -- le nom de la
+ * famille d'interface -- avant de sauter dans un repartiteur commun.
+ * L'emplacement 12 emprunte le meme repartiteur avec un nom NUL : le
+ * repartiteur prend alors celui que l'appelant fournit. Une seule methode
+ * suffit donc a atteindre n'importe quelle interface Steamworks par son nom,
+ * sans connaitre aucun autre emplacement.
+ */
+static NTSTATUS get_generic_interface( void *args )
+{
+    struct generic_interface_params *params = args;
+    typedef void *(*methode_t)( void *iface, int user, int pipe, const char *version );
+    methode_t *table;
+
+    if (!params->iface) return STATUS_INVALID_PARAMETER;
+
+    table = *(methode_t **)params->iface;
+    params->ret = table[12]( params->iface, params->user, params->pipe, params->version );
+    TRACE( "%s (utilisateur %d, tuyau %d) -> %p\n",
+           debugstr_a(params->version), params->user, params->pipe, params->ret );
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    attach,
+    create_interface,
+    create_steam_pipe,
+    release_steam_pipe,
+    appel_plat,
+    get_callback,
+    free_last_callback,
+    get_generic_interface,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
